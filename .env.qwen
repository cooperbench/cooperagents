# Model profile: Qwen3.5-9B served on Modal (vLLM, OpenAI-compatible, 32k ctx).
# Use with: ENV_FILE=.env.qwen scripts/measure.sh <label>
# The AZURE_* names are legacy: AZURE_OPENAI_DEPLOYMENT is read as "the model"
# throughout (bench_compare, planner, judge). Empty AZURE_OPENAI_BASE_URL/KEY
# make the code fall through to the OPENAI_* vars below.
AZURE_OPENAI_DEPLOYMENT=Qwen/Qwen3.5-9B
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
OPENAI_BASE_URL=https://cooperbench--qwen35-9b-bf16-32k-serve.modal.run/v1
OPENAI_API_KEY=dummy
# Pin sampling: identical configs varied 6/26 vs 11/28 features unpinned —
# greedy decoding removes most run-to-run drift so seam deltas are measurable.
COOPER_TEMPERATURE=0.0
