diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..93101c8
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,442 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <ctype.h>
+#include <limits.h>
+
+#define WIDTH 80
+#define HEIGHT 24
+
+// ANSI escape codes
+#define ESC "\033["
+#define RESET "\033[0m"
+#define BOLD "\033[1m"
+#define DIM "\033[2m"
+#define HIDE_CURSOR ESC "?25l"
+#define SHOW_CURSOR ESC "?25h"
+#define CLEAR_SCREEN ESC "2J"
+#define HOME ESC "H"
+#define SAVE_CURSOR ESC "s"
+#define RESTORE_CURSOR ESC "u"
+
+// Colors
+#define COLOR_GREEN "\033[32m"
+#define COLOR_RED "\033[31m"
+#define COLOR_BLUE "\033[34m"
+#define COLOR_WHITE "\033[37m"
+#define COLOR_YELLOW "\033[33m"
+#define COLOR_CYAN "\033[36m"
+#define COLOR_MAGENTA "\033[35m"
+#define COLOR_BLACK "\033[30m"
+
+// Default settings
+int async_scroll = 0;
+int bold_chars = 0;
+int all_bold = 0;
+int force_term = 0;
+int linux_mode = 0;
+int old_style = 0;
+int shadows_only = 0;
+int lock_mode = 0;
+int rainbow_mode = 0;
+int lambda_mode = 0;
+int chars_change = 0;
+int screensaver_mode = 0;
+int x_mode = 0;
+int no_bold = 0;
+int tty_set = 0;
+int message_set = 0;
+
+int update_delay = 4;
+char color = 'g';  // default green
+char message[256] = "";
+char tty_name[64] = "";
+
+// Character set (Matrix-like)
+const char *matrix_chars = " .:-=+*#%@";
+const char *japanese_chars = " .:-=+*#%@";
+const char *lambda_chars = "λ";
+
+// State
+int current_color = 0;
+int async_state = 0;
+int bold_state = 0;
+int all_bold_state = 0;
+int no_bold_state = 0;
+
+// Screen buffer
+typedef struct {
+    char *chars;
+    int *y_pos;
+    int *x_pos;
+    int *color;
+    int *bold;
+    int width;
+    int height;
+} Screen;
+
+Screen screen;
+
+void init_screen(void) {
+    screen.width = WIDTH;
+    screen.height = HEIGHT;
+    screen.chars = malloc(WIDTH * HEIGHT * sizeof(char));
+    screen.y_pos = malloc(WIDTH * HEIGHT * sizeof(int));
+    screen.x_pos = malloc(WIDTH * HEIGHT * sizeof(int));
+    screen.color = malloc(WIDTH * HEIGHT * sizeof(int));
+    screen.bold = malloc(WIDTH * HEIGHT * sizeof(int));
+    
+    for (int i = 0; i < WIDTH * HEIGHT; i++) {
+        screen.chars[i] = ' ';
+        screen.y_pos[i] = 0;
+        screen.x_pos[i] = 0;
+        screen.color[i] = 0;
+        screen.bold[i] = 0;
+    }
+}
+
+void free_screen(void) {
+    free(screen.chars);
+    free(screen.y_pos);
+    free(screen.x_pos);
+    free(screen.color);
+    free(screen.bold);
+}
+
+void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+void print_version(void) {
+    printf(" CMatrix version 2.0 (compiled 22:13:51, Jun 11 2026)\n");
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+void parse_args(int argc, char *argv[]) {
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            // Japanese characters mode
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            chars_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            update_delay = atoi(argv[++i]);
+            if (update_delay < 0) update_delay = 0;
+            if (update_delay > 10) update_delay = 10;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            color = argv[++i][0];
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            strncpy(message, argv[++i], sizeof(message) - 1);
+            message_set = 1;
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            strncpy(tty_name, argv[++i], sizeof(tty_name) - 1);
+            tty_set = 1;
+        }
+    }
+}
+
+int get_color_index(char c) {
+    if (c == 'g' || c == 'G') return 0;   // green
+    if (c == 'r' || c == 'R') return 1;   // red
+    if (c == 'b' || c == 'B') return 2;   // blue
+    if (c == 'w' || c == 'W') return 3;   // white
+    if (c == 'y' || c == 'Y') return 4;   // yellow
+    if (c == 'c' || c == 'C') return 5;   // cyan
+    if (c == 'm' || c == 'M') return 6;   // magenta
+    if (c == 'k' || c == 'K') return 7;   // black
+    return 0;  // default green
+}
+
+void get_current_color(void) {
+    if (rainbow_mode) {
+        static int hue = 0;
+        hue = (hue + 1) % 360;
+        int r = (hue / 60) % 6;
+        int g = (hue / 60 + 2) % 6;
+        int b = (hue / 60 + 4) % 6;
+        // Simplified: just cycle through colors
+        current_color = (hue / 60) % 8;
+    } else {
+        current_color = get_color_index(color);
+    }
+}
+
+void draw_screen(void) {
+    // Clear screen
+    printf(CLEAR_SCREEN);
+    printf(HOME);
+    
+    // Draw each character
+    for (int y = 0; y < screen.height; y++) {
+        for (int x = 0; x < screen.width; x++) {
+            int idx = y * screen.width + x;
+            char c = screen.chars[idx];
+            int col = screen.color[idx];
+            int bold = screen.bold[idx];
+            
+            if (c != ' ') {
+                printf("%c", c);
+                if (bold) printf(BOLD);
+                if (col >= 0 && col < 8) {
+                    const char *color_str;
+                    switch (col) {
+                        case 0: color_str = COLOR_GREEN; break;
+                        case 1: color_str = COLOR_RED; break;
+                        case 2: color_str = COLOR_BLUE; break;
+                        case 3: color_str = COLOR_WHITE; break;
+                        case 4: color_str = COLOR_YELLOW; break;
+                        case 5: color_str = COLOR_CYAN; break;
+                        case 6: color_str = COLOR_MAGENTA; break;
+                        case 7: color_str = COLOR_BLACK; break;
+                        default: color_str = COLOR_GREEN;
+                    }
+                    printf("%s", color_str);
+                }
+                if (!bold) printf(RESET);
+            } else {
+                printf(" ");
+            }
+        }
+        printf("\n");
+    }
+}
+
+void move_cursor(int x, int y) {
+    printf("%d;%dH", x + 1, y + 1);
+}
+
+void handle_key(int key) {
+    if (screensaver_mode) return;
+    
+    switch (key) {
+        case 'a':
+            async_state = !async_state;
+            break;
+        case 'b':
+            bold_state = !bold_state;
+            break;
+        case 'B':
+            all_bold_state = 1;
+            no_bold_state = 0;
+            break;
+        case 'n':
+            no_bold_state = 1;
+            all_bold_state = 0;
+            break;
+        case '0':
+        case '1':
+        case '2':
+        case '3':
+        case '4':
+        case '5':
+        case '6':
+        case '7':
+        case '8':
+        case '9':
+            update_delay = key - '0';
+            break;
+        case '!':
+            color = 'r';
+            break;
+        case '@':
+            color = 'g';
+            break;
+        case '#':
+            color = 'y';
+            break;
+        case '$':
+            color = 'b';
+            break;
+        case '%':
+            color = 'm';
+            break;
+        case '^':
+            color = 'c';
+            break;
+        case '&':
+            color = 'w';
+            break;
+        case ')':
+            color = 'k';
+            break;
+        case 'q':
+            exit(0);
+            break;
+    }
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    // Get terminal size
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == -1) {
+        ws.ws_col = WIDTH;
+        ws.ws_row = HEIGHT;
+    }
+    
+    // Initialize screen
+    init_screen();
+    
+    // Set up terminal
+    struct termios oldt, newt;
+    if (tcgetattr(STDIN_FILENO, &oldt) == 0) {
+        newt = oldt;
+        newt.c_lflag &= ~(ICANON | ECHO);
+        newt.c_cc[VMIN] = 0;
+        newt.c_cc[VTIME] = 0;
+        tcsetattr(STDIN_FILENO, TCSANOW, &newt);
+    }
+    
+    // Hide cursor
+    printf(HIDE_CURSOR);
+    
+    // Set terminal type if needed
+    if (force_term) {
+        setenv("TERM", "xterm", 1);
+    }
+    
+    // Get initial color
+    get_current_color();
+    
+    // Main loop
+    int running = 1;
+    int frame_count = 0;
+    
+    while (running) {
+        // Update characters
+        if (chars_change && !old_style) {
+            for (int i = 0; i < WIDTH * HEIGHT; i++) {
+                if (rand() % 100 < 5) {
+                    screen.chars[i] = matrix_chars[rand() % (strlen(matrix_chars) - 1)];
+                }
+            }
+        }
+        
+        // Move characters down
+        for (int y = screen.height - 1; y >= 0; y--) {
+            for (int x = 0; x < screen.width; x++) {
+                int idx = y * screen.width + x;
+                if (screen.y_pos[idx] > 0) {
+                    screen.y_pos[idx]--;
+                }
+            }
+        }
+        
+        // Spawn new characters
+        int spawn_rate = 2;
+        if (old_style) spawn_rate = 1;
+        
+        for (int y = 0; y < screen.height; y++) {
+            for (int x = 0; x < screen.width; x++) {
+                int idx = y * screen.width + x;
+                if (screen.y_pos[idx] == 0 && rand() % spawn_rate == 0) {
+                    screen.chars[idx] = matrix_chars[rand() % (strlen(matrix_chars) - 1)];
+                    screen.y_pos[idx] = 0;
+                    screen.x_pos[idx] = x;
+                    screen.color[idx] = current_color;
+                    screen.bold[idx] = (bold_state || all_bold_state) ? 1 : 0;
+                }
+            }
+        }
+        
+        // Draw screen
+        draw_screen();
+        
+        // Handle keyboard input
+        fd_set fds;
+        FD_ZERO(&fds);
+        FD_SET(STDIN_FILENO, &fds);
+        
+        struct timeval tv;
+        tv.tv_sec = 0;
+        tv.tv_usec = update_delay * 10000;
+        
+        int ret = select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv);
+        if (ret > 0 && FD_ISSET(STDIN_FILENO, &fds)) {
+            char buf[10];
+            int n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+            if (n > 0) {
+                buf[n] = '\0';
+                for (int i = 0; i < n; i++) {
+                    handle_key(buf[i]);
+                }
+            }
+        }
+        
+        // Sleep for update delay
+        usleep(update_delay * 10000);
+        
+        frame_count++;
+        if (frame_count > 1000) {
+            // Safety break
+            break;
+        }
+    }
+    
+    // Restore terminal
+    if (tcgetattr(STDIN_FILENO, &oldt) == 0) {
+        tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
+    }
+    printf(SHOW_CURSOR);
+    
+    free_screen();
+    
+    return 0;
+}
