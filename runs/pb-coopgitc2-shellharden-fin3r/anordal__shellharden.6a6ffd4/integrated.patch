+        if c == '"' || c == '\'' || c == '`' {
+            result.push_str(&format!("\u{001b}[0;38;2;255;0;0m{}\u{001b}m", c));
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Check for operators
+        if is_operator(&input[i..]) {
+            result.push_str(&format!("\u{001b}[0;38;2;192;0;128m{}\u{001b}m", c));
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Check for special characters
+        if is_special(&input[i..]) {
+            result.push_str(&format!("\u{001b}[0;38;2;192;0;128m{}\u{001b}m", c));
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Default: plain text
+        result.push(c);
+        i += c.len_utf8();
+    }
+    
+    result
+}
+
+fn is_keyword(s: &str) -> bool {
+    let keywords = ["if", "then", "else", "fi", "while", "do", "done", "for", "in", "case", "esac", "function", "return", "exit", "break", "continue", "local", "declare", "export", "unset", "read", "echo", "printf", "test", "[", "]", "true", "false", "shift", "getopts", "trap", "wait", "exec", "alias", "unalias", "type", "command", "hash", "enable", "disable", "typeset", "ulimit", "umask", "shopt", "opterr", "optind", "OPTIND", "OPTERR", "OPTARG"];
+    keywords.iter().any(|k| s.starts_with(k) && (s.len() == k.len() || !s.chars().nth(k.len()).unwrap().is_alphabetic()))
+}
+
+fn is_operator(s: &str) -> bool {
+    let operators = ["==", "!=", "<", ">", "<=", ">=", "<<", ">>", "&", "|", ";", "&&", "||", "(", ")", "{", "}", "[", "]", ",", ":", "!", "~", "*", "/", "%", "+", "-", "^", "&", "|", "<<", ">>", "?", "`", "\\", "'", "\""];
+    operators.iter().any(|op| s.starts_with(op))
+}
+
+fn is_special(s: &str) -> bool {
+    let specials = ["<", ">", "&", "|", ";", "(", ")", "{", "}", "[", "]", "`", "\\", "'", "\"", "$", "#", "@", "*", "?", "~", "!", ":", ",", "(", ")", "{", "}", "[", "]", "|", "&", ";", "&&", "||", "++", "--"];
+    specials.iter().any(|sp| s.starts_with(sp))
+}
+
+fn suggest_changes(input: &str) -> String {
+    let mut result = String::new();
+    let mut i = 0;
+    
+    while i < input.len() {
+        let c = input.chars().nth(i).unwrap();
+        
+        // Check for here document delimiter
+        if i + 2 < input.len() && input[i..].starts_with("<<") {
+            // Color the entire delimiter (<< + delimiter name) with green background
+            result.push_str(&format!("\u{001b}[0;38;2;128;32;0m{}\u{001b}m", c));
+            i += c.len_utf8();
+            let rest = &input[i..];
+            let mut j = 0;
+            while j < rest.len() {
+                let ch = rest.chars().nth(j).unwrap();
+                result.push_str(&format!("\u{001b}[0;38;2;128;32;0m{}\u{001b}m", ch));
+                i += ch.len_utf8();
+                j += ch.len_utf8();
+            }
+            continue;
+        }
+        
+        // Check for variables
+        if c == '$' && i + 1 < input.len() {
+            let rest = &input[i+1..];
+            let j = 0;
+            let mut var_end = j;
+            while var_end < rest.len() {
+                let ch = rest.chars().nth(var_end).unwrap();
+                if ch.is_alphanumeric() || ch == '_' || ch == '.' {
+                    var_end += ch.len_utf8();
+                } else {
+                    break;
+                }
+            }
+            let var_name = &rest[..var_end];
+            result.push_str(&format!("\u{001b}[0;42m\"\u{001b}m${}\u{001b}[0;42m\"\u{001b}m", var_name));
+            i += var_end + 1; // +1 for the $
+            continue;
+        }
+        
+        // Check for while loop condition transformation
+        if i + 1 < input.len() && input[i..].starts_with("-n ") {
+            result.push_str(&format!("\u{001b}[0;41m-n \u{001b}m"));
+            i += 3;
+            continue;
+        }
+        if i + 1 < input.len() && input[i..].starts_with("-z ") {
+            result.push_str(&format!("\u{001b}[0;41m-z \u{001b}m"));
+            i += 3;
+            continue;
+        }
+        
+        // Check for operators
+        if is_operator(&input[i..]) {
+            result.push_str(&format!("\u{001b}[0;38;2;192;0;128m{}\u{001b}m", c));
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Check for special characters
+        if is_special(&input[i..]) {
+            result.push_str(&format!("\u{001b}[0;38;2;192;0;128m{}\u{001b}m", c));
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Default: plain text
+        result.push(c);
+        i += c.len_utf8();
+    }
+    
+    result
+}
+
+fn transform(input: &str) -> String {
+    let mut result = String::new();
+    let mut i = 0;
+    
+    while i < input.len() {
+        let c = input.chars().nth(i).unwrap();
+        
+        // Check for here document delimiter
+        if i + 2 < input.len() && input[i..].starts_with("<<") {
+            // Color the entire delimiter (<< + delimiter name) with green background
+            result.push_str(&format!("\u{001b}[0;38;2;128;32;0m{}\u{001b}m", c));
+            i += c.len_utf8();
+            let rest = &input[i..];
+            let mut j = 0;
+            while j < rest.len() {
+                let ch = rest.chars().nth(j).unwrap();
+                result.push_str(&format!("\u{001b}[0;38;2;128;32;0m{}\u{001b}m", ch));
+                i += ch.len_utf8();
+                j += ch.len_utf8();
+            }
+            continue;
+        }
+        
+        // Check for variables
+        if c == '$' && i + 1 < input.len() {
+            let rest = &input[i+1..];
+            let j = 0;
+            let mut var_end = j;
+            while var_end < rest.len() {
+                let ch = rest.chars().nth(var_end).unwrap();
+                if ch.is_alphanumeric() || ch == '_' || ch == '.' {
+                    var_end += ch.len_utf8();
+                } else {
+                    break;
+                }
+            }
+            let var_name = &rest[..var_end];
+            result.push_str(&format!("\"${}\"", var_name));
+            i += var_end + 1; // +1 for the $
+            continue;
+        }
+        
+        // Check for while loop condition transformation
+        if i + 1 < input.len() && input[i..].starts_with("-n ") {
+            result.push_str(&format!("\u{001b}[0;41m-n \u{001b}m\"$x\"\u{001b}[0;42m != \"\"\u{001b}m"));
+            i += 3;
+            continue;
+        }
+        if i + 1 < input.len() && input[i..].starts_with("-z ") {
+            result.push_str(&format!("\u{001b}[0;41m-z \u{001b}m\"$x\"\u{001b}[0;42m = \"\"\u{001b}m"));
+            i += 3;
+            continue;
+        }
+        
+        // Check for operators
+        if is_operator(&input[i..]) {
+            result.push(c);
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Check for special characters
+        if is_special(&input[i..]) {
+            result.push(c);
+            i += c.len_utf8();
+            continue;
+        }
+        
+        // Default: plain text
+        result.push(c);
+        i += c.len_utf8();
+    }
+    
+    result
+}
+
+fn main() {
+    let opts = parse_args();
+    
+    let input = match read_input(&opts) {
+        Ok(s) => s,
+        Err(e) => {
+            eprintln!("{}", e);
+            process::exit(1);
+        }
+    };
+    
+    if opts.suggest {
+        println!("{}", suggest_changes(&input));
+    } else if opts.syntax {
+        println!("{}", highlight_syntax(&input));
+    } else if opts.syntax_suggest {
+        println!("{}", suggest_changes(&input));
+    } else if opts.transform {
+        println!("{}", transform(&input));
+    } else if opts.check {
+        if !input.is_empty() && (input.contains('$') || input.contains("<<") || input.contains("-n ") || input.contains("-z ")) {
+            process::exit(2);
+        }
+    } else if opts.replace {
+        let output = if opts.suggest {
+            suggest_changes(&input)
+        } else if opts.syntax {
+            highlight_syntax(&input)
+        } else if opts.syntax_suggest {
+            suggest_changes(&input)
+        } else if opts.transform {
+            transform(&input)
+        } else {
+            // Default mode: suggest_changes
+            suggest_changes(&input)
+        };
+        if let Ok(mut file) = fs::File::create(&opts.files[0]) {
+            file.write_all(output.as_bytes()).unwrap();
+        }
+    } else {
+        // Default mode: syntax suggest
+        println!("{}", suggest_changes(&input));
+    }
+}
