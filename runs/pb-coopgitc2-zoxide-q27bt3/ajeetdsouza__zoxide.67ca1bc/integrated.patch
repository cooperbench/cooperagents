++fn run(args: &[String]) {
++    // Top-level: handle -h/--help and -V/--version
++    if args.is_empty() {
++        // no command: print help to stderr, exit 2
++        eprint!("{}", main_help());
++        exit(2);
++    }
++
++    let first = &args[0];
++
++    // Global flags before any subcommand
++    if first == "-h" || first == "--help" {
++        print!("{}", main_help());
++        exit(0);
++    }
++    if first == "-V" || first == "--version" {
++        println!("zoxide {}", VERSION);
++        exit(0);
++    }
++
++    match first.as_str() {
++        "add" => { add::run(&args[1..]); }
++        "edit" => { edit::run(&args[1..]); }
++        "import" => { import::run(&args[1..]); }
++        "init" => { init::run(&args[1..]); }
++        "query" => { query::run(&args[1..]); }
++        "remove" => { remove::run(&args[1..]); }
++        _ => {
++            // unrecognized subcommand
++            eprintln!("error: unrecognized subcommand '{}'\n", first);
++            eprint!("Usage: executable <COMMAND>\n");
++            exit(2);
++        }
++    }
++}
