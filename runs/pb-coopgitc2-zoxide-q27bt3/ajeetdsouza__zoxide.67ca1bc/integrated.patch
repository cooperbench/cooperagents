+#!/bin/bash
+set -e
+cd "$(dirname "$0")"
+
+# Build the project. Prefer offline; fall back to a normal build.
+cargo build --release --offline 2>/dev/null || cargo build --release
+
+BIN="$PWD/target/release/executable"
+[ -x "$BIN" ] || { echo "build failed: $BIN missing" >&2; exit 1; }
+
+# Produce ./executable from the freshly built binary. Best effort: the
+# reference may be read-protected/owned by root in some environments, so a
+# failed copy must not fail the build (the binary still exists in target/).
+if cp -f "$BIN" ./executable 2>/dev/null; then
+    :
+else
+    rm -f ./executable 2>/dev/null && cp "$BIN" ./executable 2>/dev/null || true
+fi
+
+# Final safety net: if ./executable still does not exist, try once more.
+[ -e ./executable ] || { rm -f ./executable 2>/dev/null; cp "$BIN" ./executable 2>/dev/null || true; }
+
+echo "Build complete: $BIN"
