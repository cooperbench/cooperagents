++fn apply_cmd(text: &str, cmd: Option<&str>) -> String {
++    let c = match cmd {
++        Some(c) => c,
++        None => return text.to_string(),
++    };
++    let ci = format!("{}i", c);
++    let mut t = text.to_string();
++    // bash
++    t = t.replace("\\builtin unalias z ", &format!("\\builtin unalias {} ", c));
++    t = t.replace("function z() {", &format!("function {}() {{", c));
++    t = t.replace("\\builtin unalias zi ", &format!("\\builtin unalias {} ", ci));
++    t = t.replace("function zi() {", &format!("function {}() {{", ci));
++    t = t.replace("READLINE_LINE=\"z ", &format!("READLINE_LINE=\"{} ", c));
++    t = t.replace("\\builtin complete -F __zoxide_z_complete -o filenames -- z", &format!("\\builtin complete -F __zoxide_z_complete -o filenames -- {}", c));
++    t = t.replace("\\builtin complete -r zi ", &format!("\\builtin complete -r {} ", ci));
++    // zsh
++    t = t.replace("function z() {", &format!("function {}() {{", c));
++    t = t.replace("function zi() {", &format!("function {}() {{", ci));
++    t = t.replace("BUFFER=\"z ", &format!("BUFFER=\"{} ", c));
++    t = t.replace("\\compdef __zoxide_z_complete z", &format!("\\compdef __zoxide_z_complete {}", c));
++    // fish
++    t = t.replace("abbr --erase z ", &format!("abbr --erase {} ", c));
++    t = t.replace("complete --erase --command z", &format!("complete --erase --command {}", c));
++    t = t.replace("alias z=__zoxide_z", &format!("alias {}=__zoxide_z", c));
++    t = t.replace("abbr --erase zi ", &format!("abbr --erase {} ", ci));
++    t = t.replace("complete --erase --command zi", &format!("complete --erase --command {}", ci));
++    t = t.replace("alias zi=__zoxide_zi", &format!("alias {}=__zoxide_zi", ci));
++    // powershell
++    t = t.replace("Set-Alias -Name z -Value __zoxide_z ", &format!("Set-Alias -Name {} -Value __zoxide_z ", c));
++    t = t.replace("Set-Alias -Name zi -Value __zoxide_zi ", &format!("Set-Alias -Name {} -Value __zoxide_zi ", ci));
++    // posix
++    t = t.replace("\\command unalias z ", &format!("\\command unalias {} ", c));
++    t = t.replace("\nz() {", &format!("\n{}() {{", c));
++    t = t.replace("\\command unalias zi ", &format!("\\command unalias {} ", ci));
++    t = t.replace("\nzi() {", &format!("\n{}() {{", ci));
++    // xonsh
++    t = t.replace("builtins.aliases[\"z\"] = __zoxide_z", &format!("builtins.aliases[\"{}\"] = __zoxide_z", c));
++    t = t.replace("builtins.aliases[\"zi\"] = __zoxide_zi", &format!("builtins.aliases[\"{}\"] = __zoxide_zi", ci));
++    // tcsh
++    t = t.replace("alias z __zoxide_z", &format!("alias {} __zoxide_z", c));
++    t = t.replace("alias zi __zoxide_zi", &format!("alias {} __zoxide_zi", ci));
++    // elvish
++    t = t.replace("edit:add-var z~ $__zoxide_z~", &format!("edit:add-var {}~ $__zoxide_z~", c));
++    t = t.replace("edit:add-var zi~ $__zoxide_zi~", &format!("edit:add-var {}~ $__zoxide_zi~", ci));
++    t = t.replace("arg-completer[z] =", &format!("arg-completer[{}] =", c));
++    t = t.replace("arg-completer[zi] =", &format!("arg-completer[{}] =", ci));
++    // nushell
++    t = t.replace("alias z = __zoxide_z", &format!("alias {} = __zoxide_z", c));
++    t = t.replace("alias zi = __zoxide_zi", &format!("alias {} = __zoxide_zi", ci));
++    t
++}
