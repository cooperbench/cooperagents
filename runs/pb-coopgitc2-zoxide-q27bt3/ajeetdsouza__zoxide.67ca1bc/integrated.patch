+use std::process::exit;
+
+const INIT_HELP: &str = "zoxide-init 0.9.9
+Ajeet D'Souza <98ajeet@gmail.com>
+https://github.com/ajeetdsouza/zoxide
+
+Generate shell configuration
+
+Usage:
+  executable init [OPTIONS] <SHELL>
+
+Arguments:
+  <SHELL>  [possible values: bash, elvish, fish, nushell, posix, powershell, tcsh, xonsh, zsh]
+
+Options:
+      --no-cmd       Prevents zoxide from defining the `z` and `zi` commands
+      --cmd <CMD>    Changes the prefix of the `z` and `zi` commands [default: z]
+      --hook <HOOK>  Changes how often zoxide increments a directory's score [default: pwd] [possible values: none, prompt, pwd]
+  -h, --help         Print help
+  -V, --version      Print version
+
+Environment variables:
+  _ZO_DATA_DIR          Path for zoxide data files
+  _ZO_ECHO              Print the matched directory before navigating to it when set to 1
+  _ZO_EXCLUDE_DIRS      List of directory globs to be excluded
+  _ZO_FZF_OPTS          Custom flags to pass to fzf
+  _ZO_MAXAGE            Maximum total age after which entries start getting deleted
+  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths
+";
+
+pub fn run(args: &[String]) {
+    let mut shell: Option<String> = None;
+    let mut cmd: Option<String> = None;
+    let mut hook = String::new();
+    let mut no_cmd = false;
+    let mut i = 0;
+    while i < args.len() {
+        let a = args[i].clone();
+        match a.as_str() {
+            "-h" | "--help" => { print!("{}", INIT_HELP); exit(0); }
+            "-V" | "--version" => { println!("zoxide 0.9.9"); exit(0); }
+            "--cmd" => { if i + 1 < args.len() { cmd = Some(args[i + 1].clone()); i += 1; } }
+            "--no-cmd" => { no_cmd = true; }
+            "--hook" => { if i + 1 < args.len() { hook = args[i + 1].clone(); i += 1; } }
+            other => {
+                if other.starts_with('-') && other != "-" {
+                    eprint!("{}", INIT_HELP);
+                    exit(2);
+                }
+                shell = Some(other.to_string());
+            }
+        }
+        i += 1;
+    }
+
+    let shell = match shell {
+        Some(s) => s,
+        None => {
+            eprintln!(
+                "error: the following required arguments were not provided:\n  <SHELL>\n\nUsage: executable init{}{}\n\nFor more information, try '--help'.",
+                if cmd.is_some() { " --cmd <CMD>" } else { "" },
+                if no_cmd { " --no-cmd" } else { "" }
+            );
+            exit(2)
+        }
+    };
+
+    match shell.as_str() {
+        "bash" => { let t = bash_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "zsh" => { let t = zsh_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "fish" => { let t = fish_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "posix" => { let t = posix_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "powershell" => { let t = powershell_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "xonsh" => { let t = xonsh_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "tcsh" => { let t = tcsh_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "elvish" => { let t = elvish_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        "nushell" => { let t = nushell_base(&hook, no_cmd); let t = apply_cmd(t, cmd.as_deref()); print!("{}", t); }
+        _ => {
+            eprintln!("error: invalid value '{}' for '<SHELL>'", shell);
+            eprintln!("  [possible values: bash, elvish, fish, nushell, posix, powershell, tcsh, xonsh, zsh]");
+            eprintln!();
+            if let Some(sim) = similar(&shell) {
+                eprintln!("  tip: a similar value exists: '{}'", sim);
+                eprintln!();
+            }
+            eprintln!("For more information, try '--help'.");
+            exit(2)
+        }
+    }
+}
+
+fn apply_cmd(text: &str, cmd: Option<&str>) -> String {
+    let c = match cmd {
+        Some(c) => c,
+        None => return text.to_string(),
+    };
+    let ci = format!("{}i", c);
+    let mut t = text.to_string();
+    // bash
+    t = t.replace("\\builtin unalias z ", &format!("\\builtin unalias {} ", c));
+    t = t.replace("function z() {", &format!("function {}() {{", c));
+    t = t.replace("\\builtin unalias zi ", &format!("\\builtin unalias {} ", ci));
+    t = t.replace("function zi() {", &format!("function {}() {{", ci));
+    t = t.replace("READLINE_LINE=\"z ", &format!("READLINE_LINE=\"{} ", c));
+    t = t.replace("\\builtin complete -F __zoxide_z_complete -o filenames -- z", &format!("\\builtin complete -F __zoxide_z_complete -o filenames -- {}", c));
+    t = t.replace("\\builtin complete -r zi ", &format!("\\builtin complete -r {} ", ci));
+    // zsh
+    t = t.replace("function z() {", &format!("function {}() {{", c));
+    t = t.replace("function zi() {", &format!("function {}() {{", ci));
+    t = t.replace("BUFFER=\"z ", &format!("BUFFER=\"{} ", c));
+    t = t.replace("\\compdef __zoxide_z_complete z", &format!("\\compdef __zoxide_z_complete {}", c));
+    // fish
+    t = t.replace("abbr --erase z ", &format!("abbr --erase {} ", c));
+    t = t.replace("complete --erase --command z", &format!("complete --erase --command {}", c));
+    t = t.replace("alias z=__zoxide_z", &format!("alias {}=__zoxide_z", c));
+    t = t.replace("abbr --erase zi ", &format!("abbr --erase {} ", ci));
+    t = t.replace("complete --erase --command zi", &format!("complete --erase --command {}", ci));
+    t = t.replace("alias zi=__zoxide_zi", &format!("alias {}=__zoxide_zi", ci));
+    // powershell
+    t = t.replace("Set-Alias -Name z -Value __zoxide_z ", &format!("Set-Alias -Name {} -Value __zoxide_z ", c));
+    t = t.replace("Set-Alias -Name zi -Value __zoxide_zi ", &format!("Set-Alias -Name {} -Value __zoxide_zi ", ci));
+    // posix
+    t = t.replace("\\command unalias z ", &format!("\\command unalias {} ", c));
+    t = t.replace("\nz() {", &format!("\n{}() {{", c));
+    t = t.replace("\\command unalias zi ", &format!("\\command unalias {} ", ci));
+    t = t.replace("\nzi() {", &format!("\n{}() {{", ci));
+    // xonsh
+    t = t.replace("builtins.aliases[\"z\"] = __zoxide_z", &format!("builtins.aliases[\"{}\"] = __zoxide_z", c));
+    t = t.replace("builtins.aliases[\"zi\"] = __zoxide_zi", &format!("builtins.aliases[\"{}\"] = __zoxide_zi", ci));
+    // tcsh
+    t = t.replace("alias z __zoxide_z", &format!("alias {} __zoxide_z", c));
+    t = t.replace("alias zi __zoxide_zi", &format!("alias {} __zoxide_zi", ci));
+    // elvish
+    t = t.replace("edit:add-var z~ $__zoxide_z~", &format!("edit:add-var {}~ $__zoxide_z~", c));
+    t = t.replace("edit:add-var zi~ $__zoxide_zi~", &format!("edit:add-var {}~ $__zoxide_zi~", ci));
+    t = t.replace("arg-completer[z] =", &format!("arg-completer[{}] =", c));
+    t = t.replace("arg-completer[zi] =", &format!("arg-completer[{}] =", ci));
+    // nushell
+    t = t.replace("alias z = __zoxide_z", &format!("alias {} = __zoxide_z", c));
+    t = t.replace("alias zi = __zoxide_zi", &format!("alias {} = __zoxide_zi", ci));
+    t
+}
+
+fn similar(s: &str) -> Option<&'static str> {
+    let vals = ["bash", "elvish", "fish", "nushell", "posix", "powershell", "tcsh", "xonsh", "zsh"];
+    let mut best: Option<&str> = None;
+    let mut bestd = 1000usize;
+    for v in vals.iter() {
+        let d = edit_distance(s, v);
+        if d < bestd {
+            bestd = d;
+            best = Some(*v);
+        }
+    }
+    if bestd <= 3 { best } else { None }
+}
+
+fn edit_distance(a: &str, b: &str) -> usize {
+    let a: Vec<char> = a.chars().collect();
+    let b: Vec<char> = b.chars().collect();
+    let mut dp = vec![vec![0usize; b.len() + 1]; a.len() + 1];
+    for j in 0..=b.len() {
+        dp[0][j] = j;
+    }
+    for i in 0..=a.len() {
+        dp[i][0] = i;
+    }
+    for i in 1..=a.len() {
