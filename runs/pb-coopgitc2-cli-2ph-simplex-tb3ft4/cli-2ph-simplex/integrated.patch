++def _compute_basic_variables(final_tableau, n, m, eps=EPS):
++    """Return ``{"name": value}`` for the basic variables of the final tableau.
+ 
+-    try:
+-        final_tableau = two_phase_simplex(
+-            args.objective_coeff,
+-            args.constraints_coeff,
+-            args.constraints_relational_operators,
+-            args.constraints_rhs
++    ``final_tableau`` has layout ``[Z, x1..xn, s1..sm, RHS]`` with ``m``
++    constraint rows followed by the objective row.  For each constraint row
++    the basic variable is the first variable column (decision variables
++    first, then slack/surplus) that forms a unit column in the constraint
++    block; its value is that row's ``RHS``.
++    """
++    basic = {}
++    num_rows = len(final_tableau)
++    # The last row is the objective row; constraint rows are 0 .. num_rows-2.
++    constraint_rows = num_rows - 1
++    for r in range(constraint_rows):
++        row = final_tableau[r]
++        chosen = None
++        # x1..xn occupy columns 1..n, s1..sm occupy columns (1+n) .. (1+n+m-1).
++        for j in range(1, 1 + n + m):
++            if abs(row[j] - 1.0) >= eps:
++                continue
++            # Confirm the column is ~0 in every other constraint row.
++            is_unit = True
++            for i in range(constraint_rows):
++                if i == r:
++                    continue
++                if abs(final_tableau[i][j]) >= eps:
++                    is_unit = False
++                    break
++            if not is_unit:
++                continue
++            if j <= n:
++                chosen = "x%d" % j
++            else:
++                chosen = "s%d" % (j - n)
++            break
++        if chosen is not None:
++            basic[chosen] = float(final_tableau[r][-1])
++    return basic
++
