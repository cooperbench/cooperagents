++def _render_terms(coefficients):
++    """Render a list of coefficients (for ``x1..xn``) into a term string.
++
++    Positive terms come first, then negative, then zero; within each group the
++    variable index order is preserved.  The first term carries no separator; a
++    leading negative term therefore starts with ``-`` and no space, while later
++    negative terms use `` - ``.  Positive/zero later terms use `` + ``.
++    """
++    positive, negative, zero = [], [], []
++    for index, coeff in enumerate(coefficients):
++        quantized = round_half_up(coeff)
++        if quantized > 0:
++            positive.append((quantized, index))
++        elif quantized < 0:
++            negative.append((quantized, index))
++        else:
++            zero.append((quantized, index))
++
++    parts = []
++    first = True
++    for group in (positive, negative, zero):
++        for quantized, index in group:
++            name = "x%d" % (index + 1)
++            if quantized > 0:
++                magnitude = _format_number(quantized)
++                body = magnitude + "*" + name
++            elif quantized < 0:
++                magnitude = _format_number(-quantized)
++                body = magnitude + "*" + name
++            else:
++                body = "0.00*" + name
++            if first:
++                if quantized < 0:
++                    parts.append("-" + body)
++                else:
++                    parts.append(body)
++                first = False
++            else:
++                sep = " - " if quantized < 0 else " + "
++                parts.append(sep + body)
++    return "".join(parts)
