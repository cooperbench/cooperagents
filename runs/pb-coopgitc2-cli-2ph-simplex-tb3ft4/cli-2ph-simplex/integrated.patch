++"""Two-phase simplex algorithm and minimum-pivot planning.
++
++Public entry point : :func:`two_phase_simplex`
++"""
++
++from copy import deepcopy
++from collections import deque
++
++from simplex.tableau import (
++    EPS,
++    build_phase1_tableau,
++    canonicalize_objective,
++    setup_phase2_objective,
++    is_optimal,
++    select_entering,
++    select_leaving,
++    min_ratio_rows,
++    all_valid_pivots,
++    pivot,
++    variable_columns,
++    objective_value,
++)
++
++
++# ---------------------------------------------------------------------------
++# Helpers
++# ---------------------------------------------------------------------------
++def _apply_pivot(rows, basis, j, r):
++    """Pivot column ``j`` into row ``r`` and update the basis in place."""
++    pivot(rows, r, j)
++    basis[r] = j
++
++
++def _run_bland(rows, col_names, basis):
++    """Run a single phase using Bland's rule until optimality.
++
++    Raises :class:`Exception` if the phase is unbounded.
++    """
++    while not is_optimal(rows, col_names):
++        j = select_entering(rows, col_names)
++        if j < 0:
++            break
++        r = select_leaving(rows, j)
++        if r < 0:
++            # No leaving row -> the objective is unbounded.
++            raise Exception("The problem is unbounded.")
++        _apply_pivot(rows, basis, j, r)
++    return rows, basis
++
++
++def _transition_to_phase2(rows, col_names, basis, artificial_col, objective_coeff):
++    """Move from a feasible phase-1 state to a phase-2 state.
++
++    De-basic any artificial that is still a basic variable (degenerate
++    feasibility), drop the artificial columns, install the original
++    objective, and canonicalise it.  Returns ``(rows, col_names, basis)``.
++    """
++    art_indices = set(artificial_col.values())
++
++    # De-basic any artificial that is still a basic variable.
++    for row_idx in range(len(rows) - 1):
++        if basis[row_idx] in art_indices:
++            chosen = None
++            for j in variable_columns(col_names):
++                if j not in art_indices and abs(rows[row_idx][j]) > EPS:
++                    chosen = j
++                    break
++            if chosen is not None:
++                pivot(rows, row_idx, chosen)
++                basis[row_idx] = chosen
++            # If no non-artificial column is available the row is redundant;
++            # the artificial stays (it will be removed below).
++
++    # Drop the artificial columns.
++    new_rows = [[row[k] for k in range(len(row)) if k not in art_indices] for row in rows]
++    new_col_names = [c for k, c in enumerate(col_names) if k not in art_indices]
++
++    # Basis columns for x/s are unchanged when artificial columns are dropped.
++    new_basis = list(basis)
++    setup_phase2_objective(new_rows, objective_coeff, new_basis, new_col_names)
++    return new_rows, new_col_names, new_basis
++
++
++# ---------------------------------------------------------------------------
++# Core solver (no initial pivots) -- uses Bland's rule
++# ---------------------------------------------------------------------------
++def _solve(objective_coeff, constraints_coeff, ops, rhs):
++    """Solve the LP, returning ``(final_tableau, col_names, basis)``.
++
++    Raises :class:`Exception` if the problem is unbounded.  Infeasible problems
++    return the best-effort (last) tableau without raising.
++    """
++    rows, col_names, basis, artificial_col, _ = build_phase1_tableau(
++        objective_coeff, constraints_coeff, ops, rhs
++    )
++    canonicalize_objective(rows, basis)
++
++    # Phase 1.
++    _run_bland(rows, col_names, basis)
++
++    # Feasibility: phase-1 objective value (=-sum(artificials)) must be >= -EPS.
++    feasible = objective_value(rows) >= -EPS
++
++    # Phase 2.
++    rows2, col2, basis2 = _transition_to_phase2(
++        rows, col_names, basis, artificial_col, objective_coeff
++    )
++    if feasible:
++        _run_bland(rows2, col2, basis2)
++    # If infeasible we still return the best-effort phase-2 tableau.
++    return rows2, col2, basis2
++
++
++# ---------------------------------------------------------------------------
++# Minimum-pivot planning (with --initial_pivots)
++# ---------------------------------------------------------------------------
++def _debasic_and_remove(rows, col_names, basis, artificial_col, objective_coeff):
++    """Transition to phase 2 (de-basic, drop artificials, install objective)."""
++    return _transition_to_phase2(rows, col_names, basis, artificial_col, objective_coeff)
++
++
++def _min_path(rows, col_names, basis, artificial_col, objective_coeff):
++    """Find the minimum-pivot continuation to a phase-2 optimal tableau.
++
++    ``rows`` is the phase-1 state *after* any provided initial pivots.  Returns
++    a list of pivot records, each a dict with keys ``phase``,
++    ``enter_column`` and ``leave_row`` plus the resulting tableau (a deep
++    copy) under ``tableau``.  The phase-1 -> phase-2 transition (de-basic and
++    artificial-column removal) is a free operation and is not itself logged.
++    """
++    # Each BFS node carries the live state.  Edges are valid pivots (cost 1)
++    # or a free phase transition (cost 0).  We BFS so the first goal reached is
++    # at the minimum number of continuation pivots.
++    start = {
++        "rows": rows,
++        "col_names": col_names,
++        "basis": list(basis),
++        "artificial_col": artificial_col,
++        "phase": 1,
++    }
++    visited = {(1, tuple(basis))}
++    queue = deque()
++    queue.append((start, []))
++
++    while queue:
++        state, path = queue.popleft()
++        rows_ = state["rows"]
++        col_names_ = state["col_names"]
++        basis_ = state["basis"]
++        phase = state["phase"]
++
++        if phase == 2:
++            if is_optimal(rows_, col_names_):
++                return path, state
++            for (j, r) in all_valid_pivots(rows_, col_names_):
++                new_rows = deepcopy(rows_)
++                new_basis = list(basis_)
++                _apply_pivot(new_rows, new_basis, j, r)
++                nkey = (2, tuple(new_basis))
++                if nkey in visited:
++                    continue
++                visited.add(nkey)
++                queue.append((
++                    {"rows": new_rows, "col_names": col_names_,
++                     "basis": new_basis, "artificial_col": artificial_col,
++                     "phase": 2},
++                    path + [{"phase": 2, "enter_column": col_names_[j],
++                            "leave_row": r, "tableau": deepcopy(new_rows)}],
++                ))
++            continue
++
++        # phase 1
++        if not is_optimal(rows_, col_names_):
++            for (j, r) in all_valid_pivots(rows_, col_names_):
++                new_rows = deepcopy(rows_)
++                new_basis = list(basis_)
++                _apply_pivot(new_rows, new_basis, j, r)
++                nkey = (1, tuple(new_basis))
++                if nkey in visited:
++                    continue
++                visited.add(nkey)
++                queue.append((
++                    {"rows": new_rows, "col_names": col_names_,
++                     "basis": new_basis, "artificial_col": artificial_col,
++                     "phase": 1},
++                    path + [{"phase": 1, "enter_column": col_names_[j],
++                            "leave_row": r, "tableau": deepcopy(new_rows)}],
++                ))
++        else:
++            # Phase 1 is optimal: transition (free) to phase 2.
++            rows2, col2, basis2 = _transition_to_phase2(
++                deepcopy(rows_), list(col_names_), list(basis_),
++                artificial_col, objective_coeff,
++            )
++            nkey = (2, tuple(basis2))
++            if nkey in visited:
++                continue
++            visited.add(nkey)
++            queue.append((
++                {"rows": rows2, "col_names": col2, "basis": basis2,
++                 "artificial_col": artificial_col, "phase": 2},
++                list(path),
++            ))
++    return [], start
++
