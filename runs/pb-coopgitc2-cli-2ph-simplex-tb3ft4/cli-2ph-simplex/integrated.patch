++def _check_degeneracy(final_tableau, m, eps=EPS):
++    """Return ``True`` if any constraint row has an ``RHS`` of ~0.
++
++    The objective row is never considered.
++    """
++    for i in range(m):
++        if abs(final_tableau[i][-1]) < eps:
++            return True
++    return False
