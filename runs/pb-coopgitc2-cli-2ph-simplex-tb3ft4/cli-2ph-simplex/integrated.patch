++# Public entry points
++# ---------------------------------------------------------------------------
++def two_phase_simplex(objective_coeff, constraints_coeff, ops, rhs, initial_pivots=None):
++    """Solve the LP; return ``(final_tableau, pivot_log)``.
++
++    ``pivot_log`` is ``None`` when no initial pivots were supplied, otherwise a
++    list of pivot-record dicts::
++
++        {"step": int, "phase": int, "enter_column": str,
++         "leave_row": str, "tableau": list[list[float]]}
++    """
++    if initial_pivots is None:
++        rows, col_names, basis = _solve(
++            objective_coeff, constraints_coeff, ops, rhs
++        )
++        return rows, None
++
++    # ---- initial_pivots path ----------------------------------------------
++    n = len(objective_coeff)
++    m = len(constraints_coeff)
++
++    rows, col_names, basis, artificial_col, _ = build_phase1_tableau(
++        objective_coeff, constraints_coeff, ops, rhs
++    )
++    canonicalize_objective(rows, basis)
++
++    log = []
++
++    def _row_index(label):
++        return int(label[1:])
++
++    # Apply the provided initial pivots (a required prefix) and log them.
++    for spec in initial_pivots:
++        enter_name = spec["enter_column"]
++        leave_label = spec["leave_row"]
++        j = col_names.index(enter_name)
++        r = _row_index(leave_label)
++        _apply_pivot(rows, basis, j, r)
++        log.append({
++            "step": len(log) + 1,
++            "phase": 1,
++            "enter_column": enter_name,
++            "leave_row": leave_label,
++            "tableau": deepcopy(rows),
++        })
++
++    # Minimum-pivot continuation.
++    cont, final_state = _min_path(
++        rows, col_names, basis, artificial_col, objective_coeff
++    )
++    for rec in cont:
++        log.append({
++            "step": len(log) + 1,
++            "phase": rec["phase"],
++            "enter_column": rec["enter_column"],
++            "leave_row": "R%d" % rec["leave_row"],
++            "tableau": rec["tableau"],
++        })
++
++    return final_state["rows"], log
