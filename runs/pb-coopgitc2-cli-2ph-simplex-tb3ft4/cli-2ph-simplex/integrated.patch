++"""Tableau construction and simplex pivoting for the two-phase simplex method.
++
++Column layout
++-------------
++Phase 1 (artificials present) : ``[Z, x1..xn, s1..sm, a1..ar, RHS]``
++Phase 2 / final              : ``[Z, x1..xn, s1..sm, RHS]``
++
++``Z`` is always index 0 and ``RHS`` is always the last column.
++
++The objective row is the **last** row of the tableau.  It is stored in the
++canonical maximization form::
++
++    Z - sum(c_j * x_j) = 0
++
++so an optimal tableau has every variable-column entry ``>= -EPS`` and the
++objective value is ``-tableau[-1][RHS]``.
++"""
++
++EPS = 1e-9
++# Small tolerance for "is this entry effectively zero".
++ZERO = 1e-12
++
++# Constraint-row label for the i-th original constraint (zero based).
++ROW_LABEL = "R"  # R0, R1, ...
++
++
++# ---------------------------------------------------------------------------
++# Construction
++# ---------------------------------------------------------------------------
++def build_phase1_tableau(objective_coeff, constraints_coeff, ops, rhs):
++    """Build the phase-1 tableau.
++
++    Parameters
++    ----------
++    objective_coeff : list[float]
++    constraints_coeff : list[list[float]]
++    ops : list[str] -- one of ``<=``, ``>=``, ``=`` per constraint.
++    rhs : list[float]
++
++    Returns
++    -------
++    rows : list[list[float]]
++        Constraint rows followed by the (canonical phase-1) objective row.
++    col_names : list[str]
++        Column names ``[Z, x1..xn, s1..sm, a1..ar, RHS]``.
++    basis : list[int]
++        Column index of the basic variable of each constraint row.
++    artificial_col : dict[int, int]
++        Maps a constraint row index to its artificial column index.
++    artificial_constraints : list[int]
++        Constraint indices that received an artificial variable.
++    """
++    valid = {"<=", ">=", "="}
++    for op in ops:
++        if op not in valid:
++            raise ValueError(
++                "Invalid relational operator %r; expected one of <=, >=, =." % (op,)
++            )
++
++    n = len(objective_coeff)
++    m = len(constraints_coeff)
++
++    # Column names start with Z, the decision variables, then slack/surplus.
++    col_names = ["Z"] + ["x%d" % (j + 1) for j in range(n)] + ["s%d" % (i + 1) for i in range(m)]
++
++    # Artificial columns (one for each >= or = constraint), in constraint order.
++    artificial_col = {}
++    artificial_constraints = []
++    for i in range(m):
++        if ops[i] in (">=", "="):
++            artificial_col[i] = len(col_names)
++            col_names.append("a%d" % (len(artificial_constraints) + 1))
++            artificial_constraints.append(i)
++
++    col_names.append("RHS")
++    width = len(col_names)
++
++    rows = []
++    basis = []
++    for i in range(m):
++        row = [0.0] * width
++        row[0] = 0.0  # Z
++        # Decision-variable coefficients.
++        for j in range(n):
++            row[1 + j] = float(constraints_coeff[i][j])
++        # Slack / surplus column for this constraint.
++        row[1 + n + i] = 1.0 if ops[i] == "<=" else -1.0
++        # RHS.
++        row[-1] = float(rhs[i])
++        if i in artificial_col:
++            row[artificial_col[i]] = 1.0
++        rows.append(row)
++
++        # Basic variable of this row.
++        if ops[i] == "<=":
++            basis.append(1 + n + i)
++        else:  # >= or =
++            basis.append(artificial_col[i])
++
++    # Phase-1 objective row: minimises sum(artificials)  <=>  max -sum(artificials).
++    obj = [0.0] * width
++    obj[0] = 1.0  # Z
++    for art_col in artificial_col.values():
++        obj[art_col] = 1.0
++    rows.append(obj)
++
++    return rows, col_names, basis, artificial_col, artificial_constraints
++
++
++def canonicalize_objective(rows, basis):
++    """Eliminate the basic-variable columns from the (raw) objective row.
++
++    After this call every basic column has ``0`` in the objective row, which is
++    required before an optimality / ratio test.
++    """
++    obj = rows[-1]
++    for row_idx, col_idx in enumerate(basis):
++        factor = obj[col_idx]
++        if abs(factor) > ZERO:
++            ref = rows[row_idx]
++            for k in range(len(obj)):
++                obj[k] = obj[k] - factor * ref[k]
++
++
++def setup_phase2_objective(rows, objective_coeff, basis, col_names):
++    """Replace the objective row with the original objective (canonicalised)."""
++    ncols = len(col_names)
++    obj = [0.0] * ncols
++    obj[0] = 1.0  # Z
++    n = len(objective_coeff)
++    for j in range(n):
++        # column index of x_{j+1} is 1 + j
++        obj[1 + j] = -float(objective_coeff[j])
++    rows[-1] = obj
++    canonicalize_objective(rows, basis)
++
++
++# ---------------------------------------------------------------------------
++# Optimality / pivot selection
++# ---------------------------------------------------------------------------
++def variable_columns(col_names):
++    """Indices of the variable columns (excluding ``Z`` at 0 and ``RHS`` at end)."""
++    return list(range(1, len(col_names) - 1))
++
++
++def is_optimal(rows, col_names, eps=EPS):
++    """True when every reduced cost (variable column) is ``>= -eps``."""
++    obj = rows[-1]
++    for j in variable_columns(col_names):
++        if obj[j] < -eps:
++            return False
++    return True
++
++
++def select_entering(rows, col_names, eps=EPS):
++    """Bland's rule: smallest-index column with a negative reduced cost."""
++    obj = rows[-1]
++    for j in variable_columns(col_names):
++        if obj[j] < -eps:
++            return j
++    return -1
++
++
++def min_ratio_rows(rows, j, eps=EPS):
++    """All constraint rows attaining the minimum ratio for entering column ``j``.
++
++    Returns ``(candidates, best)`` where ``candidates`` is the list of row
++    indices attaining the smallest ``RHS / rows[r][j]`` over rows with a
++    positive pivot-column value, and ``best`` is that ratio (``inf`` if none).
++    """
++    best = None
++    candidates = []
++    for i in range(len(rows) - 1):
++        val = rows[i][j]
++        if val > eps:
++            ratio = rows[i][-1] / val
++            if best is None or ratio < best - eps:
++                best = ratio
++                candidates = [i]
++            elif abs(ratio - best) <= eps:
++                candidates.append(i)
++    return candidates, (best if best is not None else float("inf"))
++
++
++def select_leaving(rows, j, eps=EPS):
++    """Bland's rule: smallest-index row attaining the minimum ratio."""
++    candidates, _ = min_ratio_rows(rows, j, eps)
++    return candidates[0] if candidates else -1
++
++
++def all_valid_pivots(rows, col_names, eps=EPS):
++    """Every simplex-valid pivot ``(entering column, leaving row)`` in this state.
++
++    The entering column must have a negative reduced cost; the leaving row must
++    attain the minimum ratio (ties included).
++    """
++    obj = rows[-1]
++    pivots = []
++    for j in variable_columns(col_names):
++        if obj[j] < -eps:
++            candidates, _ = min_ratio_rows(rows, j, eps)
++            for r in candidates:
++                pivots.append((j, r))
++    return pivots
++
++
++def pivot(rows, r, j, eps=EPS):
++    """Perform a simplex pivot on column ``j``, row ``r`` (in place)."""
++    pivot_val = rows[r][j]
++    if abs(pivot_val) < eps:
++        raise Exception("Pivot element is (near) zero.")
++    inv = 1.0 / pivot_val
++    rows[r] = [v * inv for v in rows[r]]
++    for i in range(len(rows)):
++        if i != r:
++            factor = rows[i][j]
++            if abs(factor) > ZERO:
++                ref = rows[r]
++                rows[i] = [rows[i][k] - factor * ref[k] for k in range(len(rows[i]))]
++    # Clean up residual numerical noise in the pivot column.
++    for i in range(len(rows)):
++        if i != r and abs(rows[i][j]) < ZERO:
++            rows[i][j] = 0.0
++    rows[r][j] = 1.0
++
++
++def objective_value(rows):
++    """RHS of the objective row (``-`` the maximization objective value)."""
++    return rows[-1][-1]
