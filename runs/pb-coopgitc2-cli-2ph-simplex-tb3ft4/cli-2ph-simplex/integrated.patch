\ No newline at end of file
+Public names
+-------------
+* :data:`FinalTableau` -- the type alias for the final simplex tableau.
+* :func:`as_float_tableau` -- coerce a tableau to a list of lists of floats.
+* :func:`round_half_up` -- half-up decimal rounding to 2 places.
+* :func:`build_problem_report` -- text representation of the *parsed* input LP.
+"""
+
+from decimal import Decimal, ROUND_HALF_UP
+
+# The final simplex tableau is a 2D array of floats.
+FinalTableau = list  # list[list[float]]
+
+
+# ---------------------------------------------------------------------------
+# Numeric helpers
+# ---------------------------------------------------------------------------
+def as_float_tableau(tableau):
+    """Return a deep copy of ``tableau`` with every entry coerced to ``float``."""
+    return [[float(value) for value in row] for row in tableau]
+
+
+def _to_decimal(value):
+    """Convert a numeric value to a :class:`Decimal` without binary artefacts."""
+    text = repr(float(value))
+    return Decimal(text)
+
+
+def round_half_up(value):
+    """Round ``value`` to 2 decimal places using half-up (away from zero) rounding.
+
+    Returns a :class:`Decimal` quantized to two places.
+    """
+    return _to_decimal(value).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+def _format_number(quantized):
+    """Format a quantized :class:`Decimal`.
+
+    Zero (including ``-0.00``) is rendered as a positive ``0.00``; any other
+    value keeps its sign and is rendered with two decimals.
+    """
+    if quantized == 0:
+        return "0.00"
+    return format(quantized, "f")
+
+
+# ---------------------------------------------------------------------------
+# Problem report
+# ---------------------------------------------------------------------------
+def _render_terms(coefficients):
+    """Render a list of coefficients (for ``x1..xn``) into a term string.
+
+    Positive terms come first, then negative, then zero; within each group the
+    variable index order is preserved.  The first term carries no separator; a
+    leading negative term therefore starts with ``-`` and no space, while later
+    negative terms use `` - ``.  Positive/zero later terms use `` + ``.
+    """
+    positive, negative, zero = [], [], []
+    for index, coeff in enumerate(coefficients):
+        quantized = round_half_up(coeff)
+        if quantized > 0:
+            positive.append((quantized, index))
+        elif quantized < 0:
+            negative.append((quantized, index))
+        else:
+            zero.append((quantized, index))
+
+    parts = []
+    first = True
+    for group in (positive, negative, zero):
+        for quantized, index in group:
+            name = "x%d" % (index + 1)
+            if quantized > 0:
+                magnitude = _format_number(quantized)
+                body = magnitude + "*" + name
+            elif quantized < 0:
+                magnitude = _format_number(-quantized)
+                body = magnitude + "*" + name
+            else:
+                body = "0.00*" + name
+            if first:
+                if quantized < 0:
+                    parts.append("-" + body)
+                else:
+                    parts.append(body)
+                first = False
+            else:
+                sep = " - " if quantized < 0 else " + "
+                parts.append(sep + body)
+    return "".join(parts)
+
+
+def _render_rhs(value):
+    """Render a right-hand-side value (its sign is preserved)."""
+    return _format_number(round_half_up(value))
+
+
+def build_problem_report(objective_coeff, constraints_coeff, operators, rhs):
+    """Return a UTF-8 text representation of the *parsed* input LP.
+
+    The report starts with the ``maximize`` line, then a blank line, then
+    ``subject to:`` followed by one indented constraint line per input
+    constraint (in input order), and finally the nonnegativity line.  No
+    trailing newline is added.
+    """
+    n = len(objective_coeff)
+    m = len(constraints_coeff)
+
+    lines = []
+    lines.append("maximize " + _render_terms(objective_coeff))
+    lines.append("")
+    lines.append("subject to:")
+
+    for i in range(m):
+        left = _render_terms(constraints_coeff[i])
+        right = _render_rhs(rhs[i])
+        lines.append("    " + left + " " + operators[i] + " " + right)
+
+    variables = ", ".join("x%d" % (index + 1) for index in range(n))
+    lines.append("    " + variables + " >= 0")
+
+    return "\n".join(lines)
