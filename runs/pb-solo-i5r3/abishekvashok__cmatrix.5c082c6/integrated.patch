diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..f146cee
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,297 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+// #include <math.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_DELAY 10
+#define MIN_DELAY 0
+
+typedef struct {
+    int width;
+    int height;
+    int x;
+    int y;
+    int async;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int old_style;
+    int rainbow;
+    int lambda;
+    int characters_change;
+    int tty;
+    int lock;
+    int linux_mode;
+    char message[256];
+    int message_len;
+    int color;
+    int use_japanese;
+    int force_term;
+    int x_mode;
+    int screensaver;
+    int use_shadow;
+    int delay;
+} config_t;
+
+static const char *color_names[] = {
+    "green", "red", "blue", "white", "yellow", "cyan", "magenta", "black"
+};
+
+static char *matrix_chars = "01";
+static char *katakana_chars = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static char *latin_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+static char *numbers = "0123456789";
+static char *symbols = "!@#$%^&*()_+-=[]{}|;':\",./<>?";
+
+static char *get_chars(int mode) {
+    if (mode == 1) return matrix_chars;
+    if (mode == 2) return katakana_chars;
+    if (mode == 3) return latin_chars;
+    if (mode == 4) return numbers;
+    if (mode == 5) return symbols;
+    return matrix_chars;
+}
+
+static int get_color_index(const char *color) {
+    for (int i = 0; i < 8; i++) {
+        if (strcasecmp(color, color_names[i]) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void parse_args(int argc, char *argv[], config_t *cfg) {
+    memset(cfg, 0, sizeof(config_t));
+    cfg->width = 80;
+    cfg->height = 24;
+    cfg->color = 0;
+    cfg->tty = 0;
+    cfg->message_len = 0;
+    cfg->delay = DEFAULT_DELAY;
+    
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            cfg->async = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            cfg->bold = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            cfg->all_bold = 1;
+            cfg->bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            cfg->use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            cfg->force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            cfg->linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            cfg->lock = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            cfg->old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            cfg->no_bold = 1;
+            cfg->bold = 0;
+            cfg->all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            cfg->screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            cfg->x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            cfg->rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            cfg->lambda = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            cfg->characters_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            int delay = atoi(argv[++i]);
+            if (delay < MIN_DELAY || delay > MAX_DELAY) {
+                printf("Error opening terminal: unknown.\n");
+                exit(1);
+            }
+            cfg->delay = delay;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            cfg->color = get_color_index(argv[++i]);
+            if (cfg->color < 0) {
+                printf(" Invalid color selection\n");
+                printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+                exit(0);
+            }
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            strncpy(cfg->message, argv[++i], sizeof(cfg->message) - 1);
+            cfg->message_len = strlen(cfg->message);
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            cfg->tty = atoi(argv[++i]);
+        } else {
+            printf("Error: Unknown option %s\n", argv[i]);
+            print_usage();
+            exit(1);
+        }
+    }
+    
+    if (cfg->color < 0) {
+        cfg->color = 0;
+    }
+}
+
+static void init_terminal(config_t *cfg) {
+    struct termios oldt, newt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return;
+    }
+    
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) == -1) {
+        return;
+    }
+}
+
+static void restore_terminal(void) {
+    struct termios oldt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return;
+    }
+    
+    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void set_cursor(int x, int y) {
+    printf("\033[%d;%dH", y, x);
+}
+
+static void set_color(int color) {
+    printf("\033[%dm", color + 30);
+}
+
+static void set_bold(int bold) {
+    if (bold) {
+        printf("\033[1m");
+    } else {
+        printf("\033[22m");
+    }
+}
+
+static void set_reset(void) {
+    printf("\033[0m");
+}
+
+static char get_random_char(int mode, int change) {
+    char *chars = get_chars(mode);
+    int len = strlen(chars);
+    int idx = rand() % len;
+    
+    if (change && mode == 0) {
+        if (rand() % 100 < 30) {
+            idx = rand() % len;
+        }
+    }
+    
+    return chars[idx];
+}
+
+static void run(config_t *cfg) {
+    srand(time(NULL));
+    
+    clear_screen();
+    
+    set_color(cfg->color);
+    
+    int rows = cfg->height;
+    int cols = cfg->width;
+    
+    for (int i = 0; i < rows; i++) {
+        for (int j = 0; j < cols; j++) {
+            char c = get_random_char(cfg->use_japanese ? 2 : 0, cfg->characters_change);
+            if (cfg->lambda) {
+                c = 'X';
+            }
+            printf("%c", c);
+        }
+        printf("\n");
+    }
+    
+    if (cfg->message_len > 0) {
+        printf("\033[%d;%dH", rows / 2, cols / 2);
+        printf("\033[1;37m%s\033[0m", cfg->message);
+    }
+    
+    sleep(cfg->delay);
+    
+    restore_terminal();
+}
+
+int main(int argc, char *argv[]) {
+    config_t cfg;
+    
+    parse_args(argc, argv, &cfg);
+    
+    if (cfg.x_mode) {
+        printf("X window mode not available in this build\n");
+        return 1;
+    }
+    
+    if (cfg.force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    init_terminal(&cfg);
+    
+    run(&cfg);
+    
+    restore_terminal();
+    
+    return 0;
+}
