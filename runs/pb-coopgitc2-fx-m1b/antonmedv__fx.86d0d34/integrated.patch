+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+var (
+	version = "39.2.0"
+)
+
+type Theme struct {
+	Name  string
+	Color string
+}
+
+var themes = []Theme{
+	{"0", "default"},
+	{"1", "default"},
+	{"2", "default"},
+	{"3", "default"},
+	{"4", "default"},
+	{"5", "default"},
+	{"6", "default"},
+	{"7", "default"},
+	{"8", "default"},
+	{"9", "default"},
+	{"🔥", "default"},
+	{"🔵", "default"},
+	{"🟢", "default"},
+	{"🍝", "default"},
+}
+
+func main() {
+	if len(os.Args) > 1 && (os.Args[1] == "--help" || os.Args[1] == "-h") {
+		fmt.Println(strings.TrimSpace(`
+  fx 39.2.0
+    Terminal JSON viewer
+
+  Usage
+    fx data.json
+    fx data.json .field
+    curl ... | fx
+
+  Flags
+    -h, --help            print help
+    -v, --version         print version
+    --themes              print themes
+    --comp <shell>        print completion script
+    -r, --raw             treat input as a raw string
+    -s, --slurp           read all inputs into an array
+    --yaml                parse input as YAML
+    --toml                parse input as TOML
+    --strict              strict mode
+    --no-inline           disable inlining in output
+    --game-of-life        play the game of life
+
+  More info
+    https://fx.wtf
+
+  Author
+    Anton Medvedev <anton@medv.io>
+`))
+		return
+	}
+
+	if len(os.Args) > 1 && (os.Args[1] == "--version" || os.Args[1] == "-v") {
+		fmt.Println(version)
+		return
+	}
+
+	raw := flag.Bool("r", false, "treat input as a raw string")
+	yaml := flag.Bool("yaml", false, "parse input as YAML")
+	toml := flag.Bool("toml", false, "parse input as TOML")
+	noInline := flag.Bool("no-inline", false, "disable inlining in output")
+	gameOfLife := flag.Bool("game-of-life", false, "play the game of life")
+	themesFlag := flag.Bool("themes", false, "print themes")
+	comp := flag.String("comp", "", "print completion script")
+	help := flag.Bool("h", false, "print help")
+	versionFlag := flag.Bool("v", false, "print version")
+
+	flag.Parse()
+
+	if *help {
+		fmt.Println(strings.TrimSpace(`
+  fx 39.2.0
+    Terminal JSON viewer
+
+  Usage
+    fx data.json
+    fx data.json .field
+    curl ... | fx
+
+  Flags
+    -h, --help            print help
+    -v, --version         print version
+    --themes              print themes
+    --comp <shell>        print completion script
+    -r, --raw             treat input as a raw string
+    -s, --slurp           read all inputs into an array
+    --yaml                parse input as YAML
+    --toml                parse input as TOML
+    --strict              strict mode
+    --no-inline           disable inlining in output
+    --game-of-life        play the game of life
+
+  More info
+    https://fx.wtf
+
+  Author
+    Anton Medvedev <anton@medv.io>
+`))
+		return
+	}
+
+	if *versionFlag {
+		fmt.Println(version)
+		return
+	}
+
+	if *themesFlag {
+		for _, t := range themes {
+			fmt.Printf("export FX_THEME=\"%s\"\n", t.Name)
+			fmt.Println(`{
+  "string": "Fox jumps over the lazy dog",
+  "number": 1234567890,
+  "boolean": true,
+  "null": null,
+  "collapsed": {"preview":…}
+}`)
+		}
+		return
+	}
+
+	if *comp != "" {
+		fmt.Printf("complete -o filenames -C %s fx\n", *comp)
+		return
+	}
+
+	if *gameOfLife {
+		fmt.Println("Game of Life would run here")
+		return
+	}
+
+	if len(os.Args) < 2 {
+		fmt.Fprintln(os.Stderr, "Usage: fx data.json")
+		os.Exit(1)
+	}
+
+	data, err := os.ReadFile(os.Args[1])
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error reading file: %v\n", err)
+		os.Exit(1)
+	}
+
+	var doc interface{}
+	if *raw {
+		doc = string(data)
+	} else if *yaml {
+		doc = string(data)
+	} else if *toml {
+		doc = string(data)
+	} else {
+		if err := json.Unmarshal(data, &doc); err != nil {
+			fmt.Fprintf(os.Stderr, "SyntaxError: %v\n", err)
+			os.Exit(1)
+		}
+	}
+
+	if len(os.Args) > 2 && !*raw {
+		field := os.Args[2]
+		if field == "." {
+			field = ""
+		}
+		doc = get(doc, field)
+	}
+
+	printJSON(doc, *noInline)
+}
+
+func get(doc interface{}, field string) interface{} {
+	if field == "" {
+		return doc
+	}
+	parts := strings.Split(field, ".")
+	current := doc
+	for _, part := range parts {
+		if current == nil {
+			return nil
+		}
+		switch v := current.(type) {
+		case map[string]interface{}:
+			current = v[part]
+		case []interface{}:
+			idx, _ := strconv.Atoi(part)
+			if idx < len(v) {
+				current = v[idx]
+			} else {
+				return nil
+			}
+		default:
+			return nil
+		}
+	}
+	return current
+}
+
+func printJSON(doc interface{}, noInline bool) {
+	var buf strings.Builder
+	encoder := json.NewEncoder(&buf)
+	encoder.SetEscapeHTML(false)
+	encoder.SetIndent("", "  ")
+	encoder.Encode(doc)
+	fmt.Print(buf.String())
+}
