+#!/bin/bash
+set -e
+
+# Build script for srgn
+# This script compiles the Python implementation
+
+# Validate the Python script syntax
+python3 -m py_compile srgn.py
+
+# Test that the script runs without errors
+python3 srgn.py --help > /dev/null 2>&1
+
+# Make the Python script executable
+chmod +x srgn.py
+
+# Create the executable wrapper
+printf '#!/bin/bash\nexec python3 /workspace/srgn.py "$@"\n' > ./executable
+chmod +x ./executable
+
+# Test that the executable works
+python3 -c "import srgn; print('OK')"
