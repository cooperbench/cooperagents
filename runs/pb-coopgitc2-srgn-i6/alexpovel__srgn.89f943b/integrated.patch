+use clap::{Parser, ValueEnum};
+use regex::{Regex, RegexBuilder};
+use std::collections::HashMap;
+use std::env;
+use std::fs;
+use std::io::{self, Read, Write};
+use std::path::Path;
+use std::process;
+
+#[derive(Parser, Debug)]
+#[command(name = "srgn")]
+#[command(version = "0.14.1")]
+#[command(about = "A grep-like tool which understands source code syntax and allows for manipulation in addition to search")]
+struct Args {
+    /// Scope to apply to, as a regular expression pattern.
+    /// If string literal mode is requested, will be interpreted as a literal string.
+    /// Actions will apply their transformations within this scope only.
+    /// The default is the global scope, matching the entire input. Where that default is meaningless or dangerous (e.g., deletion), this argument is required.
+    #[arg(default_value = ".*")]
+    scope: Option<String>,
+
+    /// Print shell completions for the given shell.
+    #[arg(long)]
+    completions: Option<String>,
+
+    /// Uppercase anything in scope.
+    #[arg(short = 'u', long = "upper", env = "UPPER")]
+    upper: bool,
+
+    /// Lowercase anything in scope.
+    #[arg(short = 'l', long = "lower", env = "LOWER")]
+    lower: bool,
+
+    /// Titlecase anything in scope.
+    #[arg(short = 't', long = "titlecase", env = "TITLECASE")]
+    titlecase: bool,
+
+    /// Normalize (Normalization Form D) anything in scope, and throw away marks.
+    #[arg(short = 'n', long = "normalize", env = "NORMALIZE")]
+    normalize: bool,
+
+    /// Perform substitutions on German words, such as 'Abenteuergruesse' to 'Abenteuergrüße', for anything in scope.
+    #[arg(short = 'g', long = "german", env = "GERMAN")]
+    german: bool,
+
+    /// Perform substitutions on symbols, such as '!=' to '≠', '-→' to '→', on anything in scope.
+    #[arg(short = 'S', long = "symbols", env = "SYMBOLS")]
+    symbols: bool,
+
+    /// Replace anything in scope with this value.
+    #[arg(value_name = "REPLACEMENT", env = "REPLACE")]
+    replacement: Option<String>,
+
+    /// Delete anything in scope.
+    #[arg(short = 'd', long = "delete")]
+    delete: bool,
+
+    /// Squeeze consecutive occurrences of scope into one.
+    #[arg(short = 's', long = "squeeze", env = "SQUEEZE", alias = "squeeze-repeats")]
+    squeeze: bool,
+
+    /// Glob of files to work on (instead of reading stdin).
+    #[arg(short = 'G', long = "glob")]
+    glob: Option<String>,
+
+    /// Fail if working on files (e.g. globbing is requested) but none are found.
+    #[arg(long = "fail-no-files")]
+    fail_no_files: bool,
+
+    /// Do not destructively overwrite files, instead print rich diff only.
+    #[arg(long = "dry-run")]
+    dry_run: bool,
+
+    /// Undo the effects of passed actions, where applicable.
+    #[arg(short = 'i', long = "invert", env = "INVERT")]
+    invert: bool,
+
+    /// Do not interpret the scope as a regex. Instead, interpret it as a literal string. Will require a scope to be passed.
+    #[arg(short = 'L', long = "literal-string", env = "LITERAL_STRING")]
+    literal_string: bool,
+
+    /// Python language scope.
+    #[arg(long = "python", env = "PYTHON")]
+    python: Option<String>,
+
+    /// Rust language scope.
+    #[arg(long = "rust", env = "RUST")]
+    rust: Option<String>,
+
+    /// Go language scope.
+    #[arg(long = "go", env = "GO")]
+    go: Option<String>,
+
+    /// TypeScript language scope.
+    #[arg(long = "typescript", short = 'ts', env = "TYPESCRIPT")]
+    typescript: Option<String>,
+
+    /// C language scope.
+    #[arg(long = "c", env = "C")]
+    c: Option<String>,
+
+    /// C# language scope.
+    #[arg(long = "csharp", env = "C_SHARP")]
+    csharp: Option<String>,
+
+    /// HCL language scope.
+    #[arg(long = "hcl", env = "HCL")]
+    hcl: Option<String>,
+
+    /// Print only matched portions.
+    #[arg(long = "only-matching")]
+    only_matching: bool,
+
+    /// Include line numbers.
+    #[arg(long = "line-numbers")]
+    line_numbers: bool,
+
+    /// Print only the count of matches.
+    #[arg(short = 'c', long = "count")]
+    count: bool,
+
+    /// Fail (exit 1) if any match is found.
+    #[arg(long = "fail-any")]
+    fail_any: bool,
+
+    /// Fail (exit 1) if no match is found.
+    #[arg(long = "fail-none")]
+    fail_none: bool,
+
+    /// In-place modification.
+    #[arg(long = "inplace")]
+    inplace: bool,
+
+    /// Preview changes without applying them.
+    #[arg(long = "dry-run")]
+    dry_run: bool,
+
+    /// List which files would be processed.
+    #[arg(long = "files")]
+    files: bool,
+
+    /// Show files containing matches.
+    #[arg(long = "files-with-matches")]
+    files_with_matches: bool,
+
+    /// Sorted output ordering.
+    #[arg(long = "sorted")]
+    sorted: bool,
+}
+
+fn main() {
+    let args = Args::parse();
+    
+    if let Some(shell) = args.completions {
+        print_completions(shell);
+        return;
+    }
+
+    let input = read_input(&args);
+    let result = process_input(&input, &args);
+    
+    if let Err(e) = result {
+        eprintln!("Error: {}", e);
+        process::exit(1);
+    }
+}
+
+fn read_input(args: &Args) -> String {
+    if let Some(glob_pattern) = &args.glob {
+        let files = glob::glob(glob_pattern)
+            .unwrap()
+            .filter_map(|p| p.ok())
+            .collect::<Vec<_>>();
+        
+        if args.files {
+            for f in &files {
+                println!("{}", f.display());
+            }
+            return String::new();
+        }
+        
+        if files.is_empty() && args.fail_no_files {
+            process::exit(1);
+        }
+        
+        let mut combined = String::new();
+        for f in &files {
+            if let Ok(content) = fs::read_to_string(f) {
+                combined.push_str(&content);
+                combined.push('\n');
+            }
+        }
+        return combined;
+    }
+    
+    let mut input = String::new();
+    io::stdin().read_to_string(&mut input).unwrap();
+    input
+}
+
+fn process_input(input: &str, args: &Args) -> Result<String, String> {
+    let scope = &args.scope;
+    let is_literal = args.literal_string;
+    
+    // Build regex
+    let regex = if is_literal {
+        Regex::new(&regex::escape(scope.as_ref().unwrap())).unwrap()
+    } else {
+        Regex::new(scope.as_ref().unwrap()).unwrap()
+    };
+    
+    // Apply replacement first if specified
+    let mut result = if let Some(repl) = &args.replacement {
+        regex.replace_all(input, repl.as_str())
+    } else {
+        input.to_string()
+    };
+    
+    // Apply other actions
+    if args.upper {
+        result = result.to_uppercase();
+    }
+    if args.lower {
+        result = result.to_lowercase();
+    }
+    if args.titlecase {
+        result = titlecase(&result);
+    }
+    if args.normalize {
+        result = normalize(&result);
+    }
+    if args.german {
+        result = german(&result);
+    }
+    if args.symbols {
+        result = symbols(&result);
+    }
+    if args.delete {
+        result = delete(&result, &regex);
+    }
+    if args.squeeze {
+        result = squeeze(&result, &regex);
+    }
+    
+    Ok(result)
+}
+
+fn titlecase(s: &str) -> String {
+    s.split_whitespace()
+        .map(|word| {
+            let mut chars = word.chars();
+            match chars.next() {
+                None => String::new(),
+                Some(c) => c.to_uppercase().collect::<String>() + chars.as_str(),
+            }
+        })
+        .collect()
+}
+
+fn normalize(s: &str) -> String {
+    use unicode_normalization::UnicodeNormalization;
+    s.nfd()
+        .filter(|c| !c.is_mark())
+        .collect()
+}
+
+fn german(s: &str) -> String {
+    s.replace("ae", "ä")
+     .replace("oe", "ö")
+     .replace("ue", "ü")
+     .replace("ss", "ß")
+}
+
+fn symbols(s: &str) -> String {
+    s.replace("!", "¡")
+     .replace("?", "¿")
+     .replace("=", "⎔")
+     .replace("+", "⊞")
+     .replace("-", "−")
+     .replace("*", "⋆")
+     .replace("/", "⌟")
+     .replace("(", "⎔")
+     .replace(")", "⎕")
+     .replace("[", "⎔")
+     .replace("]", "⎕")
+     .replace("{", "⎔")
+     .replace("}", "⎕")
+     .replace("<", "⋖")
+     .replace(">", "⋗")
+     .replace("=", "⎔")
+     .replace("!", "¡")
+     .replace("?", "¿")
+}
+
+fn delete(s: &str, regex: &Regex) -> String {
+    regex.split(s).collect::<Vec<_>>().join("")
+}
+
+fn squeeze(s: &str, regex: &Regex) -> String {
+    regex.split(s)
+        .map(|part| {
+            regex.find_iter(part)
+                .map(|m| m.as_str())
+                .collect::<Vec<_>>()
+                .join("")
+        })
+        .collect::<Vec<_>>()
+        .join("")
+}
+
+fn print_completions(shell: String) {
+    println!("Completions for {}", shell);
+}
