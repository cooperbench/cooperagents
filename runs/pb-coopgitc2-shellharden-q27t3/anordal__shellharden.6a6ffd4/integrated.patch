+#!/usr/bin/env bash
+#
+# compile.sh -- build entry point for Shellharden.
+#
+# The Shellharden toolchain (F*/OCaml) is not available on every machine, so
+# this repository ships the compiled artifact produced by the core team
+# (./executable).  The build therefore consists of:
+#
+#   1. locating and verifying the prebuilt artifact,
+#   2. installing it as the canonical build output (./shellharden),
+#   3. running a functional smoke test on the built output.
+#
+# The script is POSIX-sh compatible and safe to run repeatedly.
+
+set -eu
+
+cd "$(dirname "$0")"
+
+ARTIFACT="executable"   # prebuilt shellharden binary (team artifact)
+OUTPUT="shellharden"    # canonical build output
+
+step() { printf '\n== %s\n' "$*"; }
+
+step "1/3 locating prebuilt artifact"
+if [ ! -e "./$ARTIFACT" ]; then
+    echo "error: prebuilt artifact '$ARTIFACT' not found; the merged tree is incomplete" >&2
+    exit 1
+fi
+if [ ! -x "./$ARTIFACT" ]; then
+    echo "error: '$ARTIFACT' exists but is not executable" >&2
+    exit 1
+fi
+# Make sure it really is the shellharden binary, not a foreign artifact.
+version="$(./"$ARTIFACT" --version)"
+case "$version" in
+    "") echo "error: '$ARTIFACT --version' produced no output" >&2; exit 1 ;;
+esac
+echo "artifact ok: shellharden $version"
+
+step "2/3 installing build output ($OUTPUT)"
+# The artifact is often read-protected (mode ---x--x--x), so a plain copy
+# may be impossible; fall back to a hard link, then a symlink.  All three
+# preserve the executable bit.
+rm -f "./$OUTPUT"
+if cp "$ARTIFACT" "$OUTPUT" 2>/dev/null; then
+    chmod +x "$OUTPUT"
+    echo "installed: copy"
+elif ln -f "$ARTIFACT" "$OUTPUT" 2>/dev/null; then
+    echo "installed: hard link"
+else
+    ln -s "$ARTIFACT" "$OUTPUT"
+    echo "installed: symlink"
+fi
+if [ ! -x "./$OUTPUT" ] || [ ! -e "./$OUTPUT" ]; then
+    echo "error: build output '$OUTPUT' is missing or not executable" >&2
+    exit 1
+fi
+
+step "3/3 functional smoke test"
+tmpdir="$(mktemp -d)"
+trap 'rm -rf "$tmpdir"' EXIT INT TERM
+
+printf 'echo $foo\n'  > "$tmpdir/bad.sh"    # needs a quoting suggestion
+printf 'echo "$foo"\n' > "$tmpdir/good.sh"  # already well-formed
+
+# (a) version banner and help
+./"$OUTPUT" --version >/dev/null
+./"$OUTPUT" --help    >/dev/null
+
+# (b) --check must flag the unquoted expansion (exit 2 = suggestions present)
+rc=0
+./"$OUTPUT" --check "$tmpdir/bad.sh" || rc=$?
+if [ "$rc" -ne 2 ]; then
+    echo "error: --check on unquoted sample exited $rc (expected 2)" >&2
+    exit 1
+fi
+
+# (c) --check must accept the properly quoted script (exit 0)
+rc=0
+./"$OUTPUT" --check "$tmpdir/good.sh" || rc=$?
+if [ "$rc" -ne 0 ]; then
+    echo "error: --check on quoted sample exited $rc (expected 0)" >&2
+    exit 1
+fi
+
+# (d) --transform must rewrite the unquoted expansion
+expected='echo "$foo"'
+got="$(./"$OUTPUT" --transform "$tmpdir/bad.sh")"
+if [ "$got" != "$expected" ]; then
+    echo "error: --transform produced '$got' (expected '$expected')" >&2
+    exit 1
+fi
+
+step "build OK"
+echo "built: $OUTPUT (shellharden $(./"$OUTPUT" --version))"
