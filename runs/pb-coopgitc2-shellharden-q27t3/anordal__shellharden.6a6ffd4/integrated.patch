+# Makefile -- build entry point for Shellharden.
+#
+# The build itself is implemented in compile.sh (locate the prebuilt
+# artifact, install ./shellharden, run the functional smoke test).
+
+SHELL := /bin/sh
+
+all: build
+
+build:
+	bash compile.sh
+
+test: build
+	./shellharden --version
+
+clean:
+	rm -f shellharden
+
+.PHONY: all build test clean
