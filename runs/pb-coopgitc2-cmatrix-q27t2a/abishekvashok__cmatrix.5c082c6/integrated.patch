+/*
+ * cmatrix - matrix animation
+ *
+ * (C) 2015-2021 by abishekvashok
+ */
+
+#include "matrix.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <string.h>
+#include <time.h>
+#include <ncurses.h>
+#include <pthread.h>
+
+/* the matrix dimensions */
+int height, width;
+
+/* the character sets */
+char *charset_latin =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+    "abcdefghijklmnopqrstuvwxyz"
+    "0123456789";
+
+char *charset_japanese =
+    "\xe6\x97\xa5\xe5\x8a\xa3\xe5\x91\xbc\xe5\x80\x89\xe5\x9f\x8b"
+    "\xe9\x9d\x92\xe7\x81\x8c\xe5\x80\x86\xe4\xbd\xa2\xe5\x8a\xac"
+    "\xe7\x9a\x84\xe7\x9a\x84\xe4\xba\xac\xe7\xb4\x8d\xe9\x96\x93"
+    "\xe9\x96\x93\xe4\xb8\x80\xe4\xba\x8c\xe4\xb8\x89\xe5\x9b\x9b"
+    "\xe4\xba\x94\xe5\x85\xad\xe4\xb8\x83\xe5\x85\x8b\xe5\x8f\x8b"
+    "\xe6\x9a\x84\xe7\x9a\x84\xe4\xba\xac";
+
+/* the matrix */
+char **m;
+int *speed;
+
+/*
+ * init
+ *
+ * inits the ncurses library
+ */
+void
+init()
+{
+	/* init ncurses */
+	if (initscr() == NULL)
+		exit(1);
+
+	/* set the height and width */
+	height = LINES;
+	width = COLS;
+
+	/* no echo */
+	noecho();
+
+	/* non block mode */
+	nodelay(stdscr, TRUE);
+
+	/* no cursor */
+	curs_set(0);
+}
+
+/*
+ * color_init
+ *
+ * inits the colors
+ */
+void
+color_init()
+{
+	/* if color is not available */
+	if (!has_colors())
+		return;
+
+	/* init the colors */
+	init_pair(1, COLOR_GREEN, COLOR_BLACK);
+	init_pair(2, COLOR_RED, COLOR_BLACK);
+	init_pair(3, COLOR_BLUE, COLOR_BLACK);
+	init_pair(4, COLOR_WHITE, COLOR_BLACK);
+	init_pair(5, COLOR_YELLOW, COLOR_BLACK);
+	init_pair(6, COLOR_CYAN, COLOR_BLACK);
+	init_pair(7, COLOR_MAGENTA, COLOR_BLACK);
+	init_pair(8, COLOR_BLACK, COLOR_BLACK);
+}
+
+/*
+ * get_color
+ *
+ * returns the color number
+ */
+int
+get_color()
+{
+	/* default */
+	if (color == NULL)
+		return 1;
+
+	/* match */
+	if (strcmp(color, "green") == 0)
+		return 1;
+	if (strcmp(color, "red") == 0)
+		return 2;
+	if (strcmp(color, "blue") == 0)
+		return 3;
+	if (strcmp(color, "white") == 0)
+		return 4;
+	if (strcmp(color, "yellow") == 0)
+		return 5;
+	if (strcmp(color, "cyan") == 0)
+		return 6;
+	if (strcmp(color, "magenta") == 0)
+		return 7;
+	if (strcmp(color, "black") == 0)
+		return 8;
+
+	return 1;
+}
+
+/*
+ * matrix_init
+ *
+ * inits the matrix
+ */
+void
+matrix_init()
+{
+	int i;
+
+	/* init the matrix */
+	m = malloc(width * sizeof(char *));
+	for (i = 0; i < width; i++)
+		m[i] = malloc(height * sizeof(char));
+
+	/* init the speed */
+	speed = malloc(width * sizeof(int));
+	for (i = 0; i < width; i++)
+		speed[i] = rand() % 10;
+}
+
+/*
+ * matrix_clear
+ *
+ * clears the matrix
+ */
+void
+matrix_clear()
+{
+	int i;
+
+	for (i = 0; i < width; i++)
+		free(m[i]);
+	free(m);
+	free(speed);
+}
+
+/*
+ * matrix
+ *
+ * the main matrix loop
+ */
+void
+matrix()
+{
+	int i;
+	int c;
+	int col;
+	char ch;
+
+	/* init */
+	init();
+	color_init();
+	matrix_init();
+
+	/* get the color */
+	col = get_color();
+
+	/* set the color */
+	if (has_colors())
+		attron(COLOR_PAIR(col));
+
+	/* clear the screen */
+	erase();
+	refresh();
+
+	/* the matrix loop */
+	while (1) {
+		/* read a key */
+		c = getch();
+
+		/* if a key is pressed */
+		if (c != ERR) {
+			/* if it is 'q' or escape */
+			if (c == 'q' || c == 27)
+				break;
+
+			/* if screensaver mode, exit on first keystroke */
+			if (screensaver == 1)
+				break;
+		}
+
+		/* update the matrix */
+		for (i = 0; i < width; i++) {
+			/* if it is time to update */
+			if (rand() % 10 == 0) {
+				/* get a random character */
+				if (j == 1)
+					ch = charset_japanese[rand() % 64];
+				else
+					ch = charset_latin[
+				    rand() % strlen(charset_latin)];
+
+				/* print the character */
+				mvaddch(rand() % height, i, ch);
+			}
+		}
+
+		/* refresh */
+		refresh();
+
+		/* delay */
+		if (delay > 0)
+			usleep(delay * 100000);
+	}
+
+	/* cleanup */
+	endwin();
+	matrix_clear();
+
+	/* exit */
+	exit(0);
+}
+
+/*
+ * matrix_async
+ *
+ * the asynchronous matrix loop
+ */
+void
+matrix_async()
+{
+	/* init */
+	init();
+	color_init();
+	matrix_init();
+
+	/* clear the screen */
+	erase();
+	refresh();
+
+	/* the matrix loop */
+	while (1) {
+		/* read a key */
+		if (getch() != ERR)
+			break;
+
+		/* refresh */
+		refresh();
+
+		/* delay */
+		if (delay > 0)
+			usleep(delay * 100000);
+	}
+
+	/* cleanup */
+	endwin();
+	matrix_clear();
+
+	/* exit */
+	exit(0);
+}
