+
+#include "matrix.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <string.h>
+#include <ctype.h>
+#include <time.h>
+#include <locale.h>
+#include <ncurses.h>
+#include <pthread.h>
+
+/* global options */
+int async = 0;		/* asynchronous scroll */
+int old = 0;		/* old mode */
+int lock = 0;		/* lock mode */
+int color_change = 0;	/* color change */
+int use_color = 1;	/* use color */
+int bold = 0;		/* bold */
+int all_bold = 0;	/* all bold */
+int screensaver = 0;	/* screensaver mode */
+int lambda = 0;		/* lambda mode */
+int rainbow = 0;		/* rainbow mode */
+int linux_mode = 0;	/* linux mode */
+int x = 0;		/* x mode */
+int j = 0;		/* japanese */
+int delay = 4;		/* delay */
+char *color = "green";	/* color */
+char *message = NULL;	/* message */
+char *tty = NULL;	/* tty */
+
+/* version */
+const char *version = "2.0";
+
+/* colors */
+char *color_name[] = {
+	"green", "red", "blue", "white",
+	"yellow", "cyan", "magenta", "black",
+	NULL
+};
+
+/*
+ * usage
+ *
+ * prints the usage information
+ */
+void
+usage()
+{
+	printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+	printf(" -a: Asynchronous scroll\n");
+	printf(" -b: Bold characters on\n");
+	printf(" -B: All bold characters (overrides -b)\n");
+	printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+	printf(" -f: Force the linux $TERM type to be on\n");
+	printf(" -l: Linux mode (uses matrix console font)\n");
+	printf(" -L: Lock mode (can be closed from another terminal)\n");
+	printf(" -o: Use old-style scrolling\n");
+	printf(" -h: Print usage and exit\n");
+	printf(" -n: No bold characters (overrides -b and -B, default)\n");
+	printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+	printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+	printf(" -V: Print version information and exit\n");
+	printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+	printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+	printf(" -C [color]: Use this color for matrix (default green)\n");
+	printf(" -r: rainbow mode\n");
+	printf(" -m: lambda mode\n");
+	printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+	printf(" -t [tty]: Set tty to use\n");
+}
+
+/*
+ * version_print
+ *
+ * prints the version information
+ */
+void
+version_print()
+{
+	printf(" CMatrix version %s (compiled %s, %s)\n",
+	    "2.0", "22:13:51", "Jun 11 2026");
+	printf("Email: %s\n", "abishekvashok@gmail.com");
+	printf("Web: %s\n", "https://github.com/abishekvashok/cmatrix");
+}
+
+/*
+ * color_check
+ *
+ * checks if the color is valid
+ *
+ * returns:
+ *   0 if the color is valid
+ *   1 if the color is invalid
+ */
+int
+color_check(char *c)
+{
+	int i;
+
+	for (i = 0; color_name[i] != NULL; i++)
+		if (strcmp(color_name[i], c) == 0)
+			return 0;
+
+	return 1;
+}
+
+/*
+ * main
+ */
+int
+main(int argc, char **argv)
+{
+	int c;
+
+	/* parse the arguments */
+	while ((c = getopt(argc, argv,
+	    "abBcfhlLonsxVrmt:u:C:M:k")) != -1) {
+		switch (c) {
+		case 'a':
+			/* asynchronous scroll */
+			async = 1;
+			break;
+		case 'b':
+			/* bold */
+			bold = 1;
+			break;
+		case 'B':
+			/* all bold */
+			all_bold = 1;
+			break;
+		case 'c':
+			/* use japanese characters */
+			j = 1;
+			break;
+		case 'f':
+			/* force the linux $TERM type to be on */
+			linux_mode = 1;
+			break;
+		case 'l':
+			/* linux mode */
+			linux_mode = 1;
+			break;
+		case 'L':
+			/* lock mode */
+			lock = 1;
+			break;
+		case 'o':
+			/* old mode */
+			old = 1;
+			break;
+		case 'h':
+			/* usage */
+			usage();
+			exit(0);
+		case 'n':
+			/* no bold */
+			bold = 0;
+			break;
+		case 's':
+			/* screensaver mode */
+			screensaver = 1;
+			break;
+		case 'x':
+			/* x mode */
+			x = 1;
+			break;
+		case 'V':
+			/* version */
+			version_print();
+			exit(0);
+		case 'r':
+			/* rainbow mode */
+			rainbow = 1;
+			break;
+		case 'm':
+			/* lambda mode */
+			lambda = 1;
+			break;
+		case 'M':
+			/* message */
+			message = optarg;
+			break;
+		case 'u':
+			/* delay */
+			delay = atoi(optarg);
+			break;
+		case 'C':
+			/* color */
+			/* check the color */
+			if (color_check(optarg) == 1) {
+				fprintf(stderr, " Invalid color selection\n");
+				fprintf(stderr,
+				    " Valid colors are green, red, blue, "
+				    "white, yellow, cyan, magenta and black.\n");
+				exit(0);
+			}
+			color = optarg;
+			break;
+		case 't':
+			/* tty */
+			tty = optarg;
+			break;
+		case 'k':
+			/* color change */
+			color_change = 1;
+			break;
+		default:
+			usage();
+			exit(0);
+		}
+	}
+
+	/* start the matrix */
+	if (async == 1)
+		matrix_async();
+	else
+		matrix();
+
+	return 0;
+}
