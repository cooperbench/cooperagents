+    
+    if [[ ${#args[@]} -eq 0 ]]; then
+        builtin cd ~
+    elif [[ ${#args[@]} -eq 1 && "${args[0]}" == "-" ]]; then
+        builtin cd -
+    elif [[ ${#args[@]} -eq 1 && -d "${args[0]}" ]]; then
+        builtin cd "${args[0]}"
+    else
+        builtin local -r result="$(command zoxide query --exclude "$pwd_tmp" -- "${args[@]}")"
+        if [[ -n "$result" ]]; then
+            builtin cd "$result"
+        fi
+    fi
+}
