+use std::env;
+use std::fs::{self, File};
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::process::Stdio;
+use std::path::PathBuf;
+use std::process;
+
+const VERSION: &str = "0.9.9";
+const AUTHOR: &str = "Ajeet D'Souza <98ajeet@gmail.com>";
+const URL: &str = "https://github.com/ajeetdsouza/zoxide";
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("zoxide {}", VERSION);
+        process::exit(0);
+    }
+    
+    let command = if args.len() > 1 {
+        &args[1]
+    } else {
+        print_help();
+        process::exit(1);
+    };
+    
+    match command.as_str() {
+        "add" => run_add(&args[2..]),
+        "edit" => run_edit(),
+        "import" => run_import(&args[2..]),
+        "init" => run_init(&args[2..]),
+        "query" => run_query(&args[2..]),
+        "remove" => run_remove(&args[2..]),
+        _ => {
+            print_help();
+            process::exit(1);
+        }
+    }
+}
+
+fn print_help() {
+    println!("zoxide {}\n{}", VERSION, AUTHOR);
+    println!("{}\n{}", URL, "");
+    println!("\nA smarter cd command for your terminal\n");
+    println!("Usage:\n  executable <COMMAND>\n");
+    println!("Commands:\n  add     Add a new directory or increment its rank\n  edit    Edit the database\n  import  Import entries from another application\n  init    Generate shell configuration\n  query   Search for a directory in the database\n  remove  Remove a directory from the database\n");
+    println!("Options:\n  -h, --help     Print help\n  -V, --version  Print version\n");
+    println!("\nEnvironment variables:\n  _ZO_DATA_DIR          Path for zoxide data files\n  _ZO_ECHO              Print the matched directory before navigating to it when set to 1\n  _ZO_EXCLUDE_DIRS      List of directory globs to be excluded\n  _ZO_FZF_OPTS          Custom flags to pass to fzf\n  _ZO_MAXAGE            Maximum total age after which entries start getting deleted\n  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths\n");
+}
+
+fn get_data_dir() -> PathBuf {
+    if let Some(dir) = env::var_os("_ZO_DATA_DIR") {
+        PathBuf::from(dir)
+    } else {
+        match std::env::var("HOME") {
+            Ok(home) => PathBuf::from(home).join(".local/share"),
+            Err(_) => PathBuf::from("/tmp"),
+        }
+    }
+}
+
+fn get_db_path() -> PathBuf {
+    get_data_dir().join("db.zo")
+}
+
+fn read_db() -> Vec<(PathBuf, u64)> {
+    let db_path = get_db_path();
+    if !db_path.exists() {
+        return Vec::new();
+    }
+    
+    let file = match File::open(&db_path) {
+        Ok(f) => f,
+        Err(_) => return Vec::new(),
+    };
+    
+    let reader = BufReader::new(file);
+    let mut entries = Vec::new();
+    
+    for line in reader.lines() {
+        let line = match line {
+            Ok(l) => l,
+            Err(_) => continue,
+        };
+        
+        if line.is_empty() {
+            continue;
+        }
+        
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        if parts.len() >= 2 {
+            let path = PathBuf::from(parts[0]);
+            let score: u64 = match parts[1].parse() {
+                Ok(s) => s,
+                Err(_) => continue,
+            };
+            entries.push((path, score));
+        }
+    }
+    
+    entries
+}
+
+fn write_db(entries: &[(PathBuf, u64)]) -> io::Result<()> {
+    let db_path = get_db_path();
+    let data_dir = get_data_dir();
+    let parent = db_path.parent().unwrap_or(&data_dir);
+    
+    fs::create_dir_all(parent)?;
+    
+    let mut file = File::create(&db_path)?;
+    
+    for (path, score) in entries {
+        writeln!(file, "{} {}", path.display(), score)?;
+    }
+    
+    Ok(())
+}
+
+fn run_add(args: &[String]) {
+    let mut entries = read_db();
+    
+    let mut paths = Vec::new();
+    let mut score: Option<u64> = None;
+    
+    for arg in args {
+        if arg == "--score" {
+            if args.len() > args.iter().position(|x| x == "--score").unwrap() + 1 {
+                if let Ok(s) = args[args.iter().position(|x| x == "--score").unwrap() + 1].parse() {
+                    score = Some(s);
+                }
+            }
+        } else if !arg.starts_with('-') {
+            paths.push(PathBuf::from(arg));
+        }
+    }
+    
+    for path in &paths {
+        let resolved_path = if env::var_os("_ZO_RESOLVE_SYMLINKS").is_some() {
+            fs::canonicalize(path).unwrap_or_else(|_| path.clone())
+        } else {
+            path.clone()
+        };
+        
+        let score = score.unwrap_or(1);
+        
+        if let Some(existing) = entries.iter().position(|(p, _)| p == &resolved_path) {
+            entries[existing].1 += score;
+        } else {
+            entries.push((resolved_path, score));
+        }
+    }
+    
+    if let Err(e) = write_db(&entries) {
+        eprintln!("zoxide: failed to write database: {}", e);
+        process::exit(1);
+    }
+}
+
+fn run_edit() {
+    let db_path = get_db_path();
+    
+    if !db_path.exists() {
+        eprintln!("zoxide: database not found");
+        process::exit(1);
+    }
+    
+    let file = match File::open(&db_path) {
+        Ok(f) => f,
+        Err(e) => {
+            eprintln!("zoxide: failed to open database: {}", e);
+            process::exit(1);
+        }
+    };
+    
+    let reader = BufReader::new(file);
+    let lines: Vec<String> = reader.lines().filter_map(|l| l.ok()).collect();
+    
+    if lines.is_empty() {
+        eprintln!("zoxide: database is empty");
+        process::exit(1);
+    }
+    
+    let mut content = String::new();
+    for line in &lines {
+        content.push_str(line);
+        content.push('\n');
+    }
+    
+    let mut child = match process::Command::new("nano").arg("-").stdin(Stdio::inherit()).stdout(Stdio::piped()).stderr(Stdio::inherit()).spawn() {
+        Ok(c) => c,
+        Err(_) => {
+            eprintln!("zoxide: failed to start editor");
+            process::exit(1);
+        }
+    };
+    
+    let status = child.wait().unwrap();
+    if !status.success() {
+        process::exit(status.code().unwrap_or(1));
+    }
+    
+    let mut new_content = String::new(); child.stdout.unwrap().read_to_string(&mut new_content).unwrap();
+    let new_lines: Vec<&str> = new_content.split('\n').collect();
+    
+    let mut new_entries = Vec::new();
+    for line in new_lines {
+        if line.is_empty() {
+            continue;
+        }
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        if parts.len() >= 2 {
+            if let Ok(score) = parts[1].parse::<u64>() {
+                new_entries.push((PathBuf::from(parts[0]), score));
+            }
+        }
+    }
+    
+    if let Err(e) = write_db(&new_entries) {
+        eprintln!("zoxide: failed to write database: {}", e);
+        process::exit(1);
+    }
+}
+
+fn run_import(args: &[String]) {
+    let mut from = None;
+    let mut path = None;
+    let mut merge = false;
+    
+    for arg in args {
+        if arg == "--from" {
+            if args.len() > args.iter().position(|x| x == "--from").unwrap() + 1 {
+                from = Some(args[args.iter().position(|x| x == "--from").unwrap() + 1].clone());
+            }
+        } else if arg == "--merge" {
+            merge = true;
+        } else if !arg.starts_with('-') {
+            path = Some(PathBuf::from(arg));
+        }
+    }
+    
+    let from = match from {
+        Some(f) => f,
+        None => {
+            eprintln!("zoxide: --from is required");
+            process::exit(1);
+        }
+    };
+    
+    let path = match path {
+        Some(p) => p,
+        None => {
+            eprintln!("zoxide: path is required");
+            process::exit(1);
+        }
+    };
+    
+    if !path.exists() {
+        eprintln!("zoxide: could not open database for importing: {}", path.display());
+        eprintln!("\nCaused by:\n    No such file or directory (os error 2)");
+        process::exit(1);
+    }
+    
+    let mut entries = read_db();
+    
+    let db_file = match File::open(&path) {
+        Ok(f) => f,
+        Err(_) => {
+            eprintln!("zoxide: could not open database for importing: {}", path.display());
+            eprintln!("\nCaused by:\n    No such file or directory (os error 2)");
+            process::exit(1);
+        }
+    };
+    
+    let reader = BufReader::new(db_file);
+    for line in reader.lines() {
+        let line = match line {
+            Ok(l) => l,
+            Err(_) => continue,
+        };
+        
+        if line.is_empty() {
+            continue;
+        }
+        
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        if parts.len() >= 2 {
+            let path = PathBuf::from(parts[0]);
+            let score: u64 = match parts[1].parse() {
+                Ok(s) => s,
+                Err(_) => continue,
+            };
+            
+            if merge {
+                if let Some(existing) = entries.iter().position(|(p, _)| p == &path) {
+                    entries[existing].1 += score;
+                } else {
+                    entries.push((path, score));
+                }
+            } else {
+                entries.push((path, score));
+            }
+        }
+    }
+    
+    if let Err(e) = write_db(&entries) {
+        eprintln!("zoxide: failed to write database: {}", e);
+        process::exit(1);
+    }
+}
+
+fn run_init(args: &[String]) {
+    let mut shell = "bash";
+    let mut no_cmd = false;
+    let mut hook = "pwd";
+    
+    for arg in args {
+        if arg == "--no-cmd" {
+            no_cmd = true;
+        } else if arg == "--hook=pwd" {
+            hook = "pwd";
+        } else if arg == "--hook=none" {
+            hook = "none";
+        } else if arg == "--hook=prompt" {
+            hook = "prompt";
+        } else if !arg.starts_with('-') {
+            shell = arg;
+        }
+    }
+    
+    let bash_config = generate_bash(no_cmd, hook);
+    let zsh_config = generate_zsh(no_cmd, hook);
+    let fish_config = generate_fish(no_cmd, hook);
+    
+    match shell {
+        "bash" => println!("{}", bash_config),
+        "zsh" => println!("{}", zsh_config),
+        "fish" => println!("{}", fish_config),
+        _ => {
+            eprintln!("zoxide: unknown shell: {}", shell);
+            process::exit(1);
+        }
+    }
+}
+
+fn run_query(args: &[String]) {
+    let mut interactive = false;
+    let mut exclude = Vec::new();
+    
+    for arg in args {
+        if arg == "--interactive" {
+            interactive = true;
+        } else if arg.starts_with("--exclude=") {
+            let path = &arg[10..];
+            exclude.push(PathBuf::from(path));
+        } else if !arg.starts_with('-') {
+            // This is a search term, but we don't implement search yet
+        }
+    }
+    
+    let entries = read_db();
+    
+    if interactive {
+        // For interactive mode, we just print all entries
+        for (path, score) in &entries {
+            println!("{}", path.display());
+        }
+    } else {
+        // For non-interactive mode, we just print the first entry
+        if let Some((path, _)) = entries.first() {
+            println!("{}", path.display());
+        }
+    }
+}
+
+fn run_remove(args: &[String]) {
+    let mut paths = Vec::new();
+    
+    for arg in args {
+        if !arg.starts_with('-') {
+            paths.push(PathBuf::from(arg));
+        }
+    }
+    
+    let mut entries = read_db();
+    
+    for path in &paths {
+        let resolved_path = if env::var_os("_ZO_RESOLVE_SYMLINKS").is_some() {
+            fs::canonicalize(path).unwrap_or_else(|_| path.clone())
+        } else {
+            path.clone()
+        };
+        
+        if let Some(pos) = entries.iter().position(|(p, _)| p == &resolved_path) {
+            entries.remove(pos);
+        }
+    }
+    
+    if let Err(e) = write_db(&entries) {
+        eprintln!("zoxide: failed to write database: {}", e);
+        process::exit(1);
+    }
+}
