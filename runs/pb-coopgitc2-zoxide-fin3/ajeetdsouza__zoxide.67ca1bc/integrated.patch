+    local retval=$?
+    local pwd_tmp="$(__zoxide_pwd)"
+    if [[ "$__zoxide_oldpwd" != "$pwd_tmp" ]]; then
+        __zoxide_oldpwd="$pwd_tmp"
+        command zoxide add -- "$pwd_tmp"
+    fi
+    return $retval
+}
