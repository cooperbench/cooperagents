+fn generate_fish(no_cmd: bool, hook: &str) -> String {
+    let z_func = if !no_cmd {
+        r#"
+# Jump to a directory using only keywords.
+function __zoxide_z
+    set -l args $argv
+    set -l pwd_tmp (__zoxide_pwd)
+    
+    if test (count $args) -eq 0; then
+        builtin cd ~
+    elif test (count $args) -eq 1 and "$args[1]" = "-"; then
+        builtin cd -
+    elif test (count $args) -eq 1 and -d "$args[1]"; then
