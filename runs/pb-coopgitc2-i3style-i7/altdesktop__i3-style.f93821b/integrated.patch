++def print_help():
++    """Print help message."""
++    print("i3-style 1.0")
++    print("Make your i3 config a bit more stylish")
++    print()
++    print("USAGE:")
++    print("    executable [FLAGS] [OPTIONS] [theme]")
++    print()
++    print("FLAGS:")
++    print("    -h, --help        Prints help information")
++    print("    -l, --list-all    Print a list of all available themes")
++    print("    -r, --reload      Apply the theme by reloading the config")
++    print("    -s, --save        Set the output file to the path of the input file")
++    print("    -V, --version     Prints version information")
++    print()
++    print("OPTIONS:")
++    print("    -c, --config <file>      The config file the theme should be applied to. Defaults to the default i3 location.")
++    print("    -o, --output <file>      Apply the theme, attempt to validate the result, and write it to <file>")
++    print("    -t, --to-theme <file>    Prints an i3-style theme based on the given config suitable for sharing with others")
++    print("                             [default: ]")
++    print()
++    print("ARGS:")
++    print("    <theme>    The theme to use")
++
