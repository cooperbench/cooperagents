++def print_version():
++    """Print version information."""
++    print("i3-style 1.0")
++
++
++def print_list_all():
++    """Print list of all available themes."""
++    print("\nAvailable themes:")
++    print()
++    for name, desc in THEMES.items():
++        print(f"  {name:20} - {desc}")
++
