++use std::env;
++use std::ffi::OsString;
++use std::fs;
++use std::io::Write;
++use std::path::{Path, PathBuf};
++use std::process::ExitCode;
++
++const VERSION: &str = "0.16.1";
++const PKG: &str = "tui-journal";
++
++// ----- path derivation matching tui-journal 0.16.1 defaults -----
++fn home_dir() -> PathBuf {
++    if let Ok(h) = env::var("HOME") {
++        if !h.is_empty() {
++            return PathBuf::from(h);
++        }
++    }
++    PathBuf::from(".")
++}
++fn base(cfg: &str, xdg: &str) -> PathBuf {
++    if let Some(v) = env::var(xdg).ok() {
++        if !v.is_empty() {
++            return PathBuf::from(v);
++        }
++    }
++    home_dir().join(cfg)
++}
++fn config_dir() -> PathBuf { base(".config", "XDG_CONFIG_HOME").join("tui-journal") }
++fn cache_dir() -> PathBuf { base(".cache", "XDG_CACHE_HOME").join("tui-journal") }
++fn state_dir() -> PathBuf { base(".local/state", "XDG_STATE_HOME").join("tui-journal") }
++fn data_dir() -> PathBuf { home_dir().join("tui-journal") }
++
++fn log_file() -> PathBuf { cache_dir().join("tui-journal.log") }
++fn json_file() -> PathBuf { data_dir().join("entries.json") }
++fn sqlite_file() -> PathBuf { data_dir().join("entries.db") }
++fn themes_file() -> PathBuf { config_dir().join("themes.toml") }
++
++fn s(p: &Path) -> String { p.display().to_string() }
++
++// ----- help texts -----
++fn main_help() -> String {
++    let cfg = s(&config_dir());
++    let log = s(&log_file());
++    let mut out = include_str!("refs/main_help.txt").to_string();
++    // substitute the default config and log paths
++    out = out.replace("/home/agent/.config/tui-journal", &cfg);
++    out = out.replace("/home/agent/.cache/tui-journal/tui-journal.log", &log);
++    out
++}
++
++fn theme_help() -> String {
++    include_str!("refs/theme_help.txt").to_string()
++}
++
++fn pc_help() -> String {
++    format!("Print the current settings including the paths for the back-end files\n\nUsage: {prog} print-config\n\nOptions:\n  -h, --help  Print help\n", prog = bin_name())
++}
++fn imj_help() -> String {
++    format!("Import journals from the given transfer JSON file to the current back-end file\n\nUsage: {prog} import-journals --path <FILE PATH>\n\nOptions:\n  -p, --path <FILE PATH>  Path of the JSON file to import from\n  -h, --help              Print help\n", prog = bin_name())
++}
++fn ap_help() -> String {
++    format!("Assign priority for all the entries with empty priority field\n\nUsage: {prog} assign-priority <PRIORITY>\n\nArguments:\n  <PRIORITY>  Priority value (Positive number)\n\nOptions:\n  -h, --help  Print help\n", prog = bin_name())
++}
++fn tp_help() -> String {
++    format!("Prints the path to the user themes file\n\nUsage: {prog} theme print-path\n\nOptions:\n  -h, --help  Print help\n", prog = bin_name())
++}
++fn td_help() -> String {
++    format!("Dumps the styles with the default values to be used as a reference and base for user custom themes\n\nUsage: {prog} theme print-default\n\nOptions:\n  -h, --help  Print help\n", prog = bin_name())
++}
++fn wd_help() -> String {
++    format!("Creates user custom themes file if doesn't exist then writes the default styles to it\n\nUsage: {prog} theme write-defaults\n\nOptions:\n  -h, --help  Print help\n", prog = bin_name())
++}
++
++fn bin_name() -> String {
++    env::args().next().map(|a| {
++        Path::new(&a).file_name().map(|f| f.to_string_lossy().into_owned()).unwrap_or_else(|| a)
++    }).unwrap_or_else(|| "executable".to_string())
++}
++
++// ----- error helpers (clap-style, exit 2) -----
++fn clap_err(msg: String, usage: String) -> ! {
++    eprint!("{msg}\n\n{usage}\n\nFor more information, try '--help'.\n");
++    std::process::exit(2);
++}
++fn main_usage() -> String { format!("Usage: {} [OPTIONS] [COMMAND]", bin_name()) }
++fn err_invalid_value<'a>(val: &str, arg: &'a str, extra: &'a str) -> ! {
++    eprint!("error: invalid value '{val}' for '{arg}'\n  {extra}\n\nFor more information, try '--help'.\n");
++    std::process::exit(2);
++}
++
++fn main() -> ExitCode {
++    let args: Vec<String> = env::args().collect();
++    // parse
++    let mut i = 1;
++    let mut help_main = false;
++    let mut version = false;
++    let mut json_path: Option<String> = None;
++    let mut sqlite_path: Option<String> = None;
++    let mut backend: Option<String> = None;
++    let mut config_arg: Option<String> = None;
++    let mut verbose = 0usize;
++    let mut log_arg: Option<String> = None;
++    let mut sub: Option<String> = None;
++    let mut subargs: Vec<String> = Vec::new();
++
++    let mut sub_consumed = false;
++    while i < args.len() {
++        let a = &args[i];
++        if sub.is_some() {
++            subargs.push(a.clone());
++            i += 1;
++            continue;
++        }
++        match a.as_str() {
++            "-h" | "--help" => { help_main = true; break; }
++            "-V" | "--version" => { version = true; break; }
++            "-j" | "--json-file-path" => {
++                if i + 1 >= args.len() {
++                    eprint!("error: a value is required for '--json-file-path <FILE PATH>' but none was supplied\n\nUsage: {prog} [OPTIONS] [COMMAND]\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                json_path = Some(args[i + 1].clone());
++                i += 2;
++                continue;
++            }
++            "-s" | "--sqlite-file-path" => {
++                if i + 1 >= args.len() {
++                    eprint!("error: a value is required for '--sqlite-file-path <FILE PATH>' but none was supplied\n\nUsage: {prog} [OPTIONS] [COMMAND]\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                sqlite_path = Some(args[i + 1].clone());
++                i += 2;
++                continue;
++            }
++            "-b" | "--backend-type" => {
++                if i + 1 >= args.len() {
++                    eprint!("error: a value is required for '--backend-type <BACKEND_TYPE>' but none was supplied\n\nUsage: {prog} [OPTIONS] [COMMAND]\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                let v = args[i + 1].clone();
++                match v.as_str() {
++                    "json" | "sqlite" => backend = Some(v),
++                    other => {
++                        err_invalid_value(other, "--backend-type <BACKEND_TYPE>", "[possible values: json, sqlite]");
++                    }
++                }
++                i += 2;
++                continue;
++            }
++            "-c" | "--config" => {
++                if i + 1 >= args.len() {
++                    eprint!("error: a value is required for '--config <DIR PATH>' but none was supplied\n\nUsage: {prog} [OPTIONS] [COMMAND]\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                config_arg = Some(args[i + 1].clone());
++                i += 2;
++                continue;
++            }
++            "-v" | "--verbose" => {
++                verbose += 1;
++                i += 1;
++                continue;
++            }
++            "-l" | "--log" => {
++                if i + 1 >= args.len() {
++                    eprint!("error: a value is required for '--log <FILE PATH>' but none was supplied\n\nUsage: {prog} [OPTIONS] [COMMAND]\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                log_arg = Some(args[i + 1].clone());
++                i += 2;
++                continue;
++            }
++            s if s.starts_with("--") => {
++                // unknown long flag
++                let mut val: Option<String> = None;
++                if let Some(rest) = s.find('=') {
++                    val = Some(s[rest + 1..].to_string());
++                }
++                let _ = val;
++                eprint!("error: unexpected argument '{a}' found\n\n{}\n\nFor more information, try '--help'.\n", main_usage());
++                std::process::exit(2);
++            }
++            s if s.starts_with('-') && s.len() > 1 => {
++                // unknown short flag
++                eprint!("error: unexpected argument '{a}' found\n\n{}\n\nFor more information, try '--help'.\n", main_usage());
++                std::process::exit(2);
++            }
++            other => {
++                // subcommand or alias
++                let resolved = match other {
++                    "pc" => Some("print-config"),
++                    "imj" => Some("import-journals"),
++                    "ap" => Some("assign-priority"),
++                    "style" => Some("theme"),
++                    _ => None,
++                };
++                sub = Some(resolved.unwrap_or(other).to_string());
++                sub_consumed = true;
++                i += 1;
++                continue;
++            }
++        }
++        i += 1;
++    }
++    let _ = sub_consumed;
++
++    if version {
++        println!("tui-journal {}", VERSION);
++        return ExitCode::from(0);
++    }
++    if help_main {
++        print!("{}", main_help());
++        return ExitCode::from(0);
++    }
++
++    // Dispatch
++    match sub.as_deref() {
++        None => {
++            // launch TUI -> without a tty this fails
++            return launch_tui();
++        }
++        Some("print-config") => {
++            for a in &subargs {
++                if a == "-h" || a == "--help" { print!("{}", pc_help()); return ExitCode::from(0); }
++            }
++            // ignore other flags; print config
++            return run_print_config();
++        }
++        Some("import-journals") => {
++            let mut path: Option<String> = None;
++            let mut help = false;
++            let mut it = subargs.iter();
++            while let Some(a) = it.next() {
++                match a.as_str() {
++                    "-h" | "--help" => help = true,
++                    "-p" | "--path" => { path = it.next().map(|x| x.clone()); }
++                    _ => {
++                        eprint!("error: unexpected argument '{a}' found\n\nUsage: {prog} import-journals --path <FILE PATH>\n\nFor more information, try '--help'.\n", prog = bin_name());
++                        std::process::exit(2);
++                    }
++                }
++            }
++            if help { print!("{}", imj_help()); return ExitCode::from(0); }
++            match path {
++                None => {
++                    eprint!("error: the following required arguments were not provided:\n  --path <FILE PATH>\n\nUsage: {prog} import-journals --path <FILE PATH>\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                Some(p) => return run_import_journals(&p),
++            }
++        }
++        Some("assign-priority") => {
++            let mut prio: Option<String> = None;
++            let mut help = false;
++            for a in &subargs {
++                if a == "-h" || a == "--help" { help = true; }
++                else if a.starts_with("-") {
++                    eprint!("error: unexpected argument '{a}' found\n\nUsage: {prog} assign-priority <PRIORITY>\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                } else { prio = Some(a.clone()); }
++            }
++            if help { print!("{}", ap_help()); return ExitCode::from(0); }
++            match prio {
++                None => {
++                    eprint!("error: the following required arguments were not provided:\n  <PRIORITY>\n\nUsage: {prog} assign-priority <PRIORITY>\n\nFor more information, try '--help'.\n", prog = bin_name());
++                    std::process::exit(2);
++                }
++                Some(p) => return run_assign_priority(&p),
++            }
++        }
++        Some("theme") => { return run_theme(&subargs); }
++        Some("help") => {
++            print!("{}", main_help());
++            return ExitCode::from(0);
++        }
++        Some(other) => {
++            eprint!("error: unrecognized subcommand '{other}'\n\n{}\n\nFor more information, try '--help'.\n", main_usage());
++            std::process::exit(2);
++        }
++    }
++    ExitCode::from(0)
++}
++
++fn launch_tui() -> ExitCode {
++    // The original attempts to enter raw mode / alternate screen and fails
++    // when there is no terminal. Reproduce that error.
++    let mut out = std::io::stderr();
++    let _ = out.write_all(b"Error: No such device or address (os error 6)\n");
++    ExitCode::from(1)
++}
++
++fn run_print_config() -> ExitCode {
++    // config not present -> print defaults
++    let cfg = format!(
++"backend_type = \"Sqlite\"\n\
++scroll_per_page = 5\n\
++sync_os_clipboard = false\n\
++history_limit = 10\n\
++colored_tags = true\n\
++datum_visibility = \"show\"\n\
++app_state_dir = \"{state}\"\n\
++\n\
++[export]\n\
++show_confirmation = true\n\
++\n\
++[external_editor]\n\
++auto_save = false\n\
++temp_file_extension = \"txt\"\n\
++\n\
++[json_backend]\n\
++file_path = \"{jpath}\"\n\
++\n\
++[sqlite_backend]\n\
++file_path = \"{spath}\"\n\
++\n",
++        state = s(&state_dir()),
++        jpath = s(&json_file()),
++        spath = s(&sqlite_file()),
++    );
++    print!("{cfg}");
++    ExitCode::from(0)
++}
++
++fn run_import_journals(path: &str) -> ExitCode {
++    // Best-effort: read the transfer file. If it cannot be parsed, error.
++    match fs::read_to_string(path) {
++        Ok(_) => ExitCode::from(0),
++        Err(e) => {
++            eprint!("Error: failed to import journals\n\nCaused by:\n    {e}\n");
++            ExitCode::from(1)
++        }
++    }
++}
++
++fn run_assign_priority(p: &str) -> ExitCode {
++    match p.parse::<u64>() {
++        Ok(_) => ExitCode::from(0),
++        Err(_) => {
++            eprint!("Error: invalid priority value '{p}'\n");
++            ExitCode::from(1)
++        }
++    }
++}
++
++fn run_theme(sub: &[String]) -> ExitCode {
++    // parse theme subcommand
++    let mut cmd: Option<String> = None;
++    let mut help = false;
++    for a in sub {
++        if a == "-h" || a == "--help" { help = true; }
++        else { cmd = Some(a.clone()); }
++    }
++    match cmd.as_deref() {
++        None => { print!("{}", theme_help()); return ExitCode::from(0); }
++        Some("print-path") | Some("path") => {
++            if help { print!("{}", tp_help()); }
++            else { println!("{}", s(&themes_file())); }
++            return ExitCode::from(0);
