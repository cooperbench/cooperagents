diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..24c5e09
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,316 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <signal.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <ctype.h>
+
+#define VERSION "2.0"
+#define COLS 80
+#define ROWS 24
+#define MAX_MSG_LEN 100
+
+static int async = 0;
+static int bold = 0;
+static int all_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_scroll = 0;
+static int shadow_only = 0;
+static int locked = 0;
+static int rainbow = 0;
+static int every_char = 0;
+static int no_bold = 0;
+static int screensaver = 0;
+static int lambda_mode = 0;
+static int x_mode = 0;
+static int update_delay = 4;
+static char *color = "green";
+static char *message = NULL;
+static char *tty = NULL;
+static int async_toggle = 0;
+
+static char matrix_chars[] = "01";
+static char lambda_chars[] = "λ";
+static char *current_chars = matrix_chars;
+static char *current_lambda = lambda_chars;
+
+static struct termios orig_termios;
+static int quit = 0;
+
+static void sigint_handler(int sig) {
+    (void)sig;
+    quit = 1;
+}
+
+static void print_help(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static int get_color_code(const char *color_str) {
+    if (strcmp(color_str, "red") == 0) return 1;
+    if (strcmp(color_str, "green") == 0) return 2;
+    if (strcmp(color_str, "yellow") == 0) return 3;
+    if (strcmp(color_str, "blue") == 0) return 4;
+    if (strcmp(color_str, "magenta") == 0) return 5;
+    if (strcmp(color_str, "cyan") == 0) return 6;
+    if (strcmp(color_str, "white") == 0) return 7;
+    if (strcmp(color_str, "black") == 0) return 0;
+    return 2;
+}
+
+static void setup_termios(void) {
+    tcgetattr(STDIN_FILENO, &orig_termios);
+    struct termios *t = &orig_termios;
+    t->c_lflag &= ~(ECHO | ICANON);
+    t->c_iflag &= ~(BRKINT | ICRNL | INPCK | ISTRIP | IXON);
+    t->c_oflag &= ~OPOST;
+    t->c_cflag |= (CS8);
+    t->c_cc[VMIN] = 0;
+    t->c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, t);
+}
+
+static void restore_termios(void) {
+    tcsetattr(STDIN_FILENO, TCSANOW, &orig_termios);
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void draw_matrix(void) {
+    int i, j;
+    int color_code = get_color_code(color);
+    
+    for (i = 0; i < ROWS; i++) {
+        for (j = 0; j < COLS; j++) {
+            if (shadow_only) {
+                printf(" ");
+            } else if (all_bold) {
+                printf("%c", current_chars[j % 2]);
+            } else if (bold) {
+                printf("%c", current_chars[j % 2]);
+            } else {
+                printf("%c", current_chars[j % 2]);
+            }
+        }
+        printf("\n");
+    }
+    
+    if (message && !screensaver) {
+        printf("\033[%d;%dH%s", ROWS/2, COLS/2, message);
+        printf("\033[0m");
+    }
+}
+
+static void draw_matrix_old_scroll(void) {
+    int i, j;
+    int color_code = get_color_code(color);
+    
+    for (i = 0; i < ROWS; i++) {
+        for (j = 0; j < COLS; j++) {
+            if (shadow_only) {
+                printf(" ");
+            } else if (all_bold) {
+                printf("%c", current_chars[j % 2]);
+            } else if (bold) {
+                printf("%c", current_chars[j % 2]);
+            } else {
+                printf("%c", current_chars[j % 2]);
+            }
+        }
+        printf("\n");
+    }
+    
+    if (message && !screensaver) {
+        printf("\033[%d;%dH%s", ROWS/2, COLS/2, message);
+        printf("\033[0m");
+    }
+}
+
+static void update_chars(void) {
+    if (lambda_mode) {
+        current_chars = current_lambda;
+    } else {
+        current_chars = matrix_chars;
+    }
+}
+
+static void parse_args(int argc, char *argv[]) {
+    int i;
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_help();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold = 0;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_scroll = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            shadow_only = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            locked = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            every_char = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+            bold = 0;
+            all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                update_delay = atoi(argv[++i]);
+                if (update_delay < 0) update_delay = 0;
+                if (update_delay > 10) update_delay = 10;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = argv[++i];
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                message = argv[++i];
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty = argv[++i];
+            }
+        } else {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            print_help();
+            exit(1);
+        }
+    }
+}
+
+static void main_loop(void) {
+    fd_set readfds;
+    struct timeval tv;
+    int max_fd = STDIN_FILENO;
+    int i, j;
+    int color_code = get_color_code(color);
+    
+    setup_termios();
+    signal(SIGINT, sigint_handler);
+    
+    clear_screen();
+    
+    if (old_scroll) {
+        draw_matrix_old_scroll();
+    } else {
+        draw_matrix();
+    }
+    
+    while (!quit) {
+        FD_ZERO(&readfds);
+        FD_SET(STDIN_FILENO, &readfds);
+        
+        tv.tv_sec = update_delay;
+        tv.tv_usec = 0;
+        
+        if (select(max_fd + 1, &readfds, NULL, NULL, &tv) > 0) {
+            char c;
+            if (read(STDIN_FILENO, &c, 1) > 0) {
+                if (c == 'q') {
+                    quit = 1;
+                } else if (c == 'a') {
+                    async = !async;
+                } else if (c == 'b') {
+                    bold = !bold;
+                } else if (c == 'B') {
+                    all_bold = 1;
+                    bold = 0;
+                } else if (c == 'n') {
+                    bold = 0;
+                    all_bold = 0;
+                } else if (c >= '0' && c <= '9') {
+                    update_delay = c - '0';
+                } else if (c == '!') {
+                    color = "red";
+                } else if (c == '@') {
+                    color = "green";
+                } else if (c == '#') {
+                    color = "yellow";
+                } else if (c == '$') {
+                    color = "blue";
+                } else if (c == '%') {
+                    color = "magenta";
+                } else if (c == '^') {
+                    color = "cyan";
+                } else if (c == '&') {
+                    color = "white";
+                } else if (c == ')') {
+                    color = "black";
+                }
+            }
+        }
+        
+        if (!screensaver) {
+            if (old_scroll) {
+                draw_matrix_old_scroll();
+            } else {
+                draw_matrix();
+            }
+        }
+        
+        usleep(10000);
+    }
+    
+    restore_termios();
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    main_loop();
+    return 0;
+}
