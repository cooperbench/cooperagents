+#ifndef CORE_H
+#define CORE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+
+#define MAX_COLS 256
+#define MAX_ROWS 256
+#define MAX_MESSAGE_LEN 256
+#define MAX_TTY_NAME 64
+
+typedef struct {
+    int async;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int force_term;
+    int linux_mode;
+    int old_scroll;
+    int only_shadows;
+    int lock;
+    int rainbow;
+    int lambda;
+    int characters_change;
+    int screensaver;
+    int x_mode;
+    int use_japanese;
+    int tty_set;
+    int message_set;
+    
+    int update_delay;
+    char color[16];
+    char message[MAX_MESSAGE_LEN];
+    char tty_name[MAX_TTY_NAME];
+    
+    int cols;
+    int rows;
+    int width;
+    int height;
+    
+    char **matrix_chars;
+    char **shadow_chars;
+    int *char_positions;
+    int *shadow_positions;
+    int *char_colors;
+    int *shadow_colors;
+    
+    int current_color;
+    int color_index;
+    int last_color;
+    
+    int locked;
+    int quit;
+    int keystroke_mode;
+    int keystroke_char;
+    
+    struct termios orig_termios;
+    int tty_fd;
+    
+    int initialized;
+    int help;
+    int version;
+} cmatrix_config;
+
+void init_config(cmatrix_config *config);
+void free_config(cmatrix_config *config);
+int parse_args(int argc, char **argv, cmatrix_config *config);
+void print_usage(const char *prog_name);
+void print_version(void);
+int setup_terminal(cmatrix_config *config);
+void restore_terminal(cmatrix_config *config);
+void generate_matrix(cmatrix_config *config);
+void scroll_matrix(cmatrix_config *config);
+void render_matrix(cmatrix_config *config);
+void handle_keystroke(cmatrix_config *config, char c);
+void run_loop(cmatrix_config *config);
+
+#endif /* CORE_H */
diff --git a/main.c b/main.c
new file mode 100644
index 0000000..bf3c429
--- /dev/null
+++ b/main.c
@@ -0,0 +1,30 @@
+#include "core.h"
+
+int main(int argc, char **argv) {
+    cmatrix_config config;
+    init_config(&config);
+    
+    if (parse_args(argc, argv, &config) == 0) {
+        if (config.help) {
+            print_usage(argv[0]);
+            return 0;
+        }
+        if (config.version) {
+            print_version();
+            return 0;
+        }
+        
+        if (setup_terminal(&config) != 0) {
+            fprintf(stderr, "Error: Failed to setup terminal\n");
+            return 1;
+        }
+        
+        generate_matrix(&config);
+        run_loop(&config);
+        
+        restore_terminal(&config);
+        free_config(&config);
+    }
+    
+    return 0;
+}
