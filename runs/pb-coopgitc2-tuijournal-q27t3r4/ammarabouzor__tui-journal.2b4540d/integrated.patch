+import os, pty, sys, time, select, fcntl, termios, struct, signal
+
+def run(argv, size=(24,80), feed=None, duration=4.0, outfile='pty_cap.bin'):
+    pid, fd = pty.fork()
+    if pid == 0:
+        os.execv(argv[0], argv)
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', size[0], size[1], 0, 0))
+    out = b''
+    start = time.time()
+    feed = list(feed) if feed else []
+    sent = 0
+    code = None
+    exited = False
+    while time.time() - start < duration:
+        while sent < len(feed) and feed[sent][0] <= time.time() - start:
+            try: os.write(fd, feed[sent][1])
+            except OSError: pass
+            sent += 1
+        r, _, _ = select.select([fd], [], [], 0.05)
+        if fd in r:
+            try:
+                chunk = os.read(fd, 65536)
+            except OSError:
+                chunk = b''
+            if not chunk:
+                exited = True
+            else:
+                out += chunk
+        p, st = os.waitpid(pid, os.WNOHANG)
+        if p == pid:
+            code = os.waitstatus_to_exitcode(st)
+            exited = True
+        if exited:
+            while True:
+                r, _, _ = select.select([fd], [], [], 0.05)
+                if fd not in r: break
+                try: c = os.read(fd, 65536)
+                except OSError: break
+                if not c: break
+                out += c
+            break
+    if code is None:
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except ProcessLookupError: pass
+    try:
+        p, status = os.waitpid(pid, 0)
+        if code is None:
+            code = os.waitstatus_to_exitcode(status)
+    except ChildProcessError:
+        pass
+    try: os.close(fd)
+    except OSError: pass
+    with open(outfile, 'wb') as fh:
+        fh.write(out)
+    return code, len(out)
+
+if __name__ == '__main__':
+    import json
+    spec = json.loads(sys.argv[1])
+    code, n = run(spec['argv'], size=tuple(spec.get('size',(24,80))),
+                  feed=[(float(t), data.encode() if isinstance(data,str) else bytes(data)) for t, data in (spec.get('feed') or [])],
+                  duration=spec.get('duration',4.0), outfile=spec.get('outfile','pty_cap.bin'))
+    print(json.dumps({'exit': code, 'bytes': n}))
