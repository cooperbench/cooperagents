@@ -0,0 +1,123 @@
+import re, sys, hashlib
+
+def decode(s):
+    try: return s.decode('utf-8')
+    except Exception: return '?'
+
+class VT:
+    def __init__(self, rows, cols):
+        self.rows, self.cols = rows, cols
+        self.r, self.c = 1, 1
+        self.fg, self.bg, self.bold = -1, -1, False
+        self.grid = {}   # (r,c) -> (ch, fg, bg, bold)
+        self.frames = []
+    def write(self, s):
+        for ch in s:
+            if self.c > self.cols: break
+            self.grid[(self.r, self.c)] = (ch, self.fg, self.bg, self.bold)
+            self.c += 1
+    def snapshot(self):
+        key = hashlib.md5(repr(sorted(self.grid.items())).encode()).digest()
+        if not self.frames or self.frames[-1][0] != key:
+            self.frames.append((key, dict(self.grid)))
+    def feed(self, data):
+        i = 0
+        while i < len(data):
+            if data[i:i+1] == b'\x1b' and i+1 < len(data):
+                if data[i+1:i+2] == b'[':
+                    if re.match(rb'\x1b\[\?1049h', data[i:]): i += 6; continue
+                    if re.match(rb'\x1b\[\?1049l', data[i:]): i += 6; continue
+                    m = re.match(rb'\x1b\[\?25([lh])', data[i:])
+                    if m:
+                        i += m.end()
+                        if m.group(1) == b'l': self.snapshot()
+                        continue
+                    m = re.match(rb'\x1b\[38;5;(\d+)m', data[i:])
+                    if m: self.fg = int(m.group(1)); i += m.end(); continue
+                    m = re.match(rb'\x1b\[48;5;(\d+)m', data[i:])
+                    if m: self.bg = int(m.group(1)); i += m.end(); continue
+                    m = re.match(rb'\x1b\[38;2;(\d+);(\d+);(\d+)m', data[i:])
+                    if m: self.fg = (17,)+tuple(int(x) for x in m.groups()); i += m.end(); continue
+                    m = re.match(rb'\x1b\[48;2;(\d+);(\d+);(\d+)m', data[i:])
+                    if m: self.bg = (17,)+tuple(int(x) for x in m.groups()); i += m.end(); continue
+                    m = re.match(rb'\x1b\[39;49m', data[i:])
+                    if m: self.fg = self.bg = -1; i += m.end(); continue
+                    m = re.match(rb'\x1b\[0;39m', data[i:])
+                    if m: self.fg = self.bg = -1; self.bold=False; i += m.end(); continue
+                    m = re.match(rb'\x1b\[(\d+)m', data[i:])
+                    if m:
+                        n = int(m.group(1))
+                        if n == 0: self.fg = self.bg = -1; self.bold = False
+                        elif n == 1: self.bold = True
+                        elif n == 22: self.bold = False
+                        elif n == 39: self.fg = -1
+                        elif n == 49: self.bg = -1
+                        elif 30 <= n <= 37: self.fg = n - 30
+                        elif 40 <= n <= 47: self.bg = n - 40
+                        i += m.end(); continue
+                    m = re.match(rb'\x1b\[(\d+);(\d+)H', data[i:])
+                    if m:
+                        self.r = min(int(m.group(1)), self.rows); self.c = min(int(m.group(2)), self.cols)
+                        i += m.end(); continue
+                    m = re.match(rb'\x1b\[[0-9;?]*[A-Za-z]', data[i:])
+                    if m: i += m.end(); continue
+                i += 1; continue
+            if data[i] >= 32 and data[i] < 127 or data[i] >= 192:
+                j = i
+                while j < len(data) and data[j] >= 32 and data[j] < 127:
+                    j += 1
+                # also consume utf-8 continuation bytes
+                j2 = j
+                while j2 < len(data) and data[j2-1] != 0 and data[j:j2] == b'' : pass
+                # simpler: decode char by char
+                j = i
+                buf = b''
+                while j < len(data):
+                    b = data[j]
+                    if b < 32 or b > 159 and b >= 127 and False:
+                        break
+                    if 32 <= b < 127:
+                        buf += bytes([b]); j += 1; continue
+                    if b >= 192:
+                        if b < 224: n = 2
+                        elif b < 240: n = 3
+                        else: n = 4
+                        if j + n <= len(data):
+                            buf += data[j:j+n]; j += n; continue
+                        break
+                    break
+                if buf:
+                    self.write(decode(buf))
+                i = j
+                if i == j: i += 1
+                continue
+            i += 1
+    def dump(self, limit=None):
+        for fi, (key, g) in enumerate(self.frames):
+            print(f'===== frame {fi} =====')
+            for r in range(1, self.rows+1):
+                row = []
+                prev = None
+                for c in range(1, self.cols+1):
+                    ch, fg, bg, bold = g.get((r,c), (' ', None, None, False))
+                    st = (fg, bg, bold)
+                    if st != prev:
+                        row.append(tag(fg, bg, bold))
+                        prev = st
+                    row.append(ch if ch != ' ' else '·')
+                print(f'{r:2}|' + ''.join(row))
+
+def tag(fg, bg, bold):
+    if (fg, bg, bold) == (None, None, False) or (fg is None and bg is None and not bold):
+        return '⟦.⟧'
+    def col(v):
+        if v is None: return '·'
+        if isinstance(v, tuple): return '#%02X%02X%02X' % v[1:]
+        return {0:'k',1:'r',2:'g',3:'y',4:'b',5:'m',6:'c',7:'w',8:'dk',9:'lr',10:'lg',11:'ly',12:'lb',13:'lm',14:'lc',15:'w2'}.get(v, str(v))
+    return f'⟦{col(fg)}/{col(bg)}/{"B" if bold else "-"}⟧'
+
+if __name__ == '__main__':
+    data = open(sys.argv[1], 'rb').read()
+    vt = VT(24, 80)
+    vt.feed(data)
+    vt.dump()
