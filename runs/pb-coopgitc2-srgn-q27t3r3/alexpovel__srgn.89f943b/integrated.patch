diff --git a/src/main.rs b/src/main.rs
new file mode 100644
index 0000000..b12dfc8
--- /dev/null
+++ b/src/main.rs
@@ -0,0 +1,9 @@
+use clap::{Arg, Command};
+fn main() {
+    let m = Command::new("srgn")
+        .version("0.14.1")
+        .subcommand_required(false)
+        .arg(Arg::new("scope").num_args(1).value_name("SCOPE"))
+        .get_matches();
+    println!("built ok scope={:?}", m.get_one::<String>("scope"));
+}
