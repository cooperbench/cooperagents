+static int parse_color(const char *str) {
+    if (strcasecmp(str, "green") == 0) return 32;
+    if (strcasecmp(str, "red") == 0) return 31;
+    if (strcasecmp(str, "blue") == 0) return 34;
+    if (strcasecmp(str, "white") == 0) return 37;
+    if (strcasecmp(str, "yellow") == 0) return 33;
+    if (strcasecmp(str, "cyan") == 0) return 36;
+    if (strcasecmp(str, "magenta") == 0) return 35;
+    if (strcasecmp(str, "black") == 0) return 30;
+    return 32;
+}
+
+static void init_matrix(Matrix *m) {
+    m->cols = 80;
+    m->rows = 24;
+    m->async = 0;
+    m->bold = 0;
+    m->all_bold = 0;
+    m->no_bold = 0;
+    m->old_scroll = 0;
+    m->rainbow = 0;
+    m->every_char = 0;
+    m->lambda = 0;
+    m->lock = 0;
+    m->screensaver = 0;
+    m->update_delay = 4;
+    m->color = NULL;
+    m->message = NULL;
+    m->tty_fd = -1;
+    
+    for (int r = 0; r < m->rows; r++) {
+        for (int c = 0; c < m->cols; c++) {
+            m->cells[c][r].c = matrix_chars[rand() % (sizeof(matrix_chars) - 1)];
+            m->cells[c][r].bold = 0;
+            m->cells[c][r].shadow = 0;
+        }
+    }
+}
+
+static void set_color(int fg, int bg) {
+    printf("\033[%d;%dm", fg, bg);
+}
+
+static void clear_screen(void) {
+    printf("\033[2J");
+}
+
+static void init_tty(void) {
+    struct termios oldt, newt;
+    tcgetattr(STDIN_FILENO, &oldt);
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
+}
+
+static void restore_tty(struct termios *oldt) {
+    tcsetattr(STDIN_FILENO, TCSANOW, oldt);
+}
+
+static void draw_matrix(Matrix *m) {
+    for (int r = 0; r < m->rows; r++) {
+        for (int c = 0; c < m->cols; c++) {
+            Cell *cell = &m->cells[c][r];
+            int fg = 32;
+            int bg = 49;
+            
+            if (m->rainbow) {
+                int hue = (time(NULL) + c * 3 + r) % 360;
+                fg = (hue / 60) + 30;
+            } else if (m->color) {
+                fg = parse_color(m->color);
+            }
+            
+            if (cell->bold || m->all_bold || (!m->no_bold && m->bold)) {
+                printf("\033[%d;%dm", fg, 1);
+            } else {
+                printf("\033[%d;%dm", fg, 0);
+            }
+            
+            if (m->lambda) {
+                printf("λ");
+            } else if (m->every_char) {
+                printf("%c", matrix_chars[rand() % (sizeof(matrix_chars) - 1)]);
+            } else {
+                printf("%c", cell->c);
+            }
+            
+            if (cell->shadow) {
+                printf("\033[%dm", 0);
+                printf("%c", shadow_chars[rand() % (sizeof(shadow_chars) - 1)]);
+                printf("\033[%dm", fg);
+            }
+        }
+        printf("\n");
+    }
+}
+
+static void draw_message(Matrix *m) {
+    if (m->message && m->message[0]) {
+        int msg_len = strlen(m->message);
+        int start_col = (m->cols - msg_len) / 2;
+        
+        for (int r = m->rows / 2 - 1; r < m->rows / 2 + 2; r++) {
+            for (int c = 0; c < m->cols; c++) {
+                if (c >= start_col && c < start_col + msg_len && r == m->rows / 2) {
+                    printf("\033[37m%c\033[39m", m->message[c - start_col]);
+                } else {
+                    printf(" ");
+                }
+            }
+            printf("\n");
+        }
+    }
+}
+
+static void scroll(Matrix *m) {
+    if (m->old_scroll) {
+        for (int r = m->rows - 1; r > 0; r--) {
+            for (int c = 0; c < m->cols; c++) {
+                m->cells[c][r] = m->cells[c][r - 1];
+            }
+        }
+        for (int c = 0; c < m->cols; c++) {
+            m->cells[c][0].c = matrix_chars[rand() % (sizeof(matrix_chars) - 1)];
+            m->cells[c][0].bold = 0;
+            m->cells[c][0].shadow = 0;
+        }
+    } else {
+        for (int c = 0; c < m->cols; c++) {
+            for (int r = m->rows - 1; r > 0; r--) {
+                m->cells[c][r] = m->cells[c][r - 1];
+            }
+            m->cells[c][0].c = matrix_chars[rand() % (sizeof(matrix_chars) - 1)];
+            m->cells[c][0].bold = 0;
+            m->cells[c][0].shadow = 0;
+        }
+    }
+}
