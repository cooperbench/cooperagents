+int main(int argc, char *argv[]) {
+    Matrix m;
+    struct termios oldt;
+    int ch;
+    
+    while ((ch = getopt(argc, argv, "abBflohnsmVxru:C:M:t:?")) != -1) {
+        switch (ch) {
+            case 'a': m.async = 1; break;
+            case 'b': m.bold = 1; break;
+            case 'B': m.all_bold = 1; break;
+            case 'f': printf("\033[?1049h\033[4l"); break;
+            case 'l': printf("\033[4l"); break;
+            case 'o': m.old_scroll = 1; break;
+            case 'c': break;
+            case 'L': m.lock = 1; break;
+            case 'h': case '?': print_usage(argv[0]); exit(0);
+            case 'r': m.rainbow = 1; break;
+            case 'k': m.every_char = 1; break;
+            case 'n': m.no_bold = 1; break;
+            case 's': m.screensaver = 1; break;
+            case 'm': m.lambda = 1; break;
+            case 'x': break;
+            case 'V': print_version(); exit(0);
+            case 'u': m.update_delay = atoi(optarg); break;
+            case 'C': m.color = optarg; break;
+            case 'M': m.message = optarg; break;
+            case 't': m.tty_fd = open(optarg, O_RDWR); break;
+            default: print_usage(argv[0]); exit(0);
+        }
+    }
+    
+    if (m.tty_fd >= 0) {
+        close(m.tty_fd);
+        m.tty_fd = -1;
+    }
+    
+    init_matrix(&m);
+    init_tty();
+    
+    clear_screen();
+    set_color(parse_color(m.color), 49);
+    
+    if (m.lambda) {
+        for (int r = 0; r < m.rows; r++) {
+            for (int c = 0; c < m.cols; c++) {
+                printf("\033[%d;%dH", r + 1, c + 1);
+                printf("λ");
+            }
+            printf("\n");
+        }
+    } else {
+        draw_matrix(&m);
+    }
+    
+    if (m.message && m.message[0]) {
+        draw_message(&m);
+    }
+    
+    printf("\033[?25h");
+    
+    if (m.screensaver) {
+        char buf[1];
+        fd_set readfds;
+        struct timeval tv;
+        
+        while (1) {
+            FD_ZERO(&readfds);
+            FD_SET(STDIN_FILENO, &readfds);
+            tv.tv_sec = 0;
+            tv.tv_usec = m.update_delay * 100000;
+            
+            if (select(STDIN_FILENO + 1, &readfds, NULL, NULL, &tv) > 0) {
+                read(STDIN_FILENO, buf, 1);
+                break;
+            }
+            
+            if (m.update_delay > 0) {
+                usleep(m.update_delay * 100000);
+            }
+            
+            scroll(&m);
+            clear_screen();
+            set_color(parse_color(m.color), 49);
+            draw_matrix(&m);
+            if (m.message && m.message[0]) {
+                draw_message(&m);
+            }
+        }
+    }
+    
+    restore_tty(&oldt);
+    printf("\033[?1049l\033[?25h\033[?1l\033[2J");
+    
+    return 0;
+}
