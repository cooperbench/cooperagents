+}
+
+/* Parse command line arguments */
+int parse_args(int argc, char *argv[]) {
+    int i;
+    
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage(argv[0]);
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            bold_chars = 0;
+            all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            char_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                update_delay = atoi(argv[i]);
+                if (update_delay < 0 || update_delay > 10) {
+                    printf(" Invalid update delay value\n");
+                    exit(1);
+                }
+            } else {
+                printf(" Invalid update delay value\n");
+                exit(1);
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                strncpy(color, argv[i], sizeof(color) - 1);
+                color[sizeof(color) - 1] = '\0';
+                if (!is_valid_color(color)) {
+                    printf(" Invalid color selection\n");
+                    printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+                    exit(0);
+                }
+            } else {
+                printf(" Invalid color selection\n");
+                printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+                exit(0);
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                strncpy(message, argv[i], sizeof(message) - 1);
+                message[sizeof(message) - 1] = '\0';
+            } else {
+                strncpy(message, "", sizeof(message) - 1);
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                strncpy(tty_name, argv[i], sizeof(tty_name) - 1);
+                tty_name[sizeof(tty_name) - 1] = '\0';
+            } else {
+                strncpy(tty_name, "", sizeof(tty_name) - 1);
+            }
+        } else {
+            printf(" Unknown option: %s\n", argv[i]);
+            print_usage(argv[0]);
+            exit(1);
+        }
+    }
+    
+    return 0;
+}
+
+int main(int argc, char *argv[]) {
+    (void)argc;
+    (void)argv;
+    
+    /* Parse command line arguments */
+    parse_args(argc, argv);
+    
+    /* Initialize the matrix */
+    init_matrix();
+    
+    /* Run the matrix simulation */
+    run_matrix();
+    
+    /* Cleanup */
+    cleanup();
+    
+    return 0;
+}
diff --git a/src/matrix.c b/src/matrix.c
new file mode 100644
index 0000000..3adcc3c
--- /dev/null
+++ b/src/matrix.c
@@ -0,0 +1,337 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <ctype.h>
+#include <math.h>
+#include <time.h>
+#include <errno.h>
+
+#include <fcntl.h>
+#include "cmatrix_config.h"
+
+/* Character sets */
+const char *latin_chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+const char *katakana_chars = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+const char *lambda_chars = "λ";
+
+/* Global matrix state */
+matrix_t matrix;
+int running = 1;
+int tty_fd = -1;
+struct termios orig_termios;
+
+/* Initialize the matrix */
+void init_matrix(void) {
+    int i, j;
+    
+    /* Initialize grid */
+    matrix.width = MATRIX_WIDTH;
+    matrix.height = MATRIX_HEIGHT;
+    matrix.grid = malloc(sizeof(char *) * matrix.height);
+    if (!matrix.grid) {
+        fprintf(stderr, "Memory allocation failed\n");
+        exit(1);
+    }
+    
+    for (i = 0; i < matrix.height; i++) {
+        matrix.grid[i] = malloc(sizeof(char) * matrix.width);
+        if (!matrix.grid[i]) {
+            fprintf(stderr, "Memory allocation failed\n");
+            exit(1);
+        }
+        for (j = 0; j < matrix.width; j++) {
+            matrix.grid[i][j] = ' ';
+        }
+    }
+    
+    /* Initialize other settings */
+    matrix.color = 0;
+    matrix.bold = bold_chars;
+    matrix.async = async_scroll;
+    matrix.old_style = old_style;
+    matrix.char_change = char_change;
+    matrix.use_japanese = use_japanese;
+    matrix.lambda_mode = lambda_mode;
+    matrix.rainbow = rainbow_mode;
+    matrix.all_bold = all_bold;
+    matrix.no_bold = !bold_chars;
+    
+    /* Set up terminal */
+    tty_fd = open("/dev/tty", O_RDWR);
+    if (tty_fd < 0) {
+        /* Try to use stdout if /dev/tty fails */
+        tty_fd = STDOUT_FILENO;
+    }
+    
+    if (isatty(tty_fd)) {
+        if (tcgetattr(tty_fd, &orig_termios) != 0) {
+            perror("tcgetattr");
+        }
+        
+        struct termios raw = orig_termios;
+        raw.c_lflag &= ~(ECHO | ICANON);
+        raw.c_cc[VMIN] = 0;
+        raw.c_cc[VTIME] = 0;
+        
+        if (tcsetattr(tty_fd, TCSANOW, &raw) != 0) {
+            perror("tcsetattr");
+        }
+    }
+    
+    /* Set terminal type if forced */
+    if (force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    /* Set color */
+    set_color();
+}
+
+/* Set terminal color */
+void set_color(void) {
+    int color_code;
+    
+    switch (matrix.color) {
+        case 0: /* green */
+            color_code = 32;
+            break;
+        case 1: /* red */
+            color_code = 31;
+            break;
+        case 2: /* blue */
+            color_code = 34;
+            break;
+        case 3: /* white */
+            color_code = 37;
+            break;
+        case 4: /* yellow */
+            color_code = 33;
+            break;
+        case 5: /* cyan */
+            color_code = 36;
+            break;
+        case 6: /* magenta */
+            color_code = 35;
+            break;
+        case 7: /* black */
+            color_code = 30;
+            break;
+        default:
+            color_code = 32;
+            break;
+    }
+    
+    printf("\033[%dm", color_code);
+}
+
+/* Run the matrix simulation */
+void run_matrix(void) {
+    int i, j;
+    int delay_ms;
+    struct timeval tv;
+    fd_set readfds;
+    int max_fd;
+    
+    /* Set up signal handlers */
+    signal(SIGINT, SIG_DFL);
+    signal(SIGTERM, SIG_DFL);
+    
+    /* Set update delay */
+    delay_ms = get_update_delay() * 100;
+    if (delay_ms < 10) delay_ms = 10;
+    
+    /* Main loop */
+    while (running) {
+        /* Clear screen */
+        printf("\033[2J\033[H");
+        
+        /* Print message if set */
+        if (strlen(message) > 0) {
+            printf("\033[%d;%dH", MATRIX_HEIGHT / 2, MATRIX_WIDTH / 2);
+            printf("\033[1;37m%s\033[0m", message);
+        }
+        
+        /* Print grid */
+        for (i = 0; i < matrix.height; i++) {
+            for (j = 0; j < matrix.width; j++) {
+                char c = matrix.grid[i][j];
+                
+                /* Apply character transformations */
+                if (matrix.lambda_mode && c != ' ') {
+                    c = lambda_chars[0];
+                } else if (matrix.use_japanese && c == ' ') {
+                    c = katakana_chars[rand() % strlen(katakana_chars)];
+                }
+                
+                printf("%c", c);
+            }
+            printf("\n");
+        }
+        
+        /* Check for input */
+        if (!screensaver_mode && !lock_mode) {
+            FD_ZERO(&readfds);
+            FD_SET(STDIN_FILENO, &readfds);
+            max_fd = STDIN_FILENO;
+            
+            tv.tv_sec = 0;
+            tv.tv_usec = delay_ms * 1000;
+            
+            if (select(max_fd + 1, &readfds, NULL, NULL, &tv) > 0) {
+                char buf[10];
+                int n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+                if (n > 0) {
+                    buf[n] = '\0';
+                    handle_input(buf);
+                }
+            }
+        }
+        
+        /* Sleep for delay */
+        usleep(delay_ms);
+    }
+    
+    /* Restore terminal */
+    if (isatty(tty_fd)) {
+        tcsetattr(tty_fd, TCSANOW, &orig_termios);
+    }
+    
+    /* Clear screen and move to home */
+    printf("\033[2J\033[H");
+}
+
+/* Handle keyboard input */
+void handle_input(const char *buf) {
+    int i;
+    
+    for (i = 0; buf[i] != '\0'; i++) {
+        char c = buf[i];
+        
+        if (c == 'q' || c == 'Q') {
+            running = 0;
+            break;
+        } else if (c == 'a' || c == 'A') {
+            matrix.async = !matrix.async;
+        } else if (c == 'b' || c == 'B') {
+            matrix.bold = !matrix.bold;
+        } else if (c == 'n' || c == 'N') {
+            matrix.bold = 0;
+            matrix.all_bold = 0;
+        } else if (c >= '0' && c <= '9') {
+            update_delay = c - '0';
+        } else if (c == '!') {
+            matrix.color = 0;
+        } else if (c == '@') {
+            matrix.color = 0;
+        } else if (c == '#') {
+            matrix.color = 2;
+        } else if (c == '$') {
+            matrix.color = 3;
+        } else if (c == '%') {
+            matrix.color = 4;
+        } else if (c == '^') {
+            matrix.color = 5;
+        } else if (c == '&') {
+            matrix.color = 6;
+        } else if (c == ')') {
+            matrix.color = 7;
+        }
+    }
+}
+
+/* Cleanup resources */
+void cleanup(void) {
+    int i;
+    
+    if (matrix.grid) {
+        for (i = 0; i < matrix.height; i++) {
+            free(matrix.grid[i]);
+        }
+        free(matrix.grid);
+    }
+    
+    if (tty_fd >= 0 && tty_fd != STDOUT_FILENO) {
+        close(tty_fd);
+    }
+}
+
+/* Get color string */
+const char *get_color_string(void) {
+    switch (matrix.color) {
+        case 0: return "green";
+        case 1: return "red";
+        case 2: return "blue";
+        case 3: return "white";
+        case 4: return "yellow";
+        case 5: return "cyan";
+        case 6: return "magenta";
+        case 7: return "black";
+        default: return "green";
+    }
+}
+
+/* Get update delay */
+int get_update_delay(void) {
+    return update_delay;
+}
+
+/* Check if in screensaver mode */
+int is_screensaver_mode(void) {
+    return screensaver_mode;
+}
+
+/* Check if in lock mode */
+int is_lock_mode(void) {
+    return lock_mode;
+}
+
+/* Check if in lambda mode */
+int is_lambda_mode(void) {
+    return lambda_mode;
+}
+
+/* Check if in rainbow mode */
+int is_rainbow_mode(void) {
+    return rainbow_mode;
+}
+
+/* Check if in char change mode */
+int is_char_change_mode(void) {
+    return char_change;
+}
+
+/* Check if in old style mode */
+int is_old_style_mode(void) {
+    return old_style;
+}
+
+/* Check if in async mode */
+int is_async_mode(void) {
+    return async_scroll;
+}
+
+/* Check if in bold mode */
+int is_bold_mode(void) {
+    return matrix.bold;
+}
+
+/* Check if all bold */
+int is_all_bold_mode(void) {
+    return matrix.all_bold;
+}
+
+/* Check if no bold */
+int is_no_bold_mode(void) {
+    return matrix.no_bold;
+}
+
+/* Check if using Japanese */
+int is_japanese_mode(void) {
+    return matrix.use_japanese;
+}
