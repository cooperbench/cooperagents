+++            color_code = 32;
+++            break;
+++        case 1: /* red */
+++            color_code = 31;
+++            break;
+++        case 2: /* blue */
+++            color_code = 34;
+++            break;
+++        case 3: /* white */
+++            color_code = 37;
+++            break;
+++        case 4: /* yellow */
+++            color_code = 33;
+++            break;
+++        case 5: /* cyan */
+++            color_code = 36;
+++            break;
+++        case 6: /* magenta */
+++            color_code = 35;
+++            break;
+++        case 7: /* black */
+++            color_code = 30;
+++            break;
+++        default:
+++            color_code = 32;
+++            break;
+++    }
+++    
+++    printf("\033[%dm", color_code);
+++}
+++
+++/* Run the matrix simulation */
+++void run_matrix(void) {
+++    int i, j;
+++    int delay_ms;
+++    struct timeval tv;
+++    fd_set readfds;
+++    int max_fd;
+++    
+++    /* Set up signal handlers */
+++    signal(SIGINT, SIG_DFL);
+++    signal(SIGTERM, SIG_DFL);
+++    
+++    /* Set update delay */
+++    delay_ms = get_update_delay() * 100;
+++    if (delay_ms < 10) delay_ms = 10;
+++    
+++    /* Main loop */
+++    while (running) {
+++        /* Clear screen */
+++        printf("\033[2J\033[H");
+++        
+++        /* Print message if set */
+++        if (strlen(message) > 0) {
+++            printf("\033[%d;%dH", MATRIX_HEIGHT / 2, MATRIX_WIDTH / 2);
+++            printf("\033[1;37m%s\033[0m", message);
+++        }
+++        
+++        /* Print grid */
+++        for (i = 0; i < matrix.height; i++) {
+++            for (j = 0; j < matrix.width; j++) {
+++                char c = matrix.grid[i][j];
+++                
+++                /* Apply character transformations */
+++                if (matrix.lambda_mode && c != ' ') {
+++                    c = lambda_chars[0];
+++                } else if (matrix.use_japanese && c == ' ') {
+++                    c = katakana_chars[rand() % strlen(katakana_chars)];
+++                }
+++                
+++                printf("%c", c);
+++            }
+++            printf("\n");
+++        }
+++        
+++        /* Check for input */
+++        if (!screensaver_mode && !lock_mode) {
+++            FD_ZERO(&readfds);
+++            FD_SET(STDIN_FILENO, &readfds);
+++            max_fd = STDIN_FILENO;
+++            
+++            tv.tv_sec = 0;
+++            tv.tv_usec = delay_ms * 1000;
+++            
+++            if (select(max_fd + 1, &readfds, NULL, NULL, &tv) > 0) {
+++                char buf[10];
+++                int n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+++                if (n > 0) {
+++                    buf[n] = '\0';
+++                    handle_input(buf);
+++                }
+++            }
+++        }
+++        
+++        /* Sleep for delay */
+++        usleep(delay_ms);
+++    }
+++    
+++    /* Restore terminal */
+++    if (isatty(tty_fd)) {
+++        tcsetattr(tty_fd, TCSANOW, &orig_termios);
+++    }
+++    
+++    /* Clear screen and move to home */
+++    printf("\033[2J\033[H");
+++}
+++
+++/* Handle keyboard input */
+++void handle_input(const char *buf) {
+++    int i;
+++    
+++    for (i = 0; buf[i] != '\0'; i++) {
+++        char c = buf[i];
+++        
+++        if (c == 'q' || c == 'Q') {
+++            running = 0;
+++            break;
+++        } else if (c == 'a' || c == 'A') {
+++            matrix.async = !matrix.async;
+++        } else if (c == 'b' || c == 'B') {
+++            matrix.bold = !matrix.bold;
+++        } else if (c == 'n' || c == 'N') {
+++            matrix.bold = 0;
+++            matrix.all_bold = 0;
+++        } else if (c >= '0' && c <= '9') {
+++            update_delay = c - '0';
+++        } else if (c == '!') {
+++            matrix.color = 0;
+++        } else if (c == '@') {
+++            matrix.color = 0;
+++        } else if (c == '#') {
+++            matrix.color = 2;
+++        } else if (c == '$') {
+++            matrix.color = 3;
+++        } else if (c == '%') {
+++            matrix.color = 4;
+++        } else if (c == '^') {
+++            matrix.color = 5;
+++        } else if (c == '&') {
+++            matrix.color = 6;
+++        } else if (c == ')') {
+++            matrix.color = 7;
+++        }
+++    }
+++}
+++
+++/* Cleanup resources */
+++void cleanup(void) {
+++    int i;
+++    
+++    if (matrix.grid) {
+++        for (i = 0; i < matrix.height; i++) {
+++            free(matrix.grid[i]);
+++        }
+++        free(matrix.grid);
+++    }
+++    
+++    if (tty_fd >= 0 && tty_fd != STDOUT_FILENO) {
+++        close(tty_fd);
+++    }
+++}
