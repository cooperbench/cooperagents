+fn handle_add(args: &[String]) {
+    let mut score = None;
+    let mut paths = Vec::new();
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "-s" || args[i] == "--score" {
+            if i + 1 < args.len() {
+                score = Some(args[i + 1].parse::<f64>().unwrap_or(0.0));
+                i += 2;
+            } else {
+                eprintln!("error: --score requires a value");
+                process::exit(1);
+            }
+        } else {
+            paths.push(args[i].clone());
+            i += 1;
+        }
+    }
+    
+    if paths.is_empty() {
+        eprintln!("error: no paths specified");
+        process::exit(1);
+    }
+    
+    for path in &paths {
+        let normalized = normalize_path(path);
+        let canonical = canonicalize_path(&normalized);
+        if !is_directory(&canonical) {
+            eprintln!("error: {} is not a directory", canonical);
+            process::exit(1);
+        }
+        let db = load_db();
+        let entry = db.entries.get(&canonical).cloned().unwrap_or_else(|| {
+            Entry {
+                path: canonical.clone(),
+                score: 0.0,
+                last_accessed: get_timestamp(),
+            }
+        });
+        let new_score = score.unwrap_or_else(|| get_score(&entry));
+        let mut new_entry = entry;
+        new_entry.score = new_score;
+        new_entry.last_accessed = get_timestamp();
+        db.entries.insert(canonical, new_entry);
+        save_db(&db);
+    }
+}
