+fn handle_init(args: &[String]) {
+    if args.is_empty() {
+        eprintln!("error: shell type required");
+        process::exit(1);
+    }
+    
+    let shell = &args[0];
+    let mut no_cmd = false;
+    let mut cmd = "z".to_string();
+    let mut hook = "pwd".to_string();
+    
+    let mut i = 1;
+    while i < args.len() {
+        if args[i] == "--no-cmd" {
+            no_cmd = true;
+            i += 1;
+        } else if args[i] == "--cmd" {
+            if i + 1 < args.len() {
+                cmd = args[i + 1].clone();
+                i += 2;
+            } else {
+                eprintln!("error: --cmd requires a value");
+                process::exit(1);
+            }
+        } else if args[i] == "--hook" {
+            if i + 1 < args.len() {
+                hook = args[i + 1].clone();
+                i += 2;
+            } else {
+                eprintln!("error: --hook requires a value");
+                process::exit(1);
+            }
+        } else {
+            i += 1;
+        }
+    }
+    
+    let output = match shell {
+        "bash" => init_bash(&cmd, &hook, no_cmd),
+        "elvish" => init_elvish(&cmd, &hook, no_cmd),
+        "fish" => init_fish(&cmd, &hook, no_cmd),
+        "nushell" => init_nushell(&cmd, &hook, no_cmd),
+        "posix" => init_posix(&cmd, &hook, no_cmd),
+        "powershell" => init_powershell(&cmd, &hook, no_cmd),
+        "tcsh" => init_tcsh(&cmd, &hook, no_cmd),
+        "xonsh" => init_xonsh(&cmd, &hook, no_cmd),
+        "zsh" => init_zsh(&cmd, &hook, no_cmd),
+        _ => {
+            eprintln!("error: unknown shell '{}'", shell);
+            process::exit(1);
+        }
+    };
+    println!("{}", output);
+}
