+    }
+    
+    PathBuf::from(env::var("HOME").unwrap_or_else(|_| "/home".to_string()))
+        .join(".local/share/zoxide")
+}
+
+fn get_db_path() -> PathBuf {
+    get_data_dir().join("db.zoxide")
+}
+
+fn get_excluded_dirs() -> Vec<String> {
+    if let Ok(exclude) = env::var("_ZO_EXCLUDE_DIRS") {
+        if exclude.is_empty() {
+            return vec!["$HOME".to_string()];
+        }
+        return exclude.split(':').map(|s| s.to_string()).collect();
+    }
+    vec!["$HOME".to_string()]
+}
+
+fn is_excluded(path: &str) -> bool {
+    let excluded = get_excluded_dirs();
+    for pattern in &excluded {
+        if pattern.starts_with('$') {
+            if let Ok(home) = env::var("HOME") {
+                let expanded = pattern.replace('$', &home);
+                if path.starts_with(&expanded) {
+                    return true;
+                }
+            }
+        } else if path.starts_with(pattern) {
+            return true;
+        }
+    }
+    false
+}
+
+fn load_db() -> Result<BTreeMap<String, Entry>, String> {
+    let _db_path = get_db_path();
+    if !get_db_path().exists() {
+        return Ok(BTreeMap::new());
+    }
+    
+    let file = File::open(&get_db_path()).map_err(|e| format!("zoxide: could not open database: {}", e))?;
+    let reader = BufReader::new(file);
+    
+    let mut entries = BTreeMap::new();
+    for line in reader.lines() {
+        let line = line.map_err(|e| format!("zoxide: could not read database: {}", e))?;
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        if parts.len() >= 3 {
+            let path = parts[0].to_string();
+            let score: f64 = parts[1].parse().map_err(|_| "zoxide: invalid database format")?;
+            let age: u64 = parts[2].parse().map_err(|_| "zoxide: invalid database format")?;
+            entries.insert(path.clone(), Entry { path, score, age });
+        }
+    }
+    
+    Ok(entries)
+}
+
+fn save_db(entries: &BTreeMap<String, Entry>) -> Result<(), String> {
+    let db_path = get_db_path();
+    let parent = db_path.parent().unwrap();
+    fs::create_dir_all(parent).map_err(|e| format!("zoxide: could not create data directory: {}", e))?;
+    
+    let file = File::create(&db_path).map_err(|e| format!("zoxide: could not create database: {}", e))?;
+    let mut writer = BufWriter::new(file);
+    
+    for (path, entry) in entries {
+        writeln!(writer, "{} {} {}", entry.score, entry.age, path)
+            .map_err(|e| format!("zoxide: could not write database: {}", e))?;
+    }
+    
+    writer.flush().map_err(|e| format!("zoxide: could not flush database: {}", e))?;
+    Ok(())
+}
+
+fn add_path(path: &str, increment: bool) -> Result<(), String> {
+    let entries = load_db()?;
+    
+    if is_excluded(path) {
+        return Err(format!("zoxide: {} is excluded", path));
+    }
+    
+    let path = path.trim_end_matches('/');
+    
+    let mut new_entry = Entry {
+        path: path.to_string(),
+        score: 0.0,
+        age: 0,
+    };
+    
+    if let Some(existing) = entries.get(path) {
+        new_entry.score = existing.score;
+        new_entry.age = existing.age;
+    }
+    
+    new_entry.score += 1.0;
+    new_entry.age += 1;
+    
+    let mut new_entries = entries;
+    new_entries.insert(path.to_string(), new_entry);
+    
+    let maxage = env::var("_ZO_MAXAGE")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(DEFAULT_MAXAGE);
+    
+    if new_entries.len() > maxage as usize {
+        let mut sorted: Vec<_> = new_entries.iter().collect();
+        sorted.sort_by(|a, b| b.1.score.partial_cmp(&a.1.score).unwrap_or(std::cmp::Ordering::Equal));
+        sorted.sort_by(|a, b| {
+            if a.1.score == b.1.score {
+                b.1.age.cmp(&a.1.age)
+            } else {
+                a.1.score.partial_cmp(&b.1.score).unwrap()
+            }
+        });
+        
+        let to_remove: Vec<_> = sorted.iter().skip(maxage as usize).map(|(k, _)| k).collect();
+        for key in to_remove {
+            new_entries.remove(key);
+        }
+    }
+    
+    save_db(&new_entries)?;
+    Ok(())
+}
+
+fn cmd_add(args: &[String]) -> Result<(), String> {
+    let increment = args.iter().any(|a| a == "--increment");
+    let path = if args.len() > 1 {
+        args[1].clone()
+    } else {
+        env::current_dir().map_err(|e| format!("zoxide: could not get current directory: {}", e))?.to_string_lossy().to_string()
+    };
+    
+    add_path(&path, increment)
+}
+
+fn cmd_edit() -> Result<(), String> {
+    if !is_fzf_installed() {
+        return Err("zoxide: could not find fzf, is it installed?".to_string());
+    }
+    
+    let entries = load_db()?;
+    if entries.is_empty() {
+        return Err("zoxide: database is empty".to_string());
+    }
+    
+    let fzf_opts = env::var("_ZO_FZF_OPTS").unwrap_or_default();
+    let fzf_cmd = format!("fzf --height 40% --reverse --preview 'zoxide query {}' {}", 
+        fzf_opts,
+        if fzf_opts.is_empty() { "--bind ctrl-r:reverse-sort" } else { "" });
+    
+    let result: String = entries
+        .iter()
+        .map(|(k, v)| format!("{}:{}", v.score, k))
+        .collect::<Vec<_>>()
+        .join("\n");
+    
+    let combined = result + &fzf_cmd;
+    let selected = combined.trim();
+    
+    if let Some(path) = selected.split('\n').next() {
+        if let Some(p) = path.strip_prefix(':') {
+            if let Some(parent) = PathBuf::from(p).parent() {
+                env::set_current_dir(parent).map_err(|e| format!("zoxide: could not cd: {}", e))?;
+            }
+        }
+    }
+    
+    Ok(())
+}
+
+fn is_fzf_installed() -> bool {
+    which("fzf").is_some()
+}
+
+fn which(cmd: &str) -> Option<PathBuf> {
+    env::var("PATH")
+        .ok()
+        .and_then(|path| {
+            path.split(':')
+                .find_map(|dir| {
+                    let full_path = PathBuf::from(dir).join(cmd);
+                    if full_path.exists() {
+                        Some(full_path)
+                    } else {
+                        None
+                    }
+                })
+        })
+}
+
+fn cmd_import(args: &[String]) -> Result<(), String> {
+    let mut from = None;
+    let mut path = None;
+    let mut merge = false;
+    
+    for arg in args {
+        match arg.as_str() {
+            "--from" => {
+                if let Some(idx) = args.iter().position(|a| a == "--from") {
+                    if idx + 1 < args.len() {
+                        from = Some(args[idx + 1].clone());
+                    }
+                }
+            }
+            "--merge" => merge = true,
+            _ => {
+                if path.is_none() {
+                    path = Some(arg.clone());
+                }
+            }
+        }
+    }
+    
+    let from = from.ok_or("zoxide: --from is required")?;
+    let path = path.ok_or("zoxide: path is required")?;
+    
+    let db_path = get_db_path();
+    let import_path = PathBuf::from(&path);
+    
+    if !import_path.exists() {
+        return Err(format!("zoxide: {} does not exist", path));
+    }
+    
+    let mut entries = if merge {
+        load_db()?
+    } else {
+        BTreeMap::new()
+    };
+    
+    let ext = import_path.extension().and_then(|e| e.to_str()).unwrap_or("db");
+    
+    match from.as_str() {
+        "autojump" => {
+            if ext == "db" {
+                let file = File::open(&import_path).map_err(|e| format!("zoxide: could not open file: {}", e))?;
+                let reader = BufReader::new(file);
+                for line in reader.lines() {
+                    let line = line.map_err(|e| format!("zoxide: could not read file: {}", e))?;
+                    let parts: Vec<&str> = line.split_whitespace().collect();
+                    if parts.len() >= 2 {
+                        let path = parts[0].to_string();
+                        let score: f64 = parts[1].parse().unwrap_or(0.0);
+                        let age = 0;
+                        entries.entry(path.clone()).or_insert(Entry { path: path.clone(), score, age }).score += score;
+                    }
+                }
+            }
+        }
+        "z" => {
+            if ext == "db" {
+                let file = File::open(&import_path).map_err(|e| format!("zoxide: could not open file: {}", e))?;
+                let reader = BufReader::new(file);
+                for line in reader.lines() {
+                    let line = line.map_err(|e| format!("zoxide: could not read file: {}", e))?;
+                    let parts: Vec<&str> = line.split_whitespace().collect();
+                    if parts.len() >= 2 {
+                        let path = parts[0].to_string();
+                        let score: f64 = parts[1].parse().unwrap_or(0.0);
+                        let age = 0;
+                        entries.entry(path.clone()).or_insert(Entry { path: path.clone(), score, age }).score += score;
+                    }
+                }
+            }
+        }
+        _ => return Err(format!("zoxide: unknown source '{}'", from)),
+    }
+    
+    save_db(&entries)?;
+    Ok(())
+}
+
+fn cmd_init(args: &[String]) -> Result<(), String> {
+    let shell = if args.is_empty() {
+        Shell::Bash
+    } else {
+        match args[0].as_str() {
+            "bash" => Shell::Bash,
+            "zsh" => Shell::Zsh,
+            "fish" => Shell::Fish,
+            "posix" => Shell::Posix,
+            "powershell" => Shell::PowerShell,
+            "elvish" => Shell::Elvish,
+            "nushell" => Shell::Nushell,
+            _ => return Err(format!("zoxide: unknown shell '{}'", args[0])),
+        }
+    };
+    
+    let cmd_prefix = env::var("_ZO_CMD").unwrap_or_else(|_| "z".to_string());
+    let hook = match env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string()).as_str() {
+        "none" => Hook::None,
+        "prompt" => Hook::Prompt,
+        _ => Hook::Pwd,
+    };
+    let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+    
+    let output = match shell {
+        Shell::Bash => init_bash(&cmd_prefix, hook, no_cmd),
+        Shell::Zsh => init_zsh(&cmd_prefix, hook, no_cmd),
+        Shell::Fish => init_fish(&cmd_prefix, hook, no_cmd),
+        Shell::Posix => init_posix(&cmd_prefix, hook, no_cmd),
+        Shell::PowerShell => init_powershell(&cmd_prefix, hook, no_cmd),
+        Shell::Elvish => init_elvish(&cmd_prefix, hook, no_cmd),
+        Shell::Nushell => init_nushell(&cmd_prefix, hook, no_cmd),
+    };
+    
+    println!("{}", output);
+    Ok(())
+}
