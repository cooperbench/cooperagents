+fn init_bash(cmd_prefix: &str, hook: Hook, no_cmd: bool) -> String {
+    let hook_func = match hook {
+        Hook::None => String::new(),
+        Hook::Pwd => r#"
+__zoxide_oldpwd="$(__zoxide_pwd)"
+function __zoxide_hook() {
+    builtin local -r retval="$?"
+    builtin local pwd_tmp
+    pwd_tmp="$(__zoxide_pwd)"
+    if [[ ${__zoxide_oldpwd} != "${pwd_tmp}" ]]; then
+        __zoxide_oldpwd="${pwd_tmp}"
+        command zoxide add -- "${__zoxide_oldpwd}"
+    fi
+    return "${retval}"
+}
+"#.to_string(),
+        Hook::Prompt => String::new(),
+    };
+    
+    let z_func = format!(
+        r#"
+function __zoxide_z() {{
+    builtin local result
+    result="$(command zoxide query -- "$@")"
+    if [[ -n "${{result}}" ]]; then
+        builtin cd -- "$result"
+        if [[ "${{_ZO_ECHO:-}}" == "1" ]]; then
+            builtin printf '%s\n' "$result"
+        fi
+    fi
+}}
+"#.to_string()
+    );
+    
+    let zi_func = r#"
+function __zoxide_zi() {
+    builtin local result
+    result="$(command zoxide query -- "$@" | fzf --height 40% --reverse --preview 'zoxide query {}' --bind ctrl-r:reverse-sort)"
+    if [[ -n "${{result}}" ]]; then
+        builtin cd -- "$result"
+        if [[ "${{_ZO_ECHO:-}}" == "1" ]]; then
+            builtin printf '%s\n' "$result"
+        fi
+    fi
+}
+"#.to_string();
+    
+    let complete_func = format!(
+        r#"
+__zoxide_z_prefix="${{__zoxide_z_prefix:-}}"
+__zoxide_z_complete() {{
+    builtin local cur="${{COMP_WORDS[COMP_CWORD]}}"
+    builtin local results
+    results="$(command zoxide query -- "$cur")"
+    if [[ -n "${{results}}" ]]; then
+        builtin COMPREPLY=("${{results[@]/#/$__zoxide_z_prefix}}")
+    fi
+}}
+__zoxide_z_complete_helper() {{
+    builtin local cur="${{COMP_WORDS[COMP_CWORD]}}"
+    builtin local results
+    results="$(command zoxide query -- "$cur")"
+    if [[ -n "${{results}}" ]]; then
+        builtin COMPREPLY=("${{results[@]/#/$__zoxide_z_prefix}}")
+    fi
+    builtin printf '\e[5n' > /dev/tty
+}}
