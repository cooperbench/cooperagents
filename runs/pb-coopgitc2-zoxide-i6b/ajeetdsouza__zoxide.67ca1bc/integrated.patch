+        subcmd = args[2].clone();
+    }
+    
+    match subcmd.as_str() {
+        "--help" | "-h" => Ok(print_help()),
+        "--version" | "-V" => Ok(println!("zoxide {}", VERSION)),
+        "add" => cmd_add(&args[1..]),
+        "edit" => cmd_edit(),
+        "import" => cmd_import(&args[1..]),
+        "init" => cmd_init(&args[1..]),
+        "query" => cmd_query(&args[1..]),
+        "remove" => cmd_remove(&args[1..]),
+        _ => {
+            if args.len() == 1 {
+                Ok(print_help())
+            } else {
+                Err(format!("zoxide: unrecognized command '{}'", subcmd))
+            }
+        }
+    }
