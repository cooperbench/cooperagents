+#!/usr/bin/env python3
+"""
+zip-password-finder - Find the password of protected ZIP files
+"""
+
+import argparse
+import sys
+import os
+import time
+from itertools import product
+from zipfile import ZipFile, BadZipFile
+
+# Character sets
+CHARSETS = {
+    'l': 'abcdefghijklmnopqrstuvwxyz',
+    'u': 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
+    'd': '0123456789',
+    'h': '0123456789abcdef',
+    'H': '0123456789ABCDEF',
+    's': ' !\"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~'
+}
+
+def parse_charset_file(filepath):
+    """Parse a charset file and return the combined charset string."""
+    charset = ''
+    try:
+        with open(filepath, 'r') as f:
+            for line in f:
+                line = line.strip()
+                if not line or line.startswith('#'):
+                    continue
+                # Handle both single and multiple characters per line
+                for char in line:
+                    if char not in (' ', '\t', '\n'):
+                        charset += char
+    except Exception as e:
+        print(f"Error reading charset file: {e}", file=sys.stderr)
+        sys.exit(1)
+    return charset
+
+def generate_passwords(charset, min_len, max_len):
+    """Generate all possible passwords within the length range."""
+    if not charset:
+        return
+    for length in range(min_len, max_len + 1):
+        for combo in product(charset, repeat=length):
+            yield ''.join(combo)
+
+def test_password(zip_path, password, file_number=0):
+    """Test if a password works for the ZIP file."""
+    try:
+        with ZipFile(zip_path, 'r') as zf:
+            if file_number >= 0:
+                # Test specific file
+                if file_number < len(zf.namelist()):
+                    zf.extract(zf.namelist()[file_number], path='.', pwd=password.encode())
+                else:
+                    return False
+            else:
+                # Test all files
+                for name in zf.namelist():
+                    zf.extract(name, path='.', pwd=password.encode())
+            return True
+    except (BadZipFile, Exception):
+        return False
+
+def dictionary_attack(zip_path, dict_path, file_number=0):
+    """Attack using a dictionary file."""
+    passwords_found = []
+    try:
+        with open(dict_path, 'r') as f:
+            for password in f:
+                password = password.strip()
+                if not password:
+                    continue
+                if test_password(zip_path, password, file_number):
+                    passwords_found.append(password)
+    except Exception as e:
+        print(f"Error reading dictionary file: {e}", file=sys.stderr)
+        sys.exit(1)
+    return passwords_found
+
+def brute_force_attack(zip_path, charset, min_len, max_len, file_number=0, starting_password=None):
+    """Brute force attack with given charset."""
+    passwords_found = []
+    try:
+        if starting_password:
+            # Start from a specific password
+            current = starting_password
+            while True:
+                if test_password(zip_path, current, file_number):
+                    passwords_found.append(current)
+                # Increment password
+                chars = list(current)
+                for i in range(len(chars) - 1, -1, -1):
+                    idx = chars[i]
+                    if idx < len(charset) - 1:
+                        chars[i] = charset[idx + 1]
+                        current = ''.join(chars)
+                        break
+                    else:
+                        chars[i] = charset[0]
+                        if i == 0:
+                            break
+                else:
+                    # All characters rolled over, move to next length
+                    break
+        else:
+            for password in generate_passwords(charset, min_len, max_len):
+                if test_password(zip_path, password, file_number):
+                    passwords_found.append(password)
+    except Exception as e:
+        print(f"Error during brute force attack: {e}", file=sys.stderr)
+        sys.exit(1)
+    return passwords_found
+
+def print_help():
+    """Print help message."""
+    print("Find the password of protected ZIP files")
+    print()
+    print("Usage: executable [OPTIONS] --inputFile <inputFile>")
+    print()
+    print("Options:")
+    print("  -i, --inputFile <inputFile>                    path to zip input file")
+    print("  -w, --workers <workers>                        number of workers")
+    print("  -p, --passwordDictionary <passwordDictionary>  path to a password dictionary file")
+    print("  -c, --charset <charset>                        charset to use to generate password [default: lud]")
+    print("      --charsetFile <charsetFile>                path to a charset file")
+    print("      --minPasswordLen <minPasswordLen>          minimum password length [default: 1]")
+    print("      --maxPasswordLen <maxPasswordLen>          maximum password length [default: 10]")
+    print("      --fileNumber <fileNumber>                  file number in the zip archive [default: 0]")
+    print("  -s, --startingPassword <startingPassword>      password to start from")
+    print("  -h, --help                                     Print help")
+    print("  -V, --version                                  Print version")
+
+def main():
+    # Check for --help and --version before parsing
+    if '--help' in sys.argv or '-h' in sys.argv:
+        print_help()
+        sys.exit(0)
+    if '--version' in sys.argv or '-V' in sys.argv:
+        print("zip-password-finder 0.10.3")
+        sys.exit(0)
+    
+    parser = argparse.ArgumentParser(
+        prog='executable',
+        add_help=False,
+        description='Find the password of protected ZIP files',
+        formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    parser.add_argument('-i', '--inputFile', required=True, help='path to zip input file')
+    parser.add_argument('-w', '--workers', type=int, default=1, help='number of workers')
+    parser.add_argument('-p', '--passwordDictionary', help='path to a password dictionary file')
+    parser.add_argument('-c', '--charset', default='lud', help='charset to use to generate password [default: lud]')
+    parser.add_argument('--charsetFile', help='path to a charset file')
+    parser.add_argument('--minPasswordLen', type=int, default=1, help='minimum password length [default: 1]')
+    parser.add_argument('--maxPasswordLen', type=int, default=10, help='maximum password length [default: 10]')
+    parser.add_argument('--fileNumber', type=int, default=0, help='file number in the zip archive [default: 0]')
+    parser.add_argument('-s', '--startingPassword', help='password to start from')
+    
+    # Custom error handler to match original format
+    class CustomArgumentParser(argparse.ArgumentParser):
+        def error(self, message):
+            print(f"error: the following required arguments were not provided:")
+            print(f"  --inputFile <inputFile>")
+            print()
+            print(f"Usage: executable --inputFile <inputFile>")
+            print()
+            print("For more information, try '--help'.")
+            sys.exit(2)
+    
+    parser = CustomArgumentParser(
+        prog='executable',
+        add_help=False,
+        description='Find the password of protected ZIP files',
+        formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    parser.add_argument('-i', '--inputFile', required=True, help='path to zip input file')
+    parser.add_argument('-w', '--workers', type=int, default=1, help='number of workers')
+    parser.add_argument('-p', '--passwordDictionary', help='path to a password dictionary file')
+    parser.add_argument('-c', '--charset', default='lud', help='charset to use to generate password [default: lud]')
+    parser.add_argument('--charsetFile', help='path to a charset file')
+    parser.add_argument('--minPasswordLen', type=int, default=1, help='minimum password length [default: 1]')
+    parser.add_argument('--maxPasswordLen', type=int, default=10, help='maximum password length [default: 10]')
+    parser.add_argument('--fileNumber', type=int, default=0, help='file number in the zip archive [default: 0]')
+    parser.add_argument('-s', '--startingPassword', help='password to start from')
+    
+    args = parser.parse_args()
+    
+    # Validate input file
+    if not os.path.exists(args.inputFile):
+        print(f'CLI argument error - "{args.inputFile}" does not exist', file=sys.stderr)
+        sys.exit(1)
+    
+    # Determine charset - default is 'lud' which means lowercase, uppercase, digits
+    if args.charsetFile:
+        charset = parse_charset_file(args.charsetFile)
+    else:
+        # Default charset is 'lud' (lowercase + uppercase + digits)
+        charset = CHARSETS['l'] + CHARSETS['u'] + CHARSETS['d']
+    
+    # Run attack
+    start_time = time.perf_counter()
+    
+    if args.passwordDictionary:
+        # Dictionary attack
+        passwords_found = dictionary_attack(args.inputFile, args.passwordDictionary, args.fileNumber)
+        if passwords_found:
+            print(f"Password found:{passwords_found[0]}")
+        else:
+            print("Password not found")
+    else:
+        # Brute force attack
+        start_time = time.perf_counter()
+        
+        # For brute force, we use single-threaded approach for simplicity
+        # (multi-threading would require more complex synchronization)
+        for password in generate_passwords(charset, args.minPasswordLen, args.maxPasswordLen):
+            if test_password(args.inputFile, password, args.fileNumber):
+                elapsed = time.perf_counter() - start_time
+                print(f"Time elapsed: {elapsed:.3f}s")
+                print(f"Password found:{password}")
+                sys.exit(0)
+        
+        elapsed = time.perf_counter() - start_time
+        print(f"Time elapsed: {elapsed:.3f}s")
+        print("Password not found")
+        sys.exit(0)
+
+if __name__ == '__main__':
+    main()
