+use std::env;
+use std::fs::File;
+use std::io::{BufRead, BufReader, Read};
+use std::path::Path;
+use std::process;
+use std::time::Instant;
+
+const VERSION: &str = "0.10.3";
+
+fn print_help() {
+    println!("Find the password of protected ZIP files");
+    println!();
+    println!("Usage: executable [OPTIONS] --inputFile <inputFile>");
+    println!();
+    println!("Options:");
+    println!("  -i, --inputFile <inputFile>                    path to zip input file");
+    println!("  -w, --workers <workers>                        number of workers");
+    println!("  -p, --passwordDictionary <passwordDictionary>  path to a password dictionary file");
+    println!("  -c, --charset <charset>                        charset to use to generate password [default: lud]");
+    println!("      --charsetFile <charsetFile>                path to a charset file");
+    println!("      --minPasswordLen <minPasswordLen>          minimum password length [default: 1]");
+    println!("      --maxPasswordLen <maxPasswordLen>          maximum password length [default: 10]");
+    println!("      --fileNumber <fileNumber>                  file number in the zip archive [default: 0]");
+    println!("  -s, --startingPassword <startingPassword>      password to start from");
+    println!("  -h, --help                                     Print help");
+    println!("  -V, --version                                  Print version");
+}
+
+fn print_version() {
+    println!("zip-password-finder {}", VERSION);
+}
+
+fn parse_charsets(charset: &str) -> Vec<char> {
+    let mut result = Vec::new();
+    for c in charset.chars() {
+        match c {
+            'l' => result.extend('a'..='z'),
+            'u' => result.extend('A'..='Z'),
+            'd' => result.extend('0'..='9'),
+            'h' => result.extend('0'..='9').extend('a'..='f'),
+            'H' => result.extend('0'..='9').extend('A'..='F'),
+            's' => result.extend(" \"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~".chars()),
+            _ => {}
+        }
+    }
+    result
+}
+
+fn parse_charset_file(path: &str) -> Vec<char> {
+    let file = File::open(path).expect("Failed to open charset file");
+    let reader = BufReader::new(file);
+    let mut charsets = Vec::new();
+    for line in reader.lines() {
+        let line = line.expect("Failed to read line");
+        let trimmed = line.trim();
+        if !trimmed.is_empty() && !trimmed.starts_with('#') {
+            charsets.push(trimmed.chars().next().unwrap());
+        }
+    }
+    charsets
+}
+
+fn generate_passwords(charset: &[char], min_len: usize, max_len: usize, start_password: Option<&str>) -> Vec<String> {
+    let charset_len = charset.len();
+    if charset_len == 0 {
+        return Vec::new();
+    }
+    
+    let mut passwords = Vec::new();
+    
+    if let Some(start) = start_password {
+        if start.len() >= min_len && start.len() <= max_len {
+            passwords.push(start.to_string());
+        }
+    }
+    
+    // Generate passwords from min_len to max_len
+    for len in min_len..=max_len {
+        let mut stack: Vec<(usize, Vec<char>)> = Vec::new();
+        stack.push((0, Vec::new()));
+        
+        while let Some((pos, current)) = stack.pop() {
+            if current.len() == len {
+                passwords.push(current.into_iter().collect());
+                continue;
+            }
+            
+            for i in pos..charset_len {
+                let mut new_pass = current.clone();
+                new_pass.push(charset[i]);
+                stack.push((i + 1, new_pass));
+            }
+        }
+    }
+    
+    passwords
+}
+
+fn test_password(zip_path: &str, password: &str, file_number: usize) -> bool {
+    let mut file = match File::open(zip_path) {
+        Ok(f) => f,
+        Err(_) => return false,
+    };
+    
+    let mut reader = zip_reader::ZipReader::new(&mut file).ok()?;
+    
+    if file_number >= reader.files.len() {
+        return false;
+    }
+    
+    let file_info = &reader.files[file_number];
+    
+    // Try to decrypt and read the file
+    match file_info.decrypt(password) {
+        Ok(mut decrypted) => {
+            // Check if decryption worked by verifying CRC
+            if !decrypted.is_empty() {
+                return true;
+            }
+        }
+        Err(_) => {}
+    }
+    
+    false
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "-h" || args[1] == "--help") {
+        print_help();
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && (args[1] == "-V" || args[1] == "--version") {
+        print_version();
+        process::exit(0);
+    }
+    
+    let mut input_file: Option<String> = None;
+    let mut workers: usize = 1;
+    let mut password_dictionary: Option<String> = None;
+    let mut charset: String = "lud".to_string();
+    let mut charset_file: Option<String> = None;
+    let mut min_password_len: usize = 1;
+    let mut max_password_len: usize = 10;
+    let mut file_number: usize = 0;
+    let mut starting_password: Option<String> = None;
+    
+    let mut i = 2;
+    while i < args.len() {
+        match args[i].as_str() {
+            "-i" | "--inputFile" => {
+                if i + 1 < args.len() {
+                    input_file = Some(args[i + 1].clone());
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027inputFile\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "-w" | "--workers" => {
+                if i + 1 < args.len() {
+                    workers = args[i + 1].parse().unwrap_or(1);
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027workers\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "-p" | "--passwordDictionary" => {
+                if i + 1 < args.len() {
+                    password_dictionary = Some(args[i + 1].clone());
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027passwordDictionary\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "-c" | "--charset" => {
+                if i + 1 < args.len() {
+                    charset = args[i + 1].clone();
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027charset\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "--charsetFile" => {
+                if i + 1 < args.len() {
+                    charset_file = Some(args[i + 1].clone());
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027charsetFile\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "--minPasswordLen" => {
+                if i + 1 < args.len() {
+                    min_password_len = args[i + 1].parse().unwrap_or(1);
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027minPasswordLen\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "--maxPasswordLen" => {
+                if i + 1 < args.len() {
+                    max_password_len = args[i + 1].parse().unwrap_or(10);
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027maxPasswordLen\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "--fileNumber" => {
+                if i + 1 < args.len() {
+                    file_number = args[i + 1].parse().unwrap_or(0);
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027fileNumber\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            "-s" | "--startingPassword" => {
+                if i + 1 < args.len() {
+                    starting_password = Some(args[i + 1].clone());
+                    i += 2;
+                } else {
+                    eprintln!("CLI argument error - \"\u0027startingPassword\u0027 does not exist\"");
+                    process::exit(1);
+                }
+            }
+            _ => {
+                eprintln!("Unknown argument: {}", args[i]);
+                process::exit(1);
+            }
+        }
+    }
+    
+    let input_file = match input_file {
+        Some(f) => f,
+        None => {
+            eprintln!("error: the following required arguments were not provided:\n  --inputFile <inputFile>\n\nUsage: executable --inputFile <inputFile>\n\nFor more information, try \u0027--help\u0027.");
+            process::exit(2);
+        }
+    };
+    
+    if !Path::new(&input_file).exists() {
+        eprintln!("CLI argument error - \"\u0027inputFile\u0027 does not exist\"");
+        process::exit(1);
+    }
+    
+    let charset_vec = if let Some(ref cf) = charset_file {
+        parse_charset_file(cf)
+    } else {
+        parse_charsets(&charset)
+    };
+    
+    let start_time = Instant::now();
+    
+    let mut found = false;
+    
+    if let Some(ref dict_file) = password_dictionary {
+        if !Path::new(dict_file).exists() {
+            eprintln!("CLI argument error - \"\u0027passwordDictionary\u0027 does not exist\"");
+            process::exit(1);
+        }
+        
+        let file = File::open(dict_file).expect("Failed to open dictionary file");
+        let reader = BufReader::new(file);
+        
+        for line in reader.lines() {
+            let password = match line {
+                Ok(p) => p,
+                Err(_) => continue,
+            };
+            
+            if test_password(&input_file, &password, file_number) {
+                println!("Time elapsed: {:?}", start_time.elapsed());
+                println!("Password found:{}", password);
+                found = true;
+                break;
+            }
+        }
+    } else {
+        let passwords = generate_passwords(&charset_vec, min_password_len, max_password_len, starting_password.as_deref());
+        
+        for password in passwords {
+            if test_password(&input_file, &password, file_number) {
+                println!("Time elapsed: {:?}", start_time.elapsed());
+                println!("Password found:{}", password);
+                found = true;
+                break;
+            }
+        }
+    }
+    
+    if !found {
+        println!("Time elapsed: {:?}", start_time.elapsed());
+        println!("Password not found");
+        process::exit(1);
+    }
+}
