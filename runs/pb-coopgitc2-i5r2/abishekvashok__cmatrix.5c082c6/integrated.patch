diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..2f742bb
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,316 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <ctype.h>
+#include <time.h>
+#include <math.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_COLS 200
+#define MAX_ROWS 100
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 1;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int only_shadows = 0;
+static int lock_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int chars_change = 0;
+static int x_mode = 0;
+static int screensaver_mode = 0;
+static int use_japanese = 0;
+static int tty_set = 0;
+static char tty_name[64] = "";
+static char message[256] = "";
+static int message_set = 0;
+static int delay = DEFAULT_DELAY;
+static char color[16] = "green";
+static int use_color = 1;
+
+static char matrix_chars[] = "01";
+static char matrix_chars_full[] = "01";
+static char matrix_chars_jp[] = "01";
+
+static char *get_matrix_chars(void) {
+    if (use_japanese) {
+        return matrix_chars_jp;
+    }
+    return matrix_chars_full;
+}
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void set_color(int r, int g, int b) {
+    printf("\033[48;2;%d;%d;%dm", r, g, b);
+}
+
+static void set_bold(int on) {
+    if (on) {
+        printf("\033[1m");
+    } else {
+        printf("\033[22m");
+    }
+}
+
+static void set_reset(void) {
+    printf("\033[0m");
+}
+
+static void set_fg_color(int r, int g, int b) {
+    printf("\033[38;2;%d;%d;%dm", r, g, b);
+}
+
+static void set_bg_color(int r, int g, int b) {
+    printf("\033[48;2;%d;%d;%dm", r, g, b);
+}
+
+static int parse_color(const char *color_str) {
+    if (strcmp(color_str, "green") == 0) {
+        return 0;
+    } else if (strcmp(color_str, "red") == 0) {
+        return 1;
+    } else if (strcmp(color_str, "blue") == 0) {
+        return 2;
+    } else if (strcmp(color_str, "white") == 0) {
+        return 3;
+    } else if (strcmp(color_str, "yellow") == 0) {
+        return 4;
+    } else if (strcmp(color_str, "cyan") == 0) {
+        return 5;
+    } else if (strcmp(color_str, "magenta") == 0) {
+        return 6;
+    } else if (strcmp(color_str, "black") == 0) {
+        return 7;
+    }
+    return 0;
+}
+
+static int get_random_char(void) {
+    return (rand() % 2) + '0';
+}
+
+static int get_random_bold(void) {
+    if (bold_chars && !all_bold && !no_bold) {
+        return (rand() % 100) < 30;
+    }
+    return 0;
+}
+
+static void init_terminal(void) {
+    struct termios oldt, newt;
+    if (tcgetattr(STDIN_FILENO, &oldt) == 0) {
+        newt = oldt;
+        newt.c_lflag &= ~(ECHO | ICANON);
+        newt.c_cc[VMIN] = 0;
+        newt.c_cc[VTIME] = 0;
+        tcsetattr(STDIN_FILENO, TCSANOW, &newt);
+    }
+}
+
+static void restore_terminal(struct termios *oldt) {
+    if (oldt) {
+        tcsetattr(STDIN_FILENO, TCSANOW, oldt);
+    }
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void draw_matrix(int cols, int rows) {
+    int i, j;
+    char *chars = get_matrix_chars();
+    
+    for (i = 0; i < rows; i++) {
+        for (j = 0; j < cols; j++) {
+            int char_idx = (rand() % 2);
+            printf("%c", chars[char_idx]);
+        }
+        printf("\n");
+    }
+}
+
+static void draw_message(const char *msg) {
+    int cols, rows;
+    if (msg) {
+        cols = 80;
+        rows = 24;
+    } else {
+        cols = 80;
+        rows = 24;
+    }
+    
+    for (int i = 0; i < rows; i++) {
+        for (int j = 0; j < cols; j++) {
+            if (i == rows / 2 && j == cols / 2) {
+                printf("%c", msg ? msg[j - cols/2] : ' ');
+            } else {
+                printf(" ");
+            }
+        }
+        printf("\n");
+    }
+}
+
+int main(int argc, char *argv[]) {
+    int i;
+    struct termios oldt;
+    int running = 1;
+    int cols = 80;
+    int rows = 24;
+    
+    srand(time(NULL));
+    
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            return 0;
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            return 0;
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            chars_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                delay = atoi(argv[++i]);
+                if (delay < 0) delay = 0;
+                if (delay > 10) delay = 10;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color[15] = '\0';
+                strcpy(color, argv[++i]);
+                use_color = 1;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                strncpy(tty_name, argv[++i], sizeof(tty_name) - 1);
+                tty_set = 1;
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                strncpy(message, argv[++i], sizeof(message) - 1);
+                message_set = 1;
+            }
+        } else {
+            print_usage();
+            return 1;
+        }
+    }
+    
+    if (no_bold && !all_bold) {
+        bold_chars = 0;
+    }
+    
+    if (tty_set) {
+        setenv("TERM", tty_name, 1);
+    }
+    
+    if (force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    init_terminal();
+    
+    if (lock_mode) {
+        printf("Lock mode enabled\n");
+    }
+    
+    if (screensaver_mode) {
+        printf("Screensaver mode enabled\n");
+    }
+    
+    if (message_set) {
+        printf("Message mode enabled\n");
+    }
+    
+    clear_screen();
+    
+    while (running) {
+        if (screensaver_mode) {
+            int c;
+            c = getchar();
+            if (c != EOF) {
+                running = 0;
+            }
+        } else {
+            usleep(delay * 100000);
+        }
+        
+        if (message_set) {
+            draw_message(message);
+        } else {
+            draw_matrix(cols, rows);
+        }
+        
+        fflush(stdout);
+    }
+    
+    restore_terminal(&oldt);
+    return 0;
+}
