@@ -0,0 +1,313 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <signal.h>
+#include <time.h>
+#include <ctype.h>
+#include <math.h>
+#include <errno.h>
+
+#define VERSION "2.0"
+#define BUILD_TIME "22:13:51, Jun 11 2026"
+#define EMAIL "abishekvashok@gmail.com"
+#define WEB "https://github.com/abishekvashok/cmatrix"
+
+#define WIDTH 80
+#define HEIGHT 24
+#define DEFAULT_DELAY 4
+#define MAX_DELAY 10
+
+static int width = WIDTH;
+static int height = HEIGHT;
+static int delay = DEFAULT_DELAY;
+static char *color = "green";
+static char *tty = "/dev/tty";
+static char *message = NULL;
+static int async_scroll = 0;
+static int bold = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int use_japanese = 0;
+static int force_term = 0;
+static int use_old_scroll = 0;
+static int lock_mode = 0;
+static int screensaver_mode = 0;
+static int x_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int characters_change = 0;
+
+static char *colors[] = {"green", "red", "blue", "white", "yellow", "cyan", "magenta", "black"};
+static int current_color_idx = 0;
+
+static const char *katakana = 
+    "アァカサタナハマヤャラワガザダバパイ"
+    "ィキシチニヒミリヰギジヂビピ"
+    "ウゥクスツヌフムユュルグズブヅプ"
+    "エェケセテネヘメレヱゲゼデベペ"
+    "オォコソトノホモヨョロヲゴゾドボポヴッン"
+    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+    "！＠＃＄％＾＆＃（）";
+
+static const char *lambda_char = "λ";
+
+static int fd = -1;
+static struct termios old_settings;
+
+static void print_help(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s)\n", VERSION, BUILD_TIME);
+    printf("Email: %s\n", EMAIL);
+    printf("Web: %s\n", WEB);
+}
+
+static char get_char(void) {
+    if (lambda_mode) {
+        return *lambda_char;
+    } else if (use_japanese) {
+        return (char)katakana[rand() % strlen(katakana)];
+    } else {
+        return (char)katakana[rand() % strlen(katakana)];
+    }
+}
+
+static void get_color(void) {
+    if (rainbow_mode) {
+        int idx = rand() % (sizeof(colors) / sizeof(colors[0]));
+        current_color_idx = idx;
+    }
+}
+
+static char *get_color_code(void) {
+    if (no_bold) {
+        return "";
+    } else if (all_bold) {
+        return "\033[1m";
+    } else if (bold) {
+        return "\033[1m";
+    } else {
+        return "";
+    }
+}
+
+static int init_tty(void) {
+    fd = open(tty, O_RDWR);
+    if (fd < 0) {
+        fprintf(stderr, "Error opening terminal: %s\n", strerror(errno));
+        return 0;
+    }
+    
+    if (tcgetattr(fd, &old_settings) < 0) {
+        fprintf(stderr, "Error getting terminal settings\n");
+        close(fd);
+        fd = -1;
+        return 0;
+    }
+    
+    struct termios new_settings = old_settings;
+    new_settings.c_lflag &= ~(ECHO | ICANON);
+    new_settings.c_cc[VMIN] = 1;
+    new_settings.c_cc[VTIME] = 0;
+    
+    if (tcsetattr(fd, TCSANOW, &new_settings) < 0) {
+        fprintf(stderr, "Error setting terminal settings\n");
+        close(fd);
+        fd = -1;
+        return 0;
+    }
+    
+    ioctl(fd, TIOCGWINSZ, &width);
+    ioctl(fd, TIOCGWINSZ, &height);
+    
+    return 1;
+}
+
+static void restore_tty(void) {
+    if (fd >= 0) {
+        tcsetattr(fd, TCSANOW, &old_settings);
+        close(fd);
+        fd = -1;
+    }
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void draw_line(int y, char *chars) {
+    printf("\033[%dH", y + 1);
+    for (int x = 0; x < width; x++) {
+        if (x < strlen(chars)) {
+            printf("%c", chars[x]);
+        }
+    }
+}
+
+static void draw_message(void) {
+    if (message) {
+        if (strlen(message) > width) {
+            message[width] = '\0';
+        }
+        printf("\033[%dH\033[1;37m%s\033[0m", height / 2, message);
+    }
+}
+
+static void run(void) {
+    char **chars = malloc(height * sizeof(char *));
+    for (int y = 0; y < height; y++) {
+        chars[y] = malloc(width * sizeof(char));
+        for (int x = 0; x < width; x++) {
+            chars[y][x] = get_char();
+        }
+    }
+    
+    clear_screen();
+    
+    if (lock_mode && !screensaver_mode) {
+        draw_message();
+    }
+    
+    while (1) {
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                if (characters_change) {
+                    chars[y][x] = get_char();
+                } else {
+                    if (rand() % 10 == 0) {
+                        chars[y][x] = get_char();
+                    }
+                }
+            }
+        }
+        
+        for (int y = 0; y < height; y++) {
+            draw_line(y + 1, chars[y]);
+        }
+        
+        draw_message();
+        
+        usleep(delay * 100000);
+    }
+    
+    free(chars);
+}
+
+static void parse_args(int argc, char *argv[]) {
+    int i = 1;
+    while (i < argc) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_help();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            use_old_scroll = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            use_old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            characters_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                delay = atoi(argv[i + 1]);
+                if (delay < 0 || delay > 10) {
+                    delay = DEFAULT_DELAY;
+                }
+                i++;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = argv[i + 1];
+                if (strcmp(color, "green") != 0 && 
+                    strcmp(color, "red") != 0 && 
+                    strcmp(color, "blue") != 0 && 
+                    strcmp(color, "white") != 0 && 
+                    strcmp(color, "yellow") != 0 && 
+                    strcmp(color, "cyan") != 0 && 
+                    strcmp(color, "magenta") != 0 && 
+                    strcmp(color, "black") != 0) {
+                    color = "green";
+                }
+                i++;
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                message = argv[i + 1];
+                i++;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty = argv[i + 1];
+                i++;
+            }
+        }
+        i++;
+    }
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    if (force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    if (!init_tty()) {
+        return 1;
+    }
+    
+    run();
+    
+    restore_tty();
+    return 0;
+}
