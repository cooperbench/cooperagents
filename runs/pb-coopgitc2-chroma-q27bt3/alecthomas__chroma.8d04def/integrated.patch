+// Package lexers provides the chroma lexers.
+//
+// The register function registers a lexer with the chroma package and adds it
+// to the List of lexers.
+package lexers
+
+import "github.com/alecthomas/chroma/chroma"
+
+// List is the list of lexers.
+var List []chroma.Lexer
+
+func register(l chroma.Lexer) {
+	chroma.RegisterLexer(l)
+	List = append(List, l)
+}
+
+func init() {
+	register(textLexer{})
+	register(pythonLexer{})
+}
