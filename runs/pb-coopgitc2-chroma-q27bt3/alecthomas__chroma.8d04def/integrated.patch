+package token
+
+// Type is a semantic type of a token, represented by its full name
+// (e.g. "Name", "CommentSingle").
+type Type string
+
+// All token types.
+const (
+	TypeUnspecified              Type = "Text"
+	TypeWhitespace               Type = "Whitespace"
+	TypeComment                  Type = "Comment"
+	TypeCommentPreproc           Type = "CommentPreproc"
+	TypeCommentPreprocFile       Type = "CommentPreprocFile"
+	TypeCommentHashbang          Type = "CommentHashbang"
+	TypeCommentMultiline         Type = "CommentMultiline"
+	TypeCommentSingle            Type = "CommentSingle"
+	TypeCommentSpecial           Type = "CommentSpecial"
+	TypeKeyword                  Type = "Keyword"
+	TypeKeywordConstant          Type = "KeywordConstant"
+	TypeKeywordDeclaration       Type = "KeywordDeclaration"
+	TypeKeywordNamespace         Type = "KeywordNamespace"
+	TypeKeywordPseudo            Type = "KeywordPseudo"
+	TypeKeywordReserved          Type = "KeywordReserved"
+	TypeKeywordType              Type = "KeywordType"
+	TypeName                     Type = "Name"
+	TypeNameAttribute            Type = "NameAttribute"
+	TypeNameBuiltin              Type = "NameBuiltin"
+	TypeNameBuiltinPseudo        Type = "NameBuiltinPseudo"
+	TypeNameClass                Type = "NameClass"
+	TypeNameConstant             Type = "NameConstant"
+	TypeNameDecorator            Type = "NameDecorator"
+	TypeNameException            Type = "NameException"
+	TypeNameFunction             Type = "NameFunction"
+	TypeNameFunctionMagic        Type = "NameFunctionMagic"
+	TypeNameNamespace            Type = "NameNamespace"
+	TypeNameOther                Type = "NameOther"
+	TypeNameTag                  Type = "NameTag"
+	TypeNameVariable             Type = "NameVariable"
+	TypeLiteral                  Type = "Literal"
+	TypeLiteralDate              Type = "LiteralDate"
+	TypeLiteralString            Type = "LiteralString"
+	TypeLiteralStringAffix       Type = "LiteralStringAffix"
+	TypeLiteralStringBacktick    Type = "LiteralStringBacktick"
+	TypeLiteralStringChar        Type = "LiteralStringChar"
+	TypeLiteralStringDelimiter   Type = "LiteralStringDelimiter"
+	TypeLiteralStringDoc         Type = "LiteralStringDoc"
+	TypeLiteralStringDouble      Type = "LiteralStringDouble"
+	TypeLiteralStringEscape      Type = "LiteralStringEscape"
+	TypeLiteralStringHeredoc     Type = "LiteralStringHeredoc"
+	TypeLiteralStringInterpol    Type = "LiteralStringInterpol"
+	TypeLiteralStringOther       Type = "LiteralStringOther"
+	TypeLiteralStringRegex       Type = "LiteralStringRegex"
+	TypeLiteralStringSingle      Type = "LiteralStringSingle"
+	TypeLiteralStringSymbol      Type = "LiteralStringSymbol"
+	TypeLiteralNumber            Type = "LiteralNumber"
+	TypeLiteralNumberBin         Type = "LiteralNumberBin"
+	TypeLiteralNumberFloat       Type = "LiteralNumberFloat"
+	TypeLiteralNumberHex         Type = "LiteralNumberHex"
+	TypeLiteralNumberInteger     Type = "LiteralNumberInteger"
+	TypeLiteralNumberIntegerLong Type = "LiteralNumberIntegerLong"
+	TypeLiteralNumberOct         Type = "LiteralNumberOct"
+	TypeOperator                 Type = "Operator"
+	TypeOperatorWord             Type = "OperatorWord"
+	TypeOperatorReserved         Type = "OperatorReserved"
+	TypeGenericDeleted           Type = "GenericDeleted"
+	TypeGenericEmph              Type = "GenericEmph"
+	TypeGenericInserted          Type = "GenericInserted"
+	TypeGenericStrong            Type = "GenericStrong"
+	TypeGenericSubheading        Type = "GenericSubheading"
+	TypeError                    Type = "Error"
+)
+
+// All returns all known token types, in a stable order.
+var all = []Type{
+	TypeWhitespace,
+	TypeComment,
+	TypeCommentPreproc,
+	TypeCommentPreprocFile,
+	TypeCommentHashbang,
+	TypeCommentMultiline,
+	TypeCommentSingle,
+	TypeCommentSpecial,
+	TypeKeyword,
+	TypeKeywordConstant,
+	TypeKeywordDeclaration,
+	TypeKeywordNamespace,
+	TypeKeywordPseudo,
+	TypeKeywordReserved,
+	TypeKeywordType,
+	TypeName,
+	TypeNameAttribute,
+	TypeNameBuiltin,
+	TypeNameBuiltinPseudo,
+	TypeNameClass,
+	TypeNameConstant,
+	TypeNameDecorator,
+	TypeNameException,
+	TypeNameFunction,
+	TypeNameFunctionMagic,
+	TypeNameNamespace,
+	TypeNameOther,
+	TypeNameTag,
+	TypeNameVariable,
+	TypeLiteral,
+	TypeLiteralDate,
+	TypeLiteralString,
+	TypeLiteralStringAffix,
+	TypeLiteralStringBacktick,
+	TypeLiteralStringChar,
+	TypeLiteralStringDelimiter,
+	TypeLiteralStringDoc,
+	TypeLiteralStringDouble,
+	TypeLiteralStringEscape,
+	TypeLiteralStringHeredoc,
+	TypeLiteralStringInterpol,
+	TypeLiteralStringOther,
+	TypeLiteralStringRegex,
+	TypeLiteralStringSingle,
+	TypeLiteralStringSymbol,
+	TypeLiteralNumber,
+	TypeLiteralNumberBin,
+	TypeLiteralNumberFloat,
+	TypeLiteralNumberHex,
+	TypeLiteralNumberInteger,
+	TypeLiteralNumberIntegerLong,
+	TypeLiteralNumberOct,
+	TypeOperator,
+	TypeOperatorWord,
+	TypeOperatorReserved,
+	TypeGenericDeleted,
+	TypeGenericEmph,
+	TypeGenericInserted,
+	TypeGenericStrong,
+	TypeGenericSubheading,
+	TypeError,
+}
+
+// AllTypes returns all known token types.
+func AllTypes() []Type {
+	out := make([]Type, len(all))
+	copy(out, all)
+	return out
+}
+
+// shortCode maps a token type to its CSS class name used by the HTML formatter.
+var shortCode = map[Type]string{
+	TypeError:                    "err",
+	TypeKeyword:                  "k",
+	TypeKeywordConstant:          "kc",
+	TypeKeywordDeclaration:       "kd",
+	TypeKeywordNamespace:         "kn",
+	TypeKeywordPseudo:            "kp",
+	TypeKeywordReserved:          "kr",
+	TypeKeywordType:              "kt",
+	TypeName:                     "n",
+	TypeNameAttribute:            "na",
+	TypeNameBuiltin:              "nb",
+	TypeNameBuiltinPseudo:        "bp",
+	TypeNameClass:                "nc",
+	TypeNameConstant:             "no",
+	TypeNameDecorator:            "nd",
+	TypeNameException:            "ne",
+	TypeNameFunction:             "nf",
+	TypeNameFunctionMagic:        "fm",
+	TypeNameNamespace:            "nn",
+	TypeNameOther:                "nx",
+	TypeNameTag:                  "nt",
+	TypeNameVariable:             "nv",
+	TypeLiteral:                  "l",
+	TypeLiteralDate:              "ld",
+	TypeLiteralString:            "s",
+	TypeLiteralStringAffix:       "sa",
+	TypeLiteralStringBacktick:    "sb",
+	TypeLiteralStringChar:        "sc",
+	TypeLiteralStringDelimiter:   "dl",
+	TypeLiteralStringDoc:         "sd",
+	TypeLiteralStringDouble:      "s2",
+	TypeLiteralStringEscape:      "se",
+	TypeLiteralStringHeredoc:     "sh",
+	TypeLiteralStringInterpol:    "si",
+	TypeLiteralStringOther:       "sx",
+	TypeLiteralStringRegex:       "sr",
+	TypeLiteralStringSingle:      "s1",
+	TypeLiteralStringSymbol:      "ss",
+	TypeLiteralNumber:            "m",
+	TypeLiteralNumberBin:         "mb",
+	TypeLiteralNumberFloat:       "mf",
+	TypeLiteralNumberHex:         "mh",
+	TypeLiteralNumberInteger:     "mi",
+	TypeLiteralNumberIntegerLong: "il",
+	TypeLiteralNumberOct:         "mo",
+	TypeOperator:                 "o",
+	TypeOperatorWord:             "ow",
+	TypeOperatorReserved:         "or",
+	TypeComment:                  "c",
+	TypeCommentHashbang:          "ch",
+	TypeCommentMultiline:         "cm",
+	TypeCommentSingle:            "c1",
+	TypeCommentSpecial:           "cs",
+	TypeCommentPreproc:           "cp",
+	TypeCommentPreprocFile:       "cpf",
+	TypeGenericDeleted:           "gd",
+	TypeGenericEmph:              "ge",
+	TypeGenericInserted:          "gi",
+	TypeGenericStrong:            "gs",
+	TypeGenericSubheading:        "gu",
+}
+
+// ShortCode returns the CSS class name for a token type, or "" if none.
+func (t Type) ShortCode() string {
+	return shortCode[t]
+}
+
+// parent returns the parent token type used for style lookup, or "".
+func (t Type) parent() Type {
+	switch t {
+	case TypeCommentPreproc, TypeCommentPreprocFile, TypeCommentHashbang,
+		TypeCommentMultiline, TypeCommentSingle, TypeCommentSpecial:
+		return TypeComment
+	case TypeKeywordConstant, TypeKeywordDeclaration, TypeKeywordNamespace,
+		TypeKeywordPseudo, TypeKeywordReserved, TypeKeywordType:
+		return TypeKeyword
+	case TypeNameAttribute, TypeNameBuiltin, TypeNameBuiltinPseudo, TypeNameClass,
+		TypeNameConstant, TypeNameDecorator, TypeNameException, TypeNameFunction,
+		TypeNameFunctionMagic, TypeNameNamespace, TypeNameOther, TypeNameTag,
+		TypeNameVariable:
+		return TypeName
+	case TypeLiteralDate:
+		return TypeLiteral
+	case TypeLiteralString, TypeLiteralStringAffix, TypeLiteralStringBacktick,
+		TypeLiteralStringChar, TypeLiteralStringDelimiter, TypeLiteralStringDoc,
+		TypeLiteralStringDouble, TypeLiteralStringEscape, TypeLiteralStringHeredoc,
+		TypeLiteralStringInterpol, TypeLiteralStringOther, TypeLiteralStringRegex,
+		TypeLiteralStringSingle, TypeLiteralStringSymbol:
+		return TypeLiteral
+	case TypeLiteralNumber, TypeLiteralNumberBin, TypeLiteralNumberFloat,
+		TypeLiteralNumberHex, TypeLiteralNumberInteger, TypeLiteralNumberIntegerLong,
+		TypeLiteralNumberOct:
+		return TypeLiteral
+	case TypeOperatorWord, TypeOperatorReserved:
+		return TypeOperator
+	}
+	return ""
+}
+
+// Parent returns the parent token type for style inheritance, or "".
+func (t Type) Parent() Type { return t.parent() }
