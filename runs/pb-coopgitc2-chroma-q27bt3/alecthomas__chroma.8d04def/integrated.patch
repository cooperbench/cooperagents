+package chroma
+
+import "github.com/alecthomas/chroma/token"
+
+// Token is a lexed token: a semantic type and a string value.
+type Token struct {
+	Type  token.Type
+	Value string
+}
+
+// String returns a string representation of the token, matching chroma's
+// %v output: "&Token{<Type>, "<Value>"}".
+func (t *Token) String() string {
+	return "&Token{" + string(t.Type) + ", \"" + t.Value + "\"}"
+}
+
+// Predicate methods for common token types.
+func (t Token) Whitespace() bool               { return t.Type == token.TypeWhitespace }
+func (t Token) Comment() bool                  { return t.Type == token.TypeComment }
+func (t Token) CommentPreproc() bool           { return t.Type == token.TypeCommentPreproc }
+func (t Token) CommentPreprocFile() bool       { return t.Type == token.TypeCommentPreprocFile }
