new file mode 100644
index 0000000..909667b
--- /dev/null
+++ b/lexers/text.go
@@ -0,0 +1,22 @@
+package lexers
+
+import (
+	"github.com/alecthomas/chroma/chroma"
+	"github.com/alecthomas/chroma/token"
+)
+
+// textLexer is the fallback lexer that produces a single Text token for the
+// entire input. Used when no specific lexer matches.
+type textLexer struct{}
+
+func (textLexer) Name() string         { return "text" }
+func (textLexer) Aliases() []string    { return []string{} }
+func (textLexer) FileNames() []string  { return []string{} }
+func (textLexer) MimeTypes() []string  { return []string{} }
+
+func (textLexer) Lex(s string) []chroma.Token {
+	if s == "" {
+		return nil
+	}
+	return []chroma.Token{{Type: token.TypeUnspecified, Value: s}}
+}
