@@ -0,0 +1,115 @@
+package lexers
+
+import (
+	"github.com/alecthomas/chroma/chroma"
+	"github.com/alecthomas/chroma/token"
+)
+
+// pythonLexer is a basic Python lexer.
+type pythonLexer struct{}
+
+func (pythonLexer) Name() string       { return "python" }
+func (pythonLexer) Aliases() []string  { return []string{"py", "python3", "python3.10", "python3.11"} }
+func (pythonLexer) FileNames() []string { return []string{"*.py", "*.pyw", "*.pyi", "setup.cfg"} }
+func (pythonLexer) MimeTypes() []string { return []string{"text/x-python", "text/x-python3", "application/x-python"} }
+
+var pythonKeywords = map[string]bool{
+	"False": true, "None": true, "True": true,
+	"and": true, "as": true, "assert": true, "async": true, "await": true,
+	"break": true, "class": true, "continue": true, "def": true, "del": true,
+	"elif": true, "else": true, "except": true, "finally": true, "for": true,
+	"from": true, "global": true, "if": true, "import": true, "in": true,
+	"is": true, "lambda": true, "nonlocal": true, "not": true, "or": true,
+	"pass": true, "raise": true, "return": true, "try": true, "while": true,
+	"with": true, "yield": true,
+}
+
+var pythonBuiltins = map[string]bool{
+	"abs": true, "all": true, "any": true, "bool": true, "dict": true, "float": true,
+	"int": true, "len": true, "list": true, "map": true, "max": true, "min": true,
+	"print": true, "range": true, "set": true, "str": true, "sum": true, "tuple": true,
+	"zip": true, "open": true, "type": true, "super": true, "property": true,
+}
+
+func (pythonLexer) Lex(s string) []chroma.Token {
+	var out []chroma.Token
+	runes := []rune(s)
+	i := 0
+	n := len(runes)
+	for i < n {
+		c := runes[i]
+		switch {
+		case c == '#' || c == '"' || c == '\'' || c == '`':
+			// comment or string
+			if c == '#' {
+				j := i
+				for j < n && runes[j] != '\n' {
+					j++
+				}
+				out = append(out, chroma.Token{Type: token.TypeCommentSingle, Value: string(runes[i:j])})
+				i = j
+			} else {
+				// string (basic)
+				j := i + 1
+				for j < n && runes[j] != c && runes[j] != '\n' {
+					if runes[j] == '\\' {
+						j++
+					}
+					j++
+				}
+				if j < n && runes[j] == c {
+					j++
+				}
+				out = append(out, chroma.Token{Type: token.TypeLiteralString, Value: string(runes[i:j])})
+				i = j
+			}
+		case c >= '0' && c <= '9':
+			// number
+			j := i + 1
+			for j < n && (isDigit(runes[j]) || runes[j] == '.' || runes[j] == '_') {
+				j++
+			}
+			out = append(out, chroma.Token{Type: token.TypeLiteralNumberInteger, Value: string(runes[i:j])})
+			i = j
+		case isLetter(runes[i]):
+			// name
+			j := i + 1
+			for j < n && (isLetterOrDigit(runes[j]) || runes[j] == '_') {
+				j++
+			}
+			word := string(runes[i:j])
+			t := token.TypeName
+			if pythonKeywords[word] {
+				t = token.TypeKeyword
+			} else if pythonBuiltins[word] {
+				t = token.TypeNameBuiltin
+			}
+			out = append(out, chroma.Token{Type: t, Value: word})
+			i = j
+		case isOp(c):
+			// operator
+			j := i + 1
+			for j < n && isOp(runes[j]) {
+				j++
+			}
+			out = append(out, chroma.Token{Type: token.TypeOperator, Value: string(runes[i:j])})
+			i = j
+		default:
+			// whitespace or other
+			out = append(out, chroma.Token{Type: token.TypeUnspecified, Value: string(c)})
+			i++
+		}
+	}
+	return out
+}
+
+func isDigit(r rune) bool     { return r >= '0' && r <= '9' }
+func isLetter(r rune) bool    { return (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || r == '_' }
+func isLetterOrDigit(r rune) bool { return isLetter(r) || isDigit(r) }
+func isOp(r rune) bool {
+	switch r {
+	case '+', '-', '*', '/', '(', ')', '[', ']', '{', '}', '<', '>', '=', '!', ':', ';', ',', '.':
+		return true
+	}
+	return false
+}
