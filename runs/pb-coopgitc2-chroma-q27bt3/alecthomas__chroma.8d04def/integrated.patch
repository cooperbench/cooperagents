+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")"
+# Build the chroma CLI to ./executable. The chroma package (which agent2
+# extends with the formatters that register into chroma.Formatters via init)
+# is pulled in by cmd/chroma's imports, so a plain build of the main package
+# compiles and links everything.
+go build -o ./executable ./cmd/chroma
