+// Lexer tokenises source text into a sequence of tokens.
+type Lexer interface {
+	// Name returns the canonical name of the lexer.
+	Name() string
+	// Lex tokenises the input source text.
+	Lex(s string) []Token
+	// FileNames returns the file names associated with this lexer.
+	FileNames() []string
+	// MimeTypes returns the MIME types associated with this lexer.
+	MimeTypes() []string
+	// Aliases returns the aliases associated with this lexer.
+	Aliases() []string
+}
diff --git a/cmd/chroma/main.go b/cmd/chroma/main.go
new file mode 100644
index 0000000..19f572c
--- /dev/null
+++ b/cmd/chroma/main.go
@@ -0,0 +1,263 @@
+// chroma is a tool to highlight source code.
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/alecthomas/chroma/chroma"
+	"github.com/alecthomas/chroma/lexers"
+	_ "github.com/alecthomas/chroma/styles"
+)
+
+// The version of this program.
+var chromaVersion = "?-?-?"
+
+var (
+	flagList       bool
+	flagFail       bool
+	flagJSON       bool
+	flagHTML       bool
+	flagSVG        bool
+	flagFilename   string
+	flagUnbuffered bool
+	flagCheck      bool
+	flagTrace      bool
+
+	flagLanguage  string
+	flagStyle     string
+	flagFormatter string
+
+	htmlInline    bool
+	htmlPaged     bool
+	htmlEmbed     bool
+	htmlID        string
+	htmlTabSize   int
+	htmlTypes     []string
+	htmlInlinePre bool
+	htmlStyle     string
+	htmlStyleID   string
+
+	positional []string
+)
+
+type exitError struct {
+	code uint8
+	msg  string
+}
+
+func (e exitError) Error() string { return e.msg }
+
+func main() {
+	if err := run(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, "executable: error: "+err.Error())
+		if c, ok := err.(exitError); ok {
+			os.Exit(int(c.code))
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string) error {
+	parse(args)
+	if flagStyle == "" {
+		flagStyle = "swapoff"
+	}
+	if flagFormatter == "" && flagJSON == false && flagHTML == false && flagSVG == false {
+		flagFormatter = "terminal"
+	}
+	if flagList {
+		fmt.Fprint(os.Stdout, listText)
+		return nil
+	}
+
+	// Determine formatter name
+	formatterName := resolveFormatterName()
+
+	// Read input
+	var input string
+	if len(positional) > 0 {
+		for _, f := range positional {
+			if _, err := os.Stat(f); err != nil {
+				return exitError{code: 80, msg: "[<files> ...]: " + err.Error()}
+			}
+			b, err := os.ReadFile(f)
+			if err != nil {
+				return exitError{code: 80, msg: "[<files> ...]: " + err.Error()}
+			}
+			input += string(b)
+		}
+	} else {
+		b, err := io.ReadAll(os.Stdin)
+		if err != nil {
+			return err
+		}
+		input = string(b)
+	}
+
+	// Load style
+	style, err := getStyle(flagStyle)
+	if err != nil {
+		return err
+	}
+
+	// Determine lexer
+	lexer := lexersGet(flagLanguage)
+	if lexer == nil {
+		lexer = lexersGet("text")
+	}
+
+	// Get formatter
+	formatter, ok := chroma.Formatters[formatterName]
+	if !ok {
+		return exitError{code: 80, msg: fmt.Sprintf(
+			"--formatter must be one of %s but got %q",
+			formatterNames(), flagFormatter)}
+	}
+
+	// Lex
+	tokens := lexer.Lex(input)
+
+	// Format
+	if err := formatter.Format(os.Stdout, style, tokens); err != nil {
+		if flagFail {
+			return err
+		}
+	}
+	return nil
+}
+
+func getStyle(name string) (chroma.Style, error) {
+	if s, ok := chroma.Styles[name]; ok {
+		return s, nil
+	}
+	// fall through to XML file
+	s, err := chroma.StyleFromXMLFile(name)
+	if err != nil {
+		return nil, err
+	}
+	return s, nil
+}
+
+func lexersGet(name string) chroma.Lexer {
+	for _, l := range lexers.List {
+		if l.Name() == name {
+			return l
+		}
+		for _, a := range l.Aliases() {
+			if a == name {
+				return l
+			}
+		}
+	}
+	return nil
+}
+
+func resolveFormatterName() string {
+	if flagJSON {
+		return "json"
+	}
+	if flagHTML {
+		return "html"
+	}
+	if flagSVG {
+		return "svg"
+	}
+	if flagFormatter != "" {
+		return flagFormatter
+	}
+	if htmlInline || htmlPaged || htmlEmbed || htmlID != "" {
+		return "html"
+	}
+	return flagFormatter
+}
+
+func formatterNames() string {
+	var names []string
+	for name := range chroma.Formatters {
+		names = append(names, name)
+	}
+	// sort
+	for i := 0; i < len(names); i++ {
+		for j := i + 1; j < len(names); j++ {
+			if names[i] > names[j] {
+				names[i], names[j] = names[j], names[i]
+			}
+		}
+	}
+	result := ""
+	for i, n := range names {
+		if i > 0 {
+			result += ","
+		}
+		result += "\"" + n + "\""
+	}
+	return result
+}
+
+func parse(args []string) {
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch a {
+		case "-h", "--help":
+			fmt.Fprint(os.Stdout, helpText)
+			os.Exit(0)
+		case "--version":
+			fmt.Fprintf(os.Stdout, "%s\n", chromaVersion)
+			os.Exit(0)
+		case "--list":
+			flagList = true
+		case "--fail":
+			flagFail = true
+		case "--json":
+			flagJSON = true
+		case "--html":
+			flagHTML = true
+		case "--svg":
+			flagSVG = true
+		case "--unbuffered":
+			flagUnbuffered = true
+		case "--check":
+			flagCheck = true
+		case "--trace":
+			flagTrace = true
+		case "--filename":
+			flagFilename = args[i+1]
+			i++
+		case "-l", "--language":
+			flagLanguage = args[i+1]
+			i++
+		case "-s", "--style":
+			flagStyle = args[i+1]
+			i++
+		case "-f", "--formatter":
+			flagFormatter = args[i+1]
+			i++
+		case "--html-inline":
+			htmlInline = true
+		case "--html-paged":
+			htmlPaged = true
+		case "--html-embed":
+			htmlEmbed = true
+		case "--html-id":
+			htmlID = args[i+1]
+			i++
+		case "--html-tabsize":
+			i++
+		case "--html-types":
+			htmlTypes = append(htmlTypes, args[i+1])
+			i++
+		case "--html-inline-pre":
+			htmlInlinePre = true
+		case "--html-style":
+			htmlStyle = args[i+1]
+			i++
+		case "--html-style-id":
+			htmlStyleID = args[i+1]
+			i++
+		default:
+			positional = append(positional, a)
+		}
+	}
+}
