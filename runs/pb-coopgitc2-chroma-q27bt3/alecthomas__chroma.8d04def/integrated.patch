@@ -0,0 +1,14 @@
+package token
+
+// Style is a token style (colour and font decoration).
+type Style struct {
+	Colour    string
+	Bold      bool
+	Italic    bool
+	Underline bool
+}
+
+// Equal reports whether two styles are equal.
+func (s Style) Equal(other Style) bool {
+	return s.Colour == other.Colour && s.Bold == other.Bold && s.Italic == other.Italic && s.Underline == other.Underline
+}
