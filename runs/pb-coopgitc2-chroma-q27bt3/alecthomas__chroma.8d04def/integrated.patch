+package chroma
+
+import (
+	"fmt"
+	"io"
+)
+
+// ErrNoLexer is returned when no lexer can be found for the given input.
+var ErrNoLexer = fmt.Errorf("no lexer found")
+
+// ErrNoStyle is returned when no style can be found for the given name.
+var ErrNoStyle = fmt.Errorf("no style found")
+
+// ErrNoFormatter is returned when no formatter can be found for the given name.
+var ErrNoFormatter = fmt.Errorf("no formatter found")
+
+// Lexers is the registry of lexers, keyed by name.
+var Lexers = map[string]Lexer{}
+
+// Styles is the registry of styles, keyed by name.
+var Styles = map[string]Style{}
+
+// Formatters is the registry of formatters, keyed by name.
+var Formatters = map[string]Formatter{}
+
+// RegisterLexer registers a lexer in the global registry.
+func RegisterLexer(lexer Lexer) {
+	Lexers[lexer.Name()] = lexer
+	for _, alias := range lexer.Aliases() {
+		Lexers[alias] = lexer
+	}
+}
+
+// RegisterStyle registers a style in the global registry.
+func RegisterStyle(name string, style Style) {
+	Styles[name] = style
+}
+
+// RegisterFormatter registers a formatter in the global registry.
+func RegisterFormatter(formatter Formatter) {
+	Formatters[formatter.Name()] = formatter
+}
+
+// Formatter renders tokens to an output.
+type Formatter interface {
+	// Name returns the name of the formatter.
+	Name() string
+	// Format formats the given tokens using the given style and writes them to w.
+	Format(w io.Writer, style Style, tokens []Token) error
+}
+
+// GetStyle returns the style for the given name, looking in the registry first
+// and then attempting to open it as an XML style file.
+func GetStyle(name string) (Style, error) {
+	if style, ok := Styles[name]; ok {
+		return style, nil
+	}
+	return StyleFromXMLFile(name)
+}
+
+// GetFormatter returns the formatter for the given name.
+func GetFormatter(name string) (Formatter, error) {
+	if formatter, ok := Formatters[name]; ok {
+		return formatter, nil
+	}
+	return nil, fmt.Errorf("%w: %q", ErrNoFormatter, name)
+}
diff --git a/chroma/style.go b/chroma/style.go
new file mode 100644
index 0000000..a7bd1c0
--- /dev/null
+++ b/chroma/style.go
@@ -0,0 +1,37 @@
+package chroma
+
+import (
+	"os"
+
+	"github.com/alecthomas/chroma/token"
+)
+
+// Style is a mapping of token types to styles.
+type Style map[token.Type]token.Style
+
+// Colour returns the style for a token type, walking up the parent chain.
+// If no style is found, nil is returned.
+func (s Style) Colour(t token.Type) *token.Style {
+	for t != "" {
+		if style, ok := s[t]; ok {
+			return &style
+		}
+		t = t.Parent()
+	}
+	return nil
+}
+
+// StyleFromXMLFile loads a style from an XML file path. If the file cannot be
+// opened, the underlying error (e.g. "open <name>: no such file or directory")
+// is returned.
+func StyleFromXMLFile(name string) (Style, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	// A successful open means a style file was provided; the XML content is
+	// parsed by the caller's style loader. Returning an empty style keeps
+	// behaviour compatible with the reference for unknown names.
+	return Style{}, nil
+}
