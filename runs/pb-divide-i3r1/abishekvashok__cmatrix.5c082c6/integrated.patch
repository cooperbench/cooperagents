diff --git a/main.c b/main.c
new file mode 100644
index 0000000..a42b242
--- /dev/null
+++ b/main.c
@@ -0,0 +1,384 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <ncurses.h>
+#include <locale.h>
+#include <ctype.h>
+#include "args.h"
+#include "errors.h"
+#include "version.h"
+
+#define MAX_COLS 256
+#define MAX_ROWS 256
+#define MAX_CHARS 256
+#define MAX_MESSAGE 256
+
+typedef struct {
+    char ch;
+    int x, y;
+    int color;
+    int bold;
+    int shadow;
+} CharCell;
+
+typedef struct {
+    CharCell *cells;
+    int cols, rows;
+    int char_count;
+    int async;
+    int speed;
+    int color;
+    int shadow_color;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int rainbow;
+    int lambda;
+    int every_char_change;
+    int old_style;
+    int only_shadows;
+    char message[MAX_MESSAGE];
+    int message_x, message_y;
+    int tty;
+    int lock;
+    int screensaver;
+    int update_delay;
+} Matrix;
+
+static const char *ascii_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?";
+static const char *katakana_chars = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static const char *lambda_chars = "λΛ";
+
+static int get_char_index(const char *chars, int idx) {
+    if (idx < 0 || idx >= (int)strlen(chars)) return 0;
+    return idx % (int)strlen(chars);
+}
+
+static int random_char_index(const char *chars) {
+    return get_char_index(chars, rand() % (int)strlen(chars));
+}
+
+static int get_color_index(const char *chars, int idx) {
+    if (idx < 0 || idx >= (int)strlen(chars)) return 0;
+    return idx % (int)strlen(chars);
+}
+
+static int random_color_index(const char *chars) {
+    return get_color_index(chars, rand() % (int)strlen(chars));
+}
+
+static void init_matrix(Matrix *m, Args *args) {
+    m->cols = COLS;
+    m->rows = LINES;
+    m->cells = calloc(m->cols * m->rows, sizeof(CharCell));
+    m->char_count = 0;
+    m->async = args->async_scroll;
+    m->speed = args->update_delay;
+    m->color = args->color ? 1 : 0;
+    m->shadow_color = args->only_shadows ? 1 : 0;
+    m->bold = args->bold_chars;
+    m->all_bold = args->all_bold;
+    m->no_bold = args->no_bold;
+    m->rainbow = args->rainbow;
+    m->lambda = args->lambda_mode;
+    m->every_char_change = args->every_char_change;
+    m->old_style = args->old_style;
+    m->only_shadows = args->only_shadows;
+    m->message[0] = '\0';
+    if (args->message) {
+        strncpy(m->message, args->message, MAX_MESSAGE - 1);
+        m->message[MAX_MESSAGE - 1] = '\0';
+    }
+    m->tty = args->tty ? atoi(args->tty) : 0;
+    m->lock = args->lock_mode;
+    m->screensaver = args->screensaver;
+    m->update_delay = args->update_delay;
+}
+
+static void free_matrix(Matrix *m) {
+    if (m->cells) {
+        free(m->cells);
+        m->cells = NULL;
+    }
+}
+
+static void init_colors(void) {
+    if (has_colors()) {
+        start_color();
+        init_pair(1, COLOR_GREEN, COLOR_BLACK);
+        init_pair(2, COLOR_RED, COLOR_BLACK);
+        init_pair(3, COLOR_YELLOW, COLOR_BLACK);
+        init_pair(4, COLOR_BLUE, COLOR_BLACK);
+        init_pair(5, COLOR_MAGENTA, COLOR_BLACK);
+        init_pair(6, COLOR_CYAN, COLOR_BLACK);
+        init_pair(7, COLOR_WHITE, COLOR_BLACK);
+        init_pair(8, COLOR_BLACK, COLOR_BLACK);
+    }
+}
+
+static void clear_screen(void) {
+    clear();
+    refresh();
+}
+
+static void init_terminal(void) {
+    struct termios oldt, newt;
+    tcgetattr(STDIN_FILENO, &oldt);
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
+}
+
+static void restore_terminal(struct termios *oldt) {
+    tcsetattr(STDIN_FILENO, TCSANOW, oldt);
+}
+
+static void set_linux_font(Args *args) {
+    if (args->linux_mode) {
+        setlocale(LC_ALL, "");
+        if (args->only_shadows) {
+            setlocale(LC_ALL, "");
+        }
+    }
+}
+
+static void print_message(Matrix *m) {
+    if (m->message[0] != '\0') {
+        int msg_len = strlen(m->message);
+        int msg_x = (COLS - msg_len) / 2;
+        int msg_y = (LINES - 1) / 2;
+        if (msg_x < 0) msg_x = 0;
+        if (msg_y < 0) msg_y = 0;
+        if (msg_y >= LINES) msg_y = LINES - 1;
+        mvprintw(msg_y, msg_x, "%s", m->message);
+        refresh();
+    }
+}
+
+static void draw_matrix(Matrix *m) {
+    int x, y, i;
+    int char_idx, color_idx;
+    
+    for (y = 0; y < m->rows; y++) {
+        for (x = 0; x < m->cols; x++) {
+            int idx = y * m->cols + x;
+            if (idx >= m->char_count) {
+                char_idx = random_char_index(m->lambda ? lambda_chars : (m->only_shadows ? ascii_chars : katakana_chars));
+                color_idx = random_color_index(ascii_chars);
+                m->cells[idx].ch = m->lambda ? lambda_chars[char_idx] : katakana_chars[char_idx];
+                m->cells[idx].x = x;
+                m->cells[idx].y = y;
+                m->cells[idx].color = color_idx;
+                m->cells[idx].bold = m->bold || m->all_bold;
+                m->cells[idx].shadow = m->only_shadows;
+                m->char_count++;
+            }
+            
+            CharCell *cell = &m->cells[idx];
+            int color = 0;
+            
+            if (m->rainbow) {
+                color = (y + x) % 8 + 1;
+            } else {
+                color = cell->color + 1;
+            }
+            
+            if (cell->bold && !m->no_bold) {
+                attron(A_BOLD);
+            }
+            
+            if (cell->shadow) {
+                mvprintw(cell->y, cell->x, " ");
+            }
+            
+            if (m->only_shadows) {
+                mvprintw(cell->y, cell->x, " ");
+            } else {
+                mvprintw(cell->y, cell->x, "%c", cell->ch);
+            }
+            
+            if (cell->bold && !m->no_bold) {
+                attroff(A_BOLD);
+            }
+            
+            attron(COLOR_PAIR(color));
+            if (cell->shadow) {
+                mvprintw(cell->y, cell->x, " ");
+            }
+            attroff(COLOR_PAIR(color));
+        }
+    }
+    
+    refresh();
+}
+
+static void update_matrix(Matrix *m) {
+    int x, y, i;
+    int char_idx, color_idx;
+    
+    for (y = 0; y < m->rows; y++) {
+        for (x = 0; x < m->cols; x++) {
+            int idx = y * m->cols + x;
+            if (idx >= m->char_count) {
+                char_idx = random_char_index(m->lambda ? lambda_chars : (m->only_shadows ? ascii_chars : katakana_chars));
+                color_idx = random_color_index(ascii_chars);
+                m->cells[idx].ch = m->lambda ? lambda_chars[char_idx] : katakana_chars[char_idx];
+                m->cells[idx].x = x;
+                m->cells[idx].y = y;
+                m->cells[idx].color = color_idx;
+                m->cells[idx].bold = m->bold || m->all_bold;
+                m->cells[idx].shadow = m->only_shadows;
+                m->char_count++;
+            }
+        }
+    }
+}
+
+static void handle_key(Matrix *m, int key) {
+    if (m->screensaver) {
+        return;
+    }
+    
+    switch (key) {
+        case 'a':
+            m->async = !m->async;
+            break;
+        case 'b':
+            m->bold = !m->bold;
+            break;
+        case 'B':
+            m->all_bold = 1;
+            m->bold = 1;
+            break;
+        case 'n':
+            m->no_bold = 1;
+            m->bold = 0;
+            m->all_bold = 0;
+            break;
+        case '0':
+        case '1':
+        case '2':
+        case '3':
+        case '4':
+        case '5':
+        case '6':
+        case '7':
+        case '8':
+        case '9':
+            m->update_delay = key - '0';
+            break;
+        case '!':
+            m->color = 1;
+            break;
+        case '@':
+            m->color = 0;
+            break;
+        case '#':
+            m->color = 2;
+            break;
+        case '$':
+            m->color = 3;
+            break;
+        case '%':
+            m->color = 4;
+            break;
+        case '^':
+            m->color = 5;
+            break;
+        case '&':
+            m->color = 6;
+            break;
+        case ')':
+            m->color = 7;
+            break;
+        case 'q':
+            endwin();
+            exit(0);
+            break;
+    }
+}
+
+int main(int argc, char **argv) {
+    Args *args = args_init();
+    if (!args) {
+        error_exit("Failed to initialize arguments");
+    }
+    
+    if (args_parse(argc, argv, args) != 0) {
+        args_free(args);
+        return EXIT_FAILURE;
+    }
+    
+    if (args->help_shown) {
+        args_print_help();
+        args_free(args);
+        return EXIT_SUCCESS;
+    }
+    
+    if (args->version_shown) {
+        version_print();
+        args_free(args);
+        return EXIT_SUCCESS;
+    }
+    
+    setlocale(LC_ALL, "");
+    init_colors();
+    init_terminal();
+    
+    Matrix m;
+    init_matrix(&m, args);
+    
+    struct termios oldt;
+    tcgetattr(STDIN_FILENO, &oldt);
+    
+    int key;
+    int running = 1;
+    
+    while (running) {
+        if (m.screensaver) {
+            key = getch();
+            if (key != -1) {
+                running = 0;
+            }
+        } else {
+            fd_set fds;
+            FD_ZERO(&fds);
+            FD_SET(STDIN_FILENO, &fds);
+            
+            struct timeval tv;
+            tv.tv_sec = 0;
+            tv.tv_usec = m.update_delay * 10000;
+            
+            if (select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv) > 0) {
+                key = getch();
+                if (key != -1) {
+                    handle_key(&m, key);
+                }
+            }
+        }
+        
+        if (m.every_char_change) {
+            update_matrix(&m);
+        }
+        
+        draw_matrix(&m);
+        print_message(&m);
+        
+        if (m.screensaver) {
+            key = getch();
+            if (key != -1) {
+                running = 0;
+            }
+        }
+    }
+    
+    restore_terminal(&oldt);
+    free_matrix(&m);
+    args_free(args);
+    
+    return EXIT_SUCCESS;
+}
