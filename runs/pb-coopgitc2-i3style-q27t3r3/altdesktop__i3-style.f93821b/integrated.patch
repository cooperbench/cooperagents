new file mode 100755
index 0000000..3375dcd
--- /dev/null
+++ b/scratch/mkt.sh
@@ -0,0 +1,9 @@
+#!/bin/bash
+# $1 = script name, $2 = exit code, $3 = stderr text
+cat > fakebin/$1 <<EOF
+#!/bin/bash
+echo "$1 CALL: \$@" >> /workspace/scratch/i3_calls.log
+[ -n "$3" ] && echo "$3" >&2
+exit $2
+EOF
+chmod +x fakebin/$1
