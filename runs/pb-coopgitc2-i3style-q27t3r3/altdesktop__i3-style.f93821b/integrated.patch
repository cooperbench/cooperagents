diff --git a/scratch/probe1.sh b/scratch/probe1.sh
new file mode 100644
index 0000000..5211014
--- /dev/null
+++ b/scratch/probe1.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+# Batch probe of CLI behaviors
+cd /workspace
+E=./executable
+{
+echo "=== 1. no args (done: shows USAGE + hint, exit 1)"
+echo "=== 2. unknown long flag --foo (done: clap error, exit 1)"
+echo "=== 3. unknown short flag -z (done: clap error, exit 1)"
+echo "=== 4. nonexistent theme name"
+$E nonexistent-theme; echo "EXIT: $?"
+echo "=== 5. -o without theme"
+$E -o /tmp/o1; echo "EXIT: $?"; ls -la /tmp/o1 2>/dev/null
+echo "=== 6. -c missing file"
+$E -c /nonexistent/config solarized -o /tmp/o2; echo "EXIT: $?"
+echo "=== 7. option without value"
+$E -o 2>&1; echo "EXIT: $?"
+echo "=== 8. -t without value"
+$E -t 2>&1; echo "EXIT: $?"
+echo "=== 9. two positional args"
+$E solarized purple; echo "EXIT: $?"
+echo "=== 10. -s flag alone"
+$E -s solarized; echo "EXIT: $?"
+} > probe1.out 2>&1
+echo done
