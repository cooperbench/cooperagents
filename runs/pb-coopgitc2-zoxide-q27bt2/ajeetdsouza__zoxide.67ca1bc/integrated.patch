++fn dispatch(bin: &str, sub: &str, rest: &[String]) -> i32 {
++    // clap-style: --help/-h or --version/-V anywhere in the remaining args
++    // is handled by the subcommand itself.
++    if rest.iter().any(|s| s == "--help" || s == "-h") {
++        print!("{}", sub_help(bin, sub));
++        return 0;
++    }
++    if rest.iter().any(|s| s == "--version" || s == "-V") {
++        print!("{}", sub_version(sub));
++        return 0;
++    }
++    // Strip the subcommand name so the subcommand sees only its own args.
++    let mut args = Vec::new();
++    for s in rest {
++        if s != sub {
++            args.push(s.clone());
++        }
++    }
++    let args: Vec<String> = args;
++    match sub {
++        "add" => crate::add::run(bin, &args),
++        "edit" => crate::edit::run(bin, &args),
++        "import" => crate::import::run(bin, &args),
++        "init" => crate::init::run(bin, &args),
++        "query" => crate::query::run(bin, &args),
++        "remove" => crate::remove::run(bin, &args),
++        _ => {
++            eprint!(
++                "error: unrecognized subcommand '{}'\n\nUsage: {} <COMMAND>\n\nFor more information, try '--help'.\n",
++                sub, bin
++            );
++            2
++        }
++    }
++}
