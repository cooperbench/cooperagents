+
+fn dispatch(bin: &str, sub: &str, rest: &[String]) -> i32 {
+    // clap-style: --help/-h or --version/-V anywhere in the remaining args
+    // is handled by the subcommand itself.
+    if rest.iter().any(|s| s == "--help" || s == "-h") {
+        print!("{}", sub_help(bin, sub));
+        return 0;
+    }
+    if rest.iter().any(|s| s == "--version" || s == "-V") {
+        print!("{}", sub_version(sub));
+        return 0;
+    }
+    // Strip the subcommand name so the subcommand sees only its own args.
+    let mut args = Vec::new();
+    for s in rest {
+        if s != sub {
+            args.push(s.clone());
+        }
+    }
+    let args: Vec<String> = args;
+    match sub {
+        "add" => crate::add::run(bin, &args),
+        "edit" => crate::edit::run(bin, &args),
+        "import" => crate::import::run(bin, &args),
+        "init" => crate::init::run(bin, &args),
+        "query" => crate::query::run(bin, &args),
+        "remove" => crate::remove::run(bin, &args),
+        _ => {
+            eprint!(
+                "error: unrecognized subcommand '{}'\n\nUsage: {} <COMMAND>\n\nFor more information, try '--help'.\n",
+                sub, bin
+            );
+            2
+        }
+    }
+}
+
+pub fn main(args: &[String]) -> i32 {
+    let bin = bin_name(args);
+    let rest = &args[1..];
+    if rest.is_empty() {
+        eprint!("{}", main_help(&bin));
+        return 2;
+    }
+    // Position of the first non-flag token = the subcommand.
+    let sub_idx = rest.iter().position(|s| !s.starts_with('-'));
+    match sub_idx {
+        None => {
+            // Only flags at the top level.
+            if rest.iter().any(|s| s == "--help" || s == "-h") {
+                print!("{}", main_help(&bin));
+                return 0;
+            }
+            if rest.iter().any(|s| s == "--version" || s == "-V") {
+                print!("{}", main_version());
+                return 0;
+            }
+            eprint!("{}", main_help(&bin));
+            2
+        }
+        Some(idx) => {
+            // Flags before the subcommand belong to the parent command.
+            let before = &rest[..idx];
+            if before.iter().any(|s| s == "--help" || s == "-h") {
+                print!("{}", main_help(&bin));
+                return 0;
+            }
+            if before.iter().any(|s| s == "--version" || s == "-V") {
+                print!("{}", main_version());
+                return 0;
+            }
+            let sub = &rest[idx];
+            dispatch(&bin, sub, rest)
+        }
+    }
+}
