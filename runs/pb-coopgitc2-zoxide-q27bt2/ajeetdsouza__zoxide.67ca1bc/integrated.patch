+#!/bin/bash
+set -e
+cd "$(dirname "$0")"
+# Build to a temp file then move into place (works even if ./executable is read-only,
+# since replacing a file only needs write permission on the containing directory).
+tmp="$(mktemp -d)/zo_exec"
+rustc --edition 2021 -O src/main.rs -o "$tmp"
+mv -f "$tmp" executable
