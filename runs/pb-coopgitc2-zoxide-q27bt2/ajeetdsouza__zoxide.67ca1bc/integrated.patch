++fn render(shell: &str, base: &str, cmd: &str, hook: &str, no_cmd: bool) -> String {
++    let mut s = base.to_string();
++    if shell == "bash" {
++        if cmd != "z" {
++            s = apply_cmd(&s, cmd);
++        }
++        if hook != "pwd" {
++            s = apply_hook_bash(&s, hook);
++        }
++        if no_cmd {
++            s = apply_no_cmd_bash(&s);
++        }
++    }
++    s
++}
++fn apply_cmd(s: &str, cmd: &str) -> String {
++    let mut s = s.to_string();
++    let zi = format!("{}i", cmd);
++    s = s.replace("\\builtin unalias z ", &format!("\\builtin unalias {cmd} ", cmd = cmd));
++    s = s.replace("function z() {", &format!("function {cmd}() {{", cmd = cmd));
++    s = s.replace("READLINE_LINE=\"z ", &format!("READLINE_LINE=\"{cmd} ", cmd = cmd));
++    s = s.replace("filenames -- z\n", &format!("filenames -- {cmd}\n", cmd = cmd));
++    s = s.replace("\\builtin unalias zi ", &format!("\\builtin unalias {zi} ", zi = zi));
++    s = s.replace("function zi() {", &format!("function {zi}() {{", zi = zi));
++    s = s.replace("complete -r zi ", &format!("complete -r {zi} ", zi = zi));
