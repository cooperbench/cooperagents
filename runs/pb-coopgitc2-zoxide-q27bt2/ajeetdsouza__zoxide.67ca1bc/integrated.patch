++pub fn main(args: &[String]) -> i32 {
++    let bin = bin_name(args);
++    let rest = &args[1..];
++    if rest.is_empty() {
++        eprint!("{}", main_help(&bin));
++        return 2;
++    }
++    // Position of the first non-flag token = the subcommand.
++    let sub_idx = rest.iter().position(|s| !s.starts_with('-'));
++    match sub_idx {
++        None => {
++            // Only flags at the top level.
++            if rest.iter().any(|s| s == "--help" || s == "-h") {
++                print!("{}", main_help(&bin));
++                return 0;
++            }
++            if rest.iter().any(|s| s == "--version" || s == "-V") {
++                print!("{}", main_version());
++                return 0;
++            }
++            eprint!("{}", main_help(&bin));
++            2
++        }
++        Some(idx) => {
++            // Flags before the subcommand belong to the parent command.
++            let before = &rest[..idx];
++            if before.iter().any(|s| s == "--help" || s == "-h") {
++                print!("{}", main_help(&bin));
++                return 0;
++            }
++            if before.iter().any(|s| s == "--version" || s == "-V") {
++                print!("{}", main_version());
++                return 0;
++            }
++            let sub = &rest[idx];
++            dispatch(&bin, sub, rest)
++        }
++    }
++}
