+    println!("    done < <(cat \"${{db}}\" 2>/dev/null)");
+    println!("    if [[ -n \"${{best}}\" ]]; then");
+    println!("        cd \"${{best}}\"");
+    println!("    fi");
+    println!("}}");
+    println!();
+    println!("export PROMPT_COMMAND=\"_zoxide\"");
+    println!("export _ZO_DATA_DIR=\"{}\"", dir);
