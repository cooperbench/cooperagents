+use std::collections::HashMap;
+use std::env;
+use std::fs::{self, File};
+use std::io::{self, BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process;
+
+const VERSION: &str = "0.9.9";
+const DEFAULT_DATA_DIR: &str = "./.zoxide";
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("zoxide {}", VERSION);
+        process::exit(0);
+    }
+    
+    let command = if args.len() > 1 {
+        &args[1]
+    } else {
+        print_help();
+        process::exit(1);
+    };
+    
+    match command.as_str() {
+        "add" => add(&args[2..]),
+        "query" => query(&args[2..]),
+        "remove" => remove(&args[2..]),
+        "init" => init(&args[2..]),
+        "import" => import(&args[2..]),
+        "edit" => edit(),
+        _ => {
+            print_help();
+            process::exit(1);
+        }
+    }
+}
+
+fn print_help() {
+    println!("zoxide {}", VERSION);
+    println!("Ajeet D'Souza <98ajeet@gmail.com>");
+    println!("https://github.com/ajeetdsouza/zoxide");
+    println!();
+    println!("A smarter cd command for your terminal");
+    println!();
+    println!("USAGE:");
+    println!("    zoxide <command> [arguments]");
+    println!();
+    println!("COMMANDS:");
+    println!("    add <path>    Add a directory to the database");
+    println!("    query <query> Query the database for a directory");
+    println!("    remove <path> Remove a directory from the database");
+    println!("    init <shell>  Generate shell init script");
+    println!("    import <file> Import a database from a file");
+    println!("    edit          Edit the database");
+    println!();
+    println!("ENVIRONMENT VARIABLES:");
+    println!("    ZO_DATA_DIR   Directory to store the database (default: ~/.zoxide)");
+    println!("    ZO_DEBUG      Print debug information");
+    println!();
+    println!("EXAMPLES:");
+    println!("    zoxide add /home/user/projects");
+    println!("    zoxide query myproject");
+    println!("    zoxide remove /home/user/projects");
+    println!("    zoxide init bash >> ~/.bashrc");
+}
+
+fn get_data_dir() -> PathBuf {
+    env::var("ZO_DATA_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|_| {
+            let home = env::var("HOME").unwrap_or_else(|_| "/".to_string());
+            PathBuf::from(home).join(DEFAULT_DATA_DIR)
+        })
+}
+
+fn get_db_file() -> PathBuf {
+    get_data_dir().join("db.json")
+}
+
+fn load_db() -> HashMap<String, u64> {
+    let db_path = get_db_file();
+    if !db_path.exists() {
+        return HashMap::new();
+    }
+    
+    let file = File::open(&db_path).unwrap_or_else(|_| {
+        let _ = fs::create_dir_all(get_data_dir());
+        File::create(&db_path).unwrap();
+        File::open(&db_path).unwrap()
+    });
+    
+    let reader = BufReader::new(file);
+    let mut db = HashMap::new();
+    
+    for line in reader.lines() {
+        let line = line.unwrap();
+        if let Some(pos) = line.find(':') {
+            let path = line[..pos].trim().to_string();
+            let score: u64 = line[pos+1..].trim().parse().unwrap_or(0);
+            if !path.is_empty() {
+                db.insert(path, score);
+            }
+        }
+    }
+    
+    db
+}
+
+fn save_db(db: &HashMap<String, u64>) {
+    let db_path = get_db_file();
+    let data_dir = get_data_dir();
+    
+    if let Err(e) = fs::create_dir_all(&data_dir) {
+        eprintln!("Failed to create data directory: {}", e);
+        return;
+    }
+    
+    let mut file = match File::create(&db_path) {
+        Ok(f) => f,
+        Err(e) => {
+            eprintln!("Failed to create database file: {}", e);
+            return;
+        }
+    };
+    
+    for (path, score) in db.iter() {
+        let _ = writeln!(file, "{}:{}", path, score);
+    }
+}
+
+fn add(args: &[String]) {
+    if args.is_empty() {
+        eprintln!("error: missing path");
+        process::exit(1);
+    }
+    
+    let path = &args[0];
+    let path = Path::new(path);
+    
+    if !path.exists() {
+        eprintln!("error: path does not exist: {}", path.display());
+        process::exit(1);
+    }
+    
+    if !path.is_dir() {
+        eprintln!("error: path is not a directory: {}", path.display());
+        process::exit(1);
+    }
+    
+    let db = load_db();
+    
+    let real_path = path.canonicalize().unwrap_or_else(|_| path.to_path_buf());
+    
+    let path_str = real_path.to_string_lossy().to_string();
+    let score = db.get(&path_str).copied().unwrap_or(0) + 1;
+    let mut new_db = db;
+    new_db.insert(path_str, score);
+    
+    save_db(&new_db);
+}
+
+fn query(args: &[String]) {
+    let query = if args.is_empty() {
+        String::new()
+    } else {
+        args[0].clone()
+    };
+    
+    let db = load_db();
+    
+    if db.is_empty() {
+        eprintln!("error: database is empty");
+        process::exit(1);
+    }
+    
+    let query_lower = query.to_lowercase();
+    
+    let mut best: Option<(String, u64)> = None;
+    
+    for (path, score) in db.iter() {
+        let path_lower = path.to_lowercase();
+        if path_lower.contains(&query_lower) {
+            if best.is_none() || *score > best.as_ref().unwrap().1 {
+                best = Some((path.clone(), *score));
+            }
+        }
+    }
+    
+    if let Some((path, _)) = best {
+        println!("{}", path);
+    } else {
+        eprintln!("error: no matching directory found");
+        process::exit(1);
+    }
+}
+
+fn remove(args: &[String]) {
+    if args.is_empty() {
+        eprintln!("error: missing path");
+        process::exit(1);
+    }
+    
+    let path = &args[0];
+    let path = Path::new(path);
+    
+    let mut db = load_db();
+    
+    let real_path = path.canonicalize().unwrap_or_else(|_| path.to_path_buf());
+    let path_str = real_path.to_string_lossy().to_string();
+    
+    if db.remove(&path_str).is_none() {
+        eprintln!("error: path not in database: {}", path.display());
+        process::exit(1);
+    }
+    
+    save_db(&db);
+}
+
+fn import(args: &[String]) {
+    if args.is_empty() {
+        eprintln!("error: missing file");
+        process::exit(1);
+    }
+    
+    let file_path = &args[0];
+    let file_path = Path::new(file_path);
+    
+    if !file_path.exists() {
+        eprintln!("error: file does not exist: {}", file_path.display());
+        process::exit(1);
+    }
+    
+    let mut db = load_db();
+    
+    let file = File::open(file_path).unwrap_or_else(|e| {
+        eprintln!("error: failed to open file: {}", e);
+        process::exit(1);
+    });
+    
+    let reader = BufReader::new(file);
+    
+    for line in reader.lines() {
+        let line = line.unwrap();
+        if let Some(pos) = line.find(':') {
+            let path = line[..pos].trim().to_string();
+            let score: u64 = line[pos+1..].trim().parse().unwrap_or(0);
+            if !path.is_empty() {
+                db.insert(path, score);
+            }
+        }
+    }
+    
+    save_db(&db);
+}
+
+fn edit() {
+    let db_path = get_db_file();
+    if db_path.exists() {
+        let _ = open_db(&db_path);
+    } else {
+        eprintln!("error: database does not exist");
+        process::exit(1);
+    }
+}
+
+fn open_db(path: &Path) -> io::Result<()> {
+    let file = File::open(path)?;
+    let reader = BufReader::new(file);
+    
+    for line in reader.lines() {
+        let line = line?;
+        println!("{}", line);
+    }
+    
+    Ok(())
+}
+
+fn init(args: &[String]) {
+    if args.is_empty() {
+        eprintln!("error: missing shell type");
+        process::exit(1);
+    }
+    
+    let shell = &args[0];
+    
+    match shell.as_str() {
+        "bash" => print_bash_init(),
+        "zsh" => print_zsh_init(),
+        "fish" => print_fish_init(),
+        "powershell" => print_powershell_init(),
+        "elvish" => print_elvish_init(),
+        "nushell" => print_nushell_init(),
+        "posix" => print_posix_init(),
+        _ => {
+            eprintln!("error: unsupported shell: {}", shell);
+            process::exit(1);
+        }
+    }
+}
+
+fn print_bash_init() {
+    let dir = get_data_dir().to_string_lossy().to_string();
+    let db = get_db_file().to_string_lossy().to_string();
+    let version = VERSION;
+    
+    println!("export function _zoxide() {{");
