@@ -0,0 +1,64 @@
+import pty, os, time, select, struct, fcntl, termios
+def log(m):
+    print(f'[{time.time()-t0:6.2f}] {m}', flush=True)
+t0 = time.time()
+pid, fd = pty.fork()
+log(f'forked child pid={pid} fd={fd}')
+if pid == 0:
+    os.execv('/workspace/executable', ['/workspace/executable', '/tmp/walktest'])
+fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, 0, 0))
+os.set_blocking(fd, False)
+out = b''
+sent = False
+hb = 0
+while True:
+    try:
+        r,_,_ = select.select([fd],[],[],0.05)
+    except OSError as ex:
+        log(f'select err {ex}'); break
+    if fd in r:
+        try: d = os.read(fd, 65536)
+        except BlockingIOError: d = b''
+        except OSError as ex:
+            log(f'read err {ex}'); break
+        if d:
+            out += d
+            log(f'read {len(d)} bytes (total {len(out)})')
+    p, st = os.waitpid(pid, os.WNOHANG)
+    if p != 0:
+        log(f'child exited status={st}')
+        break
+    if time.time() - hb > 2.0:
+        hb = time.time()
+        log(f'heartbeat; child alive; out={len(out)}')
+    if time.time() - t0 > 3.0 and not sent:
+        os.write(fd, b'q')
+        sent = True
+        log('sent q')
+        break
+log('--- second phase ---')
+deadline = time.time() + 8
+hb = 0
+while time.time() < deadline:
+    try:
+        r,_,_ = select.select([fd],[],[],0.05)
+    except OSError as ex:
+        log(f'select err {ex}'); break
+    if fd in r:
+        try: d = os.read(fd, 65536)
+        except BlockingIOError: d = b''
+        except OSError as ex:
+            log(f'read err {ex}'); break
+        if d: out += d
+    p, st = os.waitpid(pid, os.WNOHANG)
+    if p != 0:
+        log(f'child exited after q, status={st}')
+        break
+    if time.time() - hb > 2.0:
+        hb = time.time()
+        log(f'heartbeat2; out={len(out)}')
+else:
+    log('still running at deadline, SIGKILL')
+    os.kill(pid, 9)
+open('test_q.bin','wb').write(out)
+log(f'saved {len(out)} bytes')
diff --git a/probe/qtest3.py b/probe/qtest3.py
new file mode 100644
index 0000000..bf8f3e4
--- /dev/null
+++ b/probe/qtest3.py
@@ -0,0 +1,60 @@
+import pty, os, time, select, struct, fcntl, termios
+def log(m): print(f'[{time.time()-t0:6.2f}] {m}', flush=True)
+t0 = time.time()
+pid, fd = pty.fork()
+if pid == 0:
+    os.execv('/workspace/executable', ['/workspace/executable', '/tmp/walktest'])
+fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, 0, 0))
+os.set_blocking(fd, False)
+out = b''
+state = {}
+def drain():
+    global out
+    while True:
+        try: d = os.read(fd, 65536)
+        except BlockingIOError: break
+        except OSError: return False
+        if not d: return False
+        out += d
+    return True
+# phase 1: watch for queries, answer them
+t_last = 0
+while time.time() - t0 < 5:
+    r,_,_ = select.select([fd],[],[],0.02)
+    if fd in r:
+        if not drain(): log('closed early'); break
+        # check for queries in fresh output
+    if b'\x1b[6n' in out and 'dsr' not in state:
+        state['dsr'] = time.time()-t0
+        os.write(fd, b'\x1b[1;1R')
+        log(f'DSR query seen at {state["dsr"]:.2f}, answered')
+    if b'\x1b]11;?' in out and 'osc' not in state:
+        state['osc'] = time.time()-t0
+        os.write(fd, b'\x1b]11;rgb:1e1e/1e1e/1e1e\x1b\\')
+        log(f'OSC11 query seen at {state["osc"]:.2f}, answered')
+    e = time.time()-t0
+    if e - t_last > 1.0:
+        t_last = e
+        log(f'wait; out={len(out)} answered={list(state)}')
+    if len(out) > 47 and 'sent' in state:
+        break
+    if 'sent' not in state and e > 1.0 and 'osc' in state and 'dsr' in state:
+        os.write(fd, b'j'); state['sent'] = e
+        log('sent j after both queries answered')
+# phase 2: collect for a bit then send q
+time.sleep(0.5)
+drain(); log(f'after j: out={len(out)}')
+os.write(fd, b'q')
+log('sent q')
+t_end = time.time() + 6
+while time.time() < t_end:
+    r,_,_ = select.select([fd],[],[],0.02)
+    if fd in r and not drain(): break
+    p, st = os.waitpid(pid, os.WNOHANG)
+    if p != 0:
+        log(f'child exited at {time.time()-t0:.2f}, status={st}')
+        break
+else:
+    log('still running; killing'); os.kill(pid, 9)
+open('test_j.bin','wb').write(out)
+log(f'saved {len(out)} bytes')
diff --git a/probe/screen.py b/probe/screen.py
new file mode 100644
index 0000000..f9b8acb
--- /dev/null
+++ b/probe/screen.py
@@ -0,0 +1,76 @@
+import re
+
+class Screen:
+    def __init__(self, rows=24, cols=80):
+        self.rows, self.cols = rows, cols
+        self.cells = [[' ']*cols for _ in range(rows)]
+        self.x = 0
+        self.y = 0
+    def put(self, ch):
+        if 0 <= self.y < self.rows and 0 <= self.x < self.cols:
+            self.cells[self.y][self.x] = ch
+        self.x += 1
+    def feed(self, data):
+        i = 0
+        while i < len(data):
+            c = data[i]
+            if c == 0x1b and i+1 < len(data) and data[i+1:i+2] == b'[':
+                m = re.match(rb'\[([0-9;?]*)([A-Za-z@])', data[i+1:])
+                if not m:
+                    # OSC? skip
+                    i += 1
+                    continue
+                args, fin = m.group(1).decode(), m.group(2).decode()
+                i += 1 + m.end()
+                self.esc(args, fin)
+            elif c == 0x1b:
+                i += 1  # other escapes (like \x1b\\)
+            elif c == 0x0d:
+                self.x = 0; i += 1
+            elif c == 0x0a:
+                self.y += 1; i += 1
+            elif c == 0x07:
+                i += 1
+            elif c == 0x08:
+                self.x = max(0, self.x-1); i += 1
+            elif 32 <= c < 127:
+                self.put(chr(c)); i += 1
+            else:
+                i += 1
+    def esc(self, args, fin):
+        if fin == 'K':
+            for x in range(self.x, self.cols):
+                self.cells[self.y][x] = ' '
+        elif fin == 'J':
+            pass
+        elif fin == 'D':
+            n = int(args) if args else 1
+            self.x = max(0, self.x - n)
+        elif fin == 'C':
+            n = int(args) if args else 1
+            self.x = min(self.cols-1, self.x + n)
+        elif fin == 'A':
+            n = int(args) if args else 1
+            self.y = max(0, self.y - n)
+        elif fin == 'B':
+            n = int(args) if args else 1
+            self.y = min(self.rows-1, self.y + n)
+        elif fin == 'H' or fin == 'f':
+            pass
+        elif fin == 'm':
+            pass
+    def render(self):
+        out = []
+        for r in self.cells:
+            out.append(''.join(r).rstrip())
+        return '\n'.join(out)
+    def cursor(self):
+        return (self.x, self.y)
+
+def show(data, rows=24, cols=80, label=''):
+    s = Screen(rows, cols)
+    s.feed(data)
+    print(f"=== {label} cursor={s.cursor()} ===")
+    for i, line in enumerate(s.render().split('\n')):
+        print(f"{i:2d}|{line}|")
+    print()
