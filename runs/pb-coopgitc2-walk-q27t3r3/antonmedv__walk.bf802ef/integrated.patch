diff --git a/probe/harness.py b/probe/harness.py
new file mode 100644
index 0000000..af1a79d
--- /dev/null
+++ b/probe/harness.py
@@ -0,0 +1,77 @@
+import os, pty, sys, time, select, struct, fcntl, termios, subprocess
+
+def run(cmd, rows=24, cols=80, pre_input=b"", hold=0.5, steps=None, cwd=None, env=None, name="out"):
+    """Run cmd in a pty. steps: list of (delay, bytes_to_send)."""
+    pid, fd = pty.fork()
+    if pid == 0:
+        if cwd: os.chdir(cwd)
+        e = dict(os.environ)
+        if env:
+            for k, v in env.items():
+                if v is None: del e[k]
+                else: e[k] = v
+        os.execvpe(cmd[0], cmd, e)
+    # set window size
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
+    out = b""
+    t0 = time.time()
+    if pre_input:
+        os.write(fd, pre_input)
+    if steps is None:
+        steps = []
+    next_send = [(hold, None)] + steps
+    idx = 0
+    while True:
+        r, _, _ = select.select([fd], [], [], 0.05)
+        if fd in r:
+            try:
+                data = os.read(fd, 65536)
+            except OSError:
+                break
+            if not data:
+                break
+            out += data
+        # check if child exited
+        p, st = os.waitpid(pid, os.WNOHANG)
+        done = False
+        if p != 0:
+            # drain
+            while True:
+                r, _, _ = select.select([fd], [], [], 0.05)
+                if fd in r:
+                    try:
+                        data = os.read(fd, 65536)
+                    except OSError:
+                        break
+                    if not data: break
+                    out += data
+                else:
+                    break
+            done = True
+        elapsed = time.time() - t0
+        if idx < len(next_send) and elapsed >= next_send[idx][0]:
+            b = next_send[idx][1]
+            if b is not None:
+                os.write(fd, b)
+            idx += 1
+        if done and idx >= len(next_send):
+            break
+        if elapsed > 15:
+            try: os.kill(pid, 9)
+            except: pass
+            break
+    try:
+        os.close(fd)
+    except: pass
+    try:
+        os.waitpid(pid, 0)
+    except: pass
+    return out
+
+if __name__ == "__main__":
+    import json
+    cfg = json.loads(sys.argv[1])
+    out = run(**cfg)
+    with open(cfg["name"], "wb") as f:
+        f.write(out)
+    print(f"Captured {len(out)} bytes -> {cfg['name']}")
