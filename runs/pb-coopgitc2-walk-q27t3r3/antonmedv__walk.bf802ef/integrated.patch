diff --git a/probe/conv.py b/probe/conv.py
new file mode 100644
index 0000000..0a3140a
--- /dev/null
+++ b/probe/conv.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Conversational pty capture.
+usage: conv.py <tag> <start_dir> <width> <height> [base64:delay;...]
+events sorted by delay; delays absolute (seconds from start).
+"""
+import pty, os, time, select, struct, fcntl, termios, sys, base64
+def log(m): print(f'[{time.time()-t0:6.2f}] {m}', flush=True)
+t0 = time.time()
+tag = sys.argv[1]
+startdir = sys.argv[2]
+W, H = int(sys.argv[3]), int(sys.argv[4])
+events = []
+if len(sys.argv) > 5:
+    for ev in sys.argv[5].split(';'):
+        if not ev: continue
+        b, d = ev.split(':')
+        events.append((float(d), base64.b64decode(b)))
+events.sort()
+pid, fd = pty.fork()
+if pid == 0:
+    os.execv('/workspace/executable', ['/workspace/executable', startdir])
+fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', H, W, 0, 0))
+os.set_blocking(fd, False)
+out = b''
+def drain():
+    global out
+    while True:
+        try: d = os.read(fd, 65536)
+        except BlockingIOError: break
+        except OSError: return False
+        if not d: return False
+        out += d
+    return True
+answered = False
+next_ev = 0
+exit_wait = 0
+while True:
+    r,_,_ = select.select([fd],[],[],0.02)
+    if fd in r and not drain():
+        log('pty closed'); break
+    if not answered and b'\x1b[6n' in out and b'\x1b]11;?' in out and time.time()-t0 > 0.2:
+        answered = True
+        os.write(fd, b'\x1b[1;1R')
+        os.write(fd, b'\x1b]11;rgb:1e1e/1e1e/1e1e\x1b\\')
+        log(f'answered @ {time.time()-t0:.2f}')
+    while next_ev < len(events) and time.time()-t0 >= events[next_ev][0]:
+        d, b = events[next_ev]
+        os.write(fd, b)
+        log(f'sent {b!r} @ {time.time()-t0:.2f}')
+        next_ev += 1
+    p, st = os.waitpid(pid, os.WNOHANG)
+    if p != 0:
+        log(f'child exited @ {time.time()-t0:.2f} status={st}')
+        exit_wait = 1.0
+        break
+    if time.time() - t0 > 20:
+        log('timeout; kill'); os.kill(pid, 9); break
+time.sleep(0.2); drain()
+p, st = os.waitpid(pid, os.WNOHANG)
+if p == 0:
+    try: p, st = os.waitpid(pid, 0)
+    except ChildProcessError: pass
+log(f'final pid={p} status={st}')
+open(f'conv_{tag}.bin','wb').write(out)
+log(f'saved conv_{tag}.bin ({len(out)}B)')
