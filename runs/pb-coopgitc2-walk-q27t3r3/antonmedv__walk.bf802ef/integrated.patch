+echo "script" > run.sh && chmod +x run.sh
+ln -s file1.txt link.txt
+mkfifo pipe1 2>/dev/null
+echo "hidden" > .dotfile
+touch -d "2020-01-02 03:04:05" file1.txt
+touch -d "2021-06-07 08:09:10" sub1
