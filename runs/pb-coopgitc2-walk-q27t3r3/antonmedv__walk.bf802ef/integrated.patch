new file mode 100644
index 0000000..dc6bbc6
--- /dev/null
+++ b/probe/qtest.py
@@ -0,0 +1,43 @@
+import pty, os, time, select, struct, fcntl, termios, sys
+def log(m): print(m, flush=True)
+t0 = time.time()
+pid, fd = pty.fork()
+if pid == 0:
+    os.execv('/workspace/executable', ['/workspace/executable', '/tmp/walktest'])
+fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, 0, 0))
+os.set_blocking(fd, False)
+out = b''
+sent = False
+while True:
+    r,_,_ = select.select([fd],[],[],0.05)
+    if fd in r:
+        try: d = os.read(fd, 65536)
+        except BlockingIOError: d = b''
+        except OSError: break
+        if d: out += d
+    p, st = os.waitpid(pid, os.WNOHANG)
+    if p != 0:
+        log(f'CHILD EXITED at {time.time()-t0:.2f}s')
+        break
+    e = time.time()-t0
+    if e > 2.0 and not sent:
+        os.write(fd, b'q')
+        sent = True
+        log(f'sent q at {e:.2f}s')
+deadline = time.time() + 10
+while time.time() < deadline:
+    r,_,_ = select.select([fd],[],[],0.05)
+    if fd in r:
+        try: d = os.read(fd, 65536)
+        except BlockingIOError: d = b''
+        except OSError: break
+        if d: out += d
+    p, st = os.waitpid(pid, os.WNOHANG)
+    if p != 0:
+        log(f'EXITED after q at {time.time()-t0:.2f}s')
+        break
+else:
+    log('STILL RUNNING after 10s, killing')
+    os.kill(pid, 9)
+open('test_q.bin','wb').write(out)
+log(f'bytes: {len(out)}')
