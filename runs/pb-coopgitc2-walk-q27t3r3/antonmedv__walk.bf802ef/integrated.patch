diff --git a/probe/batch.py b/probe/batch.py
new file mode 100644
index 0000000..67d1c48
--- /dev/null
+++ b/probe/batch.py
@@ -0,0 +1,50 @@
+import harness, time, os, json, sys
+
+ENV = dict(EDITOR='/bin/true')
+
+def T(cmd, steps, rows=24, cols=80, name=None, cwd='/tmp/walktest', env=None, pre=b''):
+    e = dict(ENV)
+    if env: e.update(env)
+    return harness.run(cmd=cmd, rows=rows, cols=cols, steps=steps, cwd=cwd, env=e, name=name or 'x')
+
+scenarios = [
+    # name, args, steps (delay, bytes), kwargs
+    ("nav",   [],          [(0.5, b'j'), (0.4, b'j'), (0.4, b'k'), (0.4, b'l'), (0.4, b'h'), (0.4, b'q')]),
+    ("enter_dir", [],      [(0.5, b'j'), (0.5, b'\r'), (0.5, b'q')]),
+    ("enter_file", [],     [(0.5, b'\r'), (0.7, b'q')]),
+    ("backspace", [],      [(0.5, b'\x7f'), (0.5, b'q')]),
+    ("wsize_100x30", [],    [(0.8, b'q')], dict(rows=30, cols=100)),
+    ("wsize_40x10", [],     [(0.8, b'q')], dict(rows=10, cols=40)),
+    ("wsize_200x50", [],    [(0.8, b'q')], dict(rows=50, cols=200)),
+    ("wsize_15x5", [],      [(0.8, b'q')], dict(rows=5, cols=15)),
+    ("dot",    [],          [(0.5, b'.'), (0.5, b'.'), (0.5, b'q')]),
+    ("fuzzy",  [],          [(0.5, b'/'), (0.5, b'fil'), (0.3, b'x'), (0.4, b'q')]),
+    ("fuzzy_enter", [],     [(0.5, b'/'), (0.5, b'fil'), (0.4, b'\r'), (0.6, b'q')]),
+    ("space_preview", [],   [(0.5, b' '), (0.6, b'q')]),
+    ("help",   [],          [(0.5, b'?'), (0.5, b'q')]),
+    ("yank",   [],          [(0.5, b'y'), (0.6, b'q')]),
+    ("del",    [],          [(0.5, b'd'), (0.5, b'y'), (0.6, b'q')]),
+    ("undo",   [],          [(0.5, b'd'), (0.5, b'u'), (0.6, b'q')]),
+    ("ctrlc",  [],          [(0.5, b'\x03'), (0.5, None)]),
+    ("esc",    [],          [(0.5, b'\x1b'), (0.5, None)]),
+    ("icons",  ["--icons"], [(0.8, b'q')]),
+    ("dir_only", ["--dir-only"], [(0.8, b'q')]),
+    ("hide_hidden", ["--hide-hidden"], [(0.8, b'q')]),
+    ("preview_on", ["--preview"], [(0.8, b'q')]),
+    ("preview_border", ["--with-border","--preview"], [(0.8, b'q')]),
+    ("fuzzy_start", ["--fuzzy"], [(0.8, b'q')]),
+    ("main_color", [], [(0.8, b'q')], dict(env=dict(WALK_MAIN_COLOR='#ff0000'))),
+    ("statusbar", [], [(0.8, b'q')], dict(env=dict(WALK_STATUS_BAR='[Mode(), Size() | PadLeft(7), ModTime() | PadLeft(12)] | join(" ")'))),
+]
+
+os.makedirs('caps', exist_ok=True)
+for name, args, steps, *kw in scenarios:
+    kwargs = kw[0] if kw else {}
+    try:
+        out = T(['/workspace/executable'] + args, steps, **kwargs)
+    except Exception as ex:
+        print(f"{name}: ERROR {ex}")
+        continue
+    fn = f'caps/{name}.bin'
+    open(fn, 'wb').write(out)
+    print(f"{name}: {len(out)} bytes")
