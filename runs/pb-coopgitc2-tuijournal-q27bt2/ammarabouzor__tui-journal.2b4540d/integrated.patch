+use clap::{Arg, ArgAction, Command};
+use std::env;
+use std::path::PathBuf;
+use std::process::exit;
+
+// ===== Default themes (115 lines). `print-default` adds one trailing newline (116th blank line). =====
+const DEFAULT_THEMES: &str = r##"[general.input_block_active]
+fg = "LightYellow"
+modifiers = ""
+
+[general.input_block_invalid]
+fg = "LightRed"
+modifiers = ""
+
+[general.input_corsur_active]
+fg = "Black"
+bg = "LightYellow"
+modifiers = ""
+
+[general.input_corsur_invalid]
+fg = "Black"
+bg = "LightRed"
+modifiers = ""
+
+[general.list_item_selected]
+fg = "LightYellow"
+modifiers = "BOLD"
+
+[general.list_highlight_active]
+fg = "Black"
+bg = "LightGreen"
+modifiers = ""
+
+[general.list_highlight_inactive]
+fg = "Black"
+bg = "LightBlue"
+modifiers = ""
+
+[journals_list.block_active]
+fg = "Reset"
+modifiers = "BOLD"
+
+[journals_list.block_inactive]
+fg = "#AAAAC8"
+modifiers = ""
+
+[journals_list.block_multi_select]
+fg = "Yellow"
+modifiers = "BOLD | ITALIC"
+
+[journals_list.highlight_active]
+fg = "Black"
+bg = "LightGreen"
+modifiers = "BOLD"
+
+[journals_list.highlight_inactive]
+fg = "Black"
+bg = "LightBlue"
+modifiers = "BOLD"
+
+[journals_list.title_active]
+fg = "Reset"
+modifiers = "BOLD"
+
+[journals_list.title_inactive]
+fg = "#AAAAC8"
+modifiers = "BOLD"
+
+[journals_list.title_selected]
+fg = "Yellow"
+modifiers = "BOLD"
+
+[journals_list.date_priority]
+fg = "LightBlue"
+modifiers = ""
+
+[journals_list.tags_default]
+fg = "LightCyan"
+modifiers = "DIM"
+
+[editor.block_insert]
+fg = "LightGreen"
+modifiers = "BOLD"
+
+[editor.block_visual]
+fg = "Blue"
+modifiers = "BOLD"
+
+[editor.block_normal_active]
+fg = "Reset"
+modifiers = "BOLD"
+
+[editor.block_normal_inactive]
+fg = "#AAAAC8"
+modifiers = ""
+
+[editor.cursor_normal]
+fg = "Black"
+bg = "White"
+modifiers = ""
+
+[editor.cursor_insert]
+fg = "Black"
+bg = "LightGreen"
+modifiers = ""
+
+[editor.cursor_visual]
+fg = "Black"
+bg = "Blue"
+modifiers = ""
+
+[editor.selection_style]
+fg = "Black"
+bg = "White"
+modifiers = ""
+
+[msgbox]
+error = "LightRed"
+warning = "Yellow"
+info = "LightGreen"
+question = "LightBlue"
+"##;
+
+// ===== Config =====
+#[derive(Default)]
+struct Config {
+    backend_type: String, // "Json" | "Sqlite"
+    scroll_per_page: u32,
+    sync_os_clipboard: bool,
+    history_limit: u32,
+    colored_tags: bool,
+    datum_visibility: String,
+    app_state_dir: String,
+    export_show_confirmation: bool,
+    ee_auto_save: bool,
+    ee_temp_file_extension: String,
+    json_file_path: String,
+    sqlite_file_path: String,
+}
+
+// Partial config parsed from a TOML file (all fields optional so missing -> keep default)
+#[derive(serde::Deserialize, Default)]
+struct FileExport {
+    #[serde(default)]
+    show_confirmation: Option<bool>,
+}
+#[derive(serde::Deserialize, Default)]
+struct FileExternalEditor {
+    #[serde(default)]
+    auto_save: Option<bool>,
+    #[serde(default)]
+    temp_file_extension: Option<String>,
+}
+#[derive(serde::Deserialize, Default)]
+struct FileBackend {
+    #[serde(default)]
+    file_path: Option<String>,
+}
+#[derive(serde::Deserialize, Default)]
+struct FileConfig {
+    #[serde(default)]
+    backend_type: Option<String>,
+    #[serde(default)]
+    scroll_per_page: Option<u32>,
+    #[serde(default)]
+    sync_os_clipboard: Option<bool>,
+    #[serde(default)]
+    history_limit: Option<u32>,
+    #[serde(default)]
+    colored_tags: Option<bool>,
+    #[serde(default)]
+    datum_visibility: Option<String>,
+    #[serde(default)]
+    app_state_dir: Option<String>,
+    #[serde(default)]
+    export: FileExport,
+    #[serde(default)]
+    external_editor: FileExternalEditor,
+    #[serde(default)]
+    json_backend: FileBackend,
+    #[serde(default)]
+    sqlite_backend: FileBackend,
+}
+
+fn home_dir() -> PathBuf {
+    env::var("HOME")
+        .map(PathBuf::from)
+        .unwrap_or_else(|_| PathBuf::from("/home/agent"))
+}
+fn xdg(var: &str, fallback: &str) -> PathBuf {
+    match env::var(var) {
+        Ok(v) if !v.is_empty() => PathBuf::from(v),
+        _ => home_dir().join(fallback),
+    }
+}
+
+fn build_cli(config_default_dir: &str, log_default_path: &str) -> Command {
+    let config_help = format!(
+        "Specifies the path for the configuration directory.\nConfiguration files is considered as root for themes file too.\nIt still accepts the path for configuration file for backward compatibility.\n(default path: {config_default_dir})"
+    );
+    let log_help = format!(
+        "Specifies a file to use for logging\n(default file: {log_default_path})"
+    );
+
+    let print_config = Command::new("print-config")
+        .visible_alias("pc")
+        .about("Print the current settings including the paths for the back-end files")
+        .arg(
+            Arg::new("help")
+                .short('h')
+                .long("help")
+                .action(ArgAction::SetTrue)
+                .help("Print help"),
+        );
+
+    let import_journals = Command::new("import-journals")
+        .visible_alias("imj")
+        .about("Import journals from the given transfer JSON file to the current back-end file")
+        .arg(
+            Arg::new("path")
+                .short('p')
+                .long("path")
+                .value_name("FILE PATH")
+                .required(true)
+                .help("Path of the JSON file to import from"),
+        )
+        .arg(
+            Arg::new("help")
+                .short('h')
+                .long("help")
+                .action(ArgAction::SetTrue)
+                .help("Print help"),
+        );
+
+    let assign_priority = Command::new("assign-priority")
+        .visible_alias("ap")
+        .about("Assign priority for all the entries with empty priority field")
+        .arg(
+            Arg::new("priority")
+                .value_name("PRIORITY")
+                .required(true)
+                .value_parser(clap::value_parser!(String))
+                .help("Priority value (Positive number)"),
+        )
+        .arg(
+            Arg::new("help")
+                .short('h')
+                .long("help")
+                .action(ArgAction::SetTrue)
+                .help("Print help"),
+        );
+
+    let theme = Command::new("theme")
+        .visible_alias("style")
+        .subcommand_required(true)
+        .arg_required_else_help(true)
+        .about("Provides commands regarding changing themes and styles of the app")
+        .subcommand(
+            Command::new("print-path")
+                .visible_alias("path")
+                .about("Prints the path to the user themes file")
+                .arg(
+                    Arg::new("help")
+                        .short('h')
+                        .long("help")
+                        .action(ArgAction::SetTrue)
+                        .help("Print help"),
+                ),
+        )
+        .subcommand(
+            Command::new("print-default")
+                .visible_alias("default")
+                .about(
+                    "Dumps the styles with the default values to be used as a reference and base for user custom themes",
+                )
+                .arg(
+                    Arg::new("help")
+                        .short('h')
+                        .long("help")
+                        .action(ArgAction::SetTrue)
+                        .help("Print help"),
+                ),
+        )
+        .subcommand(
+            Command::new("write-defaults")
+                .visible_alias("write")
+                .about("Creates user custom themes file if doesn't exist then writes the default styles to it")
+                .arg(
+                    Arg::new("help")
+                        .short('h')
+                        .long("help")
+                        .action(ArgAction::SetTrue)
+                        .help("Print help"),
+                ),
+        );
+
+    Command::new("tui-journal")
+        .version("0.16.1")
+        .about(
+            "Tui app allows writing and managing journals/notes from within the terminal With different local back-ends",
+        )
+        .arg(
+            Arg::new("json_file_path")
+                .short('j')
+                .long("json-file-path")
+                .value_name("FILE PATH")
+                .help("Sets the entries Json file path and starts using it"),
+        )
+        .arg(
+            Arg::new("sqlite_file_path")
+                .short('s')
+                .long("sqlite-file-path")
+                .value_name("FILE PATH")
+                .help("Sets the entries sqlite file path and starts using it"),
+        )
+        .arg(
+            Arg::new("backend_type")
+                .short('b')
+                .long("backend-type")
+                .value_name("BACKEND_TYPE")
+                .value_parser(["json", "sqlite"])
+                .help("Sets the backend type and starts using it"),
+        )
+        .arg(
+            Arg::new("config")
+                .short('c')
+                .long("config")
+                .value_name("DIR PATH")
+                .value_parser(clap::builder::NonEmptyStringValueParser::new())
+                .help(config_help),
+        )
+        .arg(
+            Arg::new("verbose")
+                .short('v')
+                .long("verbose")
+                .action(ArgAction::Count)
+                .help("Increases logging verbosity each use for up to 3 times"),
+        )
+        .arg(
+            Arg::new("log")
+                .short('l')
+                .long("log")
+                .value_name("FILE PATH")
+                .help(log_help),
+        )
+        .subcommand(print_config)
+        .subcommand(import_journals)
+        .subcommand(assign_priority)
+        .subcommand(theme)
+}
+
+fn main() {
+    let home = home_dir();
+    // default base paths (used for help text and defaults)
+    let default_config_dir = xdg("XDG_CONFIG_HOME", ".config").join("tui-journal");
+    let state_dir = xdg("XDG_STATE_HOME", ".local/state").join("tui-journal");
+    let cache_dir = xdg("XDG_CACHE_HOME", ".cache").join("tui-journal");
+    let default_log_path = cache_dir.join("tui-journal.log");
+
+    let matches = build_cli(
+        default_config_dir.to_string_lossy().as_ref(),
+        default_log_path.to_string_lossy().as_ref(),
+    )
+    .get_matches();
+
+    let cli_config = matches
+        .get_one::<String>("config")
+        .map(|s| s.as_str());
+
+    // ---- resolve config dir / config file (handles the -c "doesn't exit" check) ----
+    // config_dir used for themes; config_file optionally loaded
+    let (config_dir, config_file) = match cli_config {
+        Some(c) => {
+            let p = PathBuf::from(c);
+            if p.is_file() {
+                (default_config_dir.clone(), Some(p))
+            } else {
+                (p.clone(), None)
+            }
+        }
+        None => (default_config_dir.clone(), None),
+    };
+
+    // ---- load config (defaults, then file, then flags) ----
+    let mut cfg = Config {
+        backend_type: "Sqlite".to_string(),
+        scroll_per_page: 5,
+        sync_os_clipboard: false,
+        history_limit: 10,
+        colored_tags: true,
+        datum_visibility: "show".to_string(),
+        app_state_dir: state_dir.to_string_lossy().into_owned(),
+        export_show_confirmation: true,
+        ee_auto_save: false,
+        ee_temp_file_extension: "txt".to_string(),
+        json_file_path: home.join("tui-journal").join("entries.json").to_string_lossy().into_owned(),
+        sqlite_file_path: home.join("tui-journal").join("entries.db").to_string_lossy().into_owned(),
+    };
+
+    // apply config file (if -c is a file)
+    if let Some(cf) = &config_file {
+        if let Ok(text) = std::fs::read_to_string(cf) {
+            if let Ok(fc) = toml::from_str::<FileConfig>(&text) {
+                if let Some(v) = fc.backend_type {
+                    cfg.backend_type = v;
+                }
+                if let Some(v) = fc.scroll_per_page {
+                    cfg.scroll_per_page = v;
+                }
+                if let Some(v) = fc.sync_os_clipboard {
+                    cfg.sync_os_clipboard = v;
+                }
+                if let Some(v) = fc.history_limit {
+                    cfg.history_limit = v;
+                }
+                if let Some(v) = fc.colored_tags {
+                    cfg.colored_tags = v;
+                }
+                if let Some(v) = fc.datum_visibility {
+                    cfg.datum_visibility = v;
+                }
+                if let Some(v) = fc.app_state_dir {
+                    cfg.app_state_dir = v;
+                }
+                if let Some(v) = fc.export.show_confirmation {
+                    cfg.export_show_confirmation = v;
+                }
+                if let Some(v) = fc.external_editor.auto_save {
+                    cfg.ee_auto_save = v;
+                }
+                if let Some(v) = fc.external_editor.temp_file_extension {
+                    cfg.ee_temp_file_extension = v;
+                }
+                if let Some(v) = fc.json_backend.file_path {
+                    cfg.json_file_path = v;
+                }
+                if let Some(v) = fc.sqlite_backend.file_path {
+                    cfg.sqlite_file_path = v;
+                }
+            }
+        }
+    }
+
+    // apply flag overrides (-j/-s/-b)
+    let json_flag = matches.get_one::<String>("json_file_path").map(|s| s.clone());
+    let sqlite_flag = matches.get_one::<String>("sqlite_file_path").map(|s| s.clone());
+    let backend_flag = matches.get_one::<String>("backend_type").map(|s| s.to_lowercase());
+
+    if let Some(p) = &json_flag {
+        cfg.json_file_path = p.clone();
+    }
+    if let Some(p) = &sqlite_flag {
+        cfg.sqlite_file_path = p.clone();
+    }
+    if let Some(b) = &backend_flag {
+        cfg.backend_type = if b == "json" { "Json" } else { "Sqlite" }.to_string();
+    }
+
+    // ---- dispatch ----
+    let cmd = matches.subcommand();
+
+    match cmd {
+        Some(("print-config", _m)) => {
+            print_config(&cfg);
+        }
+        Some(("theme", tm)) => {
+            let sub = tm.subcommand();
+            match sub {
+                Some(("print-path", _)) => {
+                    let themes = config_dir.join("themes.toml");
+                    println!("{}", themes.to_string_lossy());
+                }
+                Some(("print-default", _)) => {
+                    // 116 lines: content + one extra trailing newline
+                    print!("{DEFAULT_THEMES}");
+                    println!();
+                }
+                Some(("write-defaults", _)) => {
+                    let themes = config_dir.join("themes.toml");
+                    if themes.exists() {
+                        eprintln!(
+                            "Error: Themes file already exists. Path: {}",
+                            themes.to_string_lossy()
+                        );
+                        exit(1);
+                    }
+                    match std::fs::write(&themes, DEFAULT_THEMES) {
+                        Ok(_) => {
+                            println!(
+                                "Default themes have been written to {}",
+                                themes.to_string_lossy()
+                            );
+                        }
+                        Err(e) => {
+                            eprintln!("Error: {e}");
+                            exit(1);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        // No subcommand, or TUI-launching commands (import-journals, assign-priority):
+        // try to enter raw mode; failure (e.g. no TTY) => the observed error and exit 1.
+        _ => {
+            if let Err(e) = crossterm::terminal::enable_raw_mode() {
+                eprintln!("Error: {e}");
+                exit(1);
+            }
+            let _ = crossterm::terminal::disable_raw_mode();
+            exit(0);
+        }
+    }
+}
+
+fn print_config(cfg: &Config) {
+    let mut s = String::new();
+    s.push_str(&format!("backend_type = \"{}\"\n", cfg.backend_type));
+    s.push_str(&format!("scroll_per_page = {}\n", cfg.scroll_per_page));
+    s.push_str(&format!("sync_os_clipboard = {}\n", cfg.sync_os_clipboard));
+    s.push_str(&format!("history_limit = {}\n", cfg.history_limit));
+    s.push_str(&format!("colored_tags = {}\n", cfg.colored_tags));
+    s.push_str(&format!("datum_visibility = \"{}\"\n", cfg.datum_visibility));
+    s.push_str(&format!("app_state_dir = \"{}\"\n", cfg.app_state_dir));
+    s.push_str("\n");
+    s.push_str("[export]\n");
+    s.push_str(&format!("show_confirmation = {}\n", cfg.export_show_confirmation));
+    s.push_str("\n");
+    s.push_str("[external_editor]\n");
+    s.push_str(&format!("auto_save = {}\n", cfg.ee_auto_save));
+    s.push_str(&format!("temp_file_extension = \"{}\"\n", cfg.ee_temp_file_extension));
+    s.push_str("\n");
+    s.push_str("[json_backend]\n");
+    s.push_str(&format!("file_path = \"{}\"\n", cfg.json_file_path));
+    s.push_str("\n");
+    s.push_str("[sqlite_backend]\n");
+    s.push_str(&format!("file_path = \"{}\"\n", cfg.sqlite_file_path));
+    print!("{s}\n");
+}
