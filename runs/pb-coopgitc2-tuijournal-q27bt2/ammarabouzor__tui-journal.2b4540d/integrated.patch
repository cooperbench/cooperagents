diff --git a/Cargo.toml b/Cargo.toml
new file mode 100644
index 0000000..b773b02
--- /dev/null
+++ b/Cargo.toml
@@ -0,0 +1,18 @@
+[package]
+name = "tui-journal"
+version = "0.16.1"
+edition = "2021"
+description = "Tui app allows writing and managing journals/notes from within the terminal With different local back-ends"
+
+[[bin]]
+name = "tui-journal"
+path = "src/main.rs"
+
+[dependencies]
+clap = "4.6.1"
+crossterm = "0.29.0"
+serde = { version = "1.0.228", features = ["derive"] }
+toml = "1.1.2"
+
+[profile.release]
+opt-level = 3
diff --git a/compile.sh b/compile.sh
new file mode 100755
index 0000000..920e6fc
--- /dev/null
+++ b/compile.sh
@@ -0,0 +1,8 @@
+#!/bin/bash
+set -e
+cd "$(dirname "$0")"
+cargo build --release --offline 2>&1 | tail -5
+# ./executable may be root-owned and not directly overwritable; the directory is
+# writable, so unlink first (works as agent or root) then copy the fresh binary.
+rm -f ./executable
+cp target/release/tui-journal ./executable
