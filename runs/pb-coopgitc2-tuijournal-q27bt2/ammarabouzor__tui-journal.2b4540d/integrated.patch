new file mode 100644
index 0000000..2eecc80
--- /dev/null
+++ b/tjournal_src/src/main.rs
@@ -0,0 +1,354 @@
+use std::path::{Path, PathBuf};
+use anyhow::Result;
+use clap::{Arg, ArgAction, Command};
+use clap::builder::ValueParser;
+use serde::Serialize;
+
+// ---------------- Color / Theme model (serialized with toml::to_string) ----------------
+#[derive(Serialize)]
+struct ColorStyle {
+    fg: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    bg: Option<String>,
+    modifiers: String,
+}
+fn c(fg: &str, bg: Option<&str>, mods: &str) -> ColorStyle {
+    ColorStyle { fg: fg.into(), bg: bg.map(|s| s.into()), modifiers: mods.into() }
+}
+#[derive(Serialize)]
+struct General {
+    input_block_active: ColorStyle,
+    input_block_invalid: ColorStyle,
+    input_corsur_active: ColorStyle,
+    input_corsur_invalid: ColorStyle,
+    list_item_selected: ColorStyle,
+    list_highlight_active: ColorStyle,
+    list_highlight_inactive: ColorStyle,
+}
+#[derive(Serialize)]
+struct JournalsList {
+    block_active: ColorStyle,
+    block_inactive: ColorStyle,
+    block_multi_select: ColorStyle,
+    highlight_active: ColorStyle,
+    highlight_inactive: ColorStyle,
+    title_active: ColorStyle,
+    title_inactive: ColorStyle,
+    title_selected: ColorStyle,
+    date_priority: ColorStyle,
+    tags_default: ColorStyle,
+}
+#[derive(Serialize)]
+struct Editor {
+    block_insert: ColorStyle,
+    block_visual: ColorStyle,
+    block_normal_active: ColorStyle,
+    block_normal_inactive: ColorStyle,
+    cursor_normal: ColorStyle,
+    cursor_insert: ColorStyle,
+    cursor_visual: ColorStyle,
+    selection_style: ColorStyle,
+}
+#[derive(Serialize)]
+struct Msgbox {
+    error: String,
+    warning: String,
+    info: String,
+    question: String,
+}
+#[derive(Serialize)]
+struct Theme {
+    general: General,
+    journals_list: JournalsList,
+    editor: Editor,
+    msgbox: Msgbox,
+}
+fn default_theme() -> Theme {
+    Theme {
+        general: General {
+            input_block_active: c("LightYellow", None, ""),
+            input_block_invalid: c("LightRed", None, ""),
+            input_corsur_active: c("Black", Some("LightYellow"), ""),
+            input_corsur_invalid: c("Black", Some("LightRed"), ""),
+            list_item_selected: c("LightYellow", None, "BOLD"),
+            list_highlight_active: c("Black", Some("LightGreen"), ""),
+            list_highlight_inactive: c("Black", Some("LightBlue"), ""),
+        },
+        journals_list: JournalsList {
+            block_active: c("Reset", None, "BOLD"),
+            block_inactive: c("#AAAAC8", None, ""),
+            block_multi_select: c("Yellow", None, "BOLD | ITALIC"),
+            highlight_active: c("Black", Some("LightGreen"), "BOLD"),
+            highlight_inactive: c("Black", Some("LightBlue"), "BOLD"),
+            title_active: c("Reset", None, "BOLD"),
+            title_inactive: c("#AAAAC8", None, "BOLD"),
+            title_selected: c("Yellow", None, "BOLD"),
+            date_priority: c("LightBlue", None, ""),
+            tags_default: c("LightCyan", None, "DIM"),
+        },
+        editor: Editor {
+            block_insert: c("LightGreen", None, "BOLD"),
+            block_visual: c("Blue", None, "BOLD"),
+            block_normal_active: c("Reset", None, "BOLD"),
+            block_normal_inactive: c("#AAAAC8", None, ""),
+            cursor_normal: c("Black", Some("White"), ""),
+            cursor_insert: c("Black", Some("LightGreen"), ""),
+            cursor_visual: c("Black", Some("Blue"), ""),
+            selection_style: c("Black", Some("White"), ""),
+        },
+        msgbox: Msgbox {
+            error: "LightRed".into(),
+            warning: "Yellow".into(),
+            info: "LightGreen".into(),
+            question: "LightBlue".into(),
+        },
+    }
+}
+
+// ---------------- Config model ----------------
+#[derive(Serialize)]
+struct Config {
+    backend_type: String,
+    scroll_per_page: u8,
+    sync_os_clipboard: bool,
+    history_limit: u8,
+    colored_tags: bool,
+    datum_visibility: String,
+    app_state_dir: String,
+    export: Export,
+    external_editor: ExternalEditor,
+    json_backend: JsonBackend,
+    sqlite_backend: SqliteBackend,
+}
+#[derive(Serialize)]
+struct Export {
+    show_confirmation: bool,
+}
+#[derive(Serialize)]
+struct ExternalEditor {
+    auto_save: bool,
+    temp_file_extension: String,
+}
+#[derive(Serialize)]
+struct JsonBackend {
+    file_path: String,
+}
+#[derive(Serialize)]
+struct SqliteBackend {
+    file_path: String,
+}
+
+fn home_dir() -> PathBuf {
+    dirs::home_dir().unwrap_or_else(|| PathBuf::from("/home/agent"))
+}
+fn default_config_dir() -> PathBuf {
+    dirs::config_dir().unwrap_or_else(|| PathBuf::from("/home/agent/.config")).join("tui-journal")
+}
+fn state_dir() -> PathBuf {
+    dirs::state_dir().map(|p| p.join("tui-journal"))
+        .unwrap_or_else(|| PathBuf::from("/home/agent/.local/state/tui-journal"))
+}
+fn app() -> PathBuf {
+    home_dir().join("tui-journal")
+}
+
+fn default_config() -> Config {
+    let app = app();
+    Config {
+        backend_type: "Sqlite".into(),
+        scroll_per_page: 5,
+        sync_os_clipboard: false,
+        history_limit: 10,
+        colored_tags: true,
+        datum_visibility: "show".into(),
+        app_state_dir: state_dir().to_string_lossy().into(),
+        export: Export { show_confirmation: true },
+        external_editor: ExternalEditor { auto_save: false, temp_file_extension: "txt".into() },
+        json_backend: JsonBackend { file_path: app.join("entries.json").to_string_lossy().into() },
+        sqlite_backend: SqliteBackend { file_path: app.join("entries.db").to_string_lossy().into() },
+    }
+}
+
+// ---------------- CLI ----------------
+fn build_cli() -> Command {
+    let json_file_path = Arg::new("json-file-path")
+        .short('j')
+        .long("json-file-path")
+        .value_name("FILE PATH")
+        .help("Sets the entries Json file path and starts using it")
+        .action(ArgAction::Set)
+        .value_parser(ValueParser::path_buf())
+        ;
+    let sqlite_file_path = Arg::new("sqlite-file-path")
+        .short('s')
+        .long("sqlite-file-path")
+        .value_name("FILE PATH")
+        .help("Sets the entries sqlite file path and starts using it")
+        .action(ArgAction::Set)
+        .value_parser(ValueParser::path_buf())
+        ;
+    let backend_type = Arg::new("backend-type")
+        .short('b')
+        .long("backend-type")
+        .value_name("BACKEND_TYPE")
+        .help("Sets the backend type and starts using it")
+        .action(ArgAction::Set)
+        .value_parser(ValueParser::from(vec!["json", "sqlite"]));
+    let config = Arg::new("config")
+        .short('c')
+        .long("config")
+        .value_name("DIR PATH")
+        .help("Specifies the path for the configuration directory.\n\
+Configuration files is considered as root for themes file too.\n\
+It still accepts the path for configuration file for backward compatibility.\n\
+(default path: /home/agent/.config/tui-journal)")
+        .action(ArgAction::Set)
+        .value_parser(ValueParser::path_buf())
+        ;
+    let verbose = Arg::new("verbose")
+        .short('v')
+        .long("verbose")
+        .help("Increases logging verbosity each use for up to 3 times")
+        .action(ArgAction::Count);
+    let log = Arg::new("log")
+        .short('l')
+        .long("log")
+        .value_name("FILE PATH")
+        .help("Specifies a file to use for logging\n\
+(default file: /home/agent/.cache/tui-journal/tui-journal.log)")
+        .action(ArgAction::Set)
+        .value_parser(ValueParser::path_buf())
+        ;
+
+    let print_config = Command::new("print-config")
+        .visible_alias("pc")
+        .about("Print the current settings including the paths for the back-end files")
+        .arg(Arg::new("help").short('h').long("help").help("Print help").action(ArgAction::SetTrue));
+
+    let import_journals = Command::new("import-journals")
+        .visible_alias("imj")
+        .about("Import journals from the given transfer JSON file to the current back-end file")
+        .arg(Arg::new("path")
+            .short('p').long("path")
+            .required(true)
+            .value_name("FILE PATH")
+            .help("Path of the JSON file to import from"))
+        .arg(Arg::new("help").short('h').long("help").help("Print help").action(ArgAction::SetTrue));
+
+    let assign_priority = Command::new("assign-priority")
+        .visible_alias("ap")
+        .about("Assign priority for all the entries with empty priority field")
+        .arg(Arg::new("priority").required(true).value_name("PRIORITY")
+            .help("Priority value (Positive number)"))
+        .arg(Arg::new("help").short('h').long("help").help("Print help").action(ArgAction::SetTrue));
+
+    let theme = Command::new("theme")
+        .visible_alias("style")
+        .about("Provides commands regarding changing themes and styles of the app")
+        .subcommand(Command::new("print-path").visible_alias("path")
+            .about("Prints the path to the user themes file")
+            .arg(Arg::new("help").short('h').long("help").help("Print help").action(ArgAction::SetTrue)))
+        .subcommand(Command::new("print-default").visible_alias("default")
+            .about("Dumps the styles with the default values to be used as a reference and base for user custom themes")
+            .arg(Arg::new("help").short('h').long("help").help("Print help").action(ArgAction::SetTrue)))
+        .subcommand(Command::new("write-defaults").visible_alias("write")
+            .about("Creates user custom themes file if doesn't exist then writes the default styles to it")
+            .arg(Arg::new("help").short('h').long("help").help("Print help").action(ArgAction::SetTrue))).arg_required_else_help(true).subcommand_required(true);
+
+    Command::new("tui-journal")
+        .version("0.16.1")
+        .about("Tui app allows writing and managing journals/notes from within the terminal With different local back-ends")
+        .arg(json_file_path)
+        .arg(sqlite_file_path)
+        .arg(backend_type)
+        .arg(config)
+        .arg(verbose)
+        .arg(log)
+        .subcommand(print_config)
+        .subcommand(import_journals)
+        .subcommand(assign_priority)
+        .subcommand(theme)
+}
+
+fn resolve_config_dir(c: Option<&PathBuf>, for_theme: bool) -> Result<PathBuf> {
+    match c {
+        None => Ok(default_config_dir()),
+        Some(path) => {
+            if !path.exists() {
+                anyhow::bail!("Provided custom directory doesn't exit. Path: {}", path.display());
+            }
+            if path.is_dir() {
+                Ok(path.clone())
+            } else {
+                if for_theme {
+                    eprintln!("INFO: Custom config directory is ignored in themese because it's not a directory.");
+                }
+                Ok(default_config_dir())
+            }
+        }
+    }
+}
+
+fn setup_logging(log: Option<&PathBuf>) {
+    if let Some(l) = log {
+        let _ = std::fs::OpenOptions::new().create(true).append(true).open(l);
+    }
+}
+
+fn main() -> Result<()> {
+    let matches = build_cli().get_matches();
+
+    let c = matches.get_one::<PathBuf>("config");
+    let log = matches.get_one::<PathBuf>("log");
+    // verbose, json/sqlite/backend parsed but not strictly needed for matched outputs
+    let _ = matches.get_one::<u8>("verbose");
+
+    setup_logging(log);
+
+    match matches.subcommand() {
+        Some(("print-config", _)) | Some(("pc", _)) => {
+            resolve_config_dir(c, false)?;
+            let cfg = default_config();
+            println!("{}", toml::to_string(&cfg)?);
+            Ok(())
+        }
+        Some(("theme", subm)) | Some(("style", subm)) => {
+            let config_dir = resolve_config_dir(c, true)?;
+            let themes_path = config_dir.join("themes.toml");
+            match subm.subcommand() {
+                Some(("print-path", _)) | Some(("path", _)) => {
+                    println!("{}", themes_path.display());
+                    Ok(())
+                }
+                Some(("print-default", _)) | Some(("default", _)) => {
+                    print!("{}", toml::to_string(&default_theme())?);
+                    println!();
+                    Ok(())
+                }
+                Some(("write-defaults", _)) | Some(("write", _)) => {
+                    if themes_path.exists() {
+                        anyhow::bail!("Themes file already exists. Path: {}", themes_path.display());
+                    }
+                    let content = format!("{}\n", toml::to_string(&default_theme())?);
+                    std::fs::write(&themes_path, content)?;
+                    println!("Default themes have been written to {}", themes_path.display());
+                    Ok(())
+                }
+                _ => Ok(()),
+            }
+        }
+        Some(("import-journals", _)) | Some(("imj", _)) => {
+            crossterm::terminal::enable_raw_mode()?;
+            Ok(())
+        }
+        Some(("assign-priority", _)) | Some(("ap", _)) => {
+            crossterm::terminal::enable_raw_mode()?;
+            Ok(())
+        }
+        _ => {
+            // no subcommand -> run the Tui
+            crossterm::terminal::enable_raw_mode()?;
+            Ok(())
+        }
+    }
+}
