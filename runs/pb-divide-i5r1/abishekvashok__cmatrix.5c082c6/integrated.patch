diff --git a/src/main.c b/src/main.c
new file mode 100644
index 0000000..2ce2137
--- /dev/null
+++ b/src/main.c
@@ -0,0 +1,135 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <signal.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <ctype.h>
+#include <wchar.h>
+#include <errno.h>
+#include <fcntl.h>
+
+#include "screen.h"
+#include "options.h"
+#include "error.h"
+#include "manpage.h"
+
+#define VERSION "2.0"
+#define BUILD_TIME "22:13:51, Jun 11 2026"
+#define EMAIL "abishekvashok@gmail.com"
+#define WEB "https://github.com/abishekvashok/cmatrix"
+
+static volatile int running = 1;
+static volatile int quit_requested = 0;
+
+static void signal_handler(int sig) {
+    (void)sig;
+    running = 0;
+}
+
+void print_usage(const char *progname) {
+    printf(" Usage: %s -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n", progname);
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+void print_version(void) {
+    printf(" CMatrix version %s (compiled %s)\n", VERSION, BUILD_TIME);
+    printf("Email: %s\n", EMAIL);
+    printf("Web: %s\n", WEB);
+}
+
+int main(int argc, char *argv[]) {
+    Options opts;
+    struct termios oldt, newt;
+    int tty_fd = -1;
+
+    options_init(&opts);
+
+    if (options_parse(argc, argv, &opts) != 0) {
+        return 1;
+    }
+
+    if (opts.help) {
+        print_usage(argv[0]);
+        return 0;
+    }
+
+    if (opts.version) {
+        print_version();
+        return 0;
+    }
+
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+
+    if (opts.tty != NULL) {
+        tty_fd = open(opts.tty, O_RDWR);
+        if (tty_fd < 0) {
+            fprintf(stderr, "Error: '%s' couldn't be opened: %s\n", opts.tty, strerror(errno));
+            return 1;
+        }
+    }
+
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == -1) {
+        ws.ws_row = 24;
+        ws.ws_col = 80;
+    }
+
+    screen_init(ws.ws_row, ws.ws_col, &opts);
+
+    if (tcgetattr(STDOUT_FILENO, &oldt) == -1) {
+        fprintf(stderr, "Error: tcgetattr failed: %s\n", strerror(errno));
+        return 1;
+    }
+
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+
+    if (tcsetattr(STDOUT_FILENO, TCSANOW, &newt) == -1) {
+        fprintf(stderr, "Error: tcsetattr failed: %s\n", strerror(errno));
+        return 1;
+    }
+
+    while (running) {
+        screen_update(&opts);
+        if (quit_requested) {
+            break;
+        }
+        usleep(opts.delay * 100000);
+    }
+
+    tcsetattr(STDOUT_FILENO, TCSANOW, &oldt);
+    screen_clear();
+
+    if (tty_fd >= 0) {
+        close(tty_fd);
+    }
+
+    return 0;
+}
