+++ b/src/options.c
@@ -0,0 +1,174 @@
+#include "options.h"
+#include "error.h"
+#include "manpage.h"
+
+void options_init(Options *opts) {
+    opts->async = 0;
+    opts->bold = 0;
+    opts->all_bold = 0;
+    opts->force_term = 0;
+    opts->linux_mode = 0;
+    opts->old_scroll = 0;
+    opts->shadows = 0;
+    opts->locked = 0;
+    opts->rainbow = 0;
+    opts->lambda_mode = 0;
+    opts->char_change = 0;
+    opts->screensaver = 0;
+    opts->x_mode = 0;
+    opts->no_bold = 0;
+    opts->help = 0;
+    opts->version = 0;
+    opts->use_japanese = 0;
+    opts->delay = DEFAULT_DELAY;
+    opts->color = COLOR_GREEN;
+    opts->message = NULL;
+    opts->tty = NULL;
+}
+
+int options_parse(int argc, char **argv, Options *opts) {
+    int i = 1;
+    while (i < argc) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            opts->help = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-V") == 0) {
+            opts->version = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-a") == 0) {
+            opts->async = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-b") == 0) {
+            opts->bold = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-B") == 0) {
+            opts->all_bold = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-c") == 0) {
+            opts->use_japanese = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-f") == 0) {
+            opts->force_term = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-l") == 0) {
+            opts->linux_mode = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-L") == 0) {
+            opts->locked = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-o") == 0) {
+            opts->old_scroll = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-n") == 0) {
+            opts->no_bold = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-s") == 0) {
+            opts->screensaver = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-x") == 0) {
+            opts->x_mode = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-r") == 0) {
+            opts->rainbow = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-m") == 0) {
+            opts->lambda_mode = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-k") == 0) {
+            opts->char_change = 1;
+            i++;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 >= argc) {
+                error_exit("Error: -u requires a delay value", 1);
+            }
+            opts->delay = atoi(argv[i + 1]);
+            if (opts->delay < MIN_DELAY || opts->delay > MAX_DELAY) {
+                fprintf(stderr, "Error: delay must be between %d and %d\n", MIN_DELAY, MAX_DELAY);
+                return -1;
+            }
+            i += 2;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 >= argc) {
+                error_exit("Error: -C requires a color value", 1);
+            }
+            opts->color = validate_color(argv[i + 1]);
+            i += 2;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 >= argc) {
+                error_exit("Error: -M requires a message", 1);
+            }
+            opts->message = argv[i + 1];
+            i += 2;
+            continue;
+        }
+        
+        if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 >= argc) {
+                error_exit("Error: -t requires a tty value", 1);
+            }
+            opts->tty = argv[i + 1];
+            i += 2;
+            continue;
+        }
+        
+        // Unknown option
+        fprintf(stderr, "Error: unknown option '%s'\n", argv[i]);
+        return -1;
+    }
+    
+    return 0;
+}
