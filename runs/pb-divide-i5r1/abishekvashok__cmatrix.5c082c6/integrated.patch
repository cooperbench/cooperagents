diff --git a/src/error.c b/src/error.c
new file mode 100644
index 0000000..7f9bcde
--- /dev/null
+++ b/src/error.c
@@ -0,0 +1,39 @@
+#include "error.h"
+#include "options.h"
+
+void error_exit(const char *msg, int exit_code) {
+    fprintf(stderr, "%s\n", msg);
+    exit(exit_code);
+}
+
+void usage_exit(const char *prog_name) {
+    print_usage(prog_name);
+    exit(0);
+}
+
+void version_exit(void) {
+    print_version();
+    exit(0);
+}
+
+int validate_delay(int delay) {
+    if (delay < MIN_DELAY || delay > MAX_DELAY) {
+        fprintf(stderr, "Error: delay must be between %d and %d\n", MIN_DELAY, MAX_DELAY);
+        return 0;
+    }
+    return 1;
+}
+
+int validate_color(const char *color_str) {
+    if (strcmp(color_str, "green") == 0) return COLOR_GREEN;
+    if (strcmp(color_str, "red") == 0) return COLOR_RED;
+    if (strcmp(color_str, "blue") == 0) return COLOR_BLUE;
+    if (strcmp(color_str, "white") == 0) return COLOR_WHITE;
+    if (strcmp(color_str, "yellow") == 0) return COLOR_YELLOW;
+    if (strcmp(color_str, "cyan") == 0) return COLOR_CYAN;
+    if (strcmp(color_str, "magenta") == 0) return COLOR_MAGENTA;
+    if (strcmp(color_str, "black") == 0) return COLOR_BLACK;
+    
+    fprintf(stderr, "Error: invalid color '%s'. Valid colors are: green, red, blue, white, yellow, cyan, magenta, black\n", color_str);
+    return COLOR_GREEN;
+}
