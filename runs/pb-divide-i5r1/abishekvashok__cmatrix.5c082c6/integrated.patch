+++ b/src/screen.c
@@ -0,0 +1,191 @@
+#include "screen.h"
+#include "options.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+#include <wchar.h>
+
+#define MATRIX_CHARS "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+#define MATRIX_CHARS_LEN (sizeof(MATRIX_CHARS) - 1)
+
+#define LAMBDA_CHARS "λλ"
+#define LAMBDA_CHARS_LEN (sizeof(LAMBDA_CHARS) - 1)
+
+#define JAPANESE_CHARS "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン"
+#define JAPANESE_CHARS_LEN (sizeof(JAPANESE_CHARS) - 1)
+
+typedef struct {
+    wchar_t **lines;
+    int rows;
+    int cols;
+    int *offsets;
+    int *x_positions;
+    int *y_positions;
+    int *directions;
+    int *speeds;
+    int *colors;
+    int *bold;
+    int initialized;
+} screen_t;
+
+static screen_t *screen = NULL;
+
+static void screen_free(void);
+static void screen_init_internal(int rows, int cols, Options *opts);
+static void screen_update_internal(Options *opts);
+static void screen_clear_internal(void);
+static void screen_print_char_internal(int row, int col, wchar_t ch, int bold, int color);
+
+static void screen_free(void) {
+    if (screen) {
+        for (int i = 0; i < screen->rows; i++) {
+            free(screen->lines[i]);
+        }
+        free(screen->lines);
+        free(screen->offsets);
+        free(screen->x_positions);
+        free(screen->y_positions);
+        free(screen->directions);
+        free(screen->speeds);
+        free(screen->colors);
+        free(screen->bold);
+        free(screen);
+    }
+}
+
+static void screen_init_internal(int rows, int cols, Options *opts) {
+    (void)opts;
+    screen = calloc(1, sizeof(screen_t));
+    if (!screen) {
+        return;
+    }
+    screen->rows = rows;
+    screen->cols = cols;
+    screen->lines = calloc(rows, sizeof(wchar_t *));
+    screen->offsets = calloc(rows, sizeof(int));
+    screen->x_positions = calloc(rows * cols, sizeof(int));
+    screen->y_positions = calloc(rows * cols, sizeof(int));
+    screen->directions = calloc(rows * cols, sizeof(int));
+    screen->speeds = calloc(rows * cols, sizeof(int));
+    screen->colors = calloc(rows * cols, sizeof(int));
+    screen->bold = calloc(rows * cols, sizeof(int));
+    screen->initialized = 0;
+    if (!screen->lines || !screen->offsets || !screen->x_positions || 
+        !screen->y_positions || !screen->directions || !screen->speeds ||
+        !screen->colors || !screen->bold) {
+        screen_free();
+        return;
+    }
+    for (int i = 0; i < rows; i++) {
+        screen->lines[i] = calloc(cols, sizeof(wchar_t));
+    }
+    for (int i = 0; i < rows; i++) {
+        screen->offsets[i] = 0;
+        for (int j = 0; j < cols; j++) {
+            screen->x_positions[i * cols + j] = j;
+            screen->y_positions[i * cols + j] = i;
+            screen->directions[i * cols + j] = 1;
+            screen->speeds[i * cols + j] = 1;
+            screen->colors[i * cols + j] = 0;
+            screen->bold[i * cols + j] = 0;
+        }
+    }
+    screen->initialized = 1;
+}
+
+void screen_init(int rows, int cols, Options *opts) {
+    screen_init_internal(rows, cols, opts);
+}
+
+static void screen_update_internal(Options *opts) {
+    if (!screen || !screen->initialized) return;
+    for (int i = 0; i < screen->rows; i++) {
+        screen->offsets[i] += opts->delay;
+        if (screen->offsets[i] >= screen->cols) {
+            screen->offsets[i] = 0;
+        }
+        for (int j = 0; j < screen->cols; j++) {
+            int idx = i * screen->cols + j;
+            int new_x = screen->x_positions[idx] + screen->directions[idx] * screen->speeds[idx];
+            if (new_x >= screen->cols) {
+                new_x = 0;
+                screen->directions[idx] = 1;
+            } else if (new_x < 0) {
+                new_x = screen->cols - 1;
+                screen->directions[idx] = -1;
+            }
+            screen->x_positions[idx] = new_x;
+        }
+    }
+    for (int i = 0; i < screen->rows; i++) {
+        for (int j = 0; j < screen->cols; j++) {
+            int idx = i * screen->cols + j;
+            int x = screen->x_positions[idx];
+            wchar_t ch;
+            if (opts->lambda_mode) {
+                ch = LAMBDA_CHARS[rand() % LAMBDA_CHARS_LEN];
+            } else if (opts->use_japanese) {
+                ch = JAPANESE_CHARS[rand() % JAPANESE_CHARS_LEN];
+            } else {
+                ch = MATRIX_CHARS[rand() % MATRIX_CHARS_LEN];
+            }
+            int color = opts->color;
+            if (opts->rainbow) {
+                color = (i + j) % 8;
+            }
+            int bold = opts->bold;
+            if (opts->all_bold) {
+                bold = 1;
+            } else if (opts->no_bold) {
+                bold = 0;
+            }
+            screen->colors[idx] = color;
+            screen->bold[idx] = bold;
+            screen_print_char_internal(i, x, ch, bold, color);
+        }
+    }
+}
+
+void screen_update(Options *opts) {
+    screen_update_internal(opts);
+}
+
+static void screen_clear_internal(void) {
+    if (!screen || !screen->initialized) return;
+    for (int i = 0; i < screen->rows; i++) {
+        for (int j = 0; j < screen->cols; j++) {
+            screen_print_char_internal(i, j, L' ', 0, 0);
+        }
+    }
+}
+
+void screen_clear(void) {
+    screen_clear_internal();
+}
+
+static void screen_print_char_internal(int row, int col, wchar_t ch, int bold, int color) {
+    if (row < 0 || row >= screen->rows || col < 0 || col >= screen->cols) return;
+    if (color >= 0 && color <= 7) {
+        if (color == 0) { printf("\033[32m"); }
+        else if (color == 1) { printf("\033[31m"); }
+        else if (color == 2) { printf("\033[34m"); }
+        else if (color == 3) { printf("\033[37m"); }
+        else if (color == 4) { printf("\033[33m"); }
+        else if (color == 5) { printf("\033[36m"); }
+        else if (color == 6) { printf("\033[35m"); }
+        else if (color == 7) { printf("\033[30m"); }
+    }
+    if (bold) { printf("\033[1m"); }
+    wprintf(L"%lc", ch);
+    printf("\033[0m");
+}
+
+void screen_print_line(int row, const wchar_t *line, int len) {
+    if (!screen || !screen->initialized) return;
+    for (int i = 0; i < len && row >= 0 && row < screen->rows; i++) {
+        int col = i;
+        screen_print_char_internal(row, col, line[i], 0, 0);
+    }
+}
