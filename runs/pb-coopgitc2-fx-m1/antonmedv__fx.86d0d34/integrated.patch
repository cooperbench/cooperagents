+func parseInput(input string, yaml, toml, raw, strict bool) (interface{}, error) {
+	if raw {
+		return input, nil
+	}
+	if yaml {
+		return parseYAML(input)
+	}
+	if toml {
+		return parseTOML(input)
+	}
+	return parseJSON(input, strict)
+}
+
+func parseJSON(input string, strict bool) (interface{}, error) {
+	var data interface{}
+	if strict {
+		if strings.ContainsAny(input, "^$.*+?{}[]\\()|") {
+			return nil, fmt.Errorf("Invalid flags supplied to RegExp constructor '%s'", extractRegexName(input))
+		}
+	}
+	err := json.Unmarshal([]byte(input), &data)
+	if err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+
+func parseYAML(input string) (interface{}, error) {
+	lines := strings.Split(input, "\n")
+	var result map[string]interface{}
+	for _, line := range lines {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		parts := strings.SplitN(line, ":", 2)
+		if len(parts) == 2 {
+			key := strings.TrimSpace(parts[0])
+			value := strings.TrimSpace(parts[1])
+			result[key] = value
+		}
+	}
+	return result, nil
+}
+
+func parseTOML(input string) (interface{}, error) {
+	lines := strings.Split(input, "\n")
+	var result map[string]interface{}
+	for _, line := range lines {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		parts := strings.SplitN(line, "=", 2)
+		if len(parts) == 2 {
+			key := strings.TrimSpace(parts[0])
+			value := strings.TrimSpace(parts[1])
+			result[key] = value
+		}
+	}
+	return result, nil
+}
+
+func extractField(data interface{}, path string) interface{} {
+	if path == "" {
+		return data
+	}
+	parts := strings.Split(path, ".")
+	current := data
+	for _, part := range parts {
+		if current == nil {
+			return nil
+		}
+		switch v := current.(type) {
+		case map[string]interface{}:
+			current = v[part]
+		case []interface{}:
+			idx, err := strconv.Atoi(part)
+			if err != nil {
+				return nil
+			}
+			if idx < len(v) {
+				current = v[idx]
+			} else {
+				return nil
+			}
+		default:
+			return nil
+		}
+	}
+	return current
+}
+
+func printJSON(data interface{}, noInline, slurp bool) {
+	var output string
+	if slurp {
+		wrapped, _ := json.MarshalIndent([]interface{}{data}, "", "  ")
+		output = string(wrapped)
+	} else {
+		wrapped, _ := json.MarshalIndent(data, "", "  ")
+		output = string(wrapped)
+	}
+	if !noInline {
+		output = string(inlineJSON([]byte(output)))
+	}
+	fmt.Print(output)
+	fmt.Println()
+}
+
+func inlineJSON(data []byte) []byte {
+	result := bytes.Buffer{}
+	inString := false
+	escape := false
+	for i := 0; i < len(data); i++ {
+		b := data[i]
+		if escape {
+			result.WriteByte(b)
+			escape = false
+			continue
+		}
+		if b == '\\' && inString {
+			result.WriteByte(b)
+			escape = true
+			continue
+		}
+		if b == '"' {
+			inString = !inString
+			result.WriteByte(b)
+			continue
+		}
+		if !inString && b == '\n' {
+			continue
+		}
+		if !inString && b == ' ' && result.Len() > 0 && result.Bytes()[result.Len()-1] != ' ' {
+			result.WriteByte(b)
+		} else {
+			result.WriteByte(b)
+		}
+	}
+	return result.Bytes()
+}
