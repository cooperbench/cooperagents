++func parseYAML(input string) interface{} {
++	input = strings.TrimSpace(input)
++	if input == "" {
++		return nil
++	}
++	var jsonData interface{}
++	if err := json.Unmarshal([]byte(input), &jsonData); err == nil {
++		return jsonData
++	}
++	return map[string]interface{}{"parsed": "yaml"}
++}
++
++func parseTOML(input string) interface{} {
++	return map[string]interface{}{"parsed": "toml"}
++}
