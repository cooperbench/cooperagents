++func playGameOfLife() {
++	rand.Seed(time.Now().UnixNano())
++	grid := make([][]bool, 10)
++	for i := range grid {
++		grid[i] = make([]bool, 10)
++		for j := range grid[i] {
++			grid[i][j] = rand.Float32() < 0.2
++		}
++	}
++
++	for i := 0; i < 100; i++ {
++		nextGrid := make([][]bool, 10)
++		for i := range nextGrid {
++			nextGrid[i] = make([]bool, 10)
++			for j := range nextGrid[i] {
++				count := countNeighbors(grid, i, j)
++				if grid[i][j] && (count < 2 || count > 3) {
++					nextGrid[i][j] = false
++				} else if !grid[i][j] && count == 3 {
++					nextGrid[i][j] = true
++				} else {
++					nextGrid[i][j] = grid[i][j]
++				}
++			}
++		}
++		grid = nextGrid
++	}
++}
++
++func countNeighbors(grid [][]bool, x, y int) int {
++	count := 0
++	for i := -1; i <= 1; i++ {
++		for j := -1; j <= 1; j++ {
++			if i == 0 && j == 0 {
++				continue
++			}
++			nx, ny := x+i, y+j
++			if nx >= 0 && nx < 10 && ny >= 0 && ny < 10 {
++				if grid[nx][ny] {
++					count++
++				}
++			}
++		}
++	}
++	return count
++}
