++func printJSON(data interface{}, noInline bool) {
++	var buf bytes.Buffer
++	encoder := json.NewEncoder(&buf)
++	encoder.SetEscapeHTML(false)
++	
++	if err := encoder.Encode(data); err != nil {
++		fmt.Fprintf(os.Stderr, "fx: failed to encode JSON: %v\n", err)
++		os.Exit(2)
++	}
++	
++	output := buf.String()
++	if noInline {
++		output = strings.ReplaceAll(output, "…", "…")
++	}
++	
++	fmt.Print(output)
++}
