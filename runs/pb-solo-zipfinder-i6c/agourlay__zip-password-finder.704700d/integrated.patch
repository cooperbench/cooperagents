+#!/usr/bin/env python3
+"""zip-password-finder - Find the password of protected ZIP files"""
+
+import argparse
+import sys
+import os
+import zipfile
+import time
+import itertools
+import string
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+VERSION = "0.10.3"
+
+CHARSETS = {
+    'l': string.ascii_lowercase,
+    'u': string.ascii_uppercase,
+    'd': string.digits,
+    'h': string.hexdigits.lower(),
+    'H': string.hexdigits.upper(),
+    's': ' \t\n\r!@#$%^&*()_+-=[]{}|;:,.<>?/~`'
+}
+
+def test_password(zip_path, password, file_number=0):
+    try:
+        if file_number >= 0:
+            with zipfile.ZipFile(zip_path, 'r') as zf:
+                if file_number < len(zf.namelist()):
+                    zf.extract(zf.namelist()[file_number], path=None, pwd=password.encode())
+                else:
+                    zf.extractall(pwd=password.encode())
+        else:
+            with zipfile.ZipFile(zip_path, 'r') as zf:
+                zf.extractall(pwd=password.encode())
+        return password
+    except Exception:
+        return None
+
+def generate_passwords(charset, min_len, max_len, starting_password=None):
+    if starting_password:
+        yield starting_password
+        min_len = max(min_len, len(starting_password))
+    
+    for length in range(min_len, max_len + 1):
+        for combo in itertools.product(charset, repeat=length):
+            yield ''.join(combo)
+
+def main():
+    parser = argparse.ArgumentParser(
+        description='Find the password of protected ZIP files',
+        formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    parser.add_argument('-i', '--inputFile', required=True, help='path to zip input file')
+    parser.add_argument('-w', '--workers', type=int, default=1, help='number of workers')
+    parser.add_argument('-p', '--passwordDictionary', help='path to a password dictionary file')
+    parser.add_argument('-c', '--charset', default='lud', help='charset to use to generate password [default: lud]')
+    parser.add_argument('--charsetFile', help='path to a charset file')
+    parser.add_argument('--minPasswordLen', type=int, default=1, help='minimum password length [default: 1]')
+    parser.add_argument('--maxPasswordLen', type=int, default=10, help='maximum password length [default: 10]')
+    parser.add_argument('--fileNumber', type=int, default=0, help='file number in the zip archive [default: 0]')
+    parser.add_argument('-s', '--startingPassword', help='password to start from')
+    parser.add_argument('-V', '--version', action='version', version=f'zip-password-finder {VERSION}')
+    
+    args = parser.parse_args()
+    
+    if not os.path.exists(args.inputFile):
+        print(f'CLI argument error - "{args.inputFile}" does not exist')
+        sys.exit(1)
+    
+    charset_chars = ''
+    for char in args.charset:
+        if char in CHARSETS:
+            charset_chars += CHARSETS[char]
+    if args.charsetFile and os.path.exists(args.charsetFile):
+        with open(args.charsetFile, 'r') as f:
+            charset_chars = ''.join(line.strip() for line in f if line.strip())
+    
+    passwords = []
+    if args.passwordDictionary and os.path.exists(args.passwordDictionary):
+        with open(args.passwordDictionary, 'r') as f:
+            passwords = [line.strip() for line in f if line.strip()]
+    
+    if passwords:
+        password_generator = iter(passwords)
+    else:
+        password_generator = generate_passwords(charset_chars, args.minPasswordLen, args.maxPasswordLen, args.startingPassword)
+    
+    start_time = time.perf_counter()
+    
+    found = False
+    found_password = None
+    with ThreadPoolExecutor(max_workers=args.workers) as executor:
+        futures = []
+        for password in password_generator:
+            if found:
+                break
+            futures.append(executor.submit(test_password, args.inputFile, password, args.fileNumber))
+            if len(futures) >= args.workers:
+                for future in as_completed(futures):
+                    result = future.result()
+                    if result is not None:
+                        found = True
+                        found_password = result
+                        break
+                if found:
+                    break
+                futures = []
+    
+    elapsed = time.perf_counter() - start_time
+    
+    if found:
+        print(f'Time elapsed: {elapsed*1000000:.0f}us {int((elapsed*1000000000) % 1000):03d}ns')
+        print(f'Password found:{found_password}')
+    else:
+        print(f'Time elapsed: {elapsed*1000000:.0f}us {int((elapsed*1000000000) % 1000):03d}ns')
+        print('Password not found')
+    
+    sys.exit(0)
+
+if __name__ == '__main__':
+    main()
