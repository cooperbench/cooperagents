+#!/usr/bin/env python3
+"""ZIP Password Finder - Find passwords for protected ZIP files."""
+
+import argparse
+import sys
+import time
+import threading
+import os
+from itertools import product
+from typing import List, Optional
+
+# Character sets
+CHARSETS = {
+    'l': 'abcdefghijklmnopqrstuvwxyz',
+    'u': 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
+    'd': '0123456789',
+    'h': '0123456789abcdef',
+    'H': '0123456789ABCDEF',
+    's': ' !\"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~ '
+}
+
+def load_charset_file(filepath: str) -> str:
+    """Load charset from file, one character per line."""
+    with open(filepath, 'r') as f:
+        return ''.join(line.strip() for line in f if line.strip())
+
+def generate_passwords(charset: str, min_len: int, max_len: int, start: Optional[str] = None) -> List[str]:
+    """Generate passwords based on charset and length range."""
+    # Handle multiple charsets (e.g., "lud" means l + u + d combined)
+    charset_chars = []
+    for c in charset:
+        if c in CHARSETS:
+            charset_chars.append(CHARSETS[c])
+    
+    if not charset_chars:
+        return []
+    
+    # Combine all charset characters
+    combined = ''.join(charset_chars)
+    
+    passwords = []
+    if start:
+        # Start from a specific password
+        passwords = [start]
+    else:
+        # Generate all combinations
+        for length in range(min_len, max_len + 1):
+            for combo in product(combined, repeat=length):
+                passwords.append(''.join(combo))
+    
+    return passwords
+
+def test_password(zip_path: str, password: bytes, file_number: int) -> bool:
+    """Test if a password works for the specified file in the ZIP."""
+    import zipfile
+    
+    try:
+        with zipfile.ZipFile(zip_path, 'r') as zf:
+            # Get the file at file_number
+            if file_number < 0 or file_number >= len(zf.infolist()):
+                return False
+            
+            info = zf.infolist()[file_number]
+            
+            # Check if the file is encrypted
+            if not info.flag_bits & 0x1:
+                print(f"Invalid zip file error - the selected file in the archive is not encrypted (file_number:{file_number} file_name:{info.filename})", file=sys.stderr)
+                return False
+            
+            # Try to open with the password
+            try:
+                with zf.open(info, pwd=password) as f:
+                    return True
+            except Exception:
+                return False
+    except Exception as e:
+        print(f"Error opening zip file: {e}", file=sys.stderr)
+        return False
+
+def dictionary_attack(zip_path: str, dictionary_path: str, file_number: int) -> Optional[str]:
+    """Attack using a dictionary file."""
+    try:
+        with open(dictionary_path, 'r') as f:
+            passwords = [line.strip() for line in f if line.strip()]
+    except Exception as e:
+        print(f"Error reading dictionary file: {e}", file=sys.stderr)
+        return None
+    
+    for password in passwords:
+        if test_password(zip_path, password.encode('utf-8'), file_number):
+            return password
+    
+    return None
+
+def brute_force_attack(zip_path: str, charset: str, min_len: int, max_len: int, 
+                       file_number: int, workers: int, start: Optional[str] = None) -> Optional[str]:
+    """Brute force attack with multi-threading."""
+    passwords = generate_passwords(charset, min_len, max_len, start)
+    
+    if not passwords:
+        return None
+    
+    results = [None]
+    lock = threading.Lock()
+    
+    def worker():
+        for password in passwords:
+            if results[0] is not None:
+                break
+            if test_password(zip_path, password.encode('utf-8'), file_number):
+                with lock:
+                    results[0] = password
+                break
+    
+    threads = []
+    for _ in range(workers):
+        t = threading.Thread(target=worker)
+        t.start()
+        threads.append(t)
+    
+    for t in threads:
+        t.join()
+    
+    return results[0]
+
+def main():
+    parser = argparse.ArgumentParser(
+        description='Find the password of protected ZIP files',
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog='''
+Examples:
+  zip-password-finder --inputFile secret.zip --passwordDictionary words.txt
+  zip-password-finder --inputFile secret.zip --charset l --minPasswordLen 1 --maxPasswordLen 6
+'''
+    )
+    
+    parser.add_argument('-i', '--inputFile', required=True,
+                        help='path to zip input file')
+    parser.add_argument('-w', '--workers', type=int, default=1,
+                        help='number of workers')
+    parser.add_argument('-p', '--passwordDictionary',
+                        help='path to a password dictionary file')
+    parser.add_argument('-c', '--charset', default='lud',
+                        help='charset to use to generate password [default: lud]')
+    parser.add_argument('--charsetFile',
+                        help='path to a charset file')
+    parser.add_argument('--minPasswordLen', type=int, default=1,
+                        help='minimum password length [default: 1]')
+    parser.add_argument('--maxPasswordLen', type=int, default=10,
+                        help='maximum password length [default: 10]')
+    parser.add_argument('--fileNumber', type=int, default=0,
+                        help='file number in the zip archive [default: 0]')
+    parser.add_argument('-s', '--startingPassword',
+                        help='password to start from')
+    parser.add_argument('-V', '--version', action='version',
+                        version='zip-password-finder 0.10.3')
+    
+    args = parser.parse_args()
+    
+    # Validate inputs
+    if not os.path.exists(args.inputFile):
+        print(f'CLI argument error - "{args.inputFile}" does not exist', file=sys.stderr)
+        sys.exit(1)
+    
+    if args.passwordDictionary and not os.path.exists(args.passwordDictionary):
+        print(f'CLI argument error - "{args.passwordDictionary}" does not exist', file=sys.stderr)
+        sys.exit(1)
+    
+    if args.charsetFile and not os.path.exists(args.charsetFile):
+        print(f'CLI argument error - "{args.charsetFile}" does not exist', file=sys.stderr)
+        sys.exit(1)
+    
+    # Determine charset
+    if args.charsetFile:
+        charset = load_charset_file(args.charsetFile)
+    else:
+        charset = args.charset
+    
+    # Validate charset only if not using dictionary attack
+    if not args.passwordDictionary:
+        if args.charsetFile:
+            # If using charset file, validate it contains valid chars
+            valid = all(c in CHARSETS or c in 'ludhHs' for c in charset)
+            if not valid:
+                print(f'Invalid charset file', file=sys.stderr)
+                sys.exit(1)
+        else:
+            # Validate individual charset - allow combinations like "lud"
+            valid = all(c in CHARSETS or c in 'ludhHs' for c in charset)
+            if not valid:
+                print(f'Invalid charset: {charset}', file=sys.stderr)
+                sys.exit(1)
+    
+    # Run attack
+    start_time = time.time()
+    
+    if args.passwordDictionary:
+        password = dictionary_attack(args.inputFile, args.passwordDictionary, args.fileNumber)
+    else:
+        password = brute_force_attack(
+            args.inputFile, charset, args.minPasswordLen, args.maxPasswordLen,
+            args.fileNumber, args.workers, args.startingPassword
+        )
+    
+    elapsed = time.time() - start_time
+    
+    if password:
+        print(f'Time elapsed: {elapsed:.6f}s')
+        print(f'Password found:{password}')
+        sys.exit(0)
+    else:
+        print(f'Time elapsed: {elapsed:.6f}s')
+        print('Password not found')
+        sys.exit(0)
+
+if __name__ == '__main__':
+    main()
