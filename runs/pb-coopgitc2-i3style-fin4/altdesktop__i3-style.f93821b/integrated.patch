+def get_default_config():
+    """Get the default i3 config file path."""
+    return os.path.expanduser("~/.config/i3/config")
+
+def get_config_path(config_file):
+    """Get the full path to the config file."""
+    if config_file:
+        return os.path.expanduser(config_file)
+    return get_default_config()
+
+def load_config(config_path):
+    """Load the i3 config file."""
+    try:
+        with open(config_path, 'r') as f:
+            return f.read()
+    except FileNotFoundError:
+        return ""
+    except Exception as e:
+        print(f"Error reading config file: {e}", file=sys.stderr)
+        sys.exit(1)
+
+def apply_theme_to_config(config, theme_name):
+    """Apply a theme to the i3 config."""
+    if theme_name not in THEME_COLORS:
+        print(f"Unknown theme: {theme_name}", file=sys.stderr)
+        sys.exit(1)
+    
+    colors = THEME_COLORS[theme_name]
+    
+    # Apply window colors
+    window_colors = colors.get("window_colors", {})
+    for key, value in window_colors.items():
+        config = re.sub(
+            rf'//\s*{key}\s*:\s*\[.*?\]',
+            f'// {key}: [{", ".join(value)}]',
+            config,
+            flags=re.IGNORECASE
+        )
+        config = re.sub(
+            rf'{key}\s*:\s*\[.*?\]',
+            f'{key}: [{", ".join(value)}]',
+            config,
+            flags=re.IGNORECASE
+        )
+    
+    # Apply bar colors
+    bar_colors = colors.get("bar_colors", {})
+    for key, value in bar_colors.items():
+        config = re.sub(
+            rf'//\s*{key}\s*:\s*\[.*?\]',
+            f'// {key}: [{", ".join(value)}]',
+            config,
+            flags=re.IGNORECASE
+        )
+        config = re.sub(
+            rf'{key}\s*:\s*\[.*?\]',
+            f'{key}: [{", ".join(value)}]',
+            config,
+            flags=re.IGNORECASE
+        )
+    
+    # Apply basic colors
+    for key, value in colors.items():
+        if key not in ["window_colors", "bar_colors"]:
+            config = re.sub(
+                rf'//\s*{key}\s*:\s*.*',
+                f'// {key}: {value}',
+                config,
+                flags=re.IGNORECASE
+            )
+            config = re.sub(
+                rf'{key}\s*:\s*.*',
+                f'{key}: {value}',
+                config,
+                flags=re.IGNORECASE
+            )
+    
+    return config
+
+def validate_config(config_path):
+    """Validate the config using i3."""
+    try:
+        result = subprocess.run(
+            ["i3", "-C", "-c", config_path],
+            capture_output=True,
+            text=True,
+            timeout=10
+        )
+        if result.returncode != 0:
+            error_msg = result.stderr.strip()
+            if not error_msg:
+                error_msg = result.stdout.strip()
+            print(f"Could not validate config with `i3 -C -c {config_path}` (is i3 in the PATH?) {error_msg}", file=sys.stderr)
+            return False
+        return True
+    except FileNotFoundError:
+        print(f"Could not validate config with `i3 -C -c {config_path}` (is i3 in the PATH?) No such file or directory (os error 2)", file=sys.stderr)
+        return False
+    except subprocess.TimeoutExpired:
+        print(f"Could not validate config with `i3 -C -c {config_path}` (is i3 in the PATH?) i3 config_test timed out", file=sys.stderr)
+        return False
+    except Exception as e:
+        print(f"Could not validate config with `i3 -C -c {config_path}` (is i3 in the PATH?) {e}", file=sys.stderr)
+        return False
+
+def print_help():
+    """Print help information."""
+    print("""Usage: i3-style [OPTIONS] <theme>
+
+Apply a theme to an i3 config file.
+
+Options:
+  -h, --help            Show this help message and exit
+  -l, --list-all        Print a list of all available themes
+  -r, --reload          Apply the theme by reloading the config
+  -s, --save            Set the output file to the path of the input file
+  -V, --version         Print version information
+
+Options:
+  -c, --config <file>   The config file the theme should be applied to.
+                        Defaults to the default i3 location.
+  -o, --output <file>   Apply the theme, attempt to validate the result,
+                        and write it to <file>
+  -t, --to-theme <file> Prints an i3-style theme based on the given config
+                        suitable for sharing with others
+
+Examples:
+  i3-style slate
+  i3-style -c ~/.config/i3/config purple
+  i3-style -o ~/.config/i3/config.theme slate
+""")
+
+def print_version():
+    """Print version information."""
+    print(f"i3-style {VERSION}")
+
+def print_themes():
+    """Print a list of all available themes."""
+    for theme in sorted(THEMES.keys()):
+        print(f"  {theme}: {THEMES[theme]}")
+
+def main():
+    """Main entry point."""
+    # Handle special flags first
+    if len(sys.argv) > 1:
+        if sys.argv[1] in ("-h", "--help"):
+            print_help()
+            sys.exit(0)
+        elif sys.argv[1] in ("-V", "--version"):
+            print_version()
+            sys.exit(0)
+        elif sys.argv[1] in ("-l", "--list-all"):
+            print_themes()
+            sys.exit(0)
+    
+    # Parse remaining arguments
+    args = sys.argv[1:]
+    
+    if not args:
+        print("Error: No theme specified", file=sys.stderr)
+        print("Use -h for help", file=sys.stderr)
+        sys.exit(1)
+    
+    # Parse options
+    config_file = None
+    output_file = None
+    to_theme_file = None
+    save_to_input = False
+    reload_config = False
+    
+    i = 0
+    while i < len(args):
+        arg = args[i]
+        if arg in ("-c", "--config"):
+            if i + 1 >= len(args):
+                print("Error: --config requires an argument", file=sys.stderr)
+                sys.exit(1)
+            config_file = args[i + 1]
+            i += 2
+        elif arg in ("-o", "--output"):
+            if i + 1 >= len(args):
+                print("Error: --output requires an argument", file=sys.stderr)
+                sys.exit(1)
+            output_file = args[i + 1]
+            i += 2
+        elif arg in ("-t", "--to-theme"):
+            if i + 1 >= len(args):
+                print("Error: --to-theme requires an argument", file=sys.stderr)
+                sys.exit(1)
+            to_theme_file = args[i + 1]
+            i += 2
+        elif arg in ("-s", "--save"):
+            save_to_input = True
+            i += 1
+        elif arg in ("-r", "--reload"):
+            reload_config = True
+            i += 1
+        else:
+            # Assume it's a theme name
+            theme_name = arg
+            i += 1
+            break
+    
+    if not theme_name:
+        print("Error: No theme specified", file=sys.stderr)
+        print("Use -h for help", file=sys.stderr)
+        sys.exit(1)
+    
+    if theme_name not in THEMES:
+        print(f"Error: Unknown theme '{theme_name}'", file=sys.stderr)
+        print("Use -l to list available themes", file=sys.stderr)
+        sys.exit(1)
+    
+    config_path = get_config_path(config_file)
+    config = load_config(config_path)
+    
+    if to_theme_file:
+        # Validate config first
+        if not validate_config(config_path):
+            sys.exit(1)
+        # Generate theme from config
+        theme_content = f"""# Theme generated from: {config_path}
+# Generated by i3-style {VERSION}
+
+// darkgray: {THEME_COLORS[theme_name].get('darkgray', '#AAAAAA')}
+// darkslategray: {THEME_COLORS[theme_name].get('darkslategray', '#222133')}
+// white: {THEME_COLORS[theme_name].get('white', '#FFFFFF')}
+// darkslateblue: {THEME_COLORS[theme_name].get('darkslateblue', '#664477')}
+// lightgray: {THEME_COLORS[theme_name].get('lightgray', '#CCCCCC')}
+// indianred: {THEME_COLORS[theme_name].get('indianred', '#CE4045')}
+
+// window_colors:
+//   focused: {", ".join(THEME_COLORS[theme_name].get("window_colors", {}).get("focused", []))}
+//   focused_inactive: {", ".join(THEME_COLORS[theme_name].get("window_colors", {}).get("focused_inactive", []))}
+//   unfocused: {", ".join(THEME_COLORS[theme_name].get("window_colors", {}).get("unfocused", []))}
+//   urgent: {", ".join(THEME_COLORS[theme_name].get("window_colors", {}).get("urgent", []))}
+
+// bar_colors:
+//   separator: {THEME_COLORS[theme_name].get("bar_colors", {}).get("separator", "#AAAAAA")}
+//   background: {THEME_COLORS[theme_name].get("bar_colors", {}).get("background", "#222133")}
+//   statusline: {THEME_COLORS[theme_name].get("bar_colors", {}).get("statusline", "#FFFFFF")}
+//   focused_workspace: {", ".join(THEME_COLORS[theme_name].get("bar_colors", {}).get("focused_workspace", []))}
+//   active_workspace: {", ".join(THEME_COLORS[theme_name].get("bar_colors", {}).get("active_workspace", []))}
+//   inactive_workspace: {", ".join(THEME_COLORS[theme_name].get("bar_colors", {}).get("inactive_workspace", []))}
+//   urgent_workspace: {", ".join(THEME_COLORS[theme_name].get("bar_colors", {}).get("urgent_workspace", []))}
+"""
+        with open(to_theme_file, 'w') as f:
+            f.write(theme_content)
+        print(f"Theme written to {to_theme_file}")
+        sys.exit(0)
+    
+    # Apply theme
+    new_config = apply_theme_to_config(config, theme_name)
+    
+    if output_file:
+        output_path = output_file
+    elif save_to_input:
+        output_path = config_path
+    else:
+        output_path = None
+    
+    if output_path:
+        try:
+            with open(output_path, 'w') as f:
+                f.write(new_config)
+            
+            if not reload_config:
+                # Validate if not reloading
+                if validate_config(output_path):
+                    pass
+                else:
+                    sys.exit(1)
+        except Exception as e:
+            print(f"Error writing config: {e}", file=sys.stderr)
+            sys.exit(1)
+    else:
+        # Just print the themed config
+        print(new_config)
+    
+    if reload_config:
+        try:
+            subprocess.run(["i3", "reload"], check=True)
+            print("Config reloaded")
+        except subprocess.CalledProcessError as e:
+            print(f"Error reloading config: {e}", file=sys.stderr)
+            sys.exit(1)
+        except FileNotFoundError:
+            print("i3 not found in PATH", file=sys.stderr)
+            sys.exit(1)
+
+if __name__ == "__main__":
+    main()
