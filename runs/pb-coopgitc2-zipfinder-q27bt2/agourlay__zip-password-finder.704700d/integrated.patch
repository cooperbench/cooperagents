+use clap::{Arg, Command};
+use std::fs::File;
+use std::io::{BufRead, BufReader};
+use std::process::exit;
+use std::time::Instant;
+use flate2::read::ZlibDecoder;
+
+
+const VERSION: &str = "0.10.3";
+
+fn main() {
+    let matches = Command::new("zip-password-finder")
+        .bin_name("zip-password-finder")
+        .version(VERSION)
+        .arg(
+            Arg::new("inputFile")
+                .short('i')
+                .long("inputFile")
+                .help("path to zip input file")
+                .required(true),
+        )
+        .arg(
+            Arg::new("workers")
+                .short('w')
+                .long("workers")
+                .help("number of workers"),
+        )
+        .arg(
+            Arg::new("passwordDictionary")
+                .short('p')
+                .long("passwordDictionary")
+                .help("path to a password dictionary file"),
+        )
+        .arg(
+            Arg::new("charset")
+                .short('c')
+                .long("charset")
+                .help("charset to use to generate password"),
+        )
+        .arg(
+            Arg::new("charsetFile")
+                .long("charsetFile")
+                .help("path to a charset file"),
+        )
+        .arg(
+            Arg::new("minPasswordLen")
+                .long("minPasswordLen")
+                .help("minimum password length"),
+        )
+        .arg(
+            Arg::new("maxPasswordLen")
+                .long("maxPasswordLen")
+                .help("maximum password length"),
+        )
+        .arg(
+            Arg::new("fileNumber")
+                .long("fileNumber")
+                .help("file number in the zip archive"),
+        )
+        .arg(
+            Arg::new("startingPassword")
+                .short('s')
+                .long("startingPassword")
+                .help("password to start from"),
+        )
+        .get_matches();
+
+    let input_file = matches.get_one::<String>("inputFile").unwrap();
+    let workers: usize = matches.get_one::<String>("workers")
+        .and_then(|w| w.parse().ok())
+        .or_else(|| std::thread::available_parallelism().map(|p| p.get()).ok())
+        .unwrap_or(1);
+    let password_dict = matches.get_one::<String>("passwordDictionary");
+    let charset = matches.get_one::<String>("charset").map(|s| s.clone()).unwrap_or_else(|| "lud".to_string());
+    let charset_file = matches.get_one::<String>("charsetFile");
+    let min_len: usize = matches.get_one::<String>("minPasswordLen").map(|s| s.parse().unwrap_or(1)).unwrap_or(1);
+    let max_len: usize = matches.get_one::<String>("maxPasswordLen").map(|s| s.parse().unwrap_or(10)).unwrap_or(10);
+    let file_number: usize = matches.get_one::<String>("fileNumber").map(|s| s.parse().unwrap_or(0)).unwrap_or(0);
+    let starting_password = matches.get_one::<String>("startingPassword");
+
+    // Read zip file
+    let zip_data = match std::fs::read(input_file) {
+        Ok(data) => data,
+        Err(e) => {
+            eprintln!("Error reading file: {}", e);
+            exit(1);
+        }
+    };
+
+    // Parse zip and find the entry
+    let entry = match find_zip_entry(&zip_data, file_number) {
+        Some(entry) => entry,
+        None => {
+            eprintln!("No entry found at index {}", file_number);
+            exit(1);
+        }
+    };
+    
+    // Get charset
+    let charset_bytes = get_charset(&charset, charset_file);
+
+    // Start timing
+    let start = Instant::now();
+
+    // Try candidates
+    let result = if let Some(dict_path) = password_dict {
+        // Dictionary mode
+        find_password_dict(&entry, dict_path, starting_password.as_ref().map(|x| x.as_str()))
+    } else {
+        // Brute force mode
+        find_password(&entry, &charset_bytes, min_len, max_len, workers, starting_password.as_ref().map(|x| x.as_str()))
+    };
+
+    let elapsed = start.elapsed();
+    println!("Time elapsed: {}", format_duration(elapsed));
+
+    if let Some(pw) = result {
+        println!("Password found:{}", pw);
+    } else {
+        println!("Password not found");
+    }
+}
+
+fn format_duration(duration: std::time::Duration) -> String {
+    let total_ns = duration.as_nanos() as u64;
+    let seconds = total_ns / 1_000_000_000;
+    let minutes = seconds / 60;
+    let hours = minutes / 60;
+    let rem_seconds = seconds % 60;
+    let rem_minutes = minutes % 60;
+    let rem_ms = (total_ns % 1_000_000_000) / 1_000_000;
+    let rem_us = (total_ns % 1_000_000_000) % 1_000_000 / 1_000;
+    let rem_ns = (total_ns % 1_000_000_000) % 1_000_000 % 1_000;
+
+    let mut parts = Vec::new();
+    if hours > 0 {
+        parts.push(format!("{}h", hours));
+    }
+    if rem_minutes > 0 {
+        parts.push(format!("{}m", rem_minutes));
+    }
+    if rem_seconds > 0 {
+        parts.push(format!("{}s", rem_seconds));
+    }
+    if rem_ms > 0 {
+        parts.push(format!("{}ms", rem_ms));
+    }
+    if rem_us > 0 {
+        parts.push(format!("{}us", rem_us));
+    }
+    parts.push(format!("{}ns", rem_ns));
+    parts.join(" ")
+}
+
+struct ZipEntry {
+    method: u16,
+    crc: u32,
+    data: Vec<u8>,
+    is_aes: bool,
+    aes_key_len: u8,
+}
+
+fn find_zip_entry(zip_data: &[u8], file_number: usize) -> Option<ZipEntry> {
+    // Find central directory
+    let cd_start = find_central_directory(zip_data)?;
+    
+    let mut count = 0;
+    let mut i = cd_start;
+    while i + 4 <= zip_data.len() && zip_data[i..i+4] == [0x50, 0x4b, 0x01, 0x02] {
+        // Parse central directory entry
+        if count == file_number {
+            return parse_central_header(zip_data, i);
+        }
+        // Skip to next central directory entry
+        let extra_len = u16::from_le_bytes([zip_data[i+30], zip_data[i+31]]) as usize;
+        let comment_len = u16::from_le_bytes([zip_data[i+32], zip_data[i+33]]) as usize;
+        i += 46 + extra_len + comment_len;
+        count += 1;
+    }
+    None
+}
+
+fn find_central_directory(zip_data: &[u8]) -> Option<usize> {
+    // Find end of central directory record - look for PK\x05\x06 (4-byte signature)
+    let eocd_pos = zip_data.windows(4).position(|w| w == [0x50, 0x4b, 0x05, 0x06])?;
+    
+    // Parse EOCD - CD offset is at offset 16 within the EOCD record
+    let cd_offset = u32::from_le_bytes([zip_data[eocd_pos+16], zip_data[eocd_pos+17], zip_data[eocd_pos+18], zip_data[eocd_pos+19]]) as usize;
+    
+    Some(cd_offset)
+}
+
+fn parse_central_header(zip_data: &[u8], offset: usize) -> Option<ZipEntry> {
+    let method = u16::from_le_bytes([zip_data[offset+10], zip_data[offset+11]]);
+    let crc = u32::from_le_bytes([zip_data[offset+16], zip_data[offset+17], zip_data[offset+18], zip_data[offset+19]]);
+    let comp_size = u32::from_le_bytes([zip_data[offset+20], zip_data[offset+21], zip_data[offset+22], zip_data[offset+23]]) as usize;
+    let lho = u32::from_le_bytes([zip_data[offset+42], zip_data[offset+43], zip_data[offset+44], zip_data[offset+45]]) as usize;
+    
+    // Get local header to find actual data offset
+    let local_data_start = get_local_data_offset(zip_data, lho as usize)?;
+    // Check for AES in extra field (extra field follows the file name)
+    let fname_len = u16::from_le_bytes([zip_data[offset + 28], zip_data[offset + 29]]) as usize;
+    let (is_aes, aes_key_len) = parse_aes_extra(zip_data, offset + 46 + fname_len);
+    
+    // Read data
+    let data = zip_data[local_data_start..local_data_start + comp_size].to_vec();
+    Some(ZipEntry { method, crc, data, is_aes, aes_key_len })
+}
+
+fn get_local_data_offset(zip_data: &[u8], lho: usize) -> Option<usize> {
+    let name_len = u16::from_le_bytes([zip_data[lho+26], zip_data[lho+27]]) as usize;
+    let extra_len = u16::from_le_bytes([zip_data[lho+28], zip_data[lho+29]]) as usize;
+    Some(lho + 30 + name_len + extra_len)
+}
+
+fn parse_aes_extra(zip_data: &[u8], extra_start: usize) -> (bool, u8) {
+    // Look for 0x0001 (AES) or 0x9900 (vendor) extra field
+    let extra = &zip_data[extra_start..extra_start.min(zip_data.len())];
+    let mut i = 0;
+    while i + 4 <= extra.len() {
+        let id = u16::from_le_bytes([extra[i], extra[i+1]]);
+        let len = u16::from_le_bytes([extra[i+2], extra[i+3]]) as usize;
+        if id == 0x0001 || id == 0x9900 {
+            // AES: version, vendor, key length
+            if i + 6 <= extra.len() {
+                let key_len = u16::from_le_bytes([extra[i+4], extra[i+5]]);
+                let key_len = match key_len {
+                    1 => 0x01,
+                    2 => 0x03,
+                    3 => 0x04,
+                    _ => 0,
+                };
+                return (true, key_len);
+            }
+        }
+        i += 4 + len;
+    }
+    (false, 0)
+}
+
+fn get_charset(charset_str: &str, charset_file: Option<&String>) -> Vec<u8> {
+    if let Some(f) = charset_file {
+        // Read from file
+        if let Ok(file) = File::open(f) {
+            let mut reader = BufReader::new(file);
+            let mut charset = Vec::new();
+            let mut line = String::new();
+            while reader.read_line(&mut line).unwrap() > 0 {
+                for c in line.chars() {
+                    charset.push(c as u8);
+                }
+                line.clear();
+            }
+            return charset;
+        }
+    }
+    
+    // Built-in charset
+    let mut charset = Vec::new();
+    for c in charset_str.chars() {
+        match c {
+            'l' => charset.extend((b'a'..=b'z').map(|c| c as u8)),
+            'u' => charset.extend((b'A'..=b'Z').map(|c| c as u8)),
+            'd' => charset.extend((b'0'..=b'9').map(|c| c as u8)),
+            'h' => charset.extend(b"0123456789abcdef".iter().copied()),
+            'H' => charset.extend(b"0123456789ABCDEF".iter().copied()),
+            's' => charset.extend(b"!@#$%^&*()_+-=[]{}|;:'\\,./<>?\"".iter().copied()),
+            _ => charset.push(c as u8),
+        }
+    }
+    charset
+}
+
+fn verify_password(entry: &ZipEntry, password: &str) -> bool {
+    if entry.is_aes {
+        verify_aes(entry, password)
+    } else {
+        verify_zipcrypto(entry, password)
+    }
+}
+
+fn zipcrypto_update_keys(k0: u32, k1: u32, k2: u32, c: u8) -> (u32, u32, u32) {
+    // Matches python zipfile._ZipDecrypter.update_keys:
+    //   key0 = crc32(c, key0)
+    //   key1 = (key1 + (key0 & 0xff)) & 0xffffffff
+    //   key1 = (key1 * 134775813 + 1) & 0xffffffff
+    //   key2 = crc32(key1 >> 24, key2)
+    let k0 = crc32_update(k0, c);
+    let k1 = k1.wrapping_add(k0 & 0xff);
+    let k1 = k1.wrapping_mul(134775813).wrapping_add(1);
+    let k2 = crc32_update(k2, (k1 >> 24) as u8);
+    (k0, k1, k2)
+}
+
+fn verify_zipcrypto(entry: &ZipEntry, password: &str) -> bool {
+    // Standard ZipCrypto (matches python zipfile._ZipDecrypter)
+    let mut k0 = 0x12345678u32;
+    let mut k1 = 0x23456789u32;
+    let mut k2 = 0x34567890u32;
+
+    // Seed the keys with each password byte.
+    for b in password.bytes() {
+        let (a, b_, c) = zipcrypto_update_keys(k0, k1, k2, b);
+        k0 = a;
+        k1 = b_;
+        k2 = c;
+    }
+
+    // Decrypt the 12-byte header; the 12th byte (index 11) must equal the
+    // high byte of the (central directory) CRC.
+    let expected = ((entry.crc >> 24) & 0xff) as u8;
+
+    for (i, &cipher) in entry.data.iter().take(12).enumerate() {
+        // keystream byte = ((k2 | 2) * ((k2 | 2) ^ 1) >> 8) & 0xff
+        let k = k2 | 2;
+        let keystream = ((k as u64 * (k ^ 1) as u64) >> 8) as u8;
+        let decrypted = cipher ^ keystream;
+
+        let (a, b_, c) = zipcrypto_update_keys(k0, k1, k2, decrypted);
+        k0 = a;
+        k1 = b_;
+        k2 = c;
+
+        if i == 11 {
+            return decrypted == expected;
+        }
+    }
+
+    false
+}
+
+fn verify_aes(entry: &ZipEntry, password: &str) -> bool {
+    // AES with PBKDF2-HMAC-SHA1
+    // Format: salt (8 bytes) + verify (2 bytes) + ciphertext
+    let salt = &entry.data[..8];
+    let verify = &entry.data[8..10];
+    
+    // Derive key using PBKDF2-HMAC-SHA1
+    let dk = pbkdf2_hmac_sha1(password.as_bytes(), salt, 10000, 34);
+    let expected_verify = &dk[32..34];
+    
+    verify == expected_verify
+}
+
+fn crc32_update(mut c: u32, b: u8) -> u32 {
+    c ^= b as u32;
+    for _ in 0..8 {
+        c = if c & 1 == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 };
+    }
+    c
+}
+
+fn pbkdf2_hmac_sha1(password: &[u8], salt: &[u8], iterations: u32, dk_len: usize) -> Vec<u8> {
+    // PBKDF2-HMAC-SHA1
+    let mut dk = Vec::with_capacity(dk_len);
+    let mut block = 1u32;
+    
+    while dk.len() < dk_len {
+        // T_i = F(P, C, i)
+        let mut t = vec![0u8; 20]; // SHA1 output length
+        let mut u = hmac_sha1(password, &concat(salt, &block.to_le_bytes()));
+        
+        for _ in 1..iterations {
+            u = hmac_sha1(password, &u);
+            for i in 0..20 {
+                t[i] ^= u[i];
+            }
+        }
+        
+        for &b in &t {
+            dk.push(b);
+            if dk.len() == dk_len {
+                break;
+            }
+        }
+        
+        block += 1;
+    }
+    
+    dk.truncate(dk_len);
+    dk
+}
+
+fn concat(a: &[u8], b: &[u8]) -> Vec<u8> {
+    let mut v = Vec::with_capacity(a.len() + b.len());
+    v.extend_from_slice(a);
+    v.extend_from_slice(b);
+    v
+}
+
+fn hmac_sha1(key: &[u8], data: &[u8]) -> Vec<u8> {
+    // HMAC-SHA1
+    let mut block = vec![0u8; 64];
+    if key.len() > 64 {
+        let hash = sha1(key);
+        block[..20].copy_from_slice(&hash);
+    } else {
+        block[..key.len()].copy_from_slice(key);
+    }
+    
+    let mut inner = vec![0u8; 64];
+    for b in &block {
+        inner[*b as usize] = *b ^ 0x36;
+    }
+    
+    let mut outer = vec![0u8; 64];
+    for b in &block {
+        outer[*b as usize] = *b ^ 0x5c;
+    }
+    
+    let inner_hash = sha1(&concat(&inner, data));
+    let outer_hash = sha1(&concat(&outer, &inner_hash));
+    outer_hash[..20].to_vec()
+}
+
+fn sha1(data: &[u8]) -> Vec<u8> {
+    // SHA1 implementation
+    let mut h0 = 0x67452301u32;
+    let mut h1 = 0xEF79798Fu32;
+    let mut h2 = 0x943B77F0u32;
+    let mut h3 = 0x3024C73Bu32;
+    let mut h4 = 0xBB67A848u32;
+    
+    // Padding
+    let mut padded = data.to_vec();
+    padded.push(0x80);
+    while padded.len() % 64 != 56 {
+        padded.push(0);
+    }
+    padded.extend_from_slice(&(data.len() as u64).to_be_bytes());
+    
+    // Process each 512-bit chunk
+    for chunk in padded.chunks(64) {
+        let mut w = [0u32; 80];
+        for i in 0..16 {
+            w[i] = u32::from_be_bytes([chunk[i*4], chunk[i*4+1], chunk[i*4+2], chunk[i*4+3]]);
+        }
+        for i in 16..80 {
+            w[i] = w[i-3] ^ w[i-8] ^ w[i-14] ^ w[i-16];
+            w[i] = w[i].rotate_left(1);
+        }
+        
+        let (mut a, mut b, mut c, mut d, mut e) = (h0, h1, h2, h3, h4);
+        
+        for i in 0..80 {
+            let f;
+            let k;
+            if i < 20 {
+                f = (b & c) | ((!b) & d);
+                k = 0x5A827999;
+            } else if i < 40 {
+                f = b ^ c ^ d;
+                k = 0x6ED9EBA1;
+            } else if i < 60 {
+                f = (b & c) | (b & d) | (c & d);
+                k = 0x7FCAAA75;
+            } else {
+                f = b ^ c ^ d;
+                k = 0xFF61A345;
+            }
+            
+            let temp = a.wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[i]);
+            e = d;
+            d = c;
+            c = b.rotate_left(10);
+            b = a;
+            a = temp;
+        }
+        
+        h0 = h0.wrapping_add(a);
+        h1 = h1.wrapping_add(b);
+        h2 = h2.wrapping_add(c);
+        h3 = h3.wrapping_add(d);
+        h4 = h4.wrapping_add(e);
+    }
+    
+    // Output
+    let mut result = Vec::with_capacity(20);
+    result.extend_from_slice(&h0.to_be_bytes());
+    result.extend_from_slice(&h1.to_be_bytes());
+    result.extend_from_slice(&h2.to_be_bytes());
+    result.extend_from_slice(&h3.to_be_bytes());
+    result.extend_from_slice(&h4.to_be_bytes());
+    result
+}
+
+fn find_password_dict(entry: &ZipEntry, dict_path: &str, starting_password: Option<&str>) -> Option<String> {
+    // Try starting password first
+    if let Some(pw) = starting_password {
+        if verify_password(entry, pw) {
+            return Some(pw.to_string());
+        }
+    }
+    
+    // Read dictionary
+    let file = File::open(dict_path).ok()?;
+    let reader = BufReader::new(file);
+    
+    for line in reader.lines() {
+        let line = line.ok()?;
+        let result = verify_password(entry, &line);
+        if result {
+            return Some(line);
+        }
+    }
+    
+    None
+}
+
+fn find_password(entry: &ZipEntry, charset: &[u8], min_len: usize, max_len: usize, _workers: usize, starting_password: Option<&str>) -> Option<String> {
+    // Try starting password first
+    if let Some(pw) = starting_password {
+        if verify_password(entry, pw) {
+            return Some(pw.to_string());
+        }
+    }
+    
+    // Brute force
+    for len in min_len..=max_len {
+        if let Some(pw) = brute_force_len(entry, charset, len) {
+            return Some(pw);
+        }
+    }
+    None
+}
+
+fn brute_force_len(entry: &ZipEntry, charset: &[u8], len: usize) -> Option<String> {
+    if len == 0 {
+        if verify_password(entry, "") {
+            return Some(String::new());
+        }
+        return None;
+    }
+
+    let n = charset.len();
+    if n == 0 {
+        return None;
+    }
+
+    // Enumerate the Cartesian product of the charset, one index per position.
+    // Counting is little-endian: the leftmost position changes fastest.
+    let mut idx: Vec<usize> = vec![0; len];
+
+    loop {
+        let mut pw = Vec::with_capacity(len);
+        for &i in &idx {
+            pw.push(charset[i]);
+        }
+        let pws = String::from_utf8_lossy(&pw);
+        if verify_password(entry, &pws) {
+            return Some(pws.into_owned());
+        }
+
+        // Increment with carry.
+        let mut i = 0;
+        while i < len {
+            idx[i] += 1;
+            if idx[i] < n {
+                break;
+            }
+            idx[i] = 0;
+            i += 1;
+        }
+        if i == len {
+            return None;
+        }
+    }
+}
