diff --git a/screen.c b/screen.c
new file mode 100644
index 0000000..36543e8
--- /dev/null
+++ b/screen.c
@@ -0,0 +1,178 @@
+#include "screen.h"
+#include <sys/select.h>
+
+// Global variables
+int g_width = 80;
+int g_height = 24;
+int g_bold = 0;
+int g_color_index = 0;
+char *g_color = NULL;
+int g_message_length = 0;
+int g_async_scroll = 0;
+int g_update_delay = 4;
+int g_use_rainbow = 0;
+int g_use_color = 0;
+int g_use_B = 0;
+int g_use_n = 0;
+
+// Terminal settings
+struct termios g_old_termios;
+
+// Signal handler
+void signal_handler(int sig) {
+    (void)sig;
+    screen_exit(0);
+}
+
+// Get random character
+char get_random_char(void) {
+    static const char *chars = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()_+-=[]{}|;':,./<>?";
+    return chars[rand() % strlen(chars)];
+}
+
+// Get color code
+char* get_color_code(void) {
+    if (g_use_rainbow) {
+        g_color_index = (g_color_index + 1) % 8;
+        return COLOR_RESET;
+    }
+    if (g_use_color) {
+        if (strcmp(g_color, "red") == 0) return COLOR_RED;
+        if (strcmp(g_color, "green") == 0) return COLOR_GREEN;
+        if (strcmp(g_color, "blue") == 0) return COLOR_BLUE;
+        if (strcmp(g_color, "white") == 0) return COLOR_WHITE;
+        if (strcmp(g_color, "yellow") == 0) return COLOR_YELLOW;
+        if (strcmp(g_color, "cyan") == 0) return COLOR_CYAN;
+        if (strcmp(g_color, "magenta") == 0) return COLOR_MAGENTA;
+        if (strcmp(g_color, "black") == 0) return COLOR_BLACK;
+    }
+    return COLOR_GREEN;
+}
+
+// Get bold code
+char* get_bold_code(void) {
+    if (g_use_B) {
+        return COLOR_BOLD;
+    }
+    if (g_use_n) {
+        return "";
+    }
+    if (g_bold) {
+        return COLOR_BOLD;
+    }
+    return "";
+}
+
+// Initialize screen
+void screen_init(void) {
+    screen_get_size(&g_width, &g_height);
+    srand(time(NULL));
+}
+
+// Clear screen
+void screen_clear(void) {
+    printf("\033[2J\033[H");
+}
+
+// Print a character at position
+void screen_print_char(int x, int y, char c, int color, int bold) {
+    printf("\033[%d;%dH%s%s%c%s", x + 1, y + 1, get_color_code(), get_bold_code(), c, COLOR_RESET);
+}
+
+// Print message
+void screen_print_message(const char *msg) {
+    if (g_message_length == 0) {
+        g_message_length = strlen(msg);
+    }
+    printf("\033[%d;%dH%s", g_width / 2 - g_message_length / 2, g_height / 2, msg);
+}
+
+// Update screen
+void screen_update(void) {
+    for (int y = 0; y < g_height; y++) {
+        for (int x = 0; x < g_width; x++) {
+            char c = get_random_char();
+            screen_print_char(x, y, c, 1, g_bold);
+        }
+    }
+}
+
+// Handle keyboard input
+int screen_handle_input(void) {
+    fd_set readfds;
+    struct timeval timeout;
+    
+    FD_ZERO(&readfds);
+    FD_SET(STDIN_FILENO, &readfds);
+    
+    timeout.tv_sec = 0;
+    timeout.tv_usec = 100000;
+    
+    if (select(STDIN_FILENO + 1, &readfds, NULL, NULL, &timeout) > 0) {
+        char c;
+        if (read(STDIN_FILENO, &c, 1) > 0) {
+            if (c == 'q') {
+                return 1;
+            }
+            if (c == 'a') {
+                g_async_scroll = !g_async_scroll;
+            }
+            if (c == 'b') {
+                g_bold = !g_bold;
+            }
+            if (c == 'B') {
+                g_bold = 1;
+            }
+            if (c == 'n') {
+                g_bold = 0;
+            }
+            if (c >= '0' && c <= '9') {
+                g_update_delay = c - '0';
+            }
+            if (c == '!') { g_color_index = 0; }
+            if (c == '@') { g_color_index = 1; }
+            if (c == '#') { g_color_index = 2; }
+            if (c == '$') { g_color_index = 3; }
+            if (c == '%') { g_color_index = 4; }
+            if (c == '^') { g_color_index = 5; }
+            if (c == '&') { g_color_index = 6; }
+            if (c == ')') { g_color_index = 7; }
+        }
+    }
+    return 0;
+}
+
+// Set terminal settings
+void screen_set_termios(struct termios *old_termios) {
+    struct termios raw;
+    tcgetattr(STDIN_FILENO, &g_old_termios);
+    raw = g_old_termios;
+    raw.c_lflag &= ~(ECHO | ICANON);
+    raw.c_cc[VMIN] = 0;
+    raw.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+}
+
+// Reset terminal settings
+void screen_reset_termios(struct termios *old_termios) {
+    tcsetattr(STDIN_FILENO, TCSANOW, old_termios);
+}
+
+// Get terminal size
+void screen_get_size(int *cols, int *rows) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        *cols = ws.ws_col;
+        *rows = ws.ws_row;
+    } else {
+        *cols = 80;
+        *rows = 24;
+    }
+}
+
+// Exit program
+void screen_exit(int exit_code) {
+    screen_reset_termios(&g_old_termios);
+    screen_clear();
+    exit(exit_code);
+}
