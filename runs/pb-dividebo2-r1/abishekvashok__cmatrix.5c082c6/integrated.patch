+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <getopt.h>
+#include <signal.h>
+#include "options.h"
+#include "error.h"
+#include "screen.h"
+
+int main(int argc, char *argv[]) {
+    Options opts;
+    
+    // Initialize options with defaults
+    options_init(&opts);
+    
+    // Parse command line arguments
+    if (!options_parse(argc, argv, &opts)) {
+        return 1;
+    }
+    
+    // Handle --help
+    if (opts.help) {
+        options_print_usage(argv[0]);
+        return 0;
+    }
+    
+    // Handle --version
+    if (opts.version) {
+        options_print_version();
+        return 0;
+    }
+    
+    // Set global variables from options
+    g_use_color = opts.color != NULL;
+    g_use_rainbow = opts.rainbow_mode;
+    g_use_B = opts.all_bold;
+    g_use_n = opts.no_bold;
+    g_bold = opts.bold_chars;
+    g_update_delay = opts.update_delay;
+    g_color = opts.color;
+    
+    // Initialize screen
+    screen_init();
+    
+    // Set up signal handler
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+    
+    // Set terminal settings
+    screen_set_termios(NULL);
+    
+    // Print message if provided
+    if (opts.message) {
+        screen_print_message(opts.message);
+    }
+    
+    // Main loop
+    while (1) {
+        // Update screen
+        screen_update();
+        
+        // Handle keyboard input
+        if (screen_handle_input()) {
+            break;
+        }
+        
+        // Sleep for update delay
+        usleep(opts.update_delay * 100000);
+    }
+    
+    // Exit program
+    screen_exit(0);
+    return 0;
+}
