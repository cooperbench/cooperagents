+#include "options.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <getopt.h>
+
+// Initialize options with defaults
+void options_init(Options *opts) {
+    opts->async_scroll = 0;
+    opts->bold_chars = 0;
+    opts->all_bold = 0;
+    opts->force_term = 0;
+    opts->linux_mode = 0;
+    opts->old_scroll = 0;
+    opts->only_shadows = 0;
+    opts->lock_mode = 0;
+    opts->rainbow_mode = 0;
+    opts->lambda_mode = 0;
+    opts->chars_change = 0;
+    opts->x_window = 0;
+    opts->no_bold = 0;
+    opts->screensaver = 0;
+    opts->help = 0;
+    opts->version = 0;
+    opts->update_delay = 4;
+    opts->color = NULL;
+    opts->message = NULL;
+    opts->tty = NULL;
+}
+
+// Parse command line arguments
+int options_parse(int argc, char **argv, Options *opts) {
+    static struct option long_options[] = {
+        {"async", no_argument, 0, 'a'},
+        {"bold", no_argument, 0, 'b'},
+        {"all-bold", no_argument, 0, 'B'},
+        {"force", no_argument, 0, 'f'},
+        {"linux", no_argument, 0, 'l'},
+        {"old", no_argument, 0, 'o'},
+        {"shadows", no_argument, 0, 'c'},
+        {"lock", no_argument, 0, 'L'},
+        {"rainbow", no_argument, 0, 'r'},
+        {"lambda", no_argument, 0, 'm'},
+        {"change", no_argument, 0, 'k'},
+        {"x", no_argument, 0, 'x'},
+        {"no-bold", no_argument, 0, 'n'},
+        {"screensaver", no_argument, 0, 's'},
+        {"help", no_argument, 0, 'h'},
+        {"version", no_argument, 0, 'V'},
+        {"update", required_argument, 0, 'u'},
+        {"color", required_argument, 0, 'C'},
+        {"message", required_argument, 0, 'M'},
+        {"tty", required_argument, 0, 't'},
+        {0, 0, 0, 0}
+    };
+
+    int opt;
+    int option_index = 0;
+    
+    while ((opt = getopt_long(argc, argv, "abBcfhlmoLrkmxnsVh?u:C:M:t:", long_options, &option_index)) != -1) {
+        switch (opt) {
+            case 'a': opts->async_scroll = 1; break;
+            case 'b': opts->bold_chars = 1; break;
+            case 'B': opts->all_bold = 1; break;
+            case 'c': opts->only_shadows = 1; break;
+            case 'f': opts->force_term = 1; break;
+            case 'l': opts->linux_mode = 1; break;
+            case 'L': opts->lock_mode = 1; break;
+            case 'm': opts->lambda_mode = 1; break;
+            case 'o': opts->old_scroll = 1; break;
+            case 'r': opts->rainbow_mode = 1; break;
+            case 'k': opts->chars_change = 1; break;
+            case 'n': opts->no_bold = 1; break;
+            case 's': opts->screensaver = 1; break;
+            case 'x': opts->x_window = 1; break;
+            case 'V': opts->version = 1; break;
+            case 'h': opts->help = 1; break;
+            case '?': opts->help = 1; break;
+            case 'u': 
+                opts->update_delay = atoi(optarg);
+                if (opts->update_delay < 0 || opts->update_delay > 10) {
+                    error_exit("Invalid update delay", 1);
+                }
+                break;
+            case 'C':
+                if (!options_validate_color(optarg)) {
+                    error_invalid_color(optarg);
+                    return 0;
+                }
+                opts->color = optarg;
+                break;
+            case 'M':
+                opts->message = optarg;
+                break;
+            case 't':
+                opts->tty = optarg;
+                break;
+            default:
+                return 0;
+        }
+    }
+    
+    return 1;
+}
+
+// Print usage information
+void options_print_usage(const char *progname) {
+    printf(" Usage: %s -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n", progname);
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+// Print version information
+void options_print_version(void) {
+    printf(" CMatrix version 2.0 (compiled 22:13:51, Jun 11 2026)\n");
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+// Validate color
+bool options_validate_color(const char *color) {
+    if (strcmp(color, "green") == 0) return 1;
+    if (strcmp(color, "red") == 0) return 1;
+    if (strcmp(color, "blue") == 0) return 1;
+    if (strcmp(color, "white") == 0) return 1;
+    if (strcmp(color, "yellow") == 0) return 1;
+    if (strcmp(color, "cyan") == 0) return 1;
+    if (strcmp(color, "magenta") == 0) return 1;
+    if (strcmp(color, "black") == 0) return 1;
+    return 0;
+}
