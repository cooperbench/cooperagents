+void print_help(void) {
+    printf("Tui app allows writing and managing journals/notes from within the terminal With different local back-ends\n");
+    printf("\n");
+    printf("Usage: executable [OPTIONS] [COMMAND]\n");
+    printf("\n");
+    printf("Commands:\n");
+    printf("  print-config     Print the current settings including the paths for the back-end files [aliases: pc]\n");
+    printf("  import-journals  Import journals from the given transfer JSON file to the current back-end file [aliases: imj]\n");
+    printf("  assign-priority  Assign priority for all the entries with empty priority field [aliases: ap]\n");
+    printf("  theme            Provides commands regarding changing themes and styles of the app [aliases: style]\n");
+    printf("  help             Print this message or the help of the given subcommand(s)\n");
+    printf("\n");
+    printf("Options:\n");
+    printf("  -j, --json-file-path <FILE PATH>    Sets the entries Json file path and starts using it\n");
+    printf("  -s, --sqlite-file-path <FILE PATH>  Sets the entries sqlite file path and starts using it\n");
+    printf("  -b, --backend-type <BACKEND_TYPE>   Sets the backend type and starts using it [possible values: json, sqlite]\n");
+    printf("  -c, --config <DIR PATH>             Specifies the path for the configuration directory.\n");
+    printf("                                      Configuration files is considered as root for themes file too.\n");
+    printf("                                      It still accepts the path for configuration file for backward compatibility.\n");
+    printf("                                      (default path: /home/agent/.config/tui-journal)\n");
+    printf("  -v, --verbose...                    Increases logging verbosity each use for up to 3 times\n");
+    printf("  -l, --log <FILE PATH>               Specifies a file to use for logging\n");
+    printf("                                      (default file: /home/agent/.cache/tui-journal/tui-journal.log)\n");
+    printf("  -h, --help                          Print help\n");
+    printf("  -V, --version                       Print version\n");
+}
+
+void print_config(void) {
+    char home[256];
+    if (getenv("HOME") != NULL) {
+        strncpy(home, getenv("HOME"), sizeof(home) - 1);
+        home[sizeof(home) - 1] = '\0';
+    } else {
+        strncpy(home, DEFAULT_HOME, sizeof(home) - 1);
+        home[sizeof(home) - 1] = '\0';
+    }
+    
+    char app_state_dir[512];
+    char json_file[512];
+    char sqlite_file[512];
+    
+    snprintf(app_state_dir, sizeof(app_state_dir), "%s/.local/state/tui-journal", home);
+    snprintf(json_file, sizeof(json_file), "%s/tui-journal/entries.json", home);
+    snprintf(sqlite_file, sizeof(sqlite_file), "%s/tui-journal/entries.db", home);
+    
+    printf("backend_type = \"Sqlite\"\n");
+    printf("scroll_per_page = 5\n");
+    printf("sync_os_clipboard = false\n");
+    printf("history_limit = 10\n");
+    printf("colored_tags = true\n");
+    printf("datum_visibility = \"show\"\n");
+    printf("app_state_dir = \"%s\"\n", app_state_dir);
+    printf("\n");
+    printf("[export]\n");
+    printf("show_confirmation = true\n");
+    printf("\n");
+    printf("[external_editor]\n");
+    printf("auto_save = false\n");
+    printf("temp_file_extension = \"txt\"\n");
+    printf("\n");
+    printf("[json_backend]\n");
+    printf("file_path = \"%s\"\n", json_file);
+    printf("\n");
+    printf("[sqlite_backend]\n");
+    printf("file_path = \"%s\"\n", sqlite_file);
+}
