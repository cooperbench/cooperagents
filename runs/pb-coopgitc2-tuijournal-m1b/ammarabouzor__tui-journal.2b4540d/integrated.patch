+        }
+        if (strcmp(theme_cmd, "print-default") == 0 || strcmp(theme_cmd, "default") == 0) {
+            print_default_themes();
+            return 0;
+        }
+        if (strcmp(theme_cmd, "write-defaults") == 0 || strcmp(theme_cmd, "write") == 0) {
+            write_default_themes();
+            return 0;
+        }
+        if (strcmp(theme_cmd, "help") == 0) {
