+/*
+ * Shellharden 4.3.1 -- reconstruction of the reference executable's behavior.
+ *
+ * Observed behavior of the reference binary:
+ *   - "--version" prints "4.3.1\n" and exits 0 (short-circuits, before any
+ *     files are opened); the first --version/-h/--help in argv wins.
+ *   - "--help" / "-h" prints the help text and exits 0 (same short-circuit).
+ *   - "--check", "--replace", "--transform", "--suggest", "--syntax",
+ *     "--syntax-suggest" are recognized and silently ignored.
+ *   - "--" stops option parsing; everything after it is a filename
+ *     (so a second "--" or a later "--check" is treated as a file path).
+ *   - Any other argument is a filename. The first filename that cannot be
+ *     opened produces an error on stderr of the form
+ *       <arg>: <strerror> (os error <errno>)
+ *     and the program exits 1.
+ *   - A file that opens successfully (including a directory) is otherwise
+ *     left untouched: no stdout/stderr output and the file is not modified.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "help_data.h"
+
+/* Recognized mode flags: parsed but do nothing in this build. */
+static int is_mode(const char *s)
+{
+    return !strcmp(s, "--check") ||
+           !strcmp(s, "--replace") ||
+           !strcmp(s, "--transform") ||
+           !strcmp(s, "--suggest") ||
+           !strcmp(s, "--syntax") ||
+           !strcmp(s, "--syntax-suggest");
+}
+
+int main(int argc, char **argv)
+{
+    int i;
+    int stop_opts = 0;       /* set when "--" is seen */
+    int file_idx[1024];      /* indices of argv that are file paths */
+    int nfiles = 0;
+
+    for (i = 1; i < argc; i++) {
+        if (!stop_opts) {
+            if (!strcmp(argv[i], "--version")) {
+                fputs("4.3.1\n", stdout);
+                return 0;
+            }
+            if (!strcmp(argv[i], "--help") || !strcmp(argv[i], "-h")) {
+                fwrite(HELP_DATA, 1, sizeof(HELP_DATA), stdout);
+                return 0;
+            }
+            if (!strcmp(argv[i], "--")) {
+                stop_opts = 1;
+                continue;
+            }
+            if (is_mode(argv[i]))
+                continue;
+        }
+        /* Everything else is a file path. */
+        if (nfiles < 1024)
+            file_idx[nfiles++] = i;
+    }
+
+    /* Open each file in order; the first failure is reported and is fatal. */
+    for (i = 0; i < nfiles; i++) {
+        const char *name = argv[file_idx[i]];
+        int fd = open(name, O_RDONLY);
+        if (fd < 0) {
+            fprintf(stderr, "%s: %s (os error %d)\n",
+                    name, strerror(errno), errno);
+            return 1;
+        }
+        close(fd);
+    }
+
+    return 0;
+}
diff --git a/shellharden.c b/shellharden.c
new file mode 100644
index 0000000..170bb00
--- /dev/null
+++ b/shellharden.c
@@ -0,0 +1,263 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+/* ===== colors ===== */
+#define RESET   "\x1b[m"
+#define C_CMD   "\x1b[0;38;2;192;0;128m"
+#define C_DQ    "\x1b[0;38;2;255;0;0m"
+#define C_SQ    "\x1b[0;38;2;255;204;85m"
+#define C_VAR   "\x1b[0;38;2;63;127;207m"
+#define C_ASSIGN "\x1b[0;38;2;0;127;255m"
+#define C_COMMENT "\x1b[0;1;38;2;120;144;96m"
+#define C_SUG   "\x1b[0;42m"
+#define C_DIFF  "\x1b[0;41m"
+#define C_ARITH "\x1b[0;38;2;192;0;192m"
+
+/* ===== modes ===== */
+enum { M_SYNTAX, M_SUGGEST, M_SYNTAX_SUG, M_TRANSFORM, M_CHECK };
+static int mode = M_SYNTAX_SUG;
+static int do_replace = 0;
+
+/* ===== output buffer ===== */
+typedef struct { char *buf; int len, cap; } Out;
+static Out out;
+static void out_ensure(int extra) {
+    if (out.len + extra + 1 > out.cap) {
+        int nc = out.cap ? out.cap * 2 : 8192;
+        while (nc < out.len + extra + 1) nc *= 2;
+        out.buf = realloc(out.buf, nc);
+    }
+}
+static void out_s(const char *s) {
+    int n = strlen(s);
+    out_ensure(n);
+    memcpy(out.buf + out.len, s, n);
+    out.len += n;
+    out.buf[out.len] = 0;
+}
+static void out_c(char c) {
+    out_ensure(1);
+    out.buf[out.len++] = c;
+    out.buf[out.len] = 0;
+}
+
+/* ===== token list ===== */
+enum { LIT, VAR, SUB, DQ, SQ, ARITH };
+typedef struct {
+    int kind;
+    int start, end;
+    int simple;    /* VAR: ${name} plain ident            */
+    int complex;   /* VAR: special form (keep braces)      */
+    int nound;     /* VAR: ${#n}/${!n} (never quoted)      */
+    int in_quote;  /* expansion inside a quote region      */
+    char *sub;     /* SUB: inner source                   */
+} Tok;
+typedef struct { Tok *t; int n, cap; } TL;
+static void tl_push(TL *l, Tok x) {
+    if (l->n >= l->cap) {
+        l->cap = l->cap ? l->cap * 2 : 64;
+        l->t = realloc(l->t, l->cap * sizeof(Tok));
+    }
+    l->t[l->n++] = x;
+}
+static void tl_free(TL *l) {
+    for (int i = 0; i < l->n; i++) if (l->t[i].sub) free(l->t[i].sub);
+    free(l->t);
+}
+static int is_ident(int c) { return isalnum(c) || c == '_'; }
+
+/*
+ * Lex src[0,len) at the given quote_state.
+ * quote_state: 0 = unquoted, 1 = inside double-quote,
+ * 2 = inside single-quote.  The DQ/SQ boundary chars are
+ * emitted as DQ/SQ tokens; the interior is lexed at the
+ * appropriate quote_state.
+ */
+static void lex(const char *src, int len, TL *l, int quote_state) {
+    int i = 0;
+    int lit_start = -1;
+
+    while (i < len) {
+        char c = src[i];
+
+        if (quote_state == 2) {
+            if (c == '\\' && i + 1 < len) { i += 2; continue; }
+            if (c == '\'') {
+                if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+                tl_push(l, (Tok){SQ, i, i+1, 0,0,0,0,0,NULL});
+                i++;
+                continue;
+            }
+            if (lit_start < 0) lit_start = i;
+            i++; continue;
+        }
+        if (quote_state == 1) {
+            if (c == '\\' && i + 1 < len) { i += 2; continue; }
+            if (c == '"') {
+                if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+                tl_push(l, (Tok){DQ, i, i+1, 0,0,0,0,0,NULL});
+                i++;
+                continue;
+            }
+            if (c == '$' && i + 1 < len && src[i+1] == '{') {
+                int j = i + 2, depth = 1;
+                while (j < len && depth > 0) { if (src[j]=='{') depth++; else if (src[j]=='}') depth--; j++; }
+                tl_push(l, (Tok){VAR, i, j, 0,0,0,1,0,NULL});
+                i = j; continue;
+            }
+            if (c == '$' && i + 1 < len && is_ident(src[i+1])) {
+                int j = i + 1; while (j < len && is_ident(src[j])) j++;
+                tl_push(l, (Tok){VAR, i, j, 1,0,0,1,0,NULL});
+                i = j; continue;
+            }
+            if (lit_start < 0) lit_start = i;
+            i++; continue;
+        }
+
+        if (c == '"') {
+            if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+            tl_push(l, (Tok){DQ, i, i+1, 0,0,0,0,0,NULL});
+            i++; continue;
+        }
+        if (c == '\'') {
+            if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+            tl_push(l, (Tok){SQ, i, i+1, 0,0,0,0,0,NULL});
+            i++; continue;
+        }
+        if (c == '$' && i + 1 < len) {
+            char n = src[i+1];
+            if (n == '(' && i + 2 < len && src[i+2] == '(') {
+                if (lit_start < 0) lit_start = i;
+                int j = i + 3, depth = 0;
+                for (; j < len; j++) {
+                    if (src[j] == '(') { depth++; continue; }
+                    if (src[j] == ')') {
+                        if (depth > 0) { depth--; continue; }
+                        if (j + 1 < len && src[j+1] == ')') { j++; break; }
+                        j--;
+                    }
+                }
+                int ar_end = (j < len && src[j] == ')') ? j + 1 : j;
+                if (ar_end < len && src[ar_end-1] == ')' && src[ar_end] == ')')
+                    ar_end = (j + 2 <= len) ? j + 2 : len;
+                i = (j < len) ? j : len;
+                if (j < len && src[j] == ')') i++;
+                continue;
+            }
+            if (n == '(') {
+                if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+                int j = i + 1, depth = 0;
+                for (; j < len; j++) {
+                    char d = src[j];
+                    if (d == '\\' && j + 1 < len) { j++; continue; }
+                    if (d == '"' || d == '\'') {
+                        char q = d; j++;
+                        for (; j < len; j++) {
+                            if (src[j] == '\\' && j + 1 < len) { j++; continue; }
+                            if (src[j] == q) break;
+                        }
+                        continue;
+                    }
+                    if (d == '(') { depth++; continue; }
+                    if (d == ')') { if (depth > 0) { depth--; continue; } break; }
+                }
+                if (j < len && src[j] == ')') j++;
+                int inlen = (j - 1) - (i + 2);
+                char *inner = NULL;
+                if (inlen > 0) { inner = malloc(inlen + 1); memcpy(inner, src + i + 2, inlen); inner[inlen] = 0; }
+                tl_push(l, (Tok){SUB, i, j, 0,0,0,0,0,inner});
+                i = j; continue;
+            }
+            if (n == '{') {
+                if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+                int j = i + 2, depth = 1;
+                while (j < len && depth > 0) { if (src[j]=='{') depth++; else if (src[j]=='}') depth--; j++; }
+                const char *b = src + i + 2;
+                int blen = (j - 1) - (i + 2);
+                int complex = 0, nound = 0;
+                if (blen > 0 && (b[0] == '#' || b[0] == '!')) nound = 1;
+                else {
+                    int k = 0; while (k < blen && is_ident(b[k])) k++;
+                    if (k < blen) {
+                        char op = b[k];
+                        if (op==':'||op=='#'||op=='%'||op=='+'||op=='-'||op=='?'||op=='*'||op=='/'||op=='<'||op=='>')
+                            complex = 1;
+                    }
+                }
+                tl_push(l, (Tok){VAR, i, j, (complex==0&&nound==0), complex, nound, 0, 0, NULL});
+                i = j; continue;
+            }
+            if (is_ident(n)) {
+                if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+                int j = i + 1; while (j < len && is_ident(src[j])) j++;
+                tl_push(l, (Tok){VAR, i, j, 1, 0, 0, 0, 0, NULL});
+                i = j; continue;
+            }
+        }
+        if (c == '`') {
+            if (lit_start >= 0) { tl_push(l, (Tok){LIT, lit_start, i, 0,0,0,0,0,NULL}); lit_start = -1; }
+            int j = i + 1;
+            for (; j < len; j++) {
+                char d = src[j];
+                if (d == '\\' && j + 1 < len) { j++; continue; }
+                if (d == '"' || d == '\'') {
+                    char q = d; j++;
+                    for (; j < len; j++) {
+                        if (src[j] == '\\' && j + 1 < len) { j++; continue; }
+                        if (src[j] == q) break;
+                    }
+                    continue;
+                }
+                if (d == '`') { j++; break; }
+            }
+            int inlen = (j - 1) - (i + 1);
+            char *inner = NULL;
+            if (inlen > 0) { inner = malloc(inlen + 1); memcpy(inner, src + i + 1, inlen); inner[inlen] = 0; }
+            tl_push(l, (Tok){SUB, i, j, 0,0,0,0,0,inner});
+            i = j; continue;
+        }
+        if (lit_start < 0) lit_start = i;
+        i++;
+    }
+    if (lit_start >= 0) tl_push(l, (Tok){LIT, lit_start, len, 0,0,0,0,0,NULL});
+}
+
+/* ===== render ===== */
+
+/* Render the inner source of a command substitution into the output,
+ * applying the same transform (recursion). */
+static void render_inner(const char *inner, TL *l);
+
+/* Color a char in a given base color (0 = plain). */
+static void put_col(char c, const char *color) {
+    if (color) out_s(color);
+    out_c(c);
+    if (color) out_s(RESET);
+}
+
+/* Render a single token's source bytes with the given base color. */
+static void emit_token(const Tok *t, const char *src, const char *color) {
+    int n = t->end - t->start;
+    if (color) out_s(color);
+    out_add(out.buf ? NULL : NULL, src + t->start, 0); /* placeholder */
+    /* actual emit: */
+    out_ensure(n);
+    memcpy(out.buf + out.len, src + t->start, n);
+    out.len += n;
+    out.buf[out.len] = 0;
+    if (color) out_s(RESET);
+}
+
+/* Forward decl for the word renderer. */
+static void render_word(TL *l, const char *src, int color_state);
+
+int main(int argc, char **argv) {
+    return 0;
+}
