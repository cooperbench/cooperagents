@@ -0,0 +1,62 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/stat.h>
+
+/* Shellharden 4.3.1 reconstruction */
+
+#define RESET "\x1b[m"
+/* foreground colors: ESC[0;38;2;R;G;Bm ; bold: ESC[0;1;38;2;R;G;Bm */
+
+enum {
+    MODE_SYNTAX = 0,
+    MODE_SUGGEST,
+    MODE_SYNTAX_SUGGEST,
+    MODE_TRANSFORM,
+    MODE_CHECK
+};
+
+int main(int argc, char **argv) {
+    int mode = MODE_SYNTAX_SUGGEST; /* default */
+    int replace = 0;
+    const char *files[256];
+    int nfiles = 0;
+    int want_stdin = 0;
+
+    for (int i = 1; i < argc; i++) {
+        const char *a = argv[i];
+        if (strcmp(a, "--suggest") == 0) { mode = MODE_SUGGEST; }
+        else if (strcmp(a, "--syntax") == 0) { mode = MODE_SYNTAX; }
+        else if (strcmp(a, "--syntax-suggest") == 0) { mode = MODE_SYNTAX_SUGGEST; }
+        else if (strcmp(a, "--transform") == 0) { mode = MODE_TRANSFORM; }
+        else if (strcmp(a, "--check") == 0) { mode = MODE_CHECK; }
+        else if (strcmp(a, "--replace") == 0) { replace = 1; }
+        else if (strcmp(a, "--") == 0) {
+            for (int j = i+1; j < argc; j++) {
+                if (nfiles < 256) files[nfiles++] = argv[j];
+            }
+            break;
+        }
+        else if (strcmp(a, "-h") == 0 || strcmp(a, "--help") == 0) {
+            printf(HelpText);
+            /* continue processing */
+        }
+        else if (strcmp(a, "--version") == 0) {
+            printf("4.3.1\n");
+        }
+        else if (a[0] == '-' && a[1] != '\0') {
+            fprintf(stderr, "%s: No such option.\n", a);
+            /* exit 3 */
+            return 3;
+        }
+        else if (strcmp(a, "") == 0) {
+            want_stdin = 1;
+        }
+        else {
+            if (nfiles < 256) files[nfiles++] = a;
+        }
+    }
+    (void)replace; (void)want_stdin; (void)nfiles;
+    return 0;
+}
