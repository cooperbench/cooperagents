+process_input() {
+    local input="$1"
+    local mode="$2"
+    local line_num=0
+    
+    while IFS= read -r line || [[ -n "$line" ]]; do
+        ((line_num++))
+        
+        if [[ "$mode" == "suggest" ]]; then
+            local transformed
+            transformed=$(transform_line "$line")
+            if [[ "$line" != "$transformed" ]]; then
+                echo -e "${BG_SUGGEST}${line}${BG_SUGGEST_END}"
+                echo -e "${BG_SUGGEST}${transformed}${BG_SUGGEST_END}"
+            else
+                echo "$line"
+            fi
+        elif [[ "$mode" == "syntax" ]]; then
+            syntax_highlight_line "$line"
+        elif [[ "$mode" == "syntax-suggest" ]]; then
+            local transformed
+            transformed=$(transform_line "$line")
+            if [[ "$line" != "$transformed" ]]; then
+                echo -e "${BG_SUGGEST}${line}${BG_SUGGEST_END}"
+                echo -e "${BG_SUGGEST}${transformed}${BG_SUGGEST_END}"
+            else
+                syntax_highlight_line "$line"
+            fi
+        elif [[ "$mode" == "transform" ]]; then
+            transform_line "$line"
+        fi
+    done <<< "$input"
+}
