+def is_optimal(tableau):
+    """A maximisation tableau is optimal when every reduced cost (objective
+    row, excluding Z and RHS) is >= -EPS."""
+    obj = tableau[-1]
+    last = len(obj)
+    for j in range(1, last - 1):
+        if obj[j] < -EPS:
+            return False
+    return True
