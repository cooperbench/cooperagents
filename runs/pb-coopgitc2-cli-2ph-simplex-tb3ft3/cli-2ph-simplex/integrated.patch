++
++def _round2(v):
++    """Half-up rounding to 2 decimals; values that round to zero are
++    rendered as positive ``0.00`` (never ``-0.00``)."""
++    d = Decimal(str(float(v))).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
++    if d == 0:
++        d = d.copy_abs()
++    return d
++
++
++def _terms_text(coeffs):
++    """Order positive terms first, then negative, then zero (each group in
++    ascending variable-index order) and join them.
++
++    The leading term carries no separator; later terms are prefixed with
++    ``" + "`` (positive / zero) or ``" - "`` (negative), each sign glued to
++    the term with a single leading space.
++    """
++    pos, neg, zero = [], [], []
++    for j, c in enumerate(coeffs):
++        d = _round2(c)
++        if d > 0:
++            pos.append((j, d))
++        elif d < 0:
++            neg.append((j, d))
++        else:
++            zero.append((j, Decimal("0.00")))
++
++    parts = []
++    first = True
++    for group in (pos, neg, zero):
++        for j, d in group:
++            mag = abs(d)
++            term = f"{mag:.2f}*x{j + 1}"
++            if first:
++                # Leading term has no separator; a leading negative term keeps
++                # its minus glued to the term with no separator.
++                parts.append(term if d >= 0 else "-" + term)
++                first = False
++            else:
++                # Later terms use a separator with a single leading space:
++                # " + " for positive / zero, " - " for negative.
++                parts.append((" + " if d >= 0 else " - ") + term)
++    return "".join(parts)
+ 
