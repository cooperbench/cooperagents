+# ---------------------------------------------------------------------------
+# Build the Phase-1 tableau
+# ---------------------------------------------------------------------------
+def build_phase1_tableau(objective_coeff, constraints_coeff, operators,
+                         constraints_rhs, layout):
+    n = layout['n']
+    m = layout['m']
+    num_cols = layout['num_cols']
+    rhs_col = layout['rhs_col']
+    s_col = layout['s_col']
+    a_col = layout['a_col']
+
+    validate_operators(operators)
