++"""Two-phase simplex driver: greedy and minimum-pivot paths, reports, etc."""
++
++import copy
++from collections import deque
++
++from simplex.tableau import (
++    EPS,
++    NEAR_ZERO,
++    get_layout,
++    build_phase1_tableau,
++    remove_artificial_columns,
++    pivot as _pivot,
++    is_optimal,
++    feasible,
++)
++
++
++# ---------------------------------------------------------------------------
++# State helpers
++# ---------------------------------------------------------------------------
++def _copy_tableau(tableau):
++    return [row[:] for row in tableau]
++
++
++def _deep_copy_state(state):
++    return {
++        'tableau': _copy_tableau(state['tableau']),
++        'basis': list(state['basis']),
++        'layout': state['layout'],
++        'phase': state['phase'],
++        'step': state['step'],
++        'objective_coeff': state['objective_coeff'],
++    }
++
++
++def _phase2_name_to_col(layout):
++    """Map a variable name to its Phase-2 (artificial-removed) column index."""
++    ar = layout['ar']
++    rhs_col = layout['rhs_col']
++    start = rhs_col - ar
++    out = {}
++    for name, col in layout['name_to_col'].items():
++        if start <= col < rhs_col:
++            continue  # artificial column removed
++        newcol = col if col < start else (col - ar)
++        out[name] = newcol
++    return out
++
++
++def _col_name(layout, phase, j):
++    nmc = layout['name_to_col'] if phase == 1 else _phase2_name_to_col(layout)
++    for name, c in nmc.items():
++        if c == j:
++            return name
++    return None
++
++
++def _apply_pivot(state, col, row, enter_name, log=None):
++    """Apply a single pivot in place; optionally append a pivot-log entry."""
++    tableau = state['tableau']
++    _pivot(tableau, col, row, state['basis'], enter_name)
++    state['step'] += 1
++    if log is not None:
++        log.append({
++            'step': state['step'],
++            'phase': state['phase'],
++            'enter_column': enter_name,
++            'leave_row': 'R%d' % row,
++            'tableau': _copy_tableau(tableau),
++        })
++
++
++# ---------------------------------------------------------------------------
++# Valid-pivot enumeration
++# ---------------------------------------------------------------------------
++def _valid_pivots(state):
++    """Return a list of (enter_col, leave_row, enter_name) for every valid
++    simplex pivot in the current state.
++
++    A pivot is valid when:
++      * the entering column has a strictly negative reduced cost
++        (objective row < -EPS);
++      * at least one constraint row has a strictly positive entry in that
++        column (so a minimum ratio can be taken).
++    The leaving row is the minimum-ratio row; ties are free, so every
++    minimum-ratio row is returned as a candidate.
++    """
++    tableau = state['tableau']
++    obj = tableau[-1]
++    last = len(obj)
++    rhs_col = last - 1
++    out = []
++    for j in range(1, last - 1):
++        if obj[j] < -EPS:
++            pos = [i for i in range(len(tableau) - 1)
++                   if tableau[i][j] > EPS]
++            if not pos:
++                continue  # unbounded direction; no valid pivot
++            ratios = {i: tableau[i][rhs_col] / tableau[i][j] for i in pos}
++            best = min(ratios.values())
++            minrows = [i for i in pos if abs(ratios[i] - best) <= 1e-7]
++            name = _col_name(state['layout'], state['phase'], j)
++            for r in minrows:
++                out.append((j, r, name))
++    return out
++
++
++# ---------------------------------------------------------------------------
++# Greedy simplex (Bland's rule)
++# ---------------------------------------------------------------------------
++def _bland_column(obj):
++    best = 0.0
++    bestj = -1
++    last = len(obj)
++    for j in range(1, last - 1):
++        if obj[j] < best:
++            best = obj[j]
++            bestj = j
++    return bestj  # -1 means optimal
++
++
++def _bland_row(tableau, col):
++    best = None
++    bestrow = -1
++    rhs = len(tableau[0]) - 1
++    for i in range(len(tableau) - 1):
++        if tableau[i][col] > EPS:
++            r = tableau[i][rhs] / tableau[i][col]
++            if best is None or r < best - 1e-12:
++                best = r
++                bestrow = i
++            elif abs(r - best) <= 1e-7 and i < bestrow:
++                bestrow = i
++    return bestrow
++
++
++def _run_greedy(state, log=None):
++    """Run the simplex (Bland's rule) until the current phase is optimal."""
++    while True:
++        col = _bland_column(state['tableau'][-1])
++        if col < 0:
++            break
++        row = _bland_row(state['tableau'], col)
++        if row < 0:
++            raise Exception("Problem is unbounded")
++        name = _col_name(state['layout'], state['phase'], col)
++        _apply_pivot(state, col, row, name, log)
++    return state
++
++
++# ---------------------------------------------------------------------------
++# Phase-1 -> Phase-2 transition
++# ---------------------------------------------------------------------------
++def _phase1_to_phase2(state):
++    """Transition an optimal, feasible Phase-1 state to Phase 2."""
++    p1 = state
++    layout = p1['layout']
++    p2_tableau = remove_artificial_columns(p1['tableau'], layout)
++    num = len(p2_tableau[-1])
++    rhs = num - 1
++    n = layout['n']
++    obj_coeff = p1['objective_coeff']
++
++    obj = [0.0] * num
++    obj[0] = 1.0  # Z
++    for j in range(n):
++        obj[1 + j] = -obj_coeff[j]
++    # slack/surplus reduced costs start at 0 (zero original cost); the
++    # canonicalisation below corrects non-basic slacks/surpluses.
++    for name, col in _phase2_name_to_col(layout).items():
++        if name.startswith('s'):
++            obj[col] = 0.0
++    obj[rhs] = 0.0
++    p2_tableau[-1] = obj
++
++    # canonicalise: for each basic (non-artificial) variable, drive its
++    # column to 0 in the objective row.
++    for i in range(len(p2_tableau) - 1):
++        b = p1['basis'][i]
++        if b.startswith('a'):
++            continue
++        c2 = _phase2_name_to_col(layout).get(b)
++        if c2 is None:
++            continue
++        factor = p2_tableau[-1][c2]
++        if abs(factor) > NEAR_ZERO:
++            for j in range(num):
++                p2_tableau[-1][j] -= factor * p2_tableau[i][j]
++            p2_tableau[-1][c2] = 0.0
++
++    # Keep the full basis (length m, one entry per constraint row).
++    # Artificial basic variables are retained here and skipped by
++    # _basic_variables; this keeps the basis aligned with the rows so
++    # the report and the pivot machinery index correctly.
++    basis = list(p1['basis'])
++
++    return {
++        'tableau': p2_tableau,
++        'basis': basis,
++        'layout': layout,
++        'phase': 2,
++        'step': p1['step'],
++        'objective_coeff': p1['objective_coeff'],
++    }
++
++
++# ---------------------------------------------------------------------------
++# Reports / diagnostics
++# ---------------------------------------------------------------------------
++def _basic_variables(state):
++    out = {}
++    tableau = state['tableau']
++    rhs = len(tableau[0]) - 1
++    for i in range(len(tableau) - 1):
++        b = state['basis'][i]
++        if b.startswith('a'):
++            continue
++        out[b] = float(tableau[i][rhs])
++    return out
++
++
++def _degenerate(state):
++    tableau = state['tableau']
++    rhs = len(tableau[0]) - 1
++    for i in range(len(tableau) - 1):
++        if abs(tableau[i][rhs]) <= EPS:
++            return True
++    return False
++
++
++def _phase1_infeasible(state):
++    """Phase-1 minimises w = sum of artificials; the objective row is Z + w = 0,
++    so its RHS equals the current value of Z = -w.  The original LP is infeasible
++    exactly when the minimum w is strictly positive, i.e. objective-row RHS < -EPS.
++    """
++    obj = state['tableau'][-1]
++    rhs = len(obj) - 1
++    return obj[rhs] < -EPS
++
++
++def _unbounded(state):
++    obj = state['tableau'][-1]
++    last = len(obj)
++    for j in range(1, last - 1):
++        if obj[j] < -EPS:
++            has_pos = any(state['tableau'][i][j] > EPS
++                          for i in range(len(state['tableau']) - 1))
++            if not has_pos:
++                return True
++    return False
++
++
++# ---------------------------------------------------------------------------
++# Minimum-pivot search (used when initial_pivots is provided)
++# ---------------------------------------------------------------------------
++def _state_key(state):
++    return (state['phase'], tuple(state['basis']))
++
++
++def _minimum_pivots(start_state, log):
++    """BFS from start_state (after the provided prefix) to a Phase-2 optimal
++    tableau, choosing the shortest sequence of additional pivots.
++
++    The additional pivots are recorded in `log` in order.  The Phase-1 ->
++    Phase-2 transition is a non-pivot operation: it adds no log entry.  The
++    `step` counter is one-based and continuous across both phases; the phase
++    transition does not advance it.  Returns the final Phase-2 state, or
++    `None` if no feasible Phase-2 optimal is reachable (infeasible /
++    unbounded).
++    """
++    start = _deep_copy_state(start_state)
++    # Each queue item is (state, entries) where `entries` is the list of
++    # pivot-log dicts for the additional pivots performed so far.  The
++    # phase transition adds no entry, so it never appears in the log.
++    queue = deque()
++    queue.append((start, []))
++    visited = set()
++    visited.add(_state_key(start))
++
++    while queue:
++        state, entries = queue.popleft()
++
++        if state['phase'] == 2 and is_optimal(state['tableau']):
++            for e in entries:
++                log.append(e)
++            return state
++
++        # Phase-1 optimal -> transition to Phase-2 (free, no log entry)
++        if state['phase'] == 1 and is_optimal(state['tableau']):
++            if not _phase1_infeasible(state):
++                p2 = _phase1_to_phase2(state)
++                key = _state_key(p2)
++                if key not in visited:
++                    visited.add(key)
++                    queue.append((p2, entries))
++            # infeasible Phase-1: do not transition (no Phase-2 path)
++
++        for col, row, name in _valid_pivots(state):
++            child = _deep_copy_state(state)
++            _apply_pivot(child, col, row, name)  # increment step; no log
++            entry = {
++                'step': child['step'],
++                'phase': child['phase'],
++                'enter_column': name,
++                'leave_row': 'R%d' % row,
++                'tableau': _copy_tableau(child['tableau']),
++            }
++            key = _state_key(child)
++            if key in visited:
++                continue
++            visited.add(key)
++            queue.append((child, entries + [entry]))
++    return None
++
++# ---------------------------------------------------------------------------
++# Main driver
++# ---------------------------------------------------------------------------
++def two_phase_simplex(objective_coeff, constraints_coeff,
++                      constraints_relational_operators, constraints_rhs,
++                      initial_pivots=None):
++    objective_coeff = [float(c) for c in objective_coeff]
++    constraints_relational_operators = list(constraints_relational_operators)
++    constraints_rhs = [float(r) for r in constraints_rhs]
++    n = len(objective_coeff)
++    m = len(constraints_relational_operators)
++
++    from simplex.tableau import validate_operators
++    validate_operators(constraints_relational_operators)
++
++    layout = get_layout(n, m, constraints_relational_operators)
