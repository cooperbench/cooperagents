+    # constraint rows
+    rows = []
+    for i in range(m):
+        row = [0.0] * num_cols
+        row[0] = 0.0  # Z
+        for j in range(n):
+            row[1 + j] = float(constraints_coeff[i][j])
+        if i in s_col:
+            c = s_col[i]
+            if operators[i] == '<=':
+                row[c] = 1.0
+            elif operators[i] == '>=':
+                row[c] = -1.0  # surplus
+        if i in a_col:
+            row[a_col[i]] = 1.0
+        row[rhs_col] = float(constraints_rhs[i])
+        rows.append(row)
+
+    # Phase-1 objective row:  Z + w = 0  (w = sum of artificials).
+    # Maximising Z = -w is equivalent to minimising w.
+    obj = [0.0] * num_cols
+    obj[0] = 1.0  # Z
+    for c in a_col.values():
