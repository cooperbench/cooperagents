+# ---------------------------------------------------------------------------
+# Layout
+# ---------------------------------------------------------------------------
+def get_layout(n, m, operators):
+    """Column layout for the Phase-1 tableau.
+
+    Columns: [Z, x1..xn, s1..sk, a1..ar, RHS]
+      - sk = number of constraints using '<=' or '>='  (slack/surplus)
+      - ar = number of constraints using '>=' or '='   (artificial)
+    Slack/surplus and artificial columns are numbered in order of appearance.
+    """
+    layout = {}
+    layout['n'] = n
+    layout['m'] = m
+    layout['x_cols'] = list(range(1, 1 + n))
+
+    col = 1 + n
+
+    # slack / surplus columns
+    s_col = {}        # constraint index -> column index
+    s_names = {}      # column index -> name
+    s_count = 0
+    for i, op in enumerate(operators):
+        if op in ('<=', '>='):
+            s_count += 1
+            s_col[i] = col
+            s_names[col] = 's%d' % s_count
+            col += 1
+    layout['sk'] = s_count
+    layout['s_col'] = s_col
+    layout['s_names'] = s_names
+
+    # artificial columns
+    a_col = {}
+    a_names = {}
+    a_count = 0
+    for i, op in enumerate(operators):
+        if op in ('>=', '='):
+            a_count += 1
+            a_col[i] = col
+            a_names[col] = 'a%d' % a_count
+            col += 1
+    layout['ar'] = a_count
+    layout['a_col'] = a_col
+    layout['a_names'] = a_names
+
+    layout['rhs_col'] = col
+    col += 1
+    layout['num_cols'] = col
+
+    name_to_col = {}
+    for j in range(n):
+        name_to_col['x%d' % (j + 1)] = 1 + j
+    for c, name in s_names.items():
+        name_to_col[name] = c
+    for c, name in a_names.items():
+        name_to_col[name] = c
+    layout['name_to_col'] = name_to_col
+
+    return layout
+
+
+# ---------------------------------------------------------------------------
+# Validation
+# ---------------------------------------------------------------------------
+def validate_operators(operators):
+    for op in operators:
+        if op not in ('<=', '>=', '='):
+            raise ValueError("Invalid relational operator: %r" % (op,))
