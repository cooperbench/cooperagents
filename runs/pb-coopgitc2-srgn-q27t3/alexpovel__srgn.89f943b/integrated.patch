+ * @param opts email creation options
+ * @return 0 or an error code
+ */
+GIT_EXTERN(int) git_email_create_from_commit(
+	git_buf *out,
+	git_commit *commit,
+	const git_email_create_options *opts);
+
+/** @} */
+GIT_END_DECL
+
+#endif
