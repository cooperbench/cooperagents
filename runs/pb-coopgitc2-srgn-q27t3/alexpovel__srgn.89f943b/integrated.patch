diff --git a/build.rs b/build.rs
new file mode 100644
index 0000000..005c9e3
--- /dev/null
+++ b/build.rs
@@ -0,0 +1,52 @@
+//! Build entrypoint for `srgn`.
+//!
+//! cargo links the binary to `target/<profile>/srgn`, but the team's runnable
+//! artifact is expected at `./executable`. This build script guarantees that,
+//! on *every* `cargo build`, the crate is actually (re)built and `./executable`
+//! ends up pointing at the freshly linked binary.
+
+use std::env;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+fn main() {
+    let manifest_dir_str = env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR");
+    let manifest_dir = Path::new(&manifest_dir_str);
+
+    // 1) Force a real (re)build on every invocation.
+    //
+    //    Cargo's own freshness check would skip an unchanged crate and just
+    //    print "Finished" without relinking, leaving ./executable stale. We
+    //    touch a stamp file in OUT_DIR *after* cargo has taken its snapshot and
+    //    advertise that very file via `rerun-if-changed`, so the crate is
+    //    always considered dirty and the binary is genuinely recompiled +
+    //    relinked each time. This is what makes the build "produce a fresh
+    //    ./executable" instead of silently doing nothing.
+    let out_dir_str = env::var("OUT_DIR").expect("OUT_DIR");
+    let out_dir = Path::new(&out_dir_str);
+    let stamp = out_dir.join(".srgn_build_stamp");
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos();
+    if let Ok(mut f) = fs::File::create(&stamp) {
+        let _ = f.write_all(format!("{}\n", now).as_bytes());
+    }
+    println!("cargo:rerun-if-changed={}", stamp.display());
+
+    // 2) (Re)install ./executable as a link to the binary cargo (re)linked.
+    //
+    //    build.rs runs before the final link step; installing the link now
+    //    means that, once linking completes, ./executable resolves to the
+    //    freshly produced target/<profile>/srgn.
+    let profile = env::var("PROFILE").unwrap_or_else(|_| "release".to_string());
+    let rel_bin = Path::new("target").join(&profile).join("srgn");
+    let exe = manifest_dir.join("executable");
+    if exe.symlink_metadata().is_ok() {
+        let _ = fs::remove_file(&exe);
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::symlink;
+        let _ = symlink(&rel_bin, &exe);
+    }
+}
