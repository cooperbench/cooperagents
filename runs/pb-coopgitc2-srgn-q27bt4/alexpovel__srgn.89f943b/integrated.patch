+++ b/srgn_src.py
@@ -0,0 +1,565 @@
+#!/usr/bin/env python3
+# Reimplementation of srgn 0.14.1 behavior (regex + composable-action core).
+import sys, os, re, unicodedata, base64, io, datetime
+
+CRATE_NAME = "srgn"
+VERSION = "0.14.1"
+
+HELP_FULL  = base64.b64decode("__HELP_FULL_B64__").decode("utf-8", "replace")
+HELP_SHORT = base64.b64decode("__HELP_SHORT_B64__").decode("utf-8", "replace")
+
+def prog_name():
+    b = sys.argv[0] if sys.argv else "srgn"
+    return os.path.basename(b) if b else "srgn"
+
+# ============================================================
+#  Action implementations
+# ============================================================
+# Default (non-naive) german action converts 'ue' and 'ss' (case-insensitively),
+# matching srgn 0.14.1 behavior (e.g. 'Bruecken' -> 'BRÜCKEN', 'Koeffizienten' -> 'KOEFFIZIENTEN').
+# Naive mode also converts 'ae'/'oe'.
+GERMAN_BASE = [('ue','\u00fc'),('ss','\u00df')]
+GERMAN_NAIVE = [('ae','\u00e4'),('oe','\u00f6')]
+
+SYMBOLS = [
+    ('\u2260','!='),('\u2261','=='),('\u2264','<='),('\u2265','>='),
+    ('\u00b1','+-'),('\u00d7','x'),('\u00f7','/'),
+    ('\u2229','&&'),('\u222a','||'),('\u00ac','!'),
+    ('\u2018',"'"),('\u2019',"'"),
+    ('\u201c','"'),('\u201d','"'),
+    ('\u2190','<'),('\u2192','>'),('\u2194','<->'),
+]
+
+def action_titlecase(s):
+    out=[]
+    for w in s.split(' '):
+        if w=='':
+            out.append(w)
+        else:
+            out.append(w[0].upper()+w[1:].lower())
+    return ' '.join(out)
+
+def action_normalize(s):
+    try:
+        d=unicodedata.normalize('NFD', s)
+        return ''.join(c for c in d if unicodedata.category(c) not in ('Mn','Mc','Me'))
+    except Exception:
+        return s
+
+def _conv_umlaut(s, pairs):
+    # case-insensitive replacement of each pair, preserving case of the matched letters
+    for (k,v) in pairs:
+        # uppercase / mixed forms
+        up=k.upper()
+        # lower case
+        s=s.replace(k,v)
+        # uppercase form of first char only (e.g. 'Ue'/'uE' -> uppercase umlaut)
+        # build uppercase variant of the whole key
+        for variant in (up, k.capitalize()):
+            if variant!=k and variant!=up:
+                pass
+    return s
+
+def action_german(s, naive=False, prefer_original=False):
+    # operate word-by-word, case-insensitively for 'ue'/'ss' (and 'ae'/'oe' in naive mode)
+    pairs=list(GERMAN_BASE)
+    if naive:
+        pairs=list(GERMAN_BASE)+GERMAN_NAIVE
+    def conv(t):
+        for (k,v) in pairs:
+            # full uppercase key -> uppercase umlaut
+            ku=k.upper(); vu=v.upper()
+            # try each case variant
+            s2=t
+            # lower
+            s2=s2.replace(k,v)
+            # upper
+            s2=s2.replace(ku,vu)
+            # mixed: capitalize
+            s2=s2.replace(k.capitalize(), v.upper())
+            t=s2
+        return t
+    parts=re.split(r'(\s+)', s)
+    res=''
+    for p in parts:
+        if re.match(r'\s+', p) or p=='':
+            res+=p
+        else:
+            res+=conv(p)
+    return res
+
+def action_symbols(s, invert=False):
+    # Default -S converts ASCII -> Unicode symbols (e.g. '!=' -> '≠').
+    # With -i (--invert) it is reversed: Unicode -> ASCII.
+    if not invert:
+        for (u,a) in SYMBOLS:
+            s=s.replace(a,u)
+    else:
+        for (u,a) in SYMBOLS:
+            s=s.replace(u,a)
+    return s
+
+# ============================================================
+#  Argument parsing (clap-mimicking)
+# ============================================================
+class ParseError(Exception):
+    def __init__(self, msg, usage=None):
+        self.msg=msg; self.usage=usage
+
+LANGS=['c','csharp','go','hcl','python','rust','typescript']
+ALIAS_LANG={'cs':'csharp','py':'python','rs':'rust','ts':'typescript'}
+
+# long/short action flags -> action name
+ACTION={
+    '-u':'upper','--upper':'upper','-l':'lower','--lower':'lower',
+    '-t':'titlecase','--titlecase':'titlecase','-n':'normalize','--normalize':'normalize',
+    '-g':'german','--german':'german','-S':'symbols','--symbols':'symbols',
+    '-d':'delete','--delete':'delete','-s':'squeeze','--squeeze':'squeeze',
+    '--squeeze-repeats':'squeeze',
+}
+# boolean flags
+BOOL_FLAG={
+    '-i','--invert','-L','--literal-string','-j','--join-language-scopes',
+    '-H','--hidden','--gitignored','--dry-run','--fail-any','--fail-none',
+    '--fail-no-files','--sorted','--german-naive','--german-prefer-original',
+}
+# value-taking long flags
+LANG_FLAGS=set()
+for _l in LANGS:
+    LANG_FLAGS.add('--'+_l)
+    LANG_FLAGS.add('--'+_l+'-query')
+    LANG_FLAGS.add('--'+_l+'-query-file')
+VALUE_FLAG={'-G','--glob','--completions','--stdin-detection',
+            '--stdout-detection','--threads'}
+
+def _lang_of(flag):
+    # flag like --rust-query-file -> rust
+    base=flag[2:]
+    for suf in ('-query-file','-query',''):
+        if base.endswith(suf):
+            name=base[:-len(suf)] if suf else base
+            break
+    name=flag[2:].split('-')[0]
+    return ALIAS_LANG.get(name, name)
+
+def parse_args(argv):
+    args=argv[1:]
+    actions=[]; replacement=None; scope=None
+    literal=False; invert=False; join=False; hidden=False; gitignored=False
+    dry_run=False; fail_any=False; fail_none=False; fail_no_files=False
+    sorted_=False; german_naive=False; german_prefer=False
+    glob_val=None; completions=None
+    std_in='auto'; std_out='auto'; threads=None
+    language=None; lang_queries=[]
+    verbose=0
+    sep=False
+    i=0; n=len(args)
+    def _consume_value(name, val):
+        nonlocal glob_val, completions, std_in, std_out, threads
+        if name in ('-G','--glob'): glob_val=val
+        elif name=='--completions': completions=val
+        elif name=='--stdin-detection': std_in=val
+        elif name=='--stdout-detection': std_out=val
+        elif name=='--threads': threads=val
+    def _set_bool(name):
+        nonlocal invert, literal, join, hidden, gitignored, dry_run
+        nonlocal fail_any, fail_none, fail_no_files, sorted_, german_naive, german_prefer
+        if name in ('-i','--invert'): invert=True
+        elif name in ('-L','--literal-string'): literal=True
+        elif name in ('-j','--join-language-scopes'): join=True
+        elif name in ('-H','--hidden'): hidden=True
+        elif name=='--gitignored': gitignored=True
+        elif name=='--dry-run': dry_run=True
+        elif name=='--fail-any': fail_any=True
+        elif name=='--fail-none': fail_none=True
+        elif name=='--fail-no-files': fail_no_files=True
+        elif name=='--sorted': sorted_=True
+        elif name=='--german-naive': german_naive=True
+        elif name=='--german-prefer-original': german_prefer=True
+
+
+    while i<n:
+        a=args[i]
+        if a=='--':
+            sep=True; i+=1; continue
+
+        # help / version (not bundled)
+        if a=='-h': return HELP_SHORT
+        if a=='--help': return HELP_FULL
+        if a in ('-V','--version'): return f"{CRATE_NAME} {VERSION}\n"
+
+        # long flag with =value
+        if a.startswith('--') and '=' in a:
+            name, val = a.split('=', 1)
+            if name in LANG_FLAGS:
+                language=_lang_of(name); lang_queries.append((name,val)); i+=1; continue
+            if name in VALUE_FLAG:
+                _consume_value(name, val)
+                i+=1; continue
+            # unknown long flag with =value: treat as error
+            raise ParseError(f"error: unexpected argument '{a}' found\n\n  tip: to pass '{a}' as a value, use '-- {a}'")
+
+        # long flag (no =)
+        if a.startswith('--'):
+            if a in LANG_FLAGS:
+                language=_lang_of(a)
+                if i+1<n:
+                    lang_queries.append((a,args[i+1])); i+=2; continue
+                i+=1; continue
+            if a in VALUE_FLAG:
+                if i+1<n:
+                    _consume_value(a, args[i+1]); i+=2; continue
+                i+=1; continue
+            if a in BOOL_FLAG:
+                _set_bool(a)
+                i+=1; continue
+            if a in ACTION:
+                actions.append(ACTION[a]); i+=1; continue
+            if a=='--verbose':
+                verbose+=1; i+=1; continue
+            # unknown long flag
+            raise ParseError(f"error: unexpected argument '{a}' found\n\n  tip: to pass '{a}' as a value, use '-- {a}'")
+
+        # short flags (possibly bundled)
+        if a.startswith('-') and a!='-':
+            # handle -v / --verbose
+            if a=='-v' or a=='--verbose':
+                verbose+=1; i+=1; continue
+            # parse bundle of single-char short flags
+            chars=a[1:]
+            # find first char in a known set; bundle boolean/short flags
+            while chars:
+                c=chars[0]
+                flag='-'+c
+                if flag in ACTION:
+                    actions.append(ACTION[flag]); chars=chars[1:]; continue
+                if flag in BOOL_FLAG:
+                    _set_bool(flag); chars=chars[1:]; continue
+                if flag in VALUE_FLAG:
+                    # value flag: rest of bundle (or next arg) is the value
+                    rest=chars[1:]
+                    if rest:
+                        _consume_value(flag, rest); chars=''
+                    elif i+1<n:
+                        _consume_value(flag, args[i+1]); i+=1; chars=''
+                    else:
+                        chars=''
+                    break
+                # unknown short flag
+                raise ParseError(f"error: unexpected argument '{a}' found\n\n  tip: to pass '{a}' as a value, use '-- {a}'")
+            i+=1; continue
+
+        # positional (after -- is replacement; before -- is scope)
+        if sep:
+            if replacement is None:
+                replacement=a
+            else:
+                replacement=replacement+('' if replacement.endswith(' ') else ' ')+a
+        else:
+            if scope is None:
+                scope=a
+            else:
+                raise ParseError(f"error: unexpected argument '{a}' found")
+        i+=1
+
+    # env var defaults (best effort)
+    if replacement is None and 'REPLACE' in os.environ:
+        replacement=os.environ['REPLACE']
+    if invert and 'INVERT' not in os.environ:
+        pass
+    if literal and 'LITERAL_STRING' not in os.environ:
+        pass
+
+    return dict(actions=actions, replacement=replacement, scope=scope,
+        literal=literal, invert=invert, join=join, hidden=hidden,
+        gitignored=gitignored, sorted_=sorted_, dry_run=dry_run,
+        fail_any=fail_any, fail_none=fail_none, fail_no_files=fail_no_files,
+        glob=glob_val, completions=completions, std_in=std_in,
+        std_out=std_out, threads=threads, language=language,
+        lang_queries=lang_queries, verbose=verbose,
+        german_naive=german_naive, german_prefer=german_prefer)
+
+
+# ============================================================
+#  Main processing
+# ============================================================
+def log_error(msg):
+    now = datetime.datetime.now(datetime.timezone.utc)
+    ts = now.strftime('%Y-%m-%dT%H:%M:%S.') + f"{now.microsecond:06d}Z"
+    sys.stderr.write(f"[{ts} ERROR srgn] {msg}\n")
+
+def do_replace(replacement, match=None):
+    # expansion of $N and $name capture references; literal otherwise
+    out=[]
+    i=0
+    while i < len(replacement):
+        c=replacement[i]
+        if c=='$' and i+1 < len(replacement):
+            j=i+1
+            if replacement[j].isdigit():
+                k=j
+                while k < len(replacement) and replacement[k].isdigit():
+                    k+=1
+                num=int(replacement[j:k])
+                val=''
+                if match is not None:
+                    try:
+                        g=match.group(num)
+                        val=g if g is not None else ''
+                    except (re.error, IndexError):
+                        val=''
+                out.append(val)
+                i=k; continue
+            m2=re.match(r'\$[A-Za-z_][A-Za-z0-9_]*', replacement[j:])
+            if m2:
+                name=m2.group()[1:]
+                val=''
+                if match is not None:
+                    try:
+                        g=match.group(name)
+                        val=g if g is not None else ''
+                    except (re.error, IndexError):
+                        val=''
+                out.append(val)
+                i=j+len(m2.group()); continue
+        out.append(c); i+=1
+    return ''.join(out)
+
+_COMPOSABLE_ORDER={'upper','lower','titlecase','normalize','german','symbols'}
+def apply_actions(text, actions, replacement, invert, match=None,
+                  german_naive=False, german_prefer=False):
+    # Replacement runs first ("If given, will run before any other action").
+    # Composable actions run in the order they appear on the command line.
+    seq=[]
+    if replacement is not None:
+        seq.append('replace')
+    for act in actions:
+        if act in _COMPOSABLE_ORDER:
+            seq.append(act)
+    res=text
+    for act in seq:
+        if act=='upper':
+            res=res.upper()
+        elif act=='lower':
+            res=res.lower()
+        elif act=='titlecase':
+            res=action_titlecase(res)
+        elif act=='normalize':
+            res=action_normalize(res)
+        elif act=='german':
+            res=action_german(res, german_naive, german_prefer)
+        elif act=='symbols':
+            res=action_symbols(res, invert)
+        elif act=='replace':
+            res=do_replace(replacement, match)
+    return res
+
+def find_matches(line, pat, scope, literal):
+    matches=[]
+    if literal:
+        start=0
+        while True:
+            idx=line.find(scope, start)
+            if idx<0: break
+            matches.append((idx, idx+len(scope), None))
+            start=idx+1
+    else:
+        for m in pat.finditer(line):
+            matches.append((m.start(), m.end(), m))
+    return matches
+
+def process_line(line, pat, scope, actions, replacement, invert, literal,
+                 german_naive=False, german_prefer=False):
+    matches=find_matches(line, pat, scope, literal)
+    if not matches:
+        return line, False
+    res=[]
+    pos=0
+    for (s,e,m) in matches:
+        res.append(line[pos:s])
+        matched=line[s:e]
+        res.append(apply_actions(matched, actions, replacement, invert,
+                                 match=m, german_naive=german_naive,
+                                 german_prefer=german_prefer))
+        pos=e
+    res.append(line[pos:])
+    return ''.join(res), True
+
+def read_input(files):
+    if not files:
+        return sys.stdin.read()
+    out=[]
+    for f in files:
+        try:
+            with open(f,'r',encoding='utf-8') as fh:
+                out.append(fh.read())
+        except Exception:
+            pass
+    return '\n'.join(out) if out else ''
+
+
+COMPOSABLE={'upper','lower','titlecase','normalize','german','symbols'}
+STANDALONE={'delete','squeeze'}
+
+def validate(actions, args, data, prog):
+    LONG={'delete':'--delete','squeeze':'--squeeze','upper':'--upper',
+          'lower':'--lower','titlecase':'--titlecase','normalize':'--normalize',
+          'german':'--german','symbols':'--symbols'}
+    def lname(a): return LONG.get(a, '--'+a)
+    standalone_present=[a for a in actions if a in STANDALONE]
+    for a in standalone_present:
+        conflicting=[]
+        if args.get('replacement') is not None:
+            conflicting.append('[REPLACEMENT]')
+        comp=[x for x in actions if x in COMPOSABLE]
+        if comp:
+            for x in comp:
+                conflicting.append(lname(x))
+        if conflicting:
+            present=[lname(x) for x in actions]
+            usage=f"Usage: {prog} {' '.join(present)} <SCOPE> [-- <REPLACEMENT>]"
+            msg=(f"error: the argument '{lname(a)}' cannot be used with:"
+                 + ''.join(f'\n  {c}' for c in conflicting))
+            raise ParseError(msg, usage=usage)
+    if standalone_present and args.get('scope') is None:
+        present=[lname(x) for x in actions]
+        usage=f"Usage: {prog} {' '.join(present)} <SCOPE> [-- <REPLACEMENT>]"
+        msg=(f"error: the following required arguments were not provided:\n"
+             f"  <SCOPE>")
+        raise ParseError(msg, usage=usage)
+
+def main():
+    argv=sys.argv
+    try:
+        result=parse_args(argv)
+    except ParseError as e:
+        sys.stderr.write(e.msg+'\n')
+        usage=e.usage or f"Usage: {prog_name()} [OPTIONS] [SCOPE] [-- <REPLACEMENT>]"
+        sys.stderr.write(f"\n{usage}\n\nFor more information, try '--help'.\n")
+        return 2
+    if isinstance(result, str):
+        sys.stdout.write(result)
+        return 0
+
+    actions=result['actions']
+    replacement=result['replacement']
+    scope=result['scope'] or '.*'
+    literal=result['literal']
+    invert=result['invert']
+    language=result['language']
+    fail_any=result['fail_any']
+    fail_none=result['fail_none']
+    german_naive=result['german_naive']
+    german_prefer=result['german_prefer']
+    completions=result['completions']
+
+    # shell completions: best-effort (print nothing, exit 0)
+    if completions is not None:
+        return 0
+
+    # clap validation (required <SCOPE> for standalone actions; conflicts)
+    try:
+        validate(actions, result, data=None, prog=prog_name())
+    except ParseError as e:
+        sys.stderr.write(e.msg+'\n')
+        sys.stderr.write(f"\n{e.usage}\n\nFor more information, try '--help'.\n")
+        return 2
+
+    # read input (stdin by default; files handling is best-effort)
+    data=read_input([])
+    lines=data.split('\n')
+
+    try:
+        pat=re.compile(scope) if not literal else None
+    except re.error as err:
+        sys.stderr.write(f"Error: invalid regex: {err}\n")
+        return 1
+
+    # search mode: language scope present and no actions
+    if language and not actions and replacement is None:
+        any_match=False
+        for ln,line in enumerate(lines,1):
+            if literal:
+                matched = scope in line
+            else:
+                matched = pat.search(line) is not None
+            if matched:
+                any_match=True
+                sys.stdout.write(f"{ln}:{line}\n")
+        if not any_match:
+            log_error("No input was in scope")
+            return 1
+        if fail_none and not any_match:
+            return 1
+        if fail_any and any_match:
+            sys.stderr.write("Error: found input in scope\n")
+            return 1
+        return 0
+
+    # no actions, not in search mode
+    if not actions and replacement is None:
+        log_error("No actions specified, and not in search mode. Will return input unchanged, if any.")
+        sys.stdout.write(data)
+        if fail_none:
+            return 1
+        return 0
+
+    # delete is standalone
+    if 'delete' in actions:
+        out_lines=[]
+        any_match=False
+        for line in lines:
+            if literal:
+                new=line.replace(scope,'')
+                if new!=line: any_match=True
+            else:
+                new=pat.sub('', line)
+                if new!=line: any_match=True
+            out_lines.append(new)
+        sys.stdout.write('\n'.join(out_lines))
+        if fail_any and any_match: sys.stderr.write("Error: found input in scope\n"); return 1
+        if fail_none and not any_match: return 1
+        return 0
+
+    # squeeze standalone
+    if 'squeeze' in actions:
+        out_lines=[]
+        any_match=False
+        for line in lines:
+            if literal:
+                # squeeze consecutive literal occurrences of scope into one
+                new=line
+                if scope:
+                    while scope+scope in new:
+                        new=new.replace(scope+scope, scope)
+                if new!=line: any_match=True
+                line=new
+            else:
+                new=pat.sub(lambda m:m.group(0)[0] if m.group(0) else '', line)
+                if new!=line: any_match=True
+                line=new
+            out_lines.append(line)
+        sys.stdout.write('\n'.join(out_lines))
+        if fail_any and any_match: sys.stderr.write("Error: found input in scope\n"); return 1
+        if fail_none and not any_match: return 1
+        return 0
+
+    # general transform
+    out_lines=[]
+    any_match=False
+    for line in lines:
+        new, matched = process_line(line, pat, scope, actions, replacement, invert,
+                                    literal, german_naive, german_prefer)
+        if matched: any_match=True
+        out_lines.append(new)
+    sys.stdout.write('\n'.join(out_lines))
+    if fail_any and any_match: sys.stderr.write("Error: found input in scope\n"); return 1
+    if fail_none and not any_match: return 1
+    return 0
+
+if __name__=='__main__':
+    try:
+        sys.exit(main())
+    except Exception as e:
+        sys.stderr.write(f"Error: {e}\n")
+        sys.exit(1)
