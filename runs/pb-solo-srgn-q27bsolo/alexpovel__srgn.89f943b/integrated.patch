++    cfg.sorted = m.get_flag("sorted");
++    cfg.threads = m.get_one::<String>("threads").and_then(|s| s.parse().ok());
++    cfg
++}
++
++fn handle_completions(raw: &[String], pos: usize) {
++    let shell = raw.get(pos + 1).cloned().unwrap_or_default();
++    let mut cmd = build_command();
++    use clap_complete::Shell;
++    let shells = [
++        ("bash", Shell::Bash),
++        ("elvish", Shell::Elvish),
++        ("fish", Shell::Fish),
++        ("powershell", Shell::PowerShell),
++        ("zsh", Shell::Zsh),
++    ];
++    let mut out = io::stdout();
++    let mut matched = false;
++    for (name, sh) in shells {
++        if shell == name {
++            let _ = clap_complete::generate(sh, &mut cmd, name, &mut out);
++            matched = true;
++        }
++    }
++    if !matched {
++        let mut err = io::stderr();
++        let _ = writeln!(err, "error: a value is required for '--completions <SHELL>' but none was supplied");
++        let _ = writeln!(err, "  [possible values: bash, elvish, fish, powershell, zsh]");
++        let _ = writeln!(err);
++        let _ = writeln!(err, "Usage: executable --completions <SHELL>");
++        let _ = writeln!(err);
++        let _ = writeln!(err, "For more information, try '--help'.");
++        std::process::exit(2);
++    }
++}
++
++fn preprocess_dashdash(raw: &[String]) -> (Vec<String>, Option<String>) {
++    let mut cleaned = Vec::new();
++    let mut replacement: Option<String> = None;
++    let mut dashdash_seen = false;
++    for a in raw {
++        if !dashdash_seen && a == "--" {
++            dashdash_seen = true;
++            continue;
++        }
++        if dashdash_seen {
++            if replacement.is_none() {
++                replacement = Some(a.clone());
++            }
++            continue;
++        }
++        cleaned.push(a.clone());
++    }
++    (cleaned, replacement)
++}
++
++fn run(cfg: &Config) -> u8 {
++    let mut input = String::new();
++    let _ = io::stdin().read_to_string(&mut input);
++
++    let scope = cfg.scope.clone().unwrap_or_else(|| ".*".to_string());
++    // dry_run / sorted / threads only affect file processing, which has no
++    // effect in stdin mode; reference them so they are not dead code.
++    let _ = (cfg.dry_run, cfg.sorted, cfg.threads.is_some());
++    let pattern = if cfg.literal_string {
++        regex::escape(&scope)
++    } else {
++        scope.clone()
++    };
++    let re = match Regex::new(&pattern) {
++        Ok(r) => r,
++        Err(_) => {
++            let mut out = io::stdout();
++            let _ = out.write_all(input.as_bytes());
++            return 0;
++        }
++    };
++
++    let actions: Vec<Action> = build_actions(cfg);
++    let output = transform(&input, &re, &actions, cfg);
++
++    if !has_real_action(cfg, &actions) {
++        log::error!(
++            target: "srgn",
++            "No actions specified, and not in search mode. Will return input unchanged, if any."
++        );
++    }
++
++    let mut out = io::stdout();
++    let _ = out.write_all(output.as_bytes());
++    0
++}
++
++fn build_actions(cfg: &Config) -> Vec<Action> {
++    let mut v = Vec::new();
++    if cfg.replacement.is_some() {
++        v.push(Action::Replace);
++    }
++    if cfg.upper {
++        v.push(Action::Upper);
++    }
++    if cfg.lower {
++        v.push(Action::Lower);
++    }
++    if cfg.titlecase {
++        v.push(Action::Titlecase);
++    }
++    if cfg.normalize {
++        v.push(Action::Normalize);
++    }
++    if cfg.german {
++        v.push(Action::German);
++    }
++    if cfg.symbols {
++        v.push(Action::Symbols);
++    }
++    if cfg.delete {
++        v.push(Action::Delete);
++    }
++    if cfg.squeeze {
++        v.push(Action::Squeeze);
++    }
++    v
++}
++
++fn has_real_action(cfg: &Config, actions: &[Action]) -> bool {
++    if cfg.replacement.is_some() {
++        return true;
++    }
++    for a in actions {
++        if *a != Action::Squeeze {
++            return true;
++        }
++    }
++    false
++}
++
++fn transform(input: &str, re: &Regex, actions: &[Action], cfg: &Config) -> String {
++    let mut out = input.to_string();
++
++    if let Some(rep) = &cfg.replacement {
++        out = re.replace_all(&out, rep).to_string();
++    }
++
++    for a in actions {
++        match a {
++            Action::Upper => out = if cfg.invert {
++                transform_lower(&out, re)
++            } else {
++                transform_upper(&out, re)
++            },
++            Action::Lower => out = if cfg.invert {
++                transform_upper(&out, re)
++            } else {
++                transform_lower(&out, re)
++            },
++            Action::Titlecase => out = transform_titlecase(&out, re),
++            Action::Normalize => out = transform_normalize(&out, re),
++            Action::German => out = transform_german(&out, re, cfg.invert),
++            Action::Symbols => out = transform_symbols(&out, re, cfg.invert),
++            Action::Delete => out = re.replace_all(&out, "").to_string(),
++            Action::Squeeze => {}
++            Action::Replace => {}
++        }
++    }
++
++    if cfg.squeeze {
++        out = squeeze(&out, re);
++    }
++
++    out
++}
++
++fn transform_upper(input: &str, re: &Regex) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    for m in re.find_iter(input) {
++        result.push_str(&input[last..m.start()]);
++        for c in input[m.start()..m.end()].chars() {
++            result.push(c.to_uppercase().next().unwrap_or(c));
++        }
++        last = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
++
++fn transform_lower(input: &str, re: &Regex) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    for m in re.find_iter(input) {
++        result.push_str(&input[last..m.start()]);
++        for c in input[m.start()..m.end()].chars() {
++            result.push(c.to_lowercase().next().unwrap_or(c));
++        }
++        last = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
++
++fn transform_titlecase(input: &str, re: &Regex) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    for m in re.find_iter(input) {
++        result.push_str(&input[last..m.start()]);
++        let matched = &input[m.start()..m.end()];
++        let mut at_word_start = true;
++        for c in matched.chars() {
++            if c.is_whitespace() {
++                result.push(c);
++                at_word_start = true;
++            } else if at_word_start {
++                for cc in c.to_uppercase() {
++                    result.push(cc);
++                }
++                at_word_start = false;
++            } else {
++                let mut it = c.to_lowercase();
++                if let Some(l) = it.next() {
++                    result.push(l);
++                }
++            }
++        }
++        last = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
++
++fn transform_normalize(input: &str, re: &Regex) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    for m in re.find_iter(input) {
++        result.push_str(&input[last..m.start()]);
++        let matched = &input[m.start()..m.end()];
++        let stripped: String = matched
++            .chars()
++            .filter(|c| !is_combining_mark(*c))
++            .collect();
++        result.push_str(&stripped);
++        last = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
++
++fn is_combining_mark(c: char) -> bool {
++    (0x300..=0x36F).contains(&(c as u32))
++}
++
++fn transform_german(input: &str, re: &Regex, invert: bool) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    for m in re.find_iter(input) {
++        result.push_str(&input[last..m.start()]);
++        let matched = &input[m.start()..m.end()];
++        let s = if invert {
++            matched
++                .replace("ß", "ss")
++                .replace("ä", "ae")
++                .replace("ö", "oe")
++                .replace("ü", "ue")
++        } else {
++            matched
++                .replace("ss", "ß")
++                .replace("ae", "ä")
++                .replace("oe", "ö")
++                .replace("ue", "ü")
++        };
++        result.push_str(&s);
++        last = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
++
++fn transform_symbols(input: &str, re: &Regex, invert: bool) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    for m in re.find_iter(input) {
++        result.push_str(&input[last..m.start()]);
++        let matched = &input[m.start()..m.end()];
++        let s = if invert {
++            matched
++                .replace("→", "->")
++                .replace("≠", "!=")
++                .replace("≤", "<=")
++                .replace("≥", ">=")
++        } else {
++            matched
++                .replace("->", "→")
++                .replace("!=", "≠")
++                .replace("<=", "≤")
++                .replace(">=", "≥")
++        };
++        result.push_str(&s);
++        last = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
++
++fn squeeze(input: &str, re: &Regex) -> String {
++    let mut result = String::with_capacity(input.len());
++    let mut last = 0;
++    let mut prev_ended = 0;
++    for m in re.find_iter(input) {
++        if m.start() > prev_ended && m.start() - prev_ended <= 1 {
++            // consecutive match: squeeze (skip)
++        } else {
++            result.push_str(&input[last..m.end()]);
++        }
++        last = m.end();
++        prev_ended = m.end();
++    }
++    result.push_str(&input[last..]);
++    result
++}
