+
+fn build_command() -> Command {
+    let mut cmd = Command::new(PROGRAM_NAME)
+        .version(VERSION.trim_end())
+        .about("A grep-like tool which understands source code syntax and allows for manipulation in\naddition to search");
+
+    // Composable actions
+    cmd = cmd
+        .arg(arg_bool("upper", 'u', "Uppercase anything in scope."))
+        .arg(arg_bool("lower", 'l', "Lowercase anything in scope."))
+        .arg(arg_bool("titlecase", 't', "Titlecase anything in scope."))
+        .arg(arg_bool("normalize", 'n', "Normalize (Normalization Form D) anything in scope, and throw away marks."))
+        .arg(arg_bool("german", 'g', "Perform substitutions on German words, such as 'Abenteuergruesse' to 'Abenteuergrüße', for anything in scope."))
+        .arg(arg_bool("symbols", 'S', "Perform substitutions on symbols, such as '!=' to '≠', '->' to '→', on anything in scope."));
+
+    // Standalone actions
+    cmd = cmd
+        .arg(arg_bool("delete", 'd', "Delete anything in scope."))
+        .arg(arg_bool("squeeze", 's', "Squeeze consecutive occurrences of scope into one."))
+        .arg(
+            Arg::new("squeeze_repeats")
+                .long("squeeze-repeats")
+                .action(ArgAction::SetTrue)
+                .help("Squeeze repeated actions"),
+        );
+
+    // Scope + replacement
+    cmd = cmd
+        .arg(
+            Arg::new("scope")
+                .value_name("SCOPE")
+                .num_args(1)
+                .help("Scope to apply to, as a regular expression pattern."),
+        )
+        .arg(
+            Arg::new("replacement")
+                .value_name("REPLACEMENT")
+                .num_args(1)
+                .help("Replacement to use."),
+        );
+
+    // File / advanced flags (accepted; no-op or simple in stdin mode).
+    cmd = cmd
+        .arg(
+            Arg::new("fail_no_files")
+                .long("fail-no-files")
+                .action(ArgAction::SetTrue)
+                .help("Fail if working on files (e.g. globbing is requested) but none are found."),
+        )
+        .arg(
+            Arg::new("dry_run")
+                .long("dry-run")
+                .action(ArgAction::SetTrue)
+                .help("Do not destructively overwrite files, instead print rich diff only."),
+        )
+        .arg(
+            Arg::new("invert")
+                .short('i')
+                .long("invert")
+                .action(ArgAction::SetTrue)
+                .help("Undo the effects of passed actions, where applicable."),
+        )
+        .arg(
+            Arg::new("literal_string")
+                .short('L')
+                .long("literal-string")
+                .action(ArgAction::SetTrue)
+                .help("Do not interpret the scope as a regex. Instead, interpret it as a literal string. Will require a scope to be passed."),
+        )
+        .arg(
+            Arg::new("fail_any")
+                .long("fail-any")
+                .action(ArgAction::SetTrue)
+                .help("If anything at all is found to be in scope, fail."),
+        )
+        .arg(
+            Arg::new("fail_none")
+                .long("fail-none")
+                .action(ArgAction::SetTrue)
+                .help("If nothing is found to be in scope, fail."),
+        )
+        .arg(
+            Arg::new("join_language_scopes")
+                .short('j')
+                .long("join-language-scopes")
+                .action(ArgAction::SetTrue)
+                .help("Join (logical 'OR') multiple language scopes, instead of intersecting them."),
+        )
+        .arg(
+            Arg::new("hidden")
+                .short('H')
+                .long("hidden")
+                .action(ArgAction::SetTrue)
+                .help("Do not ignore hidden files and directories."),
+        )
+        .arg(
+            Arg::new("gitignored")
+                .long("gitignored")
+                .action(ArgAction::SetTrue)
+                .help("Do not ignore `.gitignore`d files and directories."),
+        )
+        .arg(
+            Arg::new("sorted")
+                .long("sorted")
+                .action(ArgAction::SetTrue)
+                .help("Process files in lexicographically sorted order, by file path."),
+        )
+        .arg(
+            Arg::new("stdin_detection")
+                .long("stdin-detection")
+                .num_args(1)
+                .value_name("STDIN_DETECTION")
+                .default_value("auto")
+                .help("Control heuristics for stdin readability detection, and force to value."),
+        )
+        .arg(
+            Arg::new("stdout_detection")
+                .long("stdout-detection")
+                .num_args(1)
+                .value_name("STDOUT_DETECTION")
+                .default_value("auto")
+                .help("Control heuristics for stdout detection, and potentially force to value."),
+        )
+        .arg(
+            Arg::new("threads")
+                .long("threads")
+                .num_args(1)
+                .value_name("THREADS")
+                .help("Number of threads to run processing on, when working with files."),
+        )
+        .arg(
+            Arg::new("verbose")
+                .short('v')
+                .long("verbose")
+                .action(ArgAction::Count)
+                .help("Increase log verbosity level."),
+        )
+        .arg(
+            Arg::new("german_prefer_original")
+                .long("german-prefer-original")
+                .action(ArgAction::SetTrue)
+                .help("When some original version and its replacement are equally legal, prefer the original and do not modify."),
+        )
+        .arg(
+            Arg::new("german_naive")
+                .long("german-naive")
+                .action(ArgAction::SetTrue)
+                .help("Always perform any possible replacement ('ae' -> 'ä', 'ss' -> 'ß', etc.), regardless of legality of the resulting word"),
+        );
+
+    // Language scopes (accepted; no-op without tree-sitter). Each flag takes an
+    // optional prepared-query value (comments/strings/etc.).
+    macro_rules! lang_flag {
+        ($lang:literal, $Upper:literal) => {
+            cmd = cmd
+                .arg(
+                    Arg::new($lang)
+                        .long($lang)
+                        .num_args(1)
+                        .value_name($Upper)
+                        .help(&concat!("Scope ", $lang, " code using a prepared query.")),
+                )
+                .arg(
+                    Arg::new(concat!($lang, "_query"))
+                        .long(concat!($lang, "-query"))
+                        .num_args(1)
+                        .value_name(concat!($Upper, "-query"))
+                        .help("Custom tree-sitter query for the language."),
+                )
+                .arg(
+                    Arg::new(concat!($lang, "_query_file"))
+                        .long(concat!($lang, "-query-file"))
+                        .num_args(1)
+                        .value_name(concat!($Upper, "-query-file"))
+                        .help("File containing a custom tree-sitter query for the language."),
+                );
+        };
+    }
+    lang_flag!("c", "C");
+    lang_flag!("csharp", "C#");
+    lang_flag!("go", "GO");
+    lang_flag!("hcl", "HCL");
+    lang_flag!("python", "PYTHON");
+    lang_flag!("rust", "RUST");
+    lang_flag!("typescript", "TYPESCRIPT");
+
+    cmd
+}
+
+fn arg_bool(name: &'static str, short: char, help: &'static str) -> Arg {
+    Arg::new(name)
+        .short(short)
+        .long(name)
+        .action(ArgAction::SetTrue)
+        .help(help)
+}
+
+fn main() -> ExitCode {
+    let raw: Vec<String> = env::args().collect();
+
+    // Pre-scan for help/version: these short-circuit regardless of position.
+    for a in &raw[1..] {
+        if a == "--help" {
+            io::stdout().write_all(LONG_HELP.as_bytes()).ok();
+            return ExitCode::from(0);
+        }
+        if a == "-h" {
+            io::stdout().write_all(SHORT_HELP.as_bytes()).ok();
+            return ExitCode::from(0);
+        }
+        if a == "-V" || a == "--version" {
+            io::stdout().write_all(VERSION.as_bytes()).ok();
+            return ExitCode::from(0);
+        }
+    }
+
+    // Handle --completions manually (clap_complete).
+    if let Some(pos) = raw.iter().position(|a| a == "--completions") {
+        handle_completions(&raw, pos);
+        return ExitCode::from(0);
+    }
+
+    // Pre-process -- to extract the replacement.
+    let (cleaned, replacement) = preprocess_dashdash(&raw);
+
+    init_logger();
+
+    let cmd = build_command();
+    match cmd.try_get_matches_from(&cleaned) {
+        Err(e) => {
+            e.print().ok();
+            return ExitCode::from(2);
+        }
+        Ok(m) => {
+            let cfg = parse_config(&m, &replacement);
+
+            // Scope required when delete or squeeze is present.
+            if (cfg.delete || cfg.squeeze) && cfg.scope.is_none() {
+                let action = if cfg.delete { "--delete" } else { "--squeeze" };
+                let mut out = io::stderr();
+                let _ = writeln!(out, "error: the following required arguments were not provided:");
+                let _ = writeln!(out, "  <SCOPE>");
+                let _ = writeln!(out);
+                let _ = writeln!(out, "Usage: {action} <SCOPE> [-- <REPLACEMENT>]");
+                let _ = writeln!(out);
+                let _ = writeln!(out, "For more information, try '--help'.");
+                return ExitCode::from(2);
+            }
+
+            let code = run(&cfg);
+            return ExitCode::from(code as u8);
+        }
+    }
+}
+
+fn init_logger() {
+    let _ = env_logger::Builder::new()
+        .parse_default_env()
+        .filter_level(log::LevelFilter::Error)
+        .format_timestamp(Some(env_logger::TimestampPrecision::Micros))
+        .init();
+}
+
+fn parse_config(m: &ArgMatches, replacement: &Option<String>) -> Config {
+    let mut cfg = default_config();
+    cfg.upper = m.get_flag("upper");
+    cfg.lower = m.get_flag("lower");
+    cfg.titlecase = m.get_flag("titlecase");
+    cfg.normalize = m.get_flag("normalize");
+    cfg.german = m.get_flag("german");
+    cfg.symbols = m.get_flag("symbols");
+    cfg.delete = m.get_flag("delete");
+    cfg.squeeze = m.get_flag("squeeze");
+    cfg.squeeze_repeats = m.get_flag("squeeze_repeats");
+    cfg.glob = m.get_one::<String>("glob").cloned();
+    cfg.scope = m.get_one::<String>("scope").cloned();
+    cfg.replacement = replacement
+        .clone()
+        .or_else(|| m.get_one::<String>("replacement").cloned());
+    cfg.dry_run = m.get_flag("dry_run");
+    cfg.invert = m.get_flag("invert");
+    cfg.literal_string = m.get_flag("literal_string");
+    cfg.sorted = m.get_flag("sorted");
+    cfg.threads = m.get_one::<String>("threads").and_then(|s| s.parse().ok());
+    cfg
+}
+
+fn handle_completions(raw: &[String], pos: usize) {
+    let shell = raw.get(pos + 1).cloned().unwrap_or_default();
+    let mut cmd = build_command();
+    use clap_complete::Shell;
+    let shells = [
+        ("bash", Shell::Bash),
+        ("elvish", Shell::Elvish),
+        ("fish", Shell::Fish),
+        ("powershell", Shell::PowerShell),
+        ("zsh", Shell::Zsh),
+    ];
+    let mut out = io::stdout();
+    let mut matched = false;
+    for (name, sh) in shells {
+        if shell == name {
+            let _ = clap_complete::generate(sh, &mut cmd, name, &mut out);
+            matched = true;
+        }
+    }
+    if !matched {
+        let mut err = io::stderr();
+        let _ = writeln!(err, "error: a value is required for '--completions <SHELL>' but none was supplied");
+        let _ = writeln!(err, "  [possible values: bash, elvish, fish, powershell, zsh]");
+        let _ = writeln!(err);
+        let _ = writeln!(err, "Usage: executable --completions <SHELL>");
+        let _ = writeln!(err);
+        let _ = writeln!(err, "For more information, try '--help'.");
+        std::process::exit(2);
+    }
+}
+
+fn preprocess_dashdash(raw: &[String]) -> (Vec<String>, Option<String>) {
+    let mut cleaned = Vec::new();
+    let mut replacement: Option<String> = None;
+    let mut dashdash_seen = false;
+    for a in raw {
+        if !dashdash_seen && a == "--" {
+            dashdash_seen = true;
+            continue;
+        }
+        if dashdash_seen {
+            if replacement.is_none() {
+                replacement = Some(a.clone());
+            }
+            continue;
+        }
+        cleaned.push(a.clone());
+    }
+    (cleaned, replacement)
+}
+
+fn run(cfg: &Config) -> u8 {
+    let mut input = String::new();
+    let _ = io::stdin().read_to_string(&mut input);
+
+    let scope = cfg.scope.clone().unwrap_or_else(|| ".*".to_string());
+    // dry_run / sorted / threads only affect file processing, which has no
+    // effect in stdin mode; reference them so they are not dead code.
+    let _ = (cfg.dry_run, cfg.sorted, cfg.threads.is_some());
+    let pattern = if cfg.literal_string {
+        regex::escape(&scope)
+    } else {
+        scope.clone()
+    };
+    let re = match Regex::new(&pattern) {
+        Ok(r) => r,
+        Err(_) => {
+            let mut out = io::stdout();
+            let _ = out.write_all(input.as_bytes());
+            return 0;
+        }
+    };
+
+    let actions: Vec<Action> = build_actions(cfg);
+    let output = transform(&input, &re, &actions, cfg);
+
+    if !has_real_action(cfg, &actions) {
+        log::error!(
+            target: "srgn",
+            "No actions specified, and not in search mode. Will return input unchanged, if any."
+        );
+    }
+
+    let mut out = io::stdout();
+    let _ = out.write_all(output.as_bytes());
+    0
+}
+
+fn build_actions(cfg: &Config) -> Vec<Action> {
+    let mut v = Vec::new();
+    if cfg.replacement.is_some() {
+        v.push(Action::Replace);
+    }
+    if cfg.upper {
+        v.push(Action::Upper);
+    }
+    if cfg.lower {
+        v.push(Action::Lower);
+    }
+    if cfg.titlecase {
+        v.push(Action::Titlecase);
+    }
+    if cfg.normalize {
+        v.push(Action::Normalize);
+    }
+    if cfg.german {
+        v.push(Action::German);
+    }
+    if cfg.symbols {
+        v.push(Action::Symbols);
+    }
+    if cfg.delete {
+        v.push(Action::Delete);
+    }
+    if cfg.squeeze {
+        v.push(Action::Squeeze);
+    }
+    v
+}
+
+fn has_real_action(cfg: &Config, actions: &[Action]) -> bool {
+    if cfg.replacement.is_some() {
+        return true;
+    }
+    for a in actions {
+        if *a != Action::Squeeze {
+            return true;
+        }
+    }
+    false
+}
+
+fn transform(input: &str, re: &Regex, actions: &[Action], cfg: &Config) -> String {
+    let mut out = input.to_string();
+
+    if let Some(rep) = &cfg.replacement {
+        out = re.replace_all(&out, rep).to_string();
+    }
+
+    for a in actions {
+        match a {
+            Action::Upper => out = if cfg.invert {
+                transform_lower(&out, re)
+            } else {
+                transform_upper(&out, re)
+            },
+            Action::Lower => out = if cfg.invert {
+                transform_upper(&out, re)
+            } else {
+                transform_lower(&out, re)
+            },
+            Action::Titlecase => out = transform_titlecase(&out, re),
+            Action::Normalize => out = transform_normalize(&out, re),
+            Action::German => out = transform_german(&out, re, cfg.invert),
+            Action::Symbols => out = transform_symbols(&out, re, cfg.invert),
+            Action::Delete => out = re.replace_all(&out, "").to_string(),
+            Action::Squeeze => {}
+            Action::Replace => {}
+        }
+    }
+
+    if cfg.squeeze {
+        out = squeeze(&out, re);
+    }
+
+    out
+}
+
+fn transform_upper(input: &str, re: &Regex) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    for m in re.find_iter(input) {
+        result.push_str(&input[last..m.start()]);
+        for c in input[m.start()..m.end()].chars() {
+            result.push(c.to_uppercase().next().unwrap_or(c));
+        }
+        last = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
+
+fn transform_lower(input: &str, re: &Regex) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    for m in re.find_iter(input) {
+        result.push_str(&input[last..m.start()]);
+        for c in input[m.start()..m.end()].chars() {
+            result.push(c.to_lowercase().next().unwrap_or(c));
+        }
+        last = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
+
+fn transform_titlecase(input: &str, re: &Regex) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    for m in re.find_iter(input) {
+        result.push_str(&input[last..m.start()]);
+        let matched = &input[m.start()..m.end()];
+        let mut at_word_start = true;
+        for c in matched.chars() {
+            if c.is_whitespace() {
+                result.push(c);
+                at_word_start = true;
+            } else if at_word_start {
+                for cc in c.to_uppercase() {
+                    result.push(cc);
+                }
+                at_word_start = false;
+            } else {
+                let mut it = c.to_lowercase();
+                if let Some(l) = it.next() {
+                    result.push(l);
+                }
+            }
+        }
+        last = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
+
+fn transform_normalize(input: &str, re: &Regex) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    for m in re.find_iter(input) {
+        result.push_str(&input[last..m.start()]);
+        let matched = &input[m.start()..m.end()];
+        let stripped: String = matched
+            .chars()
+            .filter(|c| !is_combining_mark(*c))
+            .collect();
+        result.push_str(&stripped);
+        last = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
+
+fn is_combining_mark(c: char) -> bool {
+    (0x300..=0x36F).contains(&(c as u32))
+}
+
+fn transform_german(input: &str, re: &Regex, invert: bool) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    for m in re.find_iter(input) {
+        result.push_str(&input[last..m.start()]);
+        let matched = &input[m.start()..m.end()];
+        let s = if invert {
+            matched
+                .replace("ß", "ss")
+                .replace("ä", "ae")
+                .replace("ö", "oe")
+                .replace("ü", "ue")
+        } else {
+            matched
+                .replace("ss", "ß")
+                .replace("ae", "ä")
+                .replace("oe", "ö")
+                .replace("ue", "ü")
+        };
+        result.push_str(&s);
+        last = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
+
+fn transform_symbols(input: &str, re: &Regex, invert: bool) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    for m in re.find_iter(input) {
+        result.push_str(&input[last..m.start()]);
+        let matched = &input[m.start()..m.end()];
+        let s = if invert {
+            matched
+                .replace("→", "->")
+                .replace("≠", "!=")
+                .replace("≤", "<=")
+                .replace("≥", ">=")
+        } else {
+            matched
+                .replace("->", "→")
+                .replace("!=", "≠")
+                .replace("<=", "≤")
+                .replace(">=", "≥")
+        };
+        result.push_str(&s);
+        last = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
+
+fn squeeze(input: &str, re: &Regex) -> String {
+    let mut result = String::with_capacity(input.len());
+    let mut last = 0;
+    let mut prev_ended = 0;
+    for m in re.find_iter(input) {
+        if m.start() > prev_ended && m.start() - prev_ended <= 1 {
+            // consecutive match: squeeze (skip)
+        } else {
+            result.push_str(&input[last..m.end()]);
+        }
+        last = m.end();
+        prev_ended = m.end();
+    }
+    result.push_str(&input[last..]);
+    result
+}
