+    normalize: bool,
+    german: bool,
+    symbols: bool,
+    delete: bool,
+    squeeze: bool,
+    squeeze_repeats: bool,
+    glob: Option<String>,
+    dry_run: bool,
+    invert: bool,
+    literal_string: bool,
+    sorted: bool,
+    threads: Option<usize>,
+}
+
+fn default_config() -> Config {
+    Config {
+        scope: None,
+        replacement: None,
+        upper: false,
+        lower: false,
+        titlecase: false,
+        normalize: false,
+        german: false,
+        symbols: false,
+        delete: false,
+        squeeze: false,
+        squeeze_repeats: false,
