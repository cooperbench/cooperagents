+const SHORT_HELP: &str = include_str!("short_help.txt");
+const VERSION: &str = include_str!("version.txt");
+const PROGRAM_NAME: &str = "srgn";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Action {
+    Replace,
+    Upper,
+    Lower,
+    Titlecase,
+    Normalize,
+    German,
+    Symbols,
+    Delete,
+    Squeeze,
+}
+
+struct Config {
