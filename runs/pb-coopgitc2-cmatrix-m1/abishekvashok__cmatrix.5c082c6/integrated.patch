+    matrix_old = malloc(rows * sizeof(char *));
+    matrix_bold = malloc(rows * cols * sizeof(int));
+    matrix_old_bold = malloc(rows * cols * sizeof(int));
+    for (int i = 0; i < rows; i++) {
+        matrix[i] = malloc(cols * sizeof(char));
+        matrix_old[i] = malloc(cols * sizeof(char));
+        for (int j = 0; j < cols; j++) {
+            matrix[i][j] = ' '; matrix_old[i][j] = ' ';
+            matrix_bold[i * cols + j] = 0; matrix_old_bold[i * cols + j] = 0;
+        }
+    }
+}
+
+static void free_matrix(void) {
+    if (matrix) { for (int i = 0; i < rows; i++) free(matrix[i]); free(matrix); matrix = NULL; }
+    if (matrix_old) { for (int i = 0; i < rows; i++) free(matrix_old[i]); free(matrix_old); matrix_old = NULL; }
+    if (matrix_bold) { free(matrix_bold); matrix_bold = NULL; }
+    if (matrix_old_bold) { free(matrix_old_bold); matrix_old_bold = NULL; }
+}
+
+static char get_random_char(void) {
+    if (lambda_mode) return 'L';
+    if (use_katakana) return (char)katakana_chars[rand() % (strlen(katakana_chars) + 1)];
+    if (use_korean) return (char)korean_chars[rand() % (strlen(korean_chars) + 1)];
+    if (use_japanese) return (char)japanese_chars[rand() % (strlen(japanese_chars) + 1)];
+    return (char)ascii_chars[rand() % (strlen(ascii_chars) + 1)];
+}
+
+static void set_color(int idx) {
+    if (rainbow_mode) color_index = (color_index + 1) % 8;
+    printf("%s", colors[color_index]);
+}
+
+static void print_matrix(void) {
+    for (int i = 0; i < rows; i++) {
+        for (int j = 0; j < cols; j++) {
+            char c = matrix[i][j];
+            int bold = matrix_bold[i * cols + j];
+            if (c == ' ') { printf("%s", reset_color); if (bold) printf("\033[1m"); printf(" "); if (bold) printf("\033[0m"); }
+            else { set_color(color_index); if (bold) printf("\033[1m"); printf("%c", c); if (bold) printf("\033[0m"); }
+        }
+        printf("\n");
+    }
+    printf("%s", reset_color);
+}
+
+static void print_message(void) {
+    if (custom_message[0]) { printf("\033[H"); printf("%s", custom_message); printf("\033[0m\n"); }
+}
+
+static void print_lock_message(void) {
+    printf("\033[H"); printf("\033[31m"); printf("CMatrix is locked. Press any key to unlock.\033[0m\n"); fflush(stdout);
+}
+
+static void print_help(void) {
+    printf("Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    struct timeval tv; gettimeofday(&tv, NULL);
+    struct tm *tm_info = localtime(&tv.tv_sec);
+    char time_str[20]; strftime(time_str, sizeof(time_str), "%H:%M:%S", tm_info);
+    char month_str[3], day_str[3];
+    snprintf(month_str, sizeof(month_str), "%d", tm_info->tm_mon + 1);
+    snprintf(day_str, sizeof(day_str), "%d", tm_info->tm_mday);
+    printf("CMatrix version %s (compiled %s, %s %s %d)\n", VERSION, time_str, month_str, day_str, tm_info->tm_year + 1900);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void parse_color(const char *color) {
+    if (strcmp(color, "green") == 0) color_index = 0;
+    else if (strcmp(color, "red") == 0) color_index = 1;
+    else if (strcmp(color, "blue") == 0) color_index = 2;
+    else if (strcmp(color, "white") == 0) color_index = 3;
+    else if (strcmp(color, "yellow") == 0) color_index = 4;
+    else if (strcmp(color, "cyan") == 0) color_index = 5;
+    else if (strcmp(color, "magenta") == 0) color_index = 6;
+    else if (strcmp(color, "black") == 0) color_index = 7;
+}
+
+static void parse_args(int argc, char **argv) {
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) { help_shown = 1; break; }
+        else if (strcmp(argv[i], "-V") == 0) { version_shown = 1; break; }
+        else if (strcmp(argv[i], "-a") == 0) async_scroll = 1;
+        else if (strcmp(argv[i], "-b") == 0) bold_chars = 1;
+        else if (strcmp(argv[i], "-B") == 0) all_bold = 1;
+        else if (strcmp(argv[i], "-c") == 0) { use_katakana = 1; use_korean = 0; use_japanese = 0; }
+        else if (strcmp(argv[i], "-f") == 0) force_term = 1;
+        else if (strcmp(argv[i], "-l") == 0) linux_mode = 1;
+        else if (strcmp(argv[i], "-L") == 0) lock_mode = 1;
+        else if (strcmp(argv[i], "-o") == 0) old_style = 1;
+        else if (strcmp(argv[i], "-n") == 0) no_bold = 1;
+        else if (strcmp(argv[i], "-s") == 0) screensaver_mode = 1;
+        else if (strcmp(argv[i], "-x") == 0) x_mode = 1;
+        else if (strcmp(argv[i], "-r") == 0) rainbow_mode = 1;
+        else if (strcmp(argv[i], "-m") == 0) lambda_mode = 1;
+        else if (strcmp(argv[i], "-k") == 0) change_chars = 1;
+        else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) { delay = atoi(argv[++i]); if (delay < MIN_DELAY) delay = MIN_DELAY; if (delay > MAX_DELAY) delay = MAX_DELAY; }
+        else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) parse_color(argv[++i]);
+        else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) { strncpy(custom_message, argv[++i], sizeof(custom_message) - 1); message_mode = 1; }
+        else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) { tty_device = argv[++i]; tty_set = 1; }
+    }
+}
+
+static void update_matrix(void) {
+    if (change_chars) {
+        for (int i = 0; i < rows; i++) for (int j = 0; j < cols; j++) if (matrix[i][j] != ' ') matrix[i][j] = get_random_char();
+    }
+    for (int i = 0; i < rows - 1; i++) {
+        for (int j = 0; j < cols; j++) {
+            if (matrix[i][j] != ' ') {
+                int next_row = async ? (i + 1) % rows : i + 1;
+                if (next_row >= rows) next_row = 0;
+                if (matrix[i][j] != matrix_old[next_row][j]) {
+                    matrix_old[next_row][j] = matrix[i][j];
+                    matrix_old_bold[next_row * cols + j] = bold_chars || all_bold;
+                }
+            }
+        }
+    }
+    for (int i = 0; i < cols; i++) {
+        if (matrix[rows - 1][i] != ' ') {
+            int next_row = async ? (rows - 1) % rows : 0;
+            if (next_row >= rows) next_row = 0;
+            if (matrix[rows - 1][i] != matrix_old[next_row][i]) {
+                matrix_old[next_row][i] = matrix[rows - 1][i];
+                matrix_old_bold[next_row * cols + i] = bold_chars || all_bold;
+            }
+        }
+    }
+    for (int i = 0; i < rows - 1; i++) {
+        for (int j = 0; j < cols; j++) {
+            if (matrix[i][j] != ' ') {
+                int next_row = async ? (i + 1) % rows : i + 1;
+                if (next_row >= rows) next_row = 0;
+                matrix[next_row][j] = matrix[i][j];
+                matrix_bold[next_row * cols + j] = matrix_old_bold[next_row * cols + j];
+            }
+        }
+    }
+    for (int i = 0; i < cols; i++) {
+        if (matrix[rows - 1][i] != ' ') {
+            int next_row = async ? (rows - 1) % rows : 0;
+            if (next_row >= rows) next_row = 0;
+            matrix[next_row][i] = matrix[rows - 1][i];
+            matrix_bold[next_row * cols + i] = matrix_old_bold[next_row * cols + i];
+        }
+    }
+    for (int i = 0; i < rows; i++) for (int j = 0; j < cols; j++) if (matrix[i][j] == ' ') { matrix[i][j] = get_random_char(); matrix_bold[i * cols + j] = bold_chars || all_bold; }
+}
+
+static void handle_input(void) {
+    char buf[10]; ssize_t n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+    if (n > 0) {
+        buf[n] = '\0';
+        for (int i = 0; buf[i]; i++) {
+            char c = buf[i];
+            if (c == 'q' || c == 'Q') quit = 1;
+            else if (c == 'a' || c == 'A') async = !async;
+            else if (c == 'b' || c == 'B') bold_chars = !bold_chars;
+            else if (c == 'n' || c == 'N') bold_chars = 0;
+            else if (c >= '0' && c <= '9') delay = c - '0';
+            else if (c == '!') color_index = 1;
+            else if (c == '@') color_index = 0;
+            else if (c == '#') color_index = 4;
+            else if (c == '$') color_index = 2;
+            else if (c == '%') color_index = 6;
+            else if (c == '^') color_index = 5;
+            else if (c == '&') color_index = 3;
+            else if (c == ')') color_index = 7;
+        }
+    }
+}
+
+static void run(void) {
+    if (lock_mode) { print_lock_message(); while (!quit) { handle_input(); usleep(100000); } return; }
+    if (message_mode) { print_message(); while (!quit) { handle_input(); usleep(100000); } return; }
+    if (screensaver_mode) {
+        print_matrix();
+        while (!quit) {
+            handle_input();
+            if (isatty(STDIN_FILENO)) {
+                char buf[10]; ssize_t n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+                if (n > 0) { buf[n] = '\0'; if (buf[0] != '\n' && buf[0] != '\r') quit = 1; }
+            }
+            usleep(100000);
+        }
+        return;
+    }
+    init_matrix(); get_terminal_size();
+    int last_update = 0;
+    while (!quit) {
+        int now = time(NULL);
+        if (now - last_update >= delay) { last_update = now; update_matrix(); print_matrix(); fflush(stdout); }
+        handle_input();
+        usleep(100000);
+    }
+    restore_terminal();
+}
+
+int main(int argc, char **argv) {
+    parse_args(argc, argv);
+    if (help_shown) { print_help(); return 0; }
+    if (version_shown) { print_version(); return 0; }
+    setup_signal_handlers();
+    save_terminal();
+    set_raw_mode();
+    run();
+    free_matrix();
+    restore_terminal();
+    return 0;
+}
