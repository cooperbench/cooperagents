+	buf.WriteString("/* OperatorReserved */ .chroma .or { color: #f92672 }\n")
+	buf.WriteString("/* Comment */ .chroma .c { color: #75715e }\n")
+	buf.WriteString("/* CommentHashbang */ .chroma .ch { color: #75715e }\n")
+	buf.WriteString("/* CommentMultiline */ .chroma .cm { color: #75715e }\n")
+	buf.WriteString("/* CommentSingle */ .chroma .c1 { color: #75715e }\n")
+	buf.WriteString("/* CommentSpecial */ .chroma .cs { color: #75715e }\n")
+	buf.WriteString("/* CommentPreproc */ .chroma .cp { color: #75715e }\n")
+	buf.WriteString("/* CommentPreprocFile */ .chroma .cpf { color: #75715e }\n")
