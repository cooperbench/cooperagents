+	buf.WriteString("/* GenericStrong */ .chroma .gs { font-weight: bold }\n")
+	buf.WriteString("/* GenericSubheading */ .chroma .gu { color: #75715e }\n")
+	buf.WriteString("body { color:#f8f8f2;background-color:#272822;; }\n")
+	buf.WriteString("</style><body class=\"bg\">\n")
