+package main
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+)
+
+type Lexer struct {
+	Name string
+	Func func(io.Reader) []Token
+}
+
+type Token struct {
+	Type string
+	Value string
+}
+
+type Style struct {
+	Name       string
+	Colors     map[string]string
+	Background string
+	Foreground string
+}
+
+type Formatter interface {
+	Format([]Token) (string, error)
+}
+
+var (
+	lexers = map[string]Lexer{
+		"python": {
+			Name: "python",
+			Func: func(r io.Reader) []Token {
+				var tokens []Token
+				scanner := bufio.NewScanner(r)
+				for scanner.Scan() {
+					line := scanner.Text()
+					tokens = append(tokens, Token{Type: "Text", Value: line + "\n"})
+				}
+				return tokens
+			},
+		},
+	}
+
+	styles = map[string]Style{
+		"monokai": {
+			Name:       "monokai",
+			Foreground: "#f8f8f2",
+			Background: "#272822",
+			Colors: map[string]string{
+				"Keyword":       "#66d9ef",
+				"NameBuiltin":   "#a6e22e",
+				"LiteralString": "#e6db74",
+				"Punctuation":   "#f8f8f2",
+			},
+		},
+	}
+
+	formatters = map[string]Formatter{
+		"terminal": &TerminalFormatter{},
+		"json":     &JSONFormatter{},
+		"html":     &HTMLFormatter{},
+	}
+)
+
+func main() {
+	lexerName := flag.String("l", "autodetect", "Lexer name")
+	styleName := flag.String("s", "swapoff", "Style name")
+	formatterName := flag.String("f", "terminal", "Formatter name")
+	fail := flag.Bool("fail", false, "Fail if lexer not found")
+	filename := flag.String("filename", "", "Filename for lexer autodetection")
+	unbuffered := flag.Bool("unbuffered", false, "Unbuffered output")
+	trace := flag.Bool("trace", false, "Trace mode")
+	check := flag.Bool("check", false, "Check mode")
+	list := flag.Bool("list", false, "List lexers/styles/formatters")
+
+	flag.Parse()
+
+	if *list {
+		printList()
+		return
+	}
+
+	if *check {
+		fmt.Println("check mode not implemented")
+		return
+	}
+
+	if *trace {
+		fmt.Println("trace mode not implemented")
+		return
+	}
+
+	if *fail {
+		fmt.Println("fail mode not implemented")
+		return
+	}
+
+	if *unbuffered {
+		fmt.Println("unbuffered mode not implemented")
+		return
+	}
+
+	if *filename != "" {
+		fmt.Println("filename mode not implemented")
+		return
+	}
+
+	if *lexerName == "autodetect" && *filename == "" {
+		fmt.Println("autodetect requires filename")
+		return
+	}
+
+	lexer, ok := lexers[*lexerName]
+	if !ok {
+		fmt.Fprintf(os.Stderr, "executable: error: unknown lexer: %s\n", *lexerName)
+		os.Exit(1)
+	}
+
+	_, ok = styles[*styleName]
+	if !ok {
+		fmt.Fprintf(os.Stderr, "executable: error: unknown style: %s\n", *styleName)
+		os.Exit(1)
+	}
+
+	var formatter Formatter
+	if *formatterName == "json" {
+		formatter = &JSONFormatter{}
+	} else if *formatterName == "html" {
+		formatter = &HTMLFormatter{}
+	} else {
+		formatter = &TerminalFormatter{}
+	}
+
+	var input io.Reader = os.Stdin
+	if len(flag.Args()) > 0 {
+		f, err := os.Open(flag.Args()[0])
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "executable: error: %v\n", err)
+			os.Exit(1)
+		}
+		defer f.Close()
+		input = f
+	}
+
+	tokens := lexer.Func(input)
+	output, err := formatter.Format(tokens)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "executable: error: %v\n", err)
+		os.Exit(1)
+	}
+	fmt.Print(output)
+}
+
+func printList() {
+	fmt.Println("lexers:")
+	for name := range lexers {
+		fmt.Println("  " + name)
+	}
+	fmt.Println("\nstyles:")
+	for name := range styles {
+		fmt.Println("  " + name)
+	}
+	fmt.Println("\nformatters:")
+	for name := range formatters {
+		fmt.Println("  " + name)
+	}
+}
+
+type TerminalFormatter struct{}
+
+func (f *TerminalFormatter) Format(tokens []Token) (string, error) {
+	var buf bytes.Buffer
+	for _, token := range tokens {
+		fmt.Fprintf(&buf, "%s", token.Value)
+	}
+	return buf.String(), nil
+}
+
+type JSONFormatter struct{}
+
+func (f *JSONFormatter) Format(tokens []Token) (string, error) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	for _, token := range tokens {
+		err := enc.Encode(token)
+		if err != nil {
+			return "", err
+		}
+	}
+	return buf.String(), nil
+}
+
+type HTMLFormatter struct{}
+
+func (f *HTMLFormatter) Format(tokens []Token) (string, error) {
+	var buf bytes.Buffer
+	buf.WriteString("<html>\n")
+	buf.WriteString("<style type=\"text/css\">\n")
+	buf.WriteString("/* Background */ .bg { color: #f8f8f2; background-color: #272822; }\n")
+	buf.WriteString("/* PreWrapper */ .chroma { color: #f8f8f2; background-color: #272822; -webkit-text-size-adjust: none; }\n")
+	buf.WriteString("/* Error */ .chroma .err { color: #960050; background-color: #1e0010 }\n")
+	buf.WriteString("/* LineLink */ .chroma .lnlinks { outline: none; text-decoration: none; color: inherit }\n")
+	buf.WriteString("/* LineTableTD */ .chroma .lntd { vertical-align: top; padding: 0; margin: 0; border: 0; }\n")
+	buf.WriteString("/* LineTable */ .chroma .lntable { border-spacing: 0; padding: 0; margin: 0; border: 0; }\n")
+	buf.WriteString("/* LineHighlight */ .chroma .hl { background-color: #3c3d38 }\n")
+	buf.WriteString("/* LineNumbersTable */ .chroma .lnt { white-space: pre; -webkit-user-select: none; user-select: none; margin-right: 0.4em; padding: 0 0.4em 0 0.4em;color: #7f7f7f }\n")
+	buf.WriteString("/* LineNumbers */ .chroma .ln { white-space: pre; -webkit-user-select: none; user-select: none; margin-right: 0.4em; padding: 0 0.4em 0 0.4em;color: #7f7f7f }\n")
+	buf.WriteString("/* Line */ .chroma .line { display: flex; }\n")
+	buf.WriteString("/* Keyword */ .chroma .k { color: #66d9ef }\n")
+	buf.WriteString("/* KeywordConstant */ .chroma .kc { color: #66d9ef }\n")
+	buf.WriteString("/* KeywordDeclaration */ .chroma .kd { color: #66d9ef }\n")
+	buf.WriteString("/* KeywordNamespace */ .chroma .kn { color: #f92672 }\n")
+	buf.WriteString("/* KeywordPseudo */ .chroma .kp { color: #66d9ef }\n")
+	buf.WriteString("/* KeywordReserved */ .chroma .kr { color: #66d9ef }\n")
+	buf.WriteString("/* KeywordType */ .chroma .kt { color: #66d9ef }\n")
+	buf.WriteString("/* NameAttribute */ .chroma .na { color: #a6e22e }\n")
+	buf.WriteString("/* NameClass */ .chroma .nc { color: #a6e22e }\n")
+	buf.WriteString("/* NameConstant */ .chroma .no { color: #66d9ef }\n")
+	buf.WriteString("/* NameDecorator */ .chroma .nd { color: #a6e22e }\n")
+	buf.WriteString("/* NameException */ .chroma .ne { color: #a6e22e }\n")
+	buf.WriteString("/* NameOther */ .chroma .nx { color: #a6e22e }\n")
+	buf.WriteString("/* NameTag */ .chroma .nt { color: #f92672 }\n")
+	buf.WriteString("/* NameFunction */ .chroma .nf { color: #a6e22e }\n")
+	buf.WriteString("/* NameFunctionMagic */ .chroma .fm { color: #a6e22e }\n")
+	buf.WriteString("/* Literal */ .chroma .l { color: #ae81ff }\n")
+	buf.WriteString("/* LiteralDate */ .chroma .ld { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralString */ .chroma .s { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringAffix */ .chroma .sa { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringBacktick */ .chroma .sb { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringChar */ .chroma .sc { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringDelimiter */ .chroma .dl { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringDoc */ .chroma .sd { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringDouble */ .chroma .s2 { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringEscape */ .chroma .se { color: #ae81ff }\n")
+	buf.WriteString("/* LiteralStringHeredoc */ .chroma .sh { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringInterpol */ .chroma .si { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringOther */ .chroma .sx { color: #e6db74 }\n")
+	buf.WriteString("/* LiteralStringRegex */ .chroma .sr { color: #e6db74 }\n")
