+/*
+ * display.c - Terminal display handling
+ * Part of CMatrix - Matrix-like terminal effect
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+#include <ctype.h>
+
+#include "matrix.h"
+
+static int terminal_width = 80;
+static int terminal_height = 24;
+static int async_mode = 0;
+static int old_style_mode = 0;
+static int bold_mode = 0;
+static int all_bold_mode = 0;
+static int no_bold_mode = 0;
+static int only_shadows = 0;
+static int lock_mode = 0;
+static int screensaver_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int characters_change = 0;
+static int use_japanese = 0;
+static int force_term = 0;
+static int tty_fd = -1;
+
+static char **columns = NULL;
+static int num_columns = 0;
+
+static void resize_terminal(void) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        terminal_width = ws.ws_col;
+        terminal_height = ws.ws_row;
+    } else {
+        terminal_width = 80;
+        terminal_height = 24;
+    }
+    
+    if (columns != NULL) {
+        free(columns);
+        columns = NULL;
+    }
+    
+    num_columns = terminal_width;
+    columns = malloc(num_columns * sizeof(char *));
+    if (columns == NULL) {
+        fprintf(stderr, "Memory allocation failed\n");
+        exit(1);
+    }
+    
+    for (int i = 0; i < num_columns; i++) {
+        columns[i] = malloc((terminal_height + 1) * sizeof(char));
+        if (columns[i] == NULL) {
+            fprintf(stderr, "Memory allocation failed\n");
+            exit(1);
+        }
+        columns[i][terminal_height] = '\0';
+    }
+}
+
+static void init_display(void) {
+    resize_terminal();
+}
+
+static void clear_display(void) {
+    for (int i = 0; i < num_columns; i++) {
+        for (int j = 0; j < terminal_height; j++) {
+            columns[i][j] = ' ';
+        }
+    }
+}
+
+static void print_column(int col, int row, char c, int bold, int shadow) {
+    if (col >= 0 && col < num_columns && row >= 0 && row < terminal_height) {
+        if (shadow) {
+            columns[col][row] = c;
+        } else {
+            columns[col][row] = c;
+        }
+    }
+}
+
+static void flush_display(void) {
+    for (int i = 0; i < num_columns; i++) {
+        for (int j = 0; j < terminal_height; j++) {
+            putchar(columns[i][j]);
+        }
+        putchar('\n');
+    }
+}
+
+static void update_display(void) {
+    for (int i = 0; i < num_columns; i++) {
+        for (int j = 0; j < terminal_height; j++) {
+            putchar(columns[i][j]);
+        }
+        putchar('\n');
+    }
+}
+
+static void close_display(void) {
+    if (columns != NULL) {
+        for (int i = 0; i < num_columns; i++) {
+            free(columns[i]);
+        }
+        free(columns);
+        columns = NULL;
+    }
+}
