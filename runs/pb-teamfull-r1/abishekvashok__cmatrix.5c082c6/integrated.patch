+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+
+#include "config.h"
+#include "terminal.h"
+#include "matrix.h"
+#include "display.h"
+#include "color.h"
+#include "interactive.h"
+#include "modes.h"
+#include "linux.h"
+
+#define VERSION "2.0"
+#define COMPILATION_TIME "22:13:51"
+#define COMPILATION_DATE "Jun 11 2026"
+
+static void print_usage(const char *prog) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s, %s)\n", VERSION, COMPILATION_TIME, COMPILATION_DATE);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void print_help(const char *prog) {
+    print_usage(prog);
+}
+
+static void print_error(const char *msg) {
+    fprintf(stderr, "Error: %s\n", msg);
+}
+
+int main(int argc, char *argv[]) {
+    config_t config;
+    config_init(&config);
+    
+    if (argc < 2) {
+        print_help(argv[0]);
+        return 0;
+    }
+    
+    int i = 1;
+    while (i < argc) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_help(argv[0]);
+            return 0;
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            return 0;
+        } else if (strcmp(argv[i], "-a") == 0) {
+            config.async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            config.bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            config.all_bold = 1;
+            config.bold_chars = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            config.japanese_chars = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            config.force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            config.linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            config.lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            config.old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            config.no_bold = 1;
+            config.bold_chars = 0;
+            config.all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            config.screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            config.x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            config.rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            config.lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            config.changing_chars = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            config.update_delay = atoi(argv[++i]);
+            if (config.update_delay < 0) config.update_delay = 0;
+            if (config.update_delay > 10) config.update_delay = 10;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            config.color = parse_color(argv[++i]);
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            config.center_message = argv[++i];
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            config.tty = argv[++i];
+        } else {
+            print_error("Unknown option: " argv[i]);
+            print_help(argv[0]);
+            return 1;
+        }
+        i++;
+    }
+    
+    if (config.update_delay < 0) config.update_delay = 4;
+    if (config.update_delay > 10) config.update_delay = 4;
+    
+    if (config.no_bold) {
+        config.bold_chars = 0;
+        config.all_bold = 0;
+    }
+    
+    if (config.all_bold) {
+        config.bold_chars = 1;
+    }
+    
+    if (config.linux_mode) {
+        linux_init();
+    }
+    
+    if (config.force_term) {
+        terminal_force();
+    }
+    
+    if (config.x_mode) {
+        printf("X window mode not supported in this build\n");
+        return 0;
+    }
+    
+    if (config.screensaver) {
+        printf("Screensaver mode not fully supported\n");
+    }
+    
+    if (config.lock_mode) {
+        printf("Lock mode not fully supported\n");
+    }
+    
+    if (config.japanese_chars) {
+        printf("Japanese characters mode requires appropriate fonts\n");
+    }
+    
+    matrix_init(&config);
+    display_init(&config);
+    color_init(&config);
+    
+    printf("\n");
+    
+    while (1) {
+        matrix_update(&config);
+        display_update(&config);
+        color_update(&config);
+        
+        if (config.screensaver) {
+            interactive_check(&config);
+        }
+        
+        usleep(config.update_delay * 100000);
+    }
+    
+    return 0;
+}
