+/*
+ * matrix.c - Matrix character generation
+ * Part of CMatrix - Matrix-like terminal effect
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <ctype.h>
+
+/* Matrix characters - Katakana and Latin */
+static const char matrix_chars[] = 
+    "アァカサタナハマヤャラワガザダバパイ"
+    "ィイウエオゥヴカシチニヒミヂビピ"
+    "ェェォフクスヴヅトヌムヅツヅ"
+    "ヴンヰヱヲンヴ"
+    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+static const char *latin_chars = 
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+
+static const char *katakana_chars = 
+    "アァカサタナハマヤャラワガザダバパイ"
+    "ィイウエオゥヴカシチニヒミヂビピ"
+    "ェェォフクスヴヅトヌムヅツヅ"
+    "ヴンヰヱヲンヴ";
+
+static const char *lambda_chars = 
+    "λΛ";
+
+/* Get a random character */
+static char get_random_char(int use_japanese, int lambda_mode, int characters_change) {
+    static char last_char = 'A';
+    static int change_counter = 0;
+    
+    if (lambda_mode) {
+        return lambda_chars[rand() % 2];
+    }
+    
+    if (characters_change && change_counter > 0) {
+        change_counter--;
+        return matrix_chars[rand() % (sizeof(matrix_chars) - 1)];
+    }
+    
+    if (use_japanese) {
+        return katakana_chars[rand() % (sizeof(katakana_chars) - 1)];
+    }
+    
+    return matrix_chars[rand() % (sizeof(matrix_chars) - 1)];
+}
+
+/* Get a random character for display */
+static char get_display_char(int use_japanese, int lambda_mode, int characters_change) {
+    if (lambda_mode) {
+        return lambda_chars[rand() % 2];
+    }
+    
+    if (use_japanese) {
+        return katakana_chars[rand() % (sizeof(katakana_chars) - 1)];
+    }
+    
+    return matrix_chars[rand() % (sizeof(matrix_chars) - 1)];
+}
