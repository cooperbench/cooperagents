new file mode 100644
index 0000000..a8a5b1b
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,307 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <curses.h>
+#include <locale.h>
+#include <signal.h>
+#include <time.h>
+#include <math.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_DELAY 10
+#define MIN_DELAY 0
+
+typedef struct {
+    int async;
+    int bold;
+    int all_bold;
+    int force_term;
+    int linux_mode;
+    int old_scroll;
+    int shadow_only;
+    int lock;
+    int rainbow;
+    int every_char;
+    int no_bold;
+    int screensaver;
+    int lambda_mode;
+    int x_mode;
+    int tty;
+    int update_delay;
+    char *color;
+    char *message;
+    int use_japanese;
+} options_t;
+
+static options_t opts = {
+    .async = 0,
+    .bold = 0,
+    .all_bold = 0,
+    .force_term = 0,
+    .linux_mode = 0,
+    .old_scroll = 0,
+    .shadow_only = 0,
+    .lock = 0,
+    .rainbow = 0,
+    .every_char = 0,
+    .no_bold = 0,
+    .screensaver = 0,
+    .lambda_mode = 0,
+    .x_mode = 0,
+    .tty = 0,
+    .update_delay = DEFAULT_DELAY,
+    .color = NULL,
+    .message = NULL,
+    .use_japanese = 0
+};
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void parse_args(int argc, char **argv) {
+    int i;
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            opts.async = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            opts.bold = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            opts.all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            opts.use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            opts.force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            opts.linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            opts.lock = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            opts.old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            opts.no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            opts.screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            opts.x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            opts.rainbow = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            opts.every_char = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            opts.lambda_mode = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            opts.update_delay = atoi(argv[++i]);
+            if (opts.update_delay < MIN_DELAY) opts.update_delay = MIN_DELAY;
+            if (opts.update_delay > MAX_DELAY) opts.update_delay = MAX_DELAY;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            opts.color = argv[++i];
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            opts.message = argv[++i];
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            opts.tty = atoi(argv[++i]);
+        } else {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            print_usage();
+            exit(1);
+        }
+    }
+}
+
+static void init_curses(void) {
+    initscr();
+    cbreak();
+    noecho();
+    keypad(stdscr, TRUE);
+    curs_set(0);
+    nodelay(stdscr, TRUE);
+    scrollok(stdscr, TRUE);
+    clear();
+    refresh();
+}
+
+static void set_color(const char *color) {
+    if (strcmp(color, "green") == 0) {
+        init_pair(1, COLOR_GREEN, COLOR_BLACK);
+    } else if (strcmp(color, "red") == 0) {
+        init_pair(1, COLOR_RED, COLOR_BLACK);
+    } else if (strcmp(color, "blue") == 0) {
+        init_pair(1, COLOR_BLUE, COLOR_BLACK);
+    } else if (strcmp(color, "white") == 0) {
+        init_pair(1, COLOR_WHITE, COLOR_BLACK);
+    } else if (strcmp(color, "yellow") == 0) {
+        init_pair(1, COLOR_YELLOW, COLOR_BLACK);
+    } else if (strcmp(color, "cyan") == 0) {
+        init_pair(1, COLOR_CYAN, COLOR_BLACK);
+    } else if (strcmp(color, "magenta") == 0) {
+        init_pair(1, COLOR_MAGENTA, COLOR_BLACK);
+    } else if (strcmp(color, "black") == 0) {
+        init_pair(1, COLOR_BLACK, COLOR_BLACK);
+    } else {
+        init_pair(1, COLOR_GREEN, COLOR_BLACK);
+    }
+}
+
+static void set_bold(int bold) {
+    if (opts.all_bold) {
+        attron(A_BOLD);
+    } else if (opts.bold) {
+        attron(A_BOLD);
+    } else if (opts.no_bold) {
+        attroff(A_BOLD);
+    }
+}
+
+static void set_rainbow(void) {
+    if (opts.rainbow) {
+        init_pair(1, COLOR_RED, COLOR_BLACK);
+        init_pair(2, COLOR_GREEN, COLOR_BLACK);
+        init_pair(3, COLOR_YELLOW, COLOR_BLACK);
+        init_pair(4, COLOR_BLUE, COLOR_BLACK);
+        init_pair(5, COLOR_MAGENTA, COLOR_BLACK);
+        init_pair(6, COLOR_CYAN, COLOR_BLACK);
+        init_pair(7, COLOR_WHITE, COLOR_BLACK);
+    }
+}
+
+static void draw_matrix(void) {
+    int i, j, x, y, col, row;
+    int height, width;
+    char *chars = "01";
+    int char_count = 2;
+    
+    getmaxyx(stdscr, height, width);
+    
+    for (i = 0; i < height; i++) {
+        for (j = 0; j < width; j++) {
+            if (opts.use_japanese) {
+                mvaddch(i, j, '0');
+            } else {
+                mvaddch(i, j, chars[j % char_count]);
+            }
+        }
+    }
+    refresh();
+}
+
+static void draw_message(void) {
+    int height, width;
+    getmaxyx(stdscr, height, width);
+    
+    if (opts.message) {
+        int msg_len = strlen(opts.message);
+        int start = (width - msg_len) / 2;
+        int y = height / 2;
+        
+        for (int i = 0; i < msg_len; i++) {
+            mvaddch(y, start + i, opts.message[i]);
+        }
+        refresh();
+    }
+}
+
+static void handle_key(int key) {
+    if (opts.screensaver) {
+        endwin();
+        exit(0);
+    }
+    
+    switch (key) {
+        case 'a':
+            opts.async = !opts.async;
+            break;
+        case 'b':
+            opts.bold = !opts.bold;
+            break;
+        case 'B':
+            opts.all_bold = 1;
+            break;
+        case 'n':
+            opts.no_bold = 1;
+            break;
+        case 'q':
+            endwin();
+            exit(0);
+        case 27:
+            endwin();
+            exit(0);
+    }
+}
+
+int main(int argc, char **argv) {
+    int i;
+    
+    parse_args(argc, argv);
+    
+    if (opts.x_mode) {
+        fprintf(stderr, "X mode not implemented\n");
+        return 1;
+    }
+    
+    if (opts.linux_mode) {
+        fprintf(stderr, "Linux mode requires matrix.fnt font\n");
+    }
+    
+    setlocale(LC_ALL, "");
+    init_curses();
+    set_color(opts.color ? opts.color : "green");
+    set_bold(opts.bold || opts.all_bold);
+    set_rainbow();
+    
+    if (opts.lock) {
+        wprintw(stdscr, "CMatrix is locked. Press 'q' to quit.\n");
+        refresh();
+    }
+    
+    while (1) {
+        int key = getch();
+        if (key != -1) {
+            handle_key(key);
+        }
+        
+        if (opts.update_delay > 0) {
+            usleep(opts.update_delay * 100000);
+        }
+        
+        draw_matrix();
+        draw_message();
+    }
+    
+    endwin();
+    return 0;
+}
