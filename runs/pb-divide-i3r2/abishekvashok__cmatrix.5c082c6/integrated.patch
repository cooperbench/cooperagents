+
+/* Parse arguments */
+static int parse_args(int argc, char *argv[])
+{
+    int i;
+    
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0 ||
+            strcmp(argv[i], "--help") == 0) {
+            show_help_only = 1;
+        } else if (strcmp(argv[i], "-V") == 0 || strcmp(argv[i], "--version") == 0) {
+            show_version_only = 1;
+        } else if (strcmp(argv[i], "--man") == 0 || strcmp(argv[i], "-man") == 0) {
+            print_man_page();
+            return 0;
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+            bold_chars = 0;
+            all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_window_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            characters_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                update_delay = atoi(argv[++i]);
+                if (update_delay < 0 || update_delay > 10) {
+                    fprintf(stderr, "Error: update delay must be between 0 and 10\n");
+                    return 1;
+                }
+            } else {
+                fprintf(stderr, "Error: -u requires a delay value\n");
+                return 1;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = argv[++i];
+                int valid = 0;
+                for (int j = 0; j < 8; j++) {
+                    if (strcmp(color, valid_colors[j]) == 0) {
+                        valid = 1;
+                        break;
+                    }
+                }
+                if (!valid) {
+                    fprintf(stderr, "Error: invalid color '%s'. Valid colors: ", color);
+                    for (int j = 0; j < 8; j++) {
+                        printf("%s%s", valid_colors[j], (j < 7) ? ", " : "");
+                    }
+                    printf("\n");
+                    return 1;
+                }
+            } else {
+                fprintf(stderr, "Error: -C requires a color value\n");
+                return 1;
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                message = argv[++i];
+                if (strlen(message) > MAX_MESSAGE_LEN) {
+                    fprintf(stderr, "Error: message too long\n");
+                    return 1;
+                }
+            } else {
+                fprintf(stderr, "Error: -M requires a message\n");
+                return 1;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty_name = argv[++i];
+                if (strlen(tty_name) > MAX_TTY_NAME) {
+                    fprintf(stderr, "Error: tty name too long\n");
+                    return 1;
+                }
+            } else {
+                fprintf(stderr, "Error: -t requires a tty name\n");
+                return 1;
+            }
+        } else {
+            fprintf(stderr, "Error: unknown option '%s'\n", argv[i]);
+            return 1;
+        }
+    }
+    
+    return 0;
+}
+
+/* Get random character */
+static int get_random_char(void)
+{
+    if (use_japanese) {
+        return (int)japanese_chars[rand() % (strlen(japanese_chars) - 1)];
+    } else if (lambda_mode) {
+        return (int)lambda_chars[0];
+    } else {
+        return (int)matrix_chars[rand() % (strlen(matrix_chars) - 1)];
+    }
+}
+
+/* Get color index */
+static int get_color_index(void)
+{
+    if (rainbow_mode) {
+        return (int)(time(NULL) / 2) % 8;
+    } else {
+        return last_color;
+    }
+}
+
+/* Get bold state */
+static int get_bold_state(void)
+{
+    if (all_bold) {
+        return 1;
+    } else if (no_bold) {
+        return 0;
+    } else if (bold_chars) {
+        return (rand() % 100) < 50;
+    } else {
+        return 0;
+    }
+}
+
+/* Get shadow color index */
+static int get_shadow_color_index(void)
+{
+    if (rainbow_mode) {
+        return (int)(time(NULL) / 2 + 4) % 8;
+    } else {
+        return (last_color + 1) % 8;
+    }
+}
+
+/* Get shadow bold state */
+static int get_shadow_bold_state(void)
+{
+    if (all_bold) {
+        return 1;
+    } else if (no_bold) {
+        return 0;
+    } else if (bold_chars) {
+        return (rand() % 100) < 50;
+    } else {
+        return 0;
+    }
+}
+
+/* Print a character with color and bold */
+static void print_char(int x, int y, int c, int color, int bold)
+{
+    if (x < 0 || x >= width || y < 0 || y >= height) {
+        return;
+    }
+    
+    if (bold) {
+        printf("\033[%d;%dH\033[1m%c\033[0m", x + 1, y + 1, c);
+    } else {
+        printf("\033[%d;%dH%c", x + 1, y + 1, c);
+    }
+}
+
+/* Print a character with shadow */
+static void print_char_with_shadow(int x, int y, int c, int color, int bold)
+{
+    if (x < 0 || x >= width || y < 0 || y >= height) {
+        return;
+    }
+    
+    int shadow_color = get_shadow_color_index();
+    int shadow_bold = get_shadow_bold_state();
+    
+    if (shadow_bold) {
+        printf("\033[%d;%dH\033[1m%c\033[0m", x + 1, y + 1, c);
+    } else {
+        printf("\033[%d;%dH%c", x + 1, y + 1, c);
+    }
+}
+
+/* Initialize matrix */
+static void init_matrix(void)
+{
+    width = 80;
+    height = 24;
+    
+    matrix = (int *)malloc(width * height * sizeof(int));
+    matrix_old = (int *)malloc(width * height * sizeof(int));
+    matrix_new = (int *)malloc(width * height * sizeof(int));
+    matrix_color = (int *)malloc(width * height * sizeof(int));
+    matrix_bold = (int *)malloc(width * height * sizeof(int));
+    matrix_shadow = (int *)malloc(width * height * sizeof(int));
+    matrix_shadow_color = (int *)malloc(width * height * sizeof(int));
+    matrix_shadow_bold = (int *)malloc(width * height * sizeof(int));
+    matrix_shadow_old = (int *)malloc(width * height * sizeof(int));
+    matrix_shadow_new = (int *)malloc(width * height * sizeof(int));
+    
+    if (!matrix || !matrix_old || !matrix_new || !matrix_color ||
+        !matrix_bold || !matrix_shadow || !matrix_shadow_color ||
+        !matrix_shadow_bold || !matrix_shadow_old || !matrix_shadow_new) {
+        fprintf(stderr, "Error: memory allocation failed\n");
+        exit(1);
+    }
+    
+    for (int i = 0; i < width * height; i++) {
+        matrix[i] = 0;
+        matrix_old[i] = 0;
+        matrix_new[i] = 0;
+        matrix_color[i] = 0;
+        matrix_bold[i] = 0;
+        matrix_shadow[i] = 0;
+        matrix_shadow_color[i] = 0;
+        matrix_shadow_bold[i] = 0;
+        matrix_shadow_old[i] = 0;
+        matrix_shadow_new[i] = 0;
+    }
+}
+
+/* Clear matrix */
+static void clear_matrix(void)
+{
+    for (int i = 0; i < width * height; i++) {
+        matrix[i] = 0;
+        matrix_old[i] = 0;
+        matrix_new[i] = 0;
+        matrix_color[i] = 0;
+        matrix_bold[i] = 0;
+        matrix_shadow[i] = 0;
+        matrix_shadow_color[i] = 0;
+        matrix_shadow_bold[i] = 0;
+        matrix_shadow_old[i] = 0;
+        matrix_shadow_new[i] = 0;
+    }
+}
+
+/* Set matrix cell */
+static void set_matrix_cell(int x, int y, int c, int color, int bold)
+{
+    if (x < 0 || x >= width || y < 0 || y >= height) {
+        return;
+    }
+    
+    int idx = y * width + x;
+    matrix[idx] = c;
+    matrix_color[idx] = color;
+    matrix_bold[idx] = bold;
+}
+
+/* Set shadow matrix cell */
+static void set_shadow_matrix_cell(int x, int y, int c, int color, int bold)
+{
+    if (x < 0 || x >= width || y < 0 || y >= height) {
+        return;
+    }
+    
+    int idx = y * width + x;
+    matrix_shadow[idx] = c;
+    matrix_shadow_color[idx] = color;
+    matrix_shadow_bold[idx] = bold;
+}
+
+/* Update matrix */
+static void update_matrix(void)
+{
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            int idx = y * width + x;
+            int old_idx = (y - 1) * width + x;
+            
+            if (y == 0) {
+                matrix[idx] = get_random_char();
+                matrix_color[idx] = get_color_index();
+                matrix_bold[idx] = get_bold_state();
+            } else {
+                matrix[idx] = matrix_old[idx];
+                matrix_color[idx] = matrix_color[old_idx];
+                matrix_bold[idx] = matrix_bold[old_idx];
+            }
+        }
+    }
+}
+
+/* Update shadow matrix */
+static void update_shadow_matrix(void)
+{
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            int idx = y * width + x;
+            int old_idx = (y - 1) * width + x;
+            
+            if (y == 0) {
+                matrix_shadow[idx] = get_random_char();
+                matrix_shadow_color[idx] = get_shadow_color_index();
+                matrix_shadow_bold[idx] = get_shadow_bold_state();
+            } else {
+                matrix_shadow[idx] = matrix_shadow_old[idx];
+                matrix_shadow_color[idx] = matrix_shadow_color[old_idx];
+                matrix_shadow_bold[idx] = matrix_shadow_bold[old_idx];
+            }
+        }
+    }
+}
+
+/* Draw matrix */
+static void draw_matrix(void)
+{
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            int idx = y * width + x;
+            
+            if (matrix[idx] != 0) {
+                print_char(x, y, matrix[idx], matrix_color[idx], matrix_bold[idx]);
+            }
+            
+            if (matrix_shadow[idx] != 0) {
+                print_char_with_shadow(x, y, matrix_shadow[idx], matrix_shadow_color[idx], matrix_shadow_bold[idx]);
+            }
+        }
+    }
+}
+
+/* Draw message */
+static void draw_message(void)
+{
+    if (message == NULL) {
+        return;
+    }
+    
+    message_x = (width - strlen(message)) / 2;
+    message_y = height / 2;
+    
+    if (message_x < 0) {
+        message_x = 0;
+    }
+    
+    for (int i = 0; i < strlen(message); i++) {
+        print_char(message_x + i, message_y, message[i], 0, 0);
+    }
+}
+
+/* Get terminal size */
+static void get_terminal_size(int *rows, int *cols)
+{
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        *rows = ws.ws_row;
+        *cols = ws.ws_col;
+    } else {
+        *rows = 24;
+        *cols = 80;
+    }
+}
+
+/* Set terminal settings */
+static void set_terminal_settings(void)
+{
+    struct termios raw;
+    
+    tcgetattr(STDOUT_FILENO, &orig_termios);
+    raw = orig_termios;
+    
+    raw.c_lflag &= ~(ECHO | ICANON);
+    raw.c_iflag &= ~(IXON);
+    raw.c_oflag &= 0;
+    raw.c_cflag |= (CS8);
+    
+    raw.c_cc[VMIN] = 0;
+    raw.c_cc[VTIME] = 0;
+    
+    tcsetattr(STDOUT_FILENO, TCSANOW, &raw);
+}
+
+/* Reset terminal settings */
+static void reset_terminal_settings(void)
+{
+    tcsetattr(STDOUT_FILENO, TCSANOW, &orig_termios);
+}
+
+/* Handle keyboard input */
+static int handle_keyboard_input(void)
+{
+    char buf[MAX_MESSAGE_LEN];
+    int n;
+    
+    n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+    if (n > 0) {
+        buf[n] = '\0';
+        
+        for (int i = 0; buf[i] != '\0'; i++) {
+            char c = buf[i];
+            
+            if (c == 'q') {
+                return 1;
+            } else if (c == 'a') {
+                async_scroll = !async_scroll;
+            } else if (c == 'b') {
+                bold_chars = !bold_chars;
+            } else if (c == 'B') {
+                all_bold = 1;
+                bold_chars = 1;
+            } else if (c == 'n') {
+                no_bold = 1;
+                bold_chars = 0;
+                all_bold = 0;
+            } else if (c >= '0' && c <= '9') {
+                update_delay = c - '0';
+            } else if (c == '!') {
+                last_color = 0;
+            } else if (c == '@') {
+                last_color = 1;
+            } else if (c == '#') {
+                last_color = 2;
+            } else if (c == '$') {
+                last_color = 3;
+            } else if (c == '%') {
+                last_color = 4;
+            } else if (c == '^') {
+                last_color = 5;
+            } else if (c == '&') {
+                last_color = 6;
+            } else if (c == ')') {
+                last_color = 7;
+            }
+        }
+    }
+    
+    return 0;
+}
+
+/* Main function */
+int main(int argc, char *argv[])
+{
+    int ret = 0;
+    
+    /* Parse arguments */
+    ret = parse_args(argc, argv);
+    if (ret != 0) {
+        return ret;
+    }
+    
+    /* Exit immediately if help or version was requested */
+    if (show_help_only) {
+        print_help();
+        return 0;
+    }
+    
+    if (show_version_only) {
+        print_version();
+        return 0;
+    }
+    
+    /* Set up signal handlers */
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+    
+    /* Check for X window mode */
+    if (x_window_mode) {
+        fprintf(stderr, "X window mode not supported in this build\n");
+        return 1;
+    }
+    
+    /* Check for lock mode */
+    if (lock_mode) {
+        if (message == NULL) {
+            message = "Lock mode - press any key to exit";
+        }
+    }
+    
+    /* Set terminal settings */
+    set_terminal_settings();
+    
+    /* Get terminal size */
+    get_terminal_size(&height, &width);
+    
+    /* Initialize matrix */
+    init_matrix();
+    
+    /* Main loop */
+    while (running) {
+        /* Update matrix */
+        update_matrix();
+        update_shadow_matrix();
+        
+        /* Draw matrix */
+        draw_matrix();
+        
+        /* Draw message */
+        draw_message();
+        
+        /* Handle keyboard input */
+        if (handle_keyboard_input()) {
+            break;
+        }
+        
+        /* Sleep for update delay */
+        usleep(update_delay * 100000);
+    }
+    
+    /* Clear screen */
+    printf("\033[2J\033[H");
+    
+    /* Reset terminal settings */
+    reset_terminal_settings();
+    
+    /* Free memory */
+    free(matrix);
+    free(matrix_old);
+    free(matrix_new);
+    free(matrix_color);
+    free(matrix_bold);
+    free(matrix_shadow);
+    free(matrix_shadow_color);
+    free(matrix_shadow_bold);
+    free(matrix_shadow_old);
+    free(matrix_shadow_new);
+    
+    return 0;
+}
