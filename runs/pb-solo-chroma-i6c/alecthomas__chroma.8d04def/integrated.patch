+const Version = "0.10.0"
+
+type Token struct {
+	Type string
+	Value string
+}
+
+type Lexer interface {
+	Tokenize(reader io.Reader) ([]Token, error)
+}
+
+type Style struct {
+	Name string
+	Colors map[string]string
+}
+
+type Formatter interface {
+	Format(tokens []Token, style *Style, options map[string]string) (string, error)
+}
+
+type TerminalFormatter struct{}
+
+func (f *TerminalFormatter) Format(tokens []Token, style *Style, options map[string]string) (string, error) {
+	var sb strings.Builder
+	for _, token := range tokens {
+		color := style.Colors[token.Type]
+		if color == "" {
+			color = "37"
+		}
+		sb.WriteString(fmt.Sprintf("\033[%sm%s\033[0m", color, token.Value))
+	}
+	return sb.String(), nil
+}
