diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..f36bb47
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,315 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <ctype.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_COLS 256
+#define MAX_ROWS 256
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_scroll = 0;
+static int lock_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int chars_change = 0;
+static int screensaver_mode = 0;
+static int x_window_mode = 0;
+static int use_japanese = 0;
+static int tty_set = 0;
+static char tty_name[64] = "";
+static int update_delay = DEFAULT_DELAY;
+static char color_name[32] = "green";
+static char message[256] = "";
+static int message_set = 0;
+
+static char *colors[] = {
+    "green", "red", "blue", "white", "yellow", "cyan", "magenta", "black"
+};
+
+static int color_index = 1;
+
+static char *term_type = NULL;
+static struct termios orig_termios;
+static int terminal_width = 80;
+static int terminal_height = 24;
+
+static void set_termios(void) {
+    tcgetattr(STDIN_FILENO, &orig_termios);
+    struct termios new_termios = orig_termios;
+    new_termios.c_lflag &= ~(ECHO | ICANON);
+    new_termios.c_cc[VMIN] = 0;
+    new_termios.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &new_termios);
+}
+
+static void reset_termios(void) {
+    tcsetattr(STDIN_FILENO, TCSANOW, &orig_termios);
+}
+
+static void resize_term(void) {
+    struct winsize ws;
+    if (ioctl(STDIN_FILENO, TIOCGWINSZ, &ws) == 0) {
+        terminal_width = ws.ws_col;
+        terminal_height = ws.ws_row;
+    }
+}
+
+static void print_matrix_line(int row, int col, char c, int color, int bold) {
+    if (color >= 0 && color < 8) {
+        printf("\033[%d;%dH\033[3%dm", row + 1, col + 1, color + 1);
+    }
+    if (bold) {
+        printf("\033[1m");
+    }
+    printf("%c", c);
+    if (bold) {
+        printf("\033[0m");
+    }
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void set_cursor(int row, int col) {
+    printf("\033[%d;%dH", row, col);
+}
+
+static void print_centered_message(const char *msg) {
+    int width = strlen(msg);
+    int padding = (terminal_width - width) / 2;
+    for (int i = 0; i < padding; i++) {
+        printf("\033[2K");
+    }
+    printf("\033[%dH\033[37m%s\033[0m", terminal_height / 2, msg);
+}
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void parse_args(int argc, char *argv[]) {
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+            bold_chars = 0;
+            all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_window_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            chars_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            update_delay = atoi(argv[++i]);
+            if (update_delay < 0) update_delay = 0;
+            if (update_delay > 10) update_delay = 10;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            strncpy(color_name, argv[++i], sizeof(color_name) - 1);
+            color_index = 1;
+            for (int j = 0; j < 8; j++) {
+                if (strcmp(colors[j], color_name) == 0) {
+                    color_index = j;
+                    break;
+                }
+            }
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            strncpy(message, argv[++i], sizeof(message) - 1);
+            message_set = 1;
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            strncpy(tty_name, argv[++i], sizeof(tty_name) - 1);
+            tty_set = 1;
+        } else {
+            print_usage();
+            exit(1);
+        }
+    }
+}
+
+static char *get_random_char(void) {
+    static char chars[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?";
+    static char japanese[] = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+    
+    if (use_japanese) {
+        return japanese;
+    }
+    return chars;
+}
+
+static int get_color_index(void) {
+    if (rainbow_mode) {
+        static int hue = 0;
+        hue = (hue + 1) % 360;
+        int r = (hue / 60) % 6;
+        int g = (hue / 60 + 2) % 6;
+        int b = (hue / 60 + 4) % 6;
+        return r + g * 2 + b * 4;
+    }
+    return color_index;
+}
+
+static char *char_set = NULL;
+
+static void init_char_set(void) {
+    if (char_set == NULL) {
+        char_set = get_random_char();
+    }
+}
+
+static void init_matrix(void) {
+    for (int row = 0; row < terminal_height; row++) {
+        for (int col = 0; col < terminal_width; col++) {
+            init_char_set();
+            char *cs = get_random_char();
+            int len = strlen(cs);
+        }
+    }
+}
+
+static void run(void) {
+    set_termios();
+    resize_term();
+    
+    if (linux_mode) {
+        printf("\033]1000;matrix.fnt\007");
+    }
+    
+    if (lock_mode) {
+        printf("\033[?1049h");
+    }
+    
+    clear_screen();
+    
+    if (message_set) {
+        print_centered_message(message);
+    }
+    
+    init_char_set();
+    
+    int rows = terminal_height;
+    int cols = terminal_width;
+    
+    while (1) {
+        if (screensaver_mode) {
+            char c;
+            if (read(STDIN_FILENO, &c, 1) > 0) {
+                break;
+            }
+        }
+        
+        for (int row = rows - 1; row >= 0; row--) {
+            for (int col = 0; col < cols; col++) {
+                int color = get_color_index();
+                int bold = 0;
+                
+                if (all_bold) {
+                    bold = 1;
+                } else if (bold_chars && rand() % 100 < 10) {
+                    bold = 1;
+                }
+                
+                print_matrix_line(row, col, get_random_char()[rand() % strlen(get_random_char())], color, bold);
+            }
+            printf("\n");
+        }
+        
+        if (message_set) {
+            print_centered_message(message);
+        }
+        
+        usleep(update_delay * 100000);
+    }
+    
+    if (lock_mode) {
+        printf("\033[?1049l");
+    }
+    
+    reset_termios();
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    if (x_window_mode) {
+        printf("X window mode not fully implemented\n");
+        return 0;
+    }
+    
+    if (tty_set) {
+        printf("Tty set to: %s\n", tty_name);
+    }
+    
+    if (force_term) {
+        term_type = "linux";
+    }
+    
+    run();
+    
+    return 0;
+}
