index 0000000..c8fb384
--- /dev/null
+++ b/src/main.rs
@@ -0,0 +1,418 @@
+use clap::{Arg, Command};
+use std::time::Instant;
+
+// ===== SHA1 =====
+fn sha1(data: &[u8]) -> [u8; 20] {
+    let mut state = [0x67452301u32, 0xEF417A2Du32, 0x95123E47u32, 0xBF597C9Fu32, 0xF6E2B90Fu32];
+    let mut padded = data.to_vec();
+    padded.push(0x80);
+    while padded.len() % 64 != 56 {
+        padded.push(0);
+    }
+    let len_bits = (data.len() as u64) * 8;
+    padded.extend_from_slice(&len_bits.to_be_bytes());
+    for block in padded.chunks(64) {
+        let mut w = [0u32; 80];
+        for i in 0..16 {
+            w[i] = u32::from_be_bytes([block[i*4], block[i*4+1], block[i*4+2], block[i*4+3]]);
+        }
+        for i in 16..80 {
+            let x = w[i-3] ^ w[i-8] ^ w[i-14] ^ w[i-16];
+            w[i] = (x << 1) | (x >> 31);
+        }
+        let (mut a, mut b, mut c, mut d, mut e) =
+            (state[0], state[1], state[2], state[3], state[4]);
+        for i in 0..80 {
+            let f = if i < 20 {
+                (b & c) | ((!b) & d)
+            } else if i < 40 {
+                b ^ c ^ d
+            } else if i < 60 {
+                (b & c) | (b & d) | (c & d)
+            } else {
+                b ^ c ^ d
+            };
+            let k = if i < 20 { 0x5A827999u32 }
+                    else if i < 40 { 0x6ED9EBA1u32 }
+                    else if i < 60 { 0x8FBC445Au32 }
+                    else { 0xCA62C1E6u32 };
+            let t = ((a << 5) | (a >> 27)) + f + e + w[i] + k;
+            e = d; d = c; c = (b << 30) | (b >> 4); b = a; a = t;
+        }
+        state[0] = state[0] + a;
+        state[1] = state[1] + b;
+        state[2] = state[2] + c;
+        state[3] = state[3] + d;
+        state[4] = state[4] + e;
+    }
+    let mut out = [0u8; 20];
+    for i in 0..5 {
+        out[i*4..i*4+4].copy_from_slice(&state[i].to_be_bytes());
+    }
+    out
+}
+
+// ===== HMAC-SHA1 =====
+fn hmac_sha1(key: &[u8], data: &[u8]) -> [u8; 20] {
+    let k = if key.len() > 64 { sha1(key).to_vec() } else { key.to_vec() };
+    let mut pad = k;
+    while pad.len() < 64 {
+        pad.push(0);
+    }
+    let mut ipad = Vec::new();
+    let mut opad = Vec::new();
+    for &x in &pad {
+        ipad.push(x ^ 0x36);
+        opad.push(x ^ 0x5C);
+    }
+    let mut inner = ipad;
+    inner.extend_from_slice(data);
+    let inner_hash = sha1(&inner);
+    let mut outer = opad;
+    outer.extend_from_slice(&inner_hash);
+    sha1(&outer)
+}
+
+// ===== PBKDF2-HMAC-SHA1 =====
+fn pbkdf2_hmac_sha1(password: &[u8], salt: &[u8], iterations: u32, key_len: usize) -> Vec<u8> {
+    let mut key = Vec::new();
+    for i in 1.. {
+        let block_bytes = (i as u32).to_be_bytes();
+        let mut u_input = salt.to_vec();
+        u_input.extend_from_slice(&block_bytes);
+        let mut u = hmac_sha1(password, &u_input);
+        let mut t = u;
+        for _ in 1..iterations {
+            u = hmac_sha1(password, &u);
+            for j in 0..20 {
+                t[j] ^= u[j];
+            }
+        }
+        key.extend_from_slice(&t);
+        if key.len() >= key_len {
+            break;
+        }
+    }
+    key.truncate(key_len);
+    key
+}
+
+// ===== CRC32 (for ZipCrypto) =====
+fn crc32_table() -> [u32; 256] {
+    let mut t = [0u32; 256];
+    for i in 0..256 {
+        let mut c = i as u32;
+        for _ in 0..8 {
+            c = if c & 1 != 0 { 0xEDB88320 ^ (c >> 1) } else { c >> 1 };
+        }
+        t[i] = c;
+    }
+    t
+}
+
+fn crc32_update(c: u32, b: u8) -> u32 {
+    static mut T: Option<[u32; 256]> = None;
+    unsafe {
+        if T.is_none() {
+            T = Some(crc32_table());
+        }
+        let t = T.unwrap();
+        t[((c ^ b as u32) & 0xFF) as usize] ^ (c >> 8)
+    }
+}
+
+// ===== ZipCrypto =====
+struct ZipCrypto {
+    k0: u32,
+    k1: u32,
+    k2: u32,
+}
+
+impl ZipCrypto {
+    fn new(password: &[u8]) -> Self {
+        let mut k0 = 0x12345678u32;
+        let mut k1 = 0x23456789u32;
+        let mut k2 = 0x34567890u32;
+        for &b in password {
+            k0 = crc32_update(k0, b);
+            k1 = (k1 + (k0 & 0xFF)) & 0xFFFFFFFF;
+            k1 = (k1.wrapping_mul(134775813) + 1) & 0xFFFFFFFF;
+            k2 = crc32_update(k2, (k1 >> 24) as u8);
+        }
+        ZipCrypto { k0, k1, k2 }
+    }
+
+    fn decrypt_byte(&mut self, c: u8) -> u8 {
+        let k = self.k2 | 2;
+        let keystream = (((k * (k ^ 1)) >> 8) & 0xFF) as u8;
+        let p = c ^ keystream;
+        self.k0 = crc32_update(self.k0, p);
+        self.k1 = (self.k1 + (self.k0 & 0xFF)) & 0xFFFFFFFF;
+        self.k1 = (self.k1.wrapping_mul(134775813) + 1) & 0xFFFFFFFF;
+        self.k2 = crc32_update(self.k2, (self.k1 >> 24) as u8);
+        p
+    }
+}
+
+// ===== ZIP parsing =====
+struct ZipEntry {
+    name: String,
+    gpf: u16,
+    method: u16,
+    local_offset: usize,
+    csize: usize,
+    crc: u32,
+    encrypted: bool,
+}
+
+fn parse_zip(data: &[u8]) -> Result<Vec<ZipEntry>, String> {
+    let mut eocd_pos = None;
+    for i in (0..data.len()).rev() {
+        if i + 22 <= data.len() && data[i..i+4] == *b"PK\x05\x06" {
+            eocd_pos = Some(i);
+            break;
+        }
+    }
+    let eocd_pos = eocd_pos.ok_or("invalid Zip archive: Could not find EOCD")?;
+    let num_entries = u16::from_le_bytes([data[eocd_pos+10], data[eocd_pos+11]]) as usize;
+    let central_dir_start = u32::from_le_bytes([data[eocd_pos+16], data[eocd_pos+17], data[eocd_pos+18], data[eocd_pos+19]]) as usize;
+
+    let mut entries = Vec::new();
+    let mut pos = central_dir_start;
+    for _ in 0..num_entries {
+        if pos + 46 > data.len() || data[pos..pos+4] != *b"PK\x01\x02" {
+            break;
+        }
+        let nlen = u16::from_le_bytes([data[pos+28], data[pos+29]]) as usize;
+        let nextra = u16::from_le_bytes([data[pos+30], data[pos+31]]) as usize;
+        let ncomment = u16::from_le_bytes([data[pos+32], data[pos+33]]) as usize;
+        let crc = u32::from_le_bytes([data[pos+16], data[pos+17], data[pos+18], data[pos+19]]);
+        let name_start = pos + 46;
+        let name = String::from_utf8_lossy(&data[name_start..name_start+nlen]).to_string();
+        // Read the LOCAL header to get gpf/method (encryption + AES live there).
+        let local_offset = u32::from_le_bytes([data[pos+42], data[pos+43], data[pos+44], data[pos+45]]) as usize;
+        let (gpf, method) = if local_offset + 30 < data.len() && data[local_offset..local_offset+4] == *b"PK\x03\x04" {
+            (u16::from_le_bytes([data[local_offset+6], data[local_offset+7]]),
+             u16::from_le_bytes([data[local_offset+8], data[local_offset+9]]))
+        } else {
+            (0, 0)
+        };
+        let encrypted = gpf & 0x01 != 0;
+        // Read csize from local header
+        let csize = if local_offset + 46 < data.len() && data[local_offset..local_offset+4] == *b"PK\x03\x04" {
+            u32::from_le_bytes([data[local_offset+18], data[local_offset+19], data[local_offset+20], data[local_offset+21]]) as usize
+        } else {
+            0
+        };
+        entries.push(ZipEntry {
+            name,
+            gpf,
+            method,
+            local_offset,
+            csize,
+            crc,
+            encrypted,
+        });
+        pos += 46 + nlen + nextra + ncomment;
+    }
+    Ok(entries)
+}
+
+// ===== Main =====
+fn build_cli() -> Command {
+    Command::new("zip-password-finder")
+        .version("0.10.3")
+        .about("Find the password of protected ZIP files")
+        .arg(Arg::new("inputFile").short('i').long("inputFile").value_name("inputFile").required(true).help("path to zip input file"))
+        .arg(Arg::new("workers").short('w').long("workers").value_name("workers").value_parser(clap::value_parser!(usize)).help("number of workers"))
+        .arg(Arg::new("passwordDictionary").short('p').long("passwordDictionary").value_name("passwordDictionary").help("path to a password dictionary file"))
+        .arg(Arg::new("charset").short('c').long("charset").value_name("charset").default_value("lud").help("charset to use to generate password"))
+        .arg(Arg::new("charsetFile").long("charsetFile").value_name("charsetFile").help("path to a charset file"))
+        .arg(Arg::new("minPasswordLen").long("minPasswordLen").value_name("minPasswordLen").default_value("1").value_parser(clap::value_parser!(usize)).help("minimum password length"))
+        .arg(Arg::new("maxPasswordLen").long("maxPasswordLen").value_name("maxPasswordLen").default_value("10").value_parser(clap::value_parser!(usize)).help("maximum password length"))
+        .arg(Arg::new("fileNumber").long("fileNumber").value_name("fileNumber").default_value("0").value_parser(clap::value_parser!(usize)).help("file number in the zip archive"))
+        .arg(Arg::new("startingPassword").short('s').long("startingPassword").value_name("startingPassword").help("password to start from"))
+}
+
+
+fn generate_charset(charset: &str) -> Vec<u8> {
+    let mut chars = Vec::new();
+    for c in charset.chars() {
+        match c {
+            'l' => chars.extend(b"abcdefghijklmnopqrstuvwxyz"),
+            'u' => chars.extend(b"ABCDEFGHIJKLMNOPQRSTUVWXYZ"),
+            'd' => chars.extend(b"0123456789"),
+            'h' => chars.extend(b"0123456789abcdef"),
+            'H' => chars.extend(b"0123456789ABCDEF"),
+            's' => {
+                // Space and symbols
+                chars.push(b' ');
+                chars.extend(b"!@#$%^&*()_+-=[]{}|;':\",./<>?");
+            }
+            _ => {}
+        }
+    }
+    chars
+}
+
+fn generate_passwords(chars: &[u8], len: usize) -> Vec<Vec<u8>> {
+    let mut passwords = Vec::new();
+    let n = chars.len();
+    let mut current = vec![0u8; len];
+    
+    // Generate all combinations
+    let mut i = 0;
+    while i < len {
+        current[i] = 0;
+        i += 1;
+    }
+    
+    loop {
+        passwords.push(current.clone());
+        i = 0;
+        while i < len {
+            if current[i] + 1 < n as u8 {
+                current[i] += 1;
+                break;
+            } else {
+                current[i] = 0;
+                i += 1;
+            }
+        }
+        if i >= len {
+            break;
+        }
+    }
+    
+    passwords
+}
+
+fn check_zipcrypto_password(data: &[u8], entry: &ZipEntry, password: &[u8]) -> bool {
+    // Decrypt the encrypted data and check the password check byte
+    let mut zip_crypto = ZipCrypto::new(password);
+
+    // Read the encrypted data
+    let local_offset = entry.local_offset;
+    if local_offset + 30 > data.len() {
+        return false;
+    }
+
+    // Skip the local header: file name length at +26, extra field length at +28
+    let local_name_len = u16::from_le_bytes([data[local_offset+26], data[local_offset+27]]) as usize;
+    let local_extra_len = u16::from_le_bytes([data[local_offset+28], data[local_offset+29]]) as usize;
+    let data_start = local_offset + 30 + local_extra_len + local_name_len;
+
+    // Decrypt the first 12 bytes of the encrypted data
+    let mut decrypted = [0u8; 12];
+    for i in 0..12 {
+        if data_start + i >= data.len() {
+            return false;
+        }
+        decrypted[i] = zip_crypto.decrypt_byte(data[data_start + i]);
+    }
+
+    // The 12th decrypted byte is the password check byte; it must equal the
+    // high byte of the file's CRC.
+    let expected = ((entry.crc >> 24) & 0xFF) as u8;
+    decrypted[11] == expected
+}
+
+fn check_aes_password(data: &[u8], entry: &ZipEntry, password: &[u8]) -> bool {
+    // AES check - use PBKDF2 and check the encrypted data
