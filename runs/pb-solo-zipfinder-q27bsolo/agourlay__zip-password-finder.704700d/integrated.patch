+}
+fn main() {
+    use std::fs;
+    use std::io::Read;
+    
+    let matches = build_cli().get_matches();
+    
+    let input_file = matches.get_one::<String>("inputFile").unwrap().clone();
+    let workers = matches.get_one::<usize>("workers").map(|x| x.clone()).unwrap_or(1);
+    let password_dict = matches.get_one::<String>("passwordDictionary").map(|x| x.clone());
+    let charset = matches.get_one::<String>("charset").map(|x| x.clone()).unwrap_or("lud".to_string());
+    let charset_file = matches.get_one::<String>("charsetFile").map(|x| x.clone());
+    let min_len = matches.get_one::<usize>("minPasswordLen").map(|x| x.clone()).unwrap_or(1);
+    let max_len = matches.get_one::<usize>("maxPasswordLen").map(|x| x.clone()).unwrap_or(10);
+    let file_num = matches.get_one::<usize>("fileNumber").map(|x| x.clone()).unwrap_or(0);
+    let starting_password = matches.get_one::<String>("startingPassword").map(|x| x.clone());
+    
+    // Read the zip file
+    let data = fs::read(&input_file).unwrap();
+    
+    // Parse the zip file
+    let entries = parse_zip(&data).unwrap();
+    
+    // Get the target entry
+    let entry = &entries[file_num];
+    // Check if the entry is encrypted
+    if !entry.encrypted {
+        return;
+    }
+    
+    // Check if it's AES or ZipCrypto
+    let is_aes = entry.method == 99; // AES encryption method
+    
+    // Try passwords
+    if let Some(dict_path) = &password_dict {
+        // Dictionary attack
+        let dict = fs::read_to_string(dict_path).unwrap();
+        for line in dict.lines() {
+            let password = line.as_bytes();
+            let found = if is_aes {
+                // AES check
+                check_aes_password(&data, entry, password)
+            } else {
+                // ZipCrypto check
+                check_zipcrypto_password(&data, entry, password)
+            };
+            if found {
+                println!("{}", String::from_utf8_lossy(password));
+                return;
+            }
+        }
+    } else {
+        // Brute-force attack
+        // Generate passwords from charset
+        let chars: Vec<u8> = if let Some(charset_file_path) = &charset_file {
+            fs::read(charset_file_path).unwrap()
+        } else {
+            generate_charset(&charset)
+        };
+        
+        // Generate and try passwords
+        for len in min_len..=max_len {
+            if let Some(starting) = &starting_password {
+                // Start from the starting password
+                let start = starting.as_bytes();
+                if start.len() == len {
+                    // Try the starting password
+                    let found = if is_aes {
+                        check_aes_password(&data, entry, start)
+                    } else {
+                        check_zipcrypto_password(&data, entry, start)
+                    };
+                    if found {
+                        println!("{}", starting);
+                        return;
+                    }
+                }
+            }
+            
+            // Generate all passwords of this length
+            let mut passwords = generate_passwords(&chars, len);
+            for password in passwords {
+                let found = if is_aes {
+                    check_aes_password(&data, entry, &password)
+                } else {
+                    check_zipcrypto_password(&data, entry, &password)
+                };
+                if found {
+                    println!("{}", String::from_utf8_lossy(&password));
+                    return;
+                }
+            }
+        }
+    }
+}
