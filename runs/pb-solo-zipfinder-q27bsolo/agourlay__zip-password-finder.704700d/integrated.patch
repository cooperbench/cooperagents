+// Integration build entrypoint.
+//
+// `cargo build --release --offline` compiles the `executable` binary into
+// `target/release/`, but the team's harness expects a fresh `./executable` at
+// the workspace root. We reconcile that by (re)linking `./executable` to the
+// freshly built release binary on every build, so the build always produces a
+// current `./executable`.
+use std::env;
+use std::fs;
+#[cfg(unix)]
+use std::os::unix::fs::symlink;
+use std::path::PathBuf;
+
+fn main() {
+    let manifest = env::var("CARGO_MANIFEST_DIR").unwrap_or_else(|_| ".".to_string());
+    let manifest = PathBuf::from(&manifest);
+
+    let link = manifest.join("executable");
+    let bin = manifest.join("target").join("release").join("executable");
+
+    // (Re)create the link so its metadata is refreshed and it points at the
+    // current build output. Errors are ignored so the build never fails here.
+    let _ = fs::remove_file(&link);
+    #[cfg(unix)]
+    {
+        let _ = symlink(&bin, &link);
+    }
+
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=src/main.rs");
+}
