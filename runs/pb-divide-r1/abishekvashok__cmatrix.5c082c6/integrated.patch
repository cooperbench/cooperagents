diff --git a/main.c b/main.c
new file mode 100644
index 0000000..47c8494
--- /dev/null
+++ b/main.c
@@ -0,0 +1,64 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+#include <math.h>
+
+#include "options.h"
+#include "render.h"
+#include "help.h"
+#include "errors.h"
+
+#define VERSION "2.0"
+#define COMPILE_TIME __DATE__ " " __TIME__
+
+int main(int argc, char *argv[]) {
+    // Parse command-line options
+    struct options opts;
+    if (parse_options(argc, argv, &opts) != 0) {
+        return 1;  // Error in option parsing
+    }
+
+    // Print version if requested
+    if (opts.show_version) {
+        printf("CMatrix version %s (compiled %s)\n", VERSION, COMPILE_TIME);
+        printf("Email: abishekvashok@gmail.com\n");
+        printf("Web: https://github.com/abishekvashok/cmatrix\n");
+        return 0;
+    }
+
+    // Print help if requested
+    if (opts.show_help) {
+        print_help();
+        return 0;
+    }
+
+    // Initialize terminal settings
+    if (!opts.force_term) {
+        if (init_terminal(&opts) != 0) {
+            return 1;
+        }
+    }
+
+    // Initialize random number generator
+    srand(time(NULL));
+
+    // Initialize render state
+    struct render_state state;
+    if (init_render(&state, &opts) != 0) {
+        return 1;
+    }
+
+    // Main render loop
+    render_loop(&state, &opts);
+
+    // Cleanup
+    cleanup_terminal();
+
+    return 0;
+}
diff --git a/options.c b/options.c
new file mode 100644
index 0000000..c94e581
--- /dev/null
+++ b/options.c
@@ -0,0 +1,142 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+#include <math.h>
+
+#include "options.h"
+#include "render.h"
+#include "help.h"
+#include "errors.h"
+
+#define VERSION "2.0"
+#define COMPILE_TIME __DATE__ " " __TIME__
+
+static const char *usage = " Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n -a: Asynchronous scroll\n -b: Bold characters on\n -B: All bold characters (overrides -b)\n -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n -f: Force the linux $TERM type to be on\n -l: Linux mode (uses matrix console font)\n -L: Lock mode (can be closed from another terminal)\n -o: Use old-style scrolling\n -h: Print usage and exit\n -n: No bold characters (overrides -b and -B, default)\n -s: \"Screensaver\" mode, exits on first keystroke\n -x: X window mode, use if your xterm is using mtx.pcf\n -V: Print version information and exit\n -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n -u delay (0 - 10, default 4): Screen update delay\n -C [color]: Use this color for matrix (default green)\n -r: rainbow mode\n -m: lambda mode\n -k: Characters change while scrolling. (Works without -o opt.)\n -t [tty]: Set tty to use\n";
+
+static const char *valid_colors[] = {"green", "red", "blue", "white", "yellow", "cyan", "magenta", "black"};
+
+int parse_options(int argc, char *argv[], struct options *opts) {
+    memset(opts, 0, sizeof(struct options));
+    
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0 || strcmp(argv[i], "--help") == 0) {
+            opts->show_help = 1;
+            return 0;
+        }
+        if (strcmp(argv[i], "-V") == 0 || strcmp(argv[i], "--version") == 0) {
+            opts->show_version = 1;
+            return 0;
+        }
+        if (strcmp(argv[i], "-a") == 0) {
+            opts->async = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            opts->bold = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            opts->all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            opts->japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            opts->force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            opts->linux_mode = 1;
+            opts->linux_font = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            opts->lock = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            opts->old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            opts->no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            opts->screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            opts->xterm = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            opts->rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            opts->lambda = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            opts->change_chars = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                opts->update_delay = atoi(argv[++i]);
+            } else {
+                return 1;  // Show help for missing argument
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                opts->color = find_color(argv[++i]);
+            } else {
+                return 1;  // Show help for missing argument
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                opts->message = argv[++i];
+                opts->message_len = strlen(opts->message);
+            } else {
+                return 1;  // Show help for missing argument
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                opts->tty = argv[++i];
+            } else {
+                return 1;  // Show help for missing argument
+            }
+        } else {
+            return 1;  // Show help for unknown option
+        }
+    }
+    
+    return 0;
+}
+
+int find_color(const char *color) {
+    for (int i = 0; i < 8; i++) {
+        if (strcmp(color, valid_colors[i]) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+int init_terminal(struct options *opts) {
+    struct termios oldt, newt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) != 0) {
+        return -1;
+    }
+    
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) != 0) {
+        return -1;
+    }
+    
+    return 0;
+}
+
+void cleanup_terminal(void) {
+    struct termios oldt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) != 0) {
+        return;
+    }
+    
+    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
+}
+
+void print_help(void) {
+    printf("%s", usage);
+}
+
+void print_version(void) {
+    printf("cmatrix %s\n", VERSION);
+}
