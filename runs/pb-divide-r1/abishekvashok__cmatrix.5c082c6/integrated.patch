diff --git a/render.c b/render.c
new file mode 100644
index 0000000..514b5ac
--- /dev/null
+++ b/render.c
@@ -0,0 +1,279 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+#include <math.h>
+
+#include "options.h"
+#include "render.h"
+#include "help.h"
+#include "errors.h"
+
+#define MATRIX_WIDTH 80
+#define MATRIX_HEIGHT 24
+#define MAX_CHARS 1024
+
+// Character sets
+static const char *ascii_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?";
+static const char *katakana_chars = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static const char *latin_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=[]{}|;:,.<>?";
+
+// Color codes
+static const char *color_codes[] = {
+    "\033[0;32m",  // green (default)
+    "\033[0;31m",  // red
+    "\033[0;34m",  // blue
+    "\033[0;37m",  // white
+    "\033[0;33m",  // yellow
+    "\033[0;36m",  // cyan
+    "\033[0;35m",  // magenta
+    "\033[0;30m",  // black
+};
+
+// Lambda character
+static const char *lambda_char = "λ";
+
+// Initialize render state
+int init_render(struct render_state *state, struct options *opts) {
+    state->width = MATRIX_WIDTH;
+    state->height = MATRIX_HEIGHT;
+    state->chars = malloc(MATRIX_WIDTH * MATRIX_HEIGHT * sizeof(char));
+    if (!state->chars) {
+        return -1;
+    }
+    
+    state->colors = malloc(MATRIX_WIDTH * MATRIX_HEIGHT * sizeof(int));
+    if (!state->colors) {
+        free(state->chars);
+        return -1;
+    }
+    
+    state->x = 0;
+    state->y = 0;
+    state->speed = 4;
+    state->update_delay = 4;
+    state->color = opts->color;
+    state->bold = opts->bold;
+    state->all_bold = opts->all_bold;
+    state->no_bold = opts->no_bold;
+    state->async = opts->async;
+    state->old_style = opts->old_style;
+    state->rainbow = opts->rainbow;
+    state->lambda = opts->lambda;
+    state->change_chars = opts->change_chars;
+    state->japanese = opts->japanese;
+    state->message = opts->message;
+    state->message_len = opts->message_len;
+    state->tty = opts->tty;
+    state->locked = opts->lock;
+    state->screensaver = opts->screensaver;
+    state->force_term = opts->force_term;
+    state->linux_mode = opts->linux_mode;
+    state->linux_font = opts->linux_font;
+    state->old_font = 0;
+    state->xterm = opts->xterm;
+    state->quit = 0;
+    
+    // Initialize character grid
+    for (int i = 0; i < MATRIX_WIDTH * MATRIX_HEIGHT; i++) {
+        state->chars[i] = ascii_chars[rand() % strlen(ascii_chars)];
+        state->colors[i] = opts->color;
+    }
+    
+    return 0;
+}
+
+// Cleanup render state
+void cleanup_render(struct render_state *state) {
+    free(state->chars);
+    free(state->colors);
+    free(state->message);
+}
+
+// Get character based on mode
+char get_char(struct render_state *state) {
+    if (state->lambda) {
+        return *lambda_char;
+    }
+    if (state->japanese) {
+        return katakana_chars[rand() % strlen(katakana_chars)];
+    }
+    if (state->change_chars) {
+        return latin_chars[rand() % strlen(latin_chars)];
+    }
+    return ascii_chars[rand() % strlen(ascii_chars)];
+}
+
+// Get color based on mode
+int get_color(struct render_state *state) {
+    if (state->rainbow) {
+        int hue = (time(NULL) / 1000) % 8;
+        return hue;
+    }
+    return state->color;
+}
+
+// Print a line of characters
+void print_line(struct render_state *state, int y) {
+    if (state->message && state->message_len > 0) {
+        // Print message in center
+        int msg_start = (MATRIX_WIDTH - state->message_len) / 2;
+        for (int i = 0; i < MATRIX_WIDTH; i++) {
+            if (i >= msg_start && i < msg_start + state->message_len) {
+                printf("%c", state->message[i - msg_start]);
+            } else {
+                printf(" ");
+            }
+        }
+    } else {
+        for (int x = 0; x < MATRIX_WIDTH; x++) {
+            int idx = y * MATRIX_WIDTH + x;
+            char c = state->chars[idx];
+            int col = state->colors[idx];
+            
+            if (state->bold || state->all_bold) {
+                printf("\033[1m%c\033[0m", c);
+            } else if (state->no_bold) {
+                printf("%c", c);
+            } else {
+                printf("%c", c);
+            }
+            
+            if (col >= 0 && col < 8) {
+                printf("%s", color_codes[col]);
+            }
+        }
+    }
+    printf("\n");
+}
+
+// Render one frame
+void render_frame(struct render_state *state, struct options *opts) {
+    // Move cursor to top-left
+    printf("\033[H");
+    
+    // Print all lines
+    for (int y = 0; y < state->height; y++) {
+        print_line(state, y);
+    }
+    
+    // Update delay
+    usleep(state->update_delay * 100000);
+}
+
+// Main render loop
+void render_loop(struct render_state *state, struct options *opts) {
+    int running = 1;
+    int async_mode = state->async;
+    
+    while (running) {
+        // Move cursor to current position
+        printf("\033[%d;%dH", state->y + 1, state->x + 1);
+        
+        // Update character at current position
+        int idx = state->y * state->width + state->x;
+        state->chars[idx] = get_char(state);
+        state->colors[idx] = get_color(state);
+        
+        // Move to next position
+        state->x++;
+        if (state->x >= state->width) {
+            state->x = 0;
+            state->y++;
+            if (state->y >= state->height) {
+                state->y = 0;
+            }
+        }
+        
+        // Check for keystrokes (if not in screensaver mode)
+        if (!state->screensaver) {
+            fd_set readfds;
+            struct timeval timeout;
+            FD_ZERO(&readfds);
+            FD_SET(STDIN_FILENO, &readfds);
+            timeout.tv_sec = 0;
+            timeout.tv_usec = 100000;  // 100ms
+            
+            if (select(STDIN_FILENO, &readfds, NULL, NULL, &timeout) > 0) {
+                char buf[1];
+                if (read(STDIN_FILENO, buf, 1) > 0) {
+                    handle_key(state, opts, buf[0]);
+                }
+            }
+        }
+        
+        // Render frame
+        render_frame(state, opts);
+        
+        // Check for quit
+        if (state->quit) {
+            running = 0;
+        }
+    }
+}
+
+// Handle keystrokes
+void handle_key(struct render_state *state, struct options *opts, char key) {
+    if (state->screensaver) {
+        return;
+    }
+    
+    switch (key) {
+        case 'q':
+            state->quit = 1;
+            break;
+        case 'a':
+            state->async = !state->async;
+            break;
+        case 'b':
+            state->bold = 1;
+            break;
+        case 'B':
+            state->all_bold = 1;
+            break;
+        case 'n':
+            state->no_bold = 1;
+            break;
+        case '0':
+        case '1':
+        case '2':
+        case '3':
+        case '4':
+        case '5':
+        case '6':
+        case '7':
+        case '8':
+        case '9':
+            state->update_delay = key - '0';
+            break;
+        case '!':
+            state->color = 0;  // red
+            break;
+        case '@':
+            state->color = 1;  // green
+            break;
+        case '#':
+            state->color = 2;  // yellow
+            break;
+        case '$':
+            state->color = 3;  // blue
+            break;
+        case '%':
+            state->color = 4;  // magenta
+            break;
+        case '^':
+            state->color = 5;  // cyan
+            break;
+        case '&':
+            state->color = 6;  // white
+            break;
+        case ')':
+            state->color = 7;  // black
+            break;
+    }
+}
