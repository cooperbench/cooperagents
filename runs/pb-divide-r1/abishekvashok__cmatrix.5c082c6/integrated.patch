+#ifndef RENDER_H
+#define RENDER_H
+
+#include "options.h"
+
+struct render_state {
+    int width;
+    int height;
+    char *chars;
+    int *colors;
+    int x;
+    int y;
+    int speed;
+    int update_delay;
+    int color;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int async;
+    int old_style;
+    int rainbow;
+    int lambda;
+    int change_chars;
+    int japanese;
+    char *message;
+    int message_len;
+    char *tty;
+    int locked;
+    int screensaver;
+    int force_term;
+    int linux_mode;
+    int linux_font;
+    int old_font;
+    int xterm;
+    int quit;
+};
+
+int init_render(struct render_state *state, struct options *opts);
+void cleanup_render(struct render_state *state);
+void render_loop(struct render_state *state, struct options *opts);
+void handle_key(struct render_state *state, struct options *opts, char key);
+
+#endif
