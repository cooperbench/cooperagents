diff --git a/cmd/chroma/main.go b/cmd/chroma/main.go
new file mode 100644
index 0000000..4fa8966
--- /dev/null
+++ b/cmd/chroma/main.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+// cli holds the parsed command-line state.
+type cli struct {
+	progName string
+
+	files []string
+
+	unbuffered bool
+	trace      bool
+	check      bool
+	filename   string
+	fail       bool
+
+	lexer    string
+	style    string
+	formatter string
+
+	json bool
+	html bool
+	svg  bool
+
+	// HTML options
+	htmlPrefix              string
+	htmlStyles             bool
+	htmlAllStyles          bool
+	htmlOnly               bool
+	htmlInlineStyles       bool
+	htmlTabWidth           int
+	htmlLines              bool
+	htmlLinesTable         bool
+	htmlLinesStyle         string
+	htmlHighlight          string
+	htmlHighlightStyle     string
+	htmlBaseLine           int
+	htmlPreventSurroundingPre bool
+	htmlLinkableLines      bool
+
+version bool
+	list    bool
+	help    bool
+
+	// internal
+	specialFirst *string // "help" or "version", whichever seen first
+}
+
+func main() {
+	c := &cli{progName: "executable"}
+	c.setDefaults()
+	args := os.Args[1:]
+	if err := c.parse(args); err != nil {
+		fmt.Fprintf(os.Stderr, "executable: error: %s\n", err)
+		os.Exit(80)
+	}
+	if err := c.run(); err != nil {
+		var ve *validationError
+		if errors.As(err, &ve) {
+			fmt.Fprintf(os.Stderr, "executable: error: %s\n", err)
+			os.Exit(80)
+		}
+		fmt.Fprintf(os.Stderr, "executable: error: %s\n", err)
+		os.Exit(1)
+	}
+}
