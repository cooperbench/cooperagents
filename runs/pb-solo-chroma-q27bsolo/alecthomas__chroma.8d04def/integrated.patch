diff --git a/cmd/chroma/parse.go b/cmd/chroma/parse.go
new file mode 100644
index 0000000..d3857eb
--- /dev/null
+++ b/cmd/chroma/parse.go
@@ -0,0 +1,212 @@
+package main
+
+import (
+	"fmt"
+
+	"strings"
+)
+
+// flagKind is the kind of a flag.
+type flagKind int
+
+const (
+	kindBool flagKind = iota
+	kindString
+	kindInt
+)
+
+// flagSpec describes one flag.
+type flagSpec struct {
+	long   string
+	short  string // single char alias, "" if none
+	kind   flagKind
+	def    string
+	help   string
+	hint   string
+	section string
+	enum   []string
+	into   *string // pointer to store string values
+	intoB  *bool
+	intoI  *int
+}
+
+func (c *cli) specs() []*flagSpec {
+	return []*flagSpec{
+		// general
+		{long: "unbuffered", kind: kindBool, help: "Do not buffer output.", intoB: &c.unbuffered, section: "general"},
+		{long: "trace", kind: kindBool, help: "Trace lexer states as they are traversed.", intoB: &c.trace, section: "general"},
+		{long: "check", kind: kindBool, help: "Do not format, check for tokenisation errors instead.", intoB: &c.check, section: "general"},
+		{long: "filename", kind: kindString, hint: "STRING", help: "Filename to use for selecting a lexer when reading from stdin.", into: &c.filename, section: "general"},
+		{long: "fail", kind: kindBool, help: "Exit silently with status 1 if no specific lexer was found.", intoB: &c.fail, section: "general"},
+		// select lexer and style
+		{long: "lexer", short: "l", kind: kindString, def: "autodetect", hint: "LEXER", help: "Lexer to use when formatting or path to an XML file to load.", into: &c.lexer, section: "select"},
+		{long: "style", short: "s", kind: kindString, def: "swapoff", hint: "STYLE", help: "Style to use for formatting or path to an XML file to load.", into: &c.style, section: "select"},
+		// output format
+		{long: "formatter", short: "f", kind: kindString, def: "terminal", hint: "FORMATTER", help: "Formatter to use.", into: &c.formatter, section: "output", enum: []string{"html", "json", "noop", "svg", "terminal", "terminal16", "terminal16m", "terminal256", "terminal8", "tokens"}},
+		{long: "json", kind: kindBool, help: "Convenience flag to use JSON formatter.", intoB: &c.json, section: "output"},
+		{long: "html", kind: kindBool, help: "Convenience flag to use HTML formatter.", intoB: &c.html, section: "output"},
+		{long: "svg", kind: kindBool, help: "Convenience flag to use SVG formatter.", intoB: &c.svg, section: "output"},
+		// html
+		{long: "html-prefix", kind: kindString, hint: "PREFIX", help: "HTML CSS class prefix.", into: &c.htmlPrefix, section: "html"},
+		{long: "html-styles", kind: kindBool, help: "Output HTML CSS styles.", intoB: &c.htmlStyles, section: "html"},
+		{long: "html-all-styles", kind: kindBool, help: "Output all HTML CSS styles, including redundant ones.", intoB: &c.htmlAllStyles, section: "html"},
+		{long: "html-only", kind: kindBool, help: "Output HTML fragment.", intoB: &c.htmlOnly, section: "html"},
+		{long: "html-inline-styles", kind: kindBool, help: "Output HTML with inline styles (no classes).", intoB: &c.htmlInlineStyles, section: "html"},
+		{long: "html-tab-width", kind: kindInt, def: "8", help: "Set the HTML tab width.", intoI: &c.htmlTabWidth, section: "html"},
+		{long: "html-lines", kind: kindBool, help: "Include line numbers in output.", intoB: &c.htmlLines, section: "html"},
+		{long: "html-lines-table", kind: kindBool, help: "Split line numbers and code in a HTML table", intoB: &c.htmlLinesTable, section: "html"},
+		{long: "html-lines-style", kind: kindString, hint: "STRING", help: "Style for line numbers.", into: &c.htmlLinesStyle, section: "html"},
+		{long: "html-highlight", kind: kindString, hint: "N[:M][,...]", help: "Highlight these lines.", into: &c.htmlHighlight, section: "html"},
+		{long: "html-highlight-style", kind: kindString, hint: "STRING", help: "Style used for highlighting lines.", into: &c.htmlHighlightStyle, section: "html"},
+		{long: "html-base-line", kind: kindInt, def: "1", help: "Base line number.", intoI: &c.htmlBaseLine, section: "html"},
+		{long: "html-prevent-surrounding-pre", kind: kindBool, help: "Prevent the surrounding pre tag.", intoB: &c.htmlPreventSurroundingPre, section: "html"},
+		{long: "html-linkable-lines", kind: kindBool, help: "Make the line numbers linkable and be a link to themselves.", intoB: &c.htmlLinkableLines, section: "html"},
+		// special
+		{long: "version", kind: kindBool, help: "Show version.", intoB: &c.version, section: "special"},
+		{long: "list", kind: kindBool, help: "List available lexers and styles.", intoB: &c.list, section: "special"},
+		{long: "help", short: "h", kind: kindBool, help: "Show context-sensitive help.", intoB: &c.help, section: "special"},
+	}
+}
+
+func (c *cli) parse(args []string) error {
+	s := c.specs()
+	byLong := map[string]*flagSpec{}
+	byShort := map[string]*flagSpec{}
+	for _, sp := range s {
+		byLong[sp.long] = sp
+		if sp.short != "" {
+			byShort[sp.short] = sp
+		}
+	}
+
+	i := 0
+	for i < len(args) {
+		arg := args[i]
+		if arg == "--" {
+			// everything after is positional
+			c.files = append(c.files, args[i+1:]...)
+			break
+		}
+		if strings.HasPrefix(arg, "--") {
+			// long flag
+			name := arg[2:]
+			val := ""
+			hasVal := false
+			if eq := strings.Index(name, "="); eq >= 0 {
+				val = name[eq+1:]
+				name = name[:eq]
+				hasVal = true
+			}
+			sp, ok := byLong[name]
+			if !ok {
+				return fmt.Errorf("unknown flag --%s", name)
+			}
+			// special flags short-circuit tracking
+			if name == "help" || name == "version" {
+				if c.specialFirst == nil {
+					t := name
+					c.specialFirst = &t
+				}
+			}
+			if sp.kind == kindBool {
+				*sp.intoB = true
+				i++
+				continue
+			}
+			// needs a value
+			if !hasVal {
+				// value is next arg, unless it's a flag
+				if i+1 < len(args) && !strings.HasPrefix(args[i+1], "-") {
+					val = args[i+1]
+					i++
+				} else if i+1 < len(args) {
+					nxt := args[i+1]
+					if strings.HasPrefix(nxt, "-") && !strings.HasPrefix(nxt, "--") {
+						return fmt.Errorf("--%s: expected %s value but got %q (short flag); perhaps try --%s=%q?", sp.long, kindWord(sp.kind), nxt, sp.long, nxt)
+					}
+					return fmt.Errorf("--%s: expected %s value but got %q; perhaps try --%s=%q?", sp.long, kindWord(sp.kind), nxt, sp.long, nxt)
+				} else {
+					return fmt.Errorf("--%s: expected %s value but got end of input", sp.long, kindWord(sp.kind))
+				}
+			}
+			if err := c.apply(sp, val); err != nil {
+				return err
+			}
+			i++
+			continue
+		}
+		if strings.HasPrefix(arg, "-") && arg != "-" {
+			// short flags
+			ch := arg[1]
+			sp, ok := byShort[string(ch)]
+			if !ok {
+				// suggest in registration order
+				var shorts []string
+				for _, sh := range shortOrder {
+					shorts = append(shorts, "-"+sh)
+				}
+				return fmt.Errorf("unknown flag -%c, did you mean one of %s?", ch, fmtShorts(shorts))
+			}
+			if name := sp.long; name == "help" || name == "version" {
+				if c.specialFirst == nil {
+					t := name
+					c.specialFirst = &t
+				}
+			}
+			if sp.kind == kindBool {
+				*sp.intoB = true
+				i++
+				continue
+			}
+			// needs value: rest of arg or next arg
+			rest := arg[2:]
+			if eq := strings.Index(rest, "="); eq >= 0 {
+				val := rest[eq+1:]
+				if err := c.apply(sp, val); err != nil {
+					return err
+				}
+				i++
+				continue
+			}
+			if rest != "" {
+				if err := c.apply(sp, rest); err != nil {
+					return err
+				}
+				i++
+				continue
+			}
+			// next arg
+			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "-") {
+				if err := c.apply(sp, args[i+1]); err != nil {
+					return err
+				}
+				i += 2
+				continue
+			}
+			if i+1 < len(args) {
+				nxt := args[i+1]
+				return fmt.Errorf("--%s: expected %s value but got %q (short flag); perhaps try --%s=%q?", sp.long, kindWord(sp.kind), nxt, sp.long, nxt)
+			}
+			return fmt.Errorf("--%s: expected %s value but got end of input", sp.long, kindWord(sp.kind))
+		}
+		// positional
+		c.files = append(c.files, arg)
+		i++
+	}
+	return nil
+}
+
+func kindWord(k flagKind) string {
+	switch k {
+	case kindInt:
+		return "int"
+	case kindString:
+		return "string"
+	}
+	return "value"
+}
+
+
+func fmtShorts(shorts []string) string {
+	return "\"" + strings.Join(shorts, "\", \"") + "\""
+}
diff --git a/cmd/chroma/run.go b/cmd/chroma/run.go
new file mode 100644
index 0000000..c291f5c
--- /dev/null
+++ b/cmd/chroma/run.go
@@ -0,0 +1,109 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+)
+
+func (c *cli) run() error {
+	// Special flags short-circuit before validation.
+	if c.specialFirst != nil {
+		if *c.specialFirst == "help" {
+			printHelp(os.Stdout)
+			return nil
+		}
+		fmt.Fprintln(os.Stdout, "?-?-?")
+		return nil
+	}
+
+	// Validate enum flags.
+	if err := c.validateEnum(); err != nil {
+		return err
+	}
+
+	if c.list {
+		printList(os.Stdout)
+		return nil
+	}
+
+	// Determine the formatter (precedence: json > html > svg > --formatter).
+	fmtr, err := c.resolveFormatter()
+	if err != nil {
+		return err
+	}
+
+	// Load style.
+	if err := c.loadStyle(); err != nil {
+		return err
+	}
+
+	// Load lexer.
+	if err := c.loadLexer(); err != nil {
+		return err
+	}
+
+	// Read input.
+	if err := c.highlight(fmtr); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (c *cli) validateEnum() error {
+	for _, sp := range c.specs() {
+		if sp.enum == nil {
+			continue
+		}
+		val := *sp.into
+		ok := false
+		for _, e := range sp.enum {
+			if e == val {
+				ok = true
+				break
+			}
+		}
+		if !ok {
+			return validationErrorf("--%s must be one of %s but got %q", sp.long, quoted(sp.enum), val)
+		}
+	}
+	return nil
+}
+
+func quoted(items []string) string {
+	out := ""
+	for i, s := range items {
+		if i > 0 {
+			out += ","
+		}
+		out += "\"" + s + "\""
+	}
+	return out
+}
+
+func (c *cli) loadStyle() error {
+	return nil
+}
+
+func (c *cli) loadLexer() error {
+	return nil
+}
+
+func (c *cli) highlight(fmtr string) error {
+	// stub: copy stdin to stdout
+	_, err := io.Copy(os.Stdout, os.Stdin)
+	return err
+}
+
+func (c *cli) resolveFormatter() (string, error) {
+	if c.json {
+		return "json", nil
+	}
+	if c.html {
+		return "html", nil
+	}
+	if c.svg {
+		return "svg", nil
+	}
+	return c.formatter, nil
+}
