--- /dev/null
+++ b/cmd/chroma/errs.go
@@ -0,0 +1,13 @@
+package main
+
+import "fmt"
+
+// validationError wraps a configuration/parse error that should cause the
+// program to exit with status 80 (kingpin's convention).
+type validationError struct{ err error }
+
+func (e *validationError) Error() string { return e.err.Error() }
+
+func validationErrorf(format string, a ...interface{}) *validationError {
+	return &validationError{err: fmt.Errorf(format, a...)}
+}
