+// Package token defines a model for lexical tokens, based on a common
+// superset of tokens across a range of languages.
+package token
+
+import (
+	"fmt"
+	"sort"
+)
+
+// Token is a lexical unit.
+type Token uint
+
+const (
+	// Text is the default text token.
+	Text Token = iota
+
+	// Generic
+
+	// Generic marks text as such.
+	Generic
+	// GenericDeleted marks text as such.
+	GenericDeleted
+	// GenericInserted marks text as such.
+	GenericInserted
+	// GenericSub marks text as such.
+	GenericSub
+	// GenericAdd marks text as such.
+	GenericAdd
+	// GenericEmph marks text as such.
+	GenericEmph
+	// GenericStrong marks text as such.
+	GenericStrong
+	// GenericHeading marks text as such.
+	GenericHeading
+	// GenericTraceback marks text as such.
+	GenericTraceback
+	// GenericPrompt marks text as such.
+	GenericPrompt
+
+	// Whitespace
+
+	// Whitespace token.
+	Whitespace
+
+	// Comment
+
+	// Comment token.
+	Comment
+	// CommentPreproc token.
+	CommentPreproc
+	// CommentSingle token.
+	CommentSingle
+	// CommentMulti token.
+	CommentMulti
+	// CommentBlock token.
+	CommentBlock
+	// CommentHashbang token.
+	CommentHashbang
+	// CommentSpecial token.
+	CommentSpecial
+	// CommentPreprocFile token.
+	CommentPreprocFile
+
+	// String
+
+	// String token.
+	String
+	// StringDouble token.
+	StringDouble
+	// StringSingle token.
+	StringSingle
+	// StringBacktick token.
+	StringBacktick
+	// StringInterpol token.
+	StringInterpol
+	// StringEscape token.
+	StringEscape
+	// StringDelimiter token.
+	StringDelimiter
+	// StringSymbol token.
+	StringSymbol
+	// StringRegex token.
+	StringRegex
+	// StringAffix token.
+	StringAffix
+	// StringInterpreter token.
+	StringInterpreter
+
+	// Name
+
+	// Name token.
+	Name
+	// NameNamespace token.
+	NameNamespace
+	// NameFunction token.
+	NameFunction
+	// NameFunctionMagic token.
+	NameFunctionMagic
+	// NameAttribute token.
+	NameAttribute
+	// NameClass token.
+	NameClass
+	// NameBuiltin token.
+	NameBuiltin
+	// NameException token.
+	NameException
+	// NameProperty token.
+	NameProperty
+	// NameKeyword token.
+	NameKeyword
+	// NamePseudoKeyword token.
+	NamePseudoKeyword
+	// NameTag token.
+	NameTag
+	// NameVariable token.
+	NameVariable
+	// NameVariableClass token.
+	NameVariableClass
+	// NameVariableGlobal token.
+	NameVariableGlobal
+	// NameVariableInstance token.
+	NameVariableInstance
+	// NameLabel token.
+	NameLabel
+	// NameOperator token.
+	NameOperator
+
+	// Operator
+
+	// Operator token.
+	Operator
+	// OperatorKeyword token.
+	OperatorKeyword
+	// OperatorWord token.
+	OperatorWord
+
+	// Punctuation
+
+	// Punctuation token.
+	Punctuation
+	// PunctuationDelimiter token.
+	PunctuationDelimiter
+	// PunctuationBracket token.
+	PunctuationBracket
+	// PunctuationQuote token.
+	PunctuationQuote
+	// PunctuationSection token.
+	PunctuationSection
+
+	// Literal
+
+	// Literal token.
+	Literal
+	// LiteralString token.
+	LiteralString
+	// LiteralStringSingle token.
+	LiteralStringSingle
+	// LiteralStringDouble token.
+	LiteralStringDouble
+	// LiteralNumber token.
+	LiteralNumber
+	// LiteralNumberInteger token.
+	LiteralNumberInteger
+	// LiteralNumberFloat token.
+	LiteralNumberFloat
+	// LiteralNumberHex token.
+	LiteralNumberHex
+	// LiteralNumberOct token.
+	LiteralNumberOct
+	// LiteralNumberBin token.
+	LiteralNumberBin
+	// LiteralNumberLong token.
+	LiteralNumberLong
+	// LiteralNumberComplex token.
+	LiteralNumberComplex
+	// LiteralDate token.
+	LiteralDate
+)
+
+// Parent returns the parent token, or zero if there is no parent.
+func (t Token) Parent() Token {
+	switch t {
+	// Generic
+	case GenericDeleted, GenericInserted, GenericSub, GenericAdd,
+		GenericEmph, GenericStrong, GenericHeading, GenericTraceback, GenericPrompt:
+		return Generic
+	case Generic:
+		return 0
+
+	// Whitespace
+	case Whitespace:
+		return 0
+
+	// Comment
+	case CommentPreproc, CommentSingle, CommentMulti, CommentBlock,
+		CommentHashbang, CommentSpecial, CommentPreprocFile:
+		return Comment
+	case Comment:
+		return 0
+
+	// String
+	case StringDouble, StringSingle, StringBacktick, StringInterpol,
+		StringEscape, StringDelimiter, StringSymbol, StringRegex, StringAffix, StringInterpreter:
+		return String
+	case String:
+		return 0
+
+	// Name
+	case NameNamespace, NameFunction, NameAttribute, NameClass, NameBuiltin,
+		NameException, NameProperty, NameKeyword, NamePseudoKeyword, NameTag,
+		NameVariable, NameLabel, NameOperator:
+		return Name
+	case NameFunctionMagic:
+		return NameFunction
+	case NameVariableClass, NameVariableGlobal, NameVariableInstance:
+		return NameVariable
+	case Name:
+		return 0
+
+	// Operator
+	case OperatorKeyword, OperatorWord:
+		return Operator
+	case Operator:
+		return 0
+
+	// Punctuation
+	case PunctuationDelimiter, PunctuationBracket, PunctuationQuote, PunctuationSection:
+		return Punctuation
+	case Punctuation:
+		return 0
+
+	// Literal
+	case LiteralString, LiteralNumber, LiteralDate:
+		return Literal
+	case LiteralStringSingle, LiteralStringDouble:
+		return LiteralString
+	case LiteralNumberInteger, LiteralNumberFloat, LiteralNumberHex,
+		LiteralNumberOct, LiteralNumberBin, LiteralNumberLong, LiteralNumberComplex:
+		return LiteralNumber
+	case Literal:
+		return 0
+	}
+	return 0
+}
+
+var names = map[Token]string{
+	Text: "Text",
+
+	Generic: "Generic",
+	GenericDeleted: "GenericDeleted",
+	GenericInserted: "GenericInserted",
+	GenericSub: "GenericSub",
+	GenericAdd: "GenericAdd",
+	GenericEmph: "GenericEmph",
+	GenericStrong: "GenericStrong",
+	GenericHeading: "GenericHeading",
+	GenericTraceback: "GenericTraceback",
+	GenericPrompt: "GenericPrompt",
+
+	Whitespace: "Whitespace",
+
+	Comment: "Comment",
+	CommentPreproc: "CommentPreproc",
+	CommentSingle: "CommentSingle",
+	CommentMulti: "CommentMulti",
+	CommentBlock: "CommentBlock",
+	CommentHashbang: "CommentHashbang",
+	CommentSpecial: "CommentSpecial",
+	CommentPreprocFile: "CommentPreprocFile",
+
+	String: "String",
+	StringDouble: "StringDouble",
+	StringSingle: "StringSingle",
+	StringBacktick: "StringBacktick",
+	StringInterpol: "StringInterpol",
+	StringEscape: "StringEscape",
+	StringDelimiter: "StringDelimiter",
+	StringSymbol: "StringSymbol",
+	StringRegex: "StringRegex",
+	StringAffix: "StringAffix",
+	StringInterpreter: "StringInterpreter",
+
+	Name: "Name",
+	NameNamespace: "NameNamespace",
+	NameFunction: "NameFunction",
+	NameFunctionMagic: "NameFunctionMagic",
+	NameAttribute: "NameAttribute",
+	NameClass: "NameClass",
+	NameBuiltin: "NameBuiltin",
+	NameException: "NameException",
+	NameProperty: "NameProperty",
+	NameKeyword: "NameKeyword",
+	NamePseudoKeyword: "NamePseudoKeyword",
+	NameTag: "NameTag",
+	NameVariable: "NameVariable",
+	NameVariableClass: "NameVariableClass",
+	NameVariableGlobal: "NameVariableGlobal",
+	NameVariableInstance: "NameVariableInstance",
+	NameLabel: "NameLabel",
+	NameOperator: "NameOperator",
+
+	Operator: "Operator",
+	OperatorKeyword: "OperatorKeyword",
+	OperatorWord: "OperatorWord",
+
+	Punctuation: "Punctuation",
+	PunctuationDelimiter: "PunctuationDelimiter",
+	PunctuationBracket: "PunctuationBracket",
+	PunctuationQuote: "PunctuationQuote",
+	PunctuationSection: "PunctuationSection",
+
+	Literal: "Literal",
+	LiteralString: "LiteralString",
+	LiteralStringSingle: "LiteralStringSingle",
+	LiteralStringDouble: "LiteralStringDouble",
+	LiteralNumber: "LiteralNumber",
+	LiteralNumberInteger: "LiteralNumberInteger",
+	LiteralNumberFloat: "LiteralNumberFloat",
+	LiteralNumberHex: "LiteralNumberHex",
+	LiteralNumberOct: "LiteralNumberOct",
+	LiteralNumberBin: "LiteralNumberBin",
+	LiteralNumberLong: "LiteralNumberLong",
+	LiteralNumberComplex: "LiteralNumberComplex",
+	LiteralDate: "LiteralDate",
+}
+
+func (t Token) String() string {
+	if s, ok := names[t]; ok {
+		return s
+	}
+	return fmt.Sprintf("Token(%d)", int(t))
+}
+
+// StringToToken returns the token for the name.
+func StringToToken(s string) (Token, bool) {
+	for k, v := range names {
+		if v == s {
+			return k, true
+		}
+	}
+	return 0, false
+}
+
+// All returns all tokens, in order.
+func All() []Token {
+	var all []Token
+	for k := range names {
+		all = append(all, k)
+	}
+	sort.Slice(all, func(i, j int) bool { return all[i] < all[j] })
+	return all
+}
