+#ifndef OPTIONS_H
+#define OPTIONS_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define VERSION "1.0"
+#define BUILD_TIME "unknown"
+#define EMAIL "cmatrix@example.com"
+#define WEB "http://example.com"
+#define DEFAULT_DELAY 4
+#define DEFAULT_COLOR "green"
+
+/* Option flags */
+#define OPT_ASYNC 1
+#define OPT_BOLD 2
+#define OPT_ALL_BOLD 4
+#define OPT_JAPANESE 8
+#define OPT_FORCE_TERM 16
+#define OPT_LINUX 32
+#define OPT_LOCK 64
+#define OPT_OLD_SCROLL 128
+#define OPT_NO_BOLD 256
+#define OPT_SAVESCREEN 512
+#define OPT_XMODE 1024
+#define OPT_RAINBOW 2048
+#define OPT_LAMBDA 4096
+#define OPT_CHANGE 8192
+
+/* Color constants */
+#define COLOR_GREEN 32
+#define COLOR_RED 31
+#define COLOR_BLUE 34
+#define COLOR_WHITE 37
+#define COLOR_YELLOW 33
+#define COLOR_CYAN 36
+#define COLOR_MAGENTA 35
+#define COLOR_BLACK 30
+
+void print_usage(void);
+void print_version(void);
+int validate_color(const char *color);
+void print_error(const char *msg);
+void print_error_invalid_color(const char *color);
+int parse_options(int argc, char **argv, int *flags, int *delay, char **color, char **message, char **tty);
+
+#endif /* OPTIONS_H */
diff --git a/src/screen.c b/src/screen.c
new file mode 100644
index 0000000..0414566
--- /dev/null
+++ b/src/screen.c
@@ -0,0 +1,79 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <string.h>
+
+#include "screen.h"
+#include "options.h"
+
+static struct termios g_orig_termios;
+static int g_tty_fd = -1;
+
+void setup_terminal(void) {
+    /* Save original terminal settings */
+    tcgetattr(STDIN_FILENO, &g_orig_termios);
+    
+    /* Set raw mode */
+    struct termios raw = g_orig_termios;
+    raw.c_lflag &= ~(ICANON | ECHO);
+    raw.c_cc[VMIN] = 1;
+    raw.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+    
+    /* Set terminal type */
+    if (g_force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    /* Set Linux mode */
+    if (g_linux_mode) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    /* Set X mode */
+    if (g_xmode) {
+        setenv("TERM", "xterm", 1);
+    }
+    
+    /* Set tty if specified */
+    if (g_tty) {
+        g_tty_fd = open(g_tty, O_RDWR);
+        if (g_tty_fd < 0) {
+            fprintf(stderr, "cmatrix: error: '%s' couldn't be opened: %s\n", 
+                    g_tty, strerror(errno));
+            exit(1);
+        }
+        dup2(g_tty_fd, STDIN_FILENO);
+        dup2(g_tty_fd, STDOUT_FILENO);
+        close(g_tty_fd);
+    }
+}
+
+void cleanup_terminal(void) {
+    /* Restore terminal settings */
+    tcsetattr(STDIN_FILENO, TCSANOW, &g_orig_termios);
+    
+    /* Reset colors */
+    printf("\033[0m");
+}
+
+void clear_screen(void) {
+    printf("\033[2J");
+}
+
+void refresh_screen(void) {
+    fflush(stdout);
+}
+
+void resize_terminal(void) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        g_cols = ws.ws_col;
+        g_rows = ws.ws_row;
+    }
+}
