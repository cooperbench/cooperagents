new file mode 100755
index 0000000..eac9d75
--- /dev/null
+++ b/compile.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+set -e
+
+cd "$(dirname "$0")"
+
+# Create src directory if it doesn't exist
+mkdir -p src
+
+# Compile the program
+gcc -o executable \
+    src/main.c \
+    src/screen.c \
+    src/matrix.c \
+    src/options.c \
+    src/interactive.c \
+    -Wall -Wextra -O2
+
+echo "Build successful: ./executable"
