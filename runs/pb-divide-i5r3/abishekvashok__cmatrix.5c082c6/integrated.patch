+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "matrix.h"
+#include "options.h"
+
+/* Matrix character set */
+static const char g_matrix_chars[] = 
+    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+    "abcdefghijklmnopqrstuvwxyz"
+    "!@#$%^&*()_+-=[]{}|;':\",./<>?";
+
+/* Japanese characters for -c option */
+static const char g_japanese_chars[] = 
+    "アァカサタナハマヤャラワガザダバパイ"
+    "ィイウエオゥヴカシチニヒミヂビピ"
+    "ェェォフクスヴヅトヌムヅテデベペ"
+    "ョョヮヴグンドトドボポロモゴゾ"
+    "ヴヰヱヲンヴヴヴヴヴヴヴヴヴヴヴヴヴ";
+
+static int g_use_japanese = 0;
+
+void init_matrix_chars(void) {
+    g_use_japanese = g_japanese;
+}
+
+char get_random_matrix_char(void) {
+    const char *chars;
+    int len;
+    
+    if (g_use_japanese) {
+        chars = g_japanese_chars;
+        len = sizeof(g_japanese_chars) - 1;
+    } else {
+        chars = g_matrix_chars;
+        len = sizeof(g_matrix_chars) - 1;
+    }
+    
+    return chars[rand() % len];
+}
