diff --git a/src/options.c b/src/options.c
new file mode 100644
index 0000000..6bfb35b
--- /dev/null
+++ b/src/options.c
@@ -0,0 +1,117 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+
+#include "options.h"
+
+void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+void print_version(void) {
+    printf("cmatrix %s\n", VERSION);
+    printf("Build time: %s\n", BUILD_TIME);
+    printf("Email: %s\n", EMAIL);
+    printf("Web: %s\n", WEB);
+}
+
+int validate_color(const char *color) {
+    if (strcmp(color, "green") == 0) return COLOR_GREEN;
+    if (strcmp(color, "red") == 0) return COLOR_RED;
+    if (strcmp(color, "blue") == 0) return COLOR_BLUE;
+    if (strcmp(color, "white") == 0) return COLOR_WHITE;
+    if (strcmp(color, "yellow") == 0) return COLOR_YELLOW;
+    if (strcmp(color, "cyan") == 0) return COLOR_CYAN;
+    if (strcmp(color, "magenta") == 0) return COLOR_MAGENTA;
+    if (strcmp(color, "black") == 0) return COLOR_BLACK;
+    return -1;
+}
+
+void print_error(const char *msg) {
+    fprintf(stderr, "cmatrix: error: %s\n", msg);
+}
+
+void print_error_invalid_color(const char *color) {
+    fprintf(stderr, "cmatrix: error: invalid color '%s'\n", color);
+}
+
+int parse_options(int argc, char **argv, int *flags, int *delay, char **color, char **message, char **tty) {
+    int i;
+    *flags = 0;
+    *delay = DEFAULT_DELAY;
+    *color = NULL;
+    *message = NULL;
+    *tty = NULL;
+    
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            return 0;
+        }
+        if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            return 0;
+        }
+        if (strcmp(argv[i], "-a") == 0) *flags |= OPT_ASYNC;
+        else if (strcmp(argv[i], "-b") == 0) *flags |= OPT_BOLD;
+        else if (strcmp(argv[i], "-B") == 0) *flags |= OPT_ALL_BOLD;
+        else if (strcmp(argv[i], "-c") == 0) *flags |= OPT_JAPANESE;
+        else if (strcmp(argv[i], "-f") == 0) *flags |= OPT_FORCE_TERM;
+        else if (strcmp(argv[i], "-l") == 0) *flags |= OPT_LINUX;
+        else if (strcmp(argv[i], "-L") == 0) *flags |= OPT_LOCK;
+        else if (strcmp(argv[i], "-o") == 0) *flags |= OPT_OLD_SCROLL;
+        else if (strcmp(argv[i], "-n") == 0) *flags |= OPT_NO_BOLD;
+        else if (strcmp(argv[i], "-s") == 0) *flags |= OPT_SAVESCREEN;
+        else if (strcmp(argv[i], "-x") == 0) *flags |= OPT_XMODE;
+        else if (strcmp(argv[i], "-r") == 0) *flags |= OPT_RAINBOW;
+        else if (strcmp(argv[i], "-m") == 0) *flags |= OPT_LAMBDA;
+        else if (strcmp(argv[i], "-k") == 0) *flags |= OPT_CHANGE;
+        else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) *delay = atoi(argv[++i]);
+            if (*delay < 0 || *delay > 10) *delay = DEFAULT_DELAY;
+        }
+        else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) *color = argv[++i];
+            else *color = DEFAULT_COLOR;
+        }
+        else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) *message = argv[++i];
+            else *message = "Welcome to the Matrix";
+        }
+        else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) *tty = argv[++i];
+            else *tty = "/dev/tty";
+        }
+        else {
+            fprintf(stderr, "cmatrix: error: unknown option '%s'\n", argv[i]);
+            return 1;
+        }
+    }
+    return 0;
+}
