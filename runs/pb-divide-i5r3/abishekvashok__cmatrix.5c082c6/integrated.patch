+++ b/src/main.c
@@ -0,0 +1,335 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+
+#include "options.h"
+#include "screen.h"
+#include "matrix.h"
+#include "interactive.h"
+
+/* Global state */
+static int g_flags = 0;
+static int g_delay = DEFAULT_DELAY;
+static char *g_color = NULL;
+static char *g_message = NULL;
+static char *g_tty = NULL;
+static int g_async = 0;
+static int g_locked = 0;
+static int g_screensaver = 0;
+static int g_old_scroll = 0;
+static int g_shadow = 0;
+static int g_rainbow = 0;
+static int g_lambda = 0;
+static int g_change = 0;
+static int g_japanese = 0;
+static int g_force_term = 0;
+static int g_linux_mode = 0;
+static int g_xmode = 0;
+static int g_no_bold = 0;
+static int g_bold = 0;
+static int g_all_bold = 0;
+
+/* Terminal state */
+static struct termios g_orig_termios;
+static int g_tty_fd = -1;
+
+/* Matrix state */
+static int g_cols = 80;
+static int g_rows = 24;
+static char g_matrix_chars[80][24];
+static int g_matrix_width = 0;
+static int g_matrix_height = 0;
+
+/* Color state */
+static int g_current_color = COLOR_GREEN;
+
+/* Signal handler */
+static void sigint_handler(int sig) {
+    (void)sig;
+    if (g_locked) {
+        return;
+    }
+    if (g_screensaver) {
+        exit(0);
+    }
+    exit(0);
+}
+
+static void sigwinch_handler(int sig) {
+    (void)sig;
+    resize_terminal();
+}
+
+static void setup_signal_handlers(void) {
+    struct sigaction sa;
+    
+    sa.sa_handler = sigint_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGINT, &sa, NULL);
+    
+    sa.sa_handler = sigwinch_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGWINCH, &sa, NULL);
+}
+
+static void init_matrix(void) {
+    g_matrix_width = g_cols;
+    g_matrix_height = g_rows;
+    
+    /* Initialize matrix with random characters */
+    for (int y = 0; y < g_rows; y++) {
+        for (int x = 0; x < g_cols; x++) {
+            g_matrix_chars[x][y] = get_random_matrix_char();
+        }
+    }
+}
+
+static void draw_matrix(void) {
+    /* Clear screen */
+    clear_screen();
+    
+    /* Draw matrix characters */
+    for (int y = 0; y < g_rows; y++) {
+        for (int x = 0; x < g_cols; x++) {
+            char c = g_matrix_chars[x][y];
+            int color = g_current_color;
+            
+            /* Apply rainbow mode */
+            if (g_rainbow) {
+                color = (color + (y + x) % 8) % 8;
+            }
+            
+            /* Apply lambda mode */
+            if (g_lambda) {
+                c = 'λ';
+            }
+            
+            /* Apply shadow mode */
+            if (g_shadow) {
+                printf("\033[2K");
+                printf("\033[%d;%dH", y + 1, x + 1);
+                printf("\033[2m%c\033[0m", c);
+            } else {
+                printf("\033[%d;%dH", y + 1, x + 1);
+                printf("\033[%dm%c\033[0m", color, c);
+            }
+            
+            /* Apply bold mode */
+            if (g_bold || g_all_bold) {
+                printf("\033[1m");
+            } else if (g_no_bold) {
+                printf("\033[22m");
+            }
+        }
+    }
+    
+    /* Draw message if present */
+    if (g_message) {
+        printf("\033[%d;%dH", g_rows / 2, g_cols / 2);
+        printf("\033[1;37m%s\033[0m", g_message);
+    }
+    
+    /* Refresh terminal */
+    refresh_screen();
+}
+
+static void update_matrix(void) {
+    /* Shift matrix characters */
+    for (int x = 0; x < g_cols; x++) {
+        for (int y = g_rows - 1; y > 0; y--) {
+            g_matrix_chars[x][y] = g_matrix_chars[x][y - 1];
+        }
+        g_matrix_chars[x][0] = get_random_matrix_char();
+    }
+}
+
+static void async_update_matrix(void) {
+    /* Asynchronous update - update only some columns */
+    int num_cols = g_cols / 4;
+    for (int i = 0; i < num_cols; i++) {
+        int col = (rand() % g_cols);
+        for (int y = g_rows - 1; y > 0; y--) {
+            g_matrix_chars[col][y] = g_matrix_chars[col][y - 1];
+        }
+        g_matrix_chars[col][0] = get_random_matrix_char();
+    }
+}
+
+static void handle_keypress(int key) {
+    if (g_screensaver) {
+        exit(0);
+    }
+    
+    if (g_locked) {
+        return;
+    }
+    
+    switch (key) {
+        case 'a':
+            g_async = !g_async;
+            break;
+        case 'b':
+            g_bold = !g_bold;
+            break;
+        case 'B':
+            g_all_bold = 1;
+            g_bold = 0;
+            g_no_bold = 0;
+            break;
+        case 'n':
+            g_no_bold = 1;
+            g_bold = 0;
+            g_all_bold = 0;
+            break;
+        case '0':
+        case '1':
+        case '2':
+        case '3':
+        case '4':
+        case '5':
+        case '6':
+        case '7':
+        case '8':
+        case '9':
+            g_delay = key - '0';
+            break;
+        case '!':
+            g_current_color = COLOR_RED;
+            break;
+        case '@':
+            g_current_color = COLOR_GREEN;
+            break;
+        case '#':
+            g_current_color = COLOR_YELLOW;
+            break;
+        case '$':
+            g_current_color = COLOR_BLUE;
+            break;
+        case '%':
+            g_current_color = COLOR_MAGENTA;
+            break;
+        case '^':
+            g_current_color = COLOR_CYAN;
+            break;
+        case '&':
+            g_current_color = COLOR_WHITE;
+            break;
+        case ')':
+            g_current_color = COLOR_BLACK;
+            break;
+        case 'q':
+            exit(0);
+            break;
+        default:
+            break;
+    }
+}
+
+static int read_keypress(void) {
+    struct termios raw;
+    tcgetattr(STDIN_FILENO, &raw);
+    int old_flags = raw.c_lflag;
+    raw.c_lflag &= ~(ICANON | ECHO);
+    raw.c_cc[VMIN] = 0;
+    raw.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+    
+    int key = getchar();
+    
+    tcsetattr(STDIN_FILENO, TCSANOW, &g_orig_termios);
+    
+    return key;
+}
+
+static void run_interactive(void) {
+    struct timeval tv;
+    fd_set readfds;
+    
+    while (1) {
+        FD_ZERO(&readfds);
+        FD_SET(STDIN_FILENO, &readfds);
+        
+        tv.tv_sec = 0;
+        tv.tv_usec = g_delay * 10000;
+        
+        int ret = select(STDIN_FILENO + 1, &readfds, NULL, NULL, &tv);
+        
+        if (ret > 0 && FD_ISSET(STDIN_FILENO, &readfds)) {
+            int key = read_keypress();
+            if (key != -1) {
+                handle_keypress(key);
+            }
+        }
+    }
+}
+
+static void run_matrix(void) {
+    while (1) {
+        draw_matrix();
+        
+        if (g_async) {
+            async_update_matrix();
+        } else {
+            update_matrix();
+        }
+        
+        usleep(g_delay * 10000);
+    }
+}
+
+int main(int argc, char **argv) {
+    int flags = 0;
+    int delay = DEFAULT_DELAY;
+    char *color = NULL;
+    char *message = NULL;
+    char *tty = NULL;
+    
+    /* Parse options */
+    if (parse_options(argc, argv, &flags, &delay, &color, &message, &tty) != 0) {
+        return 1;
+    }
+    
+    g_flags = flags;
+    g_delay = delay;
+    g_color = color;
+    g_message = message;
+    g_tty = tty;
+    
+    /* Validate color */
+    if (color) {
+        if (validate_color(color) < 0) {
+            print_error_invalid_color(color);
+            return 0;
+        }
+        g_current_color = validate_color(color);
+    }
+    
+    /* Setup terminal */
+    setup_terminal();
+    
+    /* Setup signal handlers */
+    setup_signal_handlers();
+    
+    /* Initialize matrix */
+    init_matrix();
+    
+    /* Run the program */
+    if (g_screensaver) {
+        run_interactive();
+    } else {
+        run_matrix();
+    }
+    
+    /* Cleanup */
+    cleanup_terminal();
+    
+    return 0;
+}
