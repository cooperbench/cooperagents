+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+
+#include "options.h"
+#include "screen.h"
+#include "matrix.h"
+
+static int g_async = 0;
+static int g_locked = 0;
+static int g_screensaver = 0;
+static int g_old_scroll = 0;
+static int g_shadow = 0;
+static int g_rainbow = 0;
+static int g_lambda = 0;
+static int g_change = 0;
+static int g_japanese = 0;
+static int g_force_term = 0;
+static int g_linux_mode = 0;
+static int g_xmode = 0;
+static int g_no_bold = 0;
+static int g_bold = 0;
+static int g_all_bold = 0;
+
+static struct termios g_orig_termios;
+static int g_tty_fd = -1;
+
+static void sigint_handler(int sig) {
+    (void)sig;
+    if (g_locked) return;
+    if (g_screensaver) exit(0);
+    exit(0);
+}
+
+static void sigwinch_handler(int sig) {
+    (void)sig;
+    resize_terminal();
+}
+
+static void setup_signal_handlers(void) {
+    struct sigaction sa;
+    sa.sa_handler = sigint_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGINT, &sa, NULL);
+    sa.sa_handler = sigwinch_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGWINCH, &sa, NULL);
+}
+
+static void setup_terminal(void) {
+    tcgetattr(STDIN_FILENO, &g_orig_termios);
+    struct termios raw = g_orig_termios;
+    raw.c_lflag &= ~(ICANON | ECHO);
+    raw.c_cc[VMIN] = 1;
+    raw.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+    if (g_force_term) setenv("TERM", "linux", 1);
+    if (g_linux_mode) setenv("TERM", "linux", 1);
+    if (g_xmode) setenv("TERM", "xterm", 1);
+    if (g_tty) {
+        g_tty_fd = open(g_tty, O_RDWR);
+        if (g_tty_fd < 0) {
+            fprintf(stderr, "cmatrix: error: '%s' couldn't be opened: %s\n", g_tty, strerror(errno));
+            exit(1);
+        }
+        dup2(g_tty_fd, STDIN_FILENO);
+        dup2(g_tty_fd, STDOUT_FILENO);
+        close(g_tty_fd);
+    }
+}
+
+static void cleanup_terminal(void) {
+    tcsetattr(STDIN_FILENO, TCSANOW, &g_orig_termios);
+    printf("\033[0m");
+}
+
+static void clear_screen(void) {
+    printf("\033[2J");
+}
+
+static void refresh_screen(void) {
+    fflush(stdout);
+}
+
+static void resize_terminal(void) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        /* Update global cols/rows if needed */
+    }
+}
