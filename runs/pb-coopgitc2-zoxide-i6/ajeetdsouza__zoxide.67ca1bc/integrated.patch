+def init_shell(shell: str, cmd: Optional[str] = None, no_cmd: bool = False, hook: Optional[str] = None) -> int:
+    """Generate shell initialization code."""
+    if shell == "bash":
+        return generate_bash_init(cmd, no_cmd, hook)
+    elif shell == "zsh":
+        return generate_zsh_init(cmd, no_cmd, hook)
+    elif shell == "fish":
+        return generate_fish_init(cmd, no_cmd, hook)
+    elif shell == "powershell":
+        return generate_powershell_init(cmd, no_cmd, hook)
+    elif shell == "elvish":
+        return generate_elvish_init(cmd, no_cmd, hook)
+    elif shell == "nushell":
+        return generate_nushell_init(cmd, no_cmd, hook)
+    elif shell == "posix":
+        return generate_posix_init(cmd, no_cmd, hook)
+    else:
+        print(f"zoxide: unknown shell: {shell}", file=sys.stderr)
+        return 1
+
