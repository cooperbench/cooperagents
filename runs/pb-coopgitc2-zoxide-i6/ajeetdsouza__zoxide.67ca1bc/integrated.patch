+fn init(shell: &str, cmd: &str, no_cmd: bool) {
+    match shell {
+        "bash" => init_bash(cmd, no_cmd),
+        "zsh" => init_zsh(cmd, no_cmd),
+        "fish" => init_fish(cmd, no_cmd),
+        "powershell" => init_powershell(cmd, no_cmd),
+        "elvish" => init_elvish(cmd, no_cmd),
+        "nushell" => init_nushell(cmd, no_cmd),
+        _ => {
+            eprintln!("Unsupported shell: {}", shell);
+            process::exit(1);
+        }
+    }
+}
+
+fn init_bash(cmd: &str, no_cmd: bool) {
