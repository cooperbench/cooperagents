+use std::collections::BTreeMap;
+use std::env;
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::process;
+
+const VERSION: &str = env!("CARGO_PKG_VERSION");
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+struct Entry {
+    path: PathBuf,
+    score: f64,
+    count: u64,
+    last_accessed: u64,
+}
+
+impl Entry {
+    fn new(path: PathBuf) -> Self {
+        Entry {
+            path,
+            score: 0.0,
+            count: 0,
+            last_accessed: 0,
+        }
+    }
+
+    fn score(&self) -> f64 {
+        self.score
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Database {
+    entries: BTreeMap<String, Entry>,
+}
+
+impl Database {
+    fn new() -> Self {
+        Database {
+            entries: BTreeMap::new(),
+        }
+    }
+
+    fn load(path: &Path) -> io::Result<Self> {
+        let content = fs::read_to_string(path)?;
+        let mut db = Database::new();
+        for line in content.lines() {
+            let line = line.trim();
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let parts: Vec<&str> = line.split_whitespace().collect();
+            if parts.len() >= 2 {
+                let path_str = parts[0];
+                let score: f64 = parts[1].parse().unwrap_or(0.0);
+                let entry = Entry::new(PathBuf::from(path_str));
+                entry.score = score;
+                db.entries.insert(path_str.to_string(), entry);
+            }
+        }
+        Ok(db)
+    }
+
+    fn save(&self, path: &Path) -> io::Result<()> {
+        let mut content = String::new();
+        for (path_str, entry) in &self.entries {
+            content.push_str(&format!("{} {:.10}\n", path_str, entry.score));
+        }
+        fs::write(path, content)?;
+        Ok(())
+    }
+
+    fn add(&mut self, path: &Path, score: f64) {
+        let path_str = path.to_string_lossy().to_string();
+        let entry = Entry::new(path.to_path_buf());
+        entry.score = score;
+        self.entries.insert(path_str, entry);
+    }
+
+    fn query(&self, query: &str, exclude: Option<&Path>) -> Vec<(String, f64)> {
+        let query_lower = query.to_lowercase();
+        let mut results: Vec<(String, f64)> = self
+            .entries
+            .iter()
+            .filter(|(_, entry)| {
+                if let Some(exclude) = exclude {
+                    let entry_path = entry.path.to_string_lossy();
+                    if entry_path == exclude.to_string_lossy() {
+                        return false;
+                    }
+                }
+                entry.path.to_string_lossy().to_lowercase().contains(&query_lower)
+            })
+            .map(|(path, entry)| (path.clone(), entry.score()))
+            .collect();
+        results.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+        results
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        return;
+    }
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("{}", VERSION);
+        return;
+    }
+
+    let mut cmd = None;
+    let mut no_cmd = false;
+    let mut args_to_cmd = Vec::new();
+
+    let mut i = 1;
+    while i < args.len() {
+        if args[i] == "--cmd" {
+            cmd = Some(args[i + 1].clone());
+            args_to_cmd = args[i + 2..].to_vec();
+            i += 3;
+            break;
+        } else if args[i] == "--no-cmd" {
+            no_cmd = true;
+            i += 1;
+        } else {
+            break;
+        }
+    }
+
+    let cmd = cmd.unwrap_or_else(|| "zoxide".to_string());
+    let no_cmd = no_cmd;
+
+    if args_to_cmd.is_empty() {
+        match cmd.as_str() {
+            "add" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} add <directory>", cmd);
+                    process::exit(1);
+                }
+                let dir = PathBuf::from(&args[2]);
+                if !dir.exists() {
+                    eprintln!("Error: {} does not exist", dir.display());
+                    process::exit(1);
+                }
+                add(&dir);
+            }
+            "edit" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} edit <directory>", cmd);
+                    process::exit(1);
+                }
+                let dir = PathBuf::from(&args[2]);
+                if !dir.exists() {
+                    eprintln!("Error: {} does not exist", dir.display());
+                    process::exit(1);
+                }
+                edit(&dir);
+            }
+            "import" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} import <file>", cmd);
+                    process::exit(1);
+                }
+                let file = PathBuf::from(&args[2]);
+                if !file.exists() {
+                    eprintln!("Error: {} does not exist", file.display());
+                    process::exit(1);
+                }
+                import(&file);
+            }
+            "init" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} init <shell>", cmd);
+                    process::exit(1);
+                }
+                let shell = args[2].clone();
+                init(&shell, &cmd, no_cmd);
+            }
+            "query" => {
+                if args.len() < 2 {
+                    eprintln!("Usage: {} query [query]", cmd);
+                    process::exit(1);
+                }
+                let query = if args.len() > 2 {
+                    &args[2]
+                } else {
+                    ""
+                };
+                query_dirs(query);
+            }
+            "remove" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} remove <directory>", cmd);
+                    process::exit(1);
+                }
+                let dir = PathBuf::from(&args[2]);
+                if !dir.exists() {
+                    eprintln!("Error: {} does not exist", dir.display());
+                    process::exit(1);
+                }
+                remove(&dir);
+            }
+            _ => {
+                eprintln!("Unknown command: {}", args[1]);
+                print_help();
+                process::exit(1);
+            }
+        }
+    } else {
+        match cmd.as_str() {
+            "add" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} add <directory>", cmd);
+                    process::exit(1);
+                }
+                let dir = PathBuf::from(&args[2]);
+                if !dir.exists() {
+                    eprintln!("Error: {} does not exist", dir.display());
+                    process::exit(1);
+                }
+                add(&dir);
+            }
+            "edit" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} edit <directory>", cmd);
+                    process::exit(1);
+                }
+                let dir = PathBuf::from(&args[2]);
+                if !dir.exists() {
+                    eprintln!("Error: {} does not exist", dir.display());
+                    process::exit(1);
+                }
+                edit(&dir);
+            }
+            "import" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} import <file>", cmd);
+                    process::exit(1);
+                }
+                let file = PathBuf::from(&args[2]);
+                if !file.exists() {
+                    eprintln!("Error: {} does not exist", file.display());
+                    process::exit(1);
+                }
+                import(&file);
+            }
+            "init" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} init <shell>", cmd);
+                    process::exit(1);
+                }
+                let shell = args[2].clone();
+                init(&shell, &cmd, no_cmd);
+            }
+            "query" => {
+                if args.len() < 2 {
+                    eprintln!("Usage: {} query [query]", cmd);
+                    process::exit(1);
+                }
+                let query = if args.len() > 2 {
+                    &args[2]
+                } else {
+                    ""
+                };
+                query_dirs(query);
+            }
+            "remove" => {
+                if args.len() < 3 {
+                    eprintln!("Usage: {} remove <directory>", cmd);
+                    process::exit(1);
+                }
+                let dir = PathBuf::from(&args[2]);
+                if !dir.exists() {
+                    eprintln!("Error: {} does not exist", dir.display());
+                    process::exit(1);
+                }
+                remove(&dir);
+            }
+            _ => {
+                eprintln!("Unknown command: {}", args[1]);
+                print_help();
+                process::exit(1);
+            }
+        }
+    }
+}
+
+fn print_help() {
+    println!(
+        r#"zoxide - A smarter cd command
+
+USAGE:
+    zoxide <command> [options]
+
+COMMANDS:
+    add <directory>    Add a directory to the database
+    edit <directory>   Edit the database entry for a directory
+    import <file>      Import directories from a file
+    init <shell>       Initialize shell integration
+    query [query]      Query directories
+    remove <directory> Remove a directory from the database
+
+OPTIONS:
+    --cmd <cmd>        Use a different command name
+    --no-cmd           Don't add commands to the database
+    --help, -h         Print this help message
+    --version, -V      Print version information
+
+EXAMPLES:
+    zoxide add /home/user/projects
+    zoxide query home
+    zoxide init bash
+"#
+    );
+}
+
+fn add(dir: &Path) {
+    let db_path = dirs::data_local_dir()
+        .unwrap_or_else(|| PathBuf::from("."))
+        .join("zoxide")
+        .join("db");
+    let db = Database::load(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error loading database: {}", e);
+        process::exit(1);
+    });
+    let score = calculate_score(&db, dir);
+    let mut new_db = db;
+    new_db.add(dir, score);
+    new_db.save(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error saving database: {}", e);
+        process::exit(1);
+    });
+}
+
+fn edit(dir: &Path) {
+    let db_path = dirs::data_local_dir()
+        .unwrap_or_else(|| PathBuf::from("."))
+        .join("zoxide")
+        .join("db");
+    let db = Database::load(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error loading database: {}", e);
+        process::exit(1);
+    });
+    if let Some(entry) = db.entries.get(&dir.to_string_lossy().to_string()) {
+        println!("{}", entry.score);
+    } else {
+        eprintln!("Directory not found in database");
+        process::exit(1);
+    }
+}
+
+fn import(file: &Path) {
+    let db_path = dirs::data_local_dir()
+        .unwrap_or_else(|| PathBuf::from("."))
+        .join("zoxide")
+        .join("db");
+    let db = Database::load(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error loading database: {}", e);
+        process::exit(1);
+    });
+    let content = fs::read_to_string(file).unwrap_or_else(|e| {
+        eprintln!("Error reading file: {}", e);
+        process::exit(1);
+    });
+    for line in content.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        if parts.len() >= 2 {
+            let path_str = parts[0];
+            let score: f64 = parts[1].parse().unwrap_or(0.0);
+            let entry = Entry::new(PathBuf::from(path_str));
+            entry.score = score;
+            db.entries.insert(path_str.to_string(), entry);
+        }
+    }
+    db.save(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error saving database: {}", e);
+        process::exit(1);
+    });
+}
+
+fn query_dirs(query: &str) {
+    let db_path = dirs::data_local_dir()
+        .unwrap_or_else(|| PathBuf::from("."))
+        .join("zoxide")
+        .join("db");
+    let db = Database::load(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error loading database: {}", e);
+        process::exit(1);
+    });
+    let results = db.query(query, None);
+    for (path, score) in results {
+        println!("{} {:.10}", path, score);
+    }
+}
+
+fn remove(dir: &Path) {
+    let db_path = dirs::data_local_dir()
+        .unwrap_or_else(|| PathBuf::from("."))
+        .join("zoxide")
+        .join("db");
+    let mut db = Database::load(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error loading database: {}", e);
+        process::exit(1);
+    });
+    let path_str = dir.to_string_lossy().to_string();
+    if db.entries.remove(&path_str).is_none() {
+        eprintln!("Directory not found in database");
+        process::exit(1);
+    }
+    db.save(&db_path).unwrap_or_else(|e| {
+        eprintln!("Error saving database: {}", e);
+        process::exit(1);
+    });
+}
