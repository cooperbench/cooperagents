+static void set_termios(FILE *fp, int raw_mode) {
+    struct termios oldt, newt;
+    tcgetattr(fileno(fp), &oldt);
+    newt = oldt;
+    if (raw_mode) {
+        newt.c_lflag &= ~(ECHO | ICANON);
+        newt.c_iflag &= ~(BRKINT | ICRNL | INPCK | ISTRIP | IXON);
+        newt.c_oflag &= ~OPOST;
+        newt.c_cflag |= (CS8);
+        newt.c_cc[VMIN] = 0;
+        newt.c_cc[VTIME] = 0;
+    }
+    tcsetattr(fileno(fp), TCSANOW, &newt);
+}
+
+static void restore_termios(FILE *fp) {
+    struct termios oldt;
+    if (tcgetattr(fileno(fp), &oldt) == 0) {
+        tcsetattr(fileno(fp), TCSANOW, &oldt);
+    }
+}
