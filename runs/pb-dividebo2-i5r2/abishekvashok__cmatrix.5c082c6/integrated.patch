index 0000000..0930992
--- /dev/null
+++ b/compile.sh
@@ -0,0 +1,12 @@
+#!/bin/bash
+# Compile script for CMatrix
+# This script compiles the source code and produces ./executable
+
+set -e
+
+cd "$(dirname "$0")"
+
+# Compile cmatrix.c
+gcc -o executable cmatrix.c -Wall -Wextra -O2
+
+echo "Build successful: ./executable"
