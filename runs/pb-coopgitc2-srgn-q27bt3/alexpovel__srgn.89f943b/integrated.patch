+
+use builtin;
+use str;
+
+set edit:completion:arg-completer[srgn] = {|@words|
+    fn spaces {|n|
+        builtin:repeat $n ' ' | str:join ''
+    }
+    fn cand {|text desc|
+        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
+    }
+    var command = 'srgn'
+    for word $words[1..-1] {
+        if (str:has-prefix $word '-') {
+            break
+        }
+        set command = $command';'$word
+    }
+    var completions = [
+        &'srgn'= {
+            cand --completions 'Print shell completions for the given shell.'
+            cand -G 'Glob of files to work on (instead of reading stdin).'
+            cand --glob 'Glob of files to work on (instead of reading stdin).'
