+            [CompletionResult]::new('--gitignored', 'gitignored', [CompletionResultType]::ParameterName, 'Do not ignore `.gitignore`d files and directories.')
+            [CompletionResult]::new('--sorted', 'sorted', [CompletionResultType]::ParameterName, 'Process files in lexicographically sorted order, by file path.')
