+            [CompletionResult]::new('--dry-run', 'dry-run', [CompletionResultType]::ParameterName, 'Do not destructively overwrite files, instead print rich diff only.')
+            [CompletionResult]::new('-i', 'i', [CompletionResultType]::ParameterName, 'Undo the effects of passed actions, where applicable.')
