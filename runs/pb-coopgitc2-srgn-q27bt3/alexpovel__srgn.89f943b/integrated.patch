+            cand --typescript-query-file 'Scope TypeScript code using a custom tree-sitter query from file.'
+            cand -u 'Uppercase anything in scope.'
+            cand --upper 'Uppercase anything in scope.'
+            cand -l 'Lowercase anything in scope.'
+            cand --lower 'Lowercase anything in scope.'
+            cand -t 'Titlecase anything in scope.'
+            cand --titlecase 'Titlecase anything in scope.'
+            cand -n 'Normalize (Normalization Form D) anything in scope, and throw away marks.'
+            cand --normalize 'Normalize (Normalization Form D) anything in scope, and throw away marks.'
+            cand -g 'Perform substitutions on German words, such as ''Abenteuergruesse'' to ''Abenteuergrüße'', for anything in scope.'
+            cand --german 'Perform substitutions on German words, such as ''Abenteuergruesse'' to ''Abenteuergrüße'', for anything in scope.'
+            cand -S 'Perform substitutions on symbols, such as ''!='' to ''≠'', ''->'' to ''→'', on anything in scope.'
+            cand --symbols 'Perform substitutions on symbols, such as ''!='' to ''≠'', ''->'' to ''→'', on anything in scope.'
+            cand -d 'Delete anything in scope.'
+            cand --delete 'Delete anything in scope.'
+            cand -s 'Squeeze consecutive occurrences of scope into one.'
+            cand --squeeze 'Squeeze consecutive occurrences of scope into one.'
+            cand --squeeze-repeats 'Squeeze consecutive occurrences of scope into one.'
+            cand --fail-no-files 'Fail if working on files (e.g. globbing is requested) but none are found.'
+            cand --dry-run 'Do not destructively overwrite files, instead print rich diff only.'
