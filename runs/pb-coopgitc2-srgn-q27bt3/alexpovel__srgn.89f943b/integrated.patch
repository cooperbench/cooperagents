+            cand --go-query-file 'Scope Go code using a custom tree-sitter query from file.'
+            cand --hcl 'Scope HashiCorp Configuration Language code using a prepared query.'
+            cand --hcl-query 'Scope HashiCorp Configuration Language code using a custom tree-sitter query.'
+            cand --hcl-query-file 'Scope HashiCorp Configuration Language code using a custom tree-sitter query from file.'
+            cand --python 'Scope Python code using a prepared query.'
+            cand --py 'Scope Python code using a prepared query.'
+            cand --python-query 'Scope Python code using a custom tree-sitter query.'
+            cand --python-query-file 'Scope Python code using a custom tree-sitter query from file.'
+            cand --rust 'Scope Rust code using a prepared query.'
+            cand --rs 'Scope Rust code using a prepared query.'
+            cand --rust-query 'Scope Rust code using a custom tree-sitter query.'
+            cand --rust-query-file 'Scope Rust code using a custom tree-sitter query from file.'
