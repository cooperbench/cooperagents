+            cand --invert 'Undo the effects of passed actions, where applicable.'
+            cand -L 'Do not interpret the scope as a regex. Instead, interpret it as a literal string. Will require a scope to be passed.'
+            cand --literal-string 'Do not interpret the scope as a regex. Instead, interpret it as a literal string. Will require a scope to be passed.'
+            cand --fail-any 'If anything at all is found to be in scope, fail.'
+            cand --fail-none 'If nothing is found to be in scope, fail.'
+            cand -j 'Join (logical ''OR'') multiple language scopes, instead of intersecting them.'
+            cand --join-language-scopes 'Join (logical ''OR'') multiple language scopes, instead of intersecting them.'
+            cand --line-numbers 'Prepend line numbers to output.'
