+            [CompletionResult]::new('--go', 'go', [CompletionResultType]::ParameterName, 'Scope Go code using a prepared query.')
+            [CompletionResult]::new('--go-query', 'go-query', [CompletionResultType]::ParameterName, 'Scope Go code using a custom tree-sitter query.')
+            [CompletionResult]::new('--go-query-file', 'go-query-file', [CompletionResultType]::ParameterName, 'Scope Go code using a custom tree-sitter query from file.')
+            [CompletionResult]::new('--hcl', 'hcl', [CompletionResultType]::ParameterName, 'Scope HashiCorp Configuration Language code using a prepared query.')
+            [CompletionResult]::new('--hcl-query', 'hcl-query', [CompletionResultType]::ParameterName, 'Scope HashiCorp Configuration Language code using a custom tree-sitter query.')
+            [CompletionResult]::new('--hcl-query-file', 'hcl-query-file', [CompletionResultType]::ParameterName, 'Scope HashiCorp Configuration Language code using a custom tree-sitter query from file.')
+            [CompletionResult]::new('--python', 'python', [CompletionResultType]::ParameterName, 'Scope Python code using a prepared query.')
+            [CompletionResult]::new('--py', 'py', [CompletionResultType]::ParameterName, 'Scope Python code using a prepared query.')
+            [CompletionResult]::new('--python-query', 'python-query', [CompletionResultType]::ParameterName, 'Scope Python code using a custom tree-sitter query.')
+            [CompletionResult]::new('--python-query-file', 'python-query-file', [CompletionResultType]::ParameterName, 'Scope Python code using a custom tree-sitter query from file.')
