+            [CompletionResult]::new('-d', 'd', [CompletionResultType]::ParameterName, 'Delete anything in scope.')
+            [CompletionResult]::new('--delete', 'delete', [CompletionResultType]::ParameterName, 'Delete anything in scope.')
