+    esac
+}
+
+if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
+    complete -F _srgn -o nosort -o bashdefault -o default srgn
+else
+    complete -F _srgn -o bashdefault -o default srgn
+fi
