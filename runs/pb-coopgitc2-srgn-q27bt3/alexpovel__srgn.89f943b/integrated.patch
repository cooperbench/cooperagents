diff --git a/src/main.rs b/src/main.rs
new file mode 100644
index 0000000..f88ba63
--- /dev/null
+++ b/src/main.rs
@@ -0,0 +1,801 @@
+// srgn reimplementation using std + fancy_regex.
+use fancy_regex::Regex;
+use std::collections::BTreeMap;
+use std::io::{self, Read};
+use std::process::exit;
+
+const HELP_FULL: &str = include_str!("help_full.txt");
+const HELP_SHORT: &str = include_str!("help_short.txt");
+const COMP_BASH: &str = include_str!("compl/bash.txt");
+const COMP_ELVISH: &str = include_str!("compl/elvish.txt");
+const COMP_FISH: &str = include_str!("compl/fish.txt");
+const COMP_PS: &str = include_str!("compl/powershell.txt");
+const COMP_ZSH: &str = include_str!("compl/zsh.txt");
+const VERSION: &str = env!("CARGO_PKG_VERSION");
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Action {
+    Upper,
+    Lower,
+    Titlecase,
+    Normalize,
+    German,
+    Symbols,
+    Delete,
+    Squeeze,
+}
+
+#[derive(Default)]
+struct Options {
+    scope: Option<String>,
+    replacement: Option<String>,
+    literal: bool,
+    invert: bool,
+    actions: Vec<Action>,
+    german_naive: bool,
+    german_prefer_original: bool,
+    only_matching: bool,
+    line_numbers: bool,
+    fail_any: bool,
+    fail_none: bool,
+}
+
+fn main() {
+    let raw: Vec<String> = std::env::args().skip(1).collect();
+    let mut o = match parse_args(&raw) {
+        Ok(o) => o,
+        Err(_) => return, // already printed & exited via exit(2) below
+    };
+
+    let mut input = String::new();
+    let _ = io::stdin().read_to_string(&mut input);
+
+    run(&mut o, &input);
+}
+
+// ---------------- parsing ----------------
+fn action_flag(a: &Action) -> String {
+    match a {
+        Action::Upper => "--upper".to_string(),
+        Action::Lower => "--lower".to_string(),
+        Action::Titlecase => "--titlecase".to_string(),
+        Action::Normalize => "--normalize".to_string(),
+        Action::German => "--german".to_string(),
+        Action::Symbols => "--symbols".to_string(),
+        Action::Delete => "--delete".to_string(),
+        Action::Squeeze => "--squeeze".to_string(),
+    }
+}
+
+fn parse_args(args: &[String]) -> Result<Options, ()> {
+    let mut o = Options::default();
+    let mut scope_pos: Vec<String> = Vec::new();
+    let mut repl_pos: Vec<String> = Vec::new();
+    let mut after_dashdash = false;
+    let mut provided: Vec<String> = Vec::new();
+    let mut i = 0;
+
+    while i < args.len() {
+        let a = args[i].clone();
+        i += 1;
+        if after_dashdash {
+            repl_pos.push(a);
+            continue;
+        }
+        if a == "--" {
+            after_dashdash = true;
+            continue;
+        }
+        if a.starts_with("--") {
+            let (name, eqval) = match a.split_once('=') {
+                Some((n, v)) => (n, Some(v.to_string())),
+                None => (a.as_str(), None),
+            };
+            match name {
+                "--version" => {
+                    println!("srgn {}", VERSION);
+                    exit(0);
+                }
+                "--help" => {
+                    print!("{}", HELP_FULL);
+                    exit(0);
+                }
+                "--completions" => {
+                    let mut shell = eqval.clone();
+                    if shell.is_none() && i < args.len() {
+                        shell = Some(args[i].clone());
+                        i += 1;
+                    }
+                    match shell.as_deref() {
+                        Some("bash") => {
+                            print!("{}", COMP_BASH);
+                            exit(0);
+                        }
+                        Some("elvish") => {
+                            print!("{}", COMP_ELVISH);
+                            exit(0);
+                        }
+                        Some("fish") => {
+                            print!("{}", COMP_FISH);
+                            exit(0);
+                        }
+                        Some("powershell") => {
+                            print!("{}", COMP_PS);
+                            exit(0);
+                        }
+                        Some("zsh") => {
+                            print!("{}", COMP_ZSH);
+                            exit(0);
+                        }
+                        Some(other) => {
+                            eprint!("error: invalid value '{}' for '--completions <SHELL>'\n  [possible values: bash, elvish, fish, powershell, zsh]\n\nFor more information, try '--help'.\n", other);
+                            exit(2);
+                        }
+                        None => {
+                            eprint!("error: a value is required for '--completions <SHELL>' but none was supplied\n  [possible values: bash, elvish, fish, powershell, zsh]\n\nFor more information, try '--help'.\n");
+                            exit(2);
+                        }
+                    }
+                }
+                "--upper" => { o.actions.push(Action::Upper); provided.push("--upper".to_string()); }
+                "--lower" => { o.actions.push(Action::Lower); provided.push("--lower".to_string()); }
+                "--titlecase" => { o.actions.push(Action::Titlecase); provided.push("--titlecase".to_string()); }
+                "--normalize" => { o.actions.push(Action::Normalize); provided.push("--normalize".to_string()); }
+                "--german" => { o.actions.push(Action::German); provided.push("--german".to_string()); }
+                "--symbols" => { o.actions.push(Action::Symbols); provided.push("--symbols".to_string()); }
+                "--delete" => { o.actions.push(Action::Delete); provided.push("--delete".to_string()); }
+                "--squeeze" | "--squeeze-repeats" => { o.actions.push(Action::Squeeze); provided.push("--squeeze".to_string()); }
+                "--invert" => { o.invert = true; provided.push("--invert".to_string()); }
+                "--german-naive" => o.german_naive = true,
+                "--german-prefer-original" => o.german_prefer_original = true,
+                "--literal-string" => { o.literal = true; provided.push("--literal-string".to_string()); }
+                "--line-numbers" => o.line_numbers = true,
+                "--only-matching" => o.only_matching = true,
+                "--fail-any" => o.fail_any = true,
+                "--fail-none" => o.fail_none = true,
+                "--dry-run" | "--fail-no-files" | "--hidden" | "--gitignored" | "--sorted" | "--join-language-scopes" | "--verbose" => {}
+                "--stdin-detection" | "--stdout-detection" | "--threads" | "--glob" => {
+                    if eqval.is_none() && i < args.len() {
+                        i += 1;
+                    }
+                }
+                _ => {
+                    if name == "--literal" {
+                        eprint!("error: unexpected argument '--literal' found\n\n  tip: a similar argument exists: '--literal-string'\n  tip: to pass '--literal' as a value, use '-- --literal'\n\nUsage: executable <--glob <GLOB>|--fail-no-files|--dry-run|--invert|--literal-string|--fail-any|--fail-none|--join-language-scopes|--line-numbers|--only-matching|--hidden|--gitignored|--sorted|--stdin-detection <STDIN_DETECTION>|--stdout-detection <STDOUT_DETECTION>|--threads <THREADS>|--verbose...> [SCOPE] [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n");
+                    } else {
+                        let u = if scope_pos.is_empty() { "Usage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]" } else { "Usage: executable <SCOPE> [-- <REPLACEMENT>]" };
+                        eprint!("error: unexpected argument '{}' found\n\n  tip: to pass '{}' as a value, use '-- {}'\n\n{}\n\nFor more information, try '--help'.\n", name, name, name, u);
+                    }
+                    exit(2);
+                }
+            }
+        } else if a.starts_with('-') && a.len() > 1 && !is_numeric_arg(&a) {
+            let chars: Vec<char> = a.chars().collect();
+            let mut k = 1;
+            while k < chars.len() {
+                let c = chars[k];
+                match c {
+                    'V' => { println!("srgn {}", VERSION); exit(0); }
+                    'h' => { print!("{}", HELP_SHORT); exit(0); }
+                    'u' => { o.actions.push(Action::Upper); provided.push("--upper".to_string()); }
+                    'l' => { o.actions.push(Action::Lower); provided.push("--lower".to_string()); }
+                    't' => { o.actions.push(Action::Titlecase); provided.push("--titlecase".to_string()); }
+                    'n' => { o.actions.push(Action::Normalize); provided.push("--normalize".to_string()); }
+                    'g' => { o.actions.push(Action::German); provided.push("--german".to_string()); }
+                    'S' => { o.actions.push(Action::Symbols); provided.push("--symbols".to_string()); }
+                    'd' => { o.actions.push(Action::Delete); provided.push("--delete".to_string()); }
+                    's' => { o.actions.push(Action::Squeeze); provided.push("--squeeze".to_string()); }
+                    'i' => { o.invert = true; provided.push("--invert".to_string()); }
+                    'L' => { o.literal = true; provided.push("--literal-string".to_string()); }
+                    'F' => o.fail_any = true,
+                    'N' => o.fail_none = true,
+                    _ => {
+                        let mut flag = String::from("-");
+                        flag.push(c);
+                        eprint!("error: unexpected argument '{}' found\n\n  tip: to pass '{}' as a value, use '-- {}'\n\nUsage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n", flag, flag, flag);
+                        exit(2);
+                    }
+                }
+                k += 1;
+            }
+        } else {
+            if scope_pos.len() >= 1 {
+                eprint!("error: unexpected argument '{}' found\n\nUsage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n", a);
+                exit(2);
+            }
+            scope_pos.push(a);
+        }
+    }
+
+    // positional rules matching original:
+    //   SCOPE: at most one positional before '--'
+    //   REPLACEMENT: at most one positional after '--'; REPLACE env fallback otherwise
+    if scope_pos.len() > 1 {
+        eprint!("error: unexpected argument '{}' found\n\nUsage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n", scope_pos[1]);
+        exit(2);
+    }
+    if repl_pos.len() > 1 {
+        eprint!("error: the argument '[REPLACEMENT]' cannot be used multiple times\n\nUsage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n");
+        exit(2);
+    }
+    let repl_env = std::env::var("REPLACE").ok();
+    if !scope_pos.is_empty() {
+        o.scope = Some(scope_pos[0].clone());
+    }
+    if !repl_pos.is_empty() {
+        o.replacement = Some(repl_pos[0].clone());
+    } else if o.replacement.is_none() {
+        o.replacement = repl_env;
+    }
+
+    // conflict: --delete with --squeeze
+    if o.actions.contains(&Action::Delete) && o.actions.contains(&Action::Squeeze) {
+        eprint!("error: the argument '--delete' cannot be used with '--squeeze'\n\nUsage: executable --delete <SCOPE> [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n");
+        exit(2);
+    }
+
+    // invert requires --symbols
+    if o.invert && !o.actions.contains(&Action::Symbols) {
+        let mut u = String::from("Usage: executable --symbols");
+        for f in &provided {
+            u.push(' ');
+            u.push_str(f);
+        }
+        u.push_str(" [SCOPE] [-- <REPLACEMENT>]");
+        eprint!("error: the following required arguments were not provided:\n  --symbols\n\n{}\n\nFor more information, try '--help'.\n", u);
+        exit(2);
+    }
+
+    // required scope for --delete / --squeeze
+    let needs_scope = o.actions.contains(&Action::Delete) || o.actions.contains(&Action::Squeeze);
+    if needs_scope && o.scope.is_none() {
+        let mut u = String::from("Usage: executable");
+        for f in &provided {
+            u.push(' ');
+            u.push_str(f);
+        }
+        u.push_str(" <SCOPE> [-- <REPLACEMENT>]");
+        eprint!("error: the following required arguments were not provided:\n  <SCOPE>\n\n{}\n\nFor more information, try '--help'.\n", u);
+        exit(2);
+    }
+
+    // --literal-string requires a scope
+    if o.literal && o.scope.is_none() {
+        eprint!("error: The following required argument was not provided: scope\n\nUsage: srgn [OPTIONS] [SCOPE] [-- <REPLACEMENT>]\n\nFor more information, try '--help'.\n");
+        exit(2);
+    }
+
+    Ok(o)
+}
+
+fn is_numeric_arg(a: &str) -> bool {
+    a.len() > 1 && a[1..].chars().all(|c| c.is_ascii_digit())
+}
+
+// ---------------- actions ----------------
+fn has_action(o: &Options) -> bool {
+    o.replacement.is_some()
+        || o.actions.iter().any(|a| *a != Action::Squeeze)
+}
+
+fn run(o: &Options, input: &str) {
+    // "No actions specified" message is emitted regardless of mode, when no
+    // action (and no replacement) is present.
+    if !has_action(o) {
+        eprint!("{}", timestamped("No actions specified, and not in search mode. Will return input unchanged, if any."));
+    }
+
+    let scope = o.scope.clone().unwrap_or_else(|| ".*".to_string());
+    let pattern = if o.literal { escape_regex(&scope) } else { scope };
+    let rx = match Regex::new(&pattern) {
+        Ok(r) => r,
+        Err(e) => {
+            eprint!("Error: Failed building regex\n\nCaused by:\n    Invalid regex: {}\n", e);
+            exit(1);
+        }
+    };
+
+    let search = o.only_matching || o.line_numbers;
+    let mut has_matches = false;
+    let mut out = String::new();
+
+    if search {
+        // Search mode: process line-by-line, emitting matched text with a
+        // (stdin):[line:]ranges:content prefix for each matching line.
+        let lines: Vec<&str> = input.split_inclusive('\n').collect();
+        let mut line_no = 0usize;
+        for line in &lines {
+            let has_nl = line.ends_with('\n');
+            let content = if has_nl { &line[..line.len() - 1] } else { line };
+            line_no += 1;
+
+            let caps: Vec<fancy_regex::Captures> = rx
+                .captures_iter(content)
+                .filter_map(|c| c.ok())
+                .filter(|c| {
+                    c.get(0)
+                        .map(|m| m.range().start != m.range().end)
+                        .unwrap_or(false)
+                })
+                .collect();
+
+            if caps.is_empty() {
+                continue;
+            }
+            has_matches = true;
+
+            let mut ranges = String::new();
+            let mut content_parts = String::new();
+            for cap in &caps {
+                let r = cap.get(0).unwrap().range();
+                if !ranges.is_empty() {
+                    ranges.push(';');
+                }
+                ranges.push_str(&format!("{}-{}", r.start, r.end));
+                let matched = &content[r.start..r.end];
+                let mut t = matched.to_string();
+                if let Some(repl) = &o.replacement {
+                    match apply_replacement(repl, cap) {
+                        Ok(r) => t = r,
+                        Err(e) => {
+                            eprint!("{}", e);
+                            exit(1);
+                        }
+                    }
+                }
+                t = apply_actions(&t, o);
+                content_parts.push_str(&t);
+            }
+
+            out.push_str("(stdin):");
+            if o.line_numbers {
+                out.push_str(&format!("{}:", line_no));
+            }
+            out.push_str(&ranges);
+            out.push(':');
+            out.push_str(&content_parts);
+            if has_nl {
+                out.push('\n');
+            }
+        }
+    } else {
+        // Normal mode: apply actions/replacement to matches over the whole
+        // input, preserving the non-matching parts (gaps).
+        let mut prev: usize = 0;
+        let squeeze = o.actions.contains(&Action::Squeeze);
+        let mut prev_match_end: Option<usize> = None;
+        let mut first = true;
+
+        let caps: Vec<fancy_regex::Captures> = rx
+            .captures_iter(input)
+            .filter_map(|c| c.ok())
+            .filter(|c| {
+                c.get(0)
+                    .map(|m| m.range().start != m.range().end)
+                    .unwrap_or(false)
+            })
+            .collect();
+
+        for cap in &caps {
+            let r = cap.get(0).unwrap().range();
+            has_matches = true;
+            if squeeze && !first && prev_match_end == Some(r.start) {
+                prev = r.end;
+                prev_match_end = Some(r.end);
+                continue;
+            }
+            first = false;
+            out.push_str(&input[prev..r.start]);
+            let matched = &input[r.start..r.end];
+            let mut content = matched.to_string();
+            if let Some(repl) = &o.replacement {
+                match apply_replacement(repl, cap) {
+                    Ok(r) => content = r,
+                    Err(e) => {
+                        eprint!("{}", e);
+                        exit(1);
+                    }
+                }
+            }
+            content = apply_actions(&content, o);
+            out.push_str(&content);
+            prev = r.end;
+            prev_match_end = Some(r.end);
+        }
+
+        out.push_str(&input[prev..]);
+    }
+
+    // The fail checks decide whether to emit the (possibly transformed)
+    // output at all: when they trigger, only the error is printed and the
+    // program exits without writing the output.
+    if o.fail_any && has_matches {
+        eprint!("Error: Error applying: Some input was in scope\n");
+        exit(1);
+    }
+    if o.fail_none && !has_matches {
+        eprint!("Error: Error applying: No input was in scope\n");
+        exit(1);
+    }
+
+    print!("{}", out);
+}
+
+fn apply_actions(s: &str, o: &Options) -> String {
+    let mut out = s.to_string();
+    for a in &o.actions {
+        out = apply_one(&out, *a, o);
+    }
+    out
+}
+
+fn apply_one(s: &str, a: Action, o: &Options) -> String {
+    match a {
+        Action::Upper => s.to_uppercase(),
+        Action::Lower => s.to_lowercase(),
+        Action::Titlecase => titlecase(s),
+        Action::Normalize => normalize(s),
+        Action::German => {
+            if o.german_naive {
+                german_naive(s)
+            } else {
+                s.to_string()
+            }
+        }
+        Action::Symbols => symbols(s, o.invert),
+        Action::Delete => String::new(),
+        Action::Squeeze => s.to_string(),
+    }
+}
+
+// ---------- titlecase ----------
+fn titlecase(s: &str) -> String {
+    let mut out = String::new();
+    let chars: Vec<char> = s.chars().collect();
+    let mut i = 0;
+    while i < chars.len() {
+        if chars[i].is_alphanumeric() {
+            let start = i;
+            while i < chars.len() && chars[i].is_alphanumeric() {
+                i += 1;
+            }
+            let run = &chars[start..i];
+            let has_upper = run.iter().any(|c| c.is_alphabetic() && c.is_uppercase());
+            let has_lower = run.iter().any(|c| c.is_alphabetic() && c.is_lowercase());
+            if has_upper && has_lower {
+                for c in run {
+                    out.push(*c);
+                }
+            } else {
+                let mut first_letter = false;
+                for c in run {
+                    if c.is_alphabetic() {
+                        if !first_letter {
+                            for c2 in c.to_uppercase() {
+                                out.push(c2);
+                            }
+                            first_letter = true;
+                        } else {
+                            for c2 in c.to_lowercase() {
+                                out.push(c2);
+                            }
+                        }
+                    } else {
+                        out.push(*c);
+                    }
+                }
+            }
+        } else {
+            out.push(chars[i]);
+            i += 1;
+        }
+    }
+    out
+}
+
+// ---------- normalize ----------
+fn normalize(s: &str) -> String {
+    let mut out = String::new();
+    for c in s.chars() {
+        match base_of(c) {
+            Some(b) => out.push(b),
+            None => out.push(c),
+        }
+    }
+    out
+}
+
+fn base_of(c: char) -> Option<char> {
+    let b = match c {
+        'à' | 'á' | 'â' | 'ã' | 'ä' | 'å' => 'a',
+        'À' | 'Á' | 'Â' | 'Ã' | 'Ä' | 'Å' => 'A',
+        'æ' => 'a',
+        'Æ' => 'A',
+        'ç' | 'Ç' => 'c',
+        'ð' | 'Ð' => 'd',
+        'é' | 'ê' | 'ë' | 'è' => 'e',
+        'É' | 'Ê' | 'Ë' | 'È' => 'E',
+        'ì' | 'í' | 'î' | 'ï' => 'i',
+        'Ì' | 'Í' | 'Î' | 'Ï' => 'I',
+        'ñ' | 'Ñ' => 'n',
+        'ò' | 'ó' | 'ô' | 'õ' | 'ö' | 'ø' => 'o',
+        'Ò' | 'Ó' | 'Ô' | 'Õ' | 'Ö' | 'Ø' => 'O',
+        'ú' | 'û' | 'ù' | 'ü' => 'u',
+        'Ú' | 'Û' | 'Ù' | 'Ü' => 'U',
+        'ý' | 'Ý' => 'y',
+        'ß' => 's',
+        'þ' | 'Þ' => 't',
+        _ => return None,
+    };
+    Some(b)
+}
+
+// ---------- german ----------
+fn german_naive(s: &str) -> String {
+    let map = german_map();
+    apply_word_map(s, &map)
+}
+
+fn german_map() -> BTreeMap<String, String> {
+    let mut m = BTreeMap::new();
+    m.insert("ae".to_string(), "\u{00E4}".to_string());
+    m.insert("Ae".to_string(), "\u{00C4}".to_string());
+    m.insert("oe".to_string(), "\u{00F6}".to_string());
+    m.insert("Oe".to_string(), "\u{00D6}".to_string());
+    m.insert("ue".to_string(), "\u{00FC}".to_string());
+    m.insert("Ue".to_string(), "\u{00DC}".to_string());
+    m.insert("ss".to_string(), "\u{00DF}".to_string());
+    m.insert("SS".to_string(), "\u{1E9E}".to_string());
+    m
+}
+
+fn apply_word_map(s: &str, map: &BTreeMap<String, String>) -> String {
+    let mut out = String::new();
+    let chars: Vec<char> = s.chars().collect();
+    let mut i = 0;
+    while i < chars.len() {
+        let mut matched = false;
+        for len in 2..=3 {
+            if i + len <= chars.len() {
+                let sub: String = chars[i..i + len].iter().collect();
+                if let Some(repl) = map.get(&sub) {
+                    out.push_str(repl);
+                    i += len;
+                    matched = true;
+                    break;
+                }
+            }
+        }
+        if !matched {
+            out.push(chars[i]);
+            i += 1;
+        }
+    }
+    out
+}
+
+// ---------- symbols ----------
+fn symbols(s: &str, invert: bool) -> String {
+    let map = symbol_map();
+    let mut out = String::new();
+    let chars: Vec<char> = s.chars().collect();
+    let mut i = 0;
+    while i < chars.len() {
+        let mut done = false;
+        for len in 3..=1usize {
+            if i + len <= chars.len() {
+                let sub: String = chars[i..i + len].iter().collect();
+                let hit = if !invert {
+                    map.get(&sub).map(|v| v.clone())
+                } else {
+                    // reverse: find key whose value == sub
+                    map.iter()
+                        .find(|(_, v)| **v == sub)
+                        .map(|(k, _)| k.clone())
+                };
+                if let Some(val) = hit {
+                    out.push_str(&val);
+                    i += len;
+                    done = true;
+                    break;
+                }
+            }
+        }
+        if !done {
+            out.push(chars[i]);
+            i += 1;
+        }
+    }
+    out
+}
+
+fn symbol_map() -> BTreeMap<String, String> {
+    let mut m = BTreeMap::new();
+    m.insert("!=".to_string(), "\u{2260}".to_string());
+    m.insert("->".to_string(), "\u{2192}".to_string());
+    m.insert("<-".to_string(), "\u{2190}".to_string());
+    m.insert(">=".to_string(), "\u{2265}".to_string());
+    m.insert("<=".to_string(), "\u{2264}".to_string());
+    m.insert("<->".to_string(), "\u{2194}".to_string());
+    m
+}
+
+// ---------- replacement ----------
+fn apply_replacement(repl: &str, cap: &fancy_regex::Captures<'_>) -> Result<String, String> {
+    let chars: Vec<char> = repl.chars().collect();
+    let mut out = String::new();
+    let mut i = 0;
+    while i < chars.len() {
+        let c = chars[i];
+        if c == '$' {
+            if i + 1 < chars.len() && chars[i + 1] == '$' {
+                out.push('$');
+                i += 2;
+                continue;
+            }
+            if i + 1 < chars.len() && chars[i + 1] == '{' {
+                let mut j = i + 2;
+                let mut name = String::new();
+                while j < chars.len() && chars[j] != '}' {
+                    name.push(chars[j]);
+                    j += 1;
+                }
+                if j >= chars.len() {
+                    out.push('$');
+                    i += 1;
+                    continue;
+                }
+                let val = if let Ok(n) = name.parse::<usize>() {
+                    cap.get(n).map(|m| m.as_str().to_string())
+                } else {
+                    cap.name(&name).map(|m| m.as_str().to_string())
+                };
+                match val {
+                    Some(v) => out.push_str(&v),
+                    None => return Err(apply_err(&name)),
+                }
+                i = j + 1;
+                continue;
+            }
+            if i + 1 < chars.len() {
+                let next = chars[i + 1];
+                if next.is_ascii_digit() {
+                    let mut j = i + 1;
+                    let mut num = String::new();
+                    while j < chars.len() && chars[j].is_ascii_digit() {
+                        num.push(chars[j]);
+                        j += 1;
+                    }
+                    if let Some(m) = cap.get(num.parse::<usize>().unwrap_or(0)) {
+                        out.push_str(m.as_str());
+                        i = j;
+                        continue;
+                    }
+                    return Err(apply_err(&num));
+                } else if next.is_alphabetic() {
+                    let mut j = i + 1;
+                    let mut name = String::new();
+                    while j < chars.len()
+                        && (chars[j].is_alphanumeric() || chars[j] == '_')
+                    {
+                        name.push(chars[j]);
+                        j += 1;
+                    }
+                    if let Some(m) = cap.name(&name) {
+                        out.push_str(m.as_str());
+                        i = j;
+                        continue;
+                    }
+                    return Err(apply_err(&name));
+                }
+            }
+            out.push('$');
+            i += 1;
+            continue;
+        }
+        if c == '\\' {
+            if i + 1 >= chars.len() {
+                return Err(build_repl_error(repl));
+            }
+            let e = chars[i + 1];
+            let v = match e {
+                'n' => Some('\n'),
+                't' => Some('\t'),
+                'r' => Some('\r'),
+                'a' => Some('\u{07}'),
+                'b' => Some('\u{08}'),
+                'f' => Some('\u{0C}'),
+                'v' => Some('\u{0B}'),
+                'e' => Some('\u{1B}'),
+                '\\' => Some('\\'),
+                _ => None,
+            };
+            if let Some(v) = v {
+                out.push(v);
+                i += 2;
+                continue;
+            }
+            if e.is_ascii_digit() && (e as u8) <= b'7' {
+                let mut j = i + 1;
+                let mut digits = String::new();
+                while j < chars.len()
+                    && (chars[j].is_ascii_digit() && (chars[j] as u8) <= b'7')
+                    && digits.len() < 3
+                {
+                    digits.push(chars[j]);
+                    j += 1;
+                }
+                let val = u32::from_str_radix(&digits, 8).unwrap_or(0) as u8;
+                out.push(char::from_u32(val as u32).unwrap_or('?'));
+                i = j;
+                continue;
+            }
+            return Err(build_repl_error(repl));
+        }
+        out.push(c);
+        i += 1;
+    }
+    Ok(out)
+}
+
+fn apply_err(name: &str) -> String {
+    format!(
+        "Error: Error applying: Error in an action: Action failed in replacement: Error in variable expressions: Undefined variable, unable to substitute: '{}'\n",
+        name
+    )
+}
+
+fn build_repl_error(repl: &str) -> String {
+    format!(
+        "Error: Failed building replacement string\n\nCaused by:\n    Contains invalid escape sequences: '{}'\n",
+        repl
+    )
+}
+
+// ---------- timestamp ----------
+fn timestamped(msg: &str) -> String {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default();
+    let secs = now.as_secs();
+    let micros = now.subsec_micros();
+    let (y, mo, d, h, mi, s) = to_rfc3339_parts(secs);
+    format!(
+        "[{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:06}Z ERROR srgn] {}\n",
+        y, mo, d, h, mi, s, micros, msg
+    )
+}
+
+fn to_rfc3339_parts(secs: u64) -> (u64, u64, u64, u64, u64, u64) {
+    // days since civil epoch (1970-01-01) as i64; 719468 days from 0000-03-01
+    let mut days = (secs / 86400) as i64 + 719468;
+    let rem = secs % 86400;
+    let h = (rem / 3600) as u64;
+    let mi = ((rem % 3600) / 60) as u64;
+    let s = (rem % 60) as u64;
+    // Howard Hinnant's civil_from_days, all i64
+    let z = if days >= 0 { days } else { days - 1 };
+    let era = z / 146097;
+    let doe = z - era * 146097;
+    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100 + yoe / 400);
+    let mp = (5 * doy + 2) / 153;
+    let d = (doy - (153 * mp / 5 - 2)) as u64;
+    let mo = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = (yoe + era * 400) as u64;
+    (y, mo as u64, d, h, mi, s)
+}
+
+// ---------- escape regex ----------
+fn escape_regex(s: &str) -> String {
+    let mut out = String::new();
+    for c in s.chars() {
+        if c.is_ascii_alphanumeric() {
+            out.push(c);
+        } else {
+            out.push('\\');
+            out.push(c);
+        }
+    }
+    out
+}
