+
+using namespace System.Management.Automation
+using namespace System.Management.Automation.Language
+
+Register-ArgumentCompleter -Native -CommandName 'srgn' -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition)
+
+    $commandElements = $commandAst.CommandElements
+    $command = @(
+        'srgn'
+        for ($i = 1; $i -lt $commandElements.Count; $i++) {
+            $element = $commandElements[$i]
+            if ($element -isnot [StringConstantExpressionAst] -or
+                $element.StringConstantType -ne [StringConstantType]::BareWord -or
+                $element.Value.StartsWith('-') -or
+                $element.Value -eq $wordToComplete) {
+                break
+        }
+        $element.Value
+    }) -join ';'
+
+    $completions = @(switch ($command) {
+        'srgn' {
+            [CompletionResult]::new('--completions', 'completions', [CompletionResultType]::ParameterName, 'Print shell completions for the given shell.')
+            [CompletionResult]::new('-G', 'G ', [CompletionResultType]::ParameterName, 'Glob of files to work on (instead of reading stdin).')
+            [CompletionResult]::new('--glob', 'glob', [CompletionResultType]::ParameterName, 'Glob of files to work on (instead of reading stdin).')
+            [CompletionResult]::new('--stdin-detection', 'stdin-detection', [CompletionResultType]::ParameterName, 'Control heuristics for stdin readability detection, and force to value.')
+            [CompletionResult]::new('--stdout-detection', 'stdout-detection', [CompletionResultType]::ParameterName, 'Control heuristics for stdout detection, and potentially force to value.')
+            [CompletionResult]::new('--threads', 'threads', [CompletionResultType]::ParameterName, 'Number of threads to run processing on, when working with files.')
+            [CompletionResult]::new('--c', 'c', [CompletionResultType]::ParameterName, 'Scope C code using a prepared query.')
+            [CompletionResult]::new('--c-query', 'c-query', [CompletionResultType]::ParameterName, 'Scope C code using a custom tree-sitter query.')
+            [CompletionResult]::new('--c-query-file', 'c-query-file', [CompletionResultType]::ParameterName, 'Scope C code using a custom tree-sitter query from file.')
+            [CompletionResult]::new('--csharp', 'csharp', [CompletionResultType]::ParameterName, 'Scope C# code using a prepared query.')
+            [CompletionResult]::new('--cs', 'cs', [CompletionResultType]::ParameterName, 'Scope C# code using a prepared query.')
+            [CompletionResult]::new('--csharp-query', 'csharp-query', [CompletionResultType]::ParameterName, 'Scope C# code using a custom tree-sitter query.')
