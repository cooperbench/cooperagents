+static Database *db_create(void) {
+    Database *db = malloc(sizeof(Database));
+    db->entries = NULL;
+    db->count = 0;
+    db->capacity = 0;
+    return db;
+}
+
+static void db_free(Database *db) {
+    if (db) {
+        for (int i = 0; i < db->count; i++) {
+            free(db->entries[i].path);
+        }
+        free(db->entries);
+        free(db);
+    }
+}
+
+static int db_add(Database *db, const char *path, long score, long last_access) {
+    if (db->count >= db->capacity) {
+        int new_capacity = db->capacity == 0 ? 100 : db->capacity * 2;
+        Entry *new_entries = realloc(db->entries, new_capacity * sizeof(Entry));
+        if (!new_entries) return -1;
+        db->entries = new_entries;
+        db->capacity = new_capacity;
+    }
+    
+    db->entries[db->count].path = strdup(path);
+    db->entries[db->count].score = score;
+    db->entries[db->count].last_access = last_access;
+    db->count++;
+    return 0;
+}
+
+static int db_load(Database *db, const char *db_path) {
+    FILE *f = fopen(db_path, "r");
+    if (!f) {
+        // Create empty database if file doesn't exist
+        return 0;
+    }
+    
+    char line[1024];
+    while (fgets(line, sizeof(line), f)) {
+        char *path = line;
+        char *score_str = strchr(line, ' ');
+        if (!score_str) continue;
+        *score_str = '\0';
+        score_str++;
+        
+        char *last_access_str = strchr(score_str, ' ');
+        if (!last_access_str) continue;
+        *last_access_str = '\0';
+        
+        long score = atol(score_str);
+        long last_access = atol(last_access_str + 1);
+        
+        db_add(db, path, score, last_access);
+    }
+    
+    fclose(f);
+    return 0;
+}
+
+static int db_save(Database *db, const char *db_path) {
+    FILE *f = fopen(db_path, "w");
+    if (!f) return -1;
+    
+    for (int i = 0; i < db->count; i++) {
+        fprintf(f, "%s %ld %ld\n", 
+                db->entries[i].path,
+                db->entries[i].score,
+                db->entries[i].last_access);
+    }
+    
+    fclose(f);
+    return 0;
+}
