+    }
+    
+    const char *path = db->entries[idx].path;
+    printf("%s\n", path);
+    
+    db_free(db);
+    return 0;
+}
+
+static int cmd_remove(const char *path) {
+    char *norm_path = normalize_path(path);
+    if (!norm_path) {
+        fprintf(stderr, "Error: Cannot resolve path\n");
+        return 1;
+    }
+    
+    char *data_dir = get_data_dir();
+    char db_path[PATH_MAX];
+    snprintf(db_path, sizeof(db_path), "%s/db", data_dir);
+    
+    Database *db = db_create();
+    if (db_load(db, db_path) != 0) {
+        db_free(db);
+        fprintf(stderr, "Error: Cannot open database\n");
+        free(norm_path);
+        return 1;
+    }
+    
+    int found = 0;
+    int new_count = 0;
+    for (int i = 0; i < db->count; i++) {
+        if (strcmp(db->entries[i].path, norm_path) == 0) {
+            found = 1;
+        } else {
+            db->entries[new_count++] = db->entries[i];
+        }
+    }
+    
+    if (!found) {
+        db_free(db);
+        free(norm_path);
+        fprintf(stderr, "Error: Directory not found in database\n");
+        return 1;
+    }
+    
+    db->count = new_count;
+    db->entries = realloc(db->entries, new_count * sizeof(Entry));
+    
+    if (db_save(db, db_path) != 0) {
+        db_free(db);
+        free(norm_path);
+        fprintf(stderr, "Error: Cannot save database\n");
+        return 1;
+    }
+    
+    db_free(db);
+    free(norm_path);
+    return 0;
+}
+
+static int cmd_init(const char *shell) {
+    if (!shell) {
+        fprintf(stderr, "Error: Shell type required\n");
+        return 1;
+    }
+    
+    if (strcmp(shell, "bash") == 0) {
+        printf("eval \"$(zoxide init bash)\"\n");
+    } else if (strcmp(shell, "zsh") == 0) {
+        printf("eval \"$(zoxide init zsh)\"\n");
+    } else if (strcmp(shell, "fish") == 0) {
+        printf("zoxide init fish | source\n");
+    } else if (strcmp(shell, "posix") == 0) {
+        printf("eval \"$(zoxide init posix --hook prompt)\"\n");
+    } else {
+        fprintf(stderr, "Error: Unknown shell: %s\n", shell);
+        return 1;
+    }
+    
+    return 0;
+}
+
+static int cmd_import(const char *from, const char *path) {
+    if (!from || !path) {
+        fprintf(stderr, "Error: --from=<app> and <path> required\n");
+        return 1;
+    }
+    
+    char *data_dir = get_data_dir();
+    char db_path[PATH_MAX];
+    snprintf(db_path, sizeof(db_path), "%s/db", data_dir);
+    
+    Database *db = db_create();
+    if (db_load(db, db_path) != 0) {
+        db_free(db);
+        fprintf(stderr, "Error: Cannot open database\n");
+        return 1;
+    }
+    
+    // Simple import - just add the path
+    long now = time(NULL);
+    long score = compute_score(path, now);
+    
+    if (db_add(db, path, score, now) != 0) {
+        db_free(db);
+        fprintf(stderr, "Error: Cannot add to database\n");
+        return 1;
+    }
+    
+    if (db_save(db, db_path) != 0) {
+        db_free(db);
+        fprintf(stderr, "Error: Cannot save database\n");
+        return 1;
+    }
+    
+    db_free(db);
+    return 0;
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) {
+        print_usage(argv[0]);
+        return 1;
+    }
+    
+    const char *cmd = argv[1];
+    
+    if (strcmp(cmd, "--help") == 0) {
+        print_usage(argv[0]);
+        return 0;
+    }
+    
+    if (strcmp(cmd, "--version") == 0) {
+        print_version();
+        return 0;
+    }
+    
+    if (strcmp(cmd, "add") == 0) {
+        if (argc < 3) {
+            fprintf(stderr, "Error: Path required\n");
+            return 1;
+        }
+        return cmd_add(argv[2]);
+    }
+    
+    if (strcmp(cmd, "query") == 0) {
+        if (argc < 3) {
+            fprintf(stderr, "Error: Query required\n");
+            return 1;
+        }
+        return cmd_query(argv[2]);
+    }
+    
+    if (strcmp(cmd, "remove") == 0) {
+        if (argc < 3) {
+            fprintf(stderr, "Error: Path required\n");
+            return 1;
+        }
+        return cmd_remove(argv[2]);
+    }
+    
+    if (strcmp(cmd, "init") == 0) {
+        if (argc < 3) {
+            fprintf(stderr, "Error: Shell type required\n");
+            return 1;
+        }
+        return cmd_init(argv[2]);
+    }
+    
+    if (strcmp(cmd, "import") == 0) {
+        if (argc < 4) {
+            fprintf(stderr, "Error: --from=<app> and <path> required\n");
+            return 1;
+        }
+        return cmd_import(argv[2], argv[3]);
+    }
+    
+    fprintf(stderr, "Error: Unknown command: %s\n", cmd);
+    print_usage(argv[0]);
+    return 1;
+}
