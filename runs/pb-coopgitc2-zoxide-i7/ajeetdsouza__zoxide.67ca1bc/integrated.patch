+static long compute_score(const char *path, long last_access) {
+    struct stat st;
+    if (stat(path, &st) != 0) return 0;
+    
+    long now = time(NULL);
+    long age = now - last_access;
+    
+    // Score based on recency and frequency
+    long score = (long)(1000000000000000.0 / (age + 1));
+    return score;
+}
