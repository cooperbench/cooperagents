+                println!("alias __zoxide_z 'if ( -d \"$1\" ) then cd \"$1\" fi'");
+                println!("alias __zoxide_zi 'set dir=`(fzf --preview \\\"zoxide query -s --all --base-dir {{}} --exclude {{}} {{}}\\\" 2>/dev/null)\"; if ( -n \"$dir\" ) then cd \"$dir\" fi'");
+            } else {
+                println!("eval \"$(zoxide init tcsh --no-cmd)\"");
+            }
+        }
+        "xonsh" => {
+            if no_cmd {
+                println!("def __zoxide_z(dir):");
+                println!("    if dir and os.path.isdir(dir):");
+                println!("        os.chdir(dir)");
+                println!();
+                println!("def __zoxide_zi():");
+                println!("    dir = (fzf --preview 'zoxide query -s --all --base-dir {{}} --exclude {{}} {{}}' 2>/dev/null)");
+                println!("    if dir and os.path.isdir(dir):");
+                println!("        os.chdir(dir)");
+            } else {
+                println!("eval \"$(zoxide init xonsh --no-cmd)\"");
+            }
+        }
+        _ => {
+            eprintln!("error: unknown shell: {}", shell);
+            process::exit(1);
+        }
+    }
+}
+
+fn run_query(args: &[String]) {
+    let mut all = false;
+    let mut interactive = false;
+    let mut list = false;
+    let mut show_score = false;
+    let mut exclude_current = false;
+    let mut base_dir: Option<String> = None;
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--all" || args[i] == "-a" {
+            all = true;
+            i += 1;
+        } else if args[i] == "--interactive" || args[i] == "-i" {
+            interactive = true;
+            i += 1;
+        } else if args[i] == "--list" || args[i] == "-l" {
+            list = true;
+            i += 1;
+        } else if args[i] == "--score" || args[i] == "-s" {
+            show_score = true;
+            i += 1;
+        } else if args[i] == "--exclude" {
+            if i + 1 < args.len() {
+                exclude_current = true;
+                i += 2;
+            } else {
+                eprintln!("error: --exclude requires a value");
+                process::exit(1);
+            }
+        } else if args[i] == "--base-dir" {
+            if i + 1 < args.len() {
+                base_dir = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: --base-dir requires a value");
+                process::exit(1);
+            }
+        } else if !args[i].starts_with('-') {
+            break;
+        } else {
+            i += 1;
+        }
+    }
+    
+    let db = load_db();
+    
+    if interactive {
+        let fzf_opts = env::var("_ZO_FZF_OPTS").unwrap_or_default();
+        let base = base_dir.as_deref().unwrap_or("");
+        let exclude = if exclude_current {
+            format!(" --exclude {}", env::current_dir().unwrap().display())
+        } else {
+            String::new()
+        };
+        
+        let query = if args.len() > i {
+            args[i..].join(" ")
+        } else {
+            String::new()
+        };
+        
+        let preview = format!("zoxide query -s --all --base-dir {}{} {}", base, exclude, query);
+        let fzf_cmd = format!("fzf --preview '{}' {}", preview, fzf_opts);
+        
+        let output = std::process::Command::new("bash")
+            .arg("-c")
+            .arg(&fzf_cmd)
+            .output();
+        
+        if let Ok(out) = output {
+            let result = String::from_utf8_lossy(&out.stdout);
+            if !result.trim().is_empty() {
+                let dir = result.trim();
+                if Path::new(dir).exists() {
+                    println!("{}", dir);
+                    std::process::exit(0);
+                }
+            }
+        }
+        
+        process::exit(0);
+    }
+    
+    let mut results: Vec<(String, f64)> = db.iter()
+        .filter(|(path, _)| {
+            if all {
+                true
+            } else {
+                let path_lower = path.to_lowercase();
+                let query_lower: String = args.iter()
+                    .filter(|s| !s.starts_with('-'))
+                    .map(|s| s.as_str())
+                    .collect::<Vec<_>>()
+                    .join(" ")
+                    .to_lowercase();
+                !query_lower.is_empty() && path_lower.contains(&query_lower)
+            }
+        })
+        .map(|(path, entry)| (path.clone(), entry.score))
+        .collect();
+    
+    if !results.is_empty() {
+        results.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+    }
+    
+    if list {
+        for (path, _score) in results {
+            println!("{}", path);
+        }
+    } else {
+        for (path, _score) in results {
+            if show_score {
+                println!("  {:.1} {}", _score, path);
+            } else {
+                println!("{}", path);
+            }
+        }
+    }
+}
+
+fn run_remove(args: &[String]) {
+    let paths: Vec<String> = args.iter().map(|s| s.to_string()).collect();
+    
+    let db = load_db();
+    let mut entries = db;
+    
+    for path in &paths {
+        let path = path.trim();
+        if path.is_empty() {
+            continue;
+        }
+        
+        if entries.contains_key(path) {
+            entries.remove(path);
+        }
+    }
+    
+    if !entries.is_empty() {
+        save_db(&entries);
+    }
+}
