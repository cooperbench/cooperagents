+use std::collections::HashMap;
+use std::env;
+use std::fs::{self, File};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process;
+
+const VERSION: &str = "0.9.9";
+const DEFAULT_MAXAGE: u64 = 10000;
+
+#[derive(Debug, Clone)]
+struct Entry {
+    path: String,
+    score: f64,
+    age: u64,
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("zoxide {}", VERSION);
+        process::exit(0);
+    }
+    
+    let command = if args.len() > 1 {
+        &args[1]
+    } else {
+        print_help();
+        process::exit(0);
+    };
+    
+    match command.as_str() {
+        "add" => run_add(&args[2..]),
+        "edit" => run_edit(),
+        "import" => run_import(&args[2..]),
+        "init" => run_init(&args[2..]),
+        "query" => run_query(&args[2..]),
+        "remove" => run_remove(&args[2..]),
+        _ => {
+            print_help();
+            process::exit(1);
+        }
+    }
+}
+
+fn print_help() {
+    println!("zoxide {}", VERSION);
+    println!("Ajeet D'Souza <98ajeet@gmail.com>");
+    println!("https://github.com/ajeetdsouza/zoxide");
+    println!();
+    println!("A smarter cd command for your terminal");
+    println!();
+    println!("Usage:");
+    println!("  executable <COMMAND>");
+    println!();
+    println!("Commands:");
+    println!("  add     Add a new directory or increment its rank");
+    println!("  edit    Edit the database");
+    println!("  import  Import entries from another application");
+    println!("  init    Generate shell configuration");
+    println!("  query   Search for a directory in the database");
+    println!("  remove  Remove a directory from the database");
+    println!();
+    println!("Options:");
+    println!("  -h, --help     Print help");
+    println!("  -V, --version  Print version");
+    println!();
+    println!("Environment variables:");
+    println!("  _ZO_DATA_DIR          Path for zoxide data files");
+    println!("  _ZO_ECHO              Print the matched directory before navigating to it when set to 1");
+    println!("  _ZO_EXCLUDE_DIRS      List of directory globs to be excluded");
+    println!("  _ZO_FZF_OPTS          Custom flags to pass to fzf");
+    println!("  _ZO_MAXAGE           Maximum total age after which entries start getting deleted");
+    println!("  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths");
+}
+
+fn get_data_dir() -> PathBuf {
+    if let Ok(dir) = env::var("_ZO_DATA_DIR") {
+        return PathBuf::from(dir);
+    }
+    
+    #[cfg(target_os = "macos")]
+    {
+        if let Ok(dir) = env::var("HOME") {
+            return PathBuf::from(format!("{}/Library/Application Support/zoxide", dir));
+        }
+    }
+    
+    #[cfg(target_os = "windows")]
+    {
+        if let Ok(dir) = env::var("LOCALAPPDATA") {
+            return PathBuf::from(format!("{}/zoxide", dir));
+        }
+    }
+    
+    #[cfg(target_os = "linux")]
+    {
+        if let Ok(home) = env::var("HOME") {
+            return PathBuf::from(format!("{}/.local/share/zoxide", home));
+        }
+    }
+    
+    PathBuf::from("/tmp/zoxide")
+}
+
+fn get_db_path() -> PathBuf {
+    get_data_dir().join("db.zoxide")
+}
+
+fn get_excluded_dirs() -> Vec<String> {
+    if let Ok(exclude) = env::var("_ZO_EXCLUDE_DIRS") {
+        let sep = if cfg!(target_os = "windows") { ";" } else { ":" };
+        return exclude.split(sep).map(|s| s.to_string()).collect();
+    }
+    vec!["$HOME".to_string()]
+}
+
+fn is_excluded(path: &str, excluded: &[String]) -> bool {
+    let path = Path::new(path);
+    let path_str = path.to_string_lossy();
+    
+    for exclude in excluded {
+        if path_str.starts_with(exclude) {
+            return true;
+        }
+    }
+    false
+}
+
+fn load_db() -> HashMap<String, Entry> {
+    let db_path = get_db_path();
+    if !db_path.exists() {
+        return HashMap::new();
+    }
+    
+    let file = File::open(&db_path).unwrap_or_else(|_| {
+        fs::write(&db_path, "{}").unwrap();
+        File::create(&db_path).unwrap()
+    });
+    
+    let reader = BufReader::new(file);
+    let mut entries = HashMap::new();
+    
+    for line in reader.lines() {
+        let line = line.unwrap_or_default();
+        if line.is_empty() {
+            continue;
+        }
+        
+        let parts: Vec<&str> = line.splitn(3, ',').collect();
+        if parts.len() >= 3 {
+            let path = parts[0].trim();
+            let score: f64 = parts[1].trim().parse().unwrap_or(0.0);
+            let age: u64 = parts[2].trim().parse().unwrap_or(0);
+            entries.insert(path.to_string(), Entry { path: path.to_string(), score, age });
+        }
+    }
+    
+    entries
+}
+
+fn save_db(entries: &HashMap<String, Entry>) {
+    let db_path = get_db_path();
+    let parent = db_path.parent().unwrap_or(Path::new("."));
+    fs::create_dir_all(parent).ok();
+    
+    let mut file = File::create(&db_path).unwrap();
+    for (_path, entry) in entries {
+        writeln!(file, "{},{},{:.1}", entry.path, entry.score, entry.age).ok();
+    }
+}
+
+fn apply_aging(entries: &mut HashMap<String, Entry>, maxage: u64) {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs();
+    
+    let mut total_age: f64 = 0.0;
+    let mut to_remove: Vec<String> = Vec::new();
+    
+    for (path, entry) in entries.iter() {
+        let age = now - entry.age;
+        total_age += age as f64;
+        if age > maxage {
+            to_remove.push(path.clone());
+        }
+    }
+    
+    for path in to_remove {
+        entries.remove(&path);
+    }
+    
+    if !entries.is_empty() {
+        let decay = 1.0 / (1.0 + total_age / maxage as f64);
+        for entry in entries.values_mut() {
+            entry.score *= decay;
+        }
+    }
+}
+
+fn run_add(args: &[String]) {
+    let paths: Vec<String> = args.iter().map(|s| s.clone()).collect();
+    
+    let mut score: Option<f64> = None;
+    let mut i = 0;
+    while i < paths.len() {
+        if paths[i] == "--score" || paths[i] == "-s" {
+            if i + 1 < paths.len() {
+                score = Some(paths[i + 1].parse().unwrap_or(1.0));
+                i += 2;
+            } else {
+                score = Some(1.0);
+                i += 1;
+            }
+        } else {
+            i += 1;
+        }
+    }
+    
+    let score = score.unwrap_or(1.0);
+    
+    for path in &paths {
+        let path = path.trim();
+        if path.is_empty() {
+            continue;
+        }
+        
+        let db = load_db();
+        let mut entries = db;
+        
+        let resolved_path = if env::var("_ZO_RESOLVE_SYMLINKS").is_ok() {
+            match std::fs::canonicalize(path) {
+                Ok(p) => p.to_string_lossy().to_string(),
+                Err(_) => path.to_string(),
+            }
+        } else {
+            path.to_string()
+        };
+        
+        let excluded = get_excluded_dirs();
+        if is_excluded(&resolved_path, &excluded) {
+            continue;
+        }
+        
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_secs();
+        
+        if let Some(existing) = entries.get(&resolved_path) {
+            let new_score = existing.score + score;
+            let new_age = now;
+            entries.insert(resolved_path.clone(), Entry {
+                path: resolved_path.clone(),
+                score: new_score,
+                age: new_age,
+            });
+        } else {
+            entries.insert(resolved_path.clone(), Entry {
+                path: resolved_path.clone(),
+                score,
+                age: now,
+            });
+        }
+        
+        save_db(&entries);
+    }
+}
+
+fn run_edit() {
+    let db_path = get_db_path();
+    if !db_path.exists() {
+        println!("Database not found. Run 'zoxide add' first.");
+        process::exit(1);
+    }
+    
+    let content = fs::read_to_string(&db_path).unwrap_or_default();
+    println!("{}", content);
+}
+
+fn run_import(args: &[String]) {
+    let mut from: Option<String> = None;
+    let mut path: Option<String> = None;
+    let mut merge = false;
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--from" {
+            if i + 1 < args.len() {
+                from = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: --from requires a value");
+                process::exit(1);
+            }
+        } else if args[i] == "--merge" {
+            merge = true;
+            i += 1;
+        } else if !args[i].starts_with('-') {
+            if path.is_none() {
+                path = Some(args[i].clone());
+            }
+            i += 1;
+        } else {
+            i += 1;
+        }
+    }
+    
+    let from = from.unwrap_or_else(|| {
+        eprintln!("error: --from is required");
+        process::exit(1);
+    });
+    
+    let path = path.unwrap_or_else(|| {
+        eprintln!("error: path is required");
+        process::exit(1);
+    });
+    
+    let db = load_db();
+    let mut entries = db;
+    
+    let import_path = Path::new(&path);
+    if !import_path.exists() {
+        eprintln!("error: path does not exist: {}", path);
+        process::exit(1);
+    }
+    
+    let ext = import_path.extension().and_then(|e| e.to_str()).unwrap_or("");
+    
+    match from.as_str() {
+        "autojump" => {
+            if ext == "db" {
+                let file = File::open(import_path).unwrap_or_else(|_| {
+                    eprintln!("error: cannot open file: {}", path);
+                    process::exit(1);
+                });
+                
+                let reader = BufReader::new(file);
+                for line in reader.lines() {
+                    let line = line.unwrap_or_default();
+                    if line.is_empty() {
+                        continue;
+                    }
+                    
+                    let parts: Vec<&str> = line.splitn(2, ',').collect();
+                    if parts.len() >= 2 {
+                        let p = parts[0].trim();
+                        let score: f64 = parts[1].trim().parse().unwrap_or(1.0);
+                        let now = std::time::SystemTime::now()
+                            .duration_since(std::time::UNIX_EPOCH)
+                            .unwrap_or_default()
+                            .as_secs();
+                        
+                        entries.insert(p.to_string(), Entry {
+                            path: p.to_string(),
+                            score,
+                            age: now,
+                        });
+                    }
+                }
+            } else {
+                eprintln!("error: autojump database must have .db extension");
+                process::exit(1);
+            }
+        }
+        "z" => {
+            if ext == "db" {
+                let file = File::open(import_path).unwrap_or_else(|_| {
+                    eprintln!("error: cannot open file: {}", path);
+                    process::exit(1);
+                });
+                
+                let reader = BufReader::new(file);
+                for line in reader.lines() {
+                    let line = line.unwrap_or_default();
+                    if line.is_empty() {
+                        continue;
+                    }
+                    
+                    let parts: Vec<&str> = line.splitn(2, ',').collect();
+                    if parts.len() >= 2 {
+                        let p = parts[0].trim();
+                        let score: f64 = parts[1].trim().parse().unwrap_or(1.0);
+                        let now = std::time::SystemTime::now()
+                            .duration_since(std::time::UNIX_EPOCH)
+                            .unwrap_or_default()
+                            .as_secs();
+                        
+                        entries.insert(p.to_string(), Entry {
+                            path: p.to_string(),
+                            score,
+                            age: now,
+                        });
+                    }
+                }
+            } else {
+                eprintln!("error: z database must have .db extension");
+                process::exit(1);
+            }
+        }
+        _ => {
+            eprintln!("error: unknown source: {}", from);
+            process::exit(1);
+        }
+    }
+    
+    if merge {
+        let existing_db = load_db();
+        for (_path, entry) in existing_db {
+            if !entries.contains_key(&_path) {
+                entries.insert(_path, entry);
+            }
+        }
+    }
+    
+    save_db(&entries);
+}
+
+fn run_init(args: &[String]) {
+    let mut shell: Option<String> = None;
+    let mut no_cmd = false;
+    let mut _cmd = "z".to_string();
+    let mut _hook = "pwd".to_string();
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--no-cmd" {
+            no_cmd = true;
+            i += 1;
+        } else if args[i] == "--cmd" {
+            if i + 1 < args.len() {
+                _cmd = args[i + 1].clone();
+                i += 2;
+            } else {
+                eprintln!("error: --cmd requires a value");
+                process::exit(1);
+            }
