+#!/bin/bash
+# Compile script for i3-style
+# This script creates the executable from the Python source
+
+set -e
+
+echo "Building i3-style..."
+
+# Create the executable wrapper
+cat > i3-style << 'WRAPPER'
+#!/bin/bash
+exec python3 "$(dirname "$0")/i3_style.py" "$@"
+WRAPPER
+
+chmod +x i3-style
+chmod +x i3_style.py
+
+echo "Build complete: ./i3-style"
