+import pandas as pd
+import json
+from datetime import datetime
+
+def process_data(departments_csv, employees_csv, projects_csv, schema_json):
+    # Load CSV files
+    departments_df = pd.read_csv(departments_csv)
+    employees_df = pd.read_csv(employees_csv)
+    projects_df = pd.read_csv(projects_csv)
+
+    # Initialize the output structure
+    output = {
+        "metadata": {
+            "version": "1.0",
+            "timestamp": datetime.now().isoformat(),
+            "generator": "JSON Processor Script"
+        },
+        "organization": {
+            "name": "Global Organization", # Placeholder, as not in CSVs
+            "founded": "2000-01-01", # Placeholder, as not in CSVs
+            "departments": []
+        },
+        "statistics": {}
+    }
+
+    all_skills = []
+    total_employees = 0
+    total_years_of_service = 0
+    project_status_distribution = {}
+    department_sizes = {}
+    total_department_budget = 0
+
+    for index, dept in departments_df.iterrows():
+        dept_employees = employees_df[employees_df['department_id'] == dept['id']]
+        dept_projects = projects_df[projects_df['department_id'] == dept['id']]
+
+        employees_list = []
+        for emp_idx, emp in dept_employees.iterrows():
+            skills = emp['skills'].split(';')
+            employees_list.append({
+                "id": emp['id'],
+                "name": emp['name'],
+                "position": emp['position'],
+                "skills": skills,
+                "years_of_service": int(emp['years_of_service'])
+            })
+            all_skills.extend(skills)
+            total_employees += 1
+            total_years_of_service += int(emp['years_of_service'])
+        
+        department_sizes[dept['name']] = len(employees_list)
+        total_department_budget += dept['budget']
+
+        projects_list = []
+        for proj_idx, proj in dept_projects.iterrows():
+            members = proj['member_ids'].split(';')
+            projects_list.append({
+                "name": proj['name'],
+                "status": proj['status'],
+                "members": members,
+                "deadline": proj['deadline']
+            })
+            project_status_distribution[proj['status']] = project_status_distribution.get(proj['status'], 0) + 1
+
+        output['organization']['departments'].append({
+            "id": dept['id'],
+            "name": dept['name'],
+            "budget": float(dept['budget']),
+            "employees": employees_list,
+            "projects": projects_list
+        })
+
+    # Calculate statistics
+    skill_distribution = {skill: all_skills.count(skill) for skill in set(all_skills)}
+    average_department_budget = total_department_budget / len(departments_df) if len(departments_df) > 0 else 0
+    average_years_of_service = total_years_of_service / total_employees if total_employees > 0 else 0
+
+    output['statistics'] = {
+        "averageDepartmentBudget": average_department_budget,
+        "totalEmployees": total_employees,
+        "skillDistribution": skill_distribution,
+        "departmentSizes": department_sizes,
+        "projectStatusDistribution": project_status_distribution,
+        "averageYearsOfService": average_years_of_service
+    }
+
+    return output
+
+if __name__ == "__main__":
+    departments_csv_path = "data/departments.csv"
+    employees_csv_path = "data/employees.csv"
+    projects_csv_path = "data/projects.csv"
+    schema_json_path = "schema.json"
+
+    processed_data = process_data(departments_csv_path, employees_csv_path, projects_csv_path, schema_json_path)
+
+    with open("organization.json", "w") as f:
+        json.dump(processed_data, f, indent=2)
+
+    print("organization.json created successfully!")
