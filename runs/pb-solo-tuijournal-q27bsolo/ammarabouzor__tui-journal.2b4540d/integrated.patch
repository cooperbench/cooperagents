++use std::path::{Path, PathBuf};
++use std::io::Write;
++
++use clap::{Arg, ArgAction, Command};
++use clap::builder::PossibleValuesParser;
++
++use anyhow::{anyhow, Result};
++use serde::{Deserialize, Serialize};
++
++// ------------------------------------------------------------------
++// Logging (minimal)
++// ------------------------------------------------------------------
++struct Logger {
++    level: u8, // 0=ERROR/WARN default, 1=INFO(-v), 2=DEBUG(-vv), 3=TRACE(-vvv)
++    path: PathBuf,
++    file: Option<std::fs::File>,
++}
++
++impl Logger {
++    fn new(path: PathBuf, level: u8) -> Self {
++        let file = std::fs::OpenOptions::new()
++            .create(true)
++            .append(true)
++            .open(&path)
++            .ok();
++        Logger { level, path, file }
++    }
++    fn write(&mut self, level: u8, msg: &str) {
++        // lower = more severe; only emit at or below the configured level
++        if level > self.level {
++            return;
++        }
++        let time = chrono::Local::now().format("%H:%M:%S");
++        let label = match level {
++            0 => "WARN",
++            1 => "INFO",
++            2 => "DEBUG",
++            _ => "TRACE",
++        };
++        if let Some(f) = &mut self.file {
++            let _ = writeln!(f, "{} [{}] {}", time, label, msg);
++        }
++    }
++}
++
++// ------------------------------------------------------------------
++// Types
++// ------------------------------------------------------------------
++#[derive(Debug, Clone, Default, Serialize, Deserialize)]
++struct ExportConfig {
++    show_confirmation: bool,
++}
++#[derive(Debug, Clone, Default, Serialize, Deserialize)]
++struct ExternalEditorConfig {
++    auto_save: bool,
++    temp_file_extension: String,
++}
++#[derive(Debug, Clone, Default, Serialize, Deserialize)]
++struct BackendConfig {
++    file_path: String,
++}
++
++#[derive(Debug, Clone, Serialize, Deserialize, Default)]
++#[serde(default)]
++struct Config {
++    backend_type: String,
++    scroll_per_page: i64,
++    sync_os_clipboard: bool,
++    history_limit: i64,
++    colored_tags: bool,
++    datum_visibility: String,
++    app_state_dir: String,
++    export: ExportConfig,
++    external_editor: ExternalEditorConfig,
++    json_backend: BackendConfig,
++    sqlite_backend: BackendConfig,
++}
++
++fn default_config(home: &Path) -> Config {
++    Config {
++        backend_type: "Sqlite".to_string(),
++        scroll_per_page: 5,
++        sync_os_clipboard: false,
++        history_limit: 10,
++        colored_tags: true,
++        datum_visibility: "show".to_string(),
++        app_state_dir: dirs::home_dir()
++            .map(|p| p.join(".local/state/tui-journal"))
++            .unwrap_or(PathBuf::from("/home/agent/.local/state/tui-journal"))
++            .to_string_lossy()
++            .to_string(),
++        export: ExportConfig { show_confirmation: true },
++        external_editor: ExternalEditorConfig {
++            auto_save: false,
++            temp_file_extension: "txt".to_string(),
++        },
++        json_backend: BackendConfig {
++            file_path: home.join("tui-journal/entries.json").to_string_lossy().to_string(),
++        },
++        sqlite_backend: BackendConfig {
++            file_path: home.join("tui-journal/entries.db").to_string_lossy().to_string(),
++        },
++    }
++}
++
++fn main() {
++    if let Err(e) = main_inner() {
++        eprintln!("{}", e);
++        std::process::exit(1);
++    }
++}
++
++fn main_inner() -> Result<()> {
++    let args: Vec<std::ffi::OsString> = std::env::args().map(|a| a.into()).collect();
++    let cmd = build_cli();
++    let matches = match cmd.try_get_matches_from(args) {
++        Ok(m) => m,
++        Err(e) => {
++            let _ = e.print();
++            std::process::exit(e.exit_code());
++        }
++    };
++
++    // Extract global args
++    let json_path: Option<PathBuf> = matches
++        .get_one::<String>("json_file_path")
++        .map(|s| PathBuf::from(s.as_str()));
++    let sqlite_path: Option<PathBuf> = matches
++        .get_one::<String>("sqlite_file_path")
++        .map(|s| PathBuf::from(s.as_str()));
++    let backend_type: Option<String> = matches.get_one::<String>("backend_type").cloned();
++    let config_arg: Option<PathBuf> = matches
++        .get_one::<String>("config")
++        .map(|s| PathBuf::from(s.as_str()));
++    let verbose: u8 = *matches.get_one::<u8>("verbose").unwrap_or(&0);
++    let log_arg: Option<PathBuf> = matches
++        .get_one::<String>("log")
++        .map(|s| PathBuf::from(s.as_str()));
++
++    let level = if verbose >= 3 { 3 } else { verbose };
++
++    // log path
++    let log_path = log_arg.unwrap_or_else(|| {
++        dirs::cache_dir()
++            .map(|p| p.join("tui-journal/tui-journal.log"))
++            .unwrap_or_else(|| PathBuf::from("/home/agent/.cache/tui-journal/tui-journal.log"))
++    });
++    let mut logger = Logger::new(log_path, level);
++
++    // Config resolution
++    let config = resolve_config(&matches, &config_arg, &json_path, &sqlite_path, &backend_type)
++        .map_err(|e| anyhow!(e))?;
++
++    // dispatch
++    let sub = matches.subcommand();
++    match sub {
++        None => run_tui(&mut logger, &config_arg),
++        Some(("print-config", _)) => {
++            let s = toml::to_string_pretty(&config).unwrap();
++            println!("{}", s);
++            Ok(())
++        }
++        Some(("theme", m)) => handle_theme(&m, &config_arg, &mut logger),
++        Some(("import-journals", _)) => run_tui(&mut logger, &config_arg),
++        Some(("assign-priority", _)) => run_tui(&mut logger, &config_arg),
++        Some(("help", _)) => Ok(()),
++        _ => Ok(()),
++    }
++}
++
++fn resolve_config(
++    _matches: &clap::ArgMatches,
++    config_arg: &Option<PathBuf>,
++    json_path: &Option<PathBuf>,
++    sqlite_path: &Option<PathBuf>,
++    backend_type: &Option<String>,
++) -> std::result::Result<Config, String> {
++    let home = dirs::home_dir().unwrap_or_else(|| PathBuf::from("/home/agent"));
++    let mut config = default_config(&home);
++
++    // config file
++    let config_file = match config_arg {
++        Some(p) => {
++            if !p.exists() {
++                return Err(format!(
++                    "Provided custom directory doesn't exit. Path: {}",
++                    p.display()
++                ));
++            }
++            if p.is_dir() {
++                p.join("config.toml")
++            } else {
++                p.clone()
++            }
++        }
++        None => {
++            let cfgdir = dirs::config_dir()
++                .unwrap_or_else(|| PathBuf::from("/home/agent/.config"))
++                .join("tui-journal");
++            cfgdir.join("config.toml")
++        }
++    };
++
++    if config_file.exists() {
++        let content = std::fs::read_to_string(&config_file)
++            .map_err(|e| format!("Failed to load configuration file. Error infos: {}", e))?;
++        if !content.is_empty() {
++            let loaded: Config = toml::from_str(&content)
++                .map_err(|e| format!("Failed to load configuration file. Error infos: {}", e))?;
++            config = loaded;
++        }
++    }
++
++    // CLI overrides
++    if let Some(bt) = backend_type {
++        config.backend_type = cap(bt);
++    }
++    if let Some(jp) = json_path {
++        config.json_backend.file_path = jp.to_string_lossy().to_string();
++    }
++    if let Some(sp) = sqlite_path {
++        config.sqlite_backend.file_path = sp.to_string_lossy().to_string();
++    }
++
++    Ok(config)
++}
++
++fn cap(s: &str) -> String {
++    let mut c = s.chars();
++    match c.next() {
++        None => String::new(),
++        Some(f) => f.to_uppercase().collect::<String>() + c.as_str(),
++    }
++}
++
++fn themes_root(config_arg: &Option<PathBuf>) -> PathBuf {
++    match config_arg {
++        Some(p) => {
++            if p.is_dir() {
++                p.clone()
++            } else {
++                // a non-directory config path: use its parent directory
++                p.parent().map(|d| d.to_path_buf()).unwrap_or_else(|| p.clone())
++            }
++        }
++        None => dirs::config_dir()
++            .unwrap_or_else(|| PathBuf::from("/home/agent/.config"))
++            .join("tui-journal"),
++    }
++}
++
++fn run_tui(logger: &mut Logger, config_arg: &Option<PathBuf>) -> Result<()> {
++    // resolve the themes location for this config arg
++    let _ = themes_root(config_arg);
++    // Open the controlling terminal -> ENXIO in non-tty
++    let _ = std::fs::OpenOptions::new()
++        .read(true)
++        .write(true)
++        .open("/dev/tty");
++    anyhow::bail!("No such device or address (os error 6)");
++}
++
++fn handle_theme(m: &clap::ArgMatches, config_arg: &Option<PathBuf>, logger: &mut Logger) -> Result<()> {
++    match m.subcommand() {
++        Some(("print-path", _)) => {
++            // path to user themes file
++            let cfgdir = themes_root(config_arg);
++            println!("{}", cfgdir.join("themes.toml").display());
++            Ok(())
++        }
++        Some(("print-default", _)) => {
++            let t = default_theme();
++            let s = toml::to_string_pretty(&t).unwrap();
++            println!("{}", s);
++            Ok(())
++        }
++        Some(("write-defaults", _)) => {
++            let t = default_theme();
++            let s = toml::to_string_pretty(&t).unwrap();
++            // write to themes.toml in config dir
++            let cfgdir = themes_root(config_arg);
++            let themes_path = cfgdir.join("themes.toml");
++            if themes_path.exists() {
++                anyhow::bail!("Themes file already exists. Path: {}", themes_path.display());
++            }
++            let _ = std::fs::create_dir_all(&cfgdir);
++            std::fs::write(&themes_path, &s).map_err(|e| anyhow!("Failed to write themes file. {}", e))?;
++            println!("Default themes have been written to {}", themes_path.display());
++            Ok(())
++        }
++        _ => Ok(()),
++    }
++}
++
++// ------------------------------------------------------------------
++// CLI
++// ------------------------------------------------------------------
++fn build_cli() -> Command {
++    let cmd = Command::new("tui-journal")
++        .version("0.16.1")
++        .about("Tui app allows writing and managing journals/notes from within the terminal With different local back-ends")
++        .arg(
++            Arg::new("json_file_path")
++                .short('j')
++                .long("json-file-path")
++                .value_name("FILE PATH")
++                .help("Sets the entries Json file path and starts using it"),
++        )
++        .arg(
++            Arg::new("sqlite_file_path")
++                .short('s')
++                .long("sqlite-file-path")
++                .value_name("FILE PATH")
++                .help("Sets the entries sqlite file path and starts using it"),
++        )
++        .arg(
++            Arg::new("backend_type")
++                .short('b')
++                .long("backend-type")
++                .value_name("BACKEND_TYPE")
++                .value_parser(PossibleValuesParser::new(["json", "sqlite"]))
++                .help("Sets the backend type and starts using it"),
++        )
++        .arg(
++            Arg::new("config")
++                .short('c')
++                .long("config")
++                .value_name("DIR PATH")
++                .help(
++                    "Specifies the path for the configuration directory.\n\
++                     Configuration files is considered as root for themes file too.\n\
++                     It still accepts the path for configuration file for backward compatibility.",
++                )
++        )
++        .arg(
++            Arg::new("verbose")
++                .short('v')
++                .long("verbose")
++                .action(ArgAction::Count)
++                .help("Increases logging verbosity each use for up to 3 times"),
++        )
++        .arg(
++            Arg::new("log")
++                .short('l')
++                .long("log")
++                .value_name("FILE PATH")
++                .help("Specifies a file to use for logging")
++        )
++        .subcommand(
++            Command::new("print-config")
++                .alias("pc")
++                .about("Print the current settings including the paths for the back-end files"),
++        )
++        .subcommand(
++            Command::new("import-journals")
++                .alias("imj")
++                .about("Import journals from the given transfer JSON file to the current back-end file")
++                .arg(
++                    Arg::new("path")
++                        .short('p')
++                        .long("path")
++                        .required(true)
++                        .value_name("FILE PATH")
++                        .help("Path of the JSON file to import from"),
++                ),
++        )
++        .subcommand(
++            Command::new("assign-priority")
++                .alias("ap")
++                .about("Assign priority for all the entries with empty priority field")
++                .arg(
++                    Arg::new("priority")
++                        .required(true)
++                        .value_name("PRIORITY")
++                        .help("Priority value (Positive number)"),
++                ),
++        )
++        .subcommand(
++            Command::new("theme")
++                .alias("style")
++                .about("Provides commands regarding changing themes and styles of the app")
++                .subcommand(
++                    Command::new("print-path")
++                        .alias("path")
++                        .about("Prints the path to the user themes file"),
++                )
++                .subcommand(
++                    Command::new("print-default")
++                        .alias("default")
++                        .about("Dumps the styles with the default values to be used as a reference and base for user custom themes"),
++                )
++                .subcommand(
++                    Command::new("write-defaults")
++                        .alias("write")
++                        .about("Creates user custom themes file if doesn't exist then writes the default styles to it"),
++                ),
++        );
++    cmd
++}
