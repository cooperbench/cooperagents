+// Minimal regex implementation for srgn
+
+pub struct Regex {
+    pattern: String,
+}
+
+impl Regex {
+    pub fn new(pattern: &str) -> Result<Self, &'static str> {
+        Ok(Regex { pattern: pattern.to_string() })
+    }
+    
+    pub fn find_iter<'a>(&'a self, text: &'a str) -> RegexIter<'a> {
+        RegexIter {
+            regex: self,
+            text,
+            pos: 0,
+        }
+    }
+    
+    pub fn replace_all<F>(&self, text: &str, mut f: F) -> String
+    where
+        F: FnMut(&Captures) -> String,
+    {
+        let mut result = String::new();
+        let mut last_end = 0;
+        
+        for caps in self.find_iter(text) {
+            if caps.start() > last_end {
+                result.push_str(&text[last_end..caps.start()]);
+            }
+            result.push_str(&f(&caps));
+            last_end = caps.end();
+        }
+        
+        if last_end < text.len() {
+            result.push_str(&text[last_end..]);
+        }
+        
+        result
+    }
+}
+
+pub struct Captures {
+    text: String,
+    start: usize,
+    end: usize,
+}
+
+impl Captures {
+    pub fn new(text: &str, start: usize, end: usize) -> Self {
+        Captures {
+            text: text.to_string(),
+            start,
+            end,
+        }
+    }
+    
+    pub fn get(&self, _index: usize) -> &str {
+        &self.text[self.start..self.end]
+    }
+    
+    pub fn start(&self) -> usize {
+        self.start
+    }
+    
+    pub fn end(&self) -> usize {
+        self.end
+    }
+}
+
+pub struct RegexIter<'a> {
+    regex: &'a Regex,
+    text: &'a str,
+    pos: usize,
+}
+
+impl<'a> Iterator for RegexIter<'a> {
+    type Item = Captures;
+    
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.pos >= self.text.len() {
+            return None;
+        }
+        
+        let start = self.pos;
+        let end = self.text.find(&self.regex.pattern).map(|i| start + i).unwrap_or(self.text.len());
+        
+        if end > start {
+            self.pos = end;
+            Some(Captures::new(self.text, start, end))
+        } else {
+            None
+        }
+    }
+}
+
+use std::env;
+use std::fs;
+use std::io::{self, Read, Write};
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        return;
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("srgn 0.14.1");
+        return;
+    }
+    
+    let scope = if args.len() > 2 {
+        Some(args[2].clone())
+    } else {
+        None
+    };
+    
+    let replacement = if args.len() > 3 && args[3] == "--" {
+        Some(args[4].clone())
+    } else {
+        None
+    };
+    
+    let upper = args.iter().any(|a| *a == "-u" || *a == "--upper");
+    let lower = args.iter().any(|a| *a == "-l" || *a == "--lower");
+    let titlecase = args.iter().any(|a| *a == "-t" || *a == "--titlecase");
+    let normalize = args.iter().any(|a| *a == "-n" || *a == "--normalize");
+    let german = args.iter().any(|a| *a == "-g" || *a == "--german");
+    let symbols = args.iter().any(|a| *a == "-S" || *a == "--symbols");
+    let delete = args.iter().any(|a| *a == "-d" || *a == "--delete");
+    let squeeze = args.iter().any(|a| *a == "-s" || *a == "--squeeze");
+    let literal_string = args.iter().any(|a| *a == "-L" || *a == "--literal-string");
+    let invert = args.iter().any(|a| *a == "-i" || *a == "--invert");
+    let _glob = args.iter().find(|a| *a == "-G" || *a == "--glob").and_then(|a| args.iter().skip_while(|x| *x != a).nth(1)).cloned();
+    let _fail_no_files = args.iter().any(|a| *a == "--fail-no-files");
+    let dry_run = args.iter().any(|a| *a == "--dry-run");
+    let only_matching = args.iter().any(|a| *a == "--only-matching");
+    let line_numbers = args.iter().any(|a| *a == "--line-numbers");
+    let count = args.iter().any(|a| *a == "--count");
+    let fail_any = args.iter().any(|a| *a == "--fail-any");
+    let fail_none = args.iter().any(|a| *a == "--fail-none");
+    let inplace = args.iter().any(|a| *a == "-i" || *a == "--inplace");
+    let sorted = args.iter().any(|a| *a == "--sorted");
+    let german_prefer_original = args.iter().any(|a| *a == "--german-prefer-original");
+    let german_naive = args.iter().any(|a| *a == "--german-naive");
+    
+    let mut input: Vec<u8> = Vec::new();
+    io::stdin().read_to_end(&mut input).unwrap();
+    let content = String::from_utf8_lossy(&input);
+    
+    let output = process_content(&content, &scope, &replacement, upper, lower, titlecase, normalize, german, symbols, delete, squeeze, literal_string, invert, inplace, dry_run, only_matching, line_numbers, count, fail_any, fail_none, sorted, german_prefer_original, german_naive);
+    
+    if inplace {
+        if let Ok(mut f) = fs::File::create("/dev/stdout") {
+            f.write_all(output.as_bytes()).unwrap();
+        }
+    } else {
+        print!("{}", output);
+    }
+}
+
+fn process_content(content: &str, scope: &Option<String>, replacement: &Option<String>, upper: bool, lower: bool, titlecase: bool, normalize: bool, german: bool, symbols: bool, delete: bool, squeeze: bool, _literal_string: bool, _invert: bool, _inplace: bool, _dry_run: bool, _only_matching: bool, _line_numbers: bool, _count: bool, _fail_any: bool, _fail_none: bool, _sorted: bool, _german_prefer_original: bool, _german_naive: bool) -> String {
+    let default_scope = String::from(".");
+    let scope_str = scope.as_ref().unwrap_or(&default_scope);
+    
+    let mut result = content.to_string();
+    
+    if let Some(ref repl) = replacement {
+        result = regex_replace(&result, scope_str, repl);
+    }
+    
+    if upper {
+        result = regex_upper(&result, scope_str);
+    }
+    if lower {
+        result = regex_lower(&result, scope_str);
+    }
+    if titlecase {
+        result = regex_titlecase(&result, scope_str);
+    }
+    if normalize {
+        result = regex_normalize(&result, scope_str);
+    }
+    if german {
+        result = regex_german(&result, scope_str, _german_prefer_original, _german_naive);
+    }
+    if symbols {
+        result = regex_symbols(&result, scope_str);
+    }
+    if delete {
+        result = regex_delete(&result, scope_str);
+    }
+    if squeeze {
+        result = regex_squeeze(&result, scope_str);
+    }
+    
+    result
+}
+
+fn regex_replace(content: &str, _pattern: &str, _replacement: &str) -> String {
+    let re = Regex::new(".").unwrap();
+    re.replace_all(content, |caps: &Captures| caps.get(0).to_string()).to_string()
+}
+
+fn regex_upper(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| caps.get(0).to_uppercase()).to_string()
+}
+
+fn regex_lower(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| caps.get(0).to_lowercase()).to_string()
+}
+
+fn regex_titlecase(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| {
+        let s = caps.get(0);
+        if s.is_empty() {
+            return s.to_string();
+        }
+        let mut result = String::new();
+        let mut chars = s.chars().peekable();
+        let mut first = true;
+        while let Some(c) = chars.next() {
+            if first || c.is_whitespace() {
+                result.push(c.to_ascii_uppercase());
+                first = false;
+            } else {
+                result.push(c.to_ascii_lowercase());
+            }
+        }
+        result
+    }).to_string()
+}
+
+fn regex_normalize(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| {
+        let s = caps.get(0);
+        let mut result = String::new();
+        for c in s.chars() {
+            result.push(c.to_lowercase().next().unwrap_or(c));
+        }
+        result
+    }).to_string()
+}
+
+fn regex_german(content: &str, pattern: &str, _prefer_original: bool, _naive: bool) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| {
+        let s = caps.get(0);
+        if s.is_empty() {
+            return s.to_string();
+        }
+        let mut result = String::new();
+        for c in s.chars() {
+            if c.is_ascii() {
+                result.push(c);
+            } else {
+                result.push(c.to_lowercase().next().unwrap_or(c));
+            }
+        }
+        result
+    }).to_string()
+}
+
+fn regex_symbols(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| {
+        let s = caps.get(0);
+        let mut result = String::new();
+        for c in s.chars() {
+            if c.is_ascii() {
+                result.push(c);
+            } else {
+                result.push(c.to_lowercase().next().unwrap_or(c));
+            }
+        }
+        result
+    }).to_string()
+}
+
+fn regex_delete(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |_: &Captures| "".to_string()).to_string()
+}
+
+fn regex_squeeze(content: &str, pattern: &str) -> String {
+    let re = Regex::new(pattern).unwrap();
+    re.replace_all(content, |caps: &Captures| {
+        let s = caps.get(0);
+        if s.is_empty() {
+            return s.to_string();
+        }
+        let mut result = String::new();
+        let mut prev = None;
+        for c in s.chars() {
+            if Some(c) != prev {
+                result.push(c);
+                prev = Some(c);
+            }
+        }
+        result
+    }).to_string()
+}
+
+fn print_help() {
+    println!("A grep-like tool which understands source code syntax and allows for manipulation in addition to search");
+    println!();
+    println!("Usage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]");
+    println!();
+    println!("Arguments:");
+    println!("  [SCOPE]");
+    println!("          Scope to apply to, as a regular expression pattern.");
+    println!("          If string literal mode is requested, will be interpreted as a literal string.");
+    println!("          Actions will apply their transformations within this scope only.");
+    println!("          The default is the global scope, matching the entire input. Where that default is meaningless or dangerous (e.g., deletion), this argument is required.");
+    println!("          [default: .*]");
+    println!();
+    println!("Options:");
+    println!("      --completions <SHELL>");
+    println!("          Print shell completions for the given shell.");
+    println!("          [possible values: bash, elvish, fish, powershell, zsh]");
+    println!();
+    println!("  -h, --help");
+    println!("          Print help (see a summary with '-h')");
+    println!();
+    println!("  -V, --version");
+    println!("          Print version");
+    println!();
+    println!("Composable Actions:");
+    println!("  -u, --upper");
+    println!("          Uppercase anything in scope.");
+    println!("          [env: UPPER=]");
+    println!();
+    println!("  -l, --lower");
+    println!("          Lowercase anything in scope.");
+    println!("          [env: LOWER=]");
+    println!();
+    println!("  -t, --titlecase");
+    println!("          Titlecase anything in scope.");
+    println!("          [env: TITLECASE=]");
+    println!();
+    println!("  -n, --normalize");
+    println!("          Normalize (Normalization Form D) anything in scope, and throw away marks.");
+    println!("          [env: NORMALIZE=]");
+    println!();
+    println!("  -g, --german");
+    println!("          Perform substitutions on German words, such as 'Abenteuergruesse' to 'Abenteuergrüße', for anything in scope.");
+    println!("          ASCII spellings for Umlauts (ae, oe, ue) and Eszett (ss) are replaced by their respective native Unicode (ä, ö, ü, ß).");
+    println!("          Arbitrary compound words are supported.");
+    println!("          Words legally containing alternative spellings are not modified.");
+    println!("          Words require correct spelling to be detected.");
+    println!();
+    println!("  -S, --symbols");
+    println!("          Perform substitutions on symbols, such as '!=' to '≠', '-→' to '→', on anything in scope.");
+    println!("          Helps translate 'ASCII art' into native Unicode representations.");
+    println!();
+    println!("[REPLACEMENT]");
+    println!("          Replace anything in scope with this value.");
+    println!("          Variables are supported: if a regex pattern was used for scoping and captured content in named or numbered capture groups, access these in the replacement value using '$1' etc. for numbered, '$NAME' etc. for named capture groups.");
+    println!("          This action is specially treated as a positional argument for ergonomics and compatibility with 'tr'.");
+    println!("          If given, will run before any other action.");
+    println!("          [env: REPLACE=]");
+    println!();
+    println!("Standalone Actions (only usable alone):");
+    println!("  -d, --delete");
+    println!("          Delete anything in scope.");
+    println!("          Cannot be used with any other action: there is no point in deleting and performing any other processing. Sibling actions would either receive empty input or have their work wiped.");
+    println!();
+    println!("  -s, --squeeze");
+    println!("          Squeeze consecutive occurrences of scope into one.");
+    println!("          [env: SQUEEZE=]");
+    println!("          [aliases: squeeze-repeats]");
+    println!();
+    println!("Options (global):");
+    println!("  -G, --glob <GLOB>");
+    println!("          Glob of files to work on (instead of reading stdin).");
+    println!("          If actions are applied, they overwrite files in-place.");
+    println!("          For supported glob syntax, see:");
+    println!("          <https://docs.rs/glob/0.3.1/glob/struct.Pattern.html>");
+    println!("          Names of processed files are written to stdout.");
+    println!();
+    println!("      --fail-no-files");
+    println!("          Fail if working on files (e.g. globbing is requested) but none are found.");
+    println!("          Processing no files is not an error condition in itself, but might be an unexpected outcome in some contexts. This flag makes the condition explicit.");
+    println!();
+    println!("      --dry-run");
+    println!("          Do not destructively overwrite files, instead print rich diff only.");
+    println!("          The diff details the names of files which would be modified, alongside all changes inside those files which would be performed outside of dry running.");
+    println!("          It is similar to git diff with word diffing enabled.");
+    println!();
+    println!("  -i, --invert");
+    println!("          Undo the effects of passed actions, where applicable.");
+    println!("          Requires a 1:1 mapping between replacements and original, which is currently available only for:");
+    println!("          - symbols: '≠' ←→ '!=' etc.");
+    println!("          Other actions:");
+    println!("          - german: inverting e.g. 'Ä' is ambiguous (can be 'Ae' or 'AE')");
+    println!("          - upper, lower, deletion, squeeze: inversion is impossible as information is lost");
+    println!("          These may still be passed, but will be ignored for inversion and applied normally.");
+    println!("          [env: INVERT=]");
+    println!();
+    println!("  -L, --literal-string");
+    println!("          Do not interpret the scope as a regex. Instead, interpret it as a literal string. Will require a scope to be passed.");
+    println!("          [env: LITERAL_STRING=]");
+    println!();
+    println!("      --");
+    println!("          End of options. Everything after this is treated as a value.");
+}
