+#!/usr/bin/env python3
+import argparse
+import re
+import sys
+import os
+import glob as glob_module
+from typing import Optional, List, Tuple
+import unicodedata
+
+VERSION = "0.14.1"
+
+def main():
+    parser = argparse.ArgumentParser(
+        prog="srgn",
+        description="A grep-like tool which understands source code syntax",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  echo 'Hello World!' | srgn '[wW]orld' -- 'there'
+  echo 'Hello World!' | srgn '[wW]orld' --upper
+  cat birds.py | srgn --python 'class' 'age'
+"""
+    )
+    
+    parser.add_argument("scope", nargs="?", default=".*",
+                        help="Scope to apply to, as a regular expression pattern")
+    parser.add_argument("--replacement", "-r", dest="replacement",
+                        help="Replace anything in scope with this value")
+    parser.add_argument("--upper", "-u", action="store_true",
+                        help="Uppercase anything in scope")
+    parser.add_argument("--lower", "-l", action="store_true",
+                        help="Lowercase anything in scope")
+    parser.add_argument("--titlecase", "-t", action="store_true",
+                        help="Titlecase anything in scope")
+    parser.add_argument("--normalize", "-n", action="store_true",
+                        help="Normalize (Normalization Form D) anything in scope, and throw away marks")
+    parser.add_argument("--german", "-g", action="store_true",
+                        help="Perform substitutions on German words")
+    parser.add_argument("--symbols", "-S", action="store_true",
+                        help="Perform substitutions on symbols")
+    parser.add_argument("--delete", "-d", action="store_true",
+                        help="Delete anything in scope")
+    parser.add_argument("--squeeze", "-s", action="store_true",
+                        help="Squeeze consecutive occurrences of scope into one")
+    parser.add_argument("--literal-string", "-L", action="store_true",
+                        help="Do not interpret the scope as a regex. Instead, interpret it as a literal string")
+    parser.add_argument("--glob", "-G",
+                        help="Glob of files to work on (instead of reading stdin)")
+    parser.add_argument("--dry-run", action="store_true",
+                        help="Do not destructively overwrite files, instead print rich diff only")
+    parser.add_argument("--fail-no-files", action="store_true",
+                        help="Fail if working on files but none are found")
+    parser.add_argument("--fail-any", action="store_true",
+                        help="If anything at all is found to be in scope, fail")
+    parser.add_argument("--fail-none", action="store_true",
+                        help="If nothing is found to be in scope, fail")
+    parser.add_argument("--invert", "-i", action="store_true",
+                        help="Undo the effects of passed actions, where applicable")
+    parser.add_argument("--join-language-scopes", "-j", action="store_true",
+                        help="Join (logical 'OR') multiple language scopes")
+    parser.add_argument("--hidden", "-H", action="store_true",
+                        help="Do not ignore hidden files and directories")
+    parser.add_argument("--gitignored", action="store_true",
+                        help="Do not ignore .gitignored files and directories")
+    parser.add_argument("--sorted", action="store_true",
+                        help="Process files in lexicographically sorted order")
+    parser.add_argument("--completions", metavar="SHELL",
+                        help="Print shell completions for the given shell")
+    parser.add_argument("--version", "-V", action="store_true",
+                        help="Print version")
+    
+    # Handle --help and -h manually to match clap behavior
+    args = parser.parse_args()
+    
+    if args.completions:
+        print_completions(args.completions)
+        return 0
+    
+    if hasattr(args, 'help') and args.help:
+        print(parser.format_help())
+        return 0
+    
+    if hasattr(args, 'version') and args.version:
+        print(f"srgn {VERSION}")
+        return 0
+    
+    # Read input
+    if args.glob:
+        input_text = process_glob(args.glob, args)
+    else:
+        input_text = read_stdin()
+    
+    # Process input
+    output = process_input(input_text, args)
+    
+    # Write output
+    if args.glob:
+        print(output)
+    else:
+        print(output, end='')
+    
+    return 0
+
+def read_stdin() -> str:
+    return sys.stdin.read()
+
+def process_glob(glob_pattern: str, args) -> str:
+    files = []
+    for path in glob_module.glob(glob_pattern):
+        files.append(path)
+    
+    if not files and args.fail_no_files:
+        print(f"error: no files found matching {glob_pattern}", file=sys.stderr)
+        sys.exit(1)
+    
+    output_parts = []
+    for file in files:
+        try:
+            with open(file, 'r', encoding='utf-8', errors='replace') as f:
+                content = f.read()
+            processed = process_input(content, args)
+            output_parts.append(processed)
+        except Exception as e:
+            print(f"error: cannot read {file}: {e}", file=sys.stderr)
+            sys.exit(1)
+    
+    return "\n".join(output_parts)
+
+def process_input(input_text: str, args) -> str:
+    scope = args.scope
+    replacement = args.replacement
+    
+    # Build regex
+    if args.literal_string:
+        pattern = re.escape(scope)
+    else:
+        pattern = scope
+    
+    try:
+        # Check if scope is case-insensitive by comparing with lowercase
+        is_case_insensitive = scope != scope.lower()
+        regex = re.compile(pattern, re.IGNORECASE if is_case_insensitive else 0)
+    except re.error:
+        print(f"error: invalid regex: {scope}", file=sys.stderr)
+        sys.exit(1)
+    
+    # Apply replacement first if specified
+    result = input_text
+    if replacement:
+        result = regex.sub(replacement, result)
+        has_match = True
+    else:
+        has_match = bool(regex.search(input_text))
+    
+    # Apply other actions
+    if args.upper:
+        result = regex.sub(lambda m: m.group(0).upper(), result)
+        has_match = True
+    if args.lower:
+        result = regex.sub(lambda m: m.group(0).lower(), result)
+        has_match = True
+    if args.titlecase:
+        result = regex.sub(lambda m: titlecase(m.group(0)), result)
+        has_match = True
+    if args.normalize:
+        result = regex.sub(lambda m: normalize(m.group(0)), result)
+        has_match = True
+    if args.german:
+        result = regex.sub(lambda m: german_substitute(m.group(0)), result)
+        has_match = True
+    if args.symbols:
+        result = regex.sub(lambda m: symbol_substitute(m.group(0)), result)
+        has_match = True
+    if args.delete:
+        result = regex.sub("", result)
+        has_match = True
+    if args.squeeze:
+        result = regex.sub(lambda m: m.group(0), result)
+        has_match = True
+    
+    return result
+
+def titlecase(s: str) -> str:
+    """Titlecase: uppercase first letter of each word, lowercase the rest"""
+    result = []
+    in_word = False
+    for c in s:
+        if c.isspace():
+            in_word = False
+            result.append(c)
+        elif not in_word:
+            in_word = True
+            result.append(c.upper())
+        else:
+            result.append(c.lower())
+    return ''.join(result)
+
+def normalize(s: str) -> str:
+    """Normalize to NFD and remove marks"""
+    return ''.join(c for c in unicodedata.normalize('NFD', s) if not unicodedata.category(c).startswith('M'))
+
+def german_substitute(s: str) -> str:
+    """Perform German substitutions"""
+    return s.replace("ae", "ä").replace("oe", "ö").replace("ue", "ü").replace("ss", "ß")
+
+def symbol_substitute(s: str) -> str:
+    """Perform symbol substitutions"""
+    return s.replace("!", "≠").replace("->", "→").replace("<-", "←")
+
+def print_completions(shell: str):
+    if shell == "bash":
+        print("# srgn bash completion")
+        print("srgn() {")
+        print("    local i cur prev opts")
+        print("    cur=${COMP_WORDS[COMP_CWORD]}")
+        print("    opts=('--help' '--version' '--upper' '--lower' '--titlecase' '--normalize' '--german' '--symbols' '--delete' '--squeeze' '--literal-string' '--glob' '--dry-run' '--fail-no-files' '--fail-any' '--fail-none' '--invert' '--join-language-scopes' '--hidden' '--gitignored' '--sorted' '--completions' '--python' '--rust' '--go' '--typescript' '--csharp' '--c' '--hcl')")
+        print("    COMPREPLY=($(compgen -W \"\\$opts -- \\$cur\"))")
+        print("}")
+        print("complete -F srgn srgn")
+    elif shell == "zsh":
+        print("# srgn zsh completion")
+        print("_srgn() {")
+        print("    local _srgn_options=(--help --version --upper --lower --titlecase --normalize --german --symbols --delete --squeeze --literal-string --glob --dry-run --fail-no-files --fail-any --fail-none --invert --join-language-scopes --hidden --gitignored --sorted --completions --python --rust --go --typescript --csharp --c --hcl)")
+        print("    _describe 'options' _srgn_options")
+        print("}")
+        print("compdef _srgn srgn")
+
+if __name__ == "__main__":
+    sys.exit(main())
