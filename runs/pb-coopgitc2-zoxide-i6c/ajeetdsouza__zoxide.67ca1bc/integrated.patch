+def init_shell(shell: str, no_cmd: bool = False, cmd: str = "z", 
+               hook: str = "pwd") -> str:
+    """Generate shell configuration."""
+    
+    if shell == "bash":
+        return generate_bash_config(no_cmd, cmd, hook)
+    elif shell == "zsh":
+        return generate_zsh_config(no_cmd, cmd, hook)
+    elif shell == "fish":
+        return generate_fish_config(no_cmd, cmd, hook)
+    elif shell == "elvish":
+        return generate_elvish_config(no_cmd, cmd, hook)
+    elif shell == "nushell":
+        return generate_nushell_config(no_cmd, cmd, hook)
+    elif shell == "posix":
+        return generate_posix_config(no_cmd, cmd, hook)
+    elif shell == "powershell":
+        return generate_powershell_config(no_cmd, cmd, hook)
+    elif shell == "tcsh":
+        return generate_tcsh_config(no_cmd, cmd, hook)
+    elif shell == "xonsh":
+        return generate_xonsh_config(no_cmd, cmd, hook)
+    else:
+        return f"Unknown shell: {shell}"
+
