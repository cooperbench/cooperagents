+#!/usr/bin/env python3
+"""zoxide - A smarter cd command for your terminal."""
+
+import argparse
+import os
+import sys
+import json
+import subprocess
+from typing import List, Optional, Dict, Any, Tuple
+
+VERSION = "0.9.9"
+
+# Environment variables
+ZO_DATA_DIR = os.environ.get("_ZO_DATA_DIR", None)
+ZO_ECHO = os.environ.get("_ZO_ECHO", "0")
+ZO_EXCLUDE_DIRS = os.environ.get("_ZO_EXCLUDE_DIRS", None)
+ZO_FZF_OPTS = os.environ.get("_ZO_FZF_OPTS", None)
+ZO_MAXAGE = int(os.environ.get("_ZO_MAXAGE", "10000"))
+ZO_RESOLVE_SYMLINKS = os.environ.get("_ZO_RESOLVE_SYMLINKS", "0")
+
+
+def get_data_dir() -> str:
+    """Get the data directory based on platform."""
+    if ZO_DATA_DIR:
+        return ZO_DATA_DIR
+    
+    if os.name == 'nt':  # Windows
+        return os.environ.get("LOCALAPPDATA", os.path.expanduser("~\\AppData\\Local"))
+    elif os.name == 'darwin':  # macOS
+        return os.path.expanduser("~/Library/Application Support")
+    else:  # Linux/BSD
+        xdg_data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
+        return xdg_data_home
+
+
+def get_db_path() -> str:
+    """Get the database file path."""
+    data_dir = get_data_dir()
+    return os.path.join(data_dir, "zoxide.db")
+
+
+def get_db() -> Dict[str, float]:
+    """Load the database from disk."""
+    db_path = get_db_path()
+    if os.path.exists(db_path):
+        try:
+            with open(db_path, 'r') as f:
+                return json.load(f)
+        except (json.JSONDecodeError, IOError):
+            return {}
+    return {}
+
+
+def save_db(db: Dict[str, float]) -> None:
+    """Save the database to disk."""
+    db_path = get_db_path()
+    os.makedirs(os.path.dirname(db_path), exist_ok=True)
+    with open(db_path, 'w') as f:
+        json.dump(db, f, indent=2)
+
+
+def normalize_path(path: str) -> str:
+    """Normalize a path by resolving symlinks if needed."""
+    if ZO_RESOLVE_SYMLINKS == "1":
+        try:
+            path = os.path.realpath(path)
+        except (OSError, ValueError):
+            pass
+    return os.path.normpath(path)
+
+
+def should_exclude(path: str) -> bool:
+    """Check if a path should be excluded based on _ZO_EXCLUDE_DIRS."""
+    if not ZO_EXCLUDE_DIRS:
+        return False
+    
+    exclude_list = ZO_EXCLUDE_DIRS.split(os.pathsep if os.name != 'nt' else ';')
+    
+    # Default exclusion: home directory
+    home = os.path.expanduser("~")
+    exclude_list.append(home)
+    
+    for pattern in exclude_list:
+        pattern = os.path.normpath(pattern)
+        if pattern == path:
+            return True
+        if path.startswith(pattern + os.sep) or path == pattern:
+            return True
+        try:
+            rel = os.path.relpath(path, pattern)
+            if rel.startswith("..") or rel == ".":
+                continue
+            if rel.startswith(os.sep) or (os.altsep and rel.startswith(os.altsep + os.sep)):
+                continue
+            return True
+        except ValueError:
+            pass
+    
+    return False
+
+
+def add_entry(path: str, score: Optional[float] = None) -> None:
+    """Add or update an entry in the database."""
+    db = get_db()
+    normalized = normalize_path(path)
+    
+    if should_exclude(normalized):
+        return
+    
+    if score is None:
+        score = 1.0
+    
+    db[normalized] = score
+    save_db(db)
+
+
+def query_db(keywords: List[str], all_entries: bool = False, 
+             interactive: bool = False, list_only: bool = False,
+             show_score: bool = False, exclude_current: bool = False,
+             base_dir: Optional[str] = None) -> List[Tuple[str, float]]:
+    """Query the database for matching directories."""
+    db = get_db()
+    results = []
+    
+    current_dir = os.getcwd()
+    if exclude_current:
+        current_dir = os.path.dirname(current_dir)
+    
+    for path, score in db.items():
+        if base_dir and not path.startswith(base_dir):
+            continue
+        
+        # Check if path is under current directory
+        if not all_entries and not path.startswith(current_dir + os.sep) and path != current_dir:
+            continue
+        
+        # Check keywords
+        if keywords:
+            path_lower = path.lower()
+            match = True
+            for kw in keywords:
+                kw_lower = kw.lower()
+                if kw_lower not in path_lower:
+                    match = False
+                    break
+            if not match:
+                continue
+        
+        results.append((path, score))
+    
+    # Sort by score descending
+    results.sort(key=lambda x: x[1], reverse=True)
+    
+    if list_only:
+        for path, score in results:
+            print(path)
+    elif show_score:
+        for path, score in results:
+            print(f"{path}\t{score}")
+    else:
+        for path, score in results:
+            print(path)
+    
+    return results
+
+
+def remove_entries(paths: List[str]) -> None:
+    """Remove entries from the database."""
+    db = get_db()
+    for path in paths:
+        normalized = normalize_path(path)
+        if normalized in db:
+            del db[normalized]
+    save_db(db)
+
+
+def import_from(source: str, path: str, merge: bool = False) -> None:
+    """Import entries from another application."""
+    if source == "autojump":
+        db_path = os.path.join(path, "db")
+        if os.path.exists(db_path):
+            with open(db_path, 'r') as f:
+                for line in f:
+                    line = line.strip()
+                    if line and not line.startswith('#'):
+                        parts = line.split()
+                        if len(parts) >= 2:
+                            try:
+                                score = float(parts[1])
+                                add_entry(parts[0], score)
+                            except ValueError:
+                                pass
+    elif source == "z":
+        db_path = os.path.join(path, "db")
+        if os.path.exists(db_path):
+            with open(db_path, 'r') as f:
+                for line in f:
+                    line = line.strip()
+                    if line and not line.startswith('#'):
+                        parts = line.split()
+                        if len(parts) >= 2:
+                            try:
+                                score = float(parts[1])
+                                add_entry(parts[0], score)
+                            except ValueError:
+                                pass
+
+
+def init_shell(shell: str, no_cmd: bool = False, cmd: str = "z", 
+               hook: str = "pwd") -> str:
+    """Generate shell configuration."""
+    
+    if shell == "bash":
+        return generate_bash_config(no_cmd, cmd, hook)
+    elif shell == "zsh":
+        return generate_zsh_config(no_cmd, cmd, hook)
+    elif shell == "fish":
+        return generate_fish_config(no_cmd, cmd, hook)
+    elif shell == "elvish":
+        return generate_elvish_config(no_cmd, cmd, hook)
+    elif shell == "nushell":
+        return generate_nushell_config(no_cmd, cmd, hook)
+    elif shell == "posix":
+        return generate_posix_config(no_cmd, cmd, hook)
+    elif shell == "powershell":
+        return generate_powershell_config(no_cmd, cmd, hook)
+    elif shell == "tcsh":
+        return generate_tcsh_config(no_cmd, cmd, hook)
+    elif shell == "xonsh":
+        return generate_xonsh_config(no_cmd, cmd, hook)
+    else:
+        return f"Unknown shell: {shell}"
+
+
+def generate_bash_config(no_cmd: bool, cmd: str, hook: str) -> str:
+    """Generate bash configuration."""
+    lines = []
+    lines.append("# shellcheck shell=bash")
+    lines.append("")
+    lines.append("# =============================================================================")
+    lines.append("#")
+    lines.append("# Utility functions for zoxide.")
+    lines.append("#")
+    lines.append("")
+    lines.append("# pwd based on the value of _ZO_RESOLVE_SYMLINKS.")
+    lines.append("function __zoxide_pwd() {")
+    lines.append("    \\\\builtin pwd -L")
+    lines.append("}")
+    lines.append("")
+    lines.append("# cd ...[clipped]...omplete_helper() {")
+    lines.append("        if [[ -n \"${__zoxide_result}\" ]]; then")
+    lines.append("            # shellcheck disable=SC2034,SC2296")
+    lines.append("            BUFFER=\"z ${(q-)__zoxide_result}\"")
+    lines.append("            __zoxide_result=\u0027\u0027")
+    lines.append("            \\\\builtin zle reset-prompt")
+    lines.append("            \\\\builtin zle accept-line")
+    lines.append("        else")
+    lines.append("            \\\\builtin zle reset-prompt")
+    lines.append("        fi")
+    lines.append("    }")
+    lines.append("    \\\\builtin zle -N __zoxide_z_complete_helper")
+    lines.append("")
+    lines.append("    [[ \"${+functions[compdef]}\" -ne 0 ]] \u0026\u0026 \\compdef __zoxide_z_complete z")
+    lines.append("fi")
+    lines.append("")
+    lines.append("# =============================================================================")
+    lines.append("#")
+    lines.append("# To initialize zoxide, add this to your shell configuration file (usually ~/.zshrc):")
+    lines.append("#")
+    lines.append("# eval \"$(zoxide init zsh)\"")
+    
+    return "\\n".join(lines)
+
+
+def generate_fish_config(no_cmd: bool, cmd: str, hook: str) -> str:
+    """Generate fish configuration."""
+    lines = []
+    lines.append("# =============================================================================")
+    lines.append("#")
+    lines.append("# Utility functions for zoxide.")
+    lines.append("#")
+    lines.append("")
+    lines.append("# pwd based on the value of _ZO_RESOLVE_SYMLINKS.")
+    lines.append("function __zoxide_pwd")
+    lines.append("    builtin pwd -L")
+    lines.append("end")
+    lines.append("")
+    lines.append("# A copy of fish's internal cd function. This makes it possible to use")
+    lines.append("# `alias cd=z` without causing an infinite loop.")
+    lines.append("if ! builtin functions --query __zoxide_cd_internal")
+    lines.append("    if status list-files functions/cd.fish &>/dev/null")
+    lines.append("        status get-file functions/cd.fish | string replace --regex -- '^function cd\\s' 'function __zoxide_cd_internal ' | source")
+    lines.append("    else")
+    lines.append("        string replace --regex -- '^function cd\\s' 'function __zoxide_cd_internal ' <$__fish_data_dir/functions/cd.fish | source")
+    lines.append("    end")
+    lines.append("end")
+    lines.append("")
+    lines.append("# cd + custom logic based on the value of _ZO_ECHO.")
+    lines.append("function __zoxide_cd")
+    lines.append("    if set -q __zoxide_loop")
+    lines.append("        builtin echo \"zoxide: infinite loop detected\"")
+    lines.append("        builtin echo \"Avoid aliasing `cd` to `z` directly, use `zoxide init --cmd=cd fish` instead\"")
+    lines.append("        return 1")
+    lines.append("    end")
+    lines.append("    __zoxide_loop=1 __zoxide_cd_internal $argv")
+    lines.append("end")
+    lines.append("")
+    lines.append("# =============================================================================")
+    lines.append("#")
+    lines.append("# Hook configuration for zoxide.")
+    lines.append("#")
+    lines.append("")
+    lines.append("# Initialize hook to add new entries to the database.")
+    lines.append("function __zoxide_hook --on-variable PWD")
+    lines.append("    test -z \"$fish_private_mode\"")
+    lines.append("    and command zoxide add -- (__zoxide_pwd)")
+    lines.append("end")
+    lines.append("")
+    lines.append("# =============================================================================")
+    lines.append("#")
+    lines.append("# When using zoxide with --no-cmd, alias these internal functions as desired.")
+    lines.append("#")
+    lines.append("")
+    lines.append("# Jump to a directory using only keywords.")
+    lines.append("function __zoxide_z")
+    lines.append("    set -l argc (builtin count $argv)")
+    lines.append("    if test $argc -eq 0")
+    lines.append("        __zoxide_cd")
+    else
+        set -l result (command zoxide query $argv)
+        if test -n "$result"
+            set -l dir (string match -r '^\S+' $result | head -n 1)
+            if test -n "$dir"
+                __zoxide_cd $dir
+            end
+        end
+    end
+end
+
+# =============================================================================
+#
+# Main zoxide command.
+#
+# =============================================================================
+function __zoxide_main
+    set -l argc (builtin count $argv)
+    set -l cmd (builtin echo $argv[1])
+    set -l args (builtin echo $argv[2..-1])
+    
+    if test $argc -eq 1
+        __zoxide_z
+    else
+        builtin eval "$args"
+    end
+end
+
+# =============================================================================
+#
+# Initialize zoxide for fish.
+#
+# =============================================================================
+function __zoxide_init
+    if test -z "$__zoxide_initialized"
+        set -g __zoxide_initialized 1
+        set -g __zoxide_pwd (__zoxide_pwd)
+        set -g __zoxide_cd (__zoxide_cd)
+        set -g __zoxide_z (__zoxide_z)
+        set -g __zoxide_main (__zoxide_main)
+        set -g __zoxide_init (__zoxide_init)
+        set -g __zoxide_hook (__zoxide_hook)
+        set -g __zoxide_complete (__zoxide_complete)
+        set -g __zoxide_complete_helper (__zoxide_complete_helper)
+        set -g __zoxide_z_complete (__zoxide_z_complete)
+        set -g __zoxide_z_complete_helper (__zoxide_z_complete_helper)
+end
+
