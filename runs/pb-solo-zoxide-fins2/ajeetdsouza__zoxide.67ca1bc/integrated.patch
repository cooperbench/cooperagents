+MAGIC = 0x03000000
+VERSION_DB = 0x00000001
+ENTRY_SIZE = 12
+
+def get_data_dir():
+    data_dir = os.environ.get("_ZO_DATA_DIR")
+    if data_dir:
+        return data_dir
+    xdg_data_home = os.environ.get("XDG_DATA_HOME")
+    if xdg_data_home:
+        return os.path.join(xdg_data_home, "zoxide")
+    return os.path.join(os.path.expanduser("~"), ".local", "share", "zoxide")
+
+def get_db_path():
+    return os.path.join(get_data_dir(), "db.zoxide")
+
+def read_db():
+    db_path = get_db_path()
+    if not os.path.exists(db_path):
+        return {}
+    
+    with open(db_path, "rb") as f:
+        magic = struct.unpack("<I", f.read(4))[0]
+        if magic != MAGIC:
+            raise ValueError("Invalid database magic number")
+        
+        version = struct.unpack("<I", f.read(4))[0]
+        if version != VERSION_DB:
+            raise ValueError("Unsupported database version")
+        
+        entries = {}
+        while True:
+            entry = f.read(ENTRY_SIZE)
+            if len(entry) < ENTRY_SIZE:
+                break
+            
+            path_len = struct.unpack("<H", entry[0:2])[0]
+            score = struct.unpack("<I", entry[2:6])[0]
+            path = entry[6:6+path_len].decode("utf-8")
+            
+            if path not in entries:
+                entries[path] = score
+            else:
+                entries[path] = max(entries[path], score)
+    
+    return entries
+
+def write_db(entries):
+    db_path = get_db_path()
+    os.makedirs(os.path.dirname(db_path), exist_ok=True)
+    
+    with open(db_path, "wb") as f:
+        f.write(struct.pack("<I", MAGIC))
+        f.write(struct.pack("<I", VERSION_DB))
+        
+        for path, score in sorted(entries.items()):
+            path_bytes = path.encode("utf-8")
+            f.write(struct.pack("<H", len(path_bytes)))
+            f.write(struct.pack("<I", score))
+            f.write(path_bytes)
+
+def add_path(path, score=None):
+    entries = read_db()
+    if score is None:
+        score = 0
+    entries[path] = max(entries.get(path, 0), score)
+    write_db(entries)
+
