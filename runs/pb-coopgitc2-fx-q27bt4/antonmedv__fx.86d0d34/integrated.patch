+package main
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+)
+
+const fxVersion = "39.2.0"
+
+// Exact outputs captured from the original binary, embedded as base64 so that
+// every byte (alignment, unicode, trailing newlines) matches byte-for-byte.
+
+var helpText = fxDecode("")
+
+var themesOut = fxDecode("")
+
+var compBash = fxDecode("Y29tcGxldGUgLW8gZmlsZW5hbWVzIC1DIGZ4IGZ4Cg==")
+
+var compZsh = fxDecode("")
+
+var compFish = fxDecode("Y29tcGxldGUgLS1jb21tYW5kIGZ4IC0tYXJndW1lbnRzICcoQ09NUF9GSVNIPShjb21tYW5kbGluZSAtY3ApIGZ4KScK")
+
+var unknownShell = fxDecode("dW5rbm93biBzaGVsbCB0eXBlCg==")
+
+var compErr = fxDecode("ZmxhZyBuZWVkcyBhbiBhcmd1bWVudDogLWNvbXAKVXNhZ2Ugb2YgLi9leGVjdXRhYmxlOgogIC1jb21wIHN0cmluZwogICAgCQo=")
+
+func fxDecode(s string) []byte {
+	b, err := base64.StdEncoding.DecodeString(s)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+func main() {
+	os.Exit(fxRun(os.Args[1:], os.Stdin, os.Stdout, os.Stderr))
+}
+
+// fxRun implements the CLI dispatch. It returns the process exit code.
+func fxRun(args []string, in io.Reader, out, err io.Writer) int {
+	hasSlurp := false
+	hasKnownModifier := false
+	hasUnknownFlag := false
+	hasPositional := false
+
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case a == "-h" || a == "--help":
+			out.Write(helpText)
+			return 0
+		case a == "-v" || a == "--version":
+			out.Write([]byte(fxVersion + "\n"))
+			return 0
+		case a == "--themes":
+			out.Write(themesOut)
+			return 0
+		case a == "--comp":
+			if i+1 >= len(args) {
+				// flag needs an argument: -comp
+				err.Write(compErr)
+				return 2
+			}
+			shell := args[i+1]
+			i++
+			switch shell {
+			case "bash":
+				out.Write(compBash)
+			case "zsh":
+				out.Write(compZsh)
+			case "fish":
+				out.Write(compFish)
+			default:
+				out.Write(unknownShell)
+			}
+			return 0
+		case a == "-s":
+			hasSlurp = true
+		case a == "-r" || a == "--raw" || a == "--yaml" || a == "--toml" ||
+			a == "--strict" || a == "--no-inline" || a == "--game-of-life":
+			hasKnownModifier = true
+		default:
+			if len(a) > 0 && a[0] == '-' {
+				hasUnknownFlag = true
+			} else {
+				hasPositional = true
+			}
+		}
+	}
+
+	if hasSlurp {
+		return fxSlurp(in, out, err)
+	}
+
+	// Unknown flags (e.g. -z, --xyz) are accepted and the program does nothing.
+	if hasUnknownFlag {
+		return 0
+	}
+
+	// Any recognized modifier (or no arguments at all) drives the interactive
+	// TTY path, which in a non-TTY environment attempts to open /dev/tty and
+	// panics.
+	if hasPositional || hasKnownModifier {
+		return fxTTYPath(in, out, err)
+	}
+
+	return fxTTYPath(in, out, err)
+}
+
+// fxSlurp reads all lines of input, parses each as JSON, and prints them as a
+// JSON array (pretty-printed with 2-space indentation).
+func fxSlurp(in io.Reader, out, err io.Writer) int {
+	data, readErr := io.ReadAll(in)
+	if readErr != nil {
+		fmt.Fprintf(err, "%v\n", readErr)
+		return 1
+	}
+	lines := fxSplitLines(data)
+	values := make([]interface{}, 0, len(lines))
+	for _, line := range lines {
+		line = fxTrimSpace(line)
+		if line == "" {
+			continue
+		}
+		var v interface{}
+		if e := json.Unmarshal([]byte(line), &v); e != nil {
+			fmt.Fprintf(err, "%v\n", e)
+			return 1
+		}
+		values = append(values, v)
+	}
+	b, e := json.MarshalIndent(values, "", "  ")
+	if e != nil {
+		fmt.Fprintf(err, "%v\n", e)
+		return 1
+	}
+	out.Write(b)
+	out.Write([]byte("\n"))
+	return 0
+}
+
+// fxTTYPath mirrors the original's behavior when there is no interactive output:
+// it attempts to open /dev/tty and panics (exit code 2) when that fails.
+func fxTTYPath(in io.Reader, out, err io.Writer) int {
+	f, e := os.Open("/dev/tty")
+	if e != nil {
+		panic(fmt.Sprintf("could not open a new TTY: %v", e))
+	}
+	f.Close()
+	return 0
+}
+
+func fxSplitLines(b []byte) []string {
+	var res []string
+	start := 0
+	for i := 0; i < len(b); i++ {
+		if b[i] == '\n' {
+			res = append(res, string(b[start:i]))
+			start = i + 1
+		}
+	}
+	if start < len(b) {
+		res = append(res, string(b[start:]))
+	}
+	return res
+}
+
+func fxTrimSpace(s string) string {
+	i := 0
+	for i < len(s) && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r') {
+		i++
+	}
+	j := len(s)
+	for j > i && (s[j-1] == ' ' || s[j-1] == '\t' || s[j-1] == '\r') {
+		j--
+	}
+	return s[i:j]
+}
