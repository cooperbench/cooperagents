diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..32b68d2
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,394 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+#include <ctype.h>
+#include <fcntl.h>
+#include <errno.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_COLS 200
+#define MAX_ROWS 100
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int only_shadows = 0;
+static int lock_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int chars_change = 0;
+static int screensaver_mode = 0;
+static int x_mode = 0;
+static int tty_set = 0;
+static int message_mode = 0;
+static int use_japanese = 0;
+
+static int delay = DEFAULT_DELAY;
+static char color[16] = "green";
+static char message[256] = "";
+static char tty_name[64] = "";
+
+static int cols, rows;
+static char matrix[MAX_COLS][MAX_ROWS];
+static int matrix_cols, matrix_rows;
+
+static struct termios orig_termios;
+static volatile sig_atomic_t quit = 0;
+static volatile sig_atomic_t first_key = 0;
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Only print the shadows of letters\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static int parse_color(const char *str) {
+    if (strcmp(str, "green") == 0) return 32;
+    if (strcmp(str, "red") == 0) return 31;
+    if (strcmp(str, "blue") == 0) return 34;
+    if (strcmp(str, "white") == 0) return 37;
+    if (strcmp(str, "yellow") == 0) return 33;
+    if (strcmp(str, "cyan") == 0) return 36;
+    if (strcmp(str, "magenta") == 0) return 35;
+    if (strcmp(str, "black") == 0) return 30;
+    return 32;
+}
+
+static void init_matrix(void) {
+    matrix_cols = 0;
+    matrix_rows = 0;
+    
+    const char *chars = "01";
+    if (use_japanese) {
+        chars = "01";
+    }
+    
+    for (int i = 0; i < MAX_COLS; i++) {
+        for (int j = 0; j < MAX_ROWS; j++) {
+            if (matrix_rows < MAX_ROWS) {
+                matrix[i][matrix_rows] = chars[matrix_cols % 2];
+                matrix_rows++;
+            }
+        }
+    }
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void set_color(int fg) {
+    printf("\033[%dm", fg);
+}
+
+static void set_bold(int bold) {
+    if (bold) {
+        printf("\033[1m");
+    } else {
+        printf("\033[22m");
+    }
+}
+
+static void set_reset(void) {
+    printf("\033[0m");
+}
+
+static int get_terminal_size(int *cols, int *rows) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        *cols = ws.ws_col;
+        *rows = ws.ws_row;
+        return 1;
+    }
+    *cols = 80;
+    *rows = 24;
+    return 0;
+}
+
+static void save_termios(void) {
+    tcgetattr(STDIN_FILENO, &orig_termios);
+}
+
+static void set_termios(void) {
+    struct termios raw;
+    raw = orig_termios;
+    raw.c_lflag &= ~(ECHO | ICANON);
+    raw.c_cc[VMIN] = 0;
+    raw.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+}
+
+static void restore_termios(void) {
+    tcsetattr(STDIN_FILENO, TCSANOW, &orig_termios);
+}
+
+static void draw_matrix(void) {
+    for (int i = 0; i < matrix_rows; i++) {
+        for (int j = 0; j < matrix_cols; j++) {
+            char c = matrix[j][i];
+            
+            if (lambda_mode) {
+                c = '?'; // lambda mode placeholder;
+            }
+            
+            if (only_shadows) {
+                c = '.';
+            }
+            
+            printf("%c", c);
+        }
+        printf("\n");
+    }
+}
+
+static void draw_message(void) {
+    if (message[0]) {
+        int msg_len = strlen(message);
+        int padding = (cols - msg_len) / 2;
+        for (int i = 0; i < padding; i++) {
+            printf(" ");
+        }
+        printf("%s\n", message);
+        for (int i = 0; i < padding; i++) {
+            printf(" ");
+        }
+    }
+}
+
+static void run(void) {
+    int fd = open("/dev/tty", O_RDONLY);
+    if (fd < 0) {
+        fd = STDIN_FILENO;
+    }
+    
+    save_termios();
+    set_termios();
+    
+    if (tty_set) {
+        close(fd);
+        fd = open(tty_name, O_RDONLY);
+        if (fd < 0) {
+            fd = STDIN_FILENO;
+        }
+        save_termios();
+        set_termios();
+    }
+    
+    if (linux_mode) {
+        printf("\033]1000;matrix.fnt\007");
+    }
+    
+    if (x_mode) {
+        printf("\033]1000;mtx.pcf\007");
+    }
+    
+    if (lock_mode) {
+        strncpy(message, "LOCKED", sizeof(message) - 1);
+        message_mode = 1;
+    }
+    
+    if (message_mode) {
+        strncpy(message, "LOCKED", sizeof(message) - 1);
+    }
+    
+    struct timeval tv;
+    fd_set readfds;
+    
+    while (!quit) {
+        FD_ZERO(&readfds);
+        FD_SET(fd, &readfds);
+        
+        tv.tv_sec = delay / 10;
+        tv.tv_usec = (delay % 10) * 100000;
+        
+        int ret = select(fd + 1, &readfds, NULL, NULL, &tv);
+        
+        if (ret < 0) {
+            if (errno == EINTR) continue;
+            break;
+        }
+        
+        if (ret > 0 && FD_ISSET(fd, &readfds)) {
+            char buf[1];
+            ssize_t n = read(fd, buf, 1);
+            if (n > 0) {
+                char c = buf[0];
+                if (c == 'q' || c == 'Q') {
+                    quit = 1;
+                } else if (c == 'a') {
+                    async_scroll = !async_scroll;
+                } else if (c == 'b') {
+                    bold_chars = !bold_chars;
+                } else if (c == 'B') {
+                    all_bold = !all_bold;
+                } else if (c == 'n') {
+                    no_bold = !no_bold;
+                } else if (isdigit(c)) {
+                    delay = c - '0';
+                } else if (c == '!') {
+                    color[0] = 'r';
+                } else if (c == '@') {
+                    color[0] = 'g';
+                } else if (c == '#') {
+                    color[0] = 'y';
+                } else if (c == '$') {
+                    color[0] = 'b';
+                } else if (c == '%') {
+                    color[0] = 'm';
+                } else if (c == '^') {
+                    color[0] = 'c';
+                } else if (c == '&') {
+                    color[0] = 'w';
+                } else if (c == ')') {
+                    color[0] = 'k';
+                }
+            }
+        }
+        
+        if (screensaver_mode && !first_key) {
+            char buf[1];
+            ssize_t n = read(fd, buf, 1);
+            if (n > 0) {
+                first_key = 1;
+                break;
+            }
+        }
+        
+        if (!old_style) {
+            clear_screen();
+        }
+        
+        set_color(parse_color(color));
+        set_bold(all_bold || (bold_chars && (rand() % 100 < 30)));
+        draw_matrix();
+        set_reset();
+        
+        if (message_mode) {
+            draw_message();
+        }
+        
+        fflush(stdout);
+    }
+    
+    restore_termios();
+}
+
+static void parse_args(int argc, char *argv[]) {
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0 || strcmp(argv[i], "--version") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            only_shadows = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            chars_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            delay = atoi(argv[++i]);
+            if (delay < 0) delay = 0;
+            if (delay > 10) delay = 10;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            strncpy(color, argv[++i], sizeof(color) - 1);
+            color[sizeof(color) - 1] = '\0';
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            strncpy(message, argv[++i], sizeof(message) - 1);
+            message[sizeof(message) - 1] = '\0';
+            message_mode = 1;
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            strncpy(tty_name, argv[++i], sizeof(tty_name) - 1);
+            tty_set = 1;
+        } else if (argv[i][0] == '-') {
+            print_usage();
+            exit(0);
+        }
+    }
+    
+    if (no_bold) {
+        bold_chars = 0;
+        all_bold = 0;
+    }
+    
+    if (!message_mode && lock_mode) {
+        strncpy(message, "LOCKED", sizeof(message) - 1);
+        message_mode = 1;
+    }
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    if (get_terminal_size(&cols, &rows)) {
+        matrix_cols = cols;
+        matrix_rows = rows;
+    } else {
+        printf("Error opening terminal: unknown.\n");
+        return 1;
+    }
+    
+    init_matrix();
+    run();
+    
+    return 0;
+}
