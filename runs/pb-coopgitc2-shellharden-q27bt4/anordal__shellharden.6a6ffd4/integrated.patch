++                    "h.md or online:\nhttps://github.com/anordal/shellharden/blob/master/ho"
++                    "w_to_do_things_safely_in_bash.md\n\n";
++
++                std::cout << help;
++                return 0;
++            }
++            if (a == "--version") {
++                std::cout << "4.3.1\n";
++                return 0;
++            }
++            if (a.size() > 0 && a[0] == '-') {
++                std::cerr << a << ": No such option.\n";
++                return 3;
++            }
++        }
++        // a file argument
++        anyInput = true;
++        if (a == "") {
++            readStdin = true;
++        } else {
++            files.push_back(a);
++        }
++    }
++
++    if (!anyInput) {
