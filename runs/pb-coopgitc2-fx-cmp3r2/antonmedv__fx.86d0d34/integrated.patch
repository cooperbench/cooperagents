+#!/usr/bin/env python3
+content = r'''package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+var (
+	version = "39.2.0"
+)
+
+func main() {
+	// Parse flags
+	help := flag.Bool("help", false, "Show help message")
+	versionFlag := flag.Bool("version", false, "Show version")
+	themes := flag.Bool("themes", false, "Show available themes")
+	comp := flag.String("comp", "", "Complete command for shell")
+	yaml := flag.Bool("yaml", false, "Parse YAML")
+	toml := flag.Bool("toml", false, "Parse TOML")
+	raw := flag.Bool("r", false, "Raw output")
+	slurp := flag.Bool("s", false, "Slurp entire input")
+	strict := flag.Bool("strict", false, "Strict mode")
+	noInline := flag.Bool("no-inline", false, "No inline mode")
+	gameOfLife := flag.Bool("game-of-life", false, "Game of life")
+	quiet := flag.Bool("quiet", false, "Quiet mode")
+	verbose := flag.Bool("verbose", false, "Verbose mode")
+	pretty := flag.Bool("pretty", false, "Pretty print")
+	indent := flag.Int("indent", 2, "Indentation for pretty print")
+	depth := flag.Int("depth", -1, "Max depth for output")
+	escape := flag.Bool("escape", false, "Escape special characters")
+	unescape := flag.Bool("unescape", false, "Unescape special characters")
+	trim := flag.Bool("trim", false, "Trim whitespace")
+	strip := flag.Bool("strip", false, "Strip comments")
+	compact := flag.Bool("compact", false, "Compact output")
+	minify := flag.Bool("minify", false, "Minify output")
+	validate := flag.Bool("validate", false, "Validate input")
+	format := flag.String("format", "json", "Output format (json, yaml, toml)")
+	output := flag.String("o", "", "Output file")
+	file := flag.String("f", "", "Input file")
+	path := flag.String("p", "", "Path to field")
+	key := flag.String("k", "", "Key to extract")
+	value := flag.String("v", "", "Value to set")
+	set := flag.Bool("set", false, "Set value")
+	delete := flag.Bool("delete", false, "Delete field")
+	insert := flag.Bool("insert", false, "Insert field")
+	update := flag.Bool("update", false, "Update field")
+	merge := flag.Bool("merge", false, "Merge objects")
+	diff := flag.Bool("diff", false, "Show diff")
+	patch := flag.Bool("patch", false, "Apply patch")
+	apply := flag.Bool("apply", false, "Apply changes")
+	transform := flag.String("transform", "", "Transform function")
+	filter := flag.String("filter", "", "Filter function")
+	mapFunc := flag.String("map", "", "Map function")
+	reduce := flag.String("reduce", "", "Reduce function")
+	sort := flag.String("sort", "", "Sort function")
+	limit := flag.Int("limit", 0, "Limit results")
+	offset := flag.Int("offset", 0, "Offset results")
+	count := flag.Int("count", 0, "Count results")
+	group := flag.String("group", "", "Group by field")
