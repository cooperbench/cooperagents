+
+fn print_help() {
+    println!("zoxide - a directory frequency indexer for zsh and bash");
+    println!();
+    println!("USAGE:");
+    println!("    zoxide <command> [options] [arguments]");
+    println!();
+    println!("COMMANDS:");
+    println!("    add <path>...    Add directories to the database");
+    println!("    query [options]  Query the database for directories");
+    println!("    remove <path>... Remove directories from the database");
+    println!("    edit            Edit the database");
+    println!("    import <from> <path>  Import from another database");
+    println!("    init <shell>    Initialize shell integration");
+    println!();
+    println!("OPTIONS:");
+    println!("    --help          Show this help message");
+    println!("    --version       Show version information");
+}
+
+fn print_version() {
+    println!("zoxide 0.9.9");
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 2 { print_help(); process::exit(1); }
+    let cmd_str = &args[1];
+    let mut cmd: Command = match cmd_str.as_str() {
+        "add" => {
+            Command::Add { score: None, paths: Vec::new() }
+        }
+        "query" => {
+            Command::Query { all: false, interactive: false, list: false, score: false, exclude: None, base_dir: None, keywords: Vec::new() }
+        }
+        "remove" => {
+            Command::Remove { paths: Vec::new() }
+        }
+        "edit" => {
+            Command::Edit
+        }
+        "import" => {
+            Command::Import { from: ImportFrom::Autojump, path: PathBuf::new(), merge: false }
+        }
+        "init" => {
+            Command::Init { shell: Shell::Bash, no_cmd: false, cmd: String::new(), hook: Hook::None }
+        }
+        _ => {
+            print_help();
+            process::exit(1);
+        }
+    };
+    let mut i = 2;
+    while i < args.len() {
+        match args[i].as_str() {
+            "--help" => { print_help(); process::exit(0); }
+            "--version" => { print_version(); process::exit(0); }
+            "add" => {
+                cmd = Command::Add { score: None, paths: Vec::new() };
+                i += 1;
+                while i < args.len() && !args[i].starts_with('-') {
+                    if let Command::Add { paths: ref mut paths, .. } = cmd { paths.push(PathBuf::from(&args[i])); }
+                    i += 1;
+                }
+            }
+            "query" => {
+                cmd = Command::Query { all: false, interactive: false, list: false, score: false, exclude: None, base_dir: None, keywords: Vec::new() };
+                i += 1;
+                while i < args.len() && !args[i].starts_with('-') {
+                    if let Command::Query { all: ref mut all, interactive: ref mut interactive, list: ref mut list, score: ref mut score, exclude: ref mut exclude, base_dir: ref mut base_dir, keywords: ref mut keywords, .. } = cmd {
+                        match args[i].as_str() {
+                            "--all" => *all = true,
+                            "--interactive" => *interactive = true,
+                            "--list" => *list = true,
+                            "--score" => *score = true,
+                            "--exclude" => { i += 1; if i < args.len() { *exclude = Some(PathBuf::from(&args[i])); } }
+                            "--base-dir" => { i += 1; if i < args.len() { *base_dir = Some(PathBuf::from(&args[i])); } }
+                            "--keywords" => { i += 1; if i < args.len() { keywords.push(args[i].clone()); } }
+                            _ => {}
+                        }
+                    }
+                    i += 1;
+                }
+            }
+            "remove" => {
+                cmd = Command::Remove { paths: Vec::new() };
+                i += 1;
+                while i < args.len() && !args[i].starts_with('-') {
+                    if let Command::Remove { paths: ref mut paths, .. } = cmd { paths.push(PathBuf::from(&args[i])); }
+                    i += 1;
+                }
+            }
+            "edit" => {
+                cmd = Command::Edit;
+                i += 1;
+            }
+            "import" => {
+                cmd = Command::Import { from: ImportFrom::Autojump, path: PathBuf::new(), merge: false };
+                i += 1;
+                while i < args.len() && !args[i].starts_with('-') {
+                    if let Command::Import { from: ref mut from, path: ref mut path, merge: ref mut merge, .. } = cmd {
+                        match args[i].as_str() {
+                            "autojump" => *from = ImportFrom::Autojump,
+                            "z" => *from = ImportFrom::Z,
+                            _ => {}
+                        }
+                    }
+                    i += 1;
+                }
+                if i < args.len() { if let Command::Import { path: ref mut path, .. } = cmd { *path = PathBuf::from(&args[i]); } i += 1; }
+                if i < args.len() && args[i] == "--merge" { if let Command::Import { merge: ref mut merge, .. } = cmd { *merge = true; } i += 1; }
+            }
+            "init" => {
+                cmd = Command::Init { shell: Shell::Bash, no_cmd: false, cmd: String::new(), hook: Hook::None };
+                i += 1;
+                while i < args.len() && !args[i].starts_with('-') {
+                    if let Command::Init { shell: ref mut shell, no_cmd: ref mut no_cmd, cmd: ref mut cmd, hook: ref mut hook, .. } = cmd {
+                        match args[i].as_str() {
+                            "bash" => *shell = Shell::Bash,
+                            "zsh" => *shell = Shell::Zsh,
+                            "fish" => *shell = Shell::Fish,
+                            "posix" => *shell = Shell::Posix,
+                            "elvish" => *shell = Shell::Elvish,
+                            "nushell" => *shell = Shell::Nushell,
+                            "tcsh" => *shell = Shell::Tcsh,
+                            "xonsh" => *shell = Shell::Xonsh,
+                            "powershell" => *shell = Shell::Powershell,
+                            _ => {}
+                        }
+                    }
+                    i += 1;
+                }
+                if i < args.len() && args[i] == "--no-cmd" { if let Command::Init { no_cmd: ref mut no_cmd, .. } = cmd { *no_cmd = true; } i += 1; }
+                if i < args.len() { if let Command::Init { cmd: ref mut cmd, .. } = cmd { *cmd = args[i].clone(); } i += 1; }
+                if i < args.len() && args[i] == "--hook" { i += 1; if i < args.len() {
+                    if let Command::Init { hook: ref mut hook, .. } = cmd {
+                        match args[i].as_str() {
+                            "prompt" => *hook = Hook::Prompt,
+                            "pwd" => *hook = Hook::Pwd,
+                            _ => {}
+                        }
+                    }
+                    i += 1;
+                } }
+            }
+            _ => {
+                print_help();
+                process::exit(1);
+            }
+        }
+        i += 1;
+    }
+    match &cmd {
+        Command::Add { score, paths } => {
+            cmd_add(*score, paths).unwrap_or_else(|e| { eprintln!("{}", e); process::exit(1); });
+        }
+        Command::Query { all, interactive, list, score, exclude, base_dir, keywords } => {
+            cmd_query(*all, *interactive, *list, *score, exclude.as_ref(), base_dir.as_ref(), keywords).unwrap_or_else(|e| { eprintln!("{}", e); process::exit(1); });
+        }
+        Command::Remove { paths } => {
+            cmd_remove(paths).unwrap_or_else(|e| { eprintln!("{}", e); process::exit(1); });
+        }
+        Command::Edit => {
+            cmd_edit().unwrap_or_else(|e| { eprintln!("{}", e); process::exit(1); });
+        }
+        Command::Import { from: ref from, path: ref path, merge: ref merge } => {
+            cmd_import(from.clone(), &*path, *merge).unwrap_or_else(|e| { eprintln!("{}", e); process::exit(1); });
+        }
+        Command::Init { shell, no_cmd, cmd, hook } => {
+            let output = match shell {
+                Shell::Bash => init_bash(*no_cmd, cmd, *hook),
+                Shell::Zsh => init_zsh(*no_cmd, cmd, *hook),
+                Shell::Fish => init_fish(*no_cmd, cmd, *hook),
+                Shell::Posix => init_posix(*no_cmd, cmd, *hook),
+                Shell::Elvish => init_elvish(*no_cmd, cmd, *hook),
+                Shell::Nushell => init_nushell(*no_cmd, cmd, *hook),
+                Shell::Tcsh => init_tcsh(*no_cmd, cmd, *hook),
+                Shell::Xonsh => init_xonsh(*no_cmd, cmd, *hook),
+                Shell::Powershell => init_powershell(*no_cmd, cmd, *hook),
+            };
+            println!("{}", output);
+        }
+    }
+}
