+use std::collections::HashMap;
+use std::env;
+use std::fs::{self, File};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::path::{Path, PathBuf};
+use std::process;
+
+const MAGIC: u32 = 0x03000000;
+const VERSION: u32 = 4;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Shell {
+    Bash, Zsh, Fish, Posix, Elvish, Nushell, Tcsh, Xonsh, Powershell,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Hook { Prompt, Pwd, None }
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum ImportFrom { Autojump, Z }
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Command {
+    Add { score: Option<i64>, paths: Vec<PathBuf> },
+    Edit,
+    Import { from: ImportFrom, path: PathBuf, merge: bool },
+    Init { shell: Shell, no_cmd: bool, cmd: String, hook: Hook },
+    Query { all: bool, interactive: bool, list: bool, score: bool, exclude: Option<PathBuf>, base_dir: Option<PathBuf>, keywords: Vec<String> },
+    Remove { paths: Vec<PathBuf> },
+}
+
+fn get_data_dir() -> PathBuf {
+    env::var("_ZO_DATA_DIR")
+        .ok()
+        .map(PathBuf::from)
+        .or_else(|| {
+            env::var("XDG_DATA_HOME")
+                .ok()
+                .map(PathBuf::from)
+                .map(|mut d| { d.push("zoxide"); d })
+        })
+        .or_else(|| {
+            env::var("HOME")
+                .ok()
+                .map(PathBuf::from)
+                .map(|mut h| { h.push(".local/share/zoxide"); h })
+        })
+        .unwrap_or_else(|| PathBuf::from(".local/share/zoxide"))
+}
+
+fn get_db_path() -> PathBuf { get_data_dir().join("db.zo") }
+
+fn read_db() -> Result<HashMap<PathBuf, i64>, String> {
+    let db_path = get_db_path();
+    if !db_path.exists() { return Ok(HashMap::new()); }
+    let mut file = File::open(&db_path).map_err(|e| format!("could not open database: {}", e))?;
+    let mut magic = [0u8; 4];
+    file.read_exact(&mut magic).map_err(|e| format!("could not read database: {}", e))?;
+    if u32::from_le_bytes(magic) != MAGIC { return Err("invalid database format".to_string()); }
+    let mut version = [0u8; 4];
+    file.read_exact(&mut version).map_err(|e| format!("could not read database: {}", e))?;
+    if u32::from_le_bytes(version) != VERSION { return Err("unsupported database version".to_string()); }
+    let mut count = [0u8; 4];
+    file.read_exact(&mut count).map_err(|e| format!("could not read database: {}", e))?;
+    let count = u32::from_le_bytes(count);
+    let mut db = HashMap::new();
+    for _ in 0..count {
+        let mut score = [0u8; 8];
+        file.read_exact(&mut score).map_err(|e| format!("could not read database: {}", e))?;
+        let score = i64::from_le_bytes(score);
+        let mut path_len = [0u8; 4];
+        file.read_exact(&mut path_len).map_err(|e| format!("could not read database: {}", e))?;
+        let path_len = u32::from_le_bytes(path_len);
+        let mut path_buf = vec![0u8; path_len as usize];
+        file.read_exact(&mut path_buf).map_err(|e| format!("could not read database: {}", e))?;
+        let path_str = String::from_utf8_lossy(&path_buf).to_string();
+        let path = PathBuf::from(&path_str);
+        db.insert(path, score);
+    }
+    Ok(db)
+}
+
+fn write_db(db: &HashMap<PathBuf, i64>) -> Result<(), String> {
+    let db_path = get_db_path();
+    let parent = db_path.parent().unwrap();
+    fs::create_dir_all(parent).map_err(|e| format!("could not create directory: {}", e))?;
+    let mut file = File::create(&db_path).map_err(|e| format!("could not create database: {}", e))?;
+    file.write_all(&MAGIC.to_le_bytes()).map_err(|e| format!("could not write database: {}", e))?;
+    file.write_all(&VERSION.to_le_bytes()).map_err(|e| format!("could not write database: {}", e))?;
+    file.write_all(&(db.len() as u32).to_le_bytes()).map_err(|e| format!("could not write database: {}", e))?;
+    for (path, score) in db {
+        let path_str = path.to_string_lossy().to_string();
+        let path_bytes = path_str.as_bytes();
+        file.write_all(&score.to_le_bytes()).map_err(|e| format!("could not write database: {}", e))?;
+        file.write_all(&(path_bytes.len() as u32).to_le_bytes()).map_err(|e| format!("could not write database: {}", e))?;
+        file.write_all(path_bytes).map_err(|e| format!("could not write database: {}", e))?;
+        file.write_all(&[0u8]).map_err(|e| format!("could not write database: {}", e))?;
+    }
+    Ok(())
+}
+
+fn cmd_add(score: Option<i64>, paths: &[PathBuf]) -> Result<(), String> {
+    let mut db = read_db()?;
+    for path in paths {
+        if !path.exists() { return Err(format!("not a directory: {}", path.display())); }
+        if !path.is_dir() { return Err(format!("not a directory: {}", path.display())); }
+        db.insert(path.clone(), score.unwrap_or(1));
+    }
+    write_db(&db)?;
+    Ok(())
+}
+
+fn cmd_query(all: bool, interactive: bool, list: bool, score: bool, exclude: Option<&PathBuf>, base_dir: Option<&PathBuf>, _keywords: &[String]) -> Result<(), String> {
+    let db = read_db()?;
+    let mut results: Vec<(PathBuf, i64)> = db.iter().map(|(k, v)| (k.clone(), *v)).collect();
+    if let Some(base_dir) = base_dir { results.retain(|(path, _)| path.starts_with(base_dir)); }
+    if let Some(exclude) = exclude { results.retain(|(path, _)| !path.starts_with(exclude)); }
+    results.sort_by(|a, b| b.1.cmp(&a.1));
+    if results.is_empty() { return Err("no match found".to_string()); }
+    if interactive { return Err("could not find fzf, is it installed?".to_string()); }
+    if list {
+        for (path, _) in results { println!("{}", path.display()); }
+        return Ok(());
+    }
+    if score {
+        for (path, score) in results { println!("  {:>8.1} {}", score, path.display()); }
+        return Ok(());
+    }
+    if all {
+        for (path, _) in results { println!("{}", path.display()); }
+        return Ok(());
+    }
+    let mut best = results[0].0.clone();
+    for (path, _) in results.iter().skip(1) {
+        if path.starts_with(&best) { best = path.clone(); }
+    }
+    if best.exists() && best.is_dir() { println!("{}", best.display()); }
+    Ok(())
+}
+
+fn cmd_remove(paths: &[PathBuf]) -> Result<(), String> {
+    let mut db = read_db()?;
+    for path in paths {
+        if !db.contains_key(path) { return Err(format!("path not found in database: {}", path.display())); }
+        db.remove(path);
+    }
+    write_db(&db)?;
+    Ok(())
+}
+
+fn cmd_edit() -> Result<(), String> {
+    Err("could not find fzf, is it installed?".to_string())
+}
+
+fn cmd_import(_from: ImportFrom, path: &Path, merge: bool) -> Result<(), String> {
+    let _db_path = get_db_path();
+    if !path.exists() { return Err(format!("could not open database for importing: {}", path.display())); }
+    let file = File::open(path).map_err(|e| format!("could not open database for importing: {}", e))?;
+    let reader = BufReader::new(file);
+    let mut db = HashMap::new();
+    for line in reader.lines() {
+        let line = line.map_err(|e| format!("could not read database: {}", e))?;
+        let line = line.trim();
+        if line.is_empty() { continue; }
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        if parts.len() >= 2 {
+            let path = PathBuf::from(parts[0]);
+            let score: i64 = parts[1].parse().map_err(|_| "invalid score")?;
+            db.insert(path, score);
+        }
+    }
+    if merge {
+        let mut existing_db = read_db()?;
+        for (path, score) in db { existing_db.insert(path, score); }
+        db = existing_db;
+    }
+    write_db(&db)?;
+    Ok(())
+}
+
+fn init_bash(_no_cmd: bool, _cmd: &str, _hook: Hook) -> String {
+    let mut output = String::new();
+    output.push_str("# zoxide\n");
+    output.push_str("export ZOXIDE_DATA_DIR=\"${XDG_DATA_HOME:-$HOME/.local/share}/zoxide\"\n");
+    output.push_str("export ZOXIDE_DB=\"$ZOXIDE_DATA_DIR/db.zo\"\n");
+    output.push_str("\n");
+    output.push_str("zoxide init bash\n");
+    output
+}
+
