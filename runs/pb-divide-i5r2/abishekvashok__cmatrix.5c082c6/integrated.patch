diff --git a/src/errors.c b/src/errors.c
new file mode 100644
index 0000000..513b5ce
--- /dev/null
+++ b/src/errors.c
@@ -0,0 +1,28 @@
+#include "errors.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+// Print error message and exit
+void errors_print_error(const char *message) {
+    fprintf(stderr, "Error: %s\n", message);
+    exit(1);
+}
+
+// Print terminal error
+void errors_print_terminal_error(void) {
+    fprintf(stderr, "Error opening terminal: unknown.\n");
+    exit(1);
+}
+
+// Print invalid color error
+void errors_print_invalid_color(void) {
+    printf(" Invalid color selection\n");
+    printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+    exit(0);
+}
+
+// Print invalid delay error
+void errors_print_invalid_delay(void) {
+    printf("Error: update delay must be between 0 and 10\n");
+    exit(1);
+}
