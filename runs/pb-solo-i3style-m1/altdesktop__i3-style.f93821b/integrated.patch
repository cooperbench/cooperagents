+            "client.unfocused_border": "#93a1a1", "client.unfocused_border": "#586e75",
+            "client.urgent": "#d33682", "client.urgent_border": "#d33682",
+            "client.urgent_border": "#fdf6e3", "client.urgent_border": "#dc322f",
+        }
+    },
+    "purple": {
+        "name": "Purple theme by AAlakkad <http://aalakkad.me>",
+        "colors": {
+            "separator": "#AAAAAA", "background": "#222133", "statusline": "#FFFFFF",
+            "focused_workspace": "#664477", "focused_workspace_inactive": "#664477",
+            "focused_workspace_border": "#cccccc", "active_workspace": "#DCCD69",
+            "active_workspace_inactive": "#DCCD69", "active_workspace_border": "#181715",
+            "inactive_workspace": "#222133", "inactive_workspace_inactive": "#222133",
+            "inactive_workspace_border": "#AAAAAA", "urgent_workspace": "#CE4045",
+            "urgent_workspace_inactive": "#CE4045", "urgent_workspace_border": "#FFFFFF",
+            "client.focused": "#664477", "client.focused_inactive": "#e7d8b1",
+            "client.focused_border": "#e7d8b1", "client.focused_inactive_border": "#e7d8b1",
+            "client.unfocused": "#222133", "client.unfocused_border": "#222133",
+            "client.unfocused_border": "#AAAAAA", "client.unfocused_border": "#A074C4",
+            "client.urgent": "#CE4045", "client.urgent_border": "#e7d8b1",
+            "client.urgent_border": "#DCCD69",
