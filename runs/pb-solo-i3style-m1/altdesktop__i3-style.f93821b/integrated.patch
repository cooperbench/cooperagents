+#!/usr/bin/env python3
+"""i3-style: Apply themes to i3 config files"""
+
+import argparse
+import os
+import sys
+import re
+import json
+from pathlib import Path
+
+VERSION = "1.0"
+DEFAULT_CONFIG = "~/.config/i3/config"
+
+THEMES = {
