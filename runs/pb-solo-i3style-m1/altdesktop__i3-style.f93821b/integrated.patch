+#!/bin/bash
+set -e
+
+# Create a zipapp from the Python script using Python API
+python3 << 'PYTHON_EOF'
+import zipapp
+zipapp.create_archive('./i3_style.py', './executable', interpreter='/usr/bin/env python3', main='i3_style:main')
+PYTHON_EOF
+
+# Make it executable
+chmod +x ./executable
