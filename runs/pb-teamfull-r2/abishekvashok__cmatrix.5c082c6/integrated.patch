+#!/bin/bash
+set -e
+
+cd /workspace
+
+# Create src directory if it doesn't exist
+mkdir -p src
+
+# Compile the matrix program
+gcc -o executable src/main.c src/matrix.c -lm -Wall -Wextra
+
+echo "Build complete: ./executable"
