+
+struct options {
+    int async;
+    int bold;
+    int all_bold;
+    int use_japanese;
+    int force_term;
+    int linux_mode;
+    int lock;
+    int old_scroll;
+    int no_bold;
+    int screensaver;
+    int x_mode;
+    int rainbow;
+    int lambda;
+    int change_chars;
+    char *message;
+    int update_delay;
+    char *color;
