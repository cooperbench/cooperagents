+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"strings"
+
+	_ "embed"
+)
+
+//go:embed assets/help.txt
+var helpText string
+
+//go:embed assets/version.txt
+var versionText string
+
+//go:embed assets/themes.txt
+var themesText string
+
+//go:embed assets/comp_bash.txt
+var compBash string
+
+//go:embed assets/comp_fish.txt
+var compFish string
+
+//go:embed assets/comp_zsh.txt
+var compZsh string
+
+//go:embed assets/comp_unknown.txt
+var compUnknown string
+
+func main() {
+	args := os.Args[1:]
+
+	// 1. Priority flags: -h/--help, -v/--version, --themes
+	for _, a := range args {
+		if a == "-h" || a == "--help" {
+			fmt.Print(helpText)
+			return
+		}
+	}
+	for _, a := range args {
+		if a == "-v" || a == "--version" {
+			fmt.Print(versionText)
+			return
+		}
+	}
+	for _, a := range args {
+		if a == "--themes" {
+			fmt.Print(themesText)
+			return
+		}
+	}
+
+	// 2. If --comp is present, use the flag package (only -comp registered) on
+	//    all args to reproduce the exact standard-flag error/success behavior.
+	if hasComp(args) {
+		fs := flag.NewFlagSet(os.Args[0], flag.ExitOnError)
+		fs.SetOutput(os.Stderr)
+		compShell := fs.String("comp", "", "")
+		fs.Parse(args)
+		switch *compShell {
+		case "bash":
+			fmt.Print(compBash)
+		case "fish":
+			fmt.Print(compFish)
+		case "zsh":
+			fmt.Print(compZsh)
+		default:
+			fmt.Print(compUnknown)
+		}
+		return
+	}
+
+	// 3. Manually parse the other flags.
+	var slurp, raw, yaml, toml, gameOfLife, strict, noInline bool
+	for _, a := range args {
+		switch a {
+		case "-s", "--slurp":
+			slurp = true
+		case "-r", "--raw":
+			raw = true
+		case "--yaml":
+			yaml = true
+		case "--toml":
+			toml = true
+		case "--strict":
+			strict = true
+		case "--no-inline":
+			noInline = true
+		case "--game-of-life":
+			gameOfLife = true
+		}
+	}
+
+	if toml {
+		tomlMode()
+		return
+	}
+
+	if gameOfLife {
+		gameOfLifeMode()
+		return
+	}
+
+	if slurp {
+		slurpMode(raw, yaml, strict, noInline)
+		return
+	}
+
+	// 5. Non-slurp modes open a TTY. Panic if unavailable.
+	openTTY()
+}
+
+func hasComp(args []string) bool {
+	for _, a := range args {
+		if a == "--comp" || a == "-comp" ||
+			strings.HasPrefix(a, "--comp=") || strings.HasPrefix(a, "-comp=") {
+			return true
+		}
+	}
+	return false
+}
+
+func openTTY() {
+	_, err := os.Open("/dev/tty")
+	if err != nil {
+		panic(err)
+	}
+}
+
+func gameOfLifeMode() {
+	// Non-TTY: this would normally start an interactive animation.
+	openTTY()
+}
+
+func tomlMode() {
+	// The original panics here due to a bug in its TOML->JSON conversion.
+	var buf []byte
+	_, _ = os.Stdin.Read(buf)
+	panic(buf)
+}
