+diff --git a/slurp.go b/slurp.go
+new file mode 100644
+index 0000000..ff69ac1
+--- /dev/null
++++ b/slurp.go
+@@ -0,0 +1,231 @@
++package main
++
++import (
++	"bytes"
++	"encoding/json"
++	"fmt"
++	"io"
++	"os"
++	"strings"
++)
++
++func slurpMode(raw, yaml, strict, noInline bool) {
++	data, err := io.ReadAll(os.Stdin)
++	if err != nil {
++		panic(err)
++	}
++
++	var values []interface{}
++	if raw {
++		s := string(data)
++		values = append(values, s)
++	} else {
++		var parseErr error
++		values, parseErr = parseValues(data, strict)
++		if parseErr != nil {
++			// Fallback: treat the whole (trimmed) input as a single array
++			// by wrapping it in brackets. This mirrors fx's lenient behaviour
++			// for comma-separated / JSON5-ish input that strict JSON rejects.
++			if wrapped, werr := parseWrapped(data); werr == nil {
++				values = wrapped
++			} else {
++				panic(parseErr)
++			}
++		}
++	}
++
++	var out bytes.Buffer
++	writeArray(&out, values, 0, true, noInline)
++	fmt.Print(out.String())
++}
++
++// parseValues reads a stream of JSON values from data.
++func parseValues(data []byte, strict bool) ([]interface{}, error) {
++	dec := json.NewDecoder(bytes.NewReader(data))
++	dec.UseNumber()
++	var values []interface{}
++	for {
++		var v interface{}
++		err := dec.Decode(&v)
++		if err == io.EOF {
++			break
++		}
++		if err != nil {
++			return nil, err
++		}
++		values = append(values, v)
++	}
++	return values, nil
++}
++
++// parseWrapped wraps the (trimmed) input in brackets and parses it as a single
++// JSON array.
++func parseWrapped(data []byte) ([]interface{}, error) {
++	s := strings.TrimSpace(string(data))
++	if s == "" {
++		return []interface{}{}, nil
++	}
++	wrapped := []byte("[")
++	wrapped = append(wrapped, []byte(s)...)
++	wrapped = append(wrapped, ']')
++	dec := json.NewDecoder(bytes.NewReader(wrapped))
++	dec.UseNumber()
++	var v []interface{}
++	if err := dec.Decode(&v); err != nil {
++		return nil, err
++	}
++	return v, nil
++}
++
++// writeArray writes a JSON array. The root array wraps float elements in a
++// nested array (matching fx's observed behavior). Inlining is recursive: an
++// array is inlined when all of its elements are "inlinable". When noInline is
++// true, arrays are always rendered in multi-line form.
++func writeArray(b *bytes.Buffer, a []interface{}, indent int, isRoot bool, noInline bool) {
++	if len(a) == 0 {
++		b.WriteString("[]")
++		return
++	}
++	if isRoot {
++		for i, e := range a {
++			if isFloatNumber(e) {
++				a[i] = []interface{}{e}
++			}
++		}
++	}
++	if !noInline && allInlinable(a) {
++		parts := make([]string, len(a))
++		for i, e := range a {
++			var sb bytes.Buffer
++			writeValue(&sb, e, indent, noInline)
++			parts[i] = sb.String()
++		}
++		b.WriteString("[ " + strings.Join(parts, ", ") + " ]")
++		return
++	}
++	b.WriteString("[\n")
++	for i, e := range a {
++		b.WriteString(spaces(indent + 1))
++		var sb bytes.Buffer
++		writeValue(&sb, e, indent+1, noInline)
++		b.WriteString(sb.String())
++		if i < len(a)-1 {
++			b.WriteString(",")
++		}
++		b.WriteString("\n")
++	}
++	b.WriteString(spaces(indent))
++	b.WriteString("]")
++}
++
++func writeValue(b *bytes.Buffer, v interface{}, indent int, noInline bool) {
++	switch v := v.(type) {
++	case nil:
++		b.WriteString("null")
++	case bool:
++		if v {
++			b.WriteString("true")
++		} else {
++			b.WriteString("false")
++		}
++	case json.Number:
++		b.WriteString(v.String())
++	case string:
++		b.WriteString(jsonQuote(v))
++	case []interface{}:
++		writeArray(b, v, indent, false, noInline)
++	case map[string]interface{}:
++		writeObject(b, v)
++	default:
++		b.WriteString("null")
++	}
++}
++
++func writeObject(b *bytes.Buffer, m map[string]interface{}) {
++	keys := make([]string, 0, len(m))
++	for k := range m {
++		keys = append(keys, k)
++	}
++	sortStrings(keys)
++	parts := make([]string, len(keys))
++	for i, k := range keys {
++		var sb bytes.Buffer
++		writeValue(&sb, m[k], 0, false)
++		parts[i] = jsonQuote(k) + ": " + sb.String()
++	}
++	b.WriteString("{ " + strings.Join(parts, ", ") + " }")
++}
++
++func allInlinable(a []interface{}) bool {
++	for _, e := range a {
++		if !inlinable(e) {
++			return false
++		}
++	}
++	return true
++}
++
++func inlinable(v interface{}) bool {
++	switch x := v.(type) {
++	case []interface{}:
++		for _, e := range x {
++			if !inlinable(e) {
++				return false
++			}
++		}
++		return true
++	default:
++		return true
++	}
++}
++
++// isFloatNumber reports whether v is a json.Number representing a non-integer
++// (it has a decimal point or exponent).
++func isFloatNumber(v interface{}) bool {
++	n, ok := v.(json.Number)
++	if !ok {
++		return false
++	}
++	s := n.String()
++	for _, c := range s {
++		if c == '.' || c == 'e' || c == 'E' {
++			return true
++		}
++	}
++	return false
++}
++
++func jsonQuote(s string) string {
++	var b bytes.Buffer
++	b.WriteByte('"')
++	for _, r := range s {
++		switch r {
++		case '"':
++			b.WriteString(`\"`)
++		case '\\':
++			b.WriteString(`\\`)
++		case '\n':
++			b.WriteString(`\n`)
++		case '\r':
++			b.WriteString(`\r`)
++		case '\t':
++			b.WriteString(`\t`)
++		default:
++			b.WriteRune(r)
++		}
++	}
++	b.WriteByte('"')
++	return b.String()
++}
++
++func spaces(n int) string {
++	return strings.Repeat(" ", n*2)
++}
++
++func sortStrings(s []string) {
++	for i := 1; i < len(s); i++ {
++		for j := i; j > 0 && s[j-1] > s[j]; j-- {
++			s[j-1], s[j] = s[j], s[j-1]
++		}
++	}
++}
diff --git a/slurp.go b/slurp.go
new file mode 100644
index 0000000..ff69ac1
--- /dev/null
+++ b/slurp.go
@@ -0,0 +1,231 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+)
+
+func slurpMode(raw, yaml, strict, noInline bool) {
+	data, err := io.ReadAll(os.Stdin)
+	if err != nil {
+		panic(err)
+	}
+
+	var values []interface{}
+	if raw {
+		s := string(data)
+		values = append(values, s)
+	} else {
+		var parseErr error
+		values, parseErr = parseValues(data, strict)
+		if parseErr != nil {
+			// Fallback: treat the whole (trimmed) input as a single array
+			// by wrapping it in brackets. This mirrors fx's lenient behaviour
+			// for comma-separated / JSON5-ish input that strict JSON rejects.
+			if wrapped, werr := parseWrapped(data); werr == nil {
+				values = wrapped
+			} else {
+				panic(parseErr)
+			}
+		}
+	}
+
+	var out bytes.Buffer
+	writeArray(&out, values, 0, true, noInline)
+	fmt.Print(out.String())
+}
+
+// parseValues reads a stream of JSON values from data.
+func parseValues(data []byte, strict bool) ([]interface{}, error) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.UseNumber()
+	var values []interface{}
+	for {
+		var v interface{}
+		err := dec.Decode(&v)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+		values = append(values, v)
+	}
+	return values, nil
+}
+
+// parseWrapped wraps the (trimmed) input in brackets and parses it as a single
+// JSON array.
+func parseWrapped(data []byte) ([]interface{}, error) {
+	s := strings.TrimSpace(string(data))
+	if s == "" {
+		return []interface{}{}, nil
+	}
+	wrapped := []byte("[")
+	wrapped = append(wrapped, []byte(s)...)
+	wrapped = append(wrapped, ']')
+	dec := json.NewDecoder(bytes.NewReader(wrapped))
+	dec.UseNumber()
+	var v []interface{}
+	if err := dec.Decode(&v); err != nil {
+		return nil, err
+	}
+	return v, nil
+}
+
+// writeArray writes a JSON array. The root array wraps float elements in a
+// nested array (matching fx's observed behavior). Inlining is recursive: an
+// array is inlined when all of its elements are "inlinable". When noInline is
+// true, arrays are always rendered in multi-line form.
+func writeArray(b *bytes.Buffer, a []interface{}, indent int, isRoot bool, noInline bool) {
+	if len(a) == 0 {
+		b.WriteString("[]")
+		return
+	}
+	if isRoot {
+		for i, e := range a {
+			if isFloatNumber(e) {
+				a[i] = []interface{}{e}
+			}
+		}
+	}
+	if !noInline && allInlinable(a) {
+		parts := make([]string, len(a))
+		for i, e := range a {
+			var sb bytes.Buffer
+			writeValue(&sb, e, indent, noInline)
+			parts[i] = sb.String()
+		}
+		b.WriteString("[ " + strings.Join(parts, ", ") + " ]")
+		return
+	}
+	b.WriteString("[\n")
+	for i, e := range a {
+		b.WriteString(spaces(indent + 1))
+		var sb bytes.Buffer
+		writeValue(&sb, e, indent+1, noInline)
+		b.WriteString(sb.String())
+		if i < len(a)-1 {
+			b.WriteString(",")
+		}
+		b.WriteString("\n")
+	}
+	b.WriteString(spaces(indent))
+	b.WriteString("]")
+}
+
+func writeValue(b *bytes.Buffer, v interface{}, indent int, noInline bool) {
+	switch v := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if v {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case json.Number:
+		b.WriteString(v.String())
+	case string:
+		b.WriteString(jsonQuote(v))
+	case []interface{}:
+		writeArray(b, v, indent, false, noInline)
+	case map[string]interface{}:
+		writeObject(b, v)
+	default:
+		b.WriteString("null")
+	}
+}
+
+func writeObject(b *bytes.Buffer, m map[string]interface{}) {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sortStrings(keys)
+	parts := make([]string, len(keys))
+	for i, k := range keys {
+		var sb bytes.Buffer
+		writeValue(&sb, m[k], 0, false)
+		parts[i] = jsonQuote(k) + ": " + sb.String()
+	}
+	b.WriteString("{ " + strings.Join(parts, ", ") + " }")
+}
+
+func allInlinable(a []interface{}) bool {
+	for _, e := range a {
+		if !inlinable(e) {
+			return false
+		}
+	}
+	return true
+}
+
+func inlinable(v interface{}) bool {
+	switch x := v.(type) {
+	case []interface{}:
+		for _, e := range x {
+			if !inlinable(e) {
+				return false
+			}
+		}
+		return true
+	default:
+		return true
+	}
+}
+
+// isFloatNumber reports whether v is a json.Number representing a non-integer
+// (it has a decimal point or exponent).
+func isFloatNumber(v interface{}) bool {
+	n, ok := v.(json.Number)
+	if !ok {
+		return false
+	}
+	s := n.String()
+	for _, c := range s {
+		if c == '.' || c == 'e' || c == 'E' {
+			return true
+		}
+	}
+	return false
+}
+
+func jsonQuote(s string) string {
+	var b bytes.Buffer
+	b.WriteByte('"')
+	for _, r := range s {
+		switch r {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\r':
+			b.WriteString(`\r`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func spaces(n int) string {
+	return strings.Repeat(" ", n*2)
+}
+
+func sortStrings(s []string) {
+	for i := 1; i < len(s); i++ {
+		for j := i; j > 0 && s[j-1] > s[j]; j-- {
+			s[j-1], s[j] = s[j], s[j-1]
+		}
+	}
+}
