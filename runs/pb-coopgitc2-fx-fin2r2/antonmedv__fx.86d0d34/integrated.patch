+  "boolean": true,
+  "null": null,
+  "collapsed": {"preview":…}
+}
+export FX_THEME="7"
+{
+  "string": "Fox jumps over the lazy dog",
+  "number": 1234567890,
+  "boolean": true,
+  "null": null,
+  "collapsed": {"preview":…}
+}
+export FX_THEME="8"
+{
+  "string": "Fox jumps over the lazy dog",
+  "number": 1234567890,
+  "boolean": true,
+  "null": null,
+  "collapsed": {"preview":…}
+}
+export FX_THEME="9"
+{
+  "string": "Fox jumps over the lazy dog",
