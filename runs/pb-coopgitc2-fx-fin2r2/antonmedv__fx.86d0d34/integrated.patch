+  "boolean": true,
+  "null": null,
+  "collapsed": {"preview":…}
+}
+export FX_THEME="3"
+{
+  "string": "Fox jumps over the lazy dog",
+  "number": 1234567890,
+  "boolean": true,
+  "null": null,
+  "collapsed": {"preview":…}
+}
+export FX_THEME="4"
+{
+  "string": "Fox jumps over the lazy dog",
