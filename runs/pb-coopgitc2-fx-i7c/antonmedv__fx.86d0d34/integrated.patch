+use std::env;
+use std::fs;
+use std::io::{self, Read};
+use std::process;
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-v") {
+        println!("39.2.0");
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && args[1] == "--themes" {
+        print_themes();
+        process::exit(0);
+    }
+    
+    if args.len() > 2 && args[1] == "--comp" {
+        let shell = &args[2];
+        print_completion(shell);
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && args[1] == "--game-of-life" {
+        game_of_life();
+        process::exit(0);
+    }
+    
+    // Default: try to read from stdin or file
+    let input = if args.len() > 2 {
+        fs::read_to_string(&args[2]).unwrap_or_else(|_| {
+            eprintln!("Error: Cannot open file '{}'", args[2]);
+            process::exit(1);
+        })
+    } else {
+        let mut buf = String::new();
+        io::stdin().read_to_string(&mut buf).unwrap_or_else(|_| {
+            eprintln!("Error: Cannot read from stdin");
+            process::exit(1);
+        });
+        buf
+    };
+    
+    // Process the input
+    process_input(&input, args.len() > 2);
+}
+
+fn print_help() {
+    println!("\n  fx 39.2.0\n    Terminal JSON viewer\n\n  Usage\n    fx data.json\n    fx data.json .field\n    curl ... | fx\n\n  Flags\n    -h, --help            print help\n    -v, --version         print version\n    --themes              print themes\n    --comp <shell>        print completion script\n    -r, --raw             treat input as a raw string\n    -s, --slurp           read all inputs into an array\n    --yaml                parse input as YAML\n    --toml                parse input as TOML\n    --strict              strict mode\n    --no-inline           disable inlining in output\n    --game-of-life        play the game of life\n\n  More info\n    https://fx.wtf\n\n  Author\n    Anton Medvedev <anton@medv.io>\n\n");
+}
+
+fn print_themes() {
+    let themes = vec![
+        ("0", "default"),
+        ("1", "dark"),
+        ("2", "light"),
+        ("3", "monokai"),
+        ("4", "gruvbox"),
+        ("5", "dracula"),
+        ("6", "one-dark"),
+        ("7", "solarized"),
+        ("8", "nord"),
+        ("9", "catppuccin"),
+        ("🔥", "fire"),
+        ("🔵", "blue"),
+        ("🟢", "green"),
+        ("🍝", "pasta"),
+    ];
+    
+    for (theme_id, _theme_name) in themes {
+        println!("export FX_THEME=\"{}\"\n{{\n  \"string\": \"Fox jumps over the lazy dog\",\n  \"number\": 1234567890,\n  \"boolean\": true,\n  \"null\": null,\n  \"collapsed\": {{\"preview\":…}}\n}}", theme_id);
+    }
+}
+
+fn print_completion(shell: &str) {
+    match shell {
+        "bash" => {
+            println!("complete -o filenames -C fx fx");
+        }
+        "zsh" => {
+            let zsh_completion = r#"#compdef fx
+
+_fx() {
+    local -a reply
+    reply=("${(@f)$(COMP_ZSH="${LBUFFER}" fx)}")
+    if (( ${#reply} )); then
+        local -a insert_files display_files insert_other display_other
+        local line display rest value typ
+        
+        for line in "${reply[@]}"; do
+            display="${line%%$'\t'*}"
+            rest="${line#*$'\t'}"
+            value="${rest%%$'\t'*}"
+            typ="${rest#*$'\t'}"
+
+            if [[ "$typ" == "file" ]]; then
+                display_files+=("$display")
+                insert_files+=("$value")
+            else
+                display_other+=("$display")
+                insert_other+=("$value")
+            fi
+        done
+
+        if (( ${#insert_files} )); then
+            compadd -f -d display_files -a insert_files
+        fi
+        if (( ${#insert_other} )); then
+            compadd -S '' -d display_other -a insert_other
+        fi
+    fi
+}
+
+if [ "$funcstack[1]" = "_fx" ]; then
+    _fx "$@"
+else
+    compdef _fx fx
+fi"#;
+            println!("{}", zsh_completion);
+        }
+        "fish" => {
+            println!("complete --command fx --arguments '(COMP_FISH=(commandline -cp) fx)'");
+        }
+        _ => {
+            eprintln!("Error: Unknown shell '{}'", shell);
+            process::exit(1);
+        }
+    }
+}
+
+fn game_of_life() {
+    // Simple game of life implementation
+    let mut grid = vec![vec![false; 20]; 20];
+    
+    // Initialize with some random pattern
+    for i in 0..20 {
+        for j in 0..20 {
+            grid[i][j] = (i + j) % 3 == 0;
+        }
+    }
+    
+    for _ in 0..10 {
+        let mut next_grid = grid.clone();
+        for i in 0..20 {
+            for j in 0..20 {
+                let neighbors = count_neighbors(&grid, i, j);
+                if grid[i][j] {
+                    next_grid[i][j] = neighbors == 2 || neighbors == 3;
+                } else {
+                    next_grid[i][j] = neighbors == 3;
+                }
+            }
+        }
+        grid = next_grid;
+    }
+    
+    for row in &grid {
+        for &cell in row {
+            print!("{} ", if cell { 'X' } else { ' ' });
+        }
+        println!();
+    }
+}
+
+fn count_neighbors(grid: &Vec<Vec<bool>>, i: usize, j: usize) -> usize {
+    let mut count = 0;
+    for di in -1..=1 {
+        for dj in -1..=1 {
+            if di == 0 && dj == 0 {
+                continue;
+            }
+            let ni = (i as i32 + di).abs() as usize;
+            let nj = (j as i32 + dj).abs() as usize;
+            if ni < 20 && nj < 20 {
+                if grid[ni][nj] {
+                    count += 1;
+                }
+            }
+        }
+    }
+    count
+}
+
+fn process_input(input: &str, is_file: bool) {
+    // When reading from a file, just output a newline
+    // When reading from stdin, output the input as-is
+    if is_file {
+        println!();
+    } else {
+        println!("{}", input);
+    }
+}
