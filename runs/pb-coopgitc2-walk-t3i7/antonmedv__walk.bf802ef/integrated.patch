+package main
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+)
+
+type Walk struct {
+	path         string
+	showIcons    bool
+	dirOnly      bool
+	hideHidden   bool
+	preview      bool
+	withBorder   bool
+	fuzzy        bool
+}
+
+func main() {
+	if len(os.Args) > 1 && os.Args[1] == "--help" {
+		printHelp()
+		os.Exit(0)
+	}
+	if len(os.Args) > 1 && os.Args[1] == "--version" {
+		fmt.Println("v1.13.0")
+		os.Exit(0)
+	}
+
+	w := &Walk{}
+	showIcons := false
+	dirOnly := false
+	hideHidden := false
+	preview := false
+	withBorder := false
+	fuzzy := false
+
+	for i := 1; i < len(os.Args); i++ {
+		switch os.Args[i] {
+		case "--icons":
+			showIcons = true
+		case "--dir-only":
+			dirOnly = true
+		case "--hide-hidden":
+			hideHidden = true
+		case "--preview":
+			preview = true
+		case "--with-border":
+			withBorder = true
+		case "--fuzzy":
+			fuzzy = true
+		}
+	}
+
+	w.showIcons = showIcons
+	w.dirOnly = dirOnly
+	w.hideHidden = hideHidden
+	w.preview = preview
+	w.withBorder = withBorder
+	w.fuzzy = fuzzy
+
+	if len(os.Args) > 2 {
+		w.path = os.Args[2]
+	} else {
+		w.path = "."
+	}
+
+	files := listFiles(w.path, w)
+	printFiles(files, w)
+}
+
+func printHelp() {
+	fmt.Println()
+	fmt.Println("  walk v1.13.0")
+	fmt.Println()
+	fmt.Println("  Usage: walk [path]")
+	fmt.Println()
+	fmt.Println("    arrows, hjkl  Move cursor")
+	fmt.Println("    enter         Enter directory")
+	fmt.Println("    backspace     Exit directory")
+	fmt.Println("    space         Toggle preview")
+	fmt.Println("    esc, q        Exit with cd")
+	fmt.Println("    ctrl+c        Exit without cd")
+	fmt.Println("    /             Fuzzy search")
+	fmt.Println("    d, delete     Delete file or dir")
+	fmt.Println("    y             Copy to clipboard")
+	fmt.Println("    .             Hide hidden files")
+	fmt.Println("    ?             Show help")
+	fmt.Println()
+	fmt.Println("  Flags:")
+	fmt.Println()
+	fmt.Println("    --icons        display icons")
+	fmt.Println("    --dir-only     show dirs only")
+	fmt.Println("    --hide-hidden  hide hidden files")
+	fmt.Println("    --preview      display preview")
+	fmt.Println("    --with-border  preview with border")
+	fmt.Println("    --fuzzy        fuzzy mode")
+	fmt.Println()
+}
+
+func listFiles(path string, w *Walk) []string {
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		return nil
+	}
+
+	var files []string
+	for _, entry := range entries {
+		if w.hideHidden && strings.HasPrefix(entry.Name(), ".") {
+			continue
+		}
+		if w.dirOnly && !entry.IsDir() {
+			continue
+		}
+		files = append(files, entry.Name())
+	}
+
+	sort.Strings(files)
+	return files
+}
+
+func printFiles(files []string, w *Walk) {
+	for _, file := range files {
+		fmt.Println(file)
+	}
+}
