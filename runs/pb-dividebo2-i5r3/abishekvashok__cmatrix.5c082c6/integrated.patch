+#ifndef OPTIONS_H
+#define OPTIONS_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <getopt.h>
+
+// Option structure
+typedef struct {
+    int async_scroll;
+    int bold_chars;
+    int all_bold;
+    int force_term;
+    int linux_mode;
+    int old_scroll;
+    int only_shadows;
+    int lock_mode;
+    int rainbow_mode;
+    int lambda_mode;
+    int chars_change;
+    int screensaver;
+    int x_window;
+    int no_bold;
+    int help;
+    int version;
+    int tty_set;
+    int message_set;
+    int color_set;
+    int update_set;
+    
+    char *tty;
+    char *message;
+    char *color;
+    int update_delay;
+    
+    int error_occurred;
+    char error_msg[256];
+} Options;
+
+// Initialize options with defaults
+void options_init(Options *opts);
+
+// Parse command line arguments
+int options_parse(int argc, char **argv, Options *opts);
+
+// Print help message
+void options_print_help(void);
+
+// Print version message
+void options_print_version(void);
+
+// Print error message and exit
+void options_error(const char *msg);
+
+#endif // OPTIONS_H
