+fn print_help() {
+    println!("i3-style 1.0");
+    println!("Make your i3 config a bit more stylish");
+    println!();
+    println!("USAGE:");
+    println!("    executable [FLAGS] [OPTIONS] [theme]");
+    println!();
+    println!("FLAGS:");
+    println!("    -h, --help        Prints help information");
+    println!("    -l, --list-all    Print a list of all available themes");
+    println!("    -r, --reload      Apply the theme by reloading the config");
+    println!("    -s, --save        Set the output file to the path of the input file");
+    println!("    -V, --version     Prints version information");
+    println!();
+    println!("OPTIONS:");
+    println!("    -c, --config <file>      The config file the theme should be applied to. Defaults to the default i3 location.");
+    println!("    -o, --output <file>      Apply the theme, attempt to validate the result, and write it to <file>");
+    println!("    -t, --to-theme <file>    Prints an i3-style theme based on the given config suitable for sharing with others");
+    println!("                             [default: ]");
+    println!();
+    println!("ARGS:");
+    println!("    <theme>    The theme to use");
+}
