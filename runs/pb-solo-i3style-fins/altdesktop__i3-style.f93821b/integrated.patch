+fn load_theme(theme_name: &str) -> Result<String, String> {
+    let theme_path = format!("/tmp/i3-style/{}/{}.yaml", std::process::id(), theme_name);
+    
+    if let Ok(content) = fs::read_to_string(&theme_path) {
+        Ok(content)
+    } else {
+        Err(format!("Could not open theme: {}", theme_path))
+    }
+}
+
+fn parse_yaml_simple(content: &str) -> HashMap<String, String> {
+    let mut result = HashMap::new();
+    let lines: Vec<&str> = content.lines().collect();
+    
+    for line in lines {
+        let trimmed = line.trim();
+        if trimmed.starts_with("colors:") {
+            continue;
+        }
+        if trimmed.starts_with("window_colors:") {
+            continue;
+        }
+        if trimmed.starts_with("bar_colors:") {
+            continue;
+        }
+        if trimmed.starts_with("meta:") {
+            continue;
+        }
+        if trimmed.starts_with("description:") {
+            continue;
+        }
+        
+        if trimmed.starts_with("  ") && !trimmed.starts_with("    ") {
+            let parts: Vec<&str> = trimmed.splitn(2, ':').collect();
+            if parts.len() == 2 {
+                let key = parts[0].trim().to_string();
+                let value = parts[1].trim().to_string();
+                result.insert(key, value);
+            }
+        }
+    }
+    
+    result
+}
+
+fn apply_theme_to_config(config: &str, theme_yaml: &str) -> String {
+    let mut result = String::new();
+    
+    // Parse the config to extract key parts
+    let config_lines: Vec<&str> = config.lines().collect();
+    
+    // Find the bar section and client sections
+    let mut in_bar = false;
+    let mut in_colors = false;
+    let mut bar_content = String::new();
+    let mut client_content = String::new();
+    let mut other_content = String::new();
+    let mut in_client = false;
+    
+    for line in &config_lines {
+        let trimmed = line.trim();
+        
+        if trimmed.starts_with("bar {") {
+            in_bar = true;
+            in_colors = false;
+            bar_content.push_str(line);
+            bar_content.push('\n');
+            continue;
+        }
+        
+        if trimmed == "}" && in_bar {
+            in_bar = false;
+            bar_content.push_str(line);
+            bar_content.push('\n');
+            continue;
+        }
+        
+        if in_bar {
+            if trimmed.starts_with("colors {") {
+                in_colors = true;
+                bar_content.push_str(line);
+                bar_content.push('\n');
+                continue;
+            }
+            
+            if trimmed == "}" && in_colors {
+                in_colors = false;
+                bar_content.push_str(line);
+                bar_content.push('\n');
+                continue;
+            }
+            
+            if in_colors {
+                bar_content.push_str(line);
+                bar_content.push('\n');
+                continue;
+            }
+        }
+        
+        if trimmed.starts_with("client.") {
+            in_client = true;
+            client_content.push_str(line);
+            client_content.push('\n');
+            continue;
+        }
+        
+        if in_client {
+            if trimmed.starts_with("client.") {
+                client_content.push('\n');
+            }
+            client_content.push_str(line);
+            client_content.push('\n');
+            continue;
+        }
+        
+        other_content.push_str(line);
+        other_content.push('\n');
+    }
+    
+    // Build the new config
+    result.push_str(&other_content);
+    result.push_str(&bar_content);
+    result.push_str(&client_content);
+    
+    // Parse theme colors
+    let theme_colors = parse_yaml_simple(theme_yaml);
+    
+    // Apply theme colors to bar
+    let separator = theme_colors.get("separator").map_or("#AAAAAA", |v| v.as_str());
+    let background = theme_colors.get("background").map_or("#222133", |v| v.as_str());
+    let statusline = theme_colors.get("statusline").map_or("#FFFFFF", |v| v.as_str());
+    
+    // Update focused_workspace
+    let focused_ws = format!(
+        "#{} #{} #{} #{}",
+        theme_colors.get("focused_workspace").map_or("#664477", |v| v.as_str()),
+        theme_colors.get("focused_workspace").map_or("#664477", |v| v.as_str()),
+        theme_colors.get("focused_workspace").map_or("#cccccc", |v| v.as_str()),
+        theme_colors.get("focused_workspace").map_or("#664477", |v| v.as_str())
+    );
+    result = result.replace("#664477 #664477 #cccccc", &focused_ws);
+    
+    // Update urgent_workspace
+    let urgent_ws = format!(
+        "#{} #{} #{} #{}",
+        theme_colors.get("urgent_workspace").map_or("#CE4045", |v| v.as_str()),
+        theme_colors.get("urgent_workspace").map_or("#CE4045", |v| v.as_str()),
+        theme_colors.get("urgent_workspace").map_or("#FFFFFF", |v| v.as_str()),
+        theme_colors.get("urgent_workspace").map_or("#CE4045", |v| v.as_str())
+    );
+    result = result.replace("#CE4045 #CE4045 #FFFFFF", &urgent_ws);
+    
+    // Apply theme colors to clients
+    let focused_border = theme_colors.get("focused").map_or("#664477", |v| v.as_str());
+    let focused_bg = theme_colors.get("focused").map_or("#664477", |v| v.as_str());
+    let focused_text = theme_colors.get("focused").map_or("#cccccc", |v| v.as_str());
+    let focused_indicator = theme_colors.get("focused").map_or("#e7d8b1", |v| v.as_str());
+    
+    let focused_client = format!(
+        "#{} #{} #{} #{}",
+        focused_border, focused_bg, focused_text, focused_indicator
+    );
+    result = result.replace("#664477 #664477 #cccccc #e7d8b1", &focused_client);
+    
+    let focused_inactive_border = theme_colors.get("focused_inactive").map_or("#e7d8b1", |v| v.as_str());
+    let focused_inactive_bg = theme_colors.get("focused_inactive").map_or("#e7d8b1", |v| v.as_str());
+    let focused_inactive_text = theme_colors.get("focused_inactive").map_or("#181715", |v| v.as_str());
+    let focused_inactive_indicator = theme_colors.get("focused_inactive").map_or("#A074C4", |v| v.as_str());
+    
+    let focused_inactive_client = format!(
+        "#{} #{} #{} #{}",
+        focused_inactive_border, focused_inactive_bg, focused_inactive_text, focused_inactive_indicator
+    );
+    result = result.replace("#e7d8b1 #e7d8b1 #181715 #A074C4", &focused_inactive_client);
+    
+    let unfocused_border = theme_colors.get("unfocused").map_or("#222133", |v| v.as_str());
+    let unfocused_bg = theme_colors.get("unfocused").map_or("#222133", |v| v.as_str());
+    let unfocused_text = theme_colors.get("unfocused").map_or("#AAAAAA", |v| v.as_str());
+    let unfocused_indicator = theme_colors.get("unfocused").map_or("#A074C4", |v| v.as_str());
+    
+    let unfocused_client = format!(
+        "#{} #{} #{} #{}",
+        unfocused_border, unfocused_bg, unfocused_text, unfocused_indicator
+    );
+    result = result.replace("#222133 #222133 #AAAAAA #A074C4", &unfocused_client);
+    
+    let urgent_border = theme_colors.get("urgent").map_or("#CE4045", |v| v.as_str());
+    let urgent_bg = theme_colors.get("urgent").map_or("#CE4045", |v| v.as_str());
+    let urgent_text = theme_colors.get("urgent").map_or("#e7d8b1", |v| v.as_str());
+    let urgent_indicator = theme_colors.get("urgent").map_or("#DCCD69", |v| v.as_str());
+    
+    let urgent_client = format!(
+        "#{} #{} #{} #{}",
+        urgent_border, urgent_bg, urgent_text, urgent_indicator
+    );
+    result = result.replace("#CE4045 #CE4045 #e7d8b1 #DCCD69", &urgent_client);
+    
+    // Update bar colors
+    result = result.replace("#AAAAAA", separator);
+    result = result.replace("#222133", background);
+    result = result.replace("#FFFFFF", statusline);
+    
+    result
+}
+
+fn convert_config_to_theme(config: &str) -> String {
+    let mut colors: HashMap<String, String> = HashMap::new();
+    
+    // Extract colors from bar section
+    let config_lines: Vec<&str> = config.lines().collect();
+    let mut in_bar = false;
+    let mut in_colors = false;
+    
+    for line in &config_lines {
+        let trimmed = line.trim();
+        
+        if trimmed.starts_with("bar {") {
+            in_bar = true;
+            continue;
+        }
+        
+        if trimmed == "}" && in_bar {
+            in_bar = false;
+            continue;
+        }
+        
+        if in_bar && trimmed.starts_with("colors {") {
+            in_colors = true;
+            continue;
+        }
+        
+        if in_bar && trimmed == "}" && in_colors {
+            in_colors = false;
+            continue;
+        }
+        
+        if in_colors {
+            if trimmed.starts_with("separator") {
+                if let Some(end) = trimmed.find('#') {
+                    let color = trimmed[end..].trim().to_string();
+                    colors.insert("separator".to_string(), color);
+                }
+            } else if trimmed.starts_with("background") {
+                if let Some(end) = trimmed.find('#') {
+                    let color = trimmed[end..].trim().to_string();
+                    colors.insert("background".to_string(), color);
+                }
+            } else if trimmed.starts_with("statusline") {
+                if let Some(end) = trimmed.find('#') {
+                    let color = trimmed[end..].trim().to_string();
+                    colors.insert("statusline".to_string(), color);
+                }
+            } else if trimmed.starts_with("focused_workspace") {
+                if let Some(end) = trimmed.find('#') {
+                    let rest = trimmed[end..].trim();
+                    let parts: Vec<&str> = rest.split('#').collect();
+                    if parts.len() >= 4 {
+                        colors.insert("focused_workspace".to_string(), parts[0].to_string());
+                    }
+                }
+            } else if trimmed.starts_with("urgent_workspace") {
+                if let Some(end) = trimmed.find('#') {
+                    let rest = trimmed[end..].trim();
+                    let parts: Vec<&str> = rest.split('#').collect();
+                    if parts.len() >= 4 {
+                        colors.insert("urgent_workspace".to_string(), parts[0].to_string());
+                    }
+                }
+            }
+        }
+    }
+    
+    // Extract client colors
+    let mut in_client = false;
+    for line in &config_lines {
+        let trimmed = line.trim();
+        
+        if trimmed.starts_with("client.") {
+            in_client = true;
+            continue;
+        }
+        
+        if in_client {
+            if trimmed.starts_with("client.") {
+                if let Some(end) = trimmed.find('#') {
+                    let rest = trimmed[end..].trim();
+                    let parts: Vec<&str> = rest.split('#').collect();
+                    if parts.len() >= 4 {
+                        let client_type = trimmed.split('#').next().unwrap_or("").to_string();
+                        colors.insert(client_type, parts[0].to_string());
+                    }
+                }
+            }
+        }
+    }
+    
+    // Build theme YAML
+    let mut yaml = String::from("---\nmeta:\n  description: AUTOMATICALLY GENERATED THEME\n");
+    yaml.push_str("colors:\n");
+    
+    for (key, value) in &colors {
+        yaml.push_str(&format!("  {}: \"{}\"\n", key, value));
+    }
+    
+    yaml.push_str("window_colors:\n");
+    yaml.push_str("  focused:\n");
+    yaml.push_str(&format!("    border: {}\n", colors.get("focused").map_or("#664477", |v| v.as_str())));
+    yaml.push_str(&format!("    background: {}\n", colors.get("focused").map_or("#664477", |v| v.as_str())));
+    yaml.push_str(&format!("    text: {}\n", colors.get("focused").map_or("#cccccc", |v| v.as_str())));
+    yaml.push_str(&format!("    indicator: {}\n", colors.get("focused").map_or("#e7d8b1", |v| v.as_str())));
+    
+    yaml.push_str("  focused_inactive:\n");
+    yaml.push_str(&format!("    border: {}\n", colors.get("focused_inactive").map_or("#e7d8b1", |v| v.as_str())));
+    yaml.push_str(&format!("    background: {}\n", colors.get("focused_inactive").map_or("#e7d8b1", |v| v.as_str())));
+    yaml.push_str(&format!("    text: {}\n", colors.get("focused_inactive").map_or("#181715", |v| v.as_str())));
+    yaml.push_str(&format!("    indicator: {}\n", colors.get("focused_inactive").map_or("#A074C4", |v| v.as_str())));
+    
+    yaml.push_str("  unfocused:\n");
+    yaml.push_str(&format!("    border: {}\n", colors.get("unfocused").map_or("#222133", |v| v.as_str())));
+    yaml.push_str(&format!("    background: {}\n", colors.get("unfocused").map_or("#222133", |v| v.as_str())));
+    yaml.push_str(&format!("    text: {}\n", colors.get("unfocused").map_or("#AAAAAA", |v| v.as_str())));
+    yaml.push_str(&format!("    indicator: {}\n", colors.get("unfocused").map_or("#A074C4", |v| v.as_str())));
+    
+    yaml.push_str("  urgent:\n");
+    yaml.push_str(&format!("    border: {}\n", colors.get("urgent").map_or("#CE4045", |v| v.as_str())));
+    yaml.push_str(&format!("    background: {}\n", colors.get("urgent").map_or("#CE4045", |v| v.as_str())));
+    yaml.push_str(&format!("    text: {}\n", colors.get("urgent").map_or("#e7d8b1", |v| v.as_str())));
+    yaml.push_str(&format!("    indicator: {}\n", colors.get("urgent").map_or("#DCCD69", |v| v.as_str())));
+    
+    yaml.push_str("bar_colors:\n");
+    yaml.push_str(&format!("  background: {}\n", colors.get("background").map_or("#222133", |v| v.as_str())));
+    yaml.push_str(&format!("  statusline: {}\n", colors.get("statusline").map_or("#FFFFFF", |v| v.as_str())));
+    yaml.push_str(&format!("  separator: {}\n", colors.get("separator").map_or("#AAAAAA", |v| v.as_str())));
+    yaml.push_str("  focused_workspace:\n");
+    yaml.push_str(&format!("    border: {}\n", colors.get("focused_workspace").map_or("#664477", |v| v.as_str())));
+    yaml.push_str(&format!("    background: {}\n", colors.get("focused_workspace").map_or("#664477", |v| v.as_str())));
+    yaml.push_str(&format!("    text: {}\n", colors.get("focused_workspace").map_or("#cccccc", |v| v.as_str())));
+    yaml.push_str("  urgent_workspace:\n");
+    yaml.push_str(&format!("    border: {}\n", colors.get("urgent_workspace").map_or("#CE4045", |v| v.as_str())));
+    yaml.push_str(&format!("    background: {}\n", colors.get("urgent_workspace").map_or("#CE4045", |v| v.as_str())));
+    yaml.push_str(&format!("    text: {}\n", colors.get("urgent_workspace").map_or("#FFFFFF", |v| v.as_str())));
+    
+    yaml
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() < 2 {
+        print_help();
+        process::exit(1);
+    }
+    
+    let mut i = 1;
+    let mut theme: Option<String> = None;
+    let mut config: Option<String> = None;
+    let mut output: Option<String> = None;
+    let mut to_theme: Option<String> = None;
+    let mut list_all = false;
+    let mut reload = false;
+    let mut save = false;
+    
+    while i < args.len() {
+        let arg = &args[i];
+        
+        if arg == "-h" || arg == "--help" {
+            print_help();
+            process::exit(0);
+        } else if arg == "-l" || arg == "--list-all" {
+            print_list_all();
+            process::exit(0);
+        } else if arg == "-r" || arg == "--reload" {
+            reload = true;
+            i += 1;
+            continue;
+        } else if arg == "-s" || arg == "--save" {
+            save = true;
+            i += 1;
+            continue;
+        } else if arg == "-V" || arg == "--version" {
+            print_version();
+            process::exit(0);
+        } else if arg == "-c" || arg == "--config" {
+            if i + 1 < args.len() {
+                config = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: The following required argument was not provided: --config <file>");
+                process::exit(1);
+            }
+        } else if arg == "-o" || arg == "--output" {
+            if i + 1 < args.len() {
+                output = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: The following required argument was not provided: --output <file>");
+                process::exit(1);
+            }
+        } else if arg == "-t" || arg == "--to-theme" {
+            if i + 1 < args.len() {
+                to_theme = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: The following required argument was not provided: --to-theme <file>");
+                process::exit(1);
+            }
+        } else if arg.starts_with('-') {
+            eprintln!("error: Unknown flag: {}", arg);
+            process::exit(1);
+        } else {
+            theme = Some(arg.clone());
+            i += 1;
+        }
+    }
+    
+    if list_all {
+        print_list_all();
+        return;
+    }
+    
+    if to_theme.is_some() {
+        let config_path = to_theme.unwrap();
+        let config = match fs::read_to_string(&config_path) {
+            Ok(content) => content,
+            Err(e) => {
+                eprintln!("Could not open config: {} - {}", config_path, e);
+                process::exit(1);
+            }
+        };
+        let theme_yaml = convert_config_to_theme(&config);
+        println!("{}", theme_yaml);
+        return;
+    }
+    
+    let theme_name = match &theme {
+        Some(t) => t.clone(),
+        None => {
+            eprintln!("Select a theme as the first argument. Use `i3-style --list-all` to see the themes.");
+            process::exit(1);
+        }
+    };
+    
+    let theme_yaml = match load_theme(&theme_name) {
+        Ok(t) => t,
+        Err(e) => {
+            eprintln!("{}", e);
+            eprintln!(" Use `i3-style --list-all` to see the available themes.");
+            process::exit(1);
+        }
+    };
+    
+    let config_path = match &config {
+        Some(c) => c.clone(),
+        None => "~/.config/i3/config".to_string(),
+    };
+    
+    let config = match fs::read_to_string(&config_path) {
+        Ok(content) => content,
+        Err(e) => {
+            eprintln!("Could not find i3 config");
+            process::exit(1);
+        }
+    };
+    
+    let output_path = if save {
+        config_path.clone()
+    } else {
+        match &output {
+            Some(o) => o.clone(),
+            None => config_path.clone(),
+        }
+    };
+    
+    let output_path_expanded = match fs::canonicalize(&output_path) {
+        Ok(path) => path.to_string_lossy().to_string(),
+        Err(_) => output_path.clone(),
+    };
+    
+    let new_config = apply_theme_to_config(&config, &theme_yaml);
+    
+    // Create temp directory for i3-style
+    let temp_dir = format!("/tmp/i3-style/{}", std::process::id());
+    fs::create_dir_all(&temp_dir).ok();
+    
+    // Save config for validation
+    let config_input_path = format!("{}/config-input", temp_dir);
+    fs::write(&config_input_path, &config).ok();
+    
+    eprintln!("saving config at {} to {}/config-input", config_path, temp_dir);
+    
+    // Validate config
+    let validation_output = std::process::Command::new("i3")
+        .args(&["-C", "-c", &config_input_path])
+        .output();
+    
+    if let Ok(output) = validation_output {
+        if !output.status.success() {
+            let stderr = String::from_utf8_lossy(&output.stderr);
+            eprintln!("Could not validate config with `i3 -C -c` {}", stderr.trim());
+            process::exit(1);
+        }
+    }
+    
+    // Write output
+    fs::write(&output_path_expanded, &new_config).ok();
+    
+    // Reload if requested
+    if reload {
+        let reload_output = std::process::Command::new("i3-msg")
+            .arg("reload")
+            .output();
+        
+        if let Ok(output) = reload_output {
+            if !output.status.success() {
+                let stderr = String::from_utf8_lossy(&output.stderr);
+                eprintln!("Could not reload config with i3-msg: {}", stderr.trim());
+            }
+        }
+    }
+}
