+//! zoxide - jump to frequently used directories from the command line.
+//!
+//! This module restores the zoxide source for the merged tree, implementing
+//! the command surface documented in `README.md`:
+//!
+//! * `zoxide add`     - add a new directory to the database, or bump its rank
+//! * `zoxide import`  - import entries from another application
+//! * `zoxide init`    - generate shell configuration
+//! * `zoxide query`   - search for a directory in the database
+//! * `zoxide remove`  - remove a directory from the database
+//!
+//! It uses only the Rust standard library so that the project builds in
+//! fully offline environments (no crates.io index or network required).
+
+use std::cmp::Ordering;
+use std::collections::HashMap;
+use std::env;
+use std::fs;
+use std::io::{self, Write};
+use std::path::{Component, Path, PathBuf};
+use std::process::ExitCode;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const VERSION: &str = env!("CARGO_PKG_VERSION");
+const DEFAULT_MAX_AGE: i64 = 10_000;
+const RESULTS_LIMIT: usize = 10;
+
+// ---------------------------------------------------------------------------
+// configuration
+// ---------------------------------------------------------------------------
+
+/// Runtime configuration, taken from the documented `_ZO_*` environment
+/// variables.
+#[derive(Debug, Clone)]
+struct Config {
+    max_age: i64,
+    exclude: Vec<String>,
+    resolve_symlinks: bool,
+}
+
+impl Config {
+    fn load() -> Self {
+        let max_age = env::var("_ZO_MAXAGE")
+            .ok()
+            .and_then(|v| v.parse::<i64>().ok())
+            .filter(|v| *v > 0)
+            .unwrap_or(DEFAULT_MAX_AGE);
+
+        let separator = if cfg!(target_os = "windows") { ';' } else { ':' };
+        let default_exclude = env::var("HOME").unwrap_or_default();
+        let raw = env::var("_ZO_EXCLUDE_DIRS").unwrap_or(default_exclude);
+        let exclude: Vec<String> = raw
+            .split(separator)
+            .map(str::to_string)
+            .filter(|s| !s.is_empty())
+            .collect();
+
+        let resolve_symlinks = env::var("_ZO_RESOLVE_SYMLINKS").ok().as_deref() == Some("1");
+
+        Config { max_age, exclude, resolve_symlinks }
+    }
+
+    /// Whether `path` falls inside one of the excluded directories.
+    fn is_excluded(&self, path: &Path) -> bool {
+        let s = path.to_string_lossy();
+        self.exclude.iter().any(|glob| {
+            let g = expand_tilde(glob);
+            let mut under = false;
+            if let Some(prefix) = g.strip_suffix('/') {
+                // a trailing slash means "the directory and everything below"
+                under = s.starts_with(prefix);
+            }
+            glob_match(&g, &s) || under
+        })
+    }
+}
+
+// ---------------------------------------------------------------------------
+// small helpers
+// ---------------------------------------------------------------------------
+
+/// Expand a leading `~` / `~/...` into `$HOME`.
+fn expand_tilde(s: &str) -> String {
+    if s == "~" {
+        env::var("HOME").unwrap_or_else(|_| s.to_string())
+    } else if let Some(rest) = s.strip_prefix("~/") {
+        format!("{}/{}", env::var("HOME").unwrap_or_default(), rest)
+    } else {
+        s.to_string()
+    }
+}
+
+/// Remove `.`, `..` and redundant separators from an absolute path.
+fn normalize(p: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for comp in p.components() {
+        match comp {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                out.pop();
+            }
+            c => out.push(c.as_os_str()),
+        }
+    }
+    if out.as_os_str().is_empty() {
+        out.push("/");
+    }
+    out
+}
+
+/// Case-sensitive glob match supporting `*` (any run, including `/`) and
+/// `?` (any single character).
+fn glob_match(pattern: &str, text: &str) -> bool {
+    let p: Vec<char> = pattern.chars().collect();
+    let t: Vec<char> = text.chars().collect();
+    let mut i = 0;
+    let mut j = 0;
+    let mut star: Option<(usize, usize)> = None;
+    while j < t.len() {
+        if i < p.len() && (p[i] == '?' || p[i] == t[j]) {
+            i += 1;
+            j += 1;
+        } else if i < p.len() && p[i] == '*' {
+            star = Some((i, j));
+            i += 1;
+        } else if let Some((si, sj)) = star {
+            star = Some((si, sj + 1));
+            j = sj;
+        } else {
+            return false;
+        }
+    }
+    while i < p.len() && p[i] == '*' {
+        i += 1;
+    }
+    i == p.len()
+}
+
+/// Whole-second precision is overkill; zoid works in days since epoch.
+fn now() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs() as i64 / 86_400)
+        .unwrap_or(0)
+}
+
+/// Relative recency factor: `3.0 ^ (age / max_age)`.
+fn factor(visit: i64, now: i64, max_age: i64) -> f64 {
+    if visit >= now {
+        1.0
+    } else {
+        let recency = (now - visit) as f64 / max_age as f64;
+        3.0f64.powf(recency)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// database
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy)]
+struct Entry {
+    score: f64,
+    freq: f64,
+    visit: i64,
+}
+
+type Database = HashMap<String, Entry>;
+
+fn db_path() -> PathBuf {
+    if let Ok(dir) = env::var("_ZO_DATA_DIR") {
+        if !dir.is_empty() {
+            return PathBuf::from(dir).join("zoxide.db");
+        }
+    }
+    if let Ok(dir) = env::var("XDG_DATA_HOME") {
+        if Path::new(&dir).is_absolute() {
+            return PathBuf::from(dir).join("zoxide").join("zoxide.db");
+        }
+    }
+    let home = env::var("HOME").unwrap_or_default();
+    let base = if cfg!(target_os = "windows") {
+        env::var("LOCALAPPDATA")
+            .ok()
+            .unwrap_or_else(|| format!("{}\\AppData\\Local", home))
+    } else if cfg!(target_os = "macos") {
+        format!("{}/Library/Application Support", home)
+    } else {
+        format!("{}/.local/share", home)
+    };
+    PathBuf::from(base).join("zoxide").join("zoxide.db")
+}
+
+fn load_db() -> Database {
+    let mut db = Database::new();
+    if let Ok(contents) = fs::read_to_string(db_path()) {
+        for line in contents.lines() {
+            let mut parts = line.split('\t');
+            let (Some(path), Some(score), Some(freq), Some(visit)) =
+                (parts.next(), parts.next(), parts.next(), parts.next())
+            else {
+                continue;
+            };
+            let (Ok(score), Ok(freq), Ok(visit)) =
+                (score.parse::<f64>(), freq.parse::<f64>(), visit.parse::<i64>())
+            else {
+                continue;
+            };
+            db.insert(path.to_string(), Entry { score, freq, visit });
+        }
+    }
+    db
+}
+
+/// Persist the database, forgetting the lowest-scoring entries beyond
+/// `_ZO_MAXAGE` to keep it bounded.
+fn save_db(db: &Database, config: &Config) -> io::Result<()> {
+    let mut entries: Vec<(String, Entry)> = db.iter().map(|(k, e)| (k.clone(), *e)).collect();
+    if entries.len() > config.max_age as usize {
+        let now = now();
+        entries.sort_by(|a, b| {
+            let sa = a.1.score * factor(a.1.visit, now, config.max_age);
+            let sb = b.1.score * factor(b.1.visit, now, config.max_age);
+            sb.partial_cmp(&sa).unwrap_or(Ordering::Equal)
+        });
+        entries.truncate(config.max_age as usize);
+    }
+    let mut buf = String::with_capacity(entries.len() * 64);
+    for (path, e) in &entries {
+        buf.push_str(path);
+        buf.push('\t');
+        buf.push_str(&e.score.to_string());
+        buf.push('\t');
+        buf.push_str(&e.freq.to_string());
+        buf.push('\t');
+        buf.push_str(&e.visit.to_string());
+        buf.push('\n');
+    }
+    let path = db_path();
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    let tmp = path.with_extension("db.tmp");
+    fs::write(&tmp, &buf)?;
+    fs::rename(&tmp, &path)?;
+    Ok(())
+}
+
+// ---------------------------------------------------------------------------
+// zoxide add
+// ---------------------------------------------------------------------------
+
+fn cmd_add(config: &Config, dir_arg: Option<String>) -> ExitCode {
+    let raw = match dir_arg {
+        Some(d) => d,
+        None => match env::var("PWD") {
+            Ok(p) if !p.is_empty() => p,
+            _ => match env::current_dir() {
+                Ok(p) => p.to_string_lossy().into_owned(),
+                Err(_) => return ExitCode::SUCCESS,
+            },
+        },
+    };
+    if raw.is_empty() || raw == "-" {
+        return ExitCode::SUCCESS;
+    }
+    let mut path = PathBuf::from(expand_tilde(&raw));
+    if !path.is_absolute() {
+        if let Ok(cwd) = env::current_dir() {
+            path = cwd.join(path);
+        }
+    }
+    let path = normalize(&path);
+    if path.is_symlink() && !config.resolve_symlinks {
+        return ExitCode::SUCCESS;
+    }
+    if !path.is_dir() {
+        return ExitCode::SUCCESS;
+    }
+    if config.is_excluded(&path) {
+        return ExitCode::SUCCESS;
+    }
+    let key = path.to_string_lossy().into_owned();
+    let now = now();
+    let mut db = load_db();
+    match db.get_mut(&key) {
+        Some(e) => {
+            e.freq += 1.0;
+            e.score += factor(e.visit, now, config.max_age);
+            e.visit = now;
+        }
+        None => {
+            db.insert(key, Entry { score: 1.0, freq: 1.0, visit: now });
+        }
+    }
+    if let Err(e) = save_db(&db, config) {
+        eprintln!("zoxide: failed to save database: {e}");
+        return ExitCode::FAILURE;
+    }
+    ExitCode::SUCCESS
+}
+
+// ---------------------------------------------------------------------------
+// zoxide query
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum MatchMode {
+    Substring,
+    Exact,
+    Glob,
+}
+
+#[derive(Debug, Default)]
+struct QueryOpts {
+    exact: bool,
+    glob: bool,
+    score: bool,
+    abbrev: bool,
+    filter: Option<String>,
+    match_mode: Option<MatchMode>,
+    after_ddash: bool,
+}
+
+fn parse_match_mode(v: &str) -> Option<MatchMode> {
+    match v {
+        "substring" => Some(MatchMode::Substring),
+        "exact" => Some(MatchMode::Exact),
+        "glob" => Some(MatchMode::Glob),
+        _ => None,
+    }
+}
+
+fn parse_query_args(args: &[String]) -> Result<(QueryOpts, Vec<String>), String> {
+    let mut opts = QueryOpts::default();
+    let mut terms = Vec::new();
+    let mut i = 0;
+    while i < args.len() {
+        let a = &args[i];
+        if opts.after_ddash {
+            terms.push(a.clone());
+        } else {
+            match a.as_str() {
+                "--" => opts.after_ddash = true,
+                "--exact" | "-e" => opts.exact = true,
+                "--extglob" | "--glob" | "-g" => opts.glob = true,
+                "--score" | "-s" => opts.score = true,
+                "--abbrev" | "-a" => opts.abbrev = true,
+                "--filter" => {
+                    i += 1;
+                    if i >= args.len() {
+                        return Err("--filter requires an argument".into());
+                    }
+                    opts.filter = Some(args[i].clone());
+                }
+                "--match" => {
+                    i += 1;
+                    if i >= args.len() {
+                        return Err("--match requires an argument".into());
+                    }
+                    match parse_match_mode(&args[i]) {
+                        Some(m) => opts.match_mode = Some(m),
+                        None => {
+                            return Err(format!(
+                                "unknown match algorithm '{}': expected exact, glob or substring",
+                                args[i]
+                            ))
+                        }
+                    }
+                }
+                t if t.starts_with("--") => {
+                    return Err(format!("unrecognized option: {t}"));
+                }
+                t if t.starts_with('-') => {
+                    return Err(format!("unrecognized option: {t}"));
+                }
+                t => terms.push(t.to_string()),
+            }
+        }
+        i += 1;
+    }
+    let mode = opts
+        .match_mode
+        .or_else(|| {
+            if opts.exact {
+                Some(MatchMode::Exact)
+            } else if opts.glob {
+                Some(MatchMode::Glob)
+            } else {
+                None
+            }
+        })
+        .unwrap_or(MatchMode::Substring);
+    opts.match_mode = Some(mode);
+    Ok((opts, terms))
+}
+
+/// How well does `term` match `path`? 0.0 means "no match".
+fn term_score(mode: MatchMode, term: &str, path: &str) -> f64 {
+    match mode {
+        MatchMode::Exact => {
+            if path == term {
+                10.0
+            } else if path.split('/').any(|s| s == term) {
+                8.0
+            } else {
+                0.0
+            }
+        }
+        MatchMode::Glob => {
+            if glob_match(term, path) {
+                10.0
+            } else if path.split('/').any(|s| glob_match(term, s)) {
+                8.0
+            } else if glob_match(&format!("*/{}", term), path) {
+                6.0
+            } else {
+                0.0
+            }
+        }
+        MatchMode::Substring => {
+            let t = term.to_lowercase();
+            let p = path.to_lowercase();
+            if t.is_empty() {
+                return 1.0;
+            }
+            let segments: Vec<&str> = p.split('/').collect();
+            if p == t {
+                10.0
+            } else if segments.iter().any(|s| *s == t.as_str()) {
+                8.0
+            } else if segments.last().map_or(false, |s| s.starts_with(&t)) {
+                6.0
+            } else if segments.iter().any(|s| s.starts_with(&t.as_str())) {
+                5.0
+            } else if p.contains(&format!("/{}", t)) {
+                4.0
+            } else if p.contains(&t) {
+                2.0
+            } else {
+                0.0
+            }
+        }
+    }
+}
+
+fn cmd_query(config: &Config, args: &[String]) -> ExitCode {
+    let (opts, terms) = match parse_query_args(args) {
+        Ok(v) => v,
+        Err(e) => {
+            eprintln!("zoxide: {e}");
+            return ExitCode::FAILURE;
+        }
+    };
+    if terms.is_empty() {
+        // `z` with no arguments prints nothing.
+        return ExitCode::SUCCESS;
+    }
+
+    // Fast paths that mirror `cd` behaviour (see README).
+    if terms.len() == 1 {
+        let t = &terms[0];
+        if t == "-" {
+            if let Ok(old) = env::var("OLDPWD") {
+                if Path::new(&old).is_dir() {
+                    println!("{}", normalize(&PathBuf::from(&old)).to_string_lossy());
+                }
+            }
+            return ExitCode::SUCCESS;
+        }
+        let expanded = expand_tilde(t);
+        let looks_like_path = t.ends_with('/') || t.contains('/') || t.contains(std::path::MAIN_SEPARATOR);
+        let cand = if Path::new(&expanded).is_absolute() {
+            PathBuf::from(expanded)
+        } else {
+            env::current_dir()
+                .map(|c| c.join(&expanded))
+                .unwrap_or_else(|_| PathBuf::from(expanded))
+        };
+        if looks_like_path {
+            if let Ok(resolved) = if config.resolve_symlinks {
+                cand.canonicalize()
+            } else {
+                Ok(normalize(&cand))
+            } {
+                if resolved.is_dir() {
+                    println!("{}", resolved.to_string_lossy());
+                    return ExitCode::SUCCESS;
+                }
+            }
+        }
+    }
+
+    let db = load_db();
+    let now = now();
+    let mode = opts.match_mode.unwrap_or(MatchMode::Substring);
+    let mut results: Vec<(String, f64)> = Vec::new();
+    for (path, e) in &db {
+        let mut term_boost = 1.0f64;
+        let mut matched = true;
+        for term in &terms {
+            let s = term_score(mode, term, path);
+            if s <= 0.0 {
+                matched = false;
+                break;
+            }
+            term_boost *= s;
+        }
+        if matched {
+            let score = e.score * factor(e.visit, now, config.max_age) * term_boost;
+            results.push((path.clone(), score));
+        }
+    }
+    results.sort_by(|a, b| {
+        b.1.partial_cmp(&a.1)
+            .unwrap_or(Ordering::Equal)
+            .then_with(|| a.0.cmp(&b.0))
+    });
+    if let Some(filter) = &opts.filter {
+        results.retain(|(path, _)| {
+            glob_match(filter, path) || path.contains(filter.as_str())
+        });
+    }
+    results.truncate(RESULTS_LIMIT);
+
+    let cwd = env::current_dir();
+    let mut printed = 0;
+    for (path, score) in results {
+        let disp = if opts.abbrev {
+            match cwd.as_deref() {
+                Ok(cwdp) => Path::new(&path)
+                    .strip_prefix(cwdp)
+                    .map(|p| p.to_string_lossy().into_owned())
+                    .unwrap_or(path.clone()),
+                Err(_) => path.clone(),
+            }
+        } else {
+            path.clone()
+        };
+        if opts.score {
+            println!("{score} {disp}");
+        } else {
+            println!("{disp}");
+        }
+        printed += 1;
+    }
+    if printed == 0 {
+        eprintln!("zoxide: no match found");
+        return ExitCode::SUCCESS;
+    }
+    ExitCode::SUCCESS
+}
+
+// ---------------------------------------------------------------------------
+// zoxide remove
+// ---------------------------------------------------------------------------
+
+fn cmd_remove(config: &Config, dirs: &[String]) -> ExitCode {
+    let mut db = load_db();
+    let mut removed = 0;
+    for dir in dirs {
+        let expanded = expand_tilde(dir);
+        let mut path = PathBuf::from(expanded.clone());
+        if !path.is_absolute() {
+            if let Ok(cwd) = env::current_dir() {
+                path = cwd.join(path);
+            }
+        }
+        let path = normalize(&path);
+        let key = path.to_string_lossy().into_owned();
+        let mut hit = db.remove(&key).is_some();
+        if !hit && expanded.contains('*') {
+            // fall back to glob removal
+            let victims: Vec<String> = db
+                .keys()
+                .filter(|k| glob_match(&expanded, k))
+                .cloned()
+                .collect();
+            for v in &victims {
+                db.remove(v);
+            }
+            hit = !victims.is_empty();
+        }
+        if hit {
+            removed += 1;
+        } else {
+            eprintln!("zoxide: no such entry: {dir}");
+        }
+    }
+    if removed > 0 {
+        if let Err(e) = save_db(&db, config) {
+            eprintln!("zoxide: failed to save database: {e}");
+            return ExitCode::FAILURE;
+        }
+    }
+    ExitCode::SUCCESS
+}
+
+// ---------------------------------------------------------------------------
+// zoxide import
+// ---------------------------------------------------------------------------
+
+struct ImportOpts {
+    from: String,
+    path: String,
+}
+
+fn parse_import_args(args: &[String]) -> Result<ImportOpts, String> {
+    let mut from = "autojump".to_string();
+    let mut path: Option<String> = None;
+    let mut i = 0;
+    while i < args.len() {
+        let a = &args[i];
+        if let Some(f) = a.strip_prefix("--from=") {
+            from = f.to_string();
+        } else if a == "--from" {
+            i += 1;
+            if i >= args.len() {
+                return Err("--from requires an argument".into());
+            }
+            from = args[i].clone();
+        } else if a.starts_with("--") {
+            return Err(format!("unrecognized option: {a}"));
+        } else {
+            if path.is_some() {
+                return Err(format!("unexpected argument: {a}"));
+            }
+            path = Some(a.clone());
+        }
+        i += 1;
+    }
+    let path = path.ok_or_else(|| "expected a database path".to_string())?;
+    Ok(ImportOpts { from, path })
+}
+
+fn apply_entry(db: &mut Database, key: String, freq: f64, score: f64, now: i64) {
+    if key.is_empty() || freq <= 0.0 {
+        return;
+    }
+    let key = key.trim_end_matches('/').to_string();
+    let entry = Entry { score: score.max(freq), freq, visit: now };
+    match db.get_mut(&key) {
+        Some(e) => {
+            e.freq = e.freq.max(entry.freq);
+            e.score = e.score.max(entry.score);
+            e.visit = e.visit.max(entry.visit);
+        }
+        None => {
+            db.insert(key, entry);
+        }
+    }
+}
+
+fn cmd_import(config: &Config, args: &[String]) -> ExitCode {
+    let opts = match parse_import_args(args) {
+        Ok(o) => o,
+        Err(e) => {
+            eprintln!("zoxide: {e}");
+            return ExitCode::FAILURE;
+        }
+    };
+    let lines = match fs::read_to_string(&opts.path) {
+        Ok(l) => l,
+        Err(e) => {
+            eprintln!("zoxide: cannot read {}: {e}", opts.path);
+            return ExitCode::FAILURE;
+        }
+    };
+    let now = now();
+    let mut db = load_db();
+    match opts.from.as_str() {
+        // autojump and z store `freq<TAB>path` lines.
+        "autojump" | "z" => {
+            for line in lines.lines() {
+                let mut parts = line.splitn(2, '\t');
+                if let (Some(f), Some(p)) = (parts.next(), parts.next()) {
+                    if let Ok(freq) = f.parse::<f64>() {
+                        apply_entry(&mut db, p.to_string(), freq, freq, now);
+                    }
+                }
+            }
+        }
+        // fasd stores `last_used<TAB>freq<TAB>path` lines.
+        "fasd" => {
+            for line in lines.lines() {
+                let mut parts = line.splitn(3, '\t');
+                let (Some(_ts), Some(f), Some(p)) =
+                    (parts.next(), parts.next(), parts.next())
+                else {
+                    continue;
+                };
+                if let Ok(freq) = f.parse::<f64>() {
+                    apply_entry(&mut db, p.to_string(), freq, freq, now);
+                }
+            }
+        }
+        // zlua / ZLocation store TOML sections:  ["/abs/path"]  score=... freq=...
+        "zlua" | "zlocation" => {
+            let mut current: Option<String> = None;
+            let mut score: f64 = 0.0;
+            let mut freq: f64 = 0.0;
+            for line in lines.lines() {
+                let line = line.trim();
+                if let Some(inner) = line.strip_prefix('[').and_then(|s| s.strip_suffix(']')) {
+                    if let Some(k) = current.take() {
+                        apply_entry(&mut db, k, freq, score, now);
+                    }
+                    score = 0.0;
+                    freq = 0.0;
+                    current = Some(inner.trim_matches('"').to_string());
+                } else if let Some(v) = line.strip_prefix("score") {
+                    if let Some(v) = v.strip_prefix('=') {
+                        score = v.trim().parse::<f64>().unwrap_or(0.0);
+                    }
+                } else if let Some(v) = line.strip_prefix("freq") {
+                    if let Some(v) = v.strip_prefix('=') {
+                        freq = v.trim().parse::<f64>().unwrap_or(0.0);
+                    }
+                }
+            }
+            if let Some(k) = current {
+                apply_entry(&mut db, k, freq, score, now);
+            }
+        }
+        // zsh-z stores `path<TAB>score` (or `path<TAB>score<TAB>ts`).
+        "zsh-z" => {
+            for line in lines.lines() {
+                let parts: Vec<&str> = line.split('\t').collect();
+                if parts.len() >= 2 {
+                    let score = parts[1].parse::<f64>().unwrap_or(0.0);
+                    apply_entry(&mut db, parts[0].to_string(), score, score, now);
+                }
+            }
+        }
+        other => {
+            eprintln!("zoxide: unknown import format: {other}");
+            return ExitCode::FAILURE;
+        }
+    }
+    if let Err(e) = save_db(&db, config) {
+        eprintln!("zoxide: failed to save database: {e}");
+        return ExitCode::FAILURE;
+    }
+    ExitCode::SUCCESS
+}
+
+// ---------------------------------------------------------------------------
+// zoxide init
+// ---------------------------------------------------------------------------
+
+struct InitOpts {
+    cmd: String,
+    hook: bool,
+    no_cmd: bool,
+}
+
+fn parse_init_args(args: &[String]) -> Result<InitOpts, String> {
+    let mut opts = InitOpts {
+        cmd: "zoxide".to_string(),
+        hook: true,
+        no_cmd: false,
+    };
+    let mut i = 0;
+    while i < args.len() {
+        let a = args[i].clone();
+        if let Some(c) = a.strip_prefix("--cmd=") {
+            opts.cmd = c.to_string();
+        } else if a == "--cmd" {
+            i += 1;
+            if i >= args.len() {
+                return Err("--cmd requires an argument".into());
+            }
+            opts.cmd = args[i].clone();
+        } else if a == "--hook" {
+            opts.hook = true;
+        } else if a == "--no-cmd" {
+            opts.no_cmd = true;
+        } else {
+            return Err(format!("unrecognized option: {a}"));
+        }
+        i += 1;
+    }
+    Ok(opts)
+}
+
+fn cmd_init(_config: &Config, args: &[String]) -> ExitCode {
+    let opts = match parse_init_args(args) {
+        Ok(o) => o,
+        Err(e) => {
+            eprintln!("zoxide: {e}");
+            return ExitCode::FAILURE;
+        }
+    };
+    let cmd = opts.cmd.trim();
+    let out = io::stdout();
+    let mut out = out.lock();
+    // The precmd hook records the directory the user actually landed in.
+    if opts.hook {
+        writeln!(out, "_ZO_CDHook() {{")
+            .ok();
+        writeln!(
+            out,
+            "    {cmd} add \"$PWD\" 2>/dev/null || true"
+        )
+        .ok();
+        writeln!(out, "}}").ok();
+        writeln!(out, "autoload -U add-zsh-hook").ok();
+        writeln!(out, "add-zsh-hook precmd _ZO_CDHook").ok();
+    }
+    // The `z` command wrapper records the previous directory before jumping.
+    if !opts.no_cmd {
+        writeln!(out, "{cmd}() {{").ok();
+        writeln!(out, "    local cmd=\"default\"").ok();
+        writeln!(out, "    if [[ -z $ZOPT || $ZOPT[1] = \"-\" ]]; then").ok();
+        writeln!(out, "        _ZO_CMD=({cmd} \"$_*\" | head -1)").ok();
+        writeln!(out, "        if [ ! -z \"$_ZO_CMD\" ]; then").ok();
+        writeln!(out, "            eval cd -- \"$_ZO_CMD\"").ok();
+        writeln!(out, "            {cmd} add 2>/dev/null || true").ok();
+        writeln!(out, "        fi").ok();
+        writeln!(out, "        unset _ZO_CMD").ok();
+        writeln!(out, "        return").ok();
+        writeln!(out, "    fi").ok();
+        writeln!(out, "    eval $(command {cmd} \"$_*\")").ok();
+        writeln!(out, "}}").ok();
+    }
+    let _ = out.flush();
+    ExitCode::SUCCESS
+}
+
+// ---------------------------------------------------------------------------
+// main
+// ---------------------------------------------------------------------------
+
+const HELP: &str = "\
+zoxide - jump to directories from the command line
+
+USAGE:
+    zoxide <COMMAND>
+
+COMMANDS:
+    add [DIR]     Add a directory to the database
+    import        Import from other directory history tools
+    init          Output shell initialization code
+    query         Query the database for a directory
+    remove        Remove a directory from the database
+
+OPTIONS:
+    -h, --help     Print help information
+    -V, --version  Print version information
+";
+
+fn print_help() {
+    print!("{HELP}");
+}
+
+fn main() -> ExitCode {
+    let args: Vec<String> = env::args().skip(1).collect();
+    if args.is_empty() {
+        print_help();
+        return ExitCode::SUCCESS;
+    }
+    let config = Config::load();
+    match args[0].as_str() {
+        "add" => cmd_add(&config, args.get(1).cloned()),
+        "query" | "q" | "z" => cmd_query(&config, &args[1..]),
+        "remove" | "rm" => cmd_remove(&config, &args[1..]),
+        "import" => cmd_import(&config, &args[1..]),
+        "init" => cmd_init(&config, &args[1..]),
+        "help" | "--help" | "-h" => {
+            print_help();
+            ExitCode::SUCCESS
+        }
+        "--version" | "-V" | "version" => {
+            println!("zoxide {VERSION}");
+            ExitCode::SUCCESS
+        }
+        other => {
+            eprintln!("zoxide: unknown command: {other}\n");
+            print_help();
+            ExitCode::FAILURE
+        }
+    }
+}
