+#!/usr/bin/env python3
+"""
+zoxide - A smarter cd command, inspired by z and autojump.
+
+Tracks directory usage and provides fast navigation to frequently visited directories.
+"""
+
+import argparse
+import os
+import sys
+import json
+import math
+import time
+from typing import List, Optional, Dict, Any, Tuple
+
+# Default configuration
+DEFAULT_MAXAGE = 10000
+DEFAULT_DATA_DIR = None
+
+# Detect platform for default data directory
+def get_default_data_dir() -> str:
+    if os.name == 'nt':  # Windows
+        return os.path.join(os.environ.get('LOCALAPPDATA', ''), 'zoxide')
+    elif os.name == 'posix':
+        xdg_data_home = os.environ.get('XDG_DATA_HOME', os.path.join(os.path.expanduser('~'), '.local', 'share'))
+        return os.path.join(xdg_data_home, 'zoxide')
+    else:
+        return os.path.join(os.path.expanduser('~'), '.local', 'share', 'zoxide')
+
+# Database file path
+def get_db_path() -> str:
+    data_dir = os.environ.get('_ZO_DATA_DIR', get_default_data_dir())
+    return os.path.join(data_dir, 'db.json')
+
+# Database lock file path
+def get_lock_path() -> str:
+    data_dir = os.environ.get('_ZO_DATA_DIR', get_default_data_dir())
+    return os.path.join(data_dir, 'lock')
+
+# Database file
+def get_db() -> Dict[str, Any]:
+    db_path = get_db_path()
+    if os.path.exists(db_path):
+        with open(db_path, 'r') as f:
+            return json.load(f)
+    return {'dirs': {}, 'version': 1}
+
+# Save database
+def save_db(db: Dict[str, Any]) -> None:
+    db_path = get_db_path()
+    os.makedirs(os.path.dirname(db_path), exist_ok=True)
+    with open(db_path, 'w') as f:
+        json.dump(db, f, indent=2)
+
+# Lock file handling
+def acquire_lock() -> None:
+    lock_path = get_lock_path()
+    while True:
+        try:
+            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+            os.write(fd, b'')
+            os.close(fd)
+            return
+        except FileExistsError:
+            pass
+
+def release_lock() -> None:
+    lock_path = get_lock_path()
+    try:
+        os.remove(lock_path)
+    except OSError:
+        pass
+
+# Scoring algorithm
+def score_dir(path: str, query: str, db: Dict[str, Any]) -> float:
+    """Calculate score for a directory based on frequency and recency."""
+    if path not in db['dirs']:
+        return 0.0
+    
+    info = db['dirs'][path]
+    freq = info.get('freq', 0)
+    last_accessed = info.get('last_accessed', 0)
+    
+    if freq == 0:
+        return 0.0
+    
+    # Age factor - directories decay over time
+    now = time.time()
+    age = now - last_accessed
+    age_factor = math.exp(-age / 1000000)  # Decay over ~1000 days
+    
+    # Score is frequency * age factor
+    return freq * age_factor
+
+# Add directory to database
+def add_dir(path: str, db: Dict[str, Any]) -> None:
+    """Add or increment a directory in the database."""
+    # Resolve symlinks if configured
+    if os.environ.get('_ZO_RESOLVE_SYMLINKS'):
+        path = os.path.realpath(path)
+    
+    # Normalize path
+    path = os.path.normpath(path)
+    
+    # Check exclusions
+    if is_excluded(path):
+        return
+    
+    # Get or create directory info
+    if path not in db['dirs']:
+        db['dirs'][path] = {
+            'freq': 0,
+            'last_accessed': time.time()
+        }
+    
+    db['dirs'][path]['freq'] += 1
+    db['dirs'][path]['last_accessed'] = time.time()
+    db['version'] = 2
+
+# Check if path is excluded
+def is_excluded(path: str) -> bool:
+    """Check if a path should be excluded from the database."""
+    exclude_dirs = os.environ.get('_ZO_EXCLUDE_DIRS', '')
+    
+    if not exclude_dirs:
+        return False
+    
+    # Split by OS-specific separator
+    if os.name == 'nt':
+        separators = [';']
+    else:
+        separators = [':']
+    
+    for sep in separators:
+        if sep in exclude_dirs:
+            separators.append(sep)
+    
+    for sep in separators:
+        if sep in exclude_dirs:
+            parts = exclude_dirs.split(sep)
+            for pattern in parts:
+                if pattern and pattern != '*':
+                    if path.startswith(pattern) or pattern in path:
+                        return True
+    
+    return False
+
+# Query directories
+def query_dirs(query: str, db: Dict[str, Any], prefix: bool = False) -> List[Tuple[str, float]]:
+    """Query directories matching the query."""
+    results = []
+    
+    for path, info in db['dirs'].items():
+        if info['freq'] == 0:
+            continue
+        
+        # Check if path matches query
+        if prefix:
+            if path.startswith(query):
+                results.append((path, score_dir(path, query, db)))
+        else:
+            # Fuzzy matching
+            if query in path:
+                results.append((path, score_dir(path, query, db)))
+    
+    # Sort by score descending
+    results.sort(key=lambda x: x[1], reverse=True)
+    return results
+
+# Interactive selection
+def interactive_select(query: str, db: Dict[str, Any]) -> Optional[str]:
+    """Select a directory interactively using fzf."""
+    try:
+        import fzf
+    except ImportError:
+        print("fzf not installed. Use 'z' instead of 'zi'.")
+        return None
+    
+    results = query_dirs(query, db)
+    if not results:
+        return None
+    
+    # Use fzf for selection
+    paths = [r[0] for r in results]
+    selected = fzf.prompt(paths, prompt='zoxide> ').rstrip('\n')
+    
+    if selected:
+        return selected
+    return None
+
+# Import from other tools
+def import_from(source: str, db: Dict[str, Any], path: str) -> None:
+    """Import directories from another tool."""
+    if source == 'autojump':
+        import_autojump(path, db)
+    elif source == 'z':
+        import_z(path, db)
+    elif source == 'fasd':
+        import_fasd(path, db)
+    elif source == 'zsh-z':
+        import_zsh_z(path, db)
+    elif source == 'z.lua':
+        import_z_lua(path, db)
+    elif source == 'ZLocation':
+        import_zlocation(path, db)
+    else:
+        print(f"Unknown source: {source}")
+        sys.exit(1)
+
+def import_autojump(path: str, db: Dict[str, Any]) -> None:
+    """Import from autojump."""
+    db_path = os.path.join(path, 'db.json')
+    if os.path.exists(db_path):
+        with open(db_path, 'r') as f:
+            data = json.load(f)
+        for dir_path, info in data.items():
+            add_dir(dir_path, db)
+
+def import_z(path: str, db: Dict[str, Any]) -> None:
+    """Import from z."""
+    db_path = os.path.join(path, 'db.json')
+    if os.path.exists(db_path):
+        with open(db_path, 'r') as f:
+            data = json.load(f)
+        for dir_path, info in data.items():
+            add_dir(dir_path, db)
+
+def import_fasd(path: str, db: Dict[str, Any]) -> None:
