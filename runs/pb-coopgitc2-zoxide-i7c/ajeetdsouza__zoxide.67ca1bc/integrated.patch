+# Remove directory from database
+def remove_dir(path: str, db: Dict[str, Any]) -> None:
+    """Remove a directory from the database."""
+    if path in db['dirs']:
+        del db['dirs'][path]
+
+# Shell initialization
+def init_shell(shell: str, cmd: str = 'z', hook: str = 'pwd', no_cmd: bool = False) -> str:
+    """Generate shell initialization code."""
+    if shell == 'bash':
+        return bash_init(cmd, hook, no_cmd)
+    elif shell == 'zsh':
+        return zsh_init(cmd, hook, no_cmd)
+    elif shell == 'fish':
+        return fish_init(cmd, hook, no_cmd)
+    elif shell == 'powershell':
+        return powershell_init(cmd, hook, no_cmd)
+    elif shell == 'elvish':
+        return elvish_init(cmd, hook, no_cmd)
+    elif shell == 'nushell':
+        return nushell_init(cmd, hook, no_cmd)
+    elif shell == 'posix':
+        return posix_init(cmd, hook, no_cmd)
+    else:
+        print(f"Unknown shell: {shell}")
+        sys.exit(1)
