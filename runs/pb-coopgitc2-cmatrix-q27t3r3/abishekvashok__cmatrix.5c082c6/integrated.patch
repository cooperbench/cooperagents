++#!/bin/sh
++# CMatrix - build entrypoint: produces a fresh ./executable
++# (kept aliased as ./cmatrix for the historical name)
++set -e
++CC=${CC:-cc}
++CFLAGS=${CFLAGS:--O2 -Wall}
++LDLIBS=${LDLIBS:--lncursesw}
++$CC $CFLAGS -c cmatrix.c -o cmatrix.o
++$CC $CFLAGS -c font.c -o font.o
++$CC $CFLAGS -c hash_table.c -o hash_table.o
++# Drop any stale (possibly read-only) output so the link below always
++# (re)builds a fresh ./executable.
++rm -f executable
++$CC $CFLAGS -o executable cmatrix.o font.o hash_table.o $LDLIBS
++# Keep the ./cmatrix name in sync with ./executable.
++ln -sf executable cmatrix
++echo "cmatrix built successfully (./executable)"
