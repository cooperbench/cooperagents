++                break;
++            case '8':
++                use_color = "white";
++                init_colors();
++                break;
++            case '9':
++                use_color = "green";
++                bold = 1;
++                init_colors();
++                break;
++            case 'q':
++                if (!locked)
++                    goto finish;
++                break;
++            case 27:
++                if (!locked && !screensaver_mode)
++                    goto finish;
++                break;
++            default:
++                if (screensaver_mode && !locked)
++                    goto finish;
++                break;
++        }
++    }
++
++finish:
++    for (x = 0; x < term_cols; x++)
++        free(table[x]);
++    free(table);
++    free(heads);
++    free(offsets);
++    free(use_color);
++
++    (void)tcsetattr(0, TCSANOW, &original_termios);
++    endwin();
++
++    return 0;
++}
