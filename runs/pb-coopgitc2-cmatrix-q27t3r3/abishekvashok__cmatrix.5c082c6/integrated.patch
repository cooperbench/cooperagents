++/*
++ * CMatrix - Matrix-like effect in your terminal
++ *
++ * font.c - the "matrix" character font.
++ *
++ * The classic matrix.fnt console font redefines the codes of the plain
++ * letters and digits below so that a Linux console renders them as
++ * Katakana-like glyphs; on any other terminal they simply show as
++ * letters and digits.  The font module owns this glyph set and serves
++ * random glyphs to the animation loop.
++ *
++ * This library is free software; you can redistribute it and/or modify it
++ * under the terms of the GNU General Public License as published by the
++ * Free Software Foundation; either version 3 of the License, or (at your
++ * option) any later version.
++ */
++
++#include "font.h"
++
++#include "hash_table.h"
++
++#include <stdio.h>
++#include <stdlib.h>
++#include <string.h>
++#include <unistd.h>
++
++static const char character_set[] =
++    "abcdefghijklmnopqrstuvwxyz"
++    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
++    "0123456789";
++
++static hash_table glyphs;
++static int loaded = 0;
++
++void font_load(void)
++{
++    const char *p;
++
++    if (loaded)
++        return;
++    if (hash_initialize(&glyphs) != 0)
++        return;
++    for (p = character_set; *p; p++) {
++        char key[3];
++
++        snprintf(key, sizeof key, "%02x", (unsigned char)*p);
++        hash_insert(&glyphs, key, p);
++    }
++    loaded = 1;
++}
++
++int font_glyph_count(void)
++{
++    if (!loaded)
++        font_load();
++    return (int)strlen(character_set);
++}
++
++wint_t font_random_glyph(void)
++{
++    if (!loaded)
++        font_load();
++    return (wint_t)(unsigned char)
++        character_set[rand() % (int)strlen(character_set)];
++}
++
++void font_install_console(void)
++{
++    /* Only meaningful on a Linux virtual console that ships the
++     * classic matrix font; never fatal. */
++    if (access("/usr/share/consolefonts/matrix.fnt.gz", R_OK) != 0)
++        return;
++    {
++        int status = system("ln -sf matrix.fnt.gz /usr/share/consolefonts/console.fnt.gz 2>/dev/null; "
++                            "setfont matrix.fnt 2>/dev/null");
++
++        (void)status;
++    }
++}
