+++ b/Makefile
@@ -0,0 +1,34 @@
+# CMatrix - Matrix-like effect in your terminal
+#
+# Build:   make        (or: make cmatrix) -> fresh ./executable (+ ./cmatrix alias)
+# Clean:   make clean
+
+CC      ?= cc
+CFLAGS  ?= -O2 -Wall
+LDLIBS  ?= -lncursesw
+
+CMATRIX_SRCS = cmatrix.c font.c hash_table.c
+CMATRIX_OBJS = cmatrix.o font.o hash_table.o
+
+all: executable
+
+# Primary build output: a fresh ./executable.
+executable: $(CMATRIX_OBJS)
+	rm -f executable
+	$(CC) $(CFLAGS) -o $@ $(CMATRIX_OBJS) $(LDLIBS)
+
+# Historical alias: ./cmatrix always tracks ./executable.
+cmatrix: executable
+	ln -sf executable $@
+
+%.o: %.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+cmatrix.o: cmatrix.c font.h
+font.o: font.c font.h hash_table.h
+hash_table.o: hash_table.c hash_table.h
+
+clean:
+	rm -f $(CMATRIX_OBJS) executable cmatrix
+
+.PHONY: all clean
