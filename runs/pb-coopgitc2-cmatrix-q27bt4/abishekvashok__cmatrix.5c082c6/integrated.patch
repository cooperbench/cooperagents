++static short pair_for(int color, int dim)
++{
++    /* color: index into color_names; dim: 0 bright, 1 dim */
++    if (color < 0 || color >= NUM_COLORS)
++        return 1;
++    return color + 2 + (dim ? NUM_COLORS : 0);
++}
