++                attron(COLOR_PAIR(1));
++                addch(g_ch[r][c]);
++                attroff(COLOR_PAIR(1));
++            } else if (age >= 40) {
++                attron(COLOR_PAIR(pair_for(col, 0)) | A_BOLD);
++                addch(g_ch[r][c]);
++                attroff(COLOR_PAIR(pair_for(col, 0)) | A_BOLD);
++            } else {
++                attron(COLOR_PAIR(pair_for(col, 1)));
++                addch(g_ch[r][c]);
++                attroff(COLOR_PAIR(pair_for(col, 1)));
++            }
++        }
