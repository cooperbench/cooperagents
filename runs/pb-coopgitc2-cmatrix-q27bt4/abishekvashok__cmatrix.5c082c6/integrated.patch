++static void init_colors(void)
++{
++    int i;    /* white head */
++    init_pair(1, COLOR_WHITE, COLOR_BLACK);
++    for (i = 0; i < NUM_COLORS; i++) {
++        init_pair(i + 2, nc_colors[i], COLOR_BLACK);   /* bright body */
++        init_pair(i + 2 + NUM_COLORS, nc_colors[i], COLOR_BLACK); /* dim body */
++    }
++}
