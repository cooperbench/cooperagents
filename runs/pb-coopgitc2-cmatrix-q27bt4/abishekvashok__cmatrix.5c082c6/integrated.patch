++    if (!g_drop)
++        return;
++    for (x = 0; x < g_cols; x++) {
++        g_drop[x].len = rand_range(8, g_rows / 2 + 1);
++        if (g_drop[x].len < 1)
++            g_drop[x].len = 1;
++        g_drop[x].y = rand_range(-g_drop[x].len, 0);
++        g_drop[x].step = 1;
++    }
++}
