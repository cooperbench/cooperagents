++        attron(COLOR_PAIR(pair_for(col, 0)) | A_BOLD);
++        mvaddstr(mr, ml, g_message);
++        attroff(COLOR_PAIR(pair_for(col, 0)) | A_BOLD);
++    }
++    refresh();
++}
++
++static int handle_input(void)
++{
++    int ch = getch();
++    if (ch == ERR)
++        return 0;
++
++    switch (ch) {
++        case '!': g_current_color = COL_RED;     break;
++        case '@': g_current_color = COL_GREEN;   break;
++        case '#': g_current_color = COL_YELLOW;  break;
++        case '$': g_current_color = COL_BLUE;    break;
++        case '%': g_current_color = COL_MAGENTA; break;
++        case '^': g_current_color = COL_CYAN;    break;
++        case '&': g_current_color = COL_WHITE;   break;
++        case ')': g_current_color = COL_BLACK;   break;
++        case 'q':
++        case 'Q':
++        case 27:   /* Esc */
++            return 1;
++        default:
++            if (g_screensaver)
++                return 1;   /* -s: exit on first keystroke */
++            break;
++    }
++    return 0;
++}
++
++static void run_matrix(void)
++{
++    init_matrix_state();
++    for (;;) {
++        update_matrix();
++        draw_matrix();
++        if (handle_input())
++            break;
++        usleep((unsigned)g_delay * 50000);
++    }
++}
