++        /* place a fresh character at the head */
++        if (y >= 0 && y < g_rows) {
++            g_ch[y][x] = random_char();
++            g_age[y][x] = 100;   /* freshest */
++        }
++
++        /* fill / age the trail behind the head */
++        for (y2 = 0; y2 < g_rows; y2++) {
++            if (g_age[y2][x] > 0) {
++                g_age[y2][x]--;
++                if (g_age[y2][x] == 0)
