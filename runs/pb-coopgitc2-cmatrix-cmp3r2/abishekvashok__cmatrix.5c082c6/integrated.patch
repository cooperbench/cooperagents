@@ -0,0 +1,285 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+#include <errno.h>
+
+#define VERSION "2.0"
+#define BUILD_TIME "22:13:51"
+#define BUILD_DATE "Jun 11 2026"
+#define EMAIL "abishekvashok@gmail.com"
+#define WEB "https://github.com/abishekvashok/cmatrix"
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int shadow_only = 0;
+static int lock_mode = 0;
+static int rainbow = 0;
+static int lambda_mode = 0;
+static int chars_change = 0;
+static int screensaver = 0;
+static int x_mode = 0;
+static int update_delay = 4;
+static char *color = NULL;
+static char *message = NULL;
+static char *tty = NULL;
+
+static const char *USAGE = " Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n"
+    " -a: Asynchronous scroll\n"
+    " -b: Bold characters on\n"
+    " -B: All bold characters (overrides -b)\n"
+    " -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n"
+    " -f: Force the linux $TERM type to be on\n"
+    " -l: Linux mode (uses matrix console font)\n"
+    " -L: Lock mode (can be closed from another terminal)\n"
+    " -o: Use old-style scrolling\n"
+    " -h: Print usage and exit\n"
+    " -n: No bold characters (overrides -b and -B, default)\n"
+    " -s: \"Screensaver\" mode, exits on first keystroke\n"
+    " -x: X window mode, use if your xterm is using mtx.pcf\n"
+    " -V: Print version information and exit\n"
+    " -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n"
+    " -u delay (0 - 10, default 4): Screen update delay\n"
+    " -C [color]: Use this color for matrix (default green)\n"
+    " -r: rainbow mode\n"
+    " -m: lambda mode\n"
+    " -k: Characters change while scrolling. (Works without -o opt.)\n"
+    " -t [tty]: Set tty to use\n";
+
+static void print_usage(void) {
+    printf("%s", USAGE);
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s, %s)\n", VERSION, BUILD_TIME, BUILD_DATE);
+    printf("Email: %s\n", EMAIL);
+    printf("Web: %s\n", WEB);
+}
+
+static void print_invalid_color(void) {
+    printf(" Invalid color selection\n");
+    printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+}
+
+static void print_invalid_tty(const char *tty) {
+    printf("cmatrix: error: '%s' couldn't be opened: %s.\n", tty, strerror(errno));
+}
+
+static void print_invalid_update(const char *arg) {
+    printf(" Invalid update delay\n");
+    printf(" Valid update delay is 0 - 10.\n");
+}
+
+static void print_invalid_message(const char *msg) {
+    printf(" Invalid message\n");
+}
+
+static int is_valid_color(const char *color) {
+    if (strcmp(color, "green") == 0) return 1;
+    if (strcmp(color, "red") == 0) return 1;
+    if (strcmp(color, "blue") == 0) return 1;
+    if (strcmp(color, "white") == 0) return 1;
+    if (strcmp(color, "yellow") == 0) return 1;
+    if (strcmp(color, "cyan") == 0) return 1;
+    if (strcmp(color, "magenta") == 0) return 1;
+    if (strcmp(color, "black") == 0) return 1;
+    return 0;
+}
+
+static void print_help(void) {
+    print_usage();
+}
+
+static void print_error(const char *msg) {
+    fprintf(stderr, "cmatrix: %s\n", msg);
+}
+
+int main(int argc, char *argv[]) {
+    int i;
+    
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_help();
+            return 0;
+        }
+        if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            return 0;
+        }
+        if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            shadow_only = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            bold_chars = 0;
+            all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            chars_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                update_delay = atoi(argv[++i]);
+                if (update_delay < 0 || update_delay > 10) {
+                    print_invalid_update(argv[i-1]);
+                    return 1;
+                }
+            } else {
+                print_invalid_update(argv[i]);
+                return 1;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = argv[++i];
+                if (!is_valid_color(color)) {
+                    print_invalid_color();
+                    return 0;
+                }
+            } else {
+                print_invalid_color();
+                return 0;
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                message = argv[++i];
+                if (strlen(message) == 0) {
+                    print_invalid_message(argv[i]);
+                    return 0;
+                }
+            } else {
+                print_invalid_message(argv[i]);
+                return 0;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty = argv[++i];
+            } else {
+                print_error("missing tty argument");
+                return 1;
+            }
+        } else {
+            print_help();
+            return 0;
+        }
+    }
+    
+    if (tty != NULL) {
+        struct termios oldt, newt;
+        int fd;
+        
+        fd = open(tty, O_RDWR);
+        if (fd < 0) {
+            print_invalid_tty(tty);
+            return 1;
+        }
+        
+        if (tcgetattr(fd, &oldt) < 0) {
+            print_error("couldn't get terminal attributes");
+            close(fd);
+            return 1;
+        }
+        
+        newt = oldt;
+        newt.c_lflag &= ~(ECHO | ICANON);
+        newt.c_iflag &= ~(IXON);
+        newt.c_oflag &= 0;
+        newt.c_cflag &= ~(CSIZE | PARENB);
+        newt.c_cflag |= CS8;
+        newt.c_cc[VMIN] = 0;
+        newt.c_cc[VTIME] = 0;
+        
+        if (tcsetattr(fd, TCSANOW, &newt) < 0) {
+            print_error("couldn't set terminal attributes");
+            close(fd);
+            return 1;
+        }
+        
+        close(fd);
+    }
+    
+    if (force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    if (old_style) {
+        printf("\033[?1049h");
+    }
+    
+    if (linux_mode) {
+        printf("\033]0;cmatrix\007");
+    }
+    
+    if (lock_mode) {
+        printf("\033[?1049h");
+        printf("\033[?1004h");
+    }
+    
+    if (screensaver) {
+        printf("\033[?1049h");
+    }
+    
+    if (x_mode) {
+        printf("\033[?1049h");
+    }
+    
+    if (old_style) {
+        printf("\033[?1049l");
+    }
+    
+    if (linux_mode) {
+        printf("\033[?1049l");
+    }
+    
+    if (lock_mode) {
+        printf("\033[?1004l");
+    }
+    
+    if (screensaver) {
+        printf("\033[?1049l");
+    }
+    
+    if (x_mode) {
+        printf("\033[?1049l");
+    }
+    
+    printf("\033[2J\033[H");
+    
+    if (message != NULL) {
+        printf("\033[?1049h");
+        printf("\033[1;1H");
+        printf("%s\n", message);
+        printf("\033[?1049l");
+    }
+    
+    return 0;
+}
