+#!/bin/bash
+set -e
+
+# Create go.mod if it doesn't exist
+if [ ! -f go.mod ]; then
+    cat > go.mod << 'GOMOD'
+module walk
+
+go 1.21
+GOMOD
+fi
+
+# Build the executable
+go build -o executable main.go
