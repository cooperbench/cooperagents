+            result.push_str("# This config file uses keycodes (bindsym) and was written for the QWERTY\n");
+            result.push_str("# layout.\n");
+            result.push_str("#\n");
+            result.push_str("# To get a config file with the same key positions, but for your current\n");
+            result.push_str("# layout, use the i3-config-wizard\n");
+            result.push_str("#\n");
+            result.push_str("\n");
+            result.push_str("# Font for window titles. Will also be used by the bar unless a different font\n");
+            result.push_str("# is used in the bar {} block below. ISO 10646 = Unicode\n");
+            result.push_str("font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1\n");
+            result.push_str("# The font above is very space-efficient, that is, it looks good, sharp and\n");
+            result.push_str("# clear in small sizes. However, if you need a lot of unicode glyphs or\n");
+            result.push_str("# right-to-left text rendering, you should instead use pango for rendering and\n");
+            result.push_str("# chose a FreeType font, such as:\n");
+            result.push_str("# font pango:DejaVu Sans Mono 10\n");
+            result.push_str("\n");
+            result.push_str("# use Mouse+Mod1 to drag floating windows to their wanted position\n");
+            result.push_str("floating_modifier Mod1\n");
+            result.push_str("\n");
+            result.push_str("# start a terminal\n");
+            result.push_str("bindsym Mod1+Return exec i3-sensible-terminal\n");
+            result.push_str("\n");
+            result.push_str("# kill focused window\n");
+            result.push_str("bindsym Mod1+Shift+q kill\n");
+            result.push_str("\n");
+            result.push_str("# start dmenu (a program launcher)\n");
+            result.push_str("bindsym Mod1+d exec dmenu_run\n");
+            result.push_str("# There also is the (new) i3-dmenu-desktop which only displays applications\n");
+            result.push_str("# shipping a .desktop file. It is a wrapper around dmenu, so you need that\n");
+            result.push_str("# installed.\n");
+            result.push_str("# bindsym Mod1+d exec --no-startup-id i3-dmenu-desktop\n");
+            result.push_str("\n");
+            result.push_str("# change focus\n");
+            result.push_str("bindsym Mod1+j focus left\n");
+            result.push_str("bindsym Mod1+k focus down\n");
+            result
+        }
+        _ => String::new(),
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    let (theme, config, output, reload, save, help, list_all, version) = parse_args(&args);
+
+    if help {
+        print_help();
+        process::exit(0);
+    }
+
+    if version {
+        print_version();
+        process::exit(0);
+    }
+
+    if list_all {
+        print_list_all();
+        process::exit(0);
+    }
+
+    if let Some(ref theme_name) = theme {
+        let default_config = "/etc/i3/config";
+        let config_path = config.as_ref().map_or(default_config, |v| v.as_str());
+        
+        let config_content = match fs::read_to_string(config_path) {
+            Ok(content) => content,
+            Err(e) => {
+                eprintln!("Could not read config file '{}': {}", config_path, e);
+                process::exit(1);
+            }
+        };
+
+        let themed_config = apply_theme(&config_content, theme_name);
+
+        if let Some(ref out_path) = output {
+            if save {
+                let input_path = args.get(1).map(|s| s.as_str()).unwrap_or(theme_name.as_str());
+                let out_path = out_path.as_str();
+                if out_path == input_path {
+                    fs::write(out_path, &themed_config).expect("Could not write to output file");
+                }
+            }
+            fs::write(out_path, &themed_config).expect("Could not write to output file");
+            
+            if reload {
+                eprintln!("Reloading config...");
+            }
+        } else {
+            eprintln!("Could not validate config with `i3 -C -c {}` (is i3 in the PATH?)", config_path);
+            process::exit(1);
+        }
+    } else {
+        print_help();
+        process::exit(1);
+    }
+}
