+#!/usr/bin/env python3
+"""zoxide - A smarter cd command for your terminal."""
+
+import argparse
+import json
+import os
+import sys
+import re
+from pathlib import Path
+from typing import List, Optional, Dict, Any, Tuple
+
+VERSION = "0.9.9"
+AUTHOR = "Ajeet D'Souza <98ajeet@gmail.com>"
+URL = "https://github.com/ajeetdsouza/zoxide"
+
+def get_data_dir() -> str:
+    if os.name == 'nt':
+        localappdata = os.environ.get('LOCALAPPDATA', os.path.expanduser('~\\AppData\\Local'))
+        return os.path.join(localappdata, 'zoxide')
+    else:
+        xdg_data_home = os.environ.get('XDG_DATA_HOME', os.path.expanduser('~/.local/share'))
+        return xdg_data_home
+
+def get_db_path() -> str:
+    return os.path.join(get_data_dir(), 'db.json')
+
+def get_edit_db_path() -> str:
+    return os.path.join(get_data_dir(), 'edit.json')
+
+def load_db() -> Dict[str, Any]:
+    db_path = get_db_path()
+    if not os.path.exists(db_path):
+        return {'entries': [], 'version': 1}
+    try:
+        with open(db_path, 'r') as f:
+            return json.load(f)
+    except (json.JSONDecodeError, IOError):
+        return {'entries': [], 'version': 1}
+
+def save_db(db: Dict[str, Any]) -> None:
+    db_path = get_db_path()
+    os.makedirs(os.path.dirname(db_path), exist_ok=True)
+    with open(db_path, 'w') as f:
+        json.dump(db, f, indent=2)
+
+def add_entry(path: str, score: Optional[int] = None) -> None:
+    db = load_db()
+    path = os.path.abspath(path)
+    exclude_dirs = get_exclude_dirs()
+    if path in exclude_dirs:
+        return
+    for entry in db['entries']:
+        if entry['path'] == path:
+            if score is not None:
+                entry['score'] = score
+            else:
+                entry['score'] += 1
+            entry['age'] += 1
+            return
+    db['entries'].append({
+        'path': path,
+        'score': score if score is not None else 1,
+        'age': 1
+    })
+    save_db(db)
+
+def get_exclude_dirs() -> List[str]:
+    exclude_dirs = []
+    exclude_env = os.environ.get('_ZO_EXCLUDE_DIRS', '')
+    if os.name == 'nt':
+        exclude_dirs = [os.path.abspath(p) for p in exclude_env.split(';') if p]
+    else:
+        exclude_dirs = [os.path.abspath(p) for p in exclude_env.split(':') if p]
+    return exclude_dirs
+
+
+def query_db(keywords: List[str], prefix: bool = False,
+             exclude_current: bool = False, base_dir: Optional[str] = None) -> List[Tuple[str, int]]:
+    db = load_db()
+    results = []
+    for entry in db['entries']:
+        path = entry['path']
+        if base_dir is not None:
+            if not path.startswith(base_dir):
+                continue
+        if exclude_current and path == os.getcwd():
+            continue
+        if keywords:
+            path_lower = path.lower()
+            keywords_lower = [k.lower() for k in keywords]
+            if not all(k in path_lower for k in keywords_lower):
+                continue
+        if prefix:
+            if not path.startswith(keywords[0]):
+                continue
+        results.append((path, entry['score']))
+    results.sort(key=lambda x: x[1], reverse=True)
+    return results
+
+def remove_entry(path: str) -> None:
+    db = load_db()
+    path = os.path.abspath(path)
+    db['entries'] = [e for e in db['entries'] if e['path'] != path]
+    save_db(db)
+
+def import_autojump(path: str, merge: bool = False) -> None:
+    import_db_path = os.path.join(path, 'db.json')
+    if not os.path.exists(import_db_path):
+        print(f"zoxide: import file not found: {import_db_path}", file=sys.stderr)
+        sys.exit(1)
+    try:
+        with open(import_db_path, 'r') as f:
+            import_db = json.load(f)
+    except (json.JSONDecodeError, IOError) as e:
+        print(f"zoxide: failed to parse import file: {e}", file=sys.stderr)
+        sys.exit(1)
+    db = load_db()
+    for entry in import_db.get('entries', []):
+        import_path = entry.get('path', '')
+        if not import_path:
+            continue
+        import_path = os.path.abspath(import_path)
+        if import_path in get_exclude_dirs():
+            continue
+        if merge:
+            for existing in db['entries']:
+                if existing['path'] == import_path:
+                    existing['score'] += entry.get('score', 1)
+                    existing['age'] += entry.get('age', 1)
+                    break
+        else:
+            db['entries'].append({
+                'path': import_path,
+                'score': entry.get('score', 1),
+                'age': entry.get('age', 1)
+            })
+    save_db(db)
+
+def import_z(path: str, merge: bool = False) -> None:
+    import_db_path = os.path.join(path, 'db')
+    if not os.path.exists(import_db_path):
+        print(f"zoxide: import file not found: {import_db_path}", file=sys.stderr)
+        sys.exit(1)
+    try:
+        with open(import_db_path, 'r') as f:
+            import_db = json.load(f)
+    except (json.JSONDecodeError, IOError) as e:
+        print(f"zoxide: failed to parse import file: {e}", file=sys.stderr)
+        sys.exit(1)
+    db = load_db()
+    for entry in import_db.get('entries', []):
