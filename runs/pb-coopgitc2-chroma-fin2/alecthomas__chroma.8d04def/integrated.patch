+    parser.add_argument('--trace', action='store_true', help='Trace lexer states as they are traversed.')
+    parser.add_argument('--check', action='store_true', help='Do not format, check for tokenisation errors instead.')
+    parser.add_argument('--filename', default='', help='Filename to use for selecting a lexer when reading from stdin.')
+    parser.add_argument('--fail', action='store_true', help='Exit silently with status 1 if no specific lexer was found.')
+    parser.add_argument('--lexer', default='autodetect', help='Lexer to use when formatting or path to an XML file to load.')
+    parser.add_argument('--style', default='monokai', help='Style to use for formatting or path to an XML file to load.')
+    parser.add_argument('--formatter', default='terminal', help='Formatter to use.')
+    parser.add_argument('--json', action='store_true', help='Convenience flag to use JSON formatter.')
+    parser.add_argument('--html', action='store_true', help='Convenience flag to use HTML formatter.')
+    parser.add_argument('--svg', action='store_true', help='Convenience flag to use SVG formatter.')
+    parser.add_argument('--html-prefix', default='', help='HTML CSS class prefix.')
+    parser.add_argument('--html-styles', action='store_true', help='Output HTML CSS styles.')
+    parser.add_argument('--html-all-styles', action='store_true', help='Output all HTML CSS styles, including redundant ones.')
+    parser.add_argument('--html-only', action='store_true', help='Output HTML fragment.')
+    parser.add_argument('--html-inline-styles', action='store_true', help='Output HTML with inline styles (no classes).')
+    parser.add_argument('--html-tab-width', type=int, default=8, help='Set the HTML tab width.')
+    parser.add_argument('--html-lines', action='store_true', help='Include line numbers in output.')
+    parser.add_argument('--html-lines-table', action='store_true', help='Split line numbers and code in a HTML table')
+    parser.add_argument('--html-lines-style', default='', help='Style for line numbers.')
+    parser.add_argument('--html-highlight', default='', help='Highlight these lines.')
+    parser.add_argument('--html-highlight-style', default='', help='Style used for highlighting lines.')
+    parser.add_argument('--html-base-line', type=int, default=1, help='Base line number.')
+    parser.add_argument('--html-prevent-surrounding-pre', action='store_true', help='Prevent the surrounding pre tag.')
+    parser.add_argument('--html-linkable-lines', action='store_true', help='Make the line numbers linkable and be a link to themselves.')
+    parser.add_argument('files', nargs='*', help='Files to highlight.')
+    
+    args = parser.parse_args()
+    
+    # Handle convenience flags for formatter
+    if args.json:
+        args.formatter = 'json'
+    elif args.html:
+        args.formatter = 'html'
+    elif args.svg:
+        args.formatter = 'svg'
+    
+    if args.version:
+        print(VERSION)
+        return
+    
+    if args.help:
+        print_help()
+        return
+    
+    if args.list:
+        print_list()
+        return
+    
+    if len(args.files) == 0:
+        # Read from stdin
+        if args.fail:
+            if args.filename:
+                print(f"executable: error: open {args.filename}: no such file or directory", file=sys.stderr)
+            else:
+                print("executable: error: open stdin: no such file or directory", file=sys.stderr)
+            sys.exit(1)
+        else:
+            content = sys.stdin.read()
+            tokens = get_lexer(args.lexer)(content)
+            formatted = format_tokens(tokens, args.formatter)
+            if args.unbuffered:
+                sys.stdout.write(formatted)
+            else:
+                print(formatted, end='')
+            return
+    
+    # Process files
+    for file in args.files:
+        process_file(file, args.lexer, args.style, args.formatter, args.json, args.html, args.svg,
+                     args.html_prefix, args.html_styles, args.html_all_styles, args.html_only,
+                     args.html_inline_styles, args.html_tab_width, args.html_lines,
+                     args.html_lines_table, args.html_lines_style, args.html_highlight,
+                     args.html_highlight_style, args.html_base_line,
+                     args.html_prevent_surrounding_pre, args.html_linkable_lines,
+                     args.trace, args.check, args.unbuffered, args.fail, args.filename)
+
+if __name__ == '__main__':
+    main()
