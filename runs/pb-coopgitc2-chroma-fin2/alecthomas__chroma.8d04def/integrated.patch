+# Simple lexer for Python
+def tokenize_python(text):
+    """Simple tokenizer for Python code."""
+    tokens = []
+    lines = text.split('\n')
+    for line_num, line in enumerate(lines, 1):
+        i = 0
+        while i < len(line):
+            # Skip whitespace
+            if line[i].isspace():
+                i += 1
+                continue
+            
+            # Check for comments
+            if line[i] == '#':
+                tokens.append(('comment', line[i:]))
+                break
+            
+            # Check for strings
+            if line[i] in '"\'':
+                quote = line[i]
+                j = i + 1
+                while j < len(line) and line[j] != quote:
+                    if line[j] == '\\':
+                        j += 2
+                    else:
+                        j += 1
+                if j < len(line):
+                    j += 1
+                tokens.append(('literalstring', line[i:j]))
+                i = j
+                continue
+            
+            # Check for numbers
+            if line[i].isdigit() or (line[i] == '.' and i + 1 < len(line) and line[i + 1].isdigit()):
+                j = i
+                while j < len(line) and (line[j].isdigit() or line[j] in '.eE+-'):
+                    j += 1
+                tokens.append(('literal', line[i:j]))
+                i = j
+                continue
+            
+            # Check for keywords and identifiers
+            if line[i].isalpha() or line[i] == '_':
+                j = i
+                while j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                    j += 1
+                word = line[i:j]
+                if word in ('and', 'as', 'assert', 'async', 'await', 'break', 'class', 'continue', 'def', 'del', 'elif', 'else', 'except', 'finally', 'for', 'from', 'global', 'if', 'import', 'in', 'is', 'lambda', 'nonlocal', 'not', 'or', 'pass', 'raise', 'return', 'try', 'while', 'with', 'yield'):
+                    tokens.append(('keyword', word))
+                elif word in ('True', 'False', 'None'):
+                    tokens.append(('keywordconstant', word))
+                elif word in ('int', 'float', 'complex', 'str', 'bytes', 'list', 'dict', 'set', 'tuple', 'frozenset', 'range', 'type', 'object', 'bool'):
+                    tokens.append(('keywordtype', word))
+                elif word[0].isupper():
+                    tokens.append(('nameclass', word))
+                else:
+                    tokens.append(('namefunction', word))
+                i = j
+                continue
+            
+            # Check for operators and punctuation
+            if line[i] in '(){}[];,:':
+                tokens.append(('punctuation', line[i]))
+                i += 1
+                continue
+            
+            if line[i] in '+-*/%=<>!&|^~?:':
+                j = i
+                while j < len(line) and line[j] in '+-*/%=<>!&|^~?:':
+                    j += 1
+                tokens.append(('operator', line[i:j]))
+                i = j
+                continue
+            
+            i += 1
+    
+    return tokens
+
+# Formatter implementations
+def format_terminal(tokens, style='monokai'):
+    """Format tokens for terminal output."""
+    result = []
+    for token_type, value in tokens:
+        if style == 'monokai':
+            colors = MONOKAI_STYLES
+        else:
+            colors = ANSI_COLORS
+        
+        color = colors.get(token_type, colors.get('other', ''))
+        result.append(color + value + colors.get('reset', ''))
+    return ''.join(result)
+
+def format_html(tokens, html_prefix='', html_styles=False, html_all_styles=False, 
+                html_only=False, html_inline=False, html_tab_width=8,
+                html_lines=False, html_lines_table=False, html_lines_style='',
+                html_highlight='', html_highlight_style='', html_base_line=1,
+                html_prevent_surrounding_pre=False, html_linkable_lines=False):
+    """Format tokens for HTML output."""
+    if html_only:
+        return ''.join(html.escape(str(v)) for t, v in tokens)
+    
+    result = []
+    if html_lines:
+        for i, (token_type, value) in enumerate(tokens):
+            line_num = html_base_line + i
+            if html_lines_table:
+                result.append(f'<tr><td>{line_num}</td><td>{html.escape(str(value))}</td></tr>')
+            else:
+                result.append(f'<span class="line-num">{line_num}</span> {html.escape(str(value))}')
+    else:
+        for token_type, value in tokens:
+            result.append(html.escape(str(value)))
+    
+    return '\n'.join(result)
+
+def format_json(tokens):
+    """Format tokens as JSON."""
+    return json.dumps([(t, v) for t, v in tokens])
+
+def format_svg(tokens):
+    """Format tokens as SVG."""
+    result = []
+    result.append('<?xml version="1.0" encoding="UTF-8"?>')
+    result.append('<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">')
+    for token_type, value in tokens:
+        result.append(f'<text x="0" y="20">{html.escape(str(value))}</text>')
+    result.append('</svg>')
+    return '\n'.join(result)
+
+def format_tokens(tokens, formatter='terminal', **kwargs):
+    """Format tokens using the specified formatter."""
+    if formatter == 'terminal':
+        return format_terminal(tokens)
+    elif formatter == 'html':
+        return format_html(tokens, **kwargs)
+    elif formatter == 'json':
+        return format_json(tokens)
+    elif formatter == 'svg':
+        return format_svg(tokens)
+    elif formatter == 'noop':
+        return ''.join(str(v) for t, v in tokens)
+    else:
+        return format_terminal(tokens)
+
+def get_lexer(lexer_name):
+    """Get lexer function based on name."""
+    if lexer_name == 'python':
+        return tokenize_python
+    elif lexer_name == 'autodetect':
+        # Simple autodetection based on file extension
+        def autodetect(text):
+            return tokenize_python(text)
+        return autodetect
+    else:
+        # Default to Python for now
+        return tokenize_python
+
+def process_file(file, lexer_name, style, formatter, json_flag, html_flag, svg_flag,
+                 html_prefix, html_styles, html_all_styles, html_only, html_inline,
+                 html_tab_width, html_lines, html_lines_table, html_lines_style,
+                 html_highlight, html_highlight_style, html_base_line,
+                 html_prevent_surrounding_pre, html_linkable_lines,
+                 trace, check, unbuffered, fail, filename):
+    """Process a single file."""
+    try:
+        with open(file, 'r', encoding='utf-8', errors='replace') as f:
+            content = f.read()
+    except FileNotFoundError:
+        print(f"executable: error: open {file}: no such file or directory", file=sys.stderr)
+        sys.exit(1)
+    except Exception as e:
+        print(f"executable: error: {e}", file=sys.stderr)
+        sys.exit(1)
+    
+    # Get lexer
+    lexer = get_lexer(lexer_name)
+    
+    # Tokenize
+    tokens = lexer(content)
+    
+    # Format
+    if json_flag or html_flag or svg_flag:
+        formatted = format_tokens(tokens, formatter,
+            html_prefix=html_prefix, html_styles=html_styles,
+            html_all_styles=html_all_styles, html_only=html_only,
+            html_inline=html_inline, html_tab_width=html_tab_width,
+            html_lines=html_lines, html_lines_table=html_lines_table,
+            html_lines_style=html_lines_style, html_highlight=html_highlight,
+            html_highlight_style=html_highlight_style, html_base_line=html_base_line,
+            html_prevent_surrounding_pre=html_prevent_surrounding_pre,
+            html_linkable_lines=html_linkable_lines)
+    else:
+        formatted = format_tokens(tokens, formatter)
+    
+    if unbuffered:
+        sys.stdout.write(formatted)
+    else:
+        print(formatted, end='')
+
