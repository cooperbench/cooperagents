diff --git a/src/main.rs b/src/main.rs
new file mode 100644
index 0000000..071c693
--- /dev/null
+++ b/src/main.rs
@@ -0,0 +1,10 @@
+use fancy_regex::Captures;
+fn main() {
+    println!("srgn 0.14.1");
+    let r = fancy_regex::Regex::new("a(?P<foo>b)c").unwrap();
+    if let Ok(Some(c)) = r.captures("xabc") {
+        println!("match={}", c.get(0).unwrap().as_str());
+        println!("cap1={:?}", c.get(1).map(|m| m.as_str()));
+        println!("named={:?}", c.name("foo").map(|m| m.as_str()));
+    }
+}
