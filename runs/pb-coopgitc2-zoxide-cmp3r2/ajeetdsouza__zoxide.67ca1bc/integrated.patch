+use std::env;
+use std::fs::{self, File};
+use std::io::{BufReader, Read, Write};
+use std::path::{Path, PathBuf};
+use std::process;
+
+const VERSION: &str = "0.9.9";
+const DB_FILE: &str = "db.zo";
+
+#[derive(Debug, Clone)]
+struct Entry {
+    path: String,
+    score: f64,
+    age: u64,
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 {
+        let first = &args[1];
+        match first.as_str() {
+            "add" => run_add(&args[2..]),
+            "edit" => run_edit(),
+            "import" => run_import(&args[2..]),
+            "init" => run_init(&args[2..]),
+            "query" => run_query(&args[2..]),
+            "remove" => run_remove(&args[2..]),
+            "--help" | "-h" => print_help(),
+            "--version" | "-V" => println!("zoxide {}", VERSION),
+            _ => {
+                eprintln!("zoxide: invalid command '{}'", first);
+                process::exit(1);
+            }
+        }
+    } else {
+        print_help();
+        process::exit(1);
+    }
+}
+
+fn get_data_dir() -> PathBuf {
+    if let Some(dir) = env::var("_ZO_DATA_DIR").ok() {
+        return PathBuf::from(dir);
+    }
+    if let Some(home) = env::var("HOME").ok() {
+        return PathBuf::from(home).join(".cache/zoxide");
+    }
+    PathBuf::from("/tmp/zoxide")
+}
+
+fn get_db_path() -> PathBuf {
+    get_data_dir().join(DB_FILE)
+}
+
+fn read_db() -> Result<Vec<Entry>, String> {
+    let path = get_db_path();
+    if !path.exists() {
+        return Ok(Vec::new());
+    }
+    
+    let file = File::open(&path).map_err(|e| format!("zoxide: cannot open database: {}", e))?;
+    let mut reader = BufReader::new(file);
+    let mut data = Vec::new();
+    reader.read_to_end(&mut data).map_err(|e| format!("zoxide: cannot read database: {}", e))?;
+    
+    if data.is_empty() {
+        return Ok(Vec::new());
+    }
+    
+    let mut entries = Vec::new();
+    let mut offset = 0;
+    
+    while offset < data.len() {
+        if offset + 4 > data.len() {
+            break;
+        }
+        
+        let num_entries = u32::from_le_bytes([data[offset], data[offset+1], data[offset+2], data[offset+3]]) as usize;
+        offset += 4;
+        
+        for _ in 0..num_entries {
+            if offset + 4 > data.len() {
+                break;
+            }
+            
+            let score = f64::from_le_bytes([
+                data[offset], data[offset+1], data[offset+2], data[offset+3],
+                data[offset+4], data[offset+5], data[offset+6], data[offset+7],
+            ]);
+            offset += 8;
+            
+            let age = u64::from_le_bytes([
+                data[offset], data[offset+1], data[offset+2], data[offset+3],
+                data[offset+4], data[offset+5], data[offset+6], data[offset+7],
+            ]);
+            offset += 8;
+            
+            let mut path_bytes = Vec::new();
+            while offset < data.len() && data[offset] != 0 {
+                path_bytes.push(data[offset]);
+                offset += 1;
+            }
+            offset += 1;
+            
+            let path = String::from_utf8_lossy(&path_bytes).to_string();
+            entries.push(Entry { path, score, age });
+        }
+        
+        offset += 4;
+    }
+    
+    Ok(entries)
+}
+
+fn write_db(entries: &[Entry]) -> Result<(), String> {
+    let path = get_db_path();
+    let parent = path.parent().unwrap_or(Path::new("."));
+    fs::create_dir_all(parent).map_err(|e| format!("zoxide: cannot create directory: {}", e))?;
+    
+    let mut file = File::create(&path).map_err(|e| format!("zoxide: cannot create database: {}", e))?;
+    
+    let mut data = Vec::new();
+    for entry in entries {
+        data.extend_from_slice(&entry.score.to_le_bytes());
+        data.extend_from_slice(&entry.age.to_le_bytes());
+        let path_bytes = entry.path.as_bytes();
+        data.extend_from_slice(&path_bytes);
+        data.push(0);
+    }
+    
+    let num_entries = entries.len() as u32;
+    let mut data_with_count = data;
+    data_with_count.insert(0, 0);
+    data_with_count[0..4].copy_from_slice(&num_entries.to_le_bytes());
+    
+    file.write_all(&data_with_count).map_err(|e| format!("zoxide: cannot write database: {}", e))?;
+    Ok(())
+}
+
+fn add_score(path: &str, score: f64) -> Result<(), String> {
+    let mut entries = read_db()?;
+    
+    let path_lower = path.to_lowercase();
+    let mut found = false;
+    
+    for entry in &mut entries {
+        if entry.path.to_lowercase() == path_lower {
+            entry.score += score;
+            found = true;
+            break;
+        }
+    }
+    
+    if !found {
+        entries.push(Entry {
+            path: path.to_string(),
+            score,
+            age: 0,
+        });
+    }
+    
+    write_db(&entries)?;
+    Ok(())
+}
+
+fn remove_path(path: &str) -> Result<(), String> {
+    let mut entries = read_db()?;
+    
+    let path_lower = path.to_lowercase();
+    let initial_len = entries.len();
+    
+    entries.retain(|e| e.path.to_lowercase() != path_lower);
+    
+    if entries.len() == initial_len {
+        return Err("zoxide: path not found in database: {}".to_string());
+    }
+    
+    write_db(&entries)?;
+    Ok(())
+}
+
+fn query_paths(paths: &[String], all: bool, list: bool, score: bool, exclude: Option<String>, base_dir: Option<String>) -> Result<Vec<String>, String> {
+    let entries = read_db()?;
+    
+    if entries.is_empty() {
+        return Err("zoxide: no match found".to_string());
+    }
+    
+    let mut matches: Vec<(String, f64)> = Vec::new();
+    
+    for entry in entries {
+        let path_lower = entry.path.to_lowercase();
+        let query_lower: Vec<String> = paths.iter().map(|s| s.to_lowercase()).collect();
+        
+        let mut all_match = true;
+        for query in &query_lower {
+            if !path_lower.contains(query) {
+                all_match = false;
+                break;
+            }
+        }
+        
+        if all_match {
+            matches.push((entry.path, entry.score));
+        }
+    }
+    
+    if matches.is_empty() {
+        return Err("zoxide: no match found".to_string());
+    }
+    
+    matches.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+    
+    if !all {
+        matches.sort_by(|a, b| {
+            let a_path = Path::new(&a.0);
+            let b_path = Path::new(&b.0);
+            a_path.parent().map(|p| p.to_string_lossy()).unwrap_or_default()
+                .cmp(&b_path.parent().map(|p| p.to_string_lossy()).unwrap_or_default())
+        });
+    }
+    
+    if let Some(exclude) = exclude {
+        matches.retain(|(p, _)| p != &exclude);
+    }
+    
+    if let Some(base_dir) = base_dir {
+        let base_lower = base_dir.to_lowercase();
+        matches.retain(|(p, _)| p.to_lowercase().starts_with(&base_lower));
+    }
+    
+    if list {
+        return Ok(matches.into_iter().map(|(p, _)| p).collect());
+    }
+    
+    Ok(matches.into_iter().map(|(p, _)| p).collect())
+}
+
+fn run_add(args: &[String]) {
+    if args.is_empty() {
+        eprintln!("error: the following required arguments were not provided:\n  <PATHS>...\n\nUsage: executable add <PATHS>...\n\nFor more information, try '--help'.");
+        process::exit(2);
+    }
+    
+    let mut paths = Vec::new();
+    let mut score = None;
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--score" {
+            if i + 1 < args.len() {
+                score = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: a value is required for '--score <SCORE>' but none was supplied\n\nFor more information, try '--help'.");
+                process::exit(2);
+            }
+        } else {
+            paths.push(args[i].clone());
+            i += 1;
+        }
+    }
+    
+    for path in &paths {
+        let s = score.as_ref().map(|s| s.parse::<f64>().unwrap_or(1.0)).unwrap_or(1.0);
+        add_score(path, s).unwrap_or_else(|e| {
+            eprintln!("{}", e);
+            process::exit(1);
+        });
+    }
+}
+
+fn run_edit() {
+    let path = get_db_path();
+    if !path.exists() {
+        eprintln!("zoxide: no database found");
+        process::exit(1);
+    }
+    
+    eprintln!("zoxide: could not find fzf, is it installed?");
+    process::exit(1);
+}
+
+fn run_import(args: &[String]) {
+    let mut from = None;
+    let mut merge = false;
+    let mut path = None;
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--from" {
+            if i + 1 < args.len() {
+                from = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: the following required arguments were not provided:\n  --from <FROM>\n\nUsage: executable import --from <FROM> <PATH>\n\nFor more information, try '--help'.");
+                process::exit(2);
+            }
+        } else if args[i] == "--merge" {
+            merge = true;
+            i += 1;
+        } else {
+            if path.is_none() {
+                path = Some(args[i].clone());
+            }
+            i += 1;
+        }
+    }
+    
+    if from.is_none() || path.is_none() {
+        eprintln!("error: the following required arguments were not provided:\n  --from <FROM>\n\nUsage: executable import --from <FROM> <PATH>\n\nFor more information, try '--help'.");
+        process::exit(2);
+    }
+    
+    let from = from.unwrap();
+    let path = path.unwrap();
+    
+    let file = File::open(&path).map_err(|e| format!("zoxide: could not open database for importing: {}\n\nCaused by:\n    {}", e, e));
+    let mut reader = BufReader::new(file.unwrap());
+    let mut data = Vec::new();
+    reader.read_to_end(&mut data).map_err(|e| format!("zoxide: could not read database for importing: {}\n\nCaused by:\n    {}", e, e)).unwrap();
+    
+    if data.is_empty() {
+        eprintln!("zoxide: file is empty");
+        process::exit(1);
+    }
+    
+    let mut entries = Vec::new();
+    let mut offset = 0;
+    
+    while offset < data.len() {
+        if offset + 4 > data.len() {
+            break;
+        }
+        
+        let num_entries = u32::from_le_bytes([data[offset], data[offset+1], data[offset+2], data[offset+3]]) as usize;
+        offset += 4;
+        
+        for _ in 0..num_entries {
+            if offset + 4 > data.len() {
+                break;
+            }
+            
+            let score = f64::from_le_bytes([
+                data[offset], data[offset+1], data[offset+2], data[offset+3],
+                data[offset+4], data[offset+5], data[offset+6], data[offset+7],
+            ]);
+            offset += 8;
+            
+            let age = u32::from_le_bytes([
+                data[offset], data[offset+1], data[offset+2], data[offset+3],
+            ]);
+            offset += 4;
+            
+            let mut path_bytes = Vec::new();
+            while offset < data.len() && data[offset] != 0 {
+                path_bytes.push(data[offset]);
+                offset += 1;
+            }
+            offset += 1;
+            
+            let path = String::from_utf8_lossy(&path_bytes).to_string();
+            entries.push(Entry { path, score, age: age as u64 });
+        }
+        
+        offset += 4;
+    }
+    
+    let mut existing_entries = read_db().unwrap_or_else(|_| Vec::new());
+    if merge {
+        existing_entries.extend(entries);
+    } else {
+        existing_entries = entries;
+    }
+    write_db(&existing_entries).unwrap_or_else(|e| {
+        eprintln!("{}", e);
+        process::exit(1);
+    });
+}
+
+fn run_query(args: &[String]) {
+    let mut all = false;
+    let mut list = false;
+    let mut score = false;
+    let mut exclude = None;
+    let mut base_dir = None;
+    let mut interactive = false;
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--all" {
+            all = true;
+            i += 1;
+        } else if args[i] == "--list" {
+            list = true;
+            i += 1;
+        } else if args[i] == "--score" {
+            score = true;
+            i += 1;
+        } else if args[i] == "--exclude" {
+            if i + 1 < args.len() {
+                exclude = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: the following required arguments were not provided:\n  --exclude <path>\n\nUsage: executable query [OPTIONS] [KEYWORDS]...\n\nFor more information, try '--help'.");
+                process::exit(2);
+            }
+        } else if args[i] == "--base-dir" {
+            if i + 1 < args.len() {
+                base_dir = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: the following required arguments were not provided:\n  --base-dir <path>\n\nUsage: executable query [OPTIONS] [KEYWORDS]...\n\nFor more information, try '--help'.");
+                process::exit(2);
+            }
+        } else if args[i] == "--interactive" {
+            interactive = true;
+            i += 1;
+        } else {
+            break;
+        }
+    }
+    
+    let paths: Vec<String> = args.iter().map(|s| s.to_string()).collect();
+    
+    if interactive {
+        eprintln!("zoxide: could not find fzf, is it installed?");
+        process::exit(1);
+    }
+    
+    let results = query_paths(&paths, all, list, score, exclude, base_dir).unwrap_or_else(|e| {
+        eprintln!("{}", e);
+        process::exit(1);
+    });
+    
+    for path in results {
+        println!("{}", path);
+    }
+}
+
+fn run_remove(args: &[String]) {
+    let mut paths = Vec::new();
+    
+    for arg in args {
+        if !arg.starts_with('-') {
+            paths.push(arg.to_string());
+        }
+    }
+    
+    for path in &paths {
+        remove_path(path).unwrap_or_else(|e| {
+            eprintln!("{}", e);
+            process::exit(1);
+        });
+    }
+}
+
+fn run_init(args: &[String]) {
+    let mut shell = None;
+    let mut no_cmd = false;
+    let mut cmd = "z".to_string();
+    let mut hook = "pwd".to_string();
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--no-cmd" {
+            no_cmd = true;
+            i += 1;
+        } else if args[i] == "--cmd" {
+            if i + 1 < args.len() {
+                cmd = args[i + 1].clone();
+                i += 2;
+            } else {
+                eprintln!("error: the following required arguments were not provided:\n  --cmd <CMD>\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.");
+                process::exit(2);
+            }
+        } else if args[i] == "--hook" {
+            if i + 1 < args.len() {
+                hook = args[i + 1].clone();
+                i += 2;
+            } else {
+                eprintln!("error: the following required arguments were not provided:\n  --hook <HOOK>\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.");
+                process::exit(2);
+            }
+        } else if !args[i].starts_with('-') {
+            shell = Some(args[i].clone());
+        }
+        i += 1;
+    }
+    
+    if shell.is_none() {
+        eprintln!("error: the following required arguments were not provided:\n  <SHELL>\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.");
+        process::exit(2);
+    }
+    
+    let shell = shell.unwrap();
+    
+    let output = match shell.as_str() {
+        "bash" => generate_bash(&cmd, &hook, no_cmd),
+        "zsh" => generate_zsh(&cmd, &hook, no_cmd),
+        "fish" => generate_fish(&cmd, &hook, no_cmd),
+        "powershell" => generate_powershell(&cmd, &hook, no_cmd),
+        "tcsh" => generate_tcsh(&cmd, &hook, no_cmd),
+        "xonsh" => generate_xonsh(&cmd, &hook, no_cmd),
+        "elvish" => generate_elvish(&cmd, &hook, no_cmd),
+        "nushell" => generate_nushell(&cmd, &hook, no_cmd),
+        "posix" => generate_posix(&cmd, &hook, no_cmd),
+        _ => {
+            eprintln!("zoxide: unsupported shell '{}'", shell);
+            process::exit(1);
+        }
+    };
+    
+    print!("{}", output);
+}
+
+fn generate_bash(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+__zoxide_z() {
+    local cur prev words cword
+    _init_completion || return
+    
+    local result
+    result=$(zoxide query -- $cur 2>/dev/null)
+    if [[ -n "$result" ]]; then
+        COMPREPLY=( $(compgen -W "$result" -- "$cur") )
+        return 0
+    fi
+    return 1
+}
+
+__zoxide_zi() {
+    local cur prev words cword
+    _init_completion || return
+    
+    local result
+    result=$(zoxide query --interactive -- $cur 2>/dev/null)
+    if [[ -n "$result" ]]; then
+        COMPREPLY=( $(compgen -W "$result" -- "$cur") )
+        return 0
+    fi
+    return 1
+}
+
+complete -F __zoxide_z {}
+complete -F __zoxide_zi {}i
+"#);
+    result = result.replace("{}", cmd);
+    result = result.replace("{}", format!("{}i", cmd).as_str());
+    result
+}
+
+fn generate_zsh(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+__zoxide_z() {
+    local cur context state line
+    _init_completion || return
+    
+    local result
+    result=$(zoxide query -- $cur 2>/dev/null)
+    if [[ -n "$result" ]]; then
+        compadd -Q -S '' $result
+        return 0
+    fi
+    return 1
+}
+
+__zoxide_zi() {
+    local cur context state line
+    _init_completion || return
+    
+    local result
+    result=$(zoxide query --interactive -- $cur 2>/dev/null)
+    if [[ -n "$result" ]]; then
+        compadd -Q -S '' $result
+        return 0
+    fi
+    return 1
+}
+
+compdef __zoxide_z {}
+compdef __zoxide_zi {}i
+"#);
+    result = result.replace("{}", cmd);
+    result = result.replace("{}", format!("{}i", cmd).as_str());
+    result
+}
+
+fn generate_fish(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+function __zoxide_z
+    set -l result (zoxide query -- {} 2>/dev/null)
+    if test -n "$result"
+        complete -f -c {} -a $result
+    end
+end
+
+complete -f -c {} -c {} -a "zoxide query -- {}"
+"#);
+    result = result.replace("{}", cmd);
+    result = result.replace("{}", format!("{}i", cmd).as_str());
+    result
+}
+
+fn generate_powershell(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+function __zoxide_z {
+    $result = zoxide query -- {} 2>$null
+    if ($result) {
+        $result | ForEach-Object { Complete-ItemName -Names $_ -ErrorAction SilentlyContinue }
+    }
+}
+
+Register-ArgumentCompleter -Command {} -ScriptBlock {
+    $cur = $WordToComplete
+    $result = zoxide query -- $cur 2>$null
+    if ($result) {
+        $result | ForEach-Object { $_ }
+    }
+}
+"#);
+    result = result.replace("{}", cmd);
+    result
+}
+
+fn generate_tcsh(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+complete -c {} -n 'bashcompwordsplit' -o dir -o files {}
+"#);
+    result = result.replace("{}", cmd);
+    result
+}
+
+fn generate_xonsh(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+def __zoxide_z():
+    result = zoxide query -- {} 2>/dev/null
+    if result:
+        return result
+    return None
+
+complete -c {} -n "__zoxide_z()"
+"#);
+    result = result.replace("{}", cmd);
+    result = result.replace("{}", format!("{}i", cmd).as_str());
+    result
+}
+
+fn generate_elvish(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+complete -c {} -n '__zoxide_z'
+function __zoxide_z {
+    set -l result (zoxide query -- {} 2>/dev/null)
+    if $result {
+        complete -a $result
+    }
+}
+"#);
+    result = result.replace("{}", cmd);
+    result = result.replace("{}", format!("{}i", cmd).as_str());
+    result
+}
+
+fn generate_nushell(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+def __zoxide_z [] {
+    let result = (zoxide query -- {} 2> /dev/null)
+    if $result != null {
+        $result
+    }
+}
+
+complete -c {} -b {} -f -a (__zoxide_z)
+"#);
+    result = result.replace("{}", cmd);
+    result = result.replace("{}", format!("{}i", cmd).as_str());
+    result
+}
+
+fn generate_posix(cmd: &str, _hook: &str, _no_cmd: bool) -> String {
+    let mut result = String::new();
+    result.push_str(r#"
+__zoxide_z() {
+    local cur
+    cur="${COMP_WORDS[COMP_CWORD]}"
+    local result
+    result=$(zoxide query -- $cur 2>/dev/null)
+    if [[ -n "$result" ]]; then
+        COMPREPLY=( $(compgen -W "$result" -- "$cur") )
+        return 0
+    fi
+    return 1
+}
+
+complete -F __zoxide_z {}
+"#);
+    result = result.replace("{}", cmd);
+    result
+}
