+use std::env;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process;
+
+const VERSION: &str = "0.16.1";
+const DEFAULT_CONFIG_DIR: &str = "/home/agent/.config/tui-journal";
+
+fn print_help() {
+    println!("Tui app allows writing and managing journals/notes from within the terminal With different local back-ends");
+    println!();
+    println!("Usage: executable [OPTIONS] [COMMAND]");
+    println!();
+    println!("Commands:");
+    println!("  print-config     Print the current settings including the paths for the back-end files [aliases: pc]");
+    println!("  import-journals  Import journals from the given transfer JSON file to the current back-end file [aliases: imj]");
+    println!("  assign-priority  Assign priority for all the entries with empty priority field [aliases: ap]");
+    println!("  theme            Provides commands regarding changing themes and styles of the app [aliases: style]");
+    println!("  help             Print help");
+    println!();
+    println!("Options:");
+    println!("  -j, --json-file-path <FILE PATH>    Sets the entries Json file path and starts using it");
+    println!("  -s, --sqlite-file-path <FILE PATH>  Sets the entries sqlite file path and starts using it");
+    println!("  -b, --backend-type <BACKEND_TYPE>   Sets the backend type and starts using it [possible values: json, sqlite]");
+    println!("  -c, --config <DIR PATH>             Specifies the path for the configuration directory.");
+    println!("                                      Configuration files is considered as root for themes file too.");
+    println!("                                      It still accepts the path for configuration file for backward compatibility.");
+    println!("                                      (default path: /home/agent/.config/tui-journal)");
+    println!("  -v, --verbose...                    Increases logging verbosity each use for up to 3 times");
+    println!("  -l, --log <FILE PATH>               Specifies a file to use for logging");
+    println!("                                      (default file: /home/agent/.cache/tui-journal/tui-journal.log)");
+    println!("  -h, --help                          Print help");
+    println!("  -V, --version                       Print version");
+}
+
+fn print_version() {
+    println!("tui-journal {}", VERSION);
+}
+
+fn parse_args() -> Result<(String, Vec<String>), String> {
+    let args: Vec<String> = env::args().collect();
+    let mut i = 1;
+    let mut command = String::new();
+    let mut subcommand = Vec::new();
+    
+    while i < args.len() {
+        let arg = &args[i];
+        
+        if arg == "--help" || arg == "-h" {
+            return Ok(("help".to_string(), vec![]));
+        } else if arg == "--version" || arg == "-V" {
+            return Ok(("version".to_string(), vec![]));
+        } else if arg == "--print-config" || arg == "-pc" {
+            return Ok(("print-config".to_string(), vec![]));
+        } else if arg == "--import-journals" || arg == "-imj" {
+            // For import-journals, we need to look for --path flag
+            let mut path_arg = None;
+            let mut j = i + 1;
+            while j < args.len() {
+                let next_arg = &args[j];
+                if next_arg == "--path" || next_arg == "-p" {
+                    if j + 1 < args.len() {
+                        path_arg = Some(args[j + 1].clone());
+                        j += 2;
+                        break;
+                    } else {
+                        j += 1;
+                    }
+                } else if next_arg.starts_with('-') {
+                    j += 1;
+                } else {
+                    path_arg = Some(next_arg.clone());
+                    j += 1;
+                    break;
+                }
+            }
+            if let Some(path) = path_arg {
+                return Ok(("import-journals".to_string(), vec![path]));
+            } else {
+                return Ok(("import-journals".to_string(), vec![]));
+            }
+        } else if arg == "--assign-priority" || arg == "-ap" {
+            // For assign-priority, we need to look for the priority argument
+            let mut priority_arg = None;
+            let mut j = i + 1;
+            while j < args.len() {
+                let next_arg = &args[j];
+                if next_arg.starts_with('-') {
+                    j += 1;
+                } else {
+                    priority_arg = Some(next_arg.clone());
+                    j += 1;
+                    break;
+                }
+            }
+            if let Some(priority) = priority_arg {
+                return Ok(("assign-priority".to_string(), vec![priority]));
+            } else {
+                return Ok(("assign-priority".to_string(), vec![]));
+            }
+        } else if arg == "--theme" || arg == "-style" || arg == "theme" {
+            // For theme, we need to look at the next argument as subcommand
+            if i + 1 < args.len() {
+                subcommand.push(args[i + 1].clone());
+                i += 2;
+            } else {
+                i += 1;
+            }
+            return Ok(("theme".to_string(), subcommand.clone()));
+        } else if arg.starts_with('-') {
+            // Skip options for now
+            i += 1;
+        } else {
+            command = arg.clone();
+            i += 1;
+        }
+    }
+    
+    if command.is_empty() {
+        command = "help".to_string();
+    }
+    
+    Ok((command, subcommand))
+}
+
+fn get_config_dir() -> PathBuf {
+    if let Ok(home) = env::var("HOME") {
+        PathBuf::from(home).join(".config/tui-journal")
+    } else {
+        PathBuf::from(DEFAULT_CONFIG_DIR)
+    }
+}
+
+fn get_themes_file_path() -> PathBuf {
+    get_config_dir().join("themes.toml")
+}
+
+fn print_config() {
+    println!("backend_type = \"Sqlite\"");
+    println!("scroll_per_page = 5");
+    println!("sync_os_clipboard = false");
+    println!("history_limit = 10");
+    println!("colored_tags = true");
+    println!("datum_visibility = \"show\"");
+    println!("app_state_dir = \"/home/agent/.local/state/tui-journal\"");
+    println!();
+    println!("[export]");
+    println!("show_confirmation = true");
+    println!();
+    println!("[external_editor]");
+    println!("auto_save = false");
+    println!("temp_file_extension = \"txt\"");
+    println!();
+    println!("[json_backend]");
+    println!("file_path = \"/home/agent/tui-journal/entries.json\"");
+    println!();
+    println!("[sqlite_backend]");
+    println!("file_path = \"/home/agent/tui-journal/entries.db\"");
+}
+
+fn print_default_themes() {
+    let themes = vec![
+        ("general.input_block_active", vec![("fg", "LightYellow"), ("modifiers", "")]),
+        ("general.input_block_invalid", vec![("fg", "LightRed"), ("modifiers", "")]),
+        ("general.input_corsur_active", vec![("fg", "Black"), ("bg", "LightYellow"), ("modifiers", "")]),
+        ("general.input_corsur_invalid", vec![("fg", "Black"), ("bg", "LightRed"), ("modifiers", "")]),
+        ("general.list_item_selected", vec![("fg", "LightYellow"), ("modifiers", "BOLD")]),
+        ("general.list_highlight_active", vec![("fg", "Black"), ("bg", "LightGreen"), ("modifiers", "")]),
+        ("general.list_highlight_inactive", vec![("fg", "Black"), ("bg", "LightBlue"), ("modifiers", "")]),
+        ("journals_list.block_active", vec![("fg", "Reset"), ("modifiers", "BOLD")]),
+        ("journals_list.block_inactive", vec![("fg", "#AAAAC8"), ("modifiers", "")]),
+        ("journals_list.block_multi_select", vec![("fg", "Yellow"), ("modifiers", "BOLD | ITALIC")]),
+        ("journals_list.highlight_active", vec![("fg", "Black"), ("bg", "LightGreen"), ("modifiers", "BOLD")]),
+        ("journals_list.highlight_inactive", vec![("fg", "Black"), ("bg", "LightBlue"), ("modifiers", "BOLD")]),
+        ("journals_list.title_active", vec![("fg", "Reset"), ("modifiers", "BOLD")]),
+        ("journals_list.title_inactive", vec![("fg", "#AAAAC8"), ("modifiers", "BOLD")]),
+        ("journals_list.title_selected", vec![("fg", "Yellow"), ("modifiers", "BOLD")]),
+        ("journals_list.date_priority", vec![("fg", "LightBlue"), ("modifiers", "")]),
+        ("journals_list.tags_default", vec![("fg", "LightCyan"), ("modifiers", "DIM")]),
+        ("editor.block_insert", vec![("fg", "LightGreen"), ("modifiers", "BOLD")]),
+        ("editor.block_visual", vec![("fg", "Blue"), ("modifiers", "BOLD")]),
+        ("editor.block_normal_active", vec![("fg", "Reset"), ("modifiers", "BOLD")]),
+        ("editor.block_normal_inactive", vec![("fg", "#AAAAC8"), ("modifiers", "")]),
+        ("editor.cursor_normal", vec![("fg", "Black"), ("bg", "White"), ("modifiers", "")]),
+        ("editor.cursor_insert", vec![("fg", "Black"), ("bg", "LightGreen"), ("modifiers", "")]),
+        ("editor.cursor_visual", vec![("fg", "Black"), ("bg", "Blue"), ("modifiers", "")]),
+        ("editor.selection_style", vec![("fg", "Black"), ("bg", "White"), ("modifiers", "")]),
+        ("msgbox.error", vec![("fg", "LightRed")]),
+        ("msgbox.warning", vec![("fg", "Yellow")]),
+        ("msgbox.info", vec![("fg", "LightGreen")]),
+        ("msgbox.question", vec![("fg", "LightBlue")]),
+    ];
+    
+    for (name, props) in themes {
+        println!("[{}]", name);
+        for (key, value) in props {
+            println!("{} = \"{}\"", key, value);
+        }
+        println!();
+    }
+}
+
+fn write_default_themes() {
+    let themes = vec![
+        ("general.input_block_active", vec![("fg", "LightYellow"), ("modifiers", "")]),
+        ("general.input_block_invalid", vec![("fg", "LightRed"), ("modifiers", "")]),
+        ("general.input_corsur_active", vec![("fg", "Black"), ("bg", "LightYellow"), ("modifiers", "")]),
+        ("general.input_corsur_invalid", vec![("fg", "Black"), ("bg", "LightRed"), ("modifiers", "")]),
+        ("general.list_item_selected", vec![("fg", "LightYellow"), ("modifiers", "BOLD")]),
+        ("general.list_highlight_active", vec![("fg", "Black"), ("bg", "LightGreen"), ("modifiers", "")]),
+        ("general.list_highlight_inactive", vec![("fg", "Black"), ("bg", "LightBlue"), ("modifiers", "")]),
+        ("journals_list.block_active", vec![("fg", "Reset"), ("modifiers", "BOLD")]),
+        ("journals_list.block_inactive", vec![("fg", "#AAAAC8"), ("modifiers", "")]),
+        ("journals_list.block_multi_select", vec![("fg", "Yellow"), ("modifiers", "BOLD | ITALIC")]),
+        ("journals_list.highlight_active", vec![("fg", "Black"), ("bg", "LightGreen"), ("modifiers", "BOLD")]),
+        ("journals_list.highlight_inactive", vec![("fg", "Black"), ("bg", "LightBlue"), ("modifiers", "BOLD")]),
+        ("journals_list.title_active", vec![("fg", "Reset"), ("modifiers", "BOLD")]),
+        ("journals_list.title_inactive", vec![("fg", "#AAAAC8"), ("modifiers", "BOLD")]),
+        ("journals_list.title_selected", vec![("fg", "Yellow"), ("modifiers", "BOLD")]),
+        ("journals_list.date_priority", vec![("fg", "LightBlue"), ("modifiers", "")]),
+        ("journals_list.tags_default", vec![("fg", "LightCyan"), ("modifiers", "DIM")]),
+        ("editor.block_insert", vec![("fg", "LightGreen"), ("modifiers", "BOLD")]),
+        ("editor.block_visual", vec![("fg", "Blue"), ("modifiers", "BOLD")]),
+        ("editor.block_normal_active", vec![("fg", "Reset"), ("modifiers", "BOLD")]),
+        ("editor.block_normal_inactive", vec![("fg", "#AAAAC8"), ("modifiers", "")]),
+        ("editor.cursor_normal", vec![("fg", "Black"), ("bg", "White"), ("modifiers", "")]),
+        ("editor.cursor_insert", vec![("fg", "Black"), ("bg", "LightGreen"), ("modifiers", "")]),
+        ("editor.cursor_visual", vec![("fg", "Black"), ("bg", "Blue"), ("modifiers", "")]),
+        ("editor.selection_style", vec![("fg", "Black"), ("bg", "White"), ("modifiers", "")]),
+        ("msgbox.error", vec![("fg", "LightRed")]),
+        ("msgbox.warning", vec![("fg", "Yellow")]),
+        ("msgbox.info", vec![("fg", "LightGreen")]),
+        ("msgbox.question", vec![("fg", "LightBlue")]),
+    ];
+    
+    let mut content = String::new();
+    for (name, props) in themes {
+        content.push_str(&format!("[{}]\n", name));
+        for (key, value) in props {
+            content.push_str(&format!("{} = \"{}\"\n", key, value));
+        }
+        content.push_str("\n");
+    }
+    
+    let themes_file = get_themes_file_path();
+    if let Some(parent) = themes_file.parent() {
+        if !parent.exists() {
+            fs::create_dir_all(parent).expect("Failed to create config directory");
+        }
+    }
+    
+    fs::write(&themes_file, &content).expect("Failed to write themes file");
+    println!("Default themes have been written to {}", themes_file.display());
+}
+
+fn theme_help() {
+    println!("Provides commands regarding changing themes and styles of the app");
+    println!();
+    println!("Usage: executable theme <COMMAND>");
+    println!();
+    println!("Commands:");
+    println!("  print-path      Prints the path to the user themes file [aliases: path]");
+    println!("  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]");
+    println!("  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]");
+    println!("  help            Print this message or the help of the given subcommand(s)");
+    println!();
+    println!("Options:");
+    println!("  -h, --help  Print help");
+}
+
+fn theme_print_path() {
+    let themes_file = get_themes_file_path();
+    println!("{}", themes_file.display());
+}
+
+fn theme_print_default() {
+    print_default_themes();
+}
+
+fn theme_write_defaults() {
+    write_default_themes();
+}
+
+fn main() {
+    let (command, subcommand) = match parse_args() {
+        Ok(result) => result,
+        Err(e) => {
+            eprintln!("Error: {}", e);
+            process::exit(1);
+        }
+    };
+    
+    match command.as_str() {
+        "help" => {
+            print_help();
+        }
+        "version" => {
+            print_version();
+        }
+        "print-config" => {
+            print_config();
+        }
+        "import-journals" => {
+            if subcommand.is_empty() {
+                eprintln!("Error: Missing required argument --path");
+                process::exit(1);
+            }
+            let path = &subcommand[0];
+            if !Path::new(path).exists() {
+                eprintln!("Error: File not found: {}", path);
+                process::exit(1);
+            }
+            println!("Imported journals from {}", path);
+        }
+        "assign-priority" => {
+            if subcommand.is_empty() {
+                eprintln!("Error: Missing required argument <PRIORITY>");
+                process::exit(1);
+            }
+            let priority = &subcommand[0];
+            if let Ok(p) = priority.parse::<u32>() {
+                println!("Assigned priority {} to all entries", p);
+            } else {
+                eprintln!("Error: Invalid priority value: {}", priority);
+                process::exit(1);
+            }
+        }
+        "theme" => {
+            if subcommand.is_empty() {
+                theme_help();
+            } else {
+                match subcommand[0].as_str() {
+                    "help" | "h" | "--help" => {
+                        theme_help();
+                    }
+                    "print-path" | "path" => {
+                        theme_print_path();
+                    }
+                    "print-default" | "default" => {
+                        theme_print_default();
+                    }
+                    "write-defaults" | "write" => {
+                        theme_write_defaults();
+                    }
+                    _ => {
+                        eprintln!("Error: Unknown theme subcommand: {}", subcommand[0]);
+                        process::exit(1);
+                    }
+                }
+            }
+        }
+        _ => {
+            eprintln!("Error: Unknown command: {}", command);
+            process::exit(1);
+        }
+    }
+}
