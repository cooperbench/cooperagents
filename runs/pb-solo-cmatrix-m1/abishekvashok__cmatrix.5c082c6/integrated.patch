index 0000000..185a9a3
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,358 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ctype.h>
+#include <math.h>
+
+#define VERSION "2.0"
+#define BUILD_TIME "22:13:51, Jun 11 2026"
+#define AUTHOR "abishekvashok@gmail.com"
+#define WEB "https://github.com/abishekvashok/cmatrix"
+
+#define MAX_COLS 200
+#define MAX_ROWS 100
+#define MAX_MSG_LEN 100
+
+typedef struct {
+    int x, y;
+    char c;
+    int bold;
+    int shadow;
+    int color;
+} Cell;
+
+typedef struct {
+    int width, height;
+    int cols, rows;
+    int async;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int force_term;
+    int linux_mode;
+    int old_scroll;
+    int only_shadows;
+    int lock;
+    int rainbow;
+    int every_char;
+    int lambda_mode;
+    int x_mode;
+    int update_delay;
+    int color;
+    int message;
+    char message_text[MAX_MSG_LEN];
+    char tty[64];
+    int tty_set;
+    int use_japanese;
+    int screensaver;
+} Config;
+
+static Config config = {
+    .width = 80,
+    .height = 24,
+    .cols = 80,
+    .rows = 24,
+    .async = 0,
+    .bold = 0,
+    .all_bold = 0,
+    .no_bold = 0,
+    .force_term = 0,
+    .linux_mode = 0,
+    .old_scroll = 0,
+    .only_shadows = 0,
+    .lock = 0,
+    .rainbow = 0,
+    .every_char = 0,
+    .lambda_mode = 0,
+    .x_mode = 0,
+    .update_delay = 4,
+    .color = 2,
+    .message = 0,
+    .tty_set = 0,
+    .use_japanese = 0,
+    .screensaver = 0
+};
+
+static char matrix_chars[] = "01";
+static char katakana_chars[] = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static char katakana_chars2[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+static int get_color_index(const char *color) {
+    if (strcmp(color, "green") == 0) return 2;
+    if (strcmp(color, "red") == 0) return 1;
+    if (strcmp(color, "blue") == 0) return 4;
+    if (strcmp(color, "white") == 0) return 7;
+    if (strcmp(color, "yellow") == 0) return 3;
+    if (strcmp(color, "cyan") == 0) return 6;
+    if (strcmp(color, "magenta") == 0) return 5;
+    if (strcmp(color, "black") == 0) return 0;
+    return 2;
+}
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s)\n", VERSION, BUILD_TIME);
+    printf("Email: %s\n", AUTHOR);
+    printf("Web: %s\n", WEB);
+}
+
+static void parse_args(int argc, char *argv[]) {
+    int i = 1;
+    while (i < argc) {
+        if (strcmp(argv[i], "--help") == 0 || strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "--version") == 0 || strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            config.async = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            config.bold = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            config.all_bold = 1;
+            config.bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            config.use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            config.force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            config.linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            config.lock = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            config.old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            config.no_bold = 1;
+            config.bold = 0;
+            config.all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            config.screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            config.x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            config.rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            config.lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            config.every_char = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            config.update_delay = atoi(argv[i + 1]);
+            if (config.update_delay < 0 || config.update_delay > 10) {
+                fprintf(stderr, "Error: update delay must be 0-10\n");
+                exit(1);
+            }
+            i++;
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            config.color = get_color_index(argv[i + 1]);
+            if (config.color == 2) {
+                fprintf(stderr, " Invalid color selection\n");
+                fprintf(stderr, " Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+                exit(1);
+            }
+            i++;
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            strncpy(config.message_text, argv[i + 1], MAX_MSG_LEN - 1);
+            config.message = 1;
+            i++;
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            strncpy(config.tty, argv[i + 1], sizeof(config.tty) - 1);
+            config.tty_set = 1;
+            i++;
+        } else {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            print_usage();
+            exit(1);
+        }
+        i++;
+    }
+}
+
+static int setup_terminal(void) {
+    struct termios oldt, newt;
+    if (tcgetattr(STDIN_FILENO, &oldt) != 0) {
+        return -1;
+    }
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) != 0) {
+        return -1;
+    }
+    return 0;
+}
+
+static void restore_terminal(struct termios *oldt) {
+    tcsetattr(STDIN_FILENO, TCSANOW, oldt);
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+    fflush(stdout);
+}
+
+static void set_cursor(int x, int y) {
+    printf("\033[%d;%dH", y + 1, x + 1);
+    fflush(stdout);
+}
+
+static void set_color(int color) {
+    printf("\033[%dm", 30 + color);
+    fflush(stdout);
+}
+
+static void set_bold(int bold) {
+    if (bold) {
+        printf("\033[1m");
+    } else {
+        printf("\033[22m");
+    }
+    fflush(stdout);
+}
+
+static void set_shadow(int shadow) {
+    if (shadow) {
+        printf("\033[47m");
+    } else {
+        printf("\033[27m");
+    }
+    fflush(stdout);
+}
+
+static void draw_cell(int x, int y, char c, int bold, int shadow, int color) {
+    set_cursor(x, y);
+    set_color(color);
+    set_bold(bold);
+    set_shadow(shadow);
+    printf("%c", c);
+    fflush(stdout);
+}
+
+static void draw_matrix(void) {
+    Cell cells[MAX_COLS * MAX_ROWS];
+    int i, j;
+    int x, y;
+    int color = config.color;
+    int use_katakana = config.use_japanese;
+    char *chars = use_katakana ? katakana_chars : matrix_chars;
+    int char_len = use_katakana ? strlen(katakana_chars) : strlen(matrix_chars);
+    
+    for (i = 0; i < config.cols * config.rows; i++) {
+        cells[i].x = i % config.cols;
+        cells[i].y = i / config.cols;
+        cells[i].c = chars[rand() % char_len];
+        cells[i].bold = config.bold;
+        cells[i].shadow = config.only_shadows;
+        cells[i].color = color;
+    }
+    
+    for (i = 0; i < config.cols * config.rows; i++) {
+        draw_cell(cells[i].x, cells[i].y, cells[i].c, cells[i].bold, cells[i].shadow, cells[i].color);
+    }
+}
+
+static void update_matrix(void) {
+    Cell cells[MAX_COLS * MAX_ROWS];
+    int i, j;
+    int x, y;
+    int color = config.color;
+    int use_katakana = config.use_japanese;
+    char *chars = use_katakana ? katakana_chars : matrix_chars;
+    int char_len = use_katakana ? strlen(katakana_chars) : strlen(matrix_chars);
+    
+    for (i = 0; i < config.cols * config.rows; i++) {
+        cells[i].x = i % config.cols;
+        cells[i].y = i / config.cols;
+        cells[i].c = chars[rand() % char_len];
+        cells[i].bold = config.bold;
+        cells[i].shadow = config.only_shadows;
+        cells[i].color = color;
+    }
+    
+    for (i = 0; i < config.cols * config.rows; i++) {
+        draw_cell(cells[i].x, cells[i].y, cells[i].c, cells[i].bold, cells[i].shadow, cells[i].color);
+    }
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    if (config.x_mode) {
+        fprintf(stderr, "X window mode not supported in this build\n");
+        return 1;
+    }
+    
+    if (config.linux_mode) {
+        fprintf(stderr, "Linux mode requires matrix.fnt font\n");
+        return 1;
+    }
+    
+    if (config.force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    if (config.tty_set) {
+        fprintf(stderr, "Error opening terminal: unknown.\n");
+        return 1;
+    }
+    
+    if (config.update_delay < 0 || config.update_delay > 10) {
+        fprintf(stderr, "Error: update delay must be 0-10\n");
+        return 1;
+    }
+    
+    if (config.color == 2) {
+        fprintf(stderr, " Invalid color selection\n");
+        fprintf(stderr, " Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+        return 1;
+    }
+    
+    srand(time(NULL));
+    
+    clear_screen();
+    
+    if (config.lambda_mode) {
+        for (int i = 0; i < config.cols * config.rows; i++) {
+            set_cursor(i % config.cols, i / config.cols);
+            printf("λ");
+            fflush(stdout);
+        }
+    }
+    
+    if (config.message) {
+        printf("\n");
+        printf("%s\n", config.message_text);
+        printf("\n");
+    }
+    
+    return 0;
+}
