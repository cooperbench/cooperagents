+func (f *SVGFormatter) Format(highlighted Highlighted, w io.Writer) (string, error) {
+	var sb strings.Builder
+	sb.WriteString("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%%\" height=\"100%%\">\n")
+	sb.WriteString("<style>\n")
+	sb.WriteString("text { font-family: monospace; font-size: 12px; }\n")
+	sb.WriteString("</style>\n")
+	for _, tok := range highlighted.Tokens {
+		if tok.Type == "Text" {
+			sb.WriteString("<text x=\"0\" y=\"0\">" + tok.Value + "</text>\n")
+		} else {
+			sb.WriteString("<text x=\"0\" y=\"0\" fill=\"#000\">" + tok.Value + "</text>\n")
+		}
+	}
+	sb.WriteString("</svg>\n")
+	return sb.String(), nil
+}
+
+func (f *SVGFormatter) Write(w io.Writer, highlighted Highlighted) error {
+	s, err := f.Format(highlighted, w)
+	if err != nil {
