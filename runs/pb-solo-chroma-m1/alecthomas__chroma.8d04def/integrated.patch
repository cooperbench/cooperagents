+type LexerInfo struct {
+	Name       string   `json:"name"`
+	Aliases    []string `json:"aliases"`
+	Filenames  []string `json:"filenames"`
+	Mimetypes  []string `json:"mimetypes"`
+}
+
+type StyleInfo struct {
+	Name string `json:"name"`
+}
+
+type FormatterInfo struct {
+	Name string `json:"name"`
+}
+
+type ListOutput struct {
+	Lexers      []LexerInfo  `json:"lexers"`
+	Styles      []StyleInfo  `json:"styles"`
+	Formatters  []FormatterInfo `json:"formatters"`
+}
+
+type Token struct {
+	Type   string `json:"type"`
+	Value  string `json:"value"`
+}
+
+type Highlighted struct {
+	Tokens []Token `json:"tokens"`
+}
+
+type Formatter interface {
+	Format(highlighted Highlighted, w io.Writer) (string, error)
+}
+
+type TerminalFormatter struct{}
+
+func (f *TerminalFormatter) Format(highlighted Highlighted, w io.Writer) (string, error) {
+	var sb strings.Builder
+	for _, tok := range highlighted.Tokens {
+		if tok.Type == "Text" {
+			sb.WriteString(tok.Value)
+		} else {
+			switch tok.Type {
+			case "Keyword":
+				sb.WriteString("\033[1;36m" + tok.Value + "\033[0m")
+			case "Name":
+				sb.WriteString("\033[1;32m" + tok.Value + "\033[0m")
+			case "Literal":
+				sb.WriteString("\033[1;33m" + tok.Value + "\033[0m")
+			case "Operator":
+				sb.WriteString("\033[1;37m" + tok.Value + "\033[0m")
+			case "Comment":
+				sb.WriteString("\033[1;35m" + tok.Value + "\033[0m")
+			default:
+				sb.WriteString(tok.Value)
+			}
+		}
+	}
+	return sb.String(), nil
+}
+
+type JSONFormatter struct{}
+
+func (f *JSONFormatter) Format(highlighted Highlighted, w io.Writer) (string, error) {
+	var out, _ = json.MarshalIndent(highlighted, "", "  ")
+	return string(out), nil
+}
