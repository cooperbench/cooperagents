+def greedy_pivot(tableau):
+    """Return a single (row, col) using a deterministic Bland-style rule."""
+    cols = entering_columns(tableau)
+    if not cols:
+        return None
+    col = min(cols)  # smallest-index entering column
+    rows = leaving_rows(tableau, col)
+    if not rows:
+        return ("unbounded", None, col)
+    row = min(rows)
+    return (row, col)
