+"""Tableau construction and pivot operations for the two-phase simplex method.
+
+Column layout (Phase 1, before artificial-column removal):
+    [Z, x_1..x_n, s_1..s_k, a_1..a_r, RHS]
+Column layout (Phase 2, after artificial-column removal):
+    [Z, x_1..x_n, s_1..s_k, RHS]
+
+* Z  is always index 0.
+* RHS is always the last index.
+* x_j  -> column j            (1 <= j <= n)
+* s_j  -> column n + j       (1 <= j <= k)
+* a_j  -> column n + k + j   (1 <= j <= r, Phase 1 only)
+
+Because the artificial columns sit *after* the slack/surplus columns, removing
+them leaves the x and s column indices unchanged (only RHS shifts left).
+"""
+
+TOL = 1e-9
+
+# Number of constraints that get a slack (<=) or surplus (>=) column.
+def _num_slack(ops):
+    return sum(1 for op in ops if op in ("<=", ">="))
+
+
+# Number of constraints that get an artificial column (>= or =).
+def _num_artificial(ops):
+    return sum(1 for op in ops if op in (">=", "="))
+
+
+def validate_operators(ops):
+    for op in ops:
+        if op not in ("<=", ">=", "="):
+            raise ValueError(f"Invalid relational operator: {op!r}")
+
+
+def num_cols(n, k, r, phase):
+    if phase == 1:
+        return n + k + r + 2  # Z + x + s + a + RHS
+    return n + k + 2  # Z + x + s + RHS
+
+
+def name_to_column(name, n, k, r):
+    """Map a variable name (x1, s1, a1, ...) to its column index.
+
+    Works for both phases for x and s; ``a`` is only valid during Phase 1.
+    """
+    name = name.strip()
+    if not name:
+        raise ValueError("Empty variable name")
+    head = name[0]
+    num = int(name[1:])
+    if head == "x":
+        return num  # x_j -> column j (Z is column 0)
+    if head == "s":
+        return n + num
+    if head == "a":
+        return n + k + num
+    raise ValueError(f"Unknown variable name: {name!r}")
+
+
+def column_to_name(col, n, k, r, phase):
+    """Map a column index to a variable name (or None for Z/RHS)."""
+    if col == 0:
+        return "Z"
+    total = num_cols(n, k, r, phase) - 1
+    if col == total:
+        return "RHS"
+    if 1 <= col <= n:
+        return f"x{col}"
+    if n + 1 <= col <= n + k:
+        return f"s{col - n}"
+    if phase == 1 and n + k + 1 <= col <= n + k + r:
+        return f"a{col - n - k}"
+    return None
+
+
+def label_to_row(label):
+    label = label.strip()
+    if label.startswith("R"):
+        return int(label[1:])
+    raise ValueError(f"Unknown row label: {label!r}")
+
+
+def build_phase1_tableau(objective_coeff, constraints_coeff,
+                         constraints_relational_operators, constraints_rhs):
+    """Build the initial Phase 1 tableau and the initial basis.
+
+    Returns (tableau, basis, n, k, r) where ``basis[row]`` is the column of the
+    basic variable for that constraint row.
+
+    Any constraint whose RHS is negative is first multiplied by -1 (which
+    flips its relational operator) so that every row has a non-negative RHS.
+    This guarantees the initial basis (slack / artificial columns) is feasible
+    and keeps the minimum-ratio test well-defined.
+    """
+    n = len(objective_coeff)
+    m = len(constraints_coeff)
+    validate_operators(constraints_relational_operators)
+
+    # Normalise rows with a negative RHS by multiplying the row by -1.  This
+    # flips "<=" <-> ">=" (and leaves "=" unchanged) and yields a non-negative
+    # RHS, so the auxiliary-column initial basis is feasible.
+    norm_ops = []
+    norm_coeff = []
+    norm_rhs = []
+    for i in range(m):
+        op = constraints_relational_operators[i]
+        rhs = float(constraints_rhs[i])
+        if rhs < 0.0:
+            if op == "<=":
+                op = ">="
+            elif op == ">=":
+                op = "<="
+            # "=" is unaffected by a sign flip
+            rhs = -rhs
+            coeff = [-float(c) for c in constraints_coeff[i]]
+        else:
+            coeff = [float(c) for c in constraints_coeff[i]]
+        norm_ops.append(op)
+        norm_coeff.append(coeff)
+        norm_rhs.append(rhs)
+
+    k = _num_slack(norm_ops)
+    r = _num_artificial(norm_ops)
+    nc = num_cols(n, k, r, 1)
+
+    rows = []
+    basis = {}
+    slack_count = 0
+    artificial_count = 0
+    for i in range(m):
+        op = norm_ops[i]
+        row = [0.0] * nc
+        for j in range(n):
+            row[1 + j] = norm_coeff[i][j]
+        if op == "<=":
+            slack_count += 1
+            col = n + slack_count
+            row[col] = 1.0
+            basis[i] = col
+        elif op == ">=":
+            slack_count += 1
+            scol = n + slack_count
+            row[scol] = -1.0  # surplus
+            artificial_count += 1
+            acol = n + k + artificial_count
+            row[acol] = 1.0  # artificial
+            basis[i] = acol
+        else:  # "="
+            artificial_count += 1
+            acol = n + k + artificial_count
+            row[acol] = 1.0
+            basis[i] = acol
+        row[-1] = norm_rhs[i]
+        rows.append(row)
+
+    # Phase 1 objective: maximise -sum(a_i).
+    # Raw Z-row: +1 for each artificial column, 0 elsewhere; Z-column = 1.
+    z_row = [0.0] * nc
+    z_row[0] = 1.0
+    for i in range(m):
+        col = basis[i]
+        if col >= n + k + 1:  # basic variable is artificial
+            z_row[col] = 1.0
+    # Canonicalise: zero the basic (artificial) columns of the Z-row.
+    for i in range(m):
+        col = basis[i]
+        if col >= n + k + 1:
+            c = z_row[col]
+            if abs(c) > 1e-12:
+                rrow = rows[i]
+                for j in range(nc):
+                    z_row[j] = z_row[j] - c * rrow[j]
+
+    tableau = rows + [z_row]
+    return tableau, basis, n, k, r
+
 
