++def _remove_artificial_columns(tableau, n, k, r):
++    """Drop the artificial columns, returning a Phase-2 shaped tableau."""
++    if r == 0:
++        return [list(row) for row in tableau]
++    drop = set(range(n + k + 1, n + k + r + 1))
++    kept = []
+     for row in tableau:
+-        filtered_row = [value for j, value in enumerate(row) if j not in artificial_vars]
+-        filtered_tableau.append(filtered_row)
+-    return filtered_tableau
+\ No newline at end of file
++        kept.append([row[j] for j in range(len(row)) if j not in drop])
++    return kept
