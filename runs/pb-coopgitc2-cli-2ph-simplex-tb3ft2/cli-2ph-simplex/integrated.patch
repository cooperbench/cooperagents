+"""Report generation and pivot-log writing for the two-phase simplex solver.
+
+This module provides the four helpers the CLI and the solver depend on:
+
+* ``build_problem_report``      -> UTF-8 text representation of the *parsed*
+  input LP (objective line, blank line, ``subject to:``, one line per input
+  constraint in input order, and the non-negativity line).
+* ``detect_degeneracy``         -> ``bool`` degenerate flag (any constraint row
+  has an RHS within ``1e-9`` of zero in the final tableau).
+* ``basic_variables_report``    -> ``{"basic_variables": dict[str, float]}``.
+* ``write_pivot_log``           -> JSON Lines writer for the pivot log.
+"""
+
+import json
+
+from decimal import Decimal, ROUND_HALF_UP
+
+from simplex.tableau import column_to_name
+
+
+# ---------------------------------------------------------------------------
+# numeric helpers
+# ---------------------------------------------------------------------------
+def _round2(value):
+    """Round ``value`` to 2 decimal places using half-up (away-from-zero)."""
+    d = Decimal(str(value))
+    return d.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+def _format_value(d):
+    """Render a quantized Decimal as a 2-decimal string (positive ``0.00``)."""
+    if d == 0:
+        return "0.00"
+    return str(d)
+
+
+def _format_terms(coefficients):
+    """Format a list of coefficients as ``<coef>*x<i>`` terms.
+
+    Positive terms come first, then negative, then zero, each group keeping
+    variable-index order. The leading term has no separator; later positive/zero
+    terms use `` + `` and later negative terms use `` - ``.
+    """
+    terms = []
+    for i, c in enumerate(coefficients, start=1):
+        rounded = _round2(c)
+        if rounded > 0:
+            group, sign = 0, "+"
+            abs_val = rounded
+        elif rounded < 0:
+            group, sign = 1, "-"
+            abs_val = -rounded
+        else:
+            # values that round to zero are rendered as positive 0.00
+            group, sign = 2, "+"
+            abs_val = Decimal("0.00")
+        terms.append((group, i, abs_val, sign))
+
+    terms.sort(key=lambda t: (t[0], t[1]))
+
+    parts = []
+    for idx, (group, var_index, abs_val, sign) in enumerate(terms):
+        body = "{}*x{}".format(_format_value(abs_val), var_index)
+        if idx == 0:
+            if sign == "-":
+                parts.append("-" + body)
+            else:
+                parts.append(body)
+        else:
+            if sign == "-":
+                parts.append(" - " + body)
+            else:
+                parts.append(" + " + body)
+    return "".join(parts)
+
+
+# ---------------------------------------------------------------------------
+# problem report
+# ---------------------------------------------------------------------------
+def build_problem_report(objective_coeff, constraints_coeff,
+                         constraints_relational_operators, constraints_rhs):
+    """Return the UTF-8 text representation of the parsed input LP.
+
+    The report describes the *input* (not the solved output):
+    ``maximize ...`` on the first line, a blank line, ``subject to:``, one
+    indented line per input constraint (in input order), and the indented
+    non-negativity line for the decision variables. No trailing newline.
+    """
+    lines = []
+
+    # objective line (not indented)
+    objective_terms = _format_terms(objective_coeff)
+    lines.append("maximize " + objective_terms)
+
+    # blank line
+    lines.append("")
+
+    # subject to
+    lines.append("subject to:")
+
+    # one line per input constraint, in input order (indented by 4 spaces)
+    for coeffs, op, rhs in zip(constraints_coeff,
+                               constraints_relational_operators,
+                               constraints_rhs):
+        terms = _format_terms(coeffs)
+        rhs_str = _format_value(_round2(rhs))
+        lines.append("    {} {} {}".format(terms, op, rhs_str))
+
+    # non-negativity line for the decision variables (indented by 4 spaces)
+    n = len(objective_coeff)
+    var_names = ["x{}".format(i) for i in range(1, n + 1)]
+    lines.append("    " + ", ".join(var_names) + " >= 0")
+
+    return "\n".join(lines)
+
+
+# ---------------------------------------------------------------------------
+# degeneracy
+# ---------------------------------------------------------------------------
+def detect_degeneracy(final_tableau):
+    """Return True if any constraint row (not the objective row) has RHS ~ 0.
+
+    Degeneracy is detected within a ``1e-9`` tolerance of an RHS value of zero
+    in any constraint row (the objective row is the last row and is ignored).
+    """
+    for row in final_tableau[:-1]:
+        if abs(row[-1]) < 1e-9:
+            return True
+    return False
+
+
+# ---------------------------------------------------------------------------
+# basic variables
+# ---------------------------------------------------------------------------
+def basic_variables_report(final_tableau, n, k, r, phase, basis):
+    """Return ``{"basic_variables": dict[str, float]}`` for the final basis.
+
+    ``basis`` maps each constraint row to the column of its basic variable.
+    Only decision (``x``) and slack/surplus (``s``) names are reported, in the
+    final column order, with their corresponding tableau RHS values.
+    """
+    result = {}
+    for row in range(len(final_tableau) - 1):
+        if row not in basis:
+            continue
+        col = basis[row]
+        name = column_to_name(col, n, k, r, phase)
+        if name is None:
+            continue
+        # only decision and slack/surplus variables are reported
+        if not (name.startswith("x") or name.startswith("s")):
+            continue
+        value = final_tableau[row][-1]
+        result[name] = float(value)
+    return {"basic_variables": result}
+
+
+# ---------------------------------------------------------------------------
+# pivot log
+# ---------------------------------------------------------------------------
+def write_pivot_log(pivot_log, path):
+    """Write the pivot log as UTF-8 JSON Lines (one object per line)."""
+    with open(path, "w", encoding="utf-8") as f:
