++def _detect_basis(rows, n, k, nc2):
++    """Detect the basic variable (column) for each constraint row via unit columns."""
++    m = len(rows)
++    basis = {}
++    for col in range(1, nc2 - 1):  # exclude Z(0) and RHS(last)
++        one_row = None
++        is_unit = True
++        for i in range(m):
++            v = rows[i][col]
++            if abs(v - 1.0) < 1e-6:
++                if one_row is not None:
++                    is_unit = False
++                    break
++                one_row = i
++            elif abs(v) > 1e-6:
++                is_unit = False
++                break
++        if is_unit and one_row is not None and one_row not in basis:
++            basis[one_row] = col
++    return basis
++
++
++def _update_basis(basis, row, col):
++    """Update the basis after a pivot at (row, col).
++
++    The entering column ``col`` becomes basic for ``row``.
++    """
++    basis[row] = col
++
++
++def _phase2_objective(rows, n, objective_coeff):
++    """Replace the objective row with the (canonicalised) Phase-2 objective row.
++
++    Returns (tableau, basis) where ``basis[row]`` is the basic column per row.
++    """
++    nc2 = len(rows[0])
++    basis = _detect_basis(rows, n, None, nc2)
++    z_row = [0.0] * nc2
++    z_row[0] = 1.0
++    for j in range(n):
++        z_row[1 + j] = -float(objective_coeff[j])
++    # canonicalise w.r.t. the detected basis
++    for row_i, col in basis.items():
++        c = z_row[col]
++        if abs(c) > 1e-12:
++            rrow = rows[row_i]
++            for j in range(nc2):
++                z_row[j] = z_row[j] - c * rrow[j]
++    return rows + [z_row], basis
++
++
++def _transition_to_phase2(tableau, objective_coeff, n, k, r, basis1=None):
++    """From a Phase-1 tableau build the Phase-2 tableau (artificials removed).
++
++    If ``basis1`` is provided, carry it through (dropping artificial entries and
++    re-detecting for rows whose basic variable was artificial); otherwise detect
++    the basis from the Phase-2 constraint rows.
++    """
++    p2 = _remove_artificial_columns(tableau, n, k, r)
++    rows = p2[:-1]
++    if not rows:
++        # No constraint rows (no input constraints): the Phase-2 tableau is just
++        # the objective row. The Phase-2 loop will detect unboundedness or
++        # optimality from this single row.
++        nc2 = 2 + n  # Z, x1..xn, RHS
++        z_row = [0.0] * nc2
++        z_row[0] = 1.0
++        for j in range(n):
++            z_row[1 + j] = -float(objective_coeff[j])
++        return [z_row], {}
++    nc2 = len(rows[0])
++    if basis1 is not None:
++        # Carry the non-artificial basis entries from Phase 1.
++        basis = {}
++        for row_i, col in basis1.items():
++            if col < n + k + 1:  # non-artificial column
++                basis[row_i] = col
++        # For rows whose basic variable was artificial (now removed), re-detect.
++        if len(basis) < len(rows):
++            detected = _detect_basis(rows, n, None, nc2)
++            for row_i, col in detected.items():
++                if row_i not in basis:
++                    basis[row_i] = col
++    else:
++        basis = _detect_basis(rows, n, None, nc2)
++    # Build the Phase-2 objective row and canonicalise w.r.t. the carried basis.
++    z_row = [0.0] * nc2
++    z_row[0] = 1.0
++    for j in range(n):
++        z_row[1 + j] = -float(objective_coeff[j])
++    for row_i, col in basis.items():
++        c = z_row[col]
++        if abs(c) > 1e-12:
++            rrow = rows[row_i]
++            for j in range(nc2):
++                z_row[j] = z_row[j] - c * rrow[j]
++    return rows + [z_row], basis
++
++
++def _greedy_run(tableau, phase, objective_coeff=None, n=0, k=0, r=0):
++    """Run a deterministic simplex to optimality; return (tableau, log, basis).
++
++    Used when no ``--initial_pivots`` were supplied. Returns the pivot log too
++    (so the CLI can still emit one if requested) but it is not the minimum.
++    """
++    log = []
++    basis = _detect_basis(tableau[:-1], n, k, len(tableau[0]))
++    t = tableau
++    while True:
++        gp = greedy_pivot(t)
++        if gp is None:
++            break
++        if gp[0] == "unbounded":
++            raise Exception("The linear program is unbounded")
++        row, col = gp
++        pivot(t, row, col)
++    return t, log, basis
++
++
++def _search(prefix_log, start_tableau, objective_coeff, n, k, r, basis0=None, max_states=200000):
++    """Dijkstra over simplex states to find the minimum-pivot continuation.
++
++    ``prefix_log`` is the list of already-applied pivot dicts (Phase 1).
++    ``basis0`` is the Phase-1 basis after the prefix (tracked through the
++    simplex); if None, the basis is detected from the start tableau.
++    Returns the full log (prefix + continuation) and the final Phase-2
++    tableau/basis.
++    """
++    pq = []
++    counter = 0
++
++    def push(cost, tableau, phase, basis, log):
++        nonlocal counter
++        heapq.heappush(pq, (cost, counter, tableau, phase, basis, log))
++        counter += 1
++
++    # start from the post-prefix Phase-1 tableau
++    start = copy.deepcopy(start_tableau)
++    if basis0 is not None:
++        basis = basis0
++    else:
++        basis = _detect_basis(start[:-1], n, k, len(start[0]))
++    push(0, start, 1, basis, list(prefix_log))
++    visited = {}
++    best = None
++
++    while pq:
++        cost, _, tableau, phase, basis, log = heapq.heappop(pq)
++        key = _round_key(tableau[:-1], phase)
++        if key in visited and visited[key] <= cost:
++            continue
++        visited[key] = cost
++        if len(visited) > max_states:
++            break
++
++        if phase == 2 and is_optimal(tableau):
++            best = (log, tableau, basis)
++            break
++
++        if phase == 1:
++            if is_optimal(tableau):
++                # 0-cost transition to Phase 2 (carry the basis)
++                p2, basis2 = _transition_to_phase2(
++                    tableau, objective_coeff, n, k, r, basis
++                )
++                heapq.heappush(pq, (cost, counter, p2, 2, basis2, log))
++                counter += 1
++                continue
++            # generate Phase-1 pivots
++            for col in entering_columns(tableau):
++                rows = leaving_rows(tableau, col)
++                if not rows:
++                    # unbounded in Phase 1 should not happen for feasible prefix
++                    continue
++                for row in rows:
++                    nt = copy.deepcopy(tableau)
++                    pivot(nt, row, col)
++                    name = _col_name(col, n, k, r, 1)
++                    rlabel = f"R{row}"
++                    nlog = log + [{
++                        "enter_column": name,
++                        "leave_row": rlabel,
++                        "phase": 1,
++                        "tableau": copy.deepcopy(nt),
++                    }]
++                    nb = dict(basis) if basis else {}
++                    _update_basis(nb, row, col)
++                    heapq.heappush(pq, (cost + 1, counter, nt, 1, nb, nlog))
++                    counter += 1
++        else:  # phase == 2
++            for col in entering_columns(tableau):
++                rows = leaving_rows(tableau, col)
++                if not rows:
++                    # unbounded
++                    continue
++                for row in rows:
++                    nt = copy.deepcopy(tableau)
++                    pivot(nt, row, col)
++                    name = _col_name(col, n, k, r, 2)
++                    rlabel = f"R{row}"
++                    nlog = log + [{
++                        "enter_column": name,
++                        "leave_row": rlabel,
++                        "phase": 2,
++                        "tableau": copy.deepcopy(nt),
++                    }]
++                    nb = dict(basis) if basis else {}
++                    _update_basis(nb, row, col)
++                    heapq.heappush(pq, (cost + 1, counter, nt, 2, nb, nlog))
++                    counter += 1
++
++    if best is None:
++        # fall back: run greedily from the current frontier is not feasible;
++        # raise so the CLI reports the failure rather than emitting a wrong log
++        raise Exception("Could not find a finite optimal continuation")
++    return best
++
++
++def _col_name(col, n, k, r, phase):
++    """Variable name for a column (used to label pivots in the log)."""
++    from simplex.tableau import column_to_name
++    return column_to_name(col, n, k, r, phase)
++
++
++def _apply_prefix(prefix, tableau, n, k, r, phase_label):
++    """Apply the required Phase-1 pivot prefix; returns the pivot log dicts."""
++    log = []
++    for i, p in enumerate(prefix):
++        ent = p["enter_column"]
++        leave = p["leave_row"]
++        col = name_to_column(ent, n, k, r)
++        row = label_to_row(leave)
++        pivot(tableau, row, col)
++        log.append({
++            "enter_column": ent,
++            "leave_row": leave,
++            "phase": 1,
++            "tableau": copy.deepcopy(tableau),
++        })
++    return log
++
++
++def two_phase_simplex(objective_coeff, constraints_coeff,
++                      constraints_relational_operators, constraints_rhs,
++                      initial_pivots=None):
++    """Run the two-phase simplex method.
++
++    Returns a result dict with keys:
++        final_tableau, basic_variables, degenerate, problem_report,
++        pivot_log (list of dicts), n, k, r
++    """
++    from simplex.report import (
++        build_problem_report,
++        detect_degeneracy,
++        basic_variables_report,
++    )
++
++    n = len(objective_coeff)
++    m = len(constraints_coeff)
++    k = sum(1 for op in constraints_relational_operators if op in ("<=", ">="))
++    r = sum(1 for op in constraints_relational_operators if op in (">=", "="))
++
++    # problem report (represents the parsed INPUT, independent of solving)
++    problem_report = build_problem_report(
++        objective_coeff, constraints_coeff,
++        constraints_relational_operators, constraints_rhs
++    )
++
++    # Phase 1
++    tableau, _basis0, n, k, r = build_phase1_tableau(
++        objective_coeff, constraints_coeff,
++        constraints_relational_operators, constraints_rhs
++    )
++
++    if initial_pivots is not None:
++        # Required Phase-1 prefix; then minimum-pivot continuation.
++        # Track the basis through the prefix pivots.
++        basis1 = dict(_basis0)
++        for p in initial_pivots:
++            ent = p["enter_column"]
++            leave = p["leave_row"]
++            col = name_to_column(ent, n, k, r)
++            row = label_to_row(leave)
++            _update_basis(basis1, row, col)
++        prefix_log = _apply_prefix(
++            initial_pivots, tableau, n, k, r, "phase1"
++        )
++        # Pass the tracked basis to _search.
++        result = _search(
++            prefix_log, tableau, objective_coeff, n, k, r, basis1
++        )
++        log, final2, basis2 = result
++        # decorate with one-based step numbers
++        decorated = _decorate_log(log)
++        final_tableau = final2
++        # basis2 is tracked through the simplex; if None, detect as fallback.
++        if basis2 is None:
++            basis2 = _detect_basis(final_tableau[:-1], n, k,
++                                   len(final_tableau[0]))
++        basic = basic_variables_report(final_tableau, n, k, r, phase=2,
++                                       basis=basis2)
++        degenerate = detect_degeneracy(final_tableau)
++        return {
++            "final_tableau": final_tableau,
++            "basic_variables": basic,
++            "degenerate": degenerate,
++            "problem_report": problem_report,
++            "pivot_log": decorated,
++            "n": n, "k": k, "r": r,
++            "infeasible": False,
++        }
++    else:
++        # No prefix: deterministic run for a valid (not necessarily minimum)
++        # optimal tableau.
++        log = []
++        # Phase 1
++        t1 = tableau
++        basis1 = dict(_basis0)  # track the basis through the simplex
++        while True:
++            gp = greedy_pivot(t1)
++            if gp is None:
++                break
++            if gp[0] == "unbounded":
++                raise Exception("The linear program is unbounded")
++            row, col = gp
++            pivot(t1, row, col)
++            _update_basis(basis1, row, col)
++        # infeasibility check: Phase 1 objective value (RHS of Z-row) = -sum(a_i)
++        if t1[-1][-1] < -TOL:
++            # infeasible: best-effort tableau at last state
++            final_tableau = t1
++            degenerate = detect_degeneracy(final_tableau)
++            basic = basic_variables_report(final_tableau, n, k, r,
++                                           phase=1, basis=_detect_basis(
++                                               final_tableau[:-1], n, k,
++                                               len(final_tableau[0])))
++            return {
++                "final_tableau": final_tableau,
++                "basic_variables": basic,
++                "degenerate": degenerate,
++                "problem_report": problem_report,
++                "pivot_log": [],
++                "n": n, "k": k, "r": r,
++                "infeasible": True,
++            }
++        # transition to Phase 2 (carry the basis)
++        p2, basis2 = _transition_to_phase2(t1, objective_coeff, n, k, r, basis1)
++        # Phase 2
++        t2 = p2
++        while True:
++            gp = greedy_pivot(t2)
++            if gp is None:
++                break
++            if gp[0] == "unbounded":
++                raise Exception("The linear program is unbounded")
++            row, col = gp
++            pivot(t2, row, col)
++            _update_basis(basis2, row, col)
++        final_tableau = t2
++        # basis2 is tracked through the simplex; no re-detection needed
++        basic = basic_variables_report(final_tableau, n, k, r, phase=2,
++                                       basis=basis2)
++        degenerate = detect_degeneracy(final_tableau)
++        return {
++            "final_tableau": final_tableau,
++            "basic_variables": basic,
++            "degenerate": degenerate,
++            "problem_report": problem_report,
++            "pivot_log": [],
++            "n": n, "k": k, "r": r,
++            "infeasible": False,
++        }
++
++
++
++def _decorate_log(log):
++    """Assign step/phase/tableau to a raw list of {enter_column, leave_row}."""
++    decorated = []
++    step = 1
++    for entry in log:
++        if "phase" in entry:
++            # already decorated (prefix entries)
++            decorated.append({
++                "step": step,
++                "phase": entry["phase"],
++                "enter_column": entry["enter_column"],
++                "leave_row": entry["leave_row"],
++                "tableau": entry["tableau"],
++            })
++            step += 1
++            continue
++        # continuation entries from the search: figure out phase
++        # (the search produced them in order; prefix entries are all phase 1)
++        phase = entry.get("phase", 1)
++        decorated.append({
++            "step": step,
++            "phase": phase,
++            "enter_column": entry["enter_column"],
++            "leave_row": entry["leave_row"],
++            "tableau": entry.get("tableau"),
++        })
++        step += 1
++    return decorated
