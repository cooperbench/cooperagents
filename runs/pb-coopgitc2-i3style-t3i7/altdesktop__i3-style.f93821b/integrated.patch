+#!/usr/bin/env python3
+"""i3-style: Apply themes to i3 config files."""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+VERSION = "1.0"
+
+DEFAULT_CONFIG_LOCATIONS = [
+    os.path.expanduser("~/.config/i3/config"),
+    os.path.expanduser("~/.i3/config"),
+    os.path.expanduser("~/.i3wm/config"),
+]
+
+BUILTIN_THEMES = {
+    "slate": "Slate theme by Jody Ribton <jody@ribton.me>",
+    "alphare": "A beige theme by Alphare",
+    "ubuntu": "Ubuntu theme by lasers",
+    "flat-gray": "flat gray based theme",
+    "purple": "Purple theme by AAlakkad <http://aalakkad.me>",
+    "archlinux": "Archlinux theme by okraits <http://okraits.de>",
+    "default": "Default theme for i3wm <http://i3wm.org>",
+    "debian": "Debian theme by lasers",
+    "oceanic-next": "Theme by Valentin Weber inspired by voronianski (https://github.com/voronianski/oceanic-next-color-scheme)",
+    "base16-tomorrow": "Base16 Tomorrow, by Chris Kempson (http://chriskempson.com)",
+    "okraits": "A simple theme by okraits <http://okraits.de>",
+    "icelines": "icelines theme by mbfraga",
+    "solarized": "Solarized theme by lasers",
+    "deep-purple": "Inspired by the Purple and Default themes. By jcpst <http://jcpst.com>",
+    "tomorrow-night-80s": "Tomorrow Night 80s theme by jmfurlott <http://jmfurlott.com>",
+    "seti": "seti theme by Jody Ribton - based on the seti Atom theme at https://atom.io/themes/seti-ui",
+    "lime": "Lime theme by wei2912 <http://wei2912.github.io>, based on Archlinux theme by okraits <http://okraits.de>",
+    "gruvbox": "Made by freeware-preacher <https://github.com/freeware-preacher> to match gruvbox by morhetz <https://github.com/morhetz>",
+    "mate": "Theme for blending i3 into MATE",
+}
+
+THEMES = {
+    "default": {
+        "bar.background": "#000000",
+        "bar.foreground": "#ffffff",
+        "bar.border": "#000000",
+        "bar.statusline": "#000000",
+        "bar.focused_workspace": "#000000",
+        "bar.active_workspace": "#000000",
+        "bar.inactive_workspace": "#000000",
+        "bar.urgent_workspace": "#000000",
+        "client.focused": "#000000",
+        "client.focused_inactive": "#000000",
+        "client.unfocused": "#000000",
+        "client.urgent": "#000000",
+    },
+    "solarized": {
+        "bar.background": "#002b36",
+        "bar.foreground": "#839496",
+        "bar.border": "#002b36",
+        "bar.statusline": "#268bd2",
+        "bar.focused_workspace": "#fdf6e3 #859900 #fdf6e3",
+        "bar.active_workspace": "#fdf6e3 #6c71c4 #fdf6e3",
+        "bar.inactive_workspace": "#586e75 #93a1a1 #002b36",
+        "bar.urgent_workspace": "#d33682 #d33682 #fdf6e3",
+        "client.focused": "#859900 #859900 #fdf6e3 #6c71c4",
+        "client.focused_inactive": "#073642 #073642 #eee8d5 #6c71c4",
+        "client.unfocused": "#073642 #073642 #93a1a1 #586e75",
+        "client.urgent": "#d33682 #d33682 #fdf6e3 #dc322f",
+    },
+    "purple": {
+        "bar.background": "#1a1a2e",
+        "bar.foreground": "#eaeaea",
+        "bar.border": "#1a1a2e",
+        "bar.statusline": "#a29bfe",
+        "bar.focused_workspace": "#a29bfe #a29bfe #1a1a2e",
+        "bar.active_workspace": "#fd79a8 #fd79a8 #1a1a2e",
+        "bar.inactive_workspace": "#636e72 #636e72 #1a1a2e",
+        "bar.urgent_workspace": "#e545b9 #e545b9 #1a1a2e",
+        "client.focused": "#a29bfe #a29bfe #eaeaea #fd79a8",
+        "client.focused_inactive": "#eaeaea #eaeaea #eaeaea #fd79a8",
+        "client.unfocused": "#636e72 #636e72 #636e72 #636e72",
+        "client.urgent": "#e545b9 #e545b9 #636e72 #e545b9",
+    },
+}
+
+
+def find_config_file():
+    """Find the default i3 config file."""
+    for config_path in DEFAULT_CONFIG_LOCATIONS:
+        if os.path.exists(config_path):
+            return config_path
+    return None
+
+
+def get_theme_colors(theme_name):
+    """Get colors for a theme."""
+    if theme_name in THEMES:
+        return THEMES[theme_name]
+    if theme_name in BUILTIN_THEMES:
+        return THEMES["default"].copy()
+    return None
+
+
+def parse_config(config_path):
+    """Parse an i3 config file and extract relevant sections."""
+    config = {
+        "font": None,
+        "bindings": [],
+        "bar": {
+            "colors": {
+                "separator": None,
+                "background": None,
+                "statusline": None,
+                "focused_workspace": None,
+                "active_workspace": None,
+                "inactive_workspace": None,
+                "urgent_workspace": None,
+            }
+        },
+        "clients": {
+            "focused": None,
+            "focused_inactive": None,
+            "unfocused": None,
+            "urgent": None,
+        }
+    }
+    
+    if not os.path.exists(config_path):
+        return config
+    
+    with open(config_path, 'r') as f:
+        file_content = f.read()
+    
+    # Parse font - handle both "font pango:..." and "font pango:..." formats
+    font_match = re.search(r'^font\s+(.+)$', file_content, re.MULTILINE)
+    if font_match:
+        config["font"] = font_match.group(1).strip()
+    
+    # Parse bindings - look for lines starting with bindsym
+    for line in file_content.split('\n'):
+        line = line.strip()
+        if line.startswith('bindsym'):
+            config["bindings"].append(line)
+    
+    # Parse bar block with nested braces
+    bar_start = file_content.find('bar {')
+    if bar_start != -1:
+        brace_count = 0
+        bar_end = -1
+        for i in range(bar_start, len(file_content)):
+            if file_content[i] == '{':
+                brace_count += 1
+            elif file_content[i] == '}':
+                brace_count -= 1
+                if brace_count == 0:
+                    bar_end = i
+                    break
+        
+        if bar_end != -1:
+            bar_content = file_content[bar_start:bar_end+1]
+            
+            # Parse colors block within bar
+            colors_start = bar_content.find('colors {')
+            if colors_start != -1:
+                brace_count = 0
+                colors_end = -1
+                for i in range(colors_start, len(bar_content)):
+                    if bar_content[i] == '{':
+                        brace_count += 1
+                    elif bar_content[i] == '}':
+                        brace_count -= 1
+                        if brace_count == 0:
+                            colors_end = i
+                            break
+                
+                if colors_end != -1:
+                    colors_content = bar_content[colors_start:colors_end+1]
+                    
+                    # Extract individual color values
+                    sep_match = re.search(r'separator\s+([^,\n]+)', colors_content)
+                    if sep_match:
+                        config["bar"]["colors"]["separator"] = sep_match.group(1).strip()
+                    
+                    bg_match = re.search(r'background\s+([^,\n]+)', colors_content)
+                    if bg_match:
+                        config["bar"]["colors"]["background"] = bg_match.group(1).strip()
+                    
+                    sl_match = re.search(r'statusline\s+([^,\n]+)', colors_content)
+                    if sl_match:
+                        config["bar"]["colors"]["statusline"] = sl_match.group(1).strip()
+                    
+                    fw_match = re.search(r'focused_workspace\s+([^,\n]+)', colors_content)
+                    if fw_match:
+                        config["bar"]["colors"]["focused_workspace"] = fw_match.group(1).strip()
+                    
+                    aw_match = re.search(r'active_workspace\s+([^,\n]+)', colors_content)
+                    if aw_match:
+                        config["bar"]["colors"]["active_workspace"] = aw_match.group(1).strip()
+                    
+                    iw_match = re.search(r'inactive_workspace\s+([^,\n]+)', colors_content)
+                    if iw_match:
+                        config["bar"]["colors"]["inactive_workspace"] = iw_match.group(1).strip()
+                    
+                    uw_match = re.search(r'urgent_workspace\s+([^,\n]+)', colors_content)
+                    if uw_match:
+                        config["bar"]["colors"]["urgent_workspace"] = uw_match.group(1).strip()
+    
+    # Parse client colors
+    client_focused_match = re.search(r'client\.focused\s+([^,\n]+)', file_content)
+    if client_focused_match:
+        config["clients"]["focused"] = client_focused_match.group(1).strip()
+    
+    client_focused_inactive_match = re.search(r'client\.focused_inactive\s+([^,\n]+)', file_content)
+    if client_focused_inactive_match:
+        config["clients"]["focused_inactive"] = client_focused_inactive_match.group(1).strip()
+    
+    client_unfocused_match = re.search(r'client\.unfocused\s+([^,\n]+)', file_content)
+    if client_unfocused_match:
+        config["clients"]["unfocused"] = client_unfocused_match.group(1).strip()
+    
+    client_urgent_match = re.search(r'client\.urgent\s+([^,\n]+)', file_content)
+    if client_urgent_match:
+        config["clients"]["urgent"] = client_urgent_match.group(1).strip()
+    
+    return config
+
+
+def apply_theme_to_config(config_path, theme_name, output_path=None, save=False):
+    """Apply a theme to an i3 config file."""
+    config = parse_config(config_path)
+    colors = get_theme_colors(theme_name)
+    
+    if colors is None:
+        print(f"Unknown theme: {theme_name}", file=sys.stderr)
+        return False
+    
+    # Build output: preserve original content (font, bindings)
+    output_lines = []
+    
+    if config["font"]:
+        output_lines.append(config["font"])
+    
+    for binding in config["bindings"]:
+        output_lines.append(binding)
+    
+    output_lines.append("")
+    output_lines.append("bar {")
+    output_lines.append("  colors {")
+    
+    # Use separator from original config if available, otherwise use default
+    if config["bar"]["colors"]["separator"]:
+        output_lines.append(f"    separator {config['bar']['colors']['separator']}")
+    elif colors.get("bar.separator"):
+        output_lines.append(f"    separator {colors['bar.separator']}")
+    else:
+        output_lines.append("    separator #ffffff")
+    
+    if colors.get("bar.background"):
+        output_lines.append(f"    background {colors['bar.background']}")
+    if colors.get("bar.statusline"):
+        output_lines.append(f"    statusline {colors['bar.statusline']}")
+    if colors.get("bar.focused_workspace"):
+        output_lines.append(f"    focused_workspace {colors['bar.focused_workspace']}")
+    if colors.get("bar.active_workspace"):
+        output_lines.append(f"    active_workspace {colors['bar.active_workspace']}")
+    if colors.get("bar.inactive_workspace"):
+        output_lines.append(f"    inactive_workspace {colors['bar.inactive_workspace']}")
+    if colors.get("bar.urgent_workspace"):
+        output_lines.append(f"    urgent_workspace {colors['bar.urgent_workspace']}")
+    
+    output_lines.append("  }")
+    output_lines.append("}")
+    
+    # Output client colors with 4 values each
+    if colors.get("client.focused"):
+        output_lines.append(f"client.focused {colors['client.focused']}")
+    if colors.get("client.focused_inactive"):
+        output_lines.append(f"client.focused_inactive {colors['client.focused_inactive']}")
+    if colors.get("client.unfocused"):
+        output_lines.append(f"client.unfocused {colors['client.unfocused']}")
+    if colors.get("client.urgent"):
+        output_lines.append(f"client.urgent {colors['client.urgent']}")
+    
+    if output_path:
+        with open(output_path, 'w') as f:
+            f.write('\n'.join(output_lines) + '\n')
+    elif save:
+        with open(config_path, 'w') as f:
+            f.write('\n'.join(output_lines) + '\n')
+    else:
+        print('\n'.join(output_lines))
+    
+    return True
+
+
+def validate_config(config_path):
+    """Validate an i3 config file using i3."""
+    try:
+        result = subprocess.run(
+            ['i3', '-C', '-c', config_path],
+            capture_output=True,
+            text=True,
+            timeout=10
+        )
+        return result.returncode == 0
+    except FileNotFoundError:
+        return False
+    except subprocess.TimeoutExpired:
+        return False
+
+
+def to_theme(config_path, output_path=None):
+    """Convert a config file to a theme file."""
+    config = parse_config(config_path)
+    
+    theme = {
+        "bar": {
+            "colors": {
+                "separator": config["bar"]["colors"].get("separator"),
+                "background": config["bar"]["colors"].get("background"),
+                "statusline": config["bar"]["colors"].get("statusline"),
+                "focused_workspace": config["bar"]["colors"].get("focused_workspace"),
+                "active_workspace": config["bar"]["colors"].get("active_workspace"),
+                "inactive_workspace": config["bar"]["colors"].get("inactive_workspace"),
+                "urgent_workspace": config["bar"]["colors"].get("urgent_workspace"),
+            }
+        },
+        "clients": {
+            "focused": config["clients"].get("focused"),
+            "focused_inactive": config["clients"].get("focused_inactive"),
+            "unfocused": config["clients"].get("unfocused"),
+            "urgent": config["clients"].get("urgent"),
+        }
+    }
+    
+    if output_path:
+        with open(output_path, 'w') as f:
+            f.write("# Theme extracted from config\n")
+            f.write("# Bar colors\n")
+            if theme["bar"]["colors"].get("separator"):
+                f.write(f"separator: {theme['bar']['colors']['separator']}\n")
+            if theme["bar"]["colors"].get("background"):
+                f.write(f"background: {theme['bar']['colors']['background']}\n")
+            if theme["bar"]["colors"].get("statusline"):
+                f.write(f"statusline: {theme['bar']['colors']['statusline']}\n")
+            if theme["bar"]["colors"].get("focused_workspace"):
+                f.write(f"focused_workspace: {theme['bar']['colors']['focused_workspace']}\n")
+            if theme["bar"]["colors"].get("active_workspace"):
+                f.write(f"active_workspace: {theme['bar']['colors']['active_workspace']}\n")
+            if theme["bar"]["colors"].get("inactive_workspace"):
+                f.write(f"inactive_workspace: {theme['bar']['colors']['inactive_workspace']}\n")
+            if theme["bar"]["colors"].get("urgent_workspace"):
+                f.write(f"urgent_workspace: {theme['bar']['colors']['urgent_workspace']}\n")
+            f.write("\n")
+            f.write("# Client colors\n")
+            if theme["clients"].get("focused"):
+                f.write(f"client.focused: {theme['clients']['focused']}\n")
+            if theme["clients"].get("focused_inactive"):
+                f.write(f"client.focused_inactive: {theme['clients']['focused_inactive']}\n")
+            if theme["clients"].get("unfocused"):
+                f.write(f"client.unfocused: {theme['clients']['unfocused']}\n")
+            if theme["clients"].get("urgent"):
+                f.write(f"client.urgent: {theme['clients']['urgent']}\n")
+    else:
+        print("# Theme extracted from config")
+        print("# Bar colors")
+        if theme["bar"]["colors"].get("separator"):
+            print(f"separator: {theme['bar']['colors']['separator']}")
+        if theme["bar"]["colors"].get("background"):
+            print(f"background: {theme['bar']['colors']['background']}")
+        if theme["bar"]["colors"].get("statusline"):
+            print(f"statusline: {theme['bar']['colors']['statusline']}")
+        if theme["bar"]["colors"].get("focused_workspace"):
+            print(f"focused_workspace: {theme['bar']['colors']['focused_workspace']}")
+        if theme["bar"]["colors"].get("active_workspace"):
+            print(f"active_workspace: {theme['bar']['colors']['active_workspace']}")
+        if theme["bar"]["colors"].get("inactive_workspace"):
+            print(f"inactive_workspace: {theme['bar']['colors']['inactive_workspace']}")
+        if theme["bar"]["colors"].get("urgent_workspace"):
+            print(f"urgent_workspace: {theme['bar']['colors']['urgent_workspace']}")
+        print()
+        print("# Client colors")
+        if theme["clients"].get("focused"):
+            print(f"client.focused: {theme['clients']['focused']}")
+        if theme["clients"].get("focused_inactive"):
+            print(f"client.focused_inactive: {theme['clients']['focused_inactive']}")
+        if theme["clients"].get("unfocused"):
+            print(f"client.unfocused: {theme['clients']['unfocused']}")
+        if theme["clients"].get("urgent"):
+            print(f"client.urgent: {theme['clients']['urgent']}")
+    
+    return True
+
+
+def list_themes():
+    """List all available themes."""
+    print()
+    print("Available themes:")
+    print()
+    for name, desc in BUILTIN_THEMES.items():
+        print(f"  {name:20} - {desc}")
+    return True
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Make your i3 config a bit more stylish",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  i3-style solarized -o ~/.config/i3/config --reload
+  i3-style ~/.config/i3/solarized.yaml -o ~/.config/i3/config
+  i3-style --to-theme ~/.config/i3/config -o my-theme.yaml
+"""
+    )
+    
+    parser.add_argument(
+        '-l', '--list-all',
+        action='store_true',
+        help='Print a list of all available themes'
+    )
+    parser.add_argument(
+        '-r', '--reload',
+        action='store_true',
+        help='Apply the theme by reloading the config'
+    )
+    parser.add_argument(
+        '-s', '--save',
+        action='store_true',
+        help='Set the output file to the path of the input file'
+    )
+    parser.add_argument(
+        '-V', '--version',
+        action='store_true',
+        help='Prints version information'
+    )
+    parser.add_argument(
+        '-c', '--config',
+        metavar='<file>',
+        help='The config file the theme should be applied to. Defaults to the default i3 location.'
+    )
+    parser.add_argument(
+        '-o', '--output',
+        metavar='<file>',
+        help='Apply the theme, attempt to validate the result, and write it to <file>'
+    )
+    parser.add_argument(
+        '-t', '--to-theme',
+        metavar='<file>',
+        help='Prints an i3-style theme based on the given config suitable for sharing with others'
+    )
+    parser.add_argument(
+        'theme',
+        nargs='?',
+        help='The theme to use'
+    )
+    
+    args = parser.parse_args()
+    
+    if args.version:
+        print(f"i3-style {VERSION}")
+        return 0
+    
+    if args.list_all:
+        return list_themes()
+    
+    if args.to_theme:
+        if not args.to_theme:
+            print("Error: --to-theme requires a config file path", file=sys.stderr)
+            return 1
+        return to_theme(args.to_theme, args.output)
+    
+    if not args.theme:
+        print("Error: No theme specified", file=sys.stderr)
+        return 1
+    
+    config_path = args.config or find_config_file()
+    if not config_path:
+        print("Could not find i3 config", file=sys.stderr)
+        return 1
+    
+    if args.output:
+        success = apply_theme_to_config(config_path, args.theme, args.output, args.save)
+        if success:
+            validation_result = validate_config(args.output)
+            if not validation_result:
+                print(f"Could not validate config with `i3 -C -c {args.output}` (is i3 in the PATH?) No such file or directory (os error 2)", file=sys.stderr)
+                return 1
+        return success
+    else:
+        return apply_theme_to_config(config_path, args.theme, save=args.save)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
