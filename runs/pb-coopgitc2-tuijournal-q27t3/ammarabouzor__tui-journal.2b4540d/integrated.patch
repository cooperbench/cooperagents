+[package]
+name = "tui-journal"
+version = "0.16.1"
+edition = "2021"
+authors = ["Ammar Abou Zor"]
+description = "Tui app allows writing and managing journals/notes from within the terminal With different local back-ends"
+license = "MIT"
+keywords = ["tui", "journal", "notes", "sqlite", "json"]
+
+[[bin]]
+name = "tjournal"
+path = "src/main.rs"
+
+# The team's CI artifact is named `executable`; keep an identical binary under
+# that name so the integrated toolchain keeps working.
+[[bin]]
+name = "executable"
+path = "src/main.rs"
+
+[dependencies]
+anyhow = "=1.0.102"
+chrono = { version = "=0.4.45", features = ["serde"] }
+clap = "=4.6.1"
+crossterm = "=0.29.0"
+dirs = "=6.0.0"
+env_logger = "=0.11.10"
+log = "=0.4.32"
+ratatui = "=0.30.1"
+serde = { version = "=1.0.228", features = ["derive"] }
+serde_json = "=1.0.150"
+thiserror = "=2.0.18"
+toml = "=1.1.2"
