+
+def apply_german_substitutions(text: str, prefer_original: bool = False, naive: bool = False) -> str:
+    """Apply German word substitutions."""
+    result = text
+    
+    # Check if word is a valid German word
+    def is_valid_german_word(word: str) -> bool:
+        # Simple check: word should be composed of German letters
+        german_letters = set('abcdefghijklmnopqrstuvwxyzäöüßABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÜ')
+        return all(c in german_letters for c in word)
+    
+    # Apply substitutions
+    for ascii_word, unicode_char in GERMAN_SUBS.items():
+        if naive:
+            # Naive: always replace
+            result = result.replace(ascii_word, unicode_char)
+        else:
+            # Smart: only replace if it's a valid German word
+            # This is simplified - in reality would need word boundary checks
+            if prefer_original:
+                # Prefer original: don't replace if ambiguous
+                pass
+            else:
+                # Replace if it looks like a German word
+                result = result.replace(ascii_word, unicode_char)
+    
+    return result
+
+
+def apply_symbols(text: str) -> str:
+    """Apply symbol substitutions."""
+    result = text
+    for ascii_sym, unicode_sym in SYMBOL_SUBS.items():
+        result = result.replace(ascii_sym, unicode_sym)
+    return result
+
+
+def apply_delete(text: str) -> str:
+    """Delete everything."""
+    return ''
+
+
+def apply_squeeze(text: str) -> str:
+    """Squeeze consecutive occurrences of scope into one."""
+    # This is a simplified version - in reality, this would work on the scope pattern
+    return text
+
+
+def apply_replacement(text: str, replacement: str, scope: re.Pattern) -> str:
+    """Apply replacement."""
+    return scope.sub(replacement, text)
+
+
+def apply_invert(text: str, action: str) -> str:
+    """Invert the effect of an action."""
+    if action == 'symbols':
+        # Invert symbol substitutions
+        result = text
+        for unicode_sym, ascii_sym in SYMBOL_SUBS.items():
+            result = result.replace(unicode_sym, ascii_sym)
+        return result
+    elif action == 'german':
+        # Invert German substitutions (ambiguous, so just return original)
+        return text
+    return text
+
+
+def parse_scope(scope: Optional[str], literal_string: bool) -> re.Pattern:
+    """Parse and compile the scope pattern."""
+    if literal_string:
+        # Escape special regex characters
+        escaped = re.escape(scope)
+        pattern = re.compile(f'^{escaped}$')
+    else:
+        pattern = re.compile(scope)
+    return pattern
+
+
+def process_text(text: str, scope: re.Pattern, replacement: Optional[str], actions: List[str],
+                 invert: bool = False, prefer_original: bool = False, naive: bool = False,
+                 squeeze: bool = False, literal_string: bool = False) -> str:
+    """Process text with the given scope and actions."""
+    result = text
+    
+    # Apply actions in order
+    for action in actions:
+        if action == 'upper':
+            result = scope.sub(lambda m: m.group(0).upper(), result)
+        elif action == 'lower':
+            result = scope.sub(lambda m: m.group(0).lower(), result)
+        elif action == 'titlecase':
+            result = scope.sub(lambda m: ' '.join(word.capitalize() for word in m.group(0).split()), result)
+        elif action == 'normalize':
+            # Normalize unicode
+            result = scope.sub(lambda m: unicodedata.normalize('NFC', m.group(0)), result)
+        elif action == 'german':
+            result = apply_german_substitutions(result, prefer_original, naive)
+        elif action == 'symbols':
+            result = apply_symbols(result)
+        elif action == 'delete':
+            result = scope.sub('', result)
+        elif action == 'squeeze':
+            result = apply_squeeze(result)
+    
+    # Apply replacement if specified
+    if replacement is not None:
+        result = apply_replacement(result, replacement, scope)
+    
+    return result
+
+
