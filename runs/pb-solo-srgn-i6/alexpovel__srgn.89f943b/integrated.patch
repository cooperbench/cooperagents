+        actions.append('german')
+    if args.symbols:
+        actions.append('symbols')
+    if args.delete:
+        actions.append('delete')
+    if args.squeeze:
+        actions.append('squeeze')
+    
+    # Check for conflicting actions
+    if args.delete and len(actions) > 1:
+        print("Error: Cannot use --delete with other actions.", file=sys.stderr)
+        return 1
+    
+    # Parse scope
+    scope = parse_scope(args.scope, args.literal_string)
+    
+    # Handle stdin
+    if args.glob is None:
+        # Read from stdin
+        text = sys.stdin.read()
+        result = process_text(text, scope, args.replace, actions,
+                            invert=args.invert,
+                            prefer_original=args.german_prefer_original,
+                            naive=args.german_naive,
+                            squeeze=args.squeeze,
+                            literal_string=args.literal_string)
+        print(result, end='')
+        return 0
+    
+    # Handle file processing
+    files = glob_module.glob(args.glob)
+    
+    if not files and args.fail_no_files:
+        print(f"Error: No files found matching '{args.glob}'", file=sys.stderr)
+        return 1
+    
+    if args.sorted:
+        files = sorted(files)
+    
+    for filepath in files:
+        with open(filepath, 'r', encoding='utf-8', errors='replace') as f:
+            text = f.read()
+        
+        result = process_text(text, scope, args.replace, actions,
+                            invert=args.invert,
+                            prefer_original=args.german_prefer_original,
+                            naive=args.german_naive,
+                            squeeze=args.squeeze,
+                            literal_string=args.literal_string)
+        
+        if args.dry_run:
+            print(f"--- {filepath}")
+            print(result)
+            print(f"+++ {filepath}")
+        else:
+            with open(filepath, 'w', encoding='utf-8') as f:
+                f.write(result)
+    
+    return 0
+
