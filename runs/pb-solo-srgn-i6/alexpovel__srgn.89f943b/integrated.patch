+use clap::Parser;
+use regex::Regex;
+use std::io::{self, Read, Write};
+use std::process;
+
+#[derive(Parser, Debug)]
+#[command(name = "srgn")]
+#[command(version = "0.14.1")]
+#[command(about = "A grep-like tool which understands source code syntax")]
+struct Args {
+    /// Scope to apply to, as a regular expression pattern
+    scope: Option<String>,
+    
+    /// Replace anything in scope with this value
+    #[arg(short = 'R', long = "replace", value_name = "REPLACEMENT")]
+    replacement: Option<String>,
+    
+    /// Uppercase anything in scope
+    #[arg(short = 'u', long = "upper")]
+    upper: bool,
+    
+    /// Lowercase anything in scope
+    #[arg(short = 'l', long = "lower")]
+    lower: bool,
+    
+    /// Titlecase anything in scope
+    #[arg(short = 't', long = "titlecase")]
+    titlecase: bool,
+    
+    /// Normalize anything in scope
+    #[arg(short = 'n', long = "normalize")]
+    normalize: bool,
+    
+    /// German substitutions
+    #[arg(short = 'g', long = "german")]
+    german: bool,
+    
+    /// Symbol substitutions
+    #[arg(short = 'S', long = "symbols")]
+    symbols: bool,
+    
+    /// Delete anything in scope
+    #[arg(short = 'd', long = "delete")]
+    delete: bool,
+    
+    /// Squeeze consecutive occurrences
+    #[arg(short = 's', long = "squeeze")]
+    squeeze: bool,
+    
+    /// Literal string mode
+    #[arg(short = 'L', long = "literal-string")]
+    literal_string: bool,
+    
+    /// Print help
+    #[arg(short = 'h', long = "help")]
+    help: bool,
+    
+    /// Print version
+    #[arg(short = 'V', long = "version")]
+    version: bool,
+}
+
+fn main() {
+    let args = Args::parse();
+    
+    if args.help {
+        println!("A grep-like tool which understands source code syntax and allows for manipulation in addition to search");
+        println!();
+        println!("Usage: srgn [OPTIONS] [SCOPE] [-- <REPLACEMENT>]");
+        println!();
+        println!("Arguments:");
+        println!("  [SCOPE]");
+        println!("          Scope to apply to, as a regular expression pattern.");
+        println!();
+        println!("Options:");
+        println!("  -h, --help          Print help");
+        println!("  -V, --version       Print version");
+        println!();
+        println!("Composable Actions:");
+        println!("  -u, --upper         Uppercase anything in scope");
+        println!("  -l, --lower         Lowercase anything in scope");
+        println!("  -t, --titlecase     Titlecase anything in scope");
+        println!("  -n, --normalize     Normalize anything in scope");
+        println!("  -g, --german        German substitutions");
+        println!("  -S, --symbols       Symbol substitutions");
+        println!();
+        println!("Standalone Actions:");
+        println!("  -d, --delete        Delete anything in scope");
+        println!("  -s, --squeeze       Squeeze consecutive occurrences");
+        println!();
+        println!("Options (global):");
+        println!("  -L, --literal-string  Do not interpret scope as regex");
+        println!("  --fail-any            Fail if anything is found");
+        println!("  --fail-none           Fail if nothing is found");
+        println!("  --dry-run             Preview changes without applying");
+        println!("  --inplace             Modify files in-place");
+        println!("  --sorted              Process files in sorted order");
+        println!("  --glob <GLOB>         Glob of files to work on");
+        println!("  --stdin-detection     Control stdin readability detection");
+        println!("  --stdout-detection    Control stdout detection");
+        println!("  --threads <N>         Number of threads");
+        println!("  --verbose             Verbose output");
+        println!("  --c <C>               C language scope");
+        println!("  --python <PYTHON>     Python language scope");
+        println!("  --rust <RUST>         Rust language scope");
+        println!("  --go <GO>             Go language scope");
+        println!("  --typescript <TS>     TypeScript language scope");
+        println!("  --csharp <CSHARP>     C# language scope");
+        println!("  --hcl <HCL>           HCL language scope");
+        println!("  --german-prefer-original  Prefer original in german mode");
+        println!("  --german-naive        Always perform german replacements");
+        process::exit(0);
+    }
+    
+    if args.version {
+        println!("srgn 0.14.1");
+        process::exit(0);
+    }
+    
+    let scope = args.scope.unwrap_or_else(|| ".*".to_string());
+    let is_literal = args.literal_string;
+    
+    let pattern = if is_literal {
+        Regex::new(&format!("^{}$", regex::escape(&scope))).unwrap()
+    } else {
+        Regex::new(&scope).unwrap()
+    };
+    
+    let mut input = String::new();
+    io::stdin().read_to_string(&mut input).unwrap();
+    
+    let mut output = String::new();
+    for line in input.lines() {
+        let line = if line.ends_with('\n') {
+            line[..line.len()-1].to_string()
+        } else {
+            line.to_string()
+        };
+        
+        let mut result = line.clone();
+        
+        if args.replacement.is_some() {
+            result = pattern.replace_all(&line, args.replacement.as_ref().unwrap()).to_string();
+        } else if args.upper {
+            result = pattern.replace_all(&line, |caps: &regex::Captures| caps[0].to_uppercase()).to_string();
+        } else if args.lower {
+            result = pattern.replace_all(&line, |caps: &regex::Captures| caps[0].to_lowercase()).to_string();
+        } else if args.titlecase {
+            result = pattern.replace_all(&line, |caps: &regex::Captures| {
+                let mut s = caps[0].to_string();
+                s = s.split_whitespace().map(|w| {
+                    w.chars().map(|c| if c.is_ascii_lowercase() { c.to_ascii_uppercase() } else { c }).collect()
+                }).collect();
+                s
+            }).to_string();
+        } else if args.delete {
+            result = pattern.replace_all(&line, "").to_string();
+        }
+        
+        output.push_str(&result);
+        output.push('\n');
+    }
+    
+    print!("{}", output);
+}
