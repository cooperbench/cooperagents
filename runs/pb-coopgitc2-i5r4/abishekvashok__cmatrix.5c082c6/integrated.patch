+#!/usr/bin/env python3
+"""
+CMatrix - A Matrix-like terminal effect
+Based on the screensaver from The Matrix website
+"""
+
+import sys
+import os
+import time
+import random
+import argparse
+import curses
+import struct
+import fcntl
+import termios
+import tty
+import signal
+import errno
+
+# Version information
+VERSION = "2.0"
+COMPILE_TIME = "22:13:51"
+COMPILE_DATE = "Jun 11 2026"
+EMAIL = "abishekvashok@gmail.com"
+WEB = "https://github.com/abishekvashok/cmatrix"
+
+# Colors
+COLOR_GREEN = 1
+COLOR_RED = 2
+COLOR_BLUE = 3
+COLOR_WHITE = 4
+COLOR_YELLOW = 5
+COLOR_CYAN = 6
+COLOR_MAGENTA = 7
+COLOR_BLACK = 8
+
+# Matrix characters
+MATRIX_CHARS = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+# Lambda characters
+LAMBDA_CHARS = "λ"
+
+# Japanese characters for -c option
+JAPANESE_CHARS = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+# Color mapping for interactive keystrokes
+COLOR_MAP = {
+    '!': COLOR_RED,
+    '@': COLOR_GREEN,
+    '#': COLOR_YELLOW,
+    '$': COLOR_BLUE,
+    '%': COLOR_MAGENTA,
+    '^': COLOR_CYAN,
+    '&': COLOR_WHITE,
+    ')': COLOR_BLACK,
+}
+
+# Valid colors
+VALID_COLORS = ['green', 'red', 'blue', 'white', 'yellow', 'cyan', 'magenta', 'black']
+
+def print_usage():
+    """Print usage information"""
+    usage = """ Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]
+ -a: Asynchronous scroll
+ -b: Bold characters on
+ -B: All bold characters (overrides -b)
+ -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts
+ -f: Force the linux $TERM type to be on
+ -l: Linux mode (uses matrix console font)
+ -L: Lock mode (can be closed from another terminal)
+ -o: Use old-style scrolling
+ -h: Print usage and exit
+ -n: No bold characters (overrides -b and -B, default)
+ -s: "Screensaver" mode, exits on first keystroke
+ -x: X window mode, use if your xterm is using mtx.pcf
+ -V: Print version information and exit
+ -M [message]: Prints your message in the center of the screen. Overrides -L's default message.
+ -u delay (0 - 10, default 4): Screen update delay
+ -C [color]: Use this color for matrix (default green)
+ -r: rainbow mode
+ -m: lambda mode
+ -k: Characters change while scrolling. (Works without -o opt.)
+ -t [tty]: Set tty to use
+"""
+    print(usage.rstrip())
+
+def print_version():
+    """Print version information"""
+    version = f""" CMatrix version {VERSION} (compiled {COMPILE_TIME}, {COMPILE_DATE})
+Email: {EMAIL}
+Web: {WEB}
+"""
+    print(version.rstrip())
+
+class CMatrix:
+    def __init__(self, stdscr, args):
+        self.stdscr = stdscr
+        self.args = args
+        self.running = True
+        self.async_scroll = args.a
+        self.bold = args.b
+        self.all_bold = args.B
+        self.force_term = args.f
+        self.linux_mode = args.l
+        self.old_scroll = args.o
+        self.shadows_only = args.c
+        self.locked = args.L
+        self.rainbow = args.r
+        self.lambda_mode = args.m
+        self.chars_change = args.k
+        self.screensaver = args.s
+        self.x_mode = args.x
+        self.update_delay = args.u
+        self.color = args.C
+        self.message = args.M
+        self.tty = args.t
+        self.speed = 4
+        self.current_color = COLOR_GREEN
+        
+        # Initialize terminal settings
+        self.init_terminal()
+        
+        # Get terminal dimensions
+        self.height, self.width = self.stdscr.getmaxyx()
+        
+        # Initialize matrix data
+        self.init_matrix()
+        
+        # Set up signal handlers
+        signal.signal(signal.SIGWINCH, self.handle_resize)
+        signal.signal(signal.SIGTERM, self.handle_sigterm)
+        signal.signal(signal.SIGINT, self.handle_sigint)
+        
+        # Set up lock file if needed
+        if args.L:
+            self.setup_lock()
+    
+    def init_terminal(self):
+        """Initialize terminal settings"""
+        curses.curs_set(0)
+        self.stdscr.nodelay(True)
+        self.stdscr.timeout(50)
+        
+        # Set terminal type if forced
+        if self.args.f:
+            os.environ['TERM'] = 'linux'
+    
+    def init_matrix(self):
+        """Initialize the matrix data structure"""
+        self.lines = []
+        self.num_lines = 0
+        
+        # Calculate number of lines based on terminal height
+        if self.height > 0:
+            self.num_lines = self.height // 2
+        else:
+            self.num_lines = 24
+        
+        # Initialize lines with random characters
+        for i in range(self.num_lines):
+            line = []
+            for j in range(self.width):
+                if self.lambda_mode:
+                    line.append(LAMBDA_CHARS)
+                elif self.args.c:
+                    line.append(JAPANESE_CHARS)
+                else:
+                    line.append(MATRIX_CHARS)
+            self.lines.append(line)
+    
+    def handle_resize(self, stdscr=None):
+        """Handle terminal resize"""
+        self.height, self.width = stdscr.getmaxyx()
+        self.init_matrix()
+    
+    def handle_sigterm(self, signum, frame):
+        """Handle SIGTERM"""
+        self.running = False
+    
+    def handle_sigint(self, signum, frame):
+        """Handle SIGINT"""
+        if not self.args.L:
+            self.running = False
+    
+    def setup_lock(self):
+        """Setup lock file"""
+        lock_file = '/tmp/cmatrix.lock'
+        try:
+            with open(lock_file, 'w') as f:
+                fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            self.lock_fd = f
+        except (IOError, OSError):
+            self.running = False
+    
+    def cleanup_lock(self):
+        """Cleanup lock file"""
+        if hasattr(self, 'lock_fd') and self.lock_fd:
+            try:
+                fcntl.flock(self.lock_fd.fileno(), fcntl.LOCK_UN)
+                self.lock_fd.close()
+                os.unlink('/tmp/cmatrix.lock')
+            except:
+                pass
+    
+    def set_color(self):
+        """Set the current color"""
+        if self.rainbow:
+            # Rainbow mode - cycle through colors
+            self.current_color = (self.current_color + 1) % len(VALID_COLORS)
+        elif self.args.c:
+            # Japanese mode - use cyan
+            self.current_color = COLOR_CYAN
+        else:
+            # Default green
+            self.current_color = COLOR_GREEN
+    
+    def draw_matrix(self):
+        """Draw the matrix effect"""
+        self.set_color()
+        
+        # Get current color pair
+        color_pair = self.current_color
+        
+        # Draw each line
+        for i, line in enumerate(self.lines):
+            y = i % self.height
+            x = (i * self.width) % self.width
+            
+            for j, char in enumerate(line):
+                if j >= self.width:
+                    break
+                
+                # Calculate position
+                draw_y = (y + j) % self.height
+                draw_x = (x + j) % self.width
+                
+                # Get character
+                if self.lambda_mode:
+                    display_char = LAMBDA_CHARS
+                elif self.args.c:
+                    display_char = JAPANESE_CHARS
+                else:
+                    display_char = char
+                
+                # Set attributes
+                if self.all_bold:
+                    attr = curses.A_BOLD
+                elif self.bold:
+                    attr = curses.A_BOLD
+                elif self.shadows_only:
+                    attr = 0
+                else:
+                    attr = curses.A_BOLD
+                
+                # Set color
+                if color_pair > 0:
+                    try:
+                        curses.start_color()
+                        curses.init_pair(color_pair, curses.COLOR_GREEN, curses.COLOR_BLACK)
+                        if color_pair == COLOR_RED:
+                            curses.init_pair(color_pair, curses.COLOR_RED, curses.COLOR_BLACK)
+                        elif color_pair == COLOR_BLUE:
+                            curses.init_pair(color_pair, curses.COLOR_BLUE, curses.COLOR_BLACK)
+                        elif color_pair == COLOR_WHITE:
+                            curses.init_pair(color_pair, curses.COLOR_WHITE, curses.COLOR_BLACK)
+                        elif color_pair == COLOR_YELLOW:
+                            curses.init_pair(color_pair, curses.COLOR_YELLOW, curses.COLOR_BLACK)
+                        elif color_pair == COLOR_CYAN:
+                            curses.init_pair(color_pair, curses.COLOR_CYAN, curses.COLOR_BLACK)
+                        elif color_pair == COLOR_MAGENTA:
+                            curses.init_pair(color_pair, curses.COLOR_MAGENTA, curses.COLOR_BLACK)
+                        elif color_pair == COLOR_BLACK:
+                            curses.init_pair(color_pair, curses.COLOR_BLACK, curses.COLOR_BLACK)
+                        
+                        curses.color_pair(color_pair)(attr)
+                        self.stdscr.addch(draw_y, draw_x, display_char)
+                    except curses.error:
+                        pass
+    
+    def update_matrix(self):
+        """Update the matrix data"""
+        # Move lines
+        for i in range(self.num_lines - 1, 0, -1):
+            self.lines[i] = self.lines[i - 1]
+        
+        # Add new line at top
+        new_line = []
+        for j in range(self.width):
+            if self.lambda_mode:
+                new_line.append(LAMBDA_CHARS)
+            elif self.args.c:
+                new_line.append(JAPANESE_CHARS)
+            else:
+                new_line.append(random.choice(MATRIX_CHARS))
+        self.lines.insert(0, new_line)
+    
+    def handle_input(self):
+        """Handle interactive input"""
+        try:
+            key = self.stdscr.getch()
+            if key == -1:
+                return
+            
+            if self.args.s:
+                # Screensaver mode - exit on any key
+                self.running = False
+                return
+            
+            if key == ord('q'):
+                self.running = False
+                return
+            
+            if key == ord('a'):
+                self.async_scroll = not self.async_scroll
+                return
+            
+            if key == ord('b'):
+                self.bold = not self.bold
+                return
+            
+            if key == ord('B'):
+                self.all_bold = True
+                self.bold = False
+                return
+            
+            if key == ord('n'):
+                self.all_bold = False
+                self.bold = False
+                return
+            
+            if key >= ord('0') and key <= ord('9'):
+                self.speed = int(key)
+                return
+            
+            if key in COLOR_MAP:
+                self.current_color = COLOR_MAP[key]
+                return
+            
+        except curses.error:
+            pass
+    
+    def draw_message(self):
+        """Draw the message in the center"""
+        if self.message:
+            msg_y = self.height // 2
+            msg_x = self.width // 2 - len(self.message) // 2
+            self.stdscr.addstr(msg_y, msg_x, self.message)
+    
+    def run(self):
+        """Main loop"""
+        while self.running:
+            # Update matrix
+            self.update_matrix()
+            
+            # Draw matrix
+            self.draw_matrix()
+            
+            # Draw message if present
+            self.draw_message()
+            
+            # Handle input
+            self.handle_input()
+            
+            # Clear screen
+            self.stdscr.clear()
+            
+            # Refresh
+            self.stdscr.refresh()
+            
+            # Sleep based on update delay
+            delay = self.update_delay / 10.0
+            time.sleep(delay)
+        
+        # Cleanup
+        self.cleanup_lock()
+        curses.endwin()
+    
+    def print_version(self):
+        """Print version information"""
+        version = f""" CMatrix version {VERSION} (compiled {COMPILE_TIME}, {COMPILE_DATE})
+Email: {EMAIL}
+Web: {WEB}
+"""
+        print(version.rstrip())
+
+
+def main():
+    """Main entry point"""
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument('-a', action='store_true', help='Asynchronous scroll')
+    parser.add_argument('-b', action='store_true', help='Bold characters on')
+    parser.add_argument('-B', action='store_true', help='All bold characters')
+    parser.add_argument('-c', action='store_true', help='Use Japanese characters')
+    parser.add_argument('-f', action='store_true', help='Force linux TERM type')
+    parser.add_argument('-l', action='store_true', help='Linux mode')
+    parser.add_argument('-L', action='store_true', help='Lock mode')
+    parser.add_argument('-o', action='store_true', help='Old-style scrolling')
+    parser.add_argument('-h', '-?', action='store_true', help='Print usage and exit')
+    parser.add_argument('-n', action='store_true', help='No bold characters')
+    parser.add_argument('-s', action='store_true', help='Screensaver mode')
+    parser.add_argument('-x', action='store_true', help='X window mode')
+    parser.add_argument('-V', action='store_true', help='Print version and exit')
+    parser.add_argument('-r', action='store_true', help='Rainbow mode')
+    parser.add_argument('-m', action='store_true', help='Lambda mode')
+    parser.add_argument('-k', action='store_true', help='Characters change')
+    parser.add_argument('-u', type=int, default=4, help='Update delay (0-10)')
+    parser.add_argument('-C', type=str, default='green', help='Color')
+    parser.add_argument('-M', type=str, default='', help='Message')
+    parser.add_argument('-t', type=str, default='', help='TTY')
+    
+    args = parser.parse_args()
+    
+    # Validate color
+    if args.C.lower() not in VALID_COLORS:
+        print(" Invalid color selection")
+        print(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.")
+        sys.exit(0)
+    
+    # Print usage if requested
+    if args.h:
+        print_usage()
+        sys.exit(0)
+    
+    # Print version if requested
+    if args.V:
+        print_version()
+        sys.exit(0)
+    
+    # Check for terminal
+    if not sys.stdout.isatty():
+        print("Error: This program requires a terminal")
+        sys.exit(1)
+    
+    # Create and run CMatrix
+    try:
+        stdscr = curses.initscr()
+        cmatrix = CMatrix(stdscr, args)
+        cmatrix.run()
+    except curses.error as e:
+        print(f"Error: {e}")
+        sys.exit(1)
+    except Exception as e:
+        print(f"Error: {e}")
+        sys.exit(1)
+    finally:
+        curses.endwin()
+
+
+if __name__ == '__main__':
+    main()
