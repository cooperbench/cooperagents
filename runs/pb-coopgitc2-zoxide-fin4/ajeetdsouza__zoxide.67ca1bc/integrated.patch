+use std::collections::HashMap;
+use std::env;
+use std::fs::{self, File};
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+
+const VERSION: &str = "0.9.9";
+
+fn get_data_dir() -> PathBuf {
+    env::var("_ZO_DATA_DIR")
+        .ok()
+        .map(PathBuf::from)
+        .or_else(|| env::var("XDG_DATA_HOME").map(|p| PathBuf::from(p)).ok())
+        .or_else(|| env::var("HOME").map(|h| PathBuf::from(h).join(".local/share")).ok())
+        .unwrap_or_else(|| PathBuf::from("."))
+}
+
+fn get_db_path() -> PathBuf {
+    get_data_dir().join("db.zo")
+}
+
+fn read_db() -> io::Result<HashMap<PathBuf, u64>> {
+    let db_path = get_db_path();
+    if !db_path.exists() {
+        return Ok(HashMap::new());
+    }
+    
+    let mut file = File::open(&db_path)?;
+    
+    let mut db = HashMap::new();
+    
+    // Read magic number (4 bytes)
+    let mut magic = [0u8; 4];
+    file.read_exact(&mut magic)?;
+    if magic != [0x03, 0x00, 0x00, 0x00] {
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "Invalid database format"));
+    }
+    
+    // Read version (4 bytes)
+    let mut version = [0u8; 4];
+    file.read_exact(&mut version)?;
+    let _version = u32::from_le_bytes(version);
+    
+    // Read count (4 bytes)
+    let mut count_bytes = [0u8; 4];
+    file.read_exact(&mut count_bytes)?;
+    let count = u32::from_le_bytes(count_bytes);
+    
+    // Read entries
+    for _ in 0..count {
+        // Read path (null-terminated)
+        let mut path_buf = Vec::new();
+        loop {
+            let mut byte = [0u8; 1];
+            match file.read_exact(&mut byte) {
+                Ok(_) => {
+                    if byte[0] == 0 {
+                        break;
+                    }
+                    path_buf.push(byte[0]);
+                }
+                Err(e) if e.kind() == io::ErrorKind::UnexpectedEof => {
+                    break;
+                }
+                Err(e) => return Err(e),
+            }
+        }
+        
+        let path = String::from_utf8_lossy(&path_buf).to_string();
+        let path = PathBuf::from(path);
+        
+        // Read rank (8 bytes)
+        let mut rank_bytes = [0u8; 8];
+        file.read_exact(&mut rank_bytes)?;
+        let rank = u64::from_le_bytes(rank_bytes);
+        
+        db.insert(path, rank);
+    }
+    
+    Ok(db)
+}
+
+fn write_db(db: &HashMap<PathBuf, u64>) -> io::Result<()> {
+    let db_path = get_db_path();
+    let parent = db_path.parent().unwrap_or(Path::new("."));
+    fs::create_dir_all(parent)?;
+    
+    let mut file = File::create(&db_path)?;
+    
+    // Write magic number (4 bytes)
+    file.write_all(&[0x03, 0x00, 0x00, 0x00])?;
+    
+    // Write version (4 bytes)
+    file.write_all(&[0x01, 0x00, 0x00, 0x00])?;
+    
+    // Write count (4 bytes)
+    let count = db.len() as u32;
+    let count_bytes = count.to_le_bytes();
+    file.write_all(&count_bytes)?;
+    
+    // Write entries
+    for (path, score) in db {
+        // Write path (null-terminated)
+        let path_str = path.to_string_lossy();
+        for byte in path_str.as_bytes() {
+            file.write_all(&[*byte])?;
+        }
+        file.write_all(&[0u8])?;
+        
+        // Write rank (8 bytes)
+        let score_bytes = score.to_le_bytes();
+        file.write_all(&score_bytes)?;
+    }
+    
+    Ok(())
+}
+
+fn get_excluded_dirs() -> Vec<String> {
+    let env_var = env::var("_ZO_EXCLUDE_DIRS").unwrap_or_default();
+    if env_var.is_empty() {
+        return vec!["$HOME".to_string()];
+    }
+    env_var.split(':').map(|s| s.to_string()).collect()
+}
+
+fn should_exclude(path: &Path) -> bool {
+    let excluded = get_excluded_dirs();
+    for pattern in &excluded {
+        if pattern.starts_with('$') {
+            let _expanded = env::var("HOME").unwrap_or_default();
+            let pattern = pattern[1..].replace('*', ".*");
+            let regex = format!("^{}$", pattern.replace('$', ""));
+            if path.to_string_lossy().matches(&regex).next().is_some() {
+                return true;
+            }
+        } else {
+            if path.to_string_lossy().contains(pattern) {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+fn add_dir(path: &Path) -> io::Result<()> {
+    let mut db = read_db()?;
+    
+    let resolved_path = if env::var("_ZO_RESOLVE_SYMLINKS").is_ok() {
+        fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf())
+    } else {
+        path.to_path_buf()
+    };
+    
+    if should_exclude(&resolved_path) {
+        return Ok(());
+    }
+    
+    let score = db.get(&resolved_path).copied().unwrap_or(0) + 1;
+    db.insert(resolved_path, score);
+    
+    write_db(&db)?;
+    Ok(())
+}
+
+fn query_db(query: &str) -> io::Result<Vec<(PathBuf, u64)>> {
+    let db = read_db()?;
+    
+    let query_lower = query.to_lowercase();
+    let mut results: Vec<(PathBuf, u64)> = db.iter()
+        .filter_map(|(path, score)| {
+            let path_str = path.to_string_lossy();
+            if query_lower.starts_with('/') {
+                if path_str.starts_with(&query_lower) {
+                    Some((path.to_path_buf(), *score))
+                } else {
+                    None
+                }
+            } else {
+                if path_str.to_lowercase().contains(&query_lower) {
+                    Some((path.to_path_buf(), *score))
+                } else {
+                    None
+                }
+            }
+        })
+        .collect();
+    
+    results.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    Ok(results)
+}
+
+fn run_add(path_str: &str) -> io::Result<()> {
+    let path = PathBuf::from(path_str);
+    if !path.exists() {
+        return Err(io::Error::new(io::ErrorKind::NotFound, "Path does not exist"));
+    }
+    add_dir(&path)
+}
+
+fn run_query(query: &str) -> io::Result<()> {
+    let results = query_db(query)?;
+    for (path, _score) in results {
+        println!("{}", path.to_string_lossy());
+    }
+    Ok(())
+}
+
+fn run_remove(path_str: &str) -> io::Result<()> {
+    let mut db = read_db()?;
+    let path = PathBuf::from(path_str);
+    db.remove(&path);
+    write_db(&db)?;
+    Ok(())
+}
+
+fn run_init(shell: &str, cmd: &str) -> io::Result<()> {
+    match shell {
+        "bash" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"__zoxide_z() {{
+    local dir
+    dir=$(zoxide query "$@")
+    if [ -n "$dir" ]; then
+        cd "$dir"
+    fi
+}}
+__zoxide_zi() {{
+    local dir
+    dir=$(zoxide query "$@")
+    if [ -n "$dir" ]; then
+        cd "$dir"
+    fi
+}}
+"#
+                )
+            } else {
+                format!(
+                    r#"eval "$(zoxide init bash --hook {} --cmd {})"
+"#,
+                    hook, cmd
+                )
+            };
+            println!("{}", script);
+        }
+        "zsh" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"__zoxide_z() {{
+    local dir
+    dir=$(zoxide query "$@")
+    if [ -n "$dir" ]; then
+        cd "$dir"
+    fi
+}}
+__zoxide_zi() {{
+    local dir
+    dir=$(zoxide query "$@")
+    if [ -n "$dir" ]; then
+        cd "$dir"
+    fi
+}}
+"#
+                )
+            } else {
+                format!(
+                    r#"eval "$(zoxide init zsh --hook {} --cmd {})"
+"#,
+                    hook, cmd
+                )
+            };
+            println!("{}", script);
+        }
+        "fish" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"function __zoxide_z
+    set -l dir (zoxide query $argv)
+    if [ -n "$dir" ]; then
+        cd "$dir"
+    end
+end
+function __zoxide_zi
+    set -l dir (zoxide query $argv)
+    if [ -n "$dir" ]; then
+        cd "$dir"
+    end
+end
+"#
+                )
+            } else {
+                format!(
+                    r#"eval "$(zoxide init fish --hook {} --cmd {})"
+"#,
+                    hook, cmd
+                )
+            };
+            println!("{}", script);
+        }
+        "powershell" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"function __zoxide_z {{
+    $dir = zoxide query @args
+    if ($dir) {{
+        Set-Location $dir
+    }}
+}}
+function __zoxide_zi {{
+    $dir = zoxide query @args
+    if ($dir) {{
+        Set-Location $dir
+    }}
+}}
+"#
+                )
+            } else {
+                format!(
+                    r#"Invoke-Expression (& {{ (zoxide init powershell --hook {} --cmd {}) | Out-String }})
+"#,
+                    hook, cmd
+                )
+            };
+            println!("{}", script);
+        }
+        "elvish" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"def __zoxide_z []
+    let dir = (zoxide query @)
+    if (not (empty? $dir)) {{
+        cd $dir
+    }}
+}}
+def __zoxide_zi []
+    let dir = (zoxide query @)
+    if (not (empty? $dir)) {{
+        cd $dir
+    }}
+}}
+"#
+                )
+            } else {
+                format!(
+                    r#"eval (zoxide init elvish --hook {} --cmd {})
+"#,
+                    hook, cmd
+                )
+            };
+            println!("{}", script);
+        }
+        "nushell" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"def __zoxide_z []
+    let dir = (zoxide query @)
+    if ($dir | is-not-empty) {{
+        cd $dir
+    }}
+}}
+def __zoxide_zi []
+    let dir = (zoxide query @)
+    if ($dir | is-not-empty) {{
+        cd $dir
+    }}
+}}
+"#
+                )
+            } else {
+                format!(
+                    r#"eval (zoxide init nushell --hook {} --cmd {})
+"#,
+                    hook, cmd
+                )
+            };
+            println!("{}", script);
+        }
+        "posix" => {
+            let hook = env::var("_ZO_HOOK").unwrap_or_else(|_| "pwd".to_string());
+            let no_cmd = env::var("_ZO_NO_CMD").is_ok();
+            
+            let script = if no_cmd {
+                format!(
+                    r#"__zoxide_z() {{
+    local dir
