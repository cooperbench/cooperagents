+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        println!("zoxide {}", VERSION);
+        println!("Ajeet D'Souza <98ajeet@gmail.com>");
+        println!("https://github.com/ajeetdsouza/zoxide");
+        println!();
+        println!("A smarter cd command for your terminal");
+        println!();
+        println!("Usage:");
+        println!("  executable <COMMAND>");
+        println!();
+        println!("Commands:");
+        println!("  add     Add a new directory or increment its rank");
+        println!("  edit    Edit the database");
+        println!("  import  Import entries from another application");
+        println!("  init    Generate shell configuration");
+        println!("  query   Search for a directory in the database");
+        println!("  remove  Remove a directory from the database");
+        println!();
+        println!("Options:");
+        println!("  -h, --help     Print help");
+        println!("  -V, --version  Print version");
+        println!();
+        println!("Environment variables:");
+        println!("  _ZO_DATA_DIR          Path for zoxide data files");
+        println!("  _ZO_ECHO              Print the matched directory before navigating to it when set to 1");
+        println!("  _ZO_EXCLUDE_DIRS      List of directory globs to be excluded");
+        println!("  _ZO_FZF_OPTS          Custom flags to pass to fzf");
+        println!("  _ZO_MAXAGE            Maximum total age after which entries start getting deleted");
+        println!("  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths");
+        return;
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("zoxide {}", VERSION);
+        return;
+    }
+    
+    if args.len() < 2 {
+        eprintln!("Usage: executable <COMMAND>");
+        std::process::exit(1);
+    }
+    
+    let command = &args[1];
+    
+    match command.as_str() {
+        "add" => {
+            if args.len() < 3 {
+                eprintln!("Usage: executable add <PATH>");
+                std::process::exit(1);
+            }
+            match run_add(&args[2]) {
+                Ok(_) => {},
+                Err(e) => {
+                    eprintln!("Error: {}", e);
+                    std::process::exit(1);
+                }
+            }
+        }
+        "query" => {
+            if args.len() < 3 {
+                eprintln!("Usage: executable query <QUERY>");
+                std::process::exit(1);
+            }
+            match run_query(&args[2]) {
+                Ok(_) => {},
+                Err(e) => {
+                    eprintln!("Error: {}", e);
+                    std::process::exit(1);
+                }
+            }
+        }
+        "remove" => {
+            if args.len() < 3 {
+                eprintln!("Usage: executable remove <PATH>");
+                std::process::exit(1);
+            }
+            match run_remove(&args[2]) {
+                Ok(_) => {},
+                Err(e) => {
+                    eprintln!("Error: {}", e);
+                    std::process::exit(1);
+                }
+            }
+        }
+        "init" => {
+            let shell = env::var("_ZO_SHELL").unwrap_or_else(|_| "bash".to_string());
+            let cmd = env::var("_ZO_CMD").unwrap_or_else(|_| "z".to_string());
+            match run_init(&shell, &cmd) {
+                Ok(_) => {},
+                Err(e) => {
+                    eprintln!("Error: {}", e);
+                    std::process::exit(1);
+                }
+            }
+        }
+        "import" => {
+            if args.len() < 3 {
+                eprintln!("Usage: executable import --from=<SOURCE> <DB_PATH>");
+                std::process::exit(1);
+            }
+            let from = &args[2];
+            let db_path = if args.len() > 3 { &args[3] } else { "" };
+            match run_import(from, db_path) {
+                Ok(_) => {},
+                Err(e) => {
+                    eprintln!("Error: {}", e);
+                    std::process::exit(1);
+                }
+            }
+        }
+        "edit" => {
+            match run_edit() {
+                Ok(_) => {},
+                Err(e) => {
+                    eprintln!("Error: {}", e);
+                    std::process::exit(1);
+                }
+            }
+        }
+        _ => {
+            eprintln!("Unknown command: {}", command);
+            std::process::exit(1);
+        }
+    }
+}
