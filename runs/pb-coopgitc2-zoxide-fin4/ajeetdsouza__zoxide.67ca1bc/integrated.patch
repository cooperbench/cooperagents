+            };
+            println!("{}", script);
+        }
+        _ => {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("Unsupported shell: {}", shell)
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn run_import(from: &str, _db_path: &str) -> io::Result<()> {
+    println!("Importing from {}...", from);
+    Ok(())
+}
