+}
+
+func main() {
+	if len(os.Args) > 1 && (os.Args[1] == "--help" || os.Args[1] == "-h") {
+		printHelp()
+		return
+	}
+	if len(os.Args) > 1 && (os.Args[1] == "--version" || os.Args[1] == "-v") {
+		fmt.Println(version)
+		return
+	}
+	if len(os.Args) > 1 && os.Args[1] == "--themes" {
+		printThemes()
+		return
+	}
+	if len(os.Args) > 1 && os.Args[1] == "--comp" {
+		shell := os.Args[2]
+		printCompletion(shell)
+		return
+	}
+
+	// Check for --raw, --slurp, --yaml, --toml, --strict, --no-inline, --game-of-life
+	raw := false
+	slurp := false
+	yaml := false
+	toml := false
+	gameOfLife := false
+
+	for i := 1; i < len(os.Args); i++ {
+		arg := os.Args[i]
+		if arg == "--raw" {
+			raw = true
+		} else if arg == "--slurp" {
+			slurp = true
+		} else if arg == "--yaml" {
+			yaml = true
+		} else if arg == "--toml" {
+			toml = true
+		} else if arg == "--game-of-life" {
+			gameOfLife = true
+		}
+	}
+
+	if raw && (yaml || toml) {
+		fmt.Println("Error: can't use --yaml/--toml and --raw flags together")
+		os.Exit(1)
+	}
+
+	if gameOfLife {
+		playGameOfLife()
+		return
+	}
+
+	// Read input
+	var input string
+	if len(os.Args) > 1 {
+		data, err := os.ReadFile(os.Args[1])
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "\n  %s\n  ^^^^^^^^^^^^^^\n\nSyntaxError: %v\n", os.Args[1], err)
+			os.Exit(1)
+		}
+		input = string(data)
+	} else {
+		// Read from stdin
+		buf := new(bytes.Buffer)
+		buf.ReadFrom(os.Stdin)
+		input = buf.String()
+	}
+
+	if yaml {
+		// Parse YAML and output JSON
+		data, err := parseYAML(input)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "%v\n", err)
+			os.Exit(1)
+		}
+		output, _ := json.MarshalIndent(data, "", "  ")
+		fmt.Println(string(output))
+		os.Exit(0)
+	}
+
+	if toml {
+		// Parse TOML and output JSON
+		data, err := parseTOML(input)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "%v\n", err)
+			os.Exit(1)
+		}
+		output, _ := json.MarshalIndent(data, "", "  ")
+		fmt.Println(string(output))
+		os.Exit(0)
+	}
+
+	if slurp {
+		// Parse as JSON array
+		var data []interface{}
+		if raw {
+			// Raw mode - just wrap in array
+			data = []interface{}{input}
+		} else {
+			// Try to parse as JSON
+			var single interface{}
+			if err := json.Unmarshal([]byte(input), &single); err != nil {
+				// If it's not valid JSON, wrap in array
+				data = []interface{}{input}
+			} else {
+				data = []interface{}{single}
+			}
+		}
+		output, _ := json.MarshalIndent(data, "", "  ")
+		fmt.Println(string(output))
+		os.Exit(0)
+	}
+
+	if raw {
+		// Raw mode - just print the input
+		fmt.Println(input)
+		os.Exit(0)
+	}
+
+	// Default: parse and pretty-print JSON
+	var data interface{}
+	if err := json.Unmarshal([]byte(input), &data); err != nil {
+		fmt.Fprintf(os.Stderr, "\n  %s\n  ^^^^^^^^^^^^^^\n\nSyntaxError: %v\n", input, err)
+		os.Exit(1)
+	}
+	output, _ := json.MarshalIndent(data, "", "  ")
+	fmt.Println(string(output))
+}
+
+func printHelp() {
+	fmt.Println("\n  fx " + version + "\n    Terminal JSON viewer\n\n  Usage\n    fx data.json\n    fx data.json .field\n    curl ... | fx\n\n  Flags\n    -h, --help            print help\n    -v, --version         print version\n    --themes              print themes\n    --comp <shell>        print completion script\n    -r, --raw             treat input as a raw string\n    -s, --slurp           read all inputs into an array\n    --yaml                parse input as YAML\n    --toml                parse input as TOML\n    --strict              strict mode\n    --no-inline           disable inlining in output\n    --game-of-life        play the game of life\n\n  More info\n    https://fx.wtf\n\n  Author\n    Anton Medvedev <anton@medv.io>\n\n")
+}
+
+func printThemes() {
+	for _, t := range themes {
+		fmt.Printf("export FX_THEME=\"%s\"\n%s\n", t.Name, t.JSON)
+	}
+	fmt.Println()
+}
+
