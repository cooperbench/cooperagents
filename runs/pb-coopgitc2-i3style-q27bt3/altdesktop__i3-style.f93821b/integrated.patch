++fn build_ws(leading: &str, name: &str, c: (&'static str, &'static str, &'static str), line: &str) -> String {
++    // The theme provides 3 colors (border, background, text). The 4th column
++    // (indicator) is taken from the input's 3rd color token, if present;
++    // everything after the 3rd color token is dropped. If the input has fewer
++    // than 3 color tokens, only the theme's 3 colors are emitted.
++    let rest = &line[leading.len()..];
++    let bytes = rest.as_bytes();
++    let mut i = 0usize;
++    let mut count = 0usize;
++    let mut third: Option<&str> = None;
++    while i < bytes.len() {
++        while i < bytes.len() && bytes[i].is_ascii_whitespace() { i += 1; }
++        if i >= bytes.len() { break; }
++        let start = i;
++        i += 1;
++        while i < bytes.len() && !bytes[i].is_ascii_whitespace() { i += 1; }
++        count += 1;
++        if count == 4 {
++            third = Some(&rest[start..i]);
++            break;
++        }
++    }
++    match third {
++        Some(t) => format!("{}{} {} {} {} {}", leading, name, c.0, c.1, c.2, t),
++        None => format!("{}{} {} {} {}", leading, name, c.0, c.1, c.2),
++    }
++}
++
++fn build_client(leading: &str, name: &str, colors: (&str, &str, &str, &str)) -> String {
++    format!("{}{} {} {} {} {}", leading, name, colors.0, colors.1, colors.2, colors.3)
++}
