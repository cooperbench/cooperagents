+// ----------------------------- Theming -----------------------------
+
+fn apply_theme(input: &str, theme: &Theme) -> String {
+    let lines: Vec<String> = input.lines().map(|l| l.to_string()).collect();
+
+    let mut output: Vec<String> = Vec::new();
+    let mut last_bar_idx: Option<usize> = None;
+    let mut last_client_idx: Option<usize> = None;
+    let mut bar_present = false;
+    let mut colors_open_idx: Option<usize> = None;
+    let mut bar_line_idx: Option<usize> = None;
+
+    let mut present_sep = false;
+    let mut present_bg = false;
+    let mut present_status = false;
+    let mut present_ws_focused = false;
+    let mut present_ws_active = false;
+    let mut present_ws_inactive = false;
+    let mut present_ws_urgent = false;
+    let mut present_c_focused = false;
+    let mut present_c_focused_inactive = false;
+    let mut present_c_unfocused = false;
+    let mut present_c_urgent = false;
+
+    for line in &lines {
+        let trimmed = line.trim_start();
+        let first = trimmed.split_whitespace().next().unwrap_or("");
+        let leading = &line[..line.len() - line.trim_start().len()];
+
+        match first {
+            "separator" => {
+                present_sep = true;
+                output.push(format!("{}{} {}", leading, "separator", theme.sep));
+                last_bar_idx = Some(output.len() - 1);
+            }
+            "background" => {
+                present_bg = true;
+                output.push(format!("{}{} {}", leading, "background", theme.bg));
+                last_bar_idx = Some(output.len() - 1);
+            }
+            "statusline" => {
+                present_status = true;
+                output.push(format!("{}{} {}", leading, "statusline", theme.status));
+                last_bar_idx = Some(output.len() - 1);
+            }
+            "focused_workspace" => {
+                present_ws_focused = true;
+                if let Some(c) = theme.ws_focused {
+                    output.push(build_ws(leading, "focused_workspace", c, line));
+                } else {
+                    output.push(line.clone());
+                }
+                last_bar_idx = Some(output.len() - 1);
+            }
+            "active_workspace" => {
+                present_ws_active = true;
+                if let Some(c) = theme.ws_active {
+                    output.push(build_ws(leading, "active_workspace", c, line));
+                } else {
+                    output.push(line.clone());
+                }
+                last_bar_idx = Some(output.len() - 1);
+            }
+            "inactive_workspace" => {
+                present_ws_inactive = true;
+                if let Some(c) = theme.ws_inactive {
+                    output.push(build_ws(leading, "inactive_workspace", c, line));
+                } else {
+                    output.push(line.clone());
+                }
+                last_bar_idx = Some(output.len() -  1);
+            }
+            "urgent_workspace" => {
+                present_ws_urgent = true;
+                if let Some(c) = theme.ws_urgent {
+                    output.push(build_ws(leading, "urgent_workspace", c, line));
+                } else {
+                    output.push(line.clone());
+                }
+                last_bar_idx = Some(output.len() - 1);
+            }
+            "client.focused" => {
+                present_c_focused = true;
+                output.push(build_client(leading, "client.focused", theme.c_focused));
+                last_client_idx = Some(output.len() - 1);
+            }
+            "client.focused_inactive" => {
+                present_c_focused_inactive = true;
+                output.push(build_client(leading, "client.focused_inactive", theme.c_focused_inactive));
+                last_client_idx = Some(output.len() - 1);
+            }
+            "client.unfocused" => {
+                present_c_unfocused = true;
+                output.push(build_client(leading, "client.unfocused", theme.c_unfocused));
+                last_client_idx = Some(output.len() - 1);
+            }
+            "client.urgent" => {
+                present_c_urgent = true;
+                if let Some(c) = theme.c_urgent {
+                    output.push(build_client(leading, "client.urgent", c));
+                } else {
+                    output.push(line.clone());
+                }
+                last_client_idx = Some(output.len() - 1);
+            }
+            "bar" => {
+                bar_present = true;
+                bar_line_idx = Some(output.len());
+                output.push(line.clone());
+            }
+            "colors" => {
+                bar_present = true;
+                output.push(line.clone());
+                colors_open_idx = Some(output.len());
+            }
+            _ => {
+                output.push(line.clone());
+            }
+        }
+    }
+
+    // Determine indents from present lines.
+    let mut bar_indent = String::from("    ");
+    for line in &lines {
+        let first = line.trim_start().split_whitespace().next().unwrap_or("");
+        if matches!(first, "separator" | "background" | "statusline" | "focused_workspace" | "active_workspace" | "inactive_workspace" | "urgent_workspace") {
+            bar_indent = line[..line.len() - line.trim_start().len()].to_string();
+            break;
+        }
+    }
+    let mut client_indent = String::new();
+    for line in &lines {
+        let first = line.trim_start().split_whitespace().next().unwrap_or("");
+        if matches!(first, "client.focused" | "client.focused_inactive" | "client.unfocused" | "client.urgent") {
+            client_indent = line[..line.len() - line.trim_start().len()].to_string();
+            break;
+        }
+    }
+
+    // The original omits the separator (only) when the colors block is already
+    // complete with all four workspace lines, background and statusline are both
+    // missing, and the theme itself cannot provide active/urgent workspace colors.
+    let all_ws_present = present_ws_focused && present_ws_active && present_ws_inactive && present_ws_urgent;
+    let theme_has_all_ws = theme.ws_focused.is_some() && theme.ws_active.is_some() && theme.ws_inactive.is_some() && theme.ws_urgent.is_some();
+    let add_separator = !present_sep && (present_bg || present_status || !all_ws_present || theme_has_all_ws);
+    // Missing bar color lines (sep/bg/status + workspaces), in order.
+    let mut missing_bar: Vec<String> = Vec::new();
+    if add_separator {
+        missing_bar.push(format!("{}{} {}", bar_indent, "separator", theme.sep));
+    }
+    if !present_bg {
+        missing_bar.push(format!("{}{} {}", bar_indent, "background", theme.bg));
+    }
+    if !present_status {
+        missing_bar.push(format!("{}{} {}", bar_indent, "statusline", theme.status));
+    }
+    if !present_ws_focused {
+        if let Some(c) = theme.ws_focused {
+            missing_bar.push(format!("{}{} {} {} {} {}", bar_indent, "focused_workspace", c.0, c.1, c.2, ""));
+        }
+    }
+    if !present_ws_active {
+        if let Some(c) = theme.ws_active {
+            missing_bar.push(format!("{}{} {} {} {} {}", bar_indent, "active_workspace", c.0, c.1, c.2, ""));
+        }
+    }
+    if !present_ws_inactive {
+        if let Some(c) = theme.ws_inactive {
+            missing_bar.push(format!("{}{} {} {} {} {}", bar_indent, "inactive_workspace", c.0, c.1, c.2, ""));
+        }
+    }
+    if !present_ws_urgent {
+        if let Some(c) = theme.ws_urgent {
+            missing_bar.push(format!("{}{} {} {} {} {}", bar_indent, "urgent_workspace", c.0, c.1, c.2, ""));
+        }
+    }
+
+    // Missing client lines.
+    let mut missing_client: Vec<String> = Vec::new();
+    if !present_c_focused {
+        missing_client.push(format!("{}{} {} {} {} {}", client_indent, "client.focused", theme.c_focused.0, theme.c_focused.1, theme.c_focused.2, theme.c_focused.3));
+    }
+    if !present_c_focused_inactive {
+        missing_client.push(format!("{}{} {} {} {} {}", client_indent, "client.focused_inactive", theme.c_focused_inactive.0, theme.c_focused_inactive.1, theme.c_focused_inactive.2, theme.c_focused_inactive.3));
+    }
+    if !present_c_unfocused {
+        missing_client.push(format!("{}{} {} {} {} {}", client_indent, "client.unfocused", theme.c_unfocused.0, theme.c_unfocused.1, theme.c_unfocused.2, theme.c_unfocused.3));
+    }
+    if !present_c_urgent {
+        if let Some(c) = theme.c_urgent {
+            missing_client.push(format!("{}{} {} {} {} {}", client_indent, "client.urgent", c.0, c.1, c.2, c.3));
+        }
+    }
+
+    // If a bar block exists but has no `colors` sub-block and no bar color
+    // lines, the original wraps the (missing) bar colors in a freshly created
+    // `colors { ... }` block placed just before the bar's closing brace.
+    let bar_needs_colors_block =
+        bar_present && colors_open_idx.is_none() && last_bar_idx.is_none();
+    let client_pos = last_client_idx.map(|p| p + 1).unwrap_or(output.len());
+    let bar_pos = if let Some(p) = last_bar_idx {
+        p + 1
+    } else if let Some(p) = colors_open_idx {
+        p
+    } else {
+        output.len()
+    };
+
+    // Insert in descending position order so earlier indices stay valid.
+    // Bar colors are only added when the input actually has a bar block.
+    if client_pos >= bar_pos {
+        output.splice(client_pos..client_pos, missing_client);
+        if bar_present && !bar_needs_colors_block { output.splice(bar_pos..bar_pos, missing_bar); }
+    } else {
+        if bar_present && !bar_needs_colors_block { output.splice(bar_pos..bar_pos, missing_bar); }
+        output.splice(client_pos..client_pos, missing_client);
+    }
+    if bar_needs_colors_block {
+        if let Some(bi) = bar_line_idx {
+            // Brace-match to find the bar block's closing brace.
+            let mut depth: i32 = 0;
+            for ch in output[bi].chars() {
+                if ch == '{' { depth += 1; }
+                if ch == '}' { depth -= 1; }
+            }
+            let mut close_idx: Option<usize> = None;
+            for i in (bi + 1)..output.len() {
+                for ch in output[i].chars() {
+                    if ch == '{' { depth += 1; }
+                    if ch == '}' { depth -= 1; }
+                }
+                if depth == 0 {
+                    close_idx = Some(i);
+                    break;
+                }
+            }
+            // Bar content indent = indent of first non-'}' line in the block.
+            let mut content_indent = "  ".to_string();
+            if let Some(ci) = close_idx {
+                for i in (bi + 1)..ci {
+                    let t = output[i].trim_start();
+                    if !t.is_empty() && !t.starts_with('}') {
+                        let l = &output[i];
+                        content_indent = l[..l.len() - l.trim_start().len()].to_string();
+                        break;
+                    }
+                }
+            }
+            // Colors inside the block are indented one level deeper.
+            let inner = format!("{}  ", content_indent);
+            let mut mb: Vec<String> = Vec::new();
+            if add_separator { mb.push(format!("{}{} {}", inner, "separator", theme.sep)); }
+            if !present_bg { mb.push(format!("{}{} {}", inner, "background", theme.bg)); }
+            if !present_status { mb.push(format!("{}{} {}", inner, "statusline", theme.status)); }
+            if !present_ws_focused { if let Some(c) = theme.ws_focused { mb.push(format!("{}{} {} {} {} {}", inner, "focused_workspace", c.0, c.1, c.2, "")); } }
+            if !present_ws_active { if let Some(c) = theme.ws_active { mb.push(format!("{}{} {} {} {} {}", inner, "active_workspace", c.0, c.1, c.2, "")); } }
+            if !present_ws_inactive { if let Some(c) = theme.ws_inactive { mb.push(format!("{}{} {} {} {} {}", inner, "inactive_workspace", c.0, c.1, c.2, "")); } }
+            if !present_ws_urgent { if let Some(c) = theme.ws_urgent { mb.push(format!("{}{} {} {} {} {}", inner, "urgent_workspace", c.0, c.1, c.2, "")); } }
+            let mut blk: Vec<String> = Vec::new();
+            blk.push(format!("{}colors {{", content_indent));
+            for l in &mb { blk.push(l.clone()); }
+            blk.push(format!("{}}}", content_indent));
+            if let Some(ci) = close_idx {
+                output.splice(ci..ci, blk);
+            }
+        }
+    }
+
+
+    let mut result = String::new();
+    for (i, l) in output.iter().enumerate() {
+        result.push_str(l);
+        if i + 1 < output.len() {
+            result.push('\n');
+        }
+    }
+    if input.ends_with('\n') {
+        result.push('\n');
+    }
+    result
+}
+
+fn build_ws(leading: &str, name: &str, c: (&'static str, &'static str, &'static str), line: &str) -> String {
+    // The theme provides 3 colors (border, background, text). The 4th column
+    // (indicator) is taken from the input's 3rd color token, if present;
+    // everything after the 3rd color token is dropped. If the input has fewer
+    // than 3 color tokens, only the theme's 3 colors are emitted.
+    let rest = &line[leading.len()..];
+    let bytes = rest.as_bytes();
+    let mut i = 0usize;
+    let mut count = 0usize;
+    let mut third: Option<&str> = None;
+    while i < bytes.len() {
+        while i < bytes.len() && bytes[i].is_ascii_whitespace() { i += 1; }
+        if i >= bytes.len() { break; }
+        let start = i;
+        i += 1;
+        while i < bytes.len() && !bytes[i].is_ascii_whitespace() { i += 1; }
+        count += 1;
+        if count == 4 {
+            third = Some(&rest[start..i]);
+            break;
+        }
+    }
+    match third {
+        Some(t) => format!("{}{} {} {} {} {}", leading, name, c.0, c.1, c.2, t),
+        None => format!("{}{} {} {} {}", leading, name, c.0, c.1, c.2),
+    }
+}
+
+fn build_client(leading: &str, name: &str, colors: (&str, &str, &str, &str)) -> String {
+    format!("{}{} {} {} {} {}", leading, name, colors.0, colors.1, colors.2, colors.3)
+}
