+
+// ----------------------------- Argument parsing -----------------------------
+
+struct Args {
+    help: bool,
+    list_all: bool,
+    reload: bool,
+    save: bool,
+    version: bool,
+    config: Option<String>,
+    output: Option<String>,
+    to_theme: Option<String>,
+    theme: Option<String>,
+}
+
+fn parse_args(args: &[String]) -> Result<Args, String> {
+    let mut a = Args {
+        help: false,
+        list_all: false,
+        reload: false,
+        save: false,
+        version: false,
+        config: None,
+        output: None,
+        to_theme: None,
+        theme: None,
+    };
+    let mut i = 0;
+    while i < args.len() {
+        let arg = args[i].clone();
+        match arg.as_str() {
+            "-h" | "--help" => { a.help = true; }
+            "-V" | "--version" => { a.version = true; }
+            "-l" | "--list-all" => { a.list_all = true; }
+            "-r" | "--reload" => { a.reload = true; }
+            "-s" | "--save" => { a.save = true; }
+            "-c" | "--config" | "-o" | "--output" | "-t" | "--to-theme" => {
+                // option requiring a value
+                i += 1;
+                if i >= args.len() {
+                    return Err(format!("error: Missing required argument '{}'", arg));
+                }
+                let val = args[i].clone();
+                match arg.as_str() {
+                    "-c" | "--config" => { a.config = Some(val); }
+                    "-o" | "--output" => { a.output = Some(val); }
+                    "-t" | "--to-theme" => { a.to_theme = Some(val); }
+                    _ => {}
+                }
+                i += 1;
+                continue;
+            }
+            other => {
+                if other.starts_with('-') && other.len() > 1 {
+                    return Err(format!("error: Found argument '{}' which wasn't expected, or isn't valid in this context", other));
+                }
+                if a.theme.is_some() {
+                    return Err(format!("error: Found argument '{}' which wasn't expected, or isn't valid in this context", other));
+                }
+                a.theme = Some(other.to_string());
+            }
+        }
+        i += 1;
+    }
+    Ok(a)
+}
+
+const HELP_TEXT: &str = "i3-style 1.0\nMake your i3 config a bit more stylish\n\nUSAGE:\n    executable [FLAGS] [OPTIONS] [theme]\n\nFLAGS:\n    -h, --help        Prints help information\n    -l, --list-all    Print a list of all available themes\n    -r, --reload      Apply the theme by reloading the config\n    -s, --save        Set the output file to the path of the input file\n    -V, --version     Prints version information\n\nOPTIONS:\n    -c, --config <file>      The config file the theme should be applied to. Defaults to the default i3 location.\n    -o, --output <file>      Apply the theme, attempt to validate the result, and write it to <file>\n    -t, --to-theme <file>    Prints an i3-style theme based on the given config suitable for sharing with others\n                             [default: ]\n\nARGS:\n    <theme>    The theme to use\n";
+
+fn usage_no_theme() {
+    print!("USAGE:\n    executable [FLAGS] [OPTIONS] [theme]\n\nSelect a theme as the first argument. Use `--list-all` to see the themes.\n");
+}
+
+fn unknown_flag(msg: &str) {
+    eprint!(
+        "error: {}\n\nUSAGE:\n    executable [FLAGS] [OPTIONS] [theme]\n\nFor more information try --help\n",
+        msg
+    );
+}
+
+// ----------------------------- Config application -----------------------------
+
+fn main() {
+    let raw: Vec<String> = std::env::args().skip(1).collect();
+    let args = match parse_args(&raw) {
+        Ok(a) => a,
+        Err(msg) => {
+            // Determine if it's an unknown-flag style error vs missing value.
+            if msg.starts_with("error: Found argument") {
+                unknown_flag(&msg[7..]);
+                exit(1);
+            } else {
+                // missing value for an option
+                eprint!("{}", msg);
+                eprint!("\n\nUSAGE:\n    executable [FLAGS] [OPTIONS] [theme]\n\nFor more information try --help\n");
+                exit(1);
+            }
+        }
+    };
+
+    if args.help {
+        print!("{}", HELP_TEXT);
+        exit(0);
+    }
+    if args.version {
+        println!("i3-style 1.0");
+        exit(0);
+    }
+    if args.list_all {
+        print_list_all();
+        exit(0);
+    }
+
+    // -t / --to-theme mode
+    if let Some(ref to_theme) = args.to_theme {
+        let out = Command::new("i3").arg("-C").arg("-c").arg(to_theme).output();
+        match out {
+            Err(e) => {
+                eprintln!("Could not validate config with `i3 -C -c {}` (is i3 in the PATH?) {}", to_theme, e);
+                exit(1);
+            }
+            Ok(o) => {
+                if !o.status.success() {
+                    eprintln!("Could not validate config.\nUse `i3 -C -c {}` to see validation errors.", to_theme);
+                    exit(1);
+                }
+            }
+        }
+        // validated; the original panics here (reads default config which may be missing)
+        panic_like_original();
+    }
+
+    // Need a theme.
+    let theme_name = match &args.theme {
+        Some(t) => t.clone(),
+        None => {
+            usage_no_theme();
+            exit(1);
+        }
+    };
+
+    let theme = match find_theme(&theme_name) {
+        Some(t) => t,
+        None => {
+            eprintln!("Could not open theme: {} - No such file or directory (os error 2)", theme_name);
+            eprintln!(" Use `i3-style --list-all` to see the available themes.");
+            exit(1);
+        }
+    };
+
+    // config path
+    let cfg_path = match &args.config {
+        Some(p) => p.clone(),
+        None => match default_config_path() {
+            Some(p) => p,
+            None => {
+                eprintln!("Could not find i3 config");
+                exit(1);
+            }
+        },
+    };
+
+    let input = match std::fs::read_to_string(&cfg_path) {
+        Ok(s) => s,
+        Err(_) => {
+            eprintln!("Could not find i3 config");
+            exit(1);
+        }
+    };
+
+    let themed = apply_theme(&input, &theme);
+
+    // validate
+    let out = Command::new("i3").arg("-C").arg("-c").arg(&cfg_path).output();
+    match out {
+        Err(e) => {
+            eprintln!("Could not validate config with `i3 -C -c {}` (is i3 in the PATH?) {}", cfg_path, e);
+            exit(1);
+        }
+        Ok(o) => {
+            if !o.status.success() {
+                eprintln!("Could not validate config.\nUse `i3 -C -c {}` to see validation errors.", cfg_path);
+                exit(1);
+            }
+        }
+    }
+
+    // temp dir + config-input/config-output
+    let tmp_dir = format!("/tmp/i3-style/{}", current_epoch());
+    let _ = std::fs::create_dir_all(&tmp_dir);
+    let config_input_path = format!("{}/config-input", tmp_dir);
+    let config_output_path = format!("{}/config-output", tmp_dir);
+    let _ = std::fs::write(&config_input_path, &input);
+    let _ = std::fs::write(&config_output_path, &themed);
+
+    // output
+    if let Some(ref out_path) = args.output {
+        if let Err(e) = std::fs::write(out_path, &themed) {
+            eprintln!("{}", e);
+            exit(1);
+        }
+        eprintln!("saving config at {} to {}", cfg_path, config_input_path);
+    } else if args.save {
+        if let Err(e) = std::fs::write(&cfg_path, &themed) {
+            eprintln!("{}", e);
+            exit(1);
+        }
+        eprintln!("saving config at {} to {}", cfg_path, config_input_path);
+    } else {
+        print!("{}", themed);
+    }
+
+    // reload
+    if args.reload {
+        let r = Command::new("i3-msg").output();
+        match r {
+            Err(e) => {
+                eprintln!("Could not reload config with i3-msg: {}", e);
+                exit(1);
+            }
+            Ok(o) => {
+                if !o.status.success() {
+                    eprintln!("Could not reload config.");
+                    exit(1);
+                }
+            }
+        }
+    }
+
+    exit(0);
+}
+
+fn panic_like_original() -> ! {
+    // Emulate the original's panic at src/theme.rs:613:40 (file-not-found Result::unwrap()).
+    let msg = "thread 'main' panicked at src/theme.rs:613:40:\ncalled `Result::unwrap()` on an `Err` value: Os { code: 2, kind: NotFound, message: \"No such file or directory\" }\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n";
+    use std::io::Write;
+    let _ = std::io::stderr().write_all(msg.as_bytes());
+    exit(101);
+}
+
+fn current_epoch() -> u64 {
+    use std::time::{SystemTime, UNIX_EPOCH};
+    match SystemTime::now().duration_since(UNIX_EPOCH) {
+        Ok(d) => d.as_secs(),
+        Err(_) => 0,
+    }
+}
+
+fn default_config_path() -> Option<String> {
+    let home = match std::env::var("HOME") {
+        Ok(h) => h,
+        Err(_) => return None,
+    };
+    let candidates = [
+        format!("{}/.config/i3/config", home),
+        "/etc/i3/config".to_string(),
+        format!("{}/.i3/config", home),
+    ];
+    for c in &candidates {
+        if std::fs::metadata(c).is_ok() {
+            return Some(c.clone());
+        }
+    }
+    None
+}
+
+fn print_list_all() {
+    let mut out = String::new();
+    out.push_str("\nAvailable themes:\n\n");
+    for t in all_themes() {
+        out.push_str(&format!("  {:<18} - {}\n", t.name, t.desc));
+    }
+    print!("{}", out);
+}
