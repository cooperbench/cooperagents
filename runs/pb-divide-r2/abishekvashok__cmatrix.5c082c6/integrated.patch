+} matrix_char_t;
+
+// Screen state
+typedef struct {
+    matrix_char_t **grid;
+    int rows;
+    int cols;
+    int async_scroll;
+    int bold_mode;
+    int all_bold;
+    int no_bold;
+    int old_style;
+    int shadow_mode;
+    int lock_mode;
+    int rainbow_mode;
+    int lambda_mode;
+    int change_chars;
+    int x_mode;
+    int use_term;
+    int update_delay;
+    color_t current_color;
+    char *message;
+    int tty_fd;
+    struct termios orig_termios;
+    int running;
+    int quit;
+} screen_t;
+
+// Initialize screen
+void screen_init(screen_t *screen, int width, int height);
+
+// Cleanup screen
+void screen_cleanup(screen_t *screen);
+
+// Render screen
+void screen_render(screen_t *screen);
+
+// Handle input
+void screen_handle_input(screen_t *screen, int fd);
+
+// Set color
+void screen_set_color(screen_t *screen, color_t color);
+
+// Set message
+void screen_set_message(screen_t *screen, const char *message);
+
+// Get terminal size
+void screen_get_term_size(int *rows, int *cols);
+
+// Generate random character
+char random_char(void);
+
+// Save terminal settings
+int screen_save_termios(void);
+
+// Restore terminal settings
+int screen_restore_termios(void);
+
+#endif
