+#ifndef SCREEN_H
+#define SCREEN_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+
+// Screen dimensions
+#define MAX_COLS 200
+#define MAX_ROWS 100
+
+// Character types
+typedef enum {
+    CHAR_NORMAL,
+    CHAR_BOLD,
+    CHAR_SHADOW
+} char_type_t;
+
+// Color types
+typedef enum {
+    COLOR_GREEN,
+    COLOR_RED,
+    COLOR_BLUE,
+    COLOR_WHITE,
+    COLOR_YELLOW,
+    COLOR_CYAN,
+    COLOR_MAGENTA,
+    COLOR_BLACK
+} color_t;
+
+// Matrix character
+typedef struct {
+    char c;
+    char_type_t type;
