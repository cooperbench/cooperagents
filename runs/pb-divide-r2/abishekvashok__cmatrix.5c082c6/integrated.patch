+#include "options.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <getopt.h>
+
+// Print version
+void options_print_version(void) {
+    printf("cmatrix version 1.0\n");
+}
+
+// Print usage
+void options_print_usage(const char *progname) {
+    printf("Usage: %s [-abBflohnsmVx] [-u update] [-C color]\n", progname);
+    printf("\nOptions:\n");
+    printf("  -a    Asynchronous scroll\n");
+    printf("  -b    Bold characters on\n");
+    printf("  -B    All bold characters (overrides -b)\n");
+    printf("  -f    Force the linux $TERM type to be on\n");
+    printf("  -l    Linux mode (sets \"matrix.fnt\" font in console)\n");
+    printf("  -o    Use old-style scrolling\n");
+    printf("  -c    Only print the shadows of letters\n");
+    printf("  -L    Locks cmatrix, unable to quit\n");
+    printf("  -h, -?    Print usage and exit\n");
+    printf("  -r    \"Rainbow\" mode, rainbow colored characters\n");
+    printf("  -k    Every characters change\n");
+    printf("  -n    No bold characters (overrides -b and -B)\n");
+    printf("  -s    \"Screensaver\" mode, exits on first keystroke\n");
+    printf("  -m    \"Lambda\" mode, every character becomes a lambda\n");
+    printf("  -x    X window mode\n");
+    printf("  -V    Print version information and exit\n");
+    printf("  -u delay    Screen update delay 0-9, default 4\n");
+    printf("  -C color    Use this color for matrix (default green)\n");
+    printf("  -M message  Add a message in the center of cmatrix\n");
+    printf("  -t tty      Set tty to use\n");
+}
+
+// Parse command line options
+int options_parse(int argc, char **argv, options_t *opts) {
+    int c;
+    int option_index = 0;
+    static struct option long_options[] = {
+        {"async-scroll", no_argument, 0, 'a'},
+        {"bold", no_argument, 0, 'b'},
+        {"all-bold", no_argument, 0, 'B'},
+        {"force-term", no_argument, 0, 'f'},
+        {"linux", no_argument, 0, 'l'},
+        {"old-style", no_argument, 0, 'o'},
+        {"shadows", no_argument, 0, 'c'},
+        {"lock", no_argument, 0, 'L'},
+        {"help", no_argument, 0, 'h'},
+        {"rainbow", no_argument, 0, 'r'},
+        {"change-chars", no_argument, 0, 'k'},
+        {"no-bold", no_argument, 0, 'n'},
+        {"screensaver", no_argument, 0, 's'},
+        {"lambda", no_argument, 0, 'm'},
+        {"x-mode", no_argument, 0, 'x'},
+        {"version", no_argument, 0, 'V'},
+        {"update", required_argument, 0, 'u'},
+        {"color", required_argument, 0, 'C'},
+        {"message", required_argument, 0, 'M'},
+        {"tty", required_argument, 0, 't'},
+        {0, 0, 0, 0}
+    };
+
+    opts->async_scroll = 0;
+    opts->bold_chars = 0;
+    opts->all_bold = 0;
+    opts->force_term = 0;
+    opts->linux_mode = 0;
+    opts->old_style = 0;
+    opts->shadow_mode = 0;
+    opts->lock_mode = 0;
+    opts->help = 0;
+    opts->no_bold = 0;
+    opts->screensaver = 0;
+    opts->x_mode = 0;
+    opts->version = 0;
+    opts->rainbow_mode = 0;
+    opts->lambda_mode = 0;
+    opts->change_chars = 0;
+    opts->use_tty = 0;
+    opts->use_message = 0;
+    opts->update_delay = 4;
+    opts->color = NULL;
+    opts->tty = NULL;
+    opts->message = NULL;
+
+    while ((c = getopt_long(argc, argv, "abBflohnsmVxur:kC:M:t:", long_options, &option_index)) != -1) {
+        switch (c) {
+            case 'a': opts->async_scroll = 1; break;
+            case 'b': opts->bold_chars = 1; break;
+            case 'B': opts->all_bold = 1; break;
+            case 'f': opts->force_term = 1; break;
+            case 'l': opts->linux_mode = 1; break;
+            case 'o': opts->old_style = 1; break;
+            case 'c': opts->shadow_mode = 1; break;
+            case 'L': opts->lock_mode = 1; break;
+            case 'h': opts->help = 1; break;
+            case 'r': opts->rainbow_mode = 1; break;
+            case 'k': opts->change_chars = 1; break;
+            case 'n': opts->no_bold = 1; break;
+            case 's': opts->screensaver = 1; break;
+            case 'm': opts->lambda_mode = 1; break;
+            case 'x': opts->x_mode = 1; break;
+            case 'V': opts->version = 1; break;
+            case 'u': 
+                opts->update_delay = atoi(optarg);
+                if (opts->update_delay < 0 || opts->update_delay > 9) {
+                    opts->update_delay = 4;
+                }
+                break;
+            case 'C': 
+                opts->color = strdup(optarg);
+                break;
+            case 'M': 
+                opts->message = strdup(optarg);
+                break;
+            case 't': 
+                opts->tty = strdup(optarg);
+                opts->use_tty = 1;
+                break;
+            default:
+                return -1;
+        }
+    }
+
+    return 0;
+}
+
+// Validate options
+int options_validate(const options_t *opts) {
+    if (opts->update_delay < 0 || opts->update_delay > 9) {
+        return -1;
+    }
+    return 0;
+}
