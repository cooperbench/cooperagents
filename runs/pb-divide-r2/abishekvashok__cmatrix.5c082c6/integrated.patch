+#ifndef OPTIONS_H
+#define OPTIONS_H
+
+#include <stdbool.h>
+
+// Option flags
+typedef struct {
+    bool async_scroll;
+    bool bold_chars;
+    bool all_bold;
+    bool force_term;
+    bool linux_mode;
+    bool old_style;
+    bool shadow_mode;
+    bool lock_mode;
+    bool help;
+    bool no_bold;
+    bool screensaver;
+    bool x_mode;
+    bool version;
+    bool rainbow_mode;
+    bool lambda_mode;
+    bool change_chars;
+    bool use_tty;
+    bool use_message;
+    bool quit;
+    
+    int update_delay;
+    char *color;
+    char *tty;
+    char *message;
+} options_t;
+
+// Parse command line options
+int options_parse(int argc, char **argv, options_t *opts);
+
+// Print usage
+void options_print_usage(const char *progname);
+
+// Print version
+void options_print_version(void);
+
+// Validate options
+int options_validate(const options_t *opts);
+
+#endif
