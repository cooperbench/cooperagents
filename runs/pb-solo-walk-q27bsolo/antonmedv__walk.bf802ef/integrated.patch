diff --git a/main.go b/main.go
new file mode 100644
index 0000000..6d3ad78
--- /dev/null
+++ b/main.go
@@ -0,0 +1,151 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"sort"
+
+	"github.com/gdamore/tcell/v2"
+)
+
+// version is the program version, printed by -v / --version.
+const version = "v1.13.0"
+
+// helpText is the exact text printed by -h / --help.
+const helpText = `
+  walk v1.13.0
+
+  Usage: walk [path]
+
+    arrows, hjkl  Move cursor
+    enter         Enter directory
+    backspace     Exit directory
+    space         Toggle preview
+    esc, q        Exit with cd
+    ctrl+c        Exit without cd
+    /             Fuzzy search
+    d, delete     Delete file or dir
+    y             Copy to clipboard
+    .             Hide hidden files
+    ?             Show help
+
+  Flags:
+
+    --icons        display icons
+    --dir-only     show dirs only
+    --hide-hidden  hide hidden files
+    --preview      display preview
+    --with-border  preview with border
+    --fuzzy        fuzzy mode
+
+`
+
+// options holds the parsed command-line flags.
+type options struct {
+	path        string
+	showIcons   bool
+	dirsOnly    bool
+	hideHidden  bool
+	showPreview bool
+	bordered    bool
+	fuzzy       bool
+}
+
+// parseArgs performs a single left-to-right scan of the arguments.
+//
+// The long flags --version and --help are recognised in any position; the
+// short forms -v and -h are recognised only when they are the first
+// argument. The first trigger wins: an earlier --version yields the version
+// action, an earlier --help yields the help action. Remaining flags are
+// collected into opts and a nil action is returned so the caller proceeds to
+// open the terminal.
+func parseArgs(args []string) (action func(), opts *options) {
+	opts = &options{}
+	for i, arg := range args {
+		switch {
+		case arg == "--version" || (i == 0 && arg == "-v"):
+			return func() {
+				fmt.Println(version)
+			}, opts
+		case arg == "--help" || (i == 0 && arg == "-h"):
+			return func() {
+				fmt.Fprint(os.Stderr, helpText)
+				os.Exit(1)
+			}, opts
+		case arg == "--icons":
+			opts.showIcons = true
+		case arg == "--dir-only":
+			opts.dirsOnly = true
+		case arg == "--hide-hidden":
+			opts.hideHidden = true
+		case arg == "--preview":
+			opts.showPreview = true
+		case arg == "--with-border":
+			opts.bordered = true
+		case arg == "--fuzzy":
+			opts.fuzzy = true
+		case arg == "--":
+			continue
+		default:
+			if opts.path == "" {
+				opts.path = arg
+			}
+		}
+	}
+	return nil, opts
+}
+
+func main() {
+	action, opts := parseArgs(os.Args[1:])
+	if action != nil {
+		action()
+		return
+	}
+
+	f, err := os.Open("/dev/tty")
+	if err != nil {
+		panic(fmt.Errorf("could not open a new TTY: %v", err))
+	}
+	defer f.Close()
+
+	if opts.path == "" {
+		opts.path = "."
+	}
+
+	screen, err := tcell.NewScreen()
+	if err != nil {
+		panic(fmt.Errorf("could not create a new TTY: %v", err))
+	}
+
+	if err := screen.Init(); err != nil {
+		panic(fmt.Errorf("could not initialize a new TTY: %v", err))
+	}
+	defer screen.Fini()
+
+	screen.Clear()
+	screen.SetStyle(tcell.StyleDefault)
+	for y, e := range listEntries(opts) {
+		screen.PutStr(0, y, e)
+	}
+	screen.Show()
+
+}
+
+func listEntries(opts *options) []string {
+	entries, err := os.ReadDir(opts.path)
+	if err != nil {
+		return nil
+	}
+	out := make([]string, 0, len(entries))
+	for _, e := range entries {
+		if opts.hideHidden && len(e.Name()) > 0 && e.Name()[0] == '.' {
+			continue
+		}
+		if opts.dirsOnly && !e.IsDir() {
+			continue
+		}
+		out = append(out, e.Name())
+	}
+	sort.Strings(out)
+	return out
+}
