++// clap-v2 "unexpected argument" error (unknown flag or extra positional).
++fn unknown_arg_error(
++    prog: &str,
++    arg: &str,
++    config_present: bool,
++    list_all: bool,
++    output_present: bool,
++    reload: bool,
++    save: bool,
++    to_theme_present: bool,
++) -> String {
++    // The unknown-argument USAGE lists present args in the App's
++    // definition order, but (unlike the missing/duplicate errors) does
++    // NOT always append --to-theme; when nothing is present it falls
++    // back to the generic line.
++    let mut parts: Vec<String> = Vec::new();
++    if config_present {
++        parts.push("--config <file>".to_string());
++    }
++    if list_all {
++        parts.push("--list-all".to_string());
++    }
++    if output_present {
++        parts.push("--output <file>".to_string());
++    }
++    if reload {
++        parts.push("--reload".to_string());
++    }
++    if save {
++        parts.push("--save".to_string());
++    }
++    if to_theme_present {
++        parts.push("--to-theme <file>".to_string());
++    }
++    let usage = if parts.is_empty() {
++        "[FLAGS] [OPTIONS] [theme]".to_string()
++    } else {
++        parts.join(" ")
++    };
++    format!(
++        "error: Found argument '{}' which wasn't expected, or isn't valid in this context\n\n\
++USAGE:\n    {} {}\n\n\
++For more information try --help\n",
++        arg, prog, usage
++    )
++}
++
++// ---------------- Config parsing / apply ----------------
++
++// Apply the theme to the config text.
++fn apply_theme(config: &str, theme: &Theme) -> String {
++    // Split into lines (preserve line content; we re-join with \n).
++    let had_trailing_newline = config.ends_with('\n');
++    let mut lines: Vec<String> = if config.is_empty() {
++        Vec::new()
++    } else {
++        config.lines().map(|l| l.to_string()).collect()
++    };
++
++    // --- Pass 1: brace-depth scan to locate the bar block and its colors block.
++    let mut depth = 0i32;
++    let mut bar_open: Option<usize> = None;
++    let mut bar_base = 0i32;
++    let mut bar_close: Option<usize> = None;
++    let mut colors_open: Option<usize> = None;
++    let mut colors_base = 0i32;
++    let mut colors_close: Option<usize> = None;
++
++    for (i, line) in lines.iter().enumerate() {
++        let trimmed = line.trim();
++        let is_comment = trimmed.starts_with('#');
++        let code = if is_comment { "" } else { line.as_str() };
++        let opens = code.matches('{').count() as i32;
++        let closes = code.matches('}').count() as i32;
++
++        if bar_open.is_none() && bar_close.is_none() && !is_comment && trimmed.starts_with("bar") {
++            bar_open = Some(i);
++            bar_base = depth;
++        }
++        if colors_open.is_none() && bar_open.is_some() && bar_close.is_none() && !is_comment && trimmed.starts_with("colors") {
++            colors_open = Some(i);
++            colors_base = depth;
++        }
++
++        depth += opens - closes;
++
++        if bar_open.is_some() && bar_close.is_none() && depth <= bar_base {
++            bar_close = Some(i);
++        }
++        if colors_open.is_some() && colors_close.is_none() && depth <= colors_base {
++            colors_close = Some(i);
++        }
++    }
++
++    // --- Theme color strings (use theme values; empty input => no echo).
++    let sep = render_one(&theme.sep, &[]);
++    let bg = render_one(&theme.bg, &[]);
++    let statusline = render_one(&theme.statusline, &[]);
++    let ws_focused = render_multi(&theme.ws_focused, &[], false);
++    let ws_active = render_multi(&theme.ws_active, &[], false);
++    let ws_inactive = render_multi(&theme.ws_inactive, &[], false);
++    let ws_urgent = render_multi(&theme.ws_urgent, &[], false);
++
++    // client lines
++    let client_focused = render_multi(&theme.client_focused, &[], false);
++    let client_focused_inactive = render_multi(&theme.client_focused_inactive, &[], false);
++    let client_unfocused = render_multi(&theme.client_unfocused, &[], false);
++    let client_urgent = render_multi(&theme.client_urgent, &[], false);
++
++    // Directive name -> (theme colors, is_workspace_trailing).
++    // is_workspace_trailing determines whether the ADDED block gets a trailing space.
++    let directive_colors = |name: &str| -> (Vec<String>, bool) {
++        match name {
++            "separator" => (sep.clone().into_iter().collect(), false),
++            "background" => (bg.clone().into_iter().collect(), false),
++            "statusline" => (statusline.clone().into_iter().collect(), false),
++            "focused_workspace" => (ws_focused.clone(), true),
++            "active_workspace" => (ws_active.clone(), true),
++            "inactive_workspace" => (ws_inactive.clone(), true),
++            "urgent_workspace" => (ws_urgent.clone(), true),
++            _ => (Vec::new(), false),
++        }
++    };
++
++    // --- Pass 2: edit colors block in place (EDIT) or build an ADD block.
++    if colors_open.is_some() {
++        // EDIT: replace color values within the existing colors block.
++        let co = colors_open.unwrap();
++        let cc = colors_close.unwrap();
++        for i in (co + 1)..cc {
++            let line = lines[i].clone();
++            let trimmed = line.trim();
++            let directive = trimmed.split_whitespace().next().unwrap_or("");
++            let (colors, _trail) = directive_colors(directive);
++            if colors.is_empty() {
++                continue; // not a known color directive; leave as-is
++            }
++            // Preserve indentation and trailing whitespace.
++            let indent = &line[..line.len() - line.trim_start().len()];
++            let trimmed_line = line.trim();
++            // Detect trailing whitespace on the original line.
++            let mut trimmed_end = trimmed_line.len();
++            // strip trailing whitespace chars
++            while trimmed_end > 0 && line.chars().nth(trimmed_end - 1).map_or(false, |c| c == ' ' || c == '\t') {
++                // not reached because trimmed already excludes it
++            }
++            // Rebuild: indent + directive + space + colors.
++            let mut new = String::new();
++            new.push_str(indent);
++            new.push_str(directive);
++            new.push(' ');
++            new.push_str(&join_colors(&colors, false));
++            lines[i] = new;
++        }
++    } else if bar_open.is_some() {
++        // ADD: build a colors block and insert before the bar's closing brace.
++        let bc = bar_close.unwrap_or(bar_open.unwrap());
++        let sep_v: Vec<String> = sep.clone().into_iter().collect();
++        let bg_v: Vec<String> = bg.clone().into_iter().collect();
++        let sl_v: Vec<String> = statusline.clone().into_iter().collect();
++        let mut added: Vec<String> = Vec::new();
++        added.push("  colors {".to_string());
++        added.push(format!("    separator {}", join_colors(&sep_v, false)));
++        added.push(format!("    background {}", join_colors(&bg_v, false)));
++        added.push(format!("    statusline {}", join_colors(&sl_v, false)));
++        added.push(format!("    focused_workspace {}", join_colors(&ws_focused, true)));
++        added.push(format!("    active_workspace {}", join_colors(&ws_active, true)));
++        added.push(format!("    inactive_workspace {}", join_colors(&ws_inactive, true)));
++        added.push(format!("    urgent_workspace {}", join_colors(&ws_urgent, true)));
++        added.push("  }".to_string());
++        lines.splice(bc..bc, added.into_iter());
++    }
++
++
++    // --- Pass 3: client lines (replace existing, else append at end).
++    // Detect existing client.* lines.
++    let mut last_client_line = None;
++    let mut first_client_line = None;
++    for (i, line) in lines.iter().enumerate() {
++        let trimmed = line.trim();
++        if trimmed.starts_with("client.") {
++            if first_client_line.is_none() {
++                first_client_line = Some(i);
++            }
++            last_client_line = Some(i);
++        }
++    }
++
++    let client_block = vec![
++        format!("client.focused {}", join_colors(&client_focused, false)),
++        format!("client.focused_inactive {}", join_colors(&client_focused_inactive, false)),
++        format!("client.unfocused {}", join_colors(&client_unfocused, false)),
++        format!("client.urgent {}", join_colors(&client_urgent, false)),
++    ];
++
++    if let (Some(fi), Some(li)) = (first_client_line, last_client_line) {
++        // Replace the contiguous block of client lines.
++        for i in (fi..=li).rev() {
++            lines.remove(i);
++        }
++        for i in (0..client_block.len()).rev() {
++            lines.insert(fi, client_block[i].clone());
++        }
++    } else {
++        // Append at the end (before final newline reconstruction).
++        for c in &client_block {
++            lines.push(c.clone());
++        }
++    }
++
++    // --- Reconstruct output.
++    let mut out = String::new();
++    for (i, line) in lines.iter().enumerate() {
++        if i > 0 {
++            out.push('\n');
++        }
++        out.push_str(line);
++    }
++    if had_trailing_newline {
++        out.push('\n');
++    }
++    out
++}
