+// ---------------- Theme data ----------------
+
+// Each color group: name + colors. Client groups have 4 colors.
+// Workspace groups (bar) have 3 colors; a 4th color is derived from input.
+// A color entry of None means "undefined" (echo input / special handling).
+
+#[derive(Clone)]
+struct ColorSet {
+    colors: Vec<Option<String>>,
+}
+
+
+#[derive(Clone)]
+struct Theme {
+    name: String,
+    desc: String,
+    // clients: focused, focused_inactive, unfocused, urgent  (4 colors each)
+    client_focused: ColorSet,
+    client_focused_inactive: ColorSet,
+    client_unfocused: ColorSet,
+    client_urgent: ColorSet,
+    // bar: separator, background, statusline (1 color each)
+    sep: ColorSet,
+    bg: ColorSet,
+    statusline: ColorSet,
+    // bar workspaces: focused, active, inactive, urgent (3 colors each)
+    ws_focused: ColorSet,
+    ws_active: ColorSet,
+    ws_inactive: ColorSet,
+    ws_urgent: ColorSet,
+}
+
+fn cs(c: &[&str]) -> ColorSet {
+    ColorSet { colors: c.iter().map(|s| Some(s.to_string())).collect() }
+}
+fn csones(c: &[&str]) -> ColorSet {
+    ColorSet { colors: c.iter().map(|s| Some(s.to_string())).collect() }
+}
+fn csnone() -> ColorSet {
+    ColorSet { colors: vec![None] }
+}
