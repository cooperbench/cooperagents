+// ---------------- Apply helpers ----------------
+
+// Render a ColorSet into a single color string, or None if undefined.
+fn render_one(cs: &ColorSet, input: &[String]) -> Option<String> {
+    if cs.colors.is_empty() {
+        return None;
+    }
+    // If all are None -> undefined (echo input).
+    if cs.colors.iter().all(|c| c.is_none()) {
+        // echo first input color if present
+        if !input.is_empty() {
+            return Some(input[0].clone());
+        }
+        return None;
+    }
+    // take the first Some
+    for c in &cs.colors {
+        if let Some(s) = c {
+            return Some(s.clone());
+        }
+    }
+    None
+}
+
+// Render a ColorSet into multiple colors (for workspaces/clients).
+// `n` = how many to emit. Returns the colors (theme) plus possibly an input-derived 4th.
+fn render_multi(cs: &ColorSet, input: &[String], present: bool) -> Vec<String> {
+    let mut out = Vec::new();
+    // theme colors
+    for c in &cs.colors {
+        if let Some(s) = c {
+            out.push(s.clone());
+        }
+    }
+    // If the ColorSet is entirely None (undefined), echo input colors.
+    if cs.colors.iter().all(|c| c.is_none()) && !input.is_empty() {
+        out = input.to_vec();
+    }
+    // 4th color from input[2] if present and exactly 3 colors
+    if present && out.len() == 3 {
+        if input.len() >= 3 {
+            out.push(input[2].clone());
+        }
+    }
+    out
+}
+
+fn join_colors(colors: &[String], trailing: bool) -> String {
+    let s: String = colors.iter().map(|c| c.as_str()).collect::<Vec<_>>().join(" ");
+    if trailing {
+        format!("{} ", s)
+    } else {
+        s
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+
+    // Program name = basename of argv[0] (matches clap v2).
+    let prog: String = args
+        .get(0)
+        .map(|s| {
+            std::path::Path::new(s)
+                .file_name()
+                .map(|f| f.to_string_lossy().into_owned())
+                .unwrap_or_else(|| s.clone())
+        })
+        .unwrap_or_else(|| "i3-style".to_string());
+
+    // ---------------- Parse (hand-rolled to match clap v2) ----------------
+    // -h / -V exit immediately as they are encountered.
+    // Unknown flags and a second positional are hard errors (clap).
+    // -c / -o require a value; -t has a default (empty) so missing value = "".
+    let mut list_all = false;
+    let mut reload = false;
+    let mut save = false;
+    // clap-v2: -c / -o have a REQUIRED value; -t has [default: ] (empty).
+    // A value token must not start with '-' (a flag is never a value).
+    let mut config_present = false;
+    let mut config_value: Option<String> = None;
+    let mut output_present = false;
+    let mut output_value: Option<String> = None;
+    let mut to_theme_present = false;
+    let mut to_theme_value = String::new();
+    let mut theme_pos: Option<String> = None;
+    // options present-but-missing-value, in command-line order (last is named).
+    let mut missing_opts: Vec<&str> = Vec::new();
+    // duplicates of -c/-o/-t, in command-line order (last is named).
+    let mut dup_opts: Vec<&str> = Vec::new();
+
+    let mut after_dd = false;
+    let mut i = 1;
+    while i < args.len() {
+        let a = args[i].clone();
+        let next_is_flag = i + 1 < args.len() && args[i + 1].starts_with('-') && args[i + 1] != "-";
+
+        // after "--": everything is a positional (theme)
+        if after_dd {
+            if theme_pos.is_some() {
+                eprint!("{}", unknown_arg_error(&prog, &a, config_present, list_all, output_present, reload, save, to_theme_present));
+                std::process::exit(1);
+            }
+            theme_pos = Some(a);
+            i += 1;
+            continue;
+        }
+
+        // "--" is the end-of-options separator
+        if a == "--" {
+            after_dd = true;
+            i += 1;
+            continue;
+        }
+
+        // long option with equals syntax: --config=V / --output=V / --to-theme=V
+        if let Some(v) = a.strip_prefix("--config=") {
+            if config_present {
+                dup_opts.push("config");
+            } else {
+                config_present = true;
+                config_value = Some(v.to_string());
+            }
+            i += 1;
+            continue;
+        }
+        if let Some(v) = a.strip_prefix("--output=") {
+            if output_present {
+                dup_opts.push("output");
+            } else {
+                output_present = true;
+                output_value = Some(v.to_string());
+            }
+            i += 1;
+            continue;
+        }
+        if let Some(v) = a.strip_prefix("--to-theme=") {
+            if to_theme_present {
+                dup_opts.push("to-theme");
+            } else {
+                to_theme_present = true;
+                to_theme_value = v.to_string();
+            }
+            i += 1;
+            continue;
+        }
+
+        // combined short flags / short option with equals (single dash, len > 2)
+        if a.len() > 2 && a.starts_with("-") && !a.starts_with("--") {
+            let mut j = 1usize;
+            let mut done = false;
+            while j < a.len() && !done {
+                match &a[j..j + 1] {
+                    "h" => {
+                        print!("{}", HELP_TEXT.replace("orig_executable", &prog));
+                        std::process::exit(0);
+                    }
+                    "V" => {
+                        println!("i3-style 1.0");
+                        std::process::exit(0);
+                    }
+                    "l" => { list_all = true; j += 1; }
+                    "r" => { reload = true; j += 1; }
+                    "s" => { save = true; j += 1; }
+                    "c" => {
+                        let rest = &a[j + 1..];
+                        if config_present {
+                            dup_opts.push("config");
+                        } else if let Some(v) = rest.strip_prefix("=") {
+                            config_present = true;
+                            config_value = Some(v.to_string());
+                        } else if !rest.is_empty() {
+                            config_present = true;
+                            config_value = Some(rest.to_string());
+                        } else if next_is_flag || i + 1 >= args.len() {
+                            config_present = true;
+                            missing_opts.push("config");
+                        } else {
+                            i += 1;
+                            config_present = true;
+                            config_value = Some(args[i].clone());
+                        }
+                        done = true;
+                    }
+                    "o" => {
+                        let rest = &a[j + 1..];
+                        if output_present {
+                            dup_opts.push("output");
+                        } else if let Some(v) = rest.strip_prefix("=") {
+                            output_present = true;
+                            output_value = Some(v.to_string());
+                        } else if !rest.is_empty() {
+                            output_present = true;
+                            output_value = Some(rest.to_string());
+                        } else if next_is_flag || i + 1 >= args.len() {
+                            output_present = true;
+                            missing_opts.push("output");
+                        } else {
+                            i += 1;
+                            output_present = true;
+                            output_value = Some(args[i].clone());
+                        }
+                        done = true;
+                    }
+                    "t" => {
+                        let rest = &a[j + 1..];
+                        if to_theme_present {
+                            dup_opts.push("to-theme");
+                        } else {
+                            to_theme_present = true;
+                            if let Some(v) = rest.strip_prefix("=") {
+                                to_theme_value = v.to_string();
+                            } else if !rest.is_empty() {
+                                to_theme_value = rest.to_string();
+                            } else if next_is_flag || i + 1 >= args.len() {
+                                to_theme_value = String::new();
+                            } else {
+                                i += 1;
+                                to_theme_value = args[i].clone();
+                            }
+                        }
+                        done = true;
+                    }
+                    _ => {
+                        eprint!("{}", unknown_arg_error(&prog, &a, config_present, list_all, output_present, reload, save, to_theme_present));
+                        std::process::exit(1);
+                    }
+                }
+            }
+            i += 1;
+            continue;
+        }
+
+        // single short flag / long option / positional
+        match a.as_str() {
+            "-h" | "--help" => {
+                print!("{}", HELP_TEXT.replace("orig_executable", &prog));
+                std::process::exit(0);
+            }
+            "-V" | "--version" => {
+                println!("i3-style 1.0");
+                std::process::exit(0);
+            }
+            "-l" | "--list-all" => list_all = true,
+            "-r" | "--reload" => reload = true,
+            "-s" | "--save" => save = true,
+            "-c" | "--config" => {
+                if config_present {
+                    // duplicate: still consume a non-flag value so it isn't a
+                    // stray positional, but record it as a duplicate only.
+                    if !next_is_flag && i + 1 < args.len() {
+                        i += 1;
+                    }
+                    dup_opts.push("config");
+                } else {
+                    config_present = true;
+                    if next_is_flag || i + 1 >= args.len() {
+                        missing_opts.push("config");
+                    } else {
+                        i += 1;
+                        config_value = Some(args[i].clone());
+                    }
+                }
+            }
+            "-o" | "--output" => {
+                if output_present {
+                    if !next_is_flag && i + 1 < args.len() {
+                        i += 1;
+                    }
+                    dup_opts.push("output");
+                } else {
+                    output_present = true;
+                    if next_is_flag || i + 1 >= args.len() {
+                        missing_opts.push("output");
+                    } else {
+                        i += 1;
+                        output_value = Some(args[i].clone());
+                    }
+                }
+            }
+            "-t" | "--to-theme" => {
+                if to_theme_present {
+                    if !next_is_flag && i + 1 < args.len() {
+                        i += 1;
+                    }
+                    dup_opts.push("to-theme");
+                } else {
+                    to_theme_present = true;
+                    if next_is_flag || i + 1 >= args.len() {
+                        to_theme_value = String::new();
+                    } else {
+                        i += 1;
+                        to_theme_value = args[i].clone();
+                    }
+                }
+            }
+            _ => {
+                if a.starts_with('-') && a != "-" {
+                    eprint!("{}", unknown_arg_error(&prog, &a, config_present, list_all, output_present, reload, save, to_theme_present));
+                    std::process::exit(1);
+                }
+                if theme_pos.is_some() {
+                    eprint!("{}", unknown_arg_error(&prog, &a, config_present, list_all, output_present, reload, save, to_theme_present));
+                    std::process::exit(1);
+                }
+                theme_pos = Some(a);
+            }
+        }
+        i += 1;
+    }
+
+
+    // Build the USAGE line (present args in the App's definition order, then --to-theme).
+    // Shared by the missing-value and duplicate-option errors.
+    let mut parts: Vec<String> = Vec::new();
+    if config_present {
+        parts.push("--config <file>".to_string());
+    }
+    if list_all {
+        parts.push("--list-all".to_string());
+    }
+    if output_present {
+        parts.push("--output <file>".to_string());
+    }
+    if reload {
+        parts.push("--reload".to_string());
+    }
+    if save {
+        parts.push("--save".to_string());
+    }
+    parts.push("--to-theme <file>".to_string());
+    let usage = parts.join(" ");
+
+    // Missing-value error (clap) - names the LAST missing option in command order.
+    if !missing_opts.is_empty() {
+        let named = *missing_opts.last().unwrap();
+        eprint!(
+            "error: The argument '--{} <file>' requires a value but none was supplied\n\n\
+USAGE:\n    {} {}\n\n\
+For more information try --help\n",
+            named, prog, usage
+        );
+        std::process::exit(1);
+    }
+
+    // Duplicate-option error (clap) - names the LAST duplicate in command order.
+    if !dup_opts.is_empty() {
+        let named = *dup_opts.last().unwrap();
+        eprint!(
+            "error: The argument '--{} <file>' was provided more than once, but cannot be used multiple times\n\n\
+USAGE:\n    {} {}\n\n\
+For more information try --help\n",
+            named, prog, usage
+        );
+        std::process::exit(1);
+    }
+
+    // --list-all / -l
+    if list_all {
+        print!("{}", LIST_ALL_TEXT);
+        std::process::exit(0);
+    }
+
+    // No theme and no --to-theme (present) -> usage error (to stdout), exit 1.
+    if theme_pos.is_none() && !to_theme_present {
+        print!("{}", NO_ARGS_TEXT.replace("orig_executable", &prog));
+        std::process::exit(1);
+    }
+
+    // ---------------- Resolve config path ----------------
+    let default_config = {
+        let home = env::var("HOME").unwrap_or_default();
+        PathBuf::from(&home).join(".config/i3/config")
+    };
+    // Non-empty --to-theme wins; otherwise config (-c); otherwise the default.
+    let config_path = if !to_theme_value.is_empty() {
+        PathBuf::from(&to_theme_value)
+    } else if let Some(c) = &config_value {
+        PathBuf::from(c)
+    } else {
+        default_config.clone()
+    };
+    // Whether the config path was supplied explicitly (-c or non-empty -t).
+    let is_explicit = config_value.is_some() || (to_theme_present && !to_theme_value.is_empty());
+
+    // If the config resolves to the default location and it is missing,
+    // the original reports "Could not find i3 config".
+    if !is_explicit && !config_path.exists() {
+        eprintln!("Could not find i3 config");
+        std::process::exit(1);
+    }
+
+    // ---------------- Resolve the theme (only when a positional theme was given) ----------------
+    // The original checks the theme's existence before validating the config, so a bad
+    // theme yields "Could not open theme" regardless of whether i3 is present.
+    let theme: Option<Theme> = match &theme_pos {
+        Some(name) => match find_theme(name) {
+            Some(t) => Some(t),
+            None => {
+                eprintln!(
+                    "Could not open theme: {} - No such file or directory (os error 2)",
+                    name
+                );
+                eprintln!(" Use `i3-style --list-all` to see the available themes.");
+                std::process::exit(1);
+            }
+        },
+        None => None,
+    };
+
+    // ---------------- Validate the config with i3 ----------------
+    let status = Command::new("i3")
+        .args(&["-C", "-c", &config_path.to_string_lossy()])
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(_) => {
+            eprintln!("Could not validate config.");
+            eprintln!("Use `i3 -C -c {}` to see validation errors.", config_path.display());
+            std::process::exit(1);
+        }
+        Err(e) => {
+            eprintln!(
+                "Could not validate config with `i3 -C -c {}` (is i3 in the PATH?) {}",
+                config_path.display(), e
+            );
+            std::process::exit(1);
+        }
+    }
+
+    // ---------------- apply / write / reload ----------------
+    // Read the config (now known to exist / be valid).
+    let config_content = fs::read_to_string(&config_path).unwrap_or_default();
+
+    // A positional theme is required to apply; --to-theme-only has none.
+    let applied = match &theme {
+        Some(t) => apply_theme(&config_content, t),
+        None => config_content.clone(),
+    };
+
+    // Persist the input/output under /tmp/i3-style/<ts>/ only for -o or -s.
+    if save || output_value.is_some() {
+        let ts = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_secs())
+            .unwrap_or(0);
+        let dir = PathBuf::from("/tmp/i3-style").join(format!("{}", ts));
+        let _ = fs::create_dir_all(&dir);
+        let _ = fs::write(dir.join("config-input"), &config_content);
+        let _ = fs::write(dir.join("config-output"), &applied);
+        eprintln!(
+            "saving config at {} to {}/config-input",
+            config_path.display(),
+            dir.display()
+        );
+    }
+
+    if save {
+        let _ = fs::write(&config_path, &applied);
+    }
+    if let Some(o) = &output_value {
+        let _ = fs::write(o, &applied);
+    }
+    // Plain apply (no -o / no -s): print the themed config to stdout.
+    if !save && output_value.is_none() {
+        print!("{}", applied);
+    }
+    if reload {
+        let _ = Command::new("i3-msg")
+            .arg("reload")
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status();
+    }
+}
+
+// clap-v2 "unexpected argument" error (unknown flag or extra positional).
+fn unknown_arg_error(
+    prog: &str,
+    arg: &str,
+    config_present: bool,
+    list_all: bool,
+    output_present: bool,
+    reload: bool,
+    save: bool,
+    to_theme_present: bool,
+) -> String {
+    // The unknown-argument USAGE lists present args in the App's
+    // definition order, but (unlike the missing/duplicate errors) does
+    // NOT always append --to-theme; when nothing is present it falls
+    // back to the generic line.
+    let mut parts: Vec<String> = Vec::new();
+    if config_present {
+        parts.push("--config <file>".to_string());
+    }
+    if list_all {
+        parts.push("--list-all".to_string());
+    }
+    if output_present {
+        parts.push("--output <file>".to_string());
+    }
+    if reload {
+        parts.push("--reload".to_string());
+    }
+    if save {
+        parts.push("--save".to_string());
+    }
+    if to_theme_present {
+        parts.push("--to-theme <file>".to_string());
+    }
+    let usage = if parts.is_empty() {
+        "[FLAGS] [OPTIONS] [theme]".to_string()
+    } else {
+        parts.join(" ")
+    };
+    format!(
+        "error: Found argument '{}' which wasn't expected, or isn't valid in this context\n\n\
+USAGE:\n    {} {}\n\n\
+For more information try --help\n",
+        arg, prog, usage
+    )
+}
+
+// ---------------- Config parsing / apply ----------------
+
+// Apply the theme to the config text.
+fn apply_theme(config: &str, theme: &Theme) -> String {
+    // Split into lines (preserve line content; we re-join with \n).
+    let had_trailing_newline = config.ends_with('\n');
+    let mut lines: Vec<String> = if config.is_empty() {
+        Vec::new()
+    } else {
+        config.lines().map(|l| l.to_string()).collect()
+    };
+
+    // --- Pass 1: brace-depth scan to locate the bar block and its colors block.
+    let mut depth = 0i32;
+    let mut bar_open: Option<usize> = None;
+    let mut bar_base = 0i32;
+    let mut bar_close: Option<usize> = None;
+    let mut colors_open: Option<usize> = None;
+    let mut colors_base = 0i32;
+    let mut colors_close: Option<usize> = None;
+
+    for (i, line) in lines.iter().enumerate() {
+        let trimmed = line.trim();
+        let is_comment = trimmed.starts_with('#');
+        let code = if is_comment { "" } else { line.as_str() };
+        let opens = code.matches('{').count() as i32;
+        let closes = code.matches('}').count() as i32;
+
+        if bar_open.is_none() && bar_close.is_none() && !is_comment && trimmed.starts_with("bar") {
+            bar_open = Some(i);
+            bar_base = depth;
+        }
+        if colors_open.is_none() && bar_open.is_some() && bar_close.is_none() && !is_comment && trimmed.starts_with("colors") {
+            colors_open = Some(i);
+            colors_base = depth;
+        }
+
+        depth += opens - closes;
+
+        if bar_open.is_some() && bar_close.is_none() && depth <= bar_base {
+            bar_close = Some(i);
+        }
+        if colors_open.is_some() && colors_close.is_none() && depth <= colors_base {
+            colors_close = Some(i);
+        }
+    }
+
+    // --- Theme color strings (use theme values; empty input => no echo).
+    let sep = render_one(&theme.sep, &[]);
+    let bg = render_one(&theme.bg, &[]);
+    let statusline = render_one(&theme.statusline, &[]);
+    let ws_focused = render_multi(&theme.ws_focused, &[], false);
+    let ws_active = render_multi(&theme.ws_active, &[], false);
+    let ws_inactive = render_multi(&theme.ws_inactive, &[], false);
+    let ws_urgent = render_multi(&theme.ws_urgent, &[], false);
+
+    // client lines
+    let client_focused = render_multi(&theme.client_focused, &[], false);
+    let client_focused_inactive = render_multi(&theme.client_focused_inactive, &[], false);
+    let client_unfocused = render_multi(&theme.client_unfocused, &[], false);
+    let client_urgent = render_multi(&theme.client_urgent, &[], false);
+
+    // Directive name -> (theme colors, is_workspace_trailing).
+    // is_workspace_trailing determines whether the ADDED block gets a trailing space.
+    let directive_colors = |name: &str| -> (Vec<String>, bool) {
+        match name {
+            "separator" => (sep.clone().into_iter().collect(), false),
+            "background" => (bg.clone().into_iter().collect(), false),
+            "statusline" => (statusline.clone().into_iter().collect(), false),
+            "focused_workspace" => (ws_focused.clone(), true),
+            "active_workspace" => (ws_active.clone(), true),
+            "inactive_workspace" => (ws_inactive.clone(), true),
+            "urgent_workspace" => (ws_urgent.clone(), true),
+            _ => (Vec::new(), false),
+        }
+    };
+
+    // --- Pass 2: edit colors block in place (EDIT) or build an ADD block.
+    if colors_open.is_some() {
+        // EDIT: replace color values within the existing colors block.
+        let co = colors_open.unwrap();
+        let cc = colors_close.unwrap();
+        for i in (co + 1)..cc {
+            let line = lines[i].clone();
+            let trimmed = line.trim();
+            let directive = trimmed.split_whitespace().next().unwrap_or("");
+            let (colors, _trail) = directive_colors(directive);
+            if colors.is_empty() {
+                continue; // not a known color directive; leave as-is
+            }
+            // Preserve indentation and trailing whitespace.
+            let indent = &line[..line.len() - line.trim_start().len()];
+            let trimmed_line = line.trim();
+            // Detect trailing whitespace on the original line.
+            let mut trimmed_end = trimmed_line.len();
+            // strip trailing whitespace chars
+            while trimmed_end > 0 && line.chars().nth(trimmed_end - 1).map_or(false, |c| c == ' ' || c == '\t') {
+                // not reached because trimmed already excludes it
+            }
+            // Rebuild: indent + directive + space + colors.
+            let mut new = String::new();
+            new.push_str(indent);
+            new.push_str(directive);
+            new.push(' ');
+            new.push_str(&join_colors(&colors, false));
+            lines[i] = new;
+        }
+    } else if bar_open.is_some() {
+        // ADD: build a colors block and insert before the bar's closing brace.
+        let bc = bar_close.unwrap_or(bar_open.unwrap());
+        let sep_v: Vec<String> = sep.clone().into_iter().collect();
+        let bg_v: Vec<String> = bg.clone().into_iter().collect();
+        let sl_v: Vec<String> = statusline.clone().into_iter().collect();
+        let mut added: Vec<String> = Vec::new();
+        added.push("  colors {".to_string());
+        added.push(format!("    separator {}", join_colors(&sep_v, false)));
+        added.push(format!("    background {}", join_colors(&bg_v, false)));
+        added.push(format!("    statusline {}", join_colors(&sl_v, false)));
+        added.push(format!("    focused_workspace {}", join_colors(&ws_focused, true)));
+        added.push(format!("    active_workspace {}", join_colors(&ws_active, true)));
+        added.push(format!("    inactive_workspace {}", join_colors(&ws_inactive, true)));
+        added.push(format!("    urgent_workspace {}", join_colors(&ws_urgent, true)));
+        added.push("  }".to_string());
+        lines.splice(bc..bc, added.into_iter());
+    }
+
+
+    // --- Pass 3: client lines (replace existing, else append at end).
+    // Detect existing client.* lines.
+    let mut last_client_line = None;
+    let mut first_client_line = None;
+    for (i, line) in lines.iter().enumerate() {
+        let trimmed = line.trim();
+        if trimmed.starts_with("client.") {
+            if first_client_line.is_none() {
+                first_client_line = Some(i);
+            }
+            last_client_line = Some(i);
+        }
+    }
+
+    let client_block = vec![
+        format!("client.focused {}", join_colors(&client_focused, false)),
+        format!("client.focused_inactive {}", join_colors(&client_focused_inactive, false)),
+        format!("client.unfocused {}", join_colors(&client_unfocused, false)),
+        format!("client.urgent {}", join_colors(&client_urgent, false)),
+    ];
+
+    if let (Some(fi), Some(li)) = (first_client_line, last_client_line) {
+        // Replace the contiguous block of client lines.
+        for i in (fi..=li).rev() {
+            lines.remove(i);
+        }
+        for i in (0..client_block.len()).rev() {
+            lines.insert(fi, client_block[i].clone());
+        }
+    } else {
+        // Append at the end (before final newline reconstruction).
+        for c in &client_block {
+            lines.push(c.clone());
+        }
+    }
+
+    // --- Reconstruct output.
+    let mut out = String::new();
+    for (i, line) in lines.iter().enumerate() {
+        if i > 0 {
+            out.push('\n');
+        }
+        out.push_str(line);
+    }
+    if had_trailing_newline {
+        out.push('\n');
+    }
+    out
+}
