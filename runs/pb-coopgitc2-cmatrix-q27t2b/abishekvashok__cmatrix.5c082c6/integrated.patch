+#!/bin/bash
+set -e
+cd "$(dirname "$0")"
+
+CC=${CC:-gcc}
+CFLAGS=${CFLAGS:--O2 -Wall}
+
+# Resolve ncurses compile/link flags from pkg-config when available,
+# falling back to plain -lncurses.
+if pkg-config --exists ncurses 2>/dev/null; then
+    NC_FLAGS=$(pkg-config --cflags ncurses)
+    NC_LIBS=$(pkg-config --libs ncurses)
+else
+    NC_FLAGS=""
+    NC_LIBS="-lncurses"
+fi
+
+$CC $CFLAGS $NC_FLAGS -o executable src/matrix.c $NC_LIBS -lm
