+"""Chroma command-line interface"""
+
+import sys
+
+def main():
+    """Main entry point for the chroma CLI"""
+    print("Chroma syntax highlighter")
+    print("Usage: chroma [options] <file>")
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
