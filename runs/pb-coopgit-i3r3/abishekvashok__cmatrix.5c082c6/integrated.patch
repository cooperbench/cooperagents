diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..5f56eac
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,448 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <locale.h>
+#include <math.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <fcntl.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_DELAY 10
+#define MIN_DELAY 0
+
+// Colors
+#define COLOR_GREEN 32
+#define COLOR_RED 31
+#define COLOR_BLUE 34
+#define COLOR_WHITE 37
+#define COLOR_YELLOW 33
+#define COLOR_CYAN 36
+#define COLOR_MAGENTA 35
+#define COLOR_BLACK 30
+
+// Global state
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int shadow_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int japanese_mode = 0;
+static int old_scroll = 0;
+static int lock_mode = 0;
+static int screensaver_mode = 0;
+static int x_mode = 0;
+static int force_term = 0;
+static int tty_set = 0;
+static int message_mode = 0;
+static char message[256] = "";
+static int tty_fd = -1;
+static int delay = DEFAULT_DELAY;
+static char color = 'g';
+static int use_k = 0;
+
+// Matrix characters
+static const char *matrix_chars = "01";
+static const char *katakana = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static const char *katakana2 = "ン";
+static const char *katakana3 = "ァアィイゥウェエォオカガサザタダナバパニヒビピウゥクグツズヌズムブヅレヱルヮリヰンヌヘベペポホボホモボヴヴン";
+
+// ANSI escape codes
+static const char *RESET = "\033[0m";
+static const char *BOLD = "\033[1m";
+static const char *FAINT = "\033[2m";
+static const char *RED = "\033[31m";
+static const char *GREEN = "\033[32m";
+static const char *YELLOW = "\033[33m";
+static const char *BLUE = "\033[34m";
+static const char *MAGENTA = "\033[35m";
+static const char *CYAN = "\033[36m";
+static const char *WHITE = "\033[37m";
+static const char *BLACK = "\033[30m";
+
+// Get current time in milliseconds
+static long get_time_ms(void) {
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    return tv.tv_sec * 1000 + tv.tv_usec / 1000;
+}
+
+// Get random character based on mode
+static char get_char(int mode) {
+    if (mode == 6) {
+        return 'λ';
+    } else if (mode == 7) {
+        return katakana[rand() % (strlen(katakana) + strlen(katakana2) + strlen(katakana3))];
+    } else {
+        return matrix_chars[rand() % strlen(matrix_chars)];
+    }
+}
+
+// Print usage
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+// Print version
+static void print_version(void) {
+    time_t now = time(NULL);
+    struct tm *tm_info = localtime(&now);
+    char time_str[20];
+    strftime(time_str, sizeof(time_str), "%H:%M:%S", tm_info);
+    char date_str[20];
+    strftime(date_str, sizeof(date_str), "%b %d %Y", tm_info);
+    printf(" CMatrix version %s (compiled %s, %s)\n", VERSION, time_str, date_str);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+// Get terminal size
+static void get_term_size(int *rows, int *cols) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        *rows = ws.ws_row;
+        *cols = ws.ws_col;
+    } else {
+        *rows = 24;
+        *cols = 80;
+    }
+}
+
+// Clear screen
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+// Set terminal mode
+static int set_term_mode(void) {
+    struct termios oldt, newt;
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return -1;
+    }
+    newt = oldt;
+    newt.c_lflag &= ~(ICANON | ECHO);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) == -1) {
+        return -1;
+    }
+    return 0;
+}
+
+// Restore terminal mode
+static void restore_term_mode(void) {
+    struct termios oldt;
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return;
+    }
+    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
+}
+
+// Open tty
+static int open_tty(const char *tty_path) {
+    int fd = open(tty_path, O_RDWR);
+    if (fd == -1) {
+        fprintf(stderr, "cmatrix: error: '%s' couldn't be opened: %s.\n", tty_path, strerror(errno));
+        return -1;
+    }
+    return fd;
+}
+
+// Get color string
+static char *get_color_string(void) {
+    if (color == 'r') {
+        return GREEN;
+    } else if (color == 'R') {
+        return GREEN;
+    } else if (color == 'b') {
+        return BLUE;
+    } else if (color == 'B') {
+        return BLUE;
+    } else if (color == 'y') {
+        return YELLOW;
+    } else if (color == 'Y') {
+        return YELLOW;
+    } else if (color == 'c') {
+        return CYAN;
+    } else if (color == 'C') {
+        return CYAN;
+    } else if (color == 'm') {
+        return MAGENTA;
+    } else if (color == 'M') {
+        return MAGENTA;
+    } else if (color == 'w') {
+        return WHITE;
+    } else if (color == 'W') {
+        return WHITE;
+    } else if (color == 'k') {
+        return BLACK;
+    } else if (color == 'K') {
+        return BLACK;
+    } else {
+        return GREEN;
+    }
+}
+
+// Print a line
+static void print_line(int row, int col, char *text) {
+    printf("\033[%d;%dH", row, col);
+    printf("%s%s%s", get_color_string(), text, RESET);
+}
+
+// Print matrix
+static void print_matrix(int rows, int cols) {
+    for (int i = 0; i < rows; i++) {
+        for (int j = 0; j < cols; j++) {
+            char c = get_char(0);
+            print_line(i + 1, j + 1, &c);
+        }
+    }
+}
+
+// Print message
+static void print_message(int rows, int cols) {
+    int msg_row = rows / 2;
+    int msg_col = cols / 2;
+    printf("\033[%d;%dH", msg_row, msg_col);
+    printf("%s%s%s", BOLD, message, RESET);
+}
+
+// Main function
+int main(int argc, char *argv[]) {
+    setlocale(LC_ALL, "");
+    
+    // Parse command line arguments
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            return 0;
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            return 0;
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            japanese_mode = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            // Linux mode - would set matrix.fnt font
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            use_k = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                delay = atoi(argv[++i]);
+                if (delay < MIN_DELAY) delay = MIN_DELAY;
+                if (delay > MAX_DELAY) delay = MAX_DELAY;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = argv[++i][0];
+                if (strcmp(argv[i], "green") == 0 || strcmp(argv[i], "GREEN") == 0) {
+                    color = 'g';
+                } else if (strcmp(argv[i], "red") == 0 || strcmp(argv[i], "RED") == 0) {
+                    color = 'r';
+                } else if (strcmp(argv[i], "blue") == 0 || strcmp(argv[i], "BLUE") == 0) {
+                    color = 'b';
+                } else if (strcmp(argv[i], "white") == 0 || strcmp(argv[i], "WHITE") == 0) {
+                    color = 'w';
+                } else if (strcmp(argv[i], "yellow") == 0 || strcmp(argv[i], "YELLOW") == 0) {
+                    color = 'y';
+                } else if (strcmp(argv[i], "cyan") == 0 || strcmp(argv[i], "CYAN") == 0) {
+                    color = 'c';
+                } else if (strcmp(argv[i], "magenta") == 0 || strcmp(argv[i], "MAGENTA") == 0) {
+                    color = 'm';
+                } else if (strcmp(argv[i], "black") == 0 || strcmp(argv[i], "BLACK") == 0) {
+                    color = 'k';
+                } else {
+                    printf(" Invalid color selection\n");
+                    printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+                    return 0;
+                }
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                strncpy(message, argv[++i], sizeof(message) - 1);
+                message[sizeof(message) - 1] = '\0';
+                message_mode = 1;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty_fd = open_tty(argv[++i]);
+                if (tty_fd == -1) {
+                    return 1;
+                }
+                tty_set = 1;
+            }
+        } else {
+            // Unknown option - print usage
+            print_usage();
+            return 0;
+        }
+    }
+    
+    // Check for terminal
+    if (!tty_set) {
+        char *term = getenv("TERM");
+        if (term == NULL || strcmp(term, "unknown") == 0) {
+            printf("Error opening terminal: unknown.\n");
+            return 1;
+        }
+    }
+    
+    // Get terminal size
+    int rows, cols;
+    get_term_size(&rows, &cols);
+    
+    // Clear screen
+    clear_screen();
+    
+    // Print message if specified
+    if (message_mode) {
+        print_message(rows, cols);
+    }
+    
+    // Main loop
+    long last_update = get_time_ms();
+    int key_pressed = 0;
+    
+    while (1) {
+        long current_time = get_time_ms();
+        
+        // Update based on delay
+        if (current_time - last_update >= delay * 100) {
+            last_update = current_time;
+            
+            // Print matrix
+            if (old_scroll) {
+                // Old-style scrolling - print new line at top
+                char c = get_char(0);
+                print_line(1, 1, &c);
+                // Clear bottom line
+                printf("\033[%d;%dH", rows, cols);
+                printf("\033[2J");
+            } else {
+                // Normal scrolling - print new line at bottom
+                char c = get_char(0);
+                print_line(rows, cols, &c);
+                // Clear top line
+                printf("\033[1;1H");
+                printf("\033[2J");
+            }
+        }
+        
+        // Check for key press
+        if (screensaver_mode == 0) {
+            fd_set readfds;
+            FD_ZERO(&readfds);
+            FD_SET(STDIN_FILENO, &readfds);
+            
+            struct timeval tv;
+            tv.tv_sec = 0;
+            tv.tv_usec = 100000; // 100ms timeout
+            
+            if (select(STDIN_FILENO + 1, &readfds, NULL, NULL, &tv) > 0) {
+                char buf[10];
+                ssize_t n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+                if (n > 0) {
+                    buf[n] = '\0';
+                    for (int j = 0; j < n; j++) {
+                        char c = buf[j];
+                        if (c == 'q' || c == 'Q') {
+                            break;
+                        } else if (c == 'a' || c == 'A') {
+                            async_scroll = !async_scroll;
+                        } else if (c == 'b' || c == 'B') {
+                            bold_chars = !bold_chars;
+                        } else if (c == 'n' || c == 'N') {
+                            no_bold = 1;
+                            bold_chars = 0;
+                        } else if (c >= '0' && c <= '9') {
+                            delay = c - '0';
+                        } else if (c == '!' || c == '@' || c == '#' || c == '$' || 
+                                   c == '%' || c == '^' || c == '&' || c == ')') {
+                            if (c == '!') color = 'r';
+                            else if (c == '@') color = 'g';
+                            else if (c == '#') color = 'y';
+                            else if (c == '$') color = 'b';
+                            else if (c == '%') color = 'm';
+                            else if (c == '^') color = 'c';
+                            else if (c == '&') color = 'w';
+                            else if (c == ')') color = 'k';
+                        }
+                    }
+                    key_pressed = 1;
+                }
+            }
+        }
+        
+        // Check for lock mode close
+        if (lock_mode && tty_set) {
+            // Check if terminal is closed
+            if (tcgetattr(tty_fd, NULL) == -1) {
+                break;
+            }
+        }
+        
+        // Check for screensaver mode key
+        if (screensaver_mode && key_pressed) {
+            break;
+        }
+    }
+    
+    // Restore terminal mode
+    restore_term_mode();
+    
+    // Close tty if opened
+    if (tty_fd != -1) {
+        close(tty_fd);
+    }
+    
+    return 0;
+}
