+#!/bin/bash
+# CMatrix Build Script
+# This script builds the CMatrix project
+
+set -e
+
+echo "Building CMatrix..."
+
+# Make the Python script executable
+chmod +x cmatrix.py
+
+# Create the executable wrapper script
+cat > executable << 'EXECUTABLE_EOF'
+#!/bin/bash
+# CMatrix Executable
+# This is a wrapper script for the CMatrix Python application
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+exec python3 "$SCRIPT_DIR/cmatrix.py" "$@"
+EXECUTABLE_EOF
+
+chmod +x executable
+
+# Create a symlink or copy for the executable
+if [ -f "cmatrix.py" ]; then
+    echo "cmatrix.py is ready to use"
+    echo "Run with: python3 cmatrix.py [options]"
+fi
+
+echo "Build complete!"
