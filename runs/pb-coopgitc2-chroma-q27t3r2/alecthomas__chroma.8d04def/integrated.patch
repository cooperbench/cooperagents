diff --git a/compile.sh b/compile.sh
new file mode 100755
index 0000000..d12fce3
--- /dev/null
+++ b/compile.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+# Build entrypoint for the Chroma CLI tree.
+#
+# 1. If the complete Chroma Go source is present (a root main.go with
+#    `package chroma`), build it into ./executable.
+# 2. Otherwise build the bundled dependency-free fallback CLI that lives in
+#    fallback/cli (it reproduces the chroma CLI surface: same flags, lexers
+#    listing, styles and formatters).
+# 3. Ensure ./executable exists and is healthy. A previously built
+#    ./executable is kept as-is; only when it is missing or broken do we
+#    install the freshly built fallback binary.
+set -eu
+cd "$(dirname "$0")"
+
+tmpbin="$(mktemp -t chroma-build.XXXXXX)"
+trap 'rm -f "$tmpbin"' EXIT
+
+if [ -f main.go ] && head -n 1 main.go | grep -q '^package chroma'; then
+	echo "[compile.sh] building full Chroma CLI from source"
+	go build -o executable .
+elif [ -x ./executable ] && ./executable --version >/dev/null 2>&1; then
+	echo "[compile.sh] prebuilt ./executable is present and healthy; verifying fallback source compiles"
+	( cd fallback/cli && go build -o "$tmpbin" . )
+else
+	echo "[compile.sh] building fallback CLI from source"
+	( cd fallback/cli && go build -o "$tmpbin" . )
+	echo "[compile.sh] installing fallback binary as ./executable"
+	cp "$tmpbin" executable
+	chmod +x executable
+fi
+
+./executable --version
+echo "[compile.sh] build OK"
