++// ---------- main ----------
++
++func main() {
++	var (
++		showVersion bool
++		list        bool
++		unbuffered  bool
++		trace       bool
++		check       bool
++		fail        bool
++		filename    string
++		lexer       string
++		sty         string
++		formatter   string
++		jsonOut     bool
++		htmlOut     bool
++	)
++	flag.BoolVar(&showVersion, "version", false, "Display version number and exit.")
++	flag.BoolVar(&list, "list", false, "List the lexers, styles and formatters.")
++	flag.BoolVar(&unbuffered, "unbuffered", false, "Do not buffer output.")
++	flag.BoolVar(&trace, "trace", false, "Write a trace of execution to stderr.")
++	flag.BoolVar(&check, "check", false, "Check input for tokens of type Error.")
++	flag.BoolVar(&fail, "fail", false, "Fail if the given input cannot be lexed.")
++	flag.StringVar(&filename, "filename", "", "A string containing a single file name, for use with stdin input.")
++	flag.StringVar(&lexer, "lexer", "autodetect", "The lexer to use; can also be a comma separated list.")
++	flag.StringVar(&lexer, "l", "autodetect", "The lexer to use (shorthand).")
++	flag.StringVar(&sty, "style", "swapoff", "The style to use.")
++	flag.StringVar(&sty, "s", "swapoff", "The style to use (shorthand).")
++	flag.StringVar(&formatter, "formatter", "terminal", "The formatter to use.")
++	flag.StringVar(&formatter, "f", "terminal", "The formatter to use (shorthand).")
++	flag.BoolVar(&jsonOut, "json", false, "Output JSON.")
++	flag.BoolVar(&htmlOut, "html", false, "Output HTML.")
++	flag.Parse()
++
++	if showVersion {
++		fmt.Printf("%s\n", version)
++		return
++	}
++	if list {
++		printList()
++		return
++	}
++	if jsonOut {
++		formatter = "json"
++	}
++	if htmlOut {
++		formatter = "html"
++	}
++
++	// read input
++	var src string
++	if flag.NArg() > 0 {
++		p := flag.Arg(0)
++		b, err := os.ReadFile(p)
++		if err != nil {
++			prog := filepath.Base(os.Args[0])
++			fmt.Fprintf(os.Stderr, "%s: error: %s\n", prog, err)
++			os.Exit(1)
++		}
++		src = string(b)
++		if filename == "" {
++			filename = p
++		}
++	} else {
++		b, err := readAllStdin()
++		if err != nil {
++			fmt.Fprintf(os.Stderr, "chroma: reading stdin: %v\n", err)
++			os.Exit(1)
++		}
++		src = string(b)
++	}
++
++	lexerName, specific := pickLexer(lexer, filename)
++	if trace {
++		fmt.Fprintf(os.Stderr, "chroma: lexer=%s specific=%v style=%s formatter=%s\n", lexerName, specific, sty, formatter)
++	}
++	if fail && !specific {
++		os.Exit(1)
++	}
++
++	fam := lexerFam(lexerName, extOf(filename))
++	toks := tokenize(src, fam)
++
++	switch {
++	case strings.HasPrefix(formatter, "terminal"):
++		writeTerminal(toks, sty)
++	case formatter == "html":
++		writeHTML(toks, sty)
++	case formatter == "json":
++		writeJSON(toks)
++	case formatter == "tokens":
++		writeTokens(toks)
++	case formatter == "noop":
++		io_write(src)
++	case formatter == "svg":
++		io_write(src) // minimal fallback: emit plain text
++	default:
++		fmt.Fprintf(os.Stderr, "chroma: unknown formatter %q\n", formatter)
++		os.Exit(1)
++	}
++	if check {
++		for _, t := range toks {
++			if t.Type == tError {
++				fmt.Fprintf(os.Stderr, "chroma: error token found: %q\n", t.Value)
++				os.Exit(1)
++			}
++		}
++	}
++}
++
++func readAllStdin() (string, error) {
++	b := make([]byte, 0, 64*1024)
++	buf := make([]byte, 32*1024)
++	for {
++		n, err := os.Stdin.Read(buf)
++		if n > 0 {
++			b = append(b, buf[:n]...)
++		}
++		if err != nil {
++			break
++		}
++	}
++	return string(b), nil
++}
++
++func io_write(s string) {
++	fmt.Fprint(os.Stdout, s)
++}
++
++func writeTerminal(toks []Token, styName string) {
++	st := styleTable[styName]
++	if st.m == nil {
++		// Unknown style: the upstream CLI tries to open the name as an XML
++		// file; we mimic that failure mode so behaviour stays predictable.
++		if _, err := os.Open(styName); err != nil {
++			fmt.Fprintf(os.Stderr, "chroma: open %s: no such file or directory\n", styName)
++			os.Exit(1)
++		}
++		st = styleTable["monokai"]
++	}
++	out := bufio.NewWriter(os.Stdout)
++	for _, t := range toks {
++		if c, ok := st.m[t.Type]; ok {
++			out.WriteString("\x1b[" + c + "m" + t.Value + "\x1b[0m")
++		} else {
++			out.WriteString(t.Value)
++		}
++	}
++	out.Flush()
++}
++
++func writeHTML(toks []Token, styName string) {
++	st := styleTable[styName]
++	var b strings.Builder
++	b.WriteString(`<div class="highlight"><pre>`)
++	for _, t := range toks {
++		if t.Value == "" {
++			continue
++		}
++		if c, ok := st.m[t.Type]; ok && c != "" {
++			_ = c // classes used below
++		}
++		if cls, ok := htmlClass[t.Type]; ok && cls != "" {
++			b.WriteString(`<span class="` + cls + `">` + escapeHTML(t.Value) + `</span>`)
++		} else {
++			b.WriteString(escapeHTML(t.Value))
++		}
++	}
++	b.WriteString("</pre></div>\n")
++	fmt.Fprint(os.Stdout, b.String())
++}
++
++func writeJSON(toks []Token) {
++	marshal, err := json.Marshal(toks)
++	if err != nil {
++		fmt.Fprintf(os.Stderr, "chroma: %v\n", err)
++		os.Exit(1)
++	}
++	fmt.Fprintln(os.Stdout, string(marshal))
++}
++
++func writeTokens(toks []Token) {
++	for _, t := range toks {
++		fmt.Fprintf(os.Stdout, "%s: %s\n", t.Type, strconv.Quote(t.Value))
++	}
++}
++
++func printList() {
++	fmt.Println("lexers:")
++	names := make([]string, 0, len(lexersTable))
++	byName := map[string]LexerInfo{}
++	for _, l := range lexersTable {
++		names = append(names, l.Name)
++		byName[l.Name] = l
++	}
++	sort.Strings(names)
++	for _, n := range names {
++		l := byName[n]
++		fmt.Printf("  %s\n", l.Name)
++		if len(l.Aliases) > 0 {
++			fmt.Printf("    aliases: %s\n", strings.Join(l.Aliases, " "))
++		}
++		if len(l.FileNames) > 0 {
++			fmt.Printf("    filenames: %s\n", strings.Join(l.FileNames, " "))
++		}
++		if len(l.MimeTypes) > 0 {
++			fmt.Printf("    mimetypes: %s\n", strings.Join(l.MimeTypes, " "))
++		}
++	}
++	fmt.Printf("styles: %s\n", strings.Join(styleNames, " "))
++	fmt.Printf("formatters: %s\n", strings.Join(formatterNames, " "))
++}
