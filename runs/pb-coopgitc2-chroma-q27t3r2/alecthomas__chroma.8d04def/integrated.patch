+// Command chroma is a minimal, dependency-free stand-in for the Chroma
+// syntax-highlighting CLI.
+//
+// It is NOT the full Chroma library: it exists as a build fallback so that
+// "make" / "compile.sh" always produce a working chroma executable even when
+// neither the complete Chroma source tree (cmd/chroma + go.mod) nor the
+// prebuilt CLI artifact ("executable") is present in the repository.
+//
+// Supported behaviour (subset of the real CLI):
+//   - reads a file argument or stdin and writes highlighted output
+//   - --filename/-f? no: -f is formatter. Flags: --version --list --lexer
+//     --style --formatter --json --html --check --fail --trace
+//   - lexer auto-detection by file extension using the table extracted from
+//     the real Chroma CLI (lexersTable), with --fail to exit 1 when only the
+//     plaintext lexer matches
+//   - formatters: terminal* (ANSI), html, json, tokens, noop, svg (plain text)
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+var version = "0.0.0-fallback"
+
+type LexerInfo struct {
+	Name      string
+	Aliases   []string
+	FileNames []string
+	MimeTypes []string
+}
+
+type Token struct {
+	Type  string
+	Value string
+}
+
+// ---------- token types ----------
+
+const (
+	tText         = "Text"
+	tWhitespace   = "TextWhitespace"
+	tKeyword      = "Keyword"
+	tKeywordType  = "KeywordType"
+	tKeywordDecl  = "KeywordDeclaration"
+	tComment      = "CommentSingle"
+	tCommentMulti = "CommentMultiline"
+	tString       = "LiteralString"
+	tStringDouble = "LiteralStringDouble"
+	tStringSingle = "LiteralStringSingle"
+	tNumber       = "LiteralNumber"
+	tName         = "Name"
+	tNameFunc     = "NameFunction"
+	tNameBuiltin  = "NameBuiltin"
+	tOperator     = "Operator"
+	tPunct        = "Punctuation"
+	tPreproc      = "CommentPreproc"
+	tError        = "Error"
+)
+
+// ---------- tokenizer ----------
+
+var (
+	identRe  = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*`)
+	numberRe = regexp.MustCompile(`^[0-9][0-9a-fA-FxXbBoO_.']*(?:[eE][+-]?[0-9]+)?[a-zA-Z]*`)
+	dstrRe   = regexp.MustCompile(`^"(\\.|[^"\\\n])*"`)
+	sstrRe   = regexp.MustCompile(`^'(\\.|[^'\\\n])*'`)
+	slashcom = regexp.MustCompile(`^//`)
+	cblock   = regexp.MustCompile(`^/\*`)
+)
+
+var cFamilyKw = map[string]bool{
+	"auto": true, "break": true, "case": true, "catch": true, "class": true,
+	"const": true, "continue": true, "default": true, "delete": true, "do": true,
+	"else": true, "enum": true, "export": true, "for": true, "goto": true,
+	"if": true, "import": true, "in": true, "instanceof": true, "new": true,
+	"operator": true, "public": true, "private": true, "protected": true,
+	"return": true, "sizeof": true, "static": true, "struct": true, "switch": true,
+	"template": true, "this": true, "throw": true, "try": true, "typedef": true,
+	"union": true, "using": true, "while": true, "namespace": true, "include": true,
+}
+
+var cFamilyType = map[string]bool{
+	"bool": true, "char": true, "double": true, "float": true, "int": true,
+	"long": true, "short": true, "unsigned": true, "signed": true, "void": true,
+	"string": true, "size_t": true, "uint8_t": true, "uint32_t": true,
+	"uint64_t": true, "int8_t": true, "int32_t": true, "int64_t": true,
+	"const": true, "static": true,
+}
+
+var scriptKw = map[string]bool{
+	"and": true, "as": true, "assert": true, "async": true, "await": true,
+	"break": true, "class": true, "def": true, "del": true, "elif": true,
+	"else": true, "except": true, "finally": true, "for": true, "from": true,
+	"global": true, "if": true, "import": true, "is": true, "lambda": true,
+	"nonlocal": true, "not": true, "or": true, "pass": true, "print": false,
+	"raise": true, "return": true, "try": true, "with": true, "yield": true,
+	"fn": true, "match": true, "move": true, "pub": true, "use": true,
+	"let": true, "var": true, "const": true, "function": true, "package": true,
+	"echo": true, "then": true, "do": true, "done": true, "fi": true,
+	"exit": true, "local": true, "case": true, "esac": true, "select": true,
+	"begin": true, "end": true, "module": true, "require": true, "export": true,
+	"super": true, "null": true, "nil": true, "True": true, "False": true,
+	"None": true, "true": true, "false": true, "in": true, "typeof": true,
+}
+
+var builtins = map[string]bool{
+	"println": true, "print": true, "len": true, "range": true, "append": true,
+	"make": true, "new": true, "panic": true, "recover": true, "main": false,
+	"str": true, "int": true, "float": true, "dict": true, "list": true,
+	"set": true, "tuple": true, "open": true, "input": true, "map": true,
+	"filter": true, "sorted": true, "min": true, "max": true, "sum": true,
+	"sys": true, "os": true, "time": true, "math": true, "fmt": true, "fmt.Println": true,
+}
+
+type family int
+
+const (
+	famUnknown family = iota
+	famHash           // # comments
+	famSlash          // // and /* */
+	famDash           // -- comments (Lua, Haskell...)
+	famHtml           // HTML comments: <!-- -->
+	famPreproc        // C # preprocessor
+)
+
+func familyFor(lexerName, ext string) family {
+	switch strings.ToLower(lexerName) {
+	case "python", "ruby", "bash", "shell", "dockerfile", "toml", "yaml", "yml",
+		"ini", "config", "properties", "powershell", "nix", "r", "groovy",
+		"perl", "tcl", "awk", "make", "makefile", "gitconfig", "rst", "restructuredtext",
+		"graphql", "puppet", "coffeescript", "julia", "swift", "zig", "nim",
+		"elixir", "erlang", "haskell", "systemverilog", "matlab",
+		"octave", "vcl":
+		return famHash
+	case "c", "c++", "csharp", "java", "go", "javascript", "typescript",
+		"javascriptreact", "typescriptreact", "php", "rust", "scala", "d",
+		"vala", "solidity", "objective-c", "objective-c++", "kotlin", "cilk-c",
+		"cilk-c++", "pawn", "prolog":
+		return famSlash
+	case "lua", "vhdl", "ada":
+		return famDash
+	case "html", "xml", "svg", "markdown", "vue", "svelte", "twig", "ejs", "haml", "sass", "less":
+		return famHtml
+	}
+	switch ext {
+	case "py", "pyi", "rb", "sh", "bash", "zsh", "fish", "yaml", "yml", "toml", "ini", "ps1", "r":
+		return famHash
+	case "c", "h", "cpp", "cc", "cxx", "hpp", "hh", "cs", "java", "go", "js", "ts",
+		"jsx", "tsx", "php", "rs", "scala", "kt", "kts", "d", "v", "dart", "swift", "zig":
+		return famSlash
+	case "lua":
+		return famDash
+	case "html", "htm", "xml", "svg", "md":
+		return famHtml
+	}
+	return famUnknown
+}
+
+func kwSet(fam family) (map[string]bool, map[string]bool) {
+	switch fam {
+	case famSlash:
+		return cFamilyKw, cFamilyType
+	default:
+		return scriptKw, nil
+	}
+}
+
+func tokenizeLine(line string, fam family, inBlock *int) []Token {
+	kw, kwType := kwSet(fam)
+	var toks []Token
+	rest := line
+	add := func(t string, s string) {
+		if s != "" {
+			toks = append(toks, Token{t, s})
+		}
+	}
+	for len(rest) > 0 {
+		// inside a block comment?
+		if inBlock != nil && *inBlock > 0 {
+			end := strings.Index(rest, "*/")
+			if end < 0 {
+				add(tCommentMulti, rest)
+				rest = ""
+				break
+			}
+			add(tCommentMulti, rest[:end+2])
+			rest = rest[end+2:]
+			*inBlock = 0
+			continue
+		}
+		// comments
+		if fam == famHash || fam == famPreproc || fam == famUnknown {
+			if i := strings.IndexRune(rest, '#'); i >= 0 && (fam != famPreproc || rest == "#"+rest[1:] || i == 0) {
+				// hash comment from '#' onward
+				add(tComment, rest[i:])
+				rest = rest[:i]
+				break
+			}
+		}
+		switch {
+		case fam == famSlash && strings.HasPrefix(rest, "//"):
+			add(tComment, rest)
+			rest = ""
+		case fam == famSlash && cblock.MatchString(rest):
+			end := strings.Index(rest[2:], "*/")
+			if end < 0 {
+				*inBlock = 1
+				add(tCommentMulti, rest)
+				rest = ""
+			} else {
+				add(tCommentMulti, rest[:end+4])
+				rest = rest[end+4:]
+			}
+			if rest == "" {
+			}
+			continue
+		case fam == famDash && strings.HasPrefix(rest, "--") && (len(rest) < 3 || (rest[2] < '0' || rest[2] > '9')):
+			add(tComment, rest)
+			rest = ""
+		case fam == famHtml && strings.HasPrefix(rest, "<!--"):
+			end := strings.Index(rest, "-->")
+			if end < 0 {
+				add(tComment, rest)
+				rest = ""
+			} else {
+				add(tComment, rest[:end+3])
+				rest = rest[end+3:]
+			}
+			continue
+		}
+		// strings
+		if dstrRe.MatchString(rest) {
+			m := dstrRe.FindString(rest)
+			add(tStringDouble, m)
+			rest = rest[len(m):]
+			continue
+		}
+		if sstrRe.MatchString(rest) {
+			m := sstrRe.FindString(rest)
+			add(tStringSingle, m)
+			rest = rest[len(m):]
+			continue
+		}
+		// preprocessor line (C family only)
+		if fam == famPreproc && strings.HasPrefix(rest, "#") {
+			add(tPreproc, rest)
+			rest = ""
+			continue
+		}
+		// numbers
+		if numberRe.MatchString(rest) {
+			m := numberRe.FindString(rest)
+			add(tNumber, m)
+			rest = rest[len(m):]
+			continue
+		}
+		// identifiers / keywords
+		if m := identRe.FindString(rest); m != "" {
+			if kwType != nil && kwType[m] {
+				add(tKeywordType, m)
+			} else if kw[m] {
+				add(tKeyword, m)
+			} else if builtins[m] {
+				add(tNameBuiltin, m)
+			} else {
+				add(tName, m)
+			}
+			rest = rest[len(m):]
+			continue
+		}
+		// punctuation + operators
+		r := rest[0]
+		if r == '(' || r == ')' || r == '[' || r == ']' || r == '{' || r == '}' ||
+			r == ';' || r == ',' || r == '.' || r == ':' || r == '@' || r == '`' ||
+			r == '<' || r == '>' || r == '=' || r == '+' || r == '-' || r == '*' ||
+			r == '/' || r == '%' || r == '&' || r == '|' || r == '^' || r == '!' ||
+			r == '~' || r == '?' {
+			add(tPunct, string(r))
+			rest = rest[1:]
+			continue
+		}
+		if r == ' ' || r == '\t' || r == '\r' {
+			i := 1
+			for i < len(rest) && (rest[i] == ' ' || rest[i] == '\t' || rest[i] == '\r') {
+				i++
+			}
+			add(tWhitespace, rest[:i])
+			rest = rest[i:]
+			continue
+		}
+		add(tText, string(r))
+		rest = rest[1:]
+	}
+	return toks
+}
+
+func tokenize(src string, fam family) []Token {
+	var toks []Token
+	inBlock := 0
+	lines := strings.Split(src, "\n")
+	for i, ln := range lines {
+		toks = append(toks, tokenizeLine(ln, fam, &inBlock)...)
+		if i < len(lines)-1 {
+			toks = append(toks, Token{tText, "\n"})
+		}
+	}
+	return toks
+}
