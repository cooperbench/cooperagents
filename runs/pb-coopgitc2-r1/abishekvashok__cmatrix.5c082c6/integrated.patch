index 0000000..0d78ef3
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,349 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <ncurses.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_COLS 200
+#define MAX_ROWS 100
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int rainbow = 0;
+static int lambda_mode = 0;
+static int chars_change = 0;
+static int screensaver = 0;
+static int lock_mode = 0;
+static int x_mode = 0;
+static int use_japanese = 0;
+static int force_term = 0;
+static int tty_set = 0;
+static int message_mode = 0;
+static char *message = NULL;
+static int update_delay = DEFAULT_DELAY;
+static char *color = NULL;
+
+static const char *usage = "Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n"
+    " -a: Asynchronous scroll\n"
+    " -b: Bold characters on\n"
+    " -B: All bold characters (overrides -b)\n"
+    " -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n"
+    " -f: Force the linux $TERM type to be on\n"
+    " -l: Linux mode (uses matrix console font)\n"
+    " -L: Lock mode (can be closed from another terminal)\n"
+    " -o: Use old-style scrolling\n"
+    " -h: Print usage and exit\n"
+    " -n: No bold characters (overrides -b and -B, default)\n"
+    " -s: \"Screensaver\" mode, exits on first keystroke\n"
+    " -x: X window mode, use if your xterm is using mtx.pcf\n"
+    " -V: Print version information and exit\n"
+    " -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n"
+    " -u delay (0 - 10, default 4): Screen update delay\n"
+    " -C [color]: Use this color for matrix (default green)\n"
+    " -r: rainbow mode\n"
+    " -m: lambda mode\n"
+    " -k: Characters change while scrolling. (Works without -o opt.)\n"
+    " -t [tty]: Set tty to use\n";
+
+static void print_help(void) {
+    printf("%s", usage);
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled 22:13:51, Jun 11 2026)\n", VERSION);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static int parse_args(int argc, char *argv[]) {
+    int i;
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_help();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            chars_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0 && i + 1 < argc) {
+            update_delay = atoi(argv[++i]);
+            if (update_delay < 0 || update_delay > 10) {
+                update_delay = DEFAULT_DELAY;
+            }
+        } else if (strcmp(argv[i], "-C") == 0 && i + 1 < argc) {
+            color = argv[++i];
+        } else if (strcmp(argv[i], "-M") == 0 && i + 1 < argc) {
+            message = argv[++i];
+            message_mode = 1;
+        } else if (strcmp(argv[i], "-t") == 0 && i + 1 < argc) {
+            tty_set = 1;
+        } else {
+            print_help();
+            exit(0);
+        }
+    }
+    return 0;
+}
+
+static char *get_matrix_chars(void) {
+    static char *chars = NULL;
+    static int len = 0;
+    if (len == 0) {
+        const char *katakana = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+        const char *katakana2 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ@#$%^&*()_+-=[]{}|;':,./<>?";
+        len = strlen(katakana) + strlen(katakana2);
+        chars = malloc(len + 1);
+        strcpy(chars, katakana);
+        strcat(chars, katakana2);
+    }
+    return chars;
+}
+
+static int get_random_char(void) {
+    char *chars = get_matrix_chars();
+    return rand() % strlen(chars);
+}
+
+static int get_color(int r, int g, int b) {
+    if (rainbow) {
+        int hue = (time(NULL) / 2) % 360;
+        int r2, g2, b2;
+        if (hue < 60) { r2 = 255; g2 = hue / 6; b2 = 0; }
+        else if (hue < 120) { r2 = 255 - (hue - 60) / 6; g2 = 255; b2 = 0; }
+        else if (hue < 180) { r2 = 0; g2 = 255; b2 = (hue - 120) / 6; }
+        else if (hue < 240) { r2 = 0; g2 = 255 - (hue - 180) / 6; b2 = 255; }
+        else if (hue < 300) { r2 = (hue - 240) / 6; g2 = 0; b2 = 255; }
+        else { r2 = 255; g2 = 0; b2 = 255 - (hue - 300) / 6; }
+        return (r2 * 256 * 256 + g2 * 256 + b2) & 0xFFFFFF;
+    }
+    if (color) {
+        if (strcmp(color, "red") == 0) return 0xFF0000;
+        if (strcmp(color, "green") == 0) return 0x00FF00;
+        if (strcmp(color, "blue") == 0) return 0x0000FF;
+        if (strcmp(color, "white") == 0) return 0xFFFFFF;
+        if (strcmp(color, "yellow") == 0) return 0xFFFF00;
+        if (strcmp(color, "cyan") == 0) return 0x00FFFF;
+        if (strcmp(color, "magenta") == 0) return 0xFF00FF;
+        if (strcmp(color, "black") == 0) return 0x000000;
+    }
+    return 0x00FF00;
+}
+
+static void init_ncurses(void) {
+    initscr();
+    cbreak();
+    noecho();
+    keypad(stdscr, TRUE);
+    curs_set(0);
+    if (linux_mode) {
+        set_term(&stdscr);
+    }
+}
+
+static void cleanup_ncurses(void) {
+    endwin();
+}
+
+static void draw_matrix(int rows, int cols) {
+    int i, j;
+    char *chars = get_matrix_chars();
+    int color_val = get_color(0, 0, 0);
+    
+    for (i = 0; i < rows; i++) {
+        for (j = 0; j < cols; j++) {
+            int char_idx = (i * cols + j) % strlen(chars);
+            int bold = (all_bold || (bold_chars && rand() % 100 < 50));
+            if (no_bold) bold = 0;
+            
+            if (lambda_mode) {
+                mvaddch(i, j, 0x03BB);
+            } else {
+                mvaddch(i, j, chars[char_idx]);
+            }
+            
+            if (bold) {
+                attron(A_BOLD);
+            }
+            if (color_val != 0xFFFFFF) {
+                attron(COLOR_PAIR(1));
+            }
+            mvaddch(i, j, ' ');
+            if (bold) {
+                attroff(A_BOLD);
+            }
+            if (color_val != 0xFFFFFF) {
+                attroff(COLOR_PAIR(1));
+            }
+        }
+    }
+}
+
+static void draw_message(int rows, int cols) {
+    int i, j;
+    char *chars = get_matrix_chars();
+    int color_val = get_color(0, 0, 0);
+    
+    for (i = 0; i < rows; i++) {
+        for (j = 0; j < cols; j++) {
+            int char_idx = (i * cols + j) % strlen(chars);
+            int bold = (all_bold || (bold_chars && rand() % 100 < 50));
+            if (no_bold) bold = 0;
+            
+            if (lambda_mode) {
+                mvaddch(i, j, 0x03BB);
+            } else {
+                mvaddch(i, j, chars[char_idx]);
+            }
+            
+            if (bold) {
+                attron(A_BOLD);
+            }
+            if (color_val != 0xFFFFFF) {
+                attron(COLOR_PAIR(1));
+            }
+            mvaddch(i, j, ' ');
+            if (bold) {
+                attroff(A_BOLD);
+            }
+            if (color_val != 0xFFFFFF) {
+                attroff(COLOR_PAIR(1));
+            }
+        }
+    }
+    
+    int mid_row = rows / 2;
+    int mid_col = cols / 2;
+    int msg_len = strlen(message) + 2;
+    int msg_start = mid_col - msg_len / 2;
+    
+    for (i = 0; i < msg_len; i++) {
+        mvaddstr(mid_row, msg_start + i, message);
+    }
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    if (x_mode) {
+        printf("X window mode not fully implemented\n");
+        return 0;
+    }
+    
+    if (tty_set) {
+        printf("Tty not set\n");
+        return 0;
+    }
+    
+    if (linux_mode) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    if (force_term) {
+        setenv("TERM", "xterm", 1);
+    }
+    
+    if (message_mode) {
+        if (lock_mode) {
+            message = "LOCKED";
+        }
+    } else if (lock_mode) {
+        message = "LOCKED";
+    }
+    
+    init_ncurses();
+    
+    int rows, cols;
+    getmaxyx(stdscr, rows, cols);
+    
+    int i, j;
+    char *chars = get_matrix_chars();
+    int color_val = get_color(0, 0, 0);
+    
+    for (i = 0; i < rows; i++) {
+        for (j = 0; j < cols; j++) {
+            int char_idx = (i * cols + j) % strlen(chars);
+            int bold = (all_bold || (bold_chars && rand() % 100 < 50));
+            if (no_bold) bold = 0;
+            
+            if (lambda_mode) {
+                mvaddch(i, j, 0x03BB);
+            } else {
+                mvaddch(i, j, chars[char_idx]);
+            }
+            
+            if (bold) {
+                attron(A_BOLD);
+            }
+            if (color_val != 0xFFFFFF) {
+                attron(COLOR_PAIR(1));
+            }
+            mvaddch(i, j, ' ');
+            if (bold) {
+                attroff(A_BOLD);
+            }
+            if (color_val != 0xFFFFFF) {
+                attroff(COLOR_PAIR(1));
+            }
+        }
+    }
+    
+    if (message_mode || lock_mode) {
+        int mid_row = rows / 2;
+        int mid_col = cols / 2;
+        int msg_len = strlen(message) + 2;
+        int msg_start = mid_col - msg_len / 2;
+        
+        for (i = 0; i < msg_len; i++) {
+            mvaddstr(mid_row, msg_start + i, message);
+        }
+    }
+    
+    if (screensaver) {
+        int ch;
+        while (1) {
+            ch = getch();
+            if (ch == 'q' || ch == 'Q') {
+                break;
+            }
+        }
+    }
+    
+    cleanup_ncurses();
+    return 0;
+}
