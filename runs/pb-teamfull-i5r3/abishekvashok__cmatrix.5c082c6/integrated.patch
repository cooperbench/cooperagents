+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int only_shadows = 0;
+static int lock_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int char_change = 0;
+static int x_mode = 0;
+static int screensaver_mode = 0;
+static int tty_set = 0;
+static int message_mode = 0;
+static int use_japanese = 0;
+
+static int update_delay = DEFAULT_DELAY;
+static char color[16] = "green";
+static char message[256] = "";
+static char *tty_device = NULL;
+
+static const char *latin_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+static const char *katakana_chars = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static const char *numbers = "0123456789";
+static const char *symbols = "!@#$%^&()";
+
+static const char *color_codes[] = {
+    "\033[32m", "\033[31m", "\033[33m", "\033[34m",
+    "\033[35m", "\033[36m", "\033[37m", "\033[30m"
+};
+
+static char matrix_chars[MAX_COLS][MAX_ROWS];
+static int cols, rows;
+
+static char get_random_char(void) {
+    int r = rand() % 100;
+    if (r < 80) return katakana_chars[rand() % strlen(katakana_chars)];
+    else if (r < 90) return latin_chars[rand() % strlen(latin_chars)];
+    else if (r < 95) return numbers[rand() % strlen(numbers)];
+    else return symbols[rand() % strlen(symbols)];
+}
+
+static char get_char(int x, int y) {
+    if (x < 0 || x >= cols || y < 0 || y >= rows) return ' ';
+    return matrix_chars[x][y];
+}
+
+static void set_char(int x, int y, char c) {
+    if (x >= 0 && x < cols && y >= 0 && y < rows) matrix_chars[x][y] = c;
+}
+
+static const char *get_color_code(void) {
+    if (rainbow_mode) return color_codes[rand() % 8];
+    return color_codes[0];
+}
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s)\n", VERSION, BUILD_TIME);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static void parse_args(int argc, char *argv[]) {
+    int i;
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) async_scroll = 1;
+        else if (strcmp(argv[i], "-b") == 0) bold_chars = 1;
+        else if (strcmp(argv[i], "-B") == 0) all_bold = 1;
+        else if (strcmp(argv[i], "-c") == 0) use_japanese = 1;
+        else if (strcmp(argv[i], "-f") == 0) force_term = 1;
+        else if (strcmp(argv[i], "-l") == 0) linux_mode = 1;
+        else if (strcmp(argv[i], "-L") == 0) lock_mode = 1;
+        else if (strcmp(argv[i], "-o") == 0) old_style = 1;
+        else if (strcmp(argv[i], "-n") == 0) no_bold = 1;
+        else if (strcmp(argv[i], "-s") == 0) screensaver_mode = 1;
+        else if (strcmp(argv[i], "-x") == 0) x_mode = 1;
+        else if (strcmp(argv[i], "-r") == 0) rainbow_mode = 1;
+        else if (strcmp(argv[i], "-m") == 0) lambda_mode = 1;
+        else if (strcmp(argv[i], "-k") == 0) char_change = 1;
+        else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                update_delay = atoi(argv[++i]);
+                if (update_delay < 0) update_delay = 0;
+                if (update_delay > 10) update_delay = 10;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) strncpy(color, argv[++i], sizeof(color) - 1);
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                strncpy(message, argv[++i], sizeof(message) - 1);
+                message_mode = 1;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty_device = argv[++i];
+                tty_set = 1;
+            }
+        } else {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            print_usage();
+            exit(1);
+        }
+    }
+}
