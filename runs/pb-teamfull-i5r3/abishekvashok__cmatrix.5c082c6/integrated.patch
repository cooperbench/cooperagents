+static void init_terminal(void) {
+    struct termios oldt, newt;
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) return;
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
+}
+
+static void restore_terminal(struct termios *oldt) {
+    if (oldt) tcsetattr(STDIN_FILENO, TCSANOW, oldt);
+}
+
+static void get_terminal_size(int *width, int *height) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == -1) {
+        *width = 80; *height = 24;
+    } else {
+        *width = ws.ws_col; *height = ws.ws_row;
+    }
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+}
+
+static void print_message(void) {
+    if (strlen(message) > 0) {
+        printf("\033[1;37m%s\033[0m\n", message);
+    }
+}
+
+static void draw_matrix(void) {
+    int x, y;
+    for (y = 0; y < rows; y++) {
+        for (x = 0; x < cols; x++) {
+            char c = get_char(x, y);
+            if (c != ' ') {
+                printf("%c", c);
+            }
+        }
+    }
+}
+
+static void update_matrix(void) {
+    int x, y;
+    for (x = 0; x < cols; x++) {
+        if (get_char(x, 0) == ' ') {
+            set_char(x, 0, get_random_char());
+        }
+        for (y = 1; y < rows; y++) {
+            if (get_char(x, y) == ' ') {
+                set_char(x, y, get_char(x, y - 1));
+            }
+        }
+    }
+}
+
+static void draw_shadow(void) {
