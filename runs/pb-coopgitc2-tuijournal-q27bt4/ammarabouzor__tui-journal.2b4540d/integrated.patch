index 0000000..ebd0771
--- /dev/null
+++ b/tui_journal.rs
@@ -0,0 +1,768 @@
+// Reimplementation of the `tui-journal` 0.16.1 CLI observable behavior.
+// Pure standard library, no external crates (offline build).
+
+use std::env;
+use std::fs;
+use std::path::Path;
+use std::process;
+
+// ---------- helpers ----------
+
+fn prog_name(args: &[String]) -> String {
+    match args.first() {
+        Some(a) => {
+            let p = Path::new(a);
+            match p.file_name() {
+                Some(f) => f.to_string_lossy().into_owned(),
+                None => a.clone(),
+            }
+        }
+        None => "executable".to_string(),
+    }
+}
+
+fn home() -> String {
+    env::var("HOME").unwrap_or_else(|_| "/home/agent".to_string())
+}
+
+fn join(base: &str, name: &str) -> String {
+    format!("{}/{}", base.trim_end_matches('/'), name)
+}
+
+// ---------- clap-style error (exit 2) ----------
+
+// Print a clap-style error to stderr and exit with code 2.
+// When `usage` is empty, the "Usage:" line is omitted (as clap does for
+// argument-validation errors like an invalid value).
+fn clap_error(msg: String, usage: &str) -> ! {
+    eprint!("{}\n", msg);
+    if !usage.is_empty() {
+        eprint!("\nUsage: {}\n", usage);
+    }
+    eprint!("\nFor more information, try '--help'.\n");
+    process::exit(2);
+}
+
+// ---------- help texts ----------
+
+fn root_help(prog: &str, config_dir: &str, log_file: &str) -> String {
+    format!(
