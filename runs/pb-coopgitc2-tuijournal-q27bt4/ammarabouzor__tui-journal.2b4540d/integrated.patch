++use std::path::PathBuf;
++use serde::{Serialize, Deserialize};
++
++fn config_root() -> PathBuf { dirs::config_dir().unwrap_or_default().join("tui-journal") }
++fn cache_root() -> PathBuf { dirs::cache_dir().unwrap_or_default().join("tui-journal") }
++fn state_root() -> PathBuf { dirs::state_dir().unwrap_or_default().join("tui-journal") }
++fn home_root() -> PathBuf { dirs::home_dir().unwrap_or_default().join("tui-journal") }
++
++pub fn default_config_dir() -> PathBuf { config_root() }
++pub fn default_log_file() -> PathBuf { cache_root().join("tui-journal.log") }
++pub fn default_state_dir() -> PathBuf { state_root() }
++pub fn default_json_path() -> PathBuf { home_root().join("entries.json") }
++pub fn default_sqlite_path() -> PathBuf { home_root().join("entries.db") }
++pub fn themes_path() -> PathBuf { config_root().join("themes.toml") }
++
++// Clap uses lowercase values (json/sqlite) but TOML serializes capitalized (Json/Sqlite).
++#[derive(Debug, Clone, Copy, PartialEq, Eq)]
++pub enum BackendType { Json, Sqlite }
++impl Default for BackendType { fn default() -> Self { BackendType::Sqlite } }
++impl Serialize for BackendType {
++    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
++        let v = match self { BackendType::Json => "Json", BackendType::Sqlite => "Sqlite" };
++        s.serialize_str(v)
++    }
++}
++impl<'de> Deserialize<'de> for BackendType {
++    fn deserialize<D: serde::Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
++        let v = String::deserialize(d)?;
++        match v.as_str() {
++            "Json" | "json" => Ok(BackendType::Json),
++            "Sqlite" | "sqlite" => Ok(BackendType::Sqlite),
++            other => Err(serde::de::Error::unknown_variant(other, &["Json", "Sqlite"])),
++        }
++    }
++}
++
++#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
++#[serde(rename_all = "lowercase")]
++pub enum DatumVisibility { Show, Hide }
++impl Default for DatumVisibility { fn default() -> Self { DatumVisibility::Show } }
++
++#[derive(Debug, Clone, Serialize, Deserialize)]
++pub struct ExportConfig { pub show_confirmation: bool }
++impl Default for ExportConfig { fn default() -> Self { ExportConfig { show_confirmation: true } } }
++
++#[derive(Debug, Clone, Serialize, Deserialize)]
++pub struct ExternalEditorConfig { pub auto_save: bool, pub temp_file_extension: String }
++impl Default for ExternalEditorConfig {
++    fn default() -> Self { ExternalEditorConfig { auto_save: false, temp_file_extension: "txt".into() } }
++}
++
++#[derive(Debug, Clone, Serialize, Deserialize)]
++pub struct BackendConfig { pub file_path: PathBuf }
++
++#[derive(Debug, Clone, Serialize, Deserialize)]
++pub struct Config {
++    pub backend_type: BackendType,
++    pub scroll_per_page: usize,
++    pub sync_os_clipboard: bool,
++    pub history_limit: usize,
++    pub colored_tags: bool,
++    pub datum_visibility: DatumVisibility,
++    pub app_state_dir: PathBuf,
++    pub export: ExportConfig,
++    pub external_editor: ExternalEditorConfig,
++    pub json_backend: BackendConfig,
++    pub sqlite_backend: BackendConfig,
++}
++
++impl Config {
++    pub fn with_defaults() -> Self {
++        Config {
++            backend_type: BackendType::default(),
++            scroll_per_page: 5,
