+// ---------- config ----------
+
+struct Config {
+    backend_type: String,
+    scroll_per_page: String,
+    sync_os_clipboard: String,
+    history_limit: String,
+    colored_tags: String,
+    datum_visibility: String,
+    app_state_dir: String,
+    export_show_confirmation: String,
+    editor_auto_save: String,
+    editor_temp_file_extension: String,
+    json_file_path: String,
+    sqlite_file_path: String,
+}
+
+fn default_config(home: &str) -> Config {
+    Config {
+        backend_type: "Sqlite".to_string(),
+        scroll_per_page: "5".to_string(),
+        sync_os_clipboard: "false".to_string(),
+        history_limit: "10".to_string(),
+        colored_tags: "true".to_string(),
+        datum_visibility: "show".to_string(),
+        app_state_dir: join(home, ".local/state/tui-journal"),
+        export_show_confirmation: "true".to_string(),
+        editor_auto_save: "false".to_string(),
+        editor_temp_file_extension: "txt".to_string(),
+        json_file_path: join(home, "tui-journal/entries.json"),
+        sqlite_file_path: join(home, "tui-journal/entries.db"),
+    }
+}
+
+fn strip_toml(v: &str) -> String {
+    let v = v.trim();
+    if v.starts_with('"') && v.ends_with('"') && v.len() >= 2 {
+        v[1..v.len() - 1].to_string()
+    } else {
+        v.to_string()
+    }
+}
+
+fn set_field(cfg: &mut Config, section: &str, key: &str, val: &str) {
+    match (section, key) {
+        ("", "backend_type") => cfg.backend_type = val.to_string(),
+        ("", "scroll_per_page") => cfg.scroll_per_page = val.to_string(),
+        ("", "sync_os_clipboard") => cfg.sync_os_clipboard = val.to_string(),
+        ("", "history_limit") => cfg.history_limit = val.to_string(),
+        ("", "colored_tags") => cfg.colored_tags = val.to_string(),
+        ("", "datum_visibility") => cfg.datum_visibility = val.to_string(),
+        ("", "app_state_dir") => cfg.app_state_dir = val.to_string(),
+        ("export", "show_confirmation") => cfg.export_show_confirmation = val.to_string(),
+        ("external_editor", "auto_save") => cfg.editor_auto_save = val.to_string(),
+        ("external_editor", "temp_file_extension") => cfg.editor_temp_file_extension = val.to_string(),
+        ("json_backend", "file_path") => cfg.json_file_path = val.to_string(),
+        ("sqlite_backend", "file_path") => cfg.sqlite_file_path = val.to_string(),
+        _ => {}
+    }
+}
+
+// Minimal TOML reader for the specific config structure.
+fn read_toml_file(path: &str, home: &str) -> Option<Config> {
+    let content = match fs::read_to_string(path) {
+        Ok(c) => c,
+        Err(_) => return None,
+    };
+    let mut cfg = default_config(home);
+    let mut section = String::new();
+    for line in content.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') || line.starts_with(';') {
+            continue;
+        }
+        if line.starts_with('[') {
+            section = line
+                .trim_start_matches('[')
+                .trim_end_matches(']')
+                .trim()
+                .to_string();
+            continue;
+        }
+        let mut parts = line.splitn(2, '=');
+        let key = parts.next().map(|s| s.trim().to_string()).unwrap_or_default();
+        let val = parts.next().map(|s| strip_toml(s)).unwrap_or_default();
+        set_field(&mut cfg, &section, &key, &val);
+    }
+    Some(cfg)
+}
+
+// Resolve config given -c (Some) or None (default) plus -j/-s/-b overrides.
+// Returns (config, config_dir). Exits with the "doesn't exit" error if -c
+// is given and that path does not exist.
+fn resolve_config(
+    home: &str,
+    config_arg: Option<&str>,
+    json_override: Option<&str>,
+    sqlite_override: Option<&str>,
+    backend_override: Option<&str>,
+) -> (Config, String) {
+    let (config_dir, config_file) = match config_arg {
+        Some(p) => {
+            if !Path::new(p).exists() {
+                eprint!("Error: Provided custom directory doesn't exit. Path: {}\n", p);
+                process::exit(1);
+            }
+            if p.ends_with("config.toml") || Path::new(p).is_file() {
+                let dir = Path::new(p)
+                    .parent()
+                    .map(|d| d.to_string_lossy().into_owned())
+                    .unwrap_or_else(|| p.to_string());
+                (dir, p.to_string())
+            } else {
+                (p.to_string(), join(p, "config.toml"))
+            }
+        }
+        None => (
+            join(home, ".config/tui-journal"),
+            join(home, ".config/tui-journal/config.toml"),
+        ),
+    };
+
+    let mut cfg = read_toml_file(&config_file, home).unwrap_or_else(|| default_config(home));
+
+    if let Some(j) = json_override {
+        cfg.json_file_path = j.to_string();
+    }
+    if let Some(s) = sqlite_override {
+        cfg.sqlite_file_path = s.to_string();
+    }
+    if let Some(b) = backend_override {
+        cfg.backend_type = match b {
+            "json" => "Json".to_string(),
+            "sqlite" => "Sqlite".to_string(),
+            _ => b.to_string(),
+        };
+    }
+
+    (cfg, config_dir)
+}
+
+fn print_config_output(cfg: &Config) {
+    let mut s = String::new();
+    s.push_str(&format!("backend_type = \"{}\"\n", cfg.backend_type));
+    s.push_str(&format!("scroll_per_page = {}\n", cfg.scroll_per_page));
+    s.push_str(&format!("sync_os_clipboard = {}\n", cfg.sync_os_clipboard));
+    s.push_str(&format!("history_limit = {}\n", cfg.history_limit));
+    s.push_str(&format!("colored_tags = {}\n", cfg.colored_tags));
+    s.push_str(&format!("datum_visibility = \"{}\"\n", cfg.datum_visibility));
+    s.push_str(&format!("app_state_dir = \"{}\"\n\n", cfg.app_state_dir));
+
+    s.push_str("[export]\n");
+    s.push_str(&format!("show_confirmation = {}\n\n", cfg.export_show_confirmation));
+
+    s.push_str("[external_editor]\n");
+    s.push_str(&format!("auto_save = {}\n", cfg.editor_auto_save));
+    s.push_str(&format!(
+        "temp_file_extension = \"{}\"\n\n",
+        cfg.editor_temp_file_extension
+    ));
+
+    s.push_str("[json_backend]\n");
+    s.push_str(&format!("file_path = \"{}\"\n\n", cfg.json_file_path));
+
+    s.push_str("[sqlite_backend]\n");
+    s.push_str(&format!("file_path = \"{}\"\n\n", cfg.sqlite_file_path));
+
+    print!("{}", s);
+}
+
+// ---------- terminal / TUI simulation ----------
+fn try_terminal_or_fail() -> ! {
+    eprintln!("Error: No such device or address (os error 6)");
+    process::exit(1);
+}
+
+// ---------- main ----------
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    let prog = prog_name(&args);
+    let home = home();
+    let default_config_dir = join(&home, ".config/tui-journal");
+    let default_log_file = join(&home, ".cache/tui-journal/tui-journal.log");
+
+    let tail: Vec<String> = args.iter().skip(1).cloned().collect();
+
+    let mut want_version = false;
+    let mut want_help = false;
+    let mut json_path: Option<String> = None;
+    let mut sqlite_path: Option<String> = None;
+    let mut backend_type: Option<String> = None;
+    let mut config_arg: Option<String> = None;
+    let mut _verbose = 0u32;
+    let mut _log: Option<String> = None;
+    let mut command: Option<String> = None;
+
+    let mut i = 0;
+    while i < tail.len() {
+        let a = &tail[i];
+        match a.as_str() {
+            "-h" | "--help" => {
+                want_help = true;
+                break;
+            }
+            "-V" | "--version" => {
+                want_version = true;
+                break;
+            }
+            "-j" | "--json-file-path" => {
+                let v = next_value(&tail, &mut i, a, &format!("{} [OPTIONS] [COMMAND]", &prog));
+                json_path = Some(v);
+            }
+            "-s" | "--sqlite-file-path" => {
+                let v = next_value(&tail, &mut i, a, &format!("{} [OPTIONS] [COMMAND]", &prog));
+                sqlite_path = Some(v);
+            }
+            "-b" | "--backend-type" => {
+                let v = next_value(&tail, &mut i, a, &format!("{} [OPTIONS] [COMMAND]", &prog));
+                if v != "json" && v != "sqlite" {
+                    clap_error(
+                        format!(
+                            "invalid value '{}' for '{} <BACKEND_TYPE>'\n  [possible values: json, sqlite]",
+                            v, a
+                        ),
+                        "",
+                    );
+                }
+                backend_type = Some(v);
+            }
+            "-c" | "--config" => {
+                let v = next_value(&tail, &mut i, a, &format!("{} [OPTIONS] [COMMAND]", &prog));
+                config_arg = Some(v);
+            }
+            "-l" | "--log" => {
+                let v = next_value(&tail, &mut i, a, &format!("{} [OPTIONS] [COMMAND]", &prog));
+                _log = Some(v);
+            }
+            "-v" | "--verbose" => {
+                _verbose += 1;
+            }
+            "print-config" | "pc" => {
+                command = Some("print-config".to_string());
+                i += 1;
+                break;
+            }
+            "import-journals" | "imj" => {
+                command = Some("import-journals".to_string());
+                i += 1;
+                break;
+            }
+            "assign-priority" | "ap" => {
+                command = Some("assign-priority".to_string());
+                i += 1;
+                break;
+            }
+            "theme" | "style" => {
+                command = Some("theme".to_string());
+                i += 1;
+                break;
+            }
+            "help" => {
+                command = Some("help".to_string());
+                i += 1;
+                break;
+            }
+            other => {
+                if other.starts_with('-') && other.len() > 1 {
+                    clap_error(
+                        format!("unexpected argument '{}' found", other),
+                        &format!("{} [OPTIONS] [COMMAND]", &prog),
+                    );
+                } else {
+                    clap_error(
+                        format!("unrecognized subcommand '{}'", other),
+                        &format!("{} [OPTIONS] [COMMAND]", &prog),
+                    );
+                }
+            }
+        }
+        i += 1;
+    }
+
+    if want_version {
+        println!("tui-journal 0.16.1");
+        return;
+    }
+    if want_help {
+        print!("{}", root_help(&prog, &default_config_dir, &default_log_file));
+        return;
+    }
+
+    let cmd_args = if i < tail.len() { tail[i..].to_vec() } else { Vec::new() };
+
+    match command.as_deref() {
+        Some("help") => {
+            let sub = cmd_args.first().map(|s| s.as_str());
+            match sub {
+                Some("print-config") | Some("pc") => print!("{}", help_print_config(&prog)),
+                Some("import-journals") | Some("imj") => print!("{}", help_import_journals(&prog)),
+                Some("assign-priority") | Some("ap") => {
+                    print!("{}", help_assign_priority(&prog))
+                }
+                Some("theme") | Some("style") => print!("{}", help_theme(&prog)),
+                _ => print!("{}", root_help(&prog, &default_config_dir, &default_log_file)),
+            }
+            return;
+        }
+        Some("print-config") => {
+            for a in &cmd_args {
+                if a == "-h" || a == "--help" {
+                    print!("{}", help_print_config(&prog));
+                    return;
+                }
+                clap_error(
+                    format!("unexpected argument '{}' found", a),
+                    &format!("{} print-config", &prog),
+                );
+            }
+            let (cfg, _dir) = resolve_config(
+                &home,
+                config_arg.as_deref(),
+                json_path.as_deref(),
+                sqlite_path.as_deref(),
+                backend_type.as_deref(),
+            );
+            print_config_output(&cfg);
+            return;
+        }
+        Some("import-journals") => {
+            let mut cmd_help = false;
+            let mut path: Option<String> = None;
+            let mut idx = 0;
+            while idx < cmd_args.len() {
+                let a = &cmd_args[idx];
+                if a == "-h" || a == "--help" {
+                    cmd_help = true;
+                    idx += 1;
+                } else if a == "-p" || a == "--path" {
+                    if idx + 1 < cmd_args.len() {
+                        path = Some(cmd_args[idx + 1].clone());
+                        idx += 2;
+                    } else {
+                        // missing value: clap would error; treat as provided-but-void
+                        idx += 1;
+                    }
+                } else {
+                    clap_error(
+                        format!("unexpected argument '{}' found", a),
+                        &format!("{} import-journals --path <FILE PATH>", &prog),
+                    );
+                }
+            }
+            if cmd_help {
+                print!("{}", help_import_journals(&prog));
+                return;
+            }
+            if path.is_none() {
+                clap_error(
+                    "the following required arguments were not provided:\n  --path <FILE PATH>".to_string(),
+                    &format!("{} import-journals --path <FILE PATH>", &prog),
+                );
+            }
+            resolve_config(
+                &home,
+                config_arg.as_deref(),
+                json_path.as_deref(),
+                sqlite_path.as_deref(),
+                backend_type.as_deref(),
+            );
+            try_terminal_or_fail();
+        }
+        Some("assign-priority") => {
+            let mut cmd_help = false;
+            let mut positional: Option<String> = None;
+            for a in &cmd_args {
+                if a == "-h" || a == "--help" {
+                    cmd_help = true;
+                } else if a.starts_with('-') && a.len() > 1 {
+                    clap_error(
+                        format!("unexpected argument '{}' found", a),
+                        &format!("{} assign-priority <PRIORITY>", &prog),
+                    );
+                } else {
+                    positional = Some(a.clone());
+                }
+            }
+            if cmd_help {
+                print!("{}", help_assign_priority(&prog));
+                return;
+            }
+            let priority = match positional {
+                Some(p) => p,
+                None => {
+                    clap_error(
+                        "the following required arguments were not provided:\n  <PRIORITY>".to_string(),
+                        &format!("{} assign-priority <PRIORITY>", &prog),
+                    );
+                }
+            };
+            if priority.parse::<u64>().is_err() {
+                clap_error(
+                    format!(
+                        "invalid value '{}' for '<PRIORITY>': invalid digit found in string",
+                        priority
+                    ),
+                    "",
+                );
+            }
+            resolve_config(
+                &home,
+                config_arg.as_deref(),
+                json_path.as_deref(),
+                sqlite_path.as_deref(),
+                backend_type.as_deref(),
+            );
+            try_terminal_or_fail();
+        }
+        Some("theme") => {
+            let sub = cmd_args.first().map(|s| s.as_str());
+            let sub_args = if cmd_args.len() > 1 { cmd_args[1..].to_vec() } else { Vec::new() };
+            let mut has_help = sub_args.iter().any(|a| a == "-h" || a == "--help");
+            let _ = &mut has_help;
+
+            match sub {
+                Some("-h") | Some("--help") => {
+                    print!("{}", help_theme(&prog));
+                    return;
+                }
+                Some("print-path") | Some("path") => {
+                    if sub_args.iter().any(|a| a == "-h" || a == "--help") {
+                        print!("{}", help_theme_print_path(&prog));
+                        return;
+                    }
+                    let (_cfg, config_dir) =
+                        resolve_config(&home, config_arg.as_deref(), None, None, None);
+                    let themes_path = join(&config_dir, "themes.toml");
+                    println!("{}", themes_path);
+                    return;
+                }
+                Some("print-default") | Some("default") => {
+                    if sub_args.iter().any(|a| a == "-h" || a == "--help") {
+                        print!("{}", help_theme_print_default(&prog));
+                        return;
+                    }
+                    print!("{}", default_theme());
+                    return;
+                }
+                Some("write-defaults") | Some("write") => {
+                    if sub_args.iter().any(|a| a == "-h" || a == "--help") {
+                        print!("{}", help_theme_write_defaults(&prog));
+                        return;
+                    }
+                    let (_cfg, config_dir) =
+                        resolve_config(&home, config_arg.as_deref(), None, None, None);
+                    let themes = join(&config_dir, "themes.toml");
+                    if !Path::new(&config_dir).exists() {
+                        eprintln!(
+                            "Error: Error while writing default themes to file\n\nCaused by:\n    No such file or directory (os error 2)"
+                        );
+                        process::exit(1);
+                    }
+                    match fs::write(&themes, default_theme()) {
+                        Ok(_) => println!("Default themes have been written to {}", themes),
+                        Err(_) => {
+                            eprintln!(
+                                "Error: Error while writing default themes to file\n\nCaused by:\n    No such file or directory (os error 2)"
+                            );
+                            process::exit(1);
+                        }
+                    }
+                    return;
+                }
+                Some("help") => {
+                    let subsub = sub_args.first().map(|s| s.as_str());
+                    match subsub {
+                        Some("print-path") | Some("path") => {
+                            print!("{}", help_theme_print_path(&prog))
+                        }
+                        Some("print-default") | Some("default") => {
+                            print!("{}", help_theme_print_default(&prog))
+                        }
+                        Some("write-defaults") | Some("write") => {
+                            print!("{}", help_theme_write_defaults(&prog))
+                        }
+                        _ => print!("{}", help_theme(&prog)),
+                    }
+                    return;
+                }
+                Some(other) => {
+                    clap_error(
+                        format!("unrecognized subcommand '{}'", other),
+                        &format!("{} theme <COMMAND>", &prog),
+                    );
+                }
+                None => {
+                    print!("{}", help_theme(&prog));
+                    return;
+                }
+            }
+        }
+        Some(_) => {
+            resolve_config(
+                &home,
+                config_arg.as_deref(),
+                json_path.as_deref(),
+                sqlite_path.as_deref(),
+                backend_type.as_deref(),
+            );
+            try_terminal_or_fail();
+        }
+        None => {
+            resolve_config(
+                &home,
+                config_arg.as_deref(),
+                json_path.as_deref(),
+                sqlite_path.as_deref(),
+                backend_type.as_deref(),
+            );
+            try_terminal_or_fail();
+        }
+    }
+}
+
+// Consume the next argument as the value for `flag`; if absent, error out.
+fn next_value(
+    tail: &[String],
+    i: &mut usize,
+    flag: &str,
+    usage: &str,
+) -> String {
+    match tail.get(*i + 1) {
+        Some(v) => {
+            *i += 1;
+            v.clone()
+        }
+        None => clap_error(
+            format!("the following required arguments were not provided:\n  {}", flag),
+            usage,
+        ),
+    }
+}
