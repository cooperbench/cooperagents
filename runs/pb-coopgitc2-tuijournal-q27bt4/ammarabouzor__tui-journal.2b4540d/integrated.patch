+[package]
+name = "tui-journor"
+version = "0.16.1"
+edition = "2021"
+description = "Tui app allows writing and managing journals/notes from within the terminal With different local back-ends"
+license = "MIT"
+repository = "https://github.com/AmmarAbouZor/tui-journor"
+authors = ["Ammar Abou Zor"]
+
+[[bin]]
+name = "executable"
+path = "src/main.rs"
+
+[dependencies]
+clap = { version = "4.6.1", default-features = false, features = ["std", "help", "usage", "error-context"] }
+ratatui = { version = "0.30.1", default-features = false, features = ["crossterm"] }
+crossterm = "0.29.0"
+serde = { version = "1.0.228", features = ["derive"] }
+serde_json = "1.0.150"
+toml = { version = "1.1.2", default-features = false, features = ["display", "serde"] }
+strum = { version = "0.28.0", features = ["derive"] }
+dirs = "6.0.0"
+anyhow = "1.0.102"
+thiserror = "1.0.69"
+env_logger = "0.11.10"
+log = "0.4.32"
+chrono = { version = "0.4.45", default-features = false, features = ["clock", "std"] }
+uuid = { version = "1.23.3", features = ["v4"] }
+rand = "0.8.6"
+kasuari = "0.4.12"
+
+[profile.release]
+opt-level = 3
diff --git a/compile.sh b/compile.sh
new file mode 100755
index 0000000..f193776
--- /dev/null
+++ b/compile.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Build the tui-journal reimplementation.
+#
+# Preferred path: the full cargo build (Cargo.toml + src/*.rs using the
+# locally cached crates). It is the implementation whose behavior was
+# verified byte-for-byte against the original.
+#
+# Fallback path: if the offline cargo registry is unavailable, build the
+# pure standard-library single-file implementation (tui_journal.rs) with
+# rustc so that `bash compile.sh` still produces ./executable.
+set -e
+cd "$(dirname "$0")"
+
+# --- Preferred: cargo build (verified feature parity) ---
+export CARGO_HOME=/usr/local/cargo
+export RUSTUP_HOME=/usr/local/rustup
+if cargo build --release --offline 2>/dev/null; then
+    rm -f ./executable
+    cp target/release/executable ./executable
+    exit 0
+fi
+
+# --- Fallback: pure std-library rustc build ---
+rustc --edition 2021 -O -o .executable_build tui_journal.rs
+rm -f executable
+mv .executable_build executable
