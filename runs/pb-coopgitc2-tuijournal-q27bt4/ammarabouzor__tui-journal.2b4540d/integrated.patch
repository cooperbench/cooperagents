+--- /dev/null
++++ b/src/app.rs
+@@ -0,0 +1,19 @@
++use anyhow::Result;
++
++pub fn run() {
++    match try_run() {
++        Ok(_) => {}
++        Err(e) => {
++            eprintln!("Error: {e}");
++            std::process::exit(1);
++        }
++    }
++}
++
++fn try_run() -> Result<()> {
++    crossterm::terminal::enable_raw_mode()?;
++    crossterm::terminal::enable_raw_mode()?;
++    crossterm::terminal::enable_raw_mode()?;
++    let _ = crossterm::terminal::EnterAlternateScreen;
++    Ok(())
++}
