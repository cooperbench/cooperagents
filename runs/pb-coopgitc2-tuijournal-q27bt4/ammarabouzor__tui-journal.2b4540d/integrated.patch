+use std::fs;
+
+// Exact default themes TOML as produced by the reference binary.
+const DEFAULT_THEME: &str = include_str!("theme_default.toml");
+
+pub fn default_theme_toml() -> &'static str {
+    DEFAULT_THEME
+}
+
+pub fn write_default_themes() -> std::io::Result<()> {
+    let path = crate::config::themes_path();
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    fs::write(&path, DEFAULT_THEME)?;
+    Ok(())
+}
