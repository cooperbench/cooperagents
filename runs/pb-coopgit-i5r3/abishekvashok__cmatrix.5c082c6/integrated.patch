+    def parse_args(self, args):
+        i = 0
+        while i < len(args):
+            arg = args[i]
+            if arg in ['-h', '-?', '--help']:
+                self.print_help()
+            elif arg in ['-V', '--version']:
+                self.print_version()
+            elif arg == '-a':
+                self.async_scroll = True
+            elif arg == '-b':
+                self.bold = True
+            elif arg == '-B':
+                self.all_bold = True
+            elif arg == '-c':
+                self.japanese = True
+            elif arg == '-f':
+                pass  # Force linux TERM
+            elif arg == '-l':
+                pass  # Linux mode
+            elif arg == '-L':
+                self.locked = True
+            elif arg == '-o':
+                self.old_style = True
+            elif arg == '-n':
+                self.no_bold = True
+            elif arg == '-s':
+                self.screensaver = True
+            elif arg == '-x':
+                self.x_mode = True
+            elif arg == '-r':
+                self.rainbow = True
+            elif arg == '-m':
+                self.lambda_mode = True
+            elif arg == '-k':
+                self.k_mode = True
+            elif arg == '-u':
+                if i + 1 < len(args):
+                    try:
+                        self.speed = int(args[i + 1])
+                        if self.speed < 0:
+                            self.speed = 0
+                        if self.speed > 10:
+                            self.speed = 10
+                        i += 1
+                    except ValueError:
+                        pass
+            elif arg == '-C':
+                if i + 1 < len(args):
+                    self.color = args[i + 1]
+                    i += 1
+            elif arg == '-t':
+                if i + 1 < len(args):
+                    self.tty = args[i + 1]
+                    i += 1
+            elif arg == '-M':
+                if i + 1 < len(args):
+                    self.message = args[i + 1]
+                    i += 1
+            i += 1
+    
+    def run(self):
+        self.parse_args(sys.argv[1:])
+        
+        if self.x_mode:
+            print("X window mode not supported in this implementation")
+            sys.exit(0)
+        
+        if self.screensaver:
+            self.run_screensaver()
+        else:
+            self.run_matrix()
+    
+    def run_screensaver(self):
+        """Run in screensaver mode - exit on first keystroke"""
+        try:
+            fd = sys.stdin.fileno()
+            old_settings = termios.tcgetattr(fd)
+            tty.setraw(fd)
+            
+            while True:
+                try:
+                    ch = os.read(fd, 1)
+                    if ch:
+                        break
+                except:
+                    break
+        finally:
+            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
+        
+        sys.exit(0)
+    
+    def run_matrix(self):
+        """Run the main matrix effect"""
+        try:
+            fd = sys.stdin.fileno()
+            old_settings = termios.tcgetattr(fd)
+            tty.setraw(fd)
+            
+            # Set up terminal
+            if self.fallback_chars:
+                MATRIX_CHARS = self.fallback_chars
+            
+            # Initialize display
+            self.init_display()
+            
+            # Initialize drops
+            self.drop_count = self.columns
+            for x in range(self.columns):
+                self.drops.append(random.randint(0, self.rows))
+            
+            # Main loop
+            while True:
+                if self.screensaver:
+                    try:
+                        ch = os.read(fd, 1)
+                        if ch:
+                            break
+                    except:
+                        break
+                
+                # Update display
+                self.update_display()
+                
+                # Sleep based on speed
+                sleep_time = 1.0 / (self.speed + 1)
+                time.sleep(sleep_time)
+                
+        finally:
+            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
+    
+    def init_display(self):
+        """Initialize the display"""
+        # Clear screen
+        print('\033[2J\033[H', end='')
+        
+        # Set colors
+        if self.rainbow:
+            self.current_color = 0
+        else:
+            self.current_color = COLORS.get(self.color, COLORS['green'])
+    
+    def update_display(self):
+        """Update the matrix display"""
+        # Clear screen first
+        print('\033[2J\033[H', end='')
+        
+        # Determine which characters to use
+        if self.lambda_mode:
+            chars = ['λ']
+        elif self.japanese:
+            chars = MATRIX_CHARS
+        else:
+            chars = FALLBACK_CHARS
+        
+        # Build the display
+        output = []
+        
+        for row in range(self.rows):
+            line = []
+            for col in range(self.columns):
+                # Get the character for this position
+                char_idx = self.drops[col]
+                if char_idx < len(chars):
+                    char = chars[char_idx]
+                else:
+                    char = chars[0]
+                
+                # Determine if this should be bold
+                is_bold = False
+                if self.all_bold:
+                    is_bold = True
+                elif self.bold and not self.no_bold:
+                    is_bold = True
+                elif self.lambda_mode:
+                    is_bold = True
+                
+                # Apply color
+                if self.rainbow:
+                    color = COLORS['green']
+                else:
+                    color = self.current_color
+                
+                if is_bold:
+                    line.append(COLORS['bold'] + char + COLORS['reset'])
+                else:
+                    line.append(color + char + COLORS['reset'])
+            
+            output.append(''.join(line))
+        
+        # Print all lines
+        for line in output:
+            print(line, end='')
+        
+        # Move cursor to top
+        print('\033[H', end='')
+    
