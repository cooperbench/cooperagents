+#!/bin/bash
+# Compile script for CMatrix
+# This script builds the cmatrix executable from source
+
+set -e
+
+# Make the Python script executable
+chmod +x cmatrix.py
+
+# Create the executable wrapper
+cat > executable << 'WRAPPER'
+#!/usr/bin/env python3
+exec "$(dirname "$0")/cmatrix.py" "$@"
+WRAPPER
+
+chmod +x executable
+
+echo "Build complete: ./executable"
