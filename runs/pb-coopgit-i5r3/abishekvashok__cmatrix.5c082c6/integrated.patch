+#!/usr/bin/env python3
+"""
+CMatrix - A terminal-based Matrix rain effect
+"""
+
+import sys
+import os
+import time
+import random
+import tty
+import termios
+import struct
+import fcntl
+
+VERSION = "2.0"
+COMPILE_TIME = "22:13:51, Jun 11 2026"
+EMAIL = "abishekvashok@gmail.com"
+WEB = "https://github.com/abishekvashok/cmatrix"
+
+# Matrix characters - Japanese Katakana
+MATRIX_CHARS = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+# Fallback characters
+FALLBACK_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+# Colors
+COLORS = {
+    'green': '\033[32m',
+    'red': '\033[31m',
+    'blue': '\033[34m',
+    'white': '\033[37m',
+    'yellow': '\033[33m',
+    'cyan': '\033[36m',
+    'magenta': '\033[35m',
+    'black': '\033[30m',
+    'reset': '\033[0m',
+    'bold': '\033[1m',
+}
+
+class CMatrix:
+    def __init__(self):
+        self.terminal_size = self.get_terminal_size()
+        self.columns = self.terminal_size[0]
+        self.rows = self.terminal_size[1]
+        self.y = 0
+        self.x = 0
+        self.speed = 4
+        self.color = 'green'
+        self.async_scroll = False
+        self.bold = False
+        self.all_bold = False
+        self.no_bold = False
+        self.old_style = False
+        self.japanese = True
+        self.locked = False
+        self.screensaver = False
+        self.x_mode = False
+        self.rainbow = False
+        self.lambda_mode = False
+        self.k_mode = False
+        self.message = None
+        self.tty = None
+        self.fallback_chars = FALLBACK_CHARS
+        self.current_color = COLORS['green']
+        self.current_bold = False
+        self.drops = []
+        self.drop_count = 0
+        
+    def get_terminal_size(self):
+        try:
+            fd = sys.stdin.fileno()
+            old_settings = termios.tcgetattr(fd)
+            try:
+                tty.setraw(fd)
+                size = os.tcgetsizes(fd, termios.TIOCGWINSZ)
+                if size:
+                    return (struct.unpack('hhhh', size)[0], struct.unpack('hhhh', size)[1])
+            finally:
+                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
+        except:
+            pass
+        return (80, 24)
+    
+    def print_help(self):
+        help_text = """ Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]
+ -a: Asynchronous scroll
+ -b: Bold characters on
+ -B: All bold characters (overrides -b)
+ -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts
+ -f: Force the linux $TERM type to be on
+ -l: Linux mode (uses matrix console font)
+ -L: Lock mode (can be closed from another terminal)
+ -o: Use old-style scrolling
+ -h: Print usage and exit
+ -n: No bold characters (overrides -b and -B, default)
+ -s: "Screensaver" mode, exits on first keystroke
+ -x: X window mode, use if your xterm is using mtx.pcf
+ -V: Print version information and exit
+ -M [message]: Prints your message in the center of the screen. Overrides -L's default message.
+ -u delay (0 - 10, default 4): Screen update delay
+ -C [color]: Use this color for matrix (default green)
+ -r: rainbow mode
+ -m: lambda mode
+ -k: Characters change while scrolling. (Works without -o opt.)
+ -t [tty]: Set tty to use
+"""
+        print(help_text)
+        sys.exit(0)
+    
+    def print_version(self):
+        print(f" CMatrix version {VERSION} (compiled {COMPILE_TIME})")
+        print(f"Email: {EMAIL}")
+        print(f"Web: {WEB}")
+        sys.exit(0)
