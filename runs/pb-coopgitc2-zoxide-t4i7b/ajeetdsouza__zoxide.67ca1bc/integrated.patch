+use std::collections::BTreeMap;
+use std::env;
+use std::fs::{self, File};
+use std::io::{BufRead, BufReader, Write};
+use std::path::PathBuf;
+use std::process;
+
+const VERSION: &str = "0.9.9";
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "-h" || args[1] == "--help") {
+        print_help();
+        process::exit(0);
+    }
+    
+    if args.len() > 1 && (args[1] == "-V" || args[1] == "--version") {
+        println!("zoxide {}", VERSION);
+        process::exit(0);
+    }
+    
+    let command = if args.len() > 1 {
+        &args[1]
+    } else {
+        print_help();
+        process::exit(1);
+    };
+    
+    match command.as_str() {
+        "add" => add(&args[2..]),
+        "edit" => edit(),
+        "import" => import(&args[2..]),
+        "init" => init(&args[2..]),
+        "query" => query(&args[2..]),
+        "remove" => remove(&args[2..]),
+        _ => {
+            print_help();
+            process::exit(1);
+        }
+    }
+}
+
+fn print_help() {
+    println!("zoxide 0.9.9\nAjeet D'Souza <98ajeet@gmail.com>\nhttps://github.com/ajeetdsouza/zoxide\n\nA smarter cd command for your terminal\n\nUsage:\n  zoxide <COMMAND>\n\nCommands:\n  add     Add a new directory or increment its rank\n  edit    Edit the database\n  import  Import entries from another application\n  init    Generate shell configuration\n  query   Search for a directory in the database\n  remove  Remove a directory from the database\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n\nEnvironment variables:\n  _ZO_DATA_DIR          Path for zoxide data files\n  _ZO_ECHO              Print the matched directory before navigating to it when set to 1\n  _ZO_EXCLUDE_DIRS      List of directory globs to be excluded\n  _ZO_FZF_OPTS          Custom flags to pass to fzf\n  _ZO_MAXAGE            Maximum total age after which entries start getting deleted\n  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths\n");
+}
+
+fn get_data_dir() -> PathBuf {
+    env::var("_ZO_DATA_DIR")
+        .ok()
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from(".zoxide"))
+}
+
+fn get_db_file() -> PathBuf {
+    get_data_dir().join("db.json")
+}
+
+fn load_db() -> BTreeMap<String, u64> {
+    let db_path = get_db_file();
+    if !db_path.exists() {
+        return BTreeMap::new();
+    }
+    
+    let file = File::open(&db_path).expect("Failed to open database");
+    let reader = BufReader::new(file);
+    
+    let mut db = BTreeMap::new();
+    for line in reader.lines() {
+        let line = line.expect("Failed to read line");
+        let parts: Vec<&str> = line.splitn(2, ':').collect();
+        if parts.len() == 2 {
+            let path = parts[0].trim();
+            let rank: u64 = parts[1].trim().parse().unwrap_or(0);
+            db.insert(path.to_string(), rank);
+        }
+    }
+    db
+}
+
+fn save_db(db: &BTreeMap<String, u64>) {
+    let db_path = get_db_file();
+    let parent = db_path.parent().unwrap();
+    fs::create_dir_all(parent).expect("Failed to create data directory");
+    
+    let mut file = File::create(&db_path).expect("Failed to create database");
+    for (path, rank) in db {
+        writeln!(file, "{}:{}", path, rank).expect("Failed to write to database");
+    }
+}
+
+fn add(args: &[String]) {
+    let path = &args[0];
+    let resolve_symlinks = env::var("_ZO_RESOLVE_SYMLINKS").is_ok();
+    
+    let real_path = if resolve_symlinks {
+        std::fs::canonicalize(path).unwrap_or_else(|_| PathBuf::from(path))
+    } else {
+        PathBuf::from(path)
+    };
+    
+    let mut db = load_db();
+    let rank = db.get(&real_path.to_string_lossy().to_string()).copied().unwrap_or(0) + 1;
+    db.insert(real_path.to_string_lossy().to_string(), rank);
+    save_db(&db);
+}
+
+fn edit() {
+    let mut db = load_db();
+    if db.is_empty() {
+        println!("Database is empty");
+        return;
+    }
+    
+    let db_path = get_db_file();
+    let fzf_opts = env::var("_ZO_FZF_OPTS").unwrap_or_default();
+    
+    let fzf_cmd = format!("fzf --multi --preview 'echo {}' --preview-window down:3:wrap {}", 
+        db_path.display(), fzf_opts);
+    
+    let result = std::process::Command::new("sh")
+        .arg("-c")
+        .arg(&fzf_cmd)
+        .output();
+    
+    if let Ok(output) = result {
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        for line in stdout.lines() {
+            if let Some((path, rank)) = line.split_once(':') {
+                let path = path.trim();
+                let rank: u64 = rank.trim().parse().unwrap_or(0);
+                let mut db = load_db();
+                db.insert(path.to_string(), rank);
+                save_db(&db);
+            }
+        }
+    }
+}
+
+fn import(args: &[String]) {
+    let _tool = if args.is_empty() {
+        "z"
+    } else {
+        &args[0]
+    };
+    
+    let db = load_db();
+    let mut new_db = BTreeMap::new();
+    
+    for (path, rank) in db {
+        new_db.insert(path, rank);
+    }
+    
+    save_db(&new_db);
+}
+
+fn init(args: &[String]) {
+    let mut shell = "bash".to_string();
+    let mut hook = "zoxide".to_string();
+    let mut cmd = "zoxide query".to_string();
+    let mut no_cmd = false;
+    
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--cmd" && i + 1 < args.len() {
+            cmd = args[i + 1].clone();
+            i += 2;
+        } else if args[i] == "--hook" && i + 1 < args.len() {
+            hook = args[i + 1].clone();
+            i += 2;
+        } else if args[i] == "--no-cmd" {
+            no_cmd = true;
+            i += 1;
+        } else if args[i].starts_with("--") {
+            i += 1;
+        } else {
+            shell = args[i].clone();
+            i += 1;
+        }
+    }
+    
+    match shell.as_str() {
+        "bash" => init_bash(&cmd, &hook, no_cmd),
+        "zsh" => init_zsh(&cmd, &hook, no_cmd),
+        "fish" => init_fish(&cmd, &hook, no_cmd),
+        "powershell" => init_powershell(&cmd, &hook, no_cmd),
+        _ => init_posix(&cmd, &hook, no_cmd),
+    }
+}
+
+fn init_bash(cmd: &str, hook: &str, no_cmd: bool) {
+    let args = if no_cmd {
+        vec!["--no-cmd".to_string(), "--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    } else {
+        vec!["--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    };
+    println!("eval \"$(zoxide init bash {})\"", args.join(" "));
+}
+
+fn init_zsh(cmd: &str, hook: &str, no_cmd: bool) {
+    let args = if no_cmd {
+        vec!["--no-cmd".to_string(), "--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    } else {
+        vec!["--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    };
+    println!("eval \"$(zoxide init zsh {})\"", args.join(" "));
+}
+
+fn init_fish(cmd: &str, hook: &str, no_cmd: bool) {
+    let args = if no_cmd {
+        vec!["--no-cmd".to_string(), "--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    } else {
+        vec!["--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    };
+    println!("eval \"$(zoxide init fish {})\"", args.join(" "));
+}
+
+fn init_powershell(cmd: &str, hook: &str, no_cmd: bool) {
+    let args = if no_cmd {
+        vec!["--no-cmd".to_string(), "--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    } else {
+        vec!["--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    };
+    println!("eval \"$(zoxide init powershell {})\"", args.join(" "));
+}
+
+fn init_posix(cmd: &str, hook: &str, no_cmd: bool) {
+    let args = if no_cmd {
+        vec!["--no-cmd".to_string(), "--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    } else {
+        vec!["--cmd".to_string(), cmd.to_string(), "--hook".to_string(), hook.to_string()]
+    };
+    println!("eval \"$(zoxide init posix {})\"", args.join(" "));
+}
+
+fn query(args: &[String]) {
+    let path = if args.is_empty() {
+        "."
+    } else {
+        &args[0]
+    };
+    
+    let db = load_db();
+    let matches: Vec<(String, u64)> = db.iter().map(|(k, v)| (k.clone(), *v)).collect();
+    
+    if matches.is_empty() {
+        println!("No matches found");
+        return;
+    }
+    
+    let prefix = if path.ends_with('/') {
+        &path[..path.len()-1]
+    } else {
+        path
+    };
+    
+    let mut filtered: Vec<(String, u64)> = Vec::new();
+    
+    for (p, r) in matches {
+        if p.starts_with(prefix) {
+            filtered.push((p, r));
+        }
+    }
+    
+    if filtered.is_empty() {
+        println!("No matches found");
+        return;
+    }
+    
+    filtered.sort_by(|a, b| b.1.cmp(&a.1));
+    
+    let top = filtered.iter().take(1).map(|(p, _)| p).collect::<Vec<_>>();
+    let result = top[0];
+    
+    let echo = env::var("_ZO_ECHO").unwrap_or_default();
+    if echo == "1" {
+        println!("{}", result);
+    }
+    
+    println!("{}", result);
+}
+
+fn remove(args: &[String]) {
+    let path = &args[0];
+    let db = load_db();
+    
+    let real_path = if env::var("_ZO_RESOLVE_SYMLINKS").is_ok() {
+        std::fs::canonicalize(path).unwrap_or_else(|_| PathBuf::from(path))
+    } else {
+        PathBuf::from(path)
+    };
+    
+    if db.contains_key(&real_path.to_string_lossy().to_string()) {
+        let mut new_db = BTreeMap::new();
+        for (k, v) in db {
+            if k != real_path.to_string_lossy().to_string() {
+                new_db.insert(k, v);
+            }
+        }
+        save_db(&new_db);
+    } else {
+        println!("Not found");
+    }
+}
