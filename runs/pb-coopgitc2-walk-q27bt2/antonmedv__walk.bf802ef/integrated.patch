++		rowsShown = limit
++	}
++	if rowsShown < 0 {
++		rowsShown = 0
++	}
++
++	// Render each row.
++	for r := 0; r < rowsShown; r++ {
++		out.WriteString("\r\n")
++		for c := 0; c < numCols; c++ {
++			idx := c*contentRows + r
++			cur := 0
++			if idx < n {
