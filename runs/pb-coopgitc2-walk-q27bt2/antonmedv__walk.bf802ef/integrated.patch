++
++func repeatSpace(n int) string {
++	b := make([]byte, n)
++	for i := range b {
++		b[i] = ' '
++	}
++	return string(b)
++}
++
++func itoa(i int) string {
++	if i == 0 {
++		return "0"
++	}
++	neg := i < 0
++	if neg {
++		i = -i
++	}
++	var buf [12]byte
++	pos := len(buf)
++	for i > 0 {
++		pos--
++		buf[pos] = byte('0' + i%10)
++		i /= 10
++	}
++	if neg {
++		pos--
++		buf[pos] = '-'
++	}
++	return string(buf[pos:])
++}
