+package main
+
+import "os"
+
+// version is the program version, matching the original walk release.
+const version = "v1.13.0"
+
+// helpText is the exact help/usage output. The original prints it to stderr
+// and exits with a non-zero status.
+var helpText = "\n" +
+	"  walk v1.13.0\n" +
+	"\n" +
+	"  Usage: walk [path]\n" +
+	"\n" +
+	"    arrows, hjkl  Move cursor\n" +
+	"    enter         Enter directory\n" +
+	"    backspace     Exit directory\n" +
+	"    space         Toggle preview\n" +
+	"    esc, q        Exit with cd\n" +
+	"    ctrl+c        Exit without cd\n" +
+	"    /             Fuzzy search\n" +
+	"    d, delete     Delete file or dir\n" +
+	"    y             Copy to clipboard\n" +
+	"    .             Hide hidden files\n" +
+	"    ?             Show help\n" +
+	"\n" +
+	"  Flags:\n" +
+	"\n" +
+	"    --icons        display icons\n" +
+	"    --dir-only     show dirs only\n" +
+	"    --hide-hidden  hide hidden files\n" +
+	"    --preview      display preview\n" +
+	"    --with-border  preview with border\n" +
+	"    --fuzzy        fuzzy mode\n\n"
+
+func main() {
+	args := os.Args[1:]
+
+	// The flag handling is intentionally lenient: unknown flags are ignored
+	// and the program proceeds, mirroring the original's behavior.
+	hasVersion := false
+	hasHelp := false
+	for _, a := range args {
+		switch a {
+		case "-v", "--version":
+			hasVersion = true
+		case "-h", "--help":
+			hasHelp = true
+		}
+	}
+
+	// Version wins over help.
+	if hasVersion {
+		os.Stdout.WriteString(version + "\n")
+		os.Exit(0)
+	}
+
+	if hasHelp {
+		os.Stderr.WriteString(helpText)
+		os.Exit(1)
+	}
+
+	// The original opens the controlling terminal before rendering and
+	// panics when it is unavailable; reproduce that behavior.
+	f, err := os.Open("/dev/tty")
+	if err != nil {
+		panic("could not open a new TTY: " + err.Error())
+	}
+	_ = f
+
+	// A TTY is present. Render the interactive file browser.
+	runTUI()
+}
