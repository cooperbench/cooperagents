+++ b/scheme1.py
@@ -0,0 +1,51 @@
+import hashlib, hmac, struct, subprocess, zlib
+
+def pbkdf2(pw, salt, iters, dklen):
+    out=b''; idx=1
+    while len(out)<dklen:
+        u=hmac.new(pw, salt+struct.pack('>I',idx), hashlib.sha1).digest()
+        res=u
+        for _ in range(iters-1):
+            u=hmac.new(pw, u, hashlib.sha1).digest()
+            res=bytes(a^b for a,b in zip(res,u))
+        out+=res; idx+=1
+    return out[:dklen]
+
+def aes_ctr(key, iv, data):
+    p=subprocess.run(['openssl','enc','-aes-128-ctr','-nopad','-K',key.hex(),'-iv',iv.hex()],
+                     input=data, capture_output=True)
+    assert p.returncode==0, p.stderr
+    return p.stdout
+
+FILES = {
+ 'assets/2.test.txt.zip': b'ab',
+ 'assets/3.test.txt.zip': b'D3M',
+}
+def load(name):
+    d=open(name,'rb').read()
+    nl=d[26]|(d[27]<<8); el=d[28]|(d[29]<<8)
+    off=30+nl+el
+    csize=d[18]|(d[19]<<8)
+    return d[off:off+csize]
+
+for name, pw in FILES.items():
+    payload=load(name); salt=payload[:16]; rest=payload[16:]
+    usize=len(rest)-4
+    print('====', name, 'pw', pw, 'usize', usize)
+    for iters in (10000,):
+        for dklen in (32, 40, 24):
+            der=pbkdf2(pw, salt, iters, dklen)
+            key=der[:16]; iv=b'\x00'*16
+            # H1: last 4 bytes plaintext check
+            p=aes_ctr(key, iv, rest[:-4])
+            check_stored=rest[-4:]
+            print(f' iters={iters} dklen={dklen} H1: content={p!r} check_stored={check_stored.hex()}')
+            print(f'   crc32={zlib.crc32(p)&0xFFFFFFFF:08x} der[16:20]={der[16:20].hex()} der[28:32]={der[28:32].hex()} der[:4]={der[:4].hex()}')
+            # H2: check inside ciphertext
+            dec=aes_ctr(key, iv, rest)
+            c2=dec[:-4]; ck2=dec[-4:]
+            print(f'   H2: content={c2!r} check={ck2.hex()} crc32(content)={zlib.crc32(c2)&0xFFFFFFFF:08x}')
+            # H3: iv = der[16:32]
+            dec3=aes_ctr(key, der[16:32], rest)
+            c3=dec3[:-4]; ck3=dec3[-4:]
+            print(f'   H3(iv=der[16:32]): content={c3!r} check={ck3.hex()} crc32={zlib.crc32(c3)&0xFFFFFFFF:08x}')
diff --git a/scheme2.py b/scheme2.py
new file mode 100644
index 0000000..ffe1de6
--- /dev/null
+++ b/scheme2.py
@@ -0,0 +1,54 @@
+import hashlib, hmac, struct, subprocess
+
+def pbkdf2(pw, salt, iters, dklen, hash=hashlib.sha1):
+    out=b''; idx=1
+    while len(out)<dklen:
+        u=hmac.new(pw, salt+struct.pack('>I',idx), hash).digest()
+        res=u
+        for _ in range(iters-1):
+            u=hmac.new(pw, u, hash).digest()
+            res=bytes(a^b for a,b in zip(res,u))
+        out+=res; idx+=1
+    return out[:dklen]
+
+def aes_stream(mode, key, iv, data):
+    p=subprocess.run(['openssl','enc',mode,'-nopad','-K',key.hex(),'-iv',iv.hex()],
+                     input=data, capture_output=True)
+    assert p.returncode==0, p.stderr
+    return p.stdout
+
+d=open('assets/2.test.txt.zip','rb').read()
+nl=d[26]|(d[27]<<8); el=d[28]|(d[29]<<8)
+off=30+nl+el; csize=d[18]|(d[19]<<8); usize=d[22]|(d[23]<<8)
+payload=d[off:off+csize]
+print('payload', payload.hex(), 'usize', usize, 'csize', csize)
+pw=b'ab'
+
+candidates=[]
+# (label, salt, ct, ct_offset_in_payload)
+candidates.append(('salt@0',  payload[:16],   payload[16:16+usize]))
+candidates.append(('salt@end',payload[-20:-4],payload[:usize]))
+
+modes=['-aes-128-ctr','-aes-128-cfb','-aes-128-ofb']
+kdfs=[('sha1-10000',hashlib.sha1,10000),('sha1-1000',hashlib.sha1,1000),('sha256-1000',hashlib.sha256,1000)]
+
+def printable(b):
+    return len(b)>0 and all(32<=x<127 or x in (9,10,13) for x in b)
+
+for lab, salt, ct in candidates:
+    for klab, h, it in kdfs:
+        der=pbkdf2(pw, salt, it, 32, h)
+        key=der[:16]
+        for m in modes:
+            for ivlab, iv in [('z16', b'\x00'*16), ('der16', der[16:32])]:
+                pt=aes_stream(m, key, iv, ct)
+                tag=(' <<PRINTABLE>>' if printable(pt) else '')
+                print(f'{lab} {klab} {m} iv={ivlab}: {pt!r}{tag}')
+        # also: tag4 = first 4 bytes of HMAC(hmac_key=der[16:32], salt||ct) vs stored check
+        for chk_pos in ('end4',):
+            stored = payload[-4:]
+            hkey=der[16:32]
+            for msg in (salt+ct, ct, salt):
+                t=hmac.new(hkey, msg, hashlib.sha1).digest()[:4]
+                if t==stored: print(f'MATCH tag! {lab} {klab} msg={msg}')
+                print(f'tag4 hmac({msg}): {t.hex()} vs {stored.hex()}')
