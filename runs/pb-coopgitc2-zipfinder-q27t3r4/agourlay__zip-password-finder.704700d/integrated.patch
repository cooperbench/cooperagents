+RCON=[0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36]
+
+def xtime(a): return ((a<<1) ^ 0x1b) & 0xFF if a & 0x80 else a<<1
+
+def expand(key):
+    Nk=len(key)//4; Nr=Nk+6; words=[list(key[4*i:4*i+4]) for i in range(Nk)]
+    for i in range(Nk, 4*(Nr+1)):
+        t=list(words[i-1])
+        if i % Nk == 0:
+            t=t[1:]+t[:1]; t=[SBOX[b] for b in t]; t[0]^=RCON[i//Nk-1]
+        elif Nk>6 and i % Nk == 4:
+            t=[SBOX[b] for b in t]
+        words.append([words[i-Nk][j]^t[j] for j in range(4)])
+    return words, Nr
+
+def addroundkey(st, rks, r):
+    for c in range(4):
+        for i in range(4):
+            st[i][c] ^= rks[r*4+c][i]
+
+def encrypt_block(block, rks, Nr):
+    st=[[block[i+4*c] for c in range(4)] for i in range(4)]
+    addroundkey(st, rks, 0)
+    for r in range(1, Nr):
+        for c in range(4):
+            for i in range(4): st[i][c]=SBOX[st[i][c]]
+        row1=[st[1][1],st[1][2],st[1][3],st[1][0]]
+        row2=[st[2][2],st[2][3],st[2][0],st[2][1]]
+        row3=[st[3][3],st[3][0],st[3][1],st[3][2]]
+        for c in range(4):
+            st[1][c]=row1[c]; st[2][c]=row2[c]; st[3][c]=row3[c]
+        for c in range(4):
+            a=st[0][c];b=st[1][c];cc=st[2][c];d=st[3][c]
+            st[0][c]=xtime(a)^xtime(b)^b^cc^d
+            st[1][c]=a^xtime(b)^xtime(cc)^cc^d
+            st[2][c]=a^b^xtime(cc)^xtime(d)^d
+            st[3][c]=xtime(a)^b^cc^xtime(d)
+        addroundkey(st, rks, r)
+    for c in range(4):
+        for i in range(4): st[i][c]=SBOX[st[i][c]]
+    row1=[st[1][1],st[1][2],st[1][3],st[1][0]]
+    row2=[st[2][2],st[2][3],st[2][0],st[2][1]]
+    row3=[st[3][3],st[3][0],st[3][1],st[3][2]]
+    for c in range(4):
+        st[1][c]=row1[c]; st[2][c]=row2[c]; st[3][c]=row3[c]
+    addroundkey(st, rks, Nr)
+    return bytes(st[r][c] for c in range(4) for r in range(4))
+
+def aes_ctr(key, iv, data):
+    rks,Nr=expand(key); out=bytearray(); n=len(data)
+    ctr=iv
+    for i in range(0, n, 16):
+        keystream=encrypt_block(ctr, rks, Nr)
+        chunk=data[i:i+16]
+        out+=bytes(a^b for a,b in zip(chunk,keystream))
+        ctr=bytes((b ^ (1 if j==15 else 0)) for j,b in enumerate(ctr))
+    return bytes(out)
+
+def crc32(data):
+    c=0xFFFFFFFF
+    for b in data:
+        c^=b
+        for _ in range(8):
+            c=((c>>1)^0xEDB88320) if c&1 else c>>1
+    return c^0xFFFFFFFF
+
+def sha1(data):
+    ml=len(data)*8
+    data=data+b'\x80'
+    while len(data)%64!=56: data+=b'\x00'
+    data+=struct.pack('>Q', ml)
+    h=[0x67452301,0xEFCDAB89,0x98BADCFE,0x10325476,0xC3D2E1F0]
+    for off in range(0,len(data),64):
+        w=list(struct.unpack('>16I', data[off:off+64]))
+        w += [0]*64
+        for i in range(16,80):
+            v=w[i-3]^w[i-8]^w[i-14]^w[i-16]
+            w[i]=((v<<1)|(v>>31))&0xFFFFFFFF
+        a,b,c,d,e=h
+        for i in range(80):
+            if i<20: f=(b&c)|((~b&0xFFFFFFFF)&d); k=0x5A82598D
+            elif i<40: f=b^c^d; k=0x6ED9EBA1
+            elif i<60: f=(b&c)|(b&d)|(c&d); k=0x8F1BBCDC
+            else: f=b^c^d; k=0xCA62C1D6
+            t=(((a<<5)|(a>>27))&0xFFFFFFFF)+f+e+k+w[i]
+            t&=0xFFFFFFFF
+            e=d;d=c;c=((b<<30)|(b>>2))&0xFFFFFFFF;b=a;a=t
+        h=[(h[0]+a)&0xFFFFFFFF,(h[1]+b)&0xFFFFFFFF,(h[2]+c)&0xFFFFFFFF,(h[3]+d)&0xFFFFFFFF,(h[4]+e)&0xFFFFFFFF]
+    return struct.pack('>5I', *h)
+
+def hmac_sha1(key, msg):
+    if len(key)>64: key=sha1(key)
+    key=key.ljust(64,b'\x00')
+    o_pad=bytes(a^0x5c for a in key); i_pad=bytes(a^0x36 for a in key)
+    return sha1(o_pad+sha1(i_pad+msg))
+
+def pbkdf2_hmac_sha1(pw, salt, iters, dklen):
+    out=b''; idx=1
+    while len(out)<dklen:
+        u=hmac_sha1(pw, salt+struct.pack('>I', idx))
+        res=u
+        for _ in range(iters-1):
+            u=hmac_sha1(pw, u); res=bytes(a^b for a,b in zip(res,u))
+        out+=res; idx+=1
+    return out[:dklen]
