+    match cli.command {
+        Some(Commands::PrintConfig) => {
+            print_config();
+        }
+        Some(Commands::ImportJournals { file }) => {
+            println!("Importing journals from {}", file);
+        }
+        Some(Commands::AssignPriority) => {
+            println!("Assigning priority for all entries with empty priority field");
+        }
+        Some(Commands::Theme(theme_cmd)) => {
+            match theme_cmd {
+                ThemeCommand::PrintPath => {
+                    print_path();
+                }
+                ThemeCommand::PrintDefault => {
+                    print_default();
+                }
+                ThemeCommand::WriteDefaults => {
+                    write_defaults();
+                }
+                ThemeCommand::Help => {
+                    println!("{}", ThemeCommand::into_app().render_help());
+                }
+            }
+        }
+        Some(Commands::Help) => {
+            println!("{}", Cli::into_app().render_help());
+        }
+        None => {
+            println!("{}", Cli::into_app().render_help());
+        }
+    }
