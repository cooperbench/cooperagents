+#!/usr/bin/env python3
+"""
+CMatrix - Matrix-like effect in your terminal
+Based on the screensaver from The Matrix website
+"""
+
+import sys
+import os
+import time
+import random
+import tty
+import termios
+import struct
+import fcntl
+
+# ANSI escape codes
+CSI = '\033['
+RESET = CSI + '0m'
+BOLD = CSI + '1m'
+FAINT = CSI + '2m'
+ITALIC = CSI + '3m'
+UNDERLINE = CSI + '4m'
+BLINK = CSI + '5m'
+REVERSE = CSI + '7m'
+HIDDEN = CSI + '8m'
+
+# Colors
+COLORS = {
+    'green': 32,
+    'red': 31,
+    'blue': 34,
+    'white': 37,
+    'yellow': 33,
+    'cyan': 36,
+    'magenta': 35,
+    'black': 30,
+}
+
+# Characters for the matrix effect
+KATAKANA = 'アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン'
+KATAKANA += '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'
+KATAKANA += 'アァカサタナハマヤャラワガザダバパイ'
+
+# Lambda character
+LAMBDA = 'λ'
+
+# Default settings
+DEFAULT_DELAY = 4
+DEFAULT_COLOR = 'green'
+DEFAULT_TTY = None
+
+class CMatrix:
+    def __init__(self):
+        self.async_scroll = False
+        self.bold = False
+        self.all_bold = False
+        self.no_bold = False
+        self.force_term = False
+        self.linux_mode = False
+        self.old_scroll = False
+        self.shadows_only = False
+        self.locked = False
+        self.rainbow = False
+        self.lambda_mode = False
+        self.chars_change = False
+        self.x_mode = False
+        self.screensaver = False
+        self.update_delay = DEFAULT_DELAY
+        self.color = DEFAULT_COLOR
+        self.message = None
+        self.tty = DEFAULT_TTY
+        self.use_katakana = False
+        
+        # Terminal dimensions
+        self.rows = 0
+        self.cols = 0
+        
+        # Matrix data
+        self.columns = []
+        self.current_color = COLORS[DEFAULT_COLOR]
+        
+        # Old terminal settings
+        self.old_settings = None
+        
+    def parse_args(self, args):
+        """Parse command line arguments"""
+        i = 0
+        while i < len(args):
+            arg = args[i]
+            if arg in ['-h', '-?']:
+                self.print_help()
+                sys.exit(0)
+            elif arg in ['--help', '--version', '-V']:
+                if arg == '-V':
+                    self.print_version()
+                else:
+                    self.print_help()
+                sys.exit(0)
+            elif arg == '-a':
+                self.async_scroll = True
+            elif arg == '-b':
+                self.bold = True
+            elif arg == '-B':
+                self.all_bold = True
+                self.bold = True
+            elif arg == '-c':
+                self.use_katakana = True
+            elif arg == '-f':
+                self.force_term = True
+            elif arg == '-l':
+                self.linux_mode = True
+            elif arg == '-L':
+                self.locked = True
+            elif arg == '-o':
+                self.old_scroll = True
+            elif arg == '-n':
+                self.no_bold = True
+            elif arg == '-s':
+                self.screensaver = True
+            elif arg == '-x':
+                self.x_mode = True
+            elif arg == '-r':
+                self.rainbow = True
+            elif arg == '-m':
+                self.lambda_mode = True
+            elif arg == '-k':
+                self.chars_change = True
+            elif arg == '-u':
+                if i + 1 < len(args):
+                    try:
+                        self.update_delay = int(args[i + 1])
+                        if self.update_delay < 0 or self.update_delay > 10:
+                            print("Error: update delay must be 0-10", file=sys.stderr)
+                            sys.exit(1)
+                    except ValueError:
+                        print("Error: update delay must be a number", file=sys.stderr)
+                        sys.exit(1)
+                    i += 1
+            elif arg == '-C':
+                if i + 1 < len(args):
+                    self.color = args[i + 1].lower()
+                    if self.color not in COLORS:
+                        print(f"Error: invalid color '{self.color}'", file=sys.stderr)
+                        sys.exit(1)
+                    i += 1
+            elif arg == '-M':
+                if i + 1 < len(args):
+                    self.message = args[i + 1]
+                    i += 1
+            elif arg == '-t':
+                if i + 1 < len(args):
+                    self.tty = args[i + 1]
+                    i += 1
+            i += 1
+    
+    def print_help(self):
+        """Print usage information"""
+        print(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]")
+        print(" -a: Asynchronous scroll")
+        print(" -b: Bold characters on")
+        print(" -B: All bold characters (overrides -b)")
+        print(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts")
+        print(" -f: Force the linux $TERM type to be on")
+        print(" -l: Linux mode (uses matrix console font)")
+        print(" -L: Lock mode (can be closed from another terminal)")
+        print(" -o: Use old-style scrolling")
+        print(" -h: Print usage and exit")
+        print(" -n: No bold characters (overrides -b and -B, default)")
+        print(" -s: \"Screensaver\" mode, exits on first keystroke")
+        print(" -x: X window mode, use if your xterm is using mtx.pcf")
+        print(" -V: Print version information and exit")
+        print(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.")
+        print(" -u delay (0 - 10, default 4): Screen update delay")
+        print(" -C [color]: Use this color for matrix (default green)")
+        print(" -r: rainbow mode")
+        print(" -m: lambda mode")
+        print(" -k: Characters change while scrolling. (Works without -o opt.)")
+        print(" -t [tty]: Set tty to use")
+    
+    def print_version(self):
+        """Print version information"""
+        print(" CMatrix version 2.0 (compiled 22:13:51, Jun 11 2026)")
+        print("Email: abishekvashok@gmail.com")
+        print("Web: https://github.com/abishekvashok/cmatrix")
+    
+    def get_bold_setting(self):
+        """Determine if bold should be on"""
+        if self.all_bold:
+            return True
+        if self.no_bold:
+            return False
+        return self.bold
+    
+    def get_char(self, x, y):
+        """Get character at position (x, y)"""
+        if self.lambda_mode:
+            return LAMBDA
+        if self.use_katakana:
+            return random.choice(KATAKANA)
+        return random.choice(KATAKANA)
+    
+    def get_color(self):
+        """Get current color"""
+        if self.rainbow:
+            return random.choice(list(COLORS.values()))
+        return self.current_color
+    
+    def init_terminal(self):
+        """Initialize terminal settings"""
+        try:
+            # Get terminal dimensions
+            (self.rows, self.cols) = os.popen('stty size', 'r').read().split()
+            self.rows = int(self.rows)
+            self.cols = int(self.cols)
+            
+            # Set up terminal for raw input if needed
+            if not self.screensaver:
+                fd = sys.stdin.fileno()
+                try:
+                    self.old_settings = termios.tcgetattr(fd)
+                    tty.setraw(fd)
+                except:
+                    pass
+        except:
+            pass
+    
+    def restore_terminal(self):
+        """Restore terminal settings"""
+        try:
+            if self.old_settings:
+                fd = sys.stdin.fileno()
+                termios.tcsetattr(fd, termios.TCSADRAIN, self.old_settings)
+        except:
+            pass
+    
+    def clear_screen(self):
+        """Clear the screen"""
+        print(CSI + '2J', end='')
+    
+    def move_cursor(self, row, col):
+        """Move cursor to position"""
+        print(CSI + f'{row};{col}H', end='')
+    
+    def print_matrix(self):
+        """Print the matrix effect"""
+        # Clear screen
+        self.clear_screen()
+        
+        # Print message if set
+        if self.message:
+            self.move_cursor(self.rows // 2, 1)
+            print(f"{BOLD}{self.message}", end='')
+            print(RESET)
+        
+        # Print matrix columns
+        for col in self.columns:
+            for i, (char, color) in enumerate(col):
+                row = self.rows - 1 - i
+                if row < 0:
+                    continue
+                if row >= self.rows:
+                    continue
+                color_str = f'\033[{color}m'
+                bold_str = BOLD if self.get_bold_setting() else ''
+                print(f"{color_str}{bold_str}{char}{RESET}", end='')
+        
+        # Move cursor to bottom left
+        self.move_cursor(self.rows, 0)
+    
+    def run(self):
+        """Main loop"""
+        # Initialize terminal
+        self.init_terminal()
+        
+        # Initialize columns
+        self.columns = [[(self.get_char(), self.get_color()) for _ in range(self.cols)] for _ in range(self.rows)]
+        
+        try:
+            # Main loop
+            while True:
+                # Update columns
+                for col in self.columns:
+                    for i in range(len(col) - 1, -1, -1):
+                        if i == 0:
+                            # New character at top
+                            col[i] = (self.get_char(), self.get_color())
+                        else:
+                            # Move character down
+                            col[i] = col[i - 1]
+                
+                # Print matrix
+                self.print_matrix()
+                
+                # Sleep based on delay
+                delay = self.update_delay / 10.0
+                time.sleep(delay)
+                
+                # Check for keystrokes
+                if not self.screensaver:
+                    key = self.get_key()
+                    if key:
+                        self.handle_key(key)
+        finally:
+            # Restore terminal
+            self.restore_terminal()
+    
+    def get_key(self):
+        """Get a key from stdin"""
+        try:
+            fd = sys.stdin.fileno()
+            data = os.read(fd, 1)
+            if data:
+                return data.decode('utf-8', errors='ignore')
+        except:
+            pass
+        return None
+    
+    def handle_key(self, key):
+        """Handle keyboard input"""
+        if key == 'q':
+            sys.exit(0)
+        elif key == 'a':
+            self.async_scroll = not self.async_scroll
+        elif key == 'b':
+            self.bold = not self.bold
+        elif key == 'B':
+            self.all_bold = True
+            self.bold = True
+        elif key == 'n':
+            self.no_bold = True
+            self.bold = False
+        elif key in '0123456789':
+            self.update_delay = int(key)
+        elif key == '!':
+            self.current_color = COLORS['red']
+        elif key == '@':
+            self.current_color = COLORS['green']
+        elif key == '#':
+            self.current_color = COLORS['yellow']
+        elif key == '$':
+            self.current_color = COLORS['blue']
+        elif key == '%':
+            self.current_color = COLORS['magenta']
+        elif key == '^':
+            self.current_color = COLORS['cyan']
+        elif key == '&':
+            self.current_color = COLORS['white']
+        elif key == ')':
+            self.current_color = COLORS['black']
