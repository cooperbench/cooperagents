+    def main(self):
+        """Main entry point"""
+        args = sys.argv[1:]
+        self.parse_args(args)
+        
+        # Check for invalid arguments
+        if args:
+            print("Error: invalid argument", file=sys.stderr)
+            self.print_help()
+            sys.exit(1)
+        
+        # Run the matrix effect
+        self.run()
+
+if __name__ == '__main__':
+    cmatrix = CMatrix()
+    cmatrix.main()
