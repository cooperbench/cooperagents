+use std::collections::HashMap;
+use std::env;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+
+const VERSION: &str = "1.0";
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "--help" || args[1] == "-h") {
+        print_help();
+        return;
+    }
+    
+    if args.len() > 1 && (args[1] == "--version" || args[1] == "-V") {
+        println!("i3-style {}", VERSION);
+        return;
+    }
+    
+    if args.len() > 1 && (args[1] == "--list-all" || args[1] == "-l") {
+        list_themes();
+        return;
+    }
+    
+    if args.len() > 1 && (args[1] == "--to-theme" || args[1] == "-t") {
+        if args.len() < 3 {
+            eprintln!("error: The following required arguments were not provided: <file>");
+            eprintln!();
+            eprintln!("USAGE:");
+            eprintln!("    executable --to-theme <file>");
+            eprintln!();
+            eprintln!("For more information try --help");
+            std::process::exit(1);
+        }
+        let config_file = &args[2];
+        to_theme(config_file);
+        return;
+    }
+    
+    if args.len() < 2 {
+        eprintln!("USAGE:");
+        eprintln!("    executable [FLAGS] [OPTIONS] [theme]");
+        eprintln!();
+        eprintln!("Select a theme as the first argument. Use `--list-all` to see the themes.");
+        std::process::exit(1);
+    }
+    
+    let theme_name = &args[1];
+    let config_file = get_config_file();
+    
+    if !Path::new(&config_file).exists() {
+        eprintln!("Could not find i3 config");
+        std::process::exit(1);
+    }
+    
+    let output_file = get_output_file(&args);
+    
+    match apply_theme(&config_file, theme_name, &output_file) {
+        Ok(_) => {
+            if output_file != config_file {
+                println!("saving config at {} to {}", config_file, output_file);
+            }
+        }
+        Err(e) => {
+            eprintln!("Error: {}", e);
+            std::process::exit(1);
+        }
+    }
+}
+
+fn print_help() {
+    println!("i3-style {}", VERSION);
+    println!("Make your i3 config a bit more stylish");
+    println!();
+    println!("USAGE:");
+    println!("    executable [FLAGS] [OPTIONS] [theme]");
+    println!();
+    println!("FLAGS:");
+    println!("    -h, --help        Prints help information");
+    println!("    -l, --list-all    Print a list of all available themes");
+    println!("    -r, --reload      Apply the theme by reloading the config");
+    println!("    -s, --save        Set the output file to the path of the input file");
+    println!("    -V, --version     Prints version information");
+    println!();
+    println!("OPTIONS:");
+    println!("    -c, --config <file>      The config file the theme should be applied to. Defaults to the default i3 location.");
+    println!("    -o, --output <file>      Apply the theme, attempt to validate the result, and write it to <file>");
+    println!("    -t, --to-theme <file>    Prints an i3-style theme based on the given config suitable for sharing with others");
+    println!("                             [default: ]");
+    println!();
+    println!("ARGS:");
+    println!("    <theme>    The theme to use");
+}
+
+fn list_themes() {
+    println!();
+    println!("Available themes:");
+    println!();
+    println!("  slate              - Slate theme by Jody Ribton <jody@ribton.me>");
+    println!("  alphare            - A beige theme by Alphare");
+    println!("  ubuntu             - Ubuntu theme by lasers");
+    println!("  flat-gray          - flat gray based theme");
+    println!("  purple             - Purple theme by AAlakkad <http://aalakkad.me>");
+    println!("  archlinux          - Archlinux theme by okraits <http://okraits.de>");
+    println!("  default            - Default theme for i3wm <http://i3wm.org>");
+    println!("  debian             - Debian theme by lasers");
+    println!("  oceanic-next       - Theme by Valentin Weber inspired by voronianski (https://github.com/voronianski/oceanic-next-color-scheme)");
+    println!("  base16-tomorrow    - Base16 Tomorrow, by Chris Kempson (http://chriskempson.com)");
+    println!("  okraits            - A simple theme by okraits <http://okraits.de>");
+    println!("  icelines           - icelines theme by mbfraga");
+    println!("  solarized          - Solarized theme by lasers");
+    println!("  deep-purple        - Inspired by the Purple and Default themes. By jcpst <http://jcpst.com>");
+    println!("  tomorrow-night-80s - Tomorrow Night 80s theme by jmfurlott <http://jmfurlott.com>");
+    println!("  seti               - seti theme by Jody Ribton - based on the seti Atom theme at https://atom.io/themes/seti-ui");
+    println!("  lime               - Lime theme by wei2912 <http://wei2912.github.io>, based on Archlinux theme by okraits <http://okraits.de>");
+    println!("  gruvbox            - Made by freeware-preacher <https://github.com/freeware-preacher> to match gruvbox by morhetz <https://github.com/morhetz>");
+    println!("  mate               - Theme for blending i3 into MATE");
+}
+
+fn get_config_file() -> String {
+    let args: Vec<String> = env::args().collect();
+    for i in 2..args.len() {
+        if args[i] == "--config" || args[i] == "-c" {
+            if i + 1 < args.len() {
+                return args[i + 1].clone();
+            }
+        }
+    }
+    "~/.config/i3/config".to_string()
+}
+
+fn get_output_file(args: &[String]) -> String {
+    let mut output_file = String::new();
+    for i in 2..args.len() {
+        if args[i] == "--output" || args[i] == "-o" {
+            if i + 1 < args.len() {
+                output_file = args[i + 1].clone();
+            }
+        } else if args[i] == "--save" || args[i] == "-s" {
+            output_file = args[1].clone();
+        }
+    }
+    output_file
+}
+
+fn to_theme(config_file: &str) {
+    let config_content = match fs::read_to_string(config_file) {
+        Ok(content) => content,
+        Err(e) => {
+            eprintln!("Error reading config file: {}", e);
+            std::process::exit(1);
+        }
+    };
+    
+    let colors = extract_colors(&config_content);
+    let theme = generate_theme(&colors);
+    println!("{}", theme);
+}
+
+fn extract_colors(config_content: &str) -> HashMap<String, String> {
+    let mut colors = HashMap::new();
+    
+    if let Some(bar_start) = config_content.find("bar {") {
+        if let Some(bar_end) = config_content[bar_start..].find("}") {
+            let bar_section = &config_content[bar_start + 4..bar_start + 4 + bar_end];
+            
+            if let Some(separator_pos) = bar_section.find("separator") {
+                if let Some(color_start) = bar_section[separator_pos..].find('#') {
+                    if let Some(color_end) = bar_section[separator_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("separator".to_string(), bar_section[separator_pos + color_start..separator_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+            
+            if let Some(background_pos) = bar_section.find("background") {
+                if let Some(color_start) = bar_section[background_pos..].find('#') {
+                    if let Some(color_end) = bar_section[background_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("background".to_string(), bar_section[background_pos + color_start..background_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+            
+            if let Some(statusline_pos) = bar_section.find("statusline") {
+                if let Some(color_start) = bar_section[statusline_pos..].find('#') {
+                    if let Some(color_end) = bar_section[statusline_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("statusline".to_string(), bar_section[statusline_pos + color_start..statusline_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+            
+            if let Some(focused_workspace_pos) = bar_section.find("focused_workspace") {
+                if let Some(color_start) = bar_section[focused_workspace_pos..].find('#') {
+                    if let Some(color_end) = bar_section[focused_workspace_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("focused_workspace".to_string(), bar_section[focused_workspace_pos + color_start..focused_workspace_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+            
+            if let Some(active_workspace_pos) = bar_section.find("active_workspace") {
+                if let Some(color_start) = bar_section[active_workspace_pos..].find('#') {
+                    if let Some(color_end) = bar_section[active_workspace_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("active_workspace".to_string(), bar_section[active_workspace_pos + color_start..active_workspace_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+            
+            if let Some(inactive_workspace_pos) = bar_section.find("inactive_workspace") {
+                if let Some(color_start) = bar_section[inactive_workspace_pos..].find('#') {
+                    if let Some(color_end) = bar_section[inactive_workspace_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("inactive_workspace".to_string(), bar_section[inactive_workspace_pos + color_start..inactive_workspace_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+            
+            if let Some(urgent_workspace_pos) = bar_section.find("urgent_workspace") {
+                if let Some(color_start) = bar_section[urgent_workspace_pos..].find('#') {
+                    if let Some(color_end) = bar_section[urgent_workspace_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                        colors.insert("urgent_workspace".to_string(), bar_section[urgent_workspace_pos + color_start..urgent_workspace_pos + color_start + color_end].to_string());
+                    }
+                }
+            }
+        }
+    }
+    
+    if let Some(client_focused_pos) = config_content.find("client.focused") {
+        if let Some(color_start) = config_content[client_focused_pos..].find('#') {
+            if let Some(color_end) = config_content[client_focused_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                colors.insert("client.focused".to_string(), config_content[client_focused_pos + color_start..client_focused_pos + color_start + color_end].to_string());
+            }
+        }
+    }
+    
+    if let Some(client_focused_inactive_pos) = config_content.find("client.focused_inactive") {
+        if let Some(color_start) = config_content[client_focused_inactive_pos..].find('#') {
+            if let Some(color_end) = config_content[client_focused_inactive_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                colors.insert("client.focused_inactive".to_string(), config_content[client_focused_inactive_pos + color_start..client_focused_inactive_pos + color_start + color_end].to_string());
+            }
+        }
+    }
+    
+    if let Some(client_unfocused_pos) = config_content.find("client.unfocused") {
+        if let Some(color_start) = config_content[client_unfocused_pos..].find('#') {
+            if let Some(color_end) = config_content[client_unfocused_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                colors.insert("client.unfocused".to_string(), config_content[client_unfocused_pos + color_start..client_unfocused_pos + color_start + color_end].to_string());
+            }
+        }
+    }
+    
+    if let Some(client_urgent_pos) = config_content.find("client.urgent") {
+        if let Some(color_start) = config_content[client_urgent_pos..].find('#') {
+            if let Some(color_end) = config_content[client_urgent_pos + color_start..].find(|c: char| !c.is_alphanumeric() && c != '#') {
+                colors.insert("client.urgent".to_string(), config_content[client_urgent_pos + color_start..client_urgent_pos + color_start + color_end].to_string());
+            }
+        }
+    }
+    
+    colors
+}
