+    theme.push_str(&format!("    statusline {}\n", colors.get("statusline").unwrap_or(&"#FFFFFF".to_string())));
+    theme.push_str(&format!("    focused_workspace {} {} {}\n", 
+        colors.get("focused_workspace").unwrap_or(&"#664477".to_string()),
+        colors.get("focused_workspace").unwrap_or(&"#664477".to_string()),
+        colors.get("focused_workspace").unwrap_or(&"#cccccc".to_string())));
+    theme.push_str(&format!("    active_workspace {} {} {}\n", 
+        colors.get("active_workspace").unwrap_or(&"#DCCD69".to_string()),
+        colors.get("active_workspace").unwrap_or(&"#DCCD69".to_string()),
+        colors.get("active_workspace").unwrap_or(&"#181715".to_string())));
+    theme.push_str(&format!("    inactive_workspace {} {} {}\n", 
+        colors.get("inactive_workspace").unwrap_or(&"#222133".to_string()),
+        colors.get("inactive_workspace").unwrap_or(&"#222133".to_string()),
+        colors.get("inactive_workspace").unwrap_or(&"#AAAAAA".to_string())));
+    theme.push_str(&format!("    urgent_workspace {} {} {}\n", 
+        colors.get("urgent_workspace").unwrap_or(&"#CE4045".to_string()),
+        colors.get("urgent_workspace").unwrap_or(&"#CE4045".to_string()),
+        colors.get("urgent_workspace").unwrap_or(&"#FFFFFF".to_string())));
+    theme.push_str("  }\n");
+    theme.push_str("}\n");
+    theme.push_str("\n");
+    theme.push_str("#######################################################################\n");
+    theme.push_str("# automatically start i3-config-wizard to offer the user to create a\n");
+    theme.push_str("# keysym-based config which used his favorite modifier (alt or windows)\n");
+    theme.push_str("#\n");
+    theme.push_str("# i3-config-wizard will not launch if there already is a config file\n");
+    theme.push_str("# in ~/.i3/config.\n");
+    theme.push_str("#\n");
+    theme.push_str("# Please remove the following exec line:\n");
+    theme.push_str("#######################################################################\n");
+    theme.push_str("exec i3-config-wizard\n");
+    theme.push_str(&format!("client.focused {}\n", colors.get("client.focused").unwrap_or(&"#664477".to_string())));
+    theme.push_str(&format!("client.focused_inactive {}\n", colors.get("client.focused_inactive").unwrap_or(&"#e7d8b1".to_string())));
+    theme.push_str(&format!("client.unfocused {}\n", colors.get("client.unfocused").unwrap_or(&"#222133".to_string())));
+    theme.push_str(&format!("client.urgent {}\n", colors.get("client.urgent").unwrap_or(&"#CE4045".to_string())));
+    
+    theme
+}
+
+fn apply_theme(config_file: &str, theme_name: &str, output_file: &str) -> Result<(), String> {
+    let config_content = match fs::read_to_string(config_file) {
+        Ok(content) => content,
+        Err(e) => return Err(format!("Error reading config file: {}", e)),
+    };
+    
+    let theme_colors = get_theme_colors(theme_name);
+    
+    let mut result = String::new();
+    result.push_str(&config_content);
+    
+    for (_key, value) in &theme_colors {
+        result.push_str(&format!("{}\n", value));
+    }
+    
+    let mut output = match fs::File::create(output_file) {
+        Ok(f) => f,
+        Err(e) => return Err(format!("Error creating output file: {}", e)),
+    };
+    
+    if let Err(e) = output.write_all(result.as_bytes()) {
+        return Err(format!("Error writing output file: {}", e));
+    }
+    
+    Ok(())
+}
+
+fn get_theme_colors(theme_name: &str) -> HashMap<String, String> {
+    let mut colors = HashMap::new();
+    
+    match theme_name {
+        "solarized" => {
+            colors.insert("separator".to_string(), "#dc322f".to_string());
+            colors.insert("background".to_string(), "#002b36".to_string());
+            colors.insert("statusline".to_string(), "#268bd2".to_string());
+            colors.insert("focused_workspace".to_string(), "#fdf6e3".to_string());
+            colors.insert("active_workspace".to_string(), "#6c71c4".to_string());
+            colors.insert("inactive_workspace".to_string(), "#586e75".to_string());
+            colors.insert("urgent_workspace".to_string(), "#d33682".to_string());
+            colors.insert("client.focused".to_string(), "#859900".to_string());
+            colors.insert("client.focused_inactive".to_string(), "#073642".to_string());
+            colors.insert("client.unfocused".to_string(), "#073642".to_string());
+            colors.insert("client.urgent".to_string(), "#d33682".to_string());
+        }
+        "purple" => {
+            colors.insert("separator".to_string(), "#AAAAAA".to_string());
+            colors.insert("background".to_string(), "#222133".to_string());
+            colors.insert("statusline".to_string(), "#FFFFFF".to_string());
+            colors.insert("focused_workspace".to_string(), "#664477".to_string());
+            colors.insert("active_workspace".to_string(), "#DCCD69".to_string());
+            colors.insert("inactive_workspace".to_string(), "#222133".to_string());
+            colors.insert("urgent_workspace".to_string(), "#CE4045".to_string());
+            colors.insert("client.focused".to_string(), "#664477".to_string());
+            colors.insert("client.focused_inactive".to_string(), "#e7d8b1".to_string());
+            colors.insert("client.unfocused".to_string(), "#222133".to_string());
+            colors.insert("client.urgent".to_string(), "#CE4045".to_string());
+        }
+        _ => {
+            colors.insert("separator".to_string(), "#AAAAAA".to_string());
+            colors.insert("background".to_string(), "#222133".to_string());
+            colors.insert("statusline".to_string(), "#FFFFFF".to_string());
+            colors.insert("focused_workspace".to_string(), "#664477".to_string());
+            colors.insert("active_workspace".to_string(), "#DCCD69".to_string());
+            colors.insert("inactive_workspace".to_string(), "#222133".to_string());
+            colors.insert("urgent_workspace".to_string(), "#CE4045".to_string());
+            colors.insert("client.focused".to_string(), "#664477".to_string());
+            colors.insert("client.focused_inactive".to_string(), "#e7d8b1".to_string());
+            colors.insert("client.unfocused".to_string(), "#222133".to_string());
+            colors.insert("client.urgent".to_string(), "#CE4045".to_string());
+        }
+    }
+    
+    colors
+}
