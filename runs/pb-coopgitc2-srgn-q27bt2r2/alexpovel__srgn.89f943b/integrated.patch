@@ -0,0 +1,1013 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+)
+
+const versionString = "srgn 0.14.1"
+
+// ---------------------------------------------------------------------------
+// Configuration
+// ---------------------------------------------------------------------------
+
+type action struct {
+	name string // "replace","upper","lower","titlecase","normalize","german","symbols","delete","squeeze"
+}
+
+type config struct {
+	scope      string
+	hasScope   bool
+	replace    string
+	hasReplace bool
+
+	// composable actions, in command-line order
+	actions []action
+
+	// standalone
+	delete  bool
+	squeeze bool
+
+	// flags
+	invert      bool
+	glob        string
+	hasGlob     bool
+	dryRun      bool
+	failNoFiles bool
+	failAny     bool
+	failNone    bool
+	joinLangScopes bool
+	hidden        bool
+	gitignored    bool
+	sorted        bool
+	germanPreferOrig bool
+	germanNaive    bool
+	literalString  bool
+	numThreads     int
+	stdinDetection string
+	stdoutDetection string
+	verbose      int
+
+	// completions
+	compShell string
+	compShellSet bool
+
+	// language scopes (accepted, approximate; tree-sitter not available offline)
+	languageScopes    []string
+	languageScopeVals []string
+
+	showVersion bool
+	showHelp   bool
+	shortHelp   bool
+
+	noArgs bool
+}
+
+func main() {
+	os.Exit(run(os.Args[1:]))
+}
+
+func run(args []string) int {
+	// First pass: handle --version and --help/-h specially (clap prints these early)
+	c := &config{scope: ".*"}
+	err := parse(args, c)
+	if err != nil {
+		if !err.silent {
+			fmt.Fprint(os.Stderr, err.msg)
+		}
+		return err.code
+	}
+	if c.showVersion {
+		fmt.Fprintln(os.Stdout, versionString)
+		return 0
+	}
+	if c.showHelp {
+		name := progName()
+		if c.shortHelp {
+			fmt.Fprint(os.Stdout, strings.Replace(shortHelp, "executable", name, -1))
+		} else {
+			fmt.Fprint(os.Stdout, strings.Replace(fullHelp, "executable", name, -1))
+		}
+		return 0
+	}
+	if c.compShellSet {
+		// The original emits a stub completion (just the function name) for any
+		// shell value, regardless of what value is given.
+		fmt.Fprintln(os.Stdout, "_srgn")
+		return 0
+	}
+	return process(c)
+}
+
+// ---------------------------------------------------------------------------
+// Parsing
+// ---------------------------------------------------------------------------
+
+type parseError struct {
+	msg    string
+	code   int
+	silent bool
+}
+
+
+func (e *parseError) Error() string { return e.msg }
+
+// silentErr is a parse error that produces no output but still returns
+// code 2. The reference build stays silent (empty stdout and stderr) for
+// unknown flags and for value-taking flags given without a value.
+func silentErr() *parseError {
+	return &parseError{msg: "", code: 2, silent: true}
+}
+
+var boolFlags = map[string]bool{
+	"-h": true, "--help": true, "-V": true, "--version": true,
+	"-u": true, "--upper": true, "-l": true, "--lower": true,
+	"-t": true, "--titlecase": true, "-n": true, "--normalize": true,
+	"-g": true, "--german": true, "-S": true, "--symbols": true,
+	"-d": true, "--delete": true, "-s": true, "--squeeze": true, "--squeeze-repeats": true,
+	"-i": true, "--invert": true, "-L": true, "--literal-string": true,
+	"--fail-no-files": true, "--dry-run": true, "--fail-any": true, "--fail-none": true,
+	"-j": true, "--join-language-scopes": true,
+	"-H": true, "--hidden": true, "--gitignored": true, "--sorted": true,
+	"--german-prefer-original": true, "--german-naive": true,
+	"-v": true, "--verbose": true,
+}
+
+// value-taking flags: name -> short name for the value in help
+var valFlags = map[string]string{
+	"--completions": "",
+	"-G": "--glob", "--glob": "",
+	"--stdin-detection": "", "--stdout-detection": "",
+	"--threads": "",
+	// language scopes (value-taking; tree-sitter not available offline)
+	"--c": "", "--c-query": "", "--c-query-file": "",
+	"--csharp": "", "--csharp-query": "", "--csharp-query-file": "",
+	"--go": "", "--go-query": "", "--go-query-file": "",
+	"--hcl": "", "--hcl-query": "", "--hcl-query-file": "",
+	"--python": "", "--python-query": "", "--python-query-file": "",
+	"--rust": "", "--rust-query": "", "--rust-query-file": "",
+	"--typescript": "", "--typescript-query": "", "--typescript-query-file": "",
+	// aliases
+	"-cs": "--csharp", "-py": "--python", "-rs": "--rust", "-ts": "--typescript",
+}
+
+func isFlag(s string) bool { return strings.HasPrefix(s, "-") && s != "-" }
+
+func parse(args []string, c *config) *parseError {
+	var positionals []string // non-flag args before "--"
+	var repls []string       // all args after "--" (replacement)
+	afterDD := false
+	i := 0
+	for i < len(args) {
+		a := args[i]
+		if afterDD {
+			// After "--", every token is a replacement value (including
+			// a literal "--", which clap treats as a value, not a
+			// second terminator).
+			repls = append(repls, a)
+			i++
+			continue
+		}
+		if a == "--" {
+			afterDD = true
+			i++
+			continue
+		}
+		if isFlag(a) {
+			// split --name=value
+			name := a
+			var inlineVal *string
+			if idx := strings.Index(a, "="); idx > 1 {
+				name = a[:idx]
+				v := a[idx+1:]
+				inlineVal = &v
+			}
+			// version/help short-circuit (clap prints these immediately)
+			if name == "-V" || name == "--version" {
+				c.showVersion = true
+				return nil
+			}
+			if name == "-h" {
+				c.showHelp = true
+				c.shortHelp = true
+				return nil
+			}
+			if name == "--help" {
+				c.showHelp = true
+				return nil
+			}
+			// boolean flags
+			if _, ok := boolFlags[name]; ok {
+				setBool(c, name)
+				i++
+				continue
+			}
+			// value-taking flags
+			if _, ok := valFlags[name]; ok {
+				var val string
+				if inlineVal != nil {
+					val = *inlineVal
+				} else {
+					if i+1 >= len(args) {
+						return silentErr()
+					}
+					val = args[i+1]
+					i++
+				}
+				setVal(c, name, val)
+				i++
+				continue
+			}
+			// Bundled short flags: e.g. -Sgu -> -S -g -u.
+			// A short flag is "-" followed by single letters, no second dash.
+			if len(name) >= 2 && name[0] == '-' && name[1] != '-' {
+				rest := name[1:]
+				for len(rest) > 0 {
+					sub := "-" + string(rest[0])
+					if _, ok := boolFlags[sub]; ok {
+						setBool(c, sub)
+						rest = rest[1:]
+						continue
+					}
+					if _, ok := valFlags[sub]; ok {
+						// value is the rest of the token, else the next arg
+						if len(rest) > 1 {
+							setVal(c, sub, string(rest[1:]))
+						} else {
+							i++
+							if i >= len(args) {
+								return silentErr()
+							}
+							setVal(c, sub, args[i])
+						}
+						rest = ""
+						continue
+					}
+					// unknown bundled flag: reference stays silent
+					return silentErr()
+				}
+				i++
+				continue
+			}
+			// unknown flag: reference stays silent (empty stdout and stderr)
+			return silentErr()
+		}
+		// positional (before "--")
+		positionals = append(positionals, a)
+		i++
+	}
+	// Only one positional scope is accepted.
+	if len(positionals) == 1 {
+		c.scope = positionals[0]
+		c.hasScope = true
+	} else if len(positionals) >= 2 {
+		return &parseError{msg: positionalError(positionals[1]), code: 2}
+	}
+	// Only one replacement is accepted (after "--").
+	if len(repls) == 1 {
+		c.replace = repls[0]
+		c.hasReplace = true
+	} else if len(repls) >= 2 {
+		return &parseError{msg: multipleReplacements(), code: 2}
+	}
+	if len(args) == 0 {
+		c.noArgs = true
+	}
+	applyEnv(c)
+	return nil
+}
+
+func setBool(c *config, name string) {
+	switch name {
+	case "-u", "--upper":
+		c.actions = append(c.actions, action{"upper"})
+	case "-l", "--lower":
+		c.actions = append(c.actions, action{"lower"})
+	case "-t", "--titlecase":
+		c.actions = append(c.actions, action{"titlecase"})
+	case "-n", "--normalize":
+		c.actions = append(c.actions, action{"normalize"})
+	case "-g", "--german":
+		c.actions = append(c.actions, action{"german"})
+	case "-S", "--symbols":
+		c.actions = append(c.actions, action{"symbols"})
+	case "-d", "--delete":
+		c.delete = true
+	case "-s", "--squeeze":
+		c.squeeze = true
+	case "-i", "--invert":
+		c.invert = true
+	case "--fail-no-files":
+		c.failNoFiles = true
+	case "--dry-run":
+		c.dryRun = true
+	case "--fail-any":
+		c.failAny = true
+	case "--fail-none":
+		c.failNone = true
+	case "-H", "--hidden":
+		c.hidden = true
+	case "--gitignored":
+		c.gitignored = true
+	case "--sorted":
+		c.sorted = true
+	case "--german-prefer-original":
+		c.germanPreferOrig = true
+	case "--german-naive":
+		c.germanNaive = true
+	case "-L", "--literal-string":
+		c.literalString = true
+	case "-j", "--join-language-scopes":
+		c.joinLangScopes = true
+	case "--squeeze-repeats":
+		c.squeeze = true
+	case "-v", "--verbose":
+		c.verbose++
+	}
+}
+
+func setVal(c *config, name, val string) {
+	// resolve aliases to canonical names
+	switch name {
+	case "-cs":
+		name = "--csharp"
+	case "-py":
+		name = "--python"
+	case "-rs":
+		name = "--rust"
+	case "-ts":
+		name = "--typescript"
+	}
+	switch name {
+	case "--completions":
+		c.compShell = val
+		c.compShellSet = true
+	case "-G", "--glob":
+		c.glob = val
+		c.hasGlob = true
+	case "--stdin-detection":
+		c.stdinDetection = val
+	case "--stdout-detection":
+		c.stdoutDetection = val
+	case "--threads":
+		if n, err := strconv.Atoi(val); err == nil {
+			c.numThreads = n
+		}
+	case "--c", "--csharp", "--go", "--hcl", "--python", "--rust", "--typescript":
+		c.languageScopes = append(c.languageScopes, name)
+		c.languageScopeVals = append(c.languageScopeVals, val)
+	case "--c-query", "--csharp-query", "--go-query", "--hcl-query", "--python-query", "--rust-query", "--typescript-query":
+		c.languageScopes = append(c.languageScopes, name)
+		c.languageScopeVals = append(c.languageScopeVals, val)
+	case "--c-query-file", "--csharp-query-file", "--go-query-file", "--hcl-query-file", "--python-query-file", "--rust-query-file", "--typescript-query-file":
+		c.languageScopes = append(c.languageScopes, name)
+		c.languageScopeVals = append(c.languageScopeVals, val)
+	}
+}
+
+func applyEnv(c *config) {
+	truthy := func(k string) bool {
+		v := os.Getenv(k)
+		return v != "" && v != "0"
+	}
+	if truthy("UPPER") {
+		c.actions = append(c.actions, action{"upper"})
+	}
+	if truthy("LOWER") {
+		c.actions = append(c.actions, action{"lower"})
+	}
+	if truthy("TITLECASE") {
+		c.actions = append(c.actions, action{"titlecase"})
+	}
+	if truthy("NORMALIZE") {
+		c.actions = append(c.actions, action{"normalize"})
+	}
+	if truthy("GERMAN") {
+		c.actions = append(c.actions, action{"german"})
+	}
+	if truthy("SQUEEZE") {
+		c.squeeze = true
+	}
+	if truthy("INVERT") {
+		c.invert = true
+	}
+	if truthy("LITERAL_STRING") {
+		c.literalString = true
+	}
+	if truthy("GERMAN_PREFER_ORIGINAL") {
+		c.germanPreferOrig = true
+	}
+	if truthy("GERMAN_NAIVE") {
+		c.germanNaive = true
+	}
+	if r := os.Getenv("REPLACE"); r != "" {
+		if !c.hasReplace {
+			c.replace = r
+			c.hasReplace = true
+		}
+	}
+}
+
+func progName() string {
+	return filepath.Base(os.Args[0])
+}
+
+func usageLine() string {
+	return fmt.Sprintf("Usage: %s [OPTIONS] [SCOPE] [-- <REPLACEMENT>]", progName())
+}
+
+// flagUnexpected: error for an unrecognized flag (includes the "-- %s" tip).
+func flagUnexpected(a string) string {
+	similar := similarArg(a)
+	var b strings.Builder
+	fmt.Fprintf(&b, "error: unexpected argument '%s' found\n\n", a)
+	if similar != "" {
+		fmt.Fprintf(&b, "  tip: a similar argument exists: %q\n", similar)
+	}
+	fmt.Fprintf(&b, "  tip: to pass %q as a value, use '%s'\n\n", a, "-- "+a)
+	fmt.Fprintf(&b, "%s\n\n", usageLine())
+	fmt.Fprintf(&b, "For more information, try '--help'.\n")
+	return b.String()
+}
+
+// positionalError: error for an extra positional argument (no tip).
+func positionalError(a string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "error: unexpected argument '%s' found\n\n", a)
+	fmt.Fprintf(&b, "%s\n\n", usageLine())
+	fmt.Fprintf(&b, "For more information, try '--help'.\n")
+	return b.String()
+}
+
+// multipleReplacements: error when more than one replacement is given.
+func multipleReplacements() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "error: the argument '[REPLACEMENT]' cannot be used multiple times\n\n")
+	fmt.Fprintf(&b, "%s\n\n", usageLine())
+	fmt.Fprintf(&b, "For more information, try '--help'.\n")
+	return b.String()
+}
+
+func similarArg(a string) string {
+	cands := []string{"--upper", "--lower", "--titlecase", "--normalize", "--german", "--symbols", "--delete", "--squeeze", "--invert", "--glob", "--completions", "--help", "--version"}
+	if strings.HasPrefix(a, "--") {
+		cands = append(cands, "--c", "--csharp", "--go", "--hcl", "--python", "--rust", "--typescript", "--only-matching", "--line-numbers")
+	}
+	best := ""
+	bestd := 99
+	for _, cand := range cands {
+		d := levenshtein(a, cand)
+		if d < bestd {
+			bestd = d
+			best = cand
+		}
+	}
+	// threshold: within a few edits
+	if bestd <= 3 && bestd > 0 {
+		return best
+	}
+	return ""
+}
+
+func levenshtein(a, b string) int {
+	ra, rb := []rune(a), []rune(b)
+	la, lb := len(ra), len(rb)
+	prev := make([]int, lb+1)
+	cur := make([]int, lb+1)
+	for j := 0; j <= lb; j++ {
+		prev[j] = j
+	}
+	for i := 1; i <= la; i++ {
+		cur[0] = i
+		for j := 1; j <= lb; j++ {
+			c := 1
+			if ra[i-1] == rb[j-1] {
+				c = 0
+			}
+			cur[j] = min3(prev[j]+1, cur[j-1]+1, prev[j-1]+c)
+		}
+		prev, cur = cur, prev
+	}
+	return prev[lb]
+}
+
+func min3(a, b, c int) int {
+	m := a
+	if b < m {
+		m = b
+	}
+	if c < m {
+		m = c
+	}
+	return m
+}
+
+// ---------------------------------------------------------------------------
+// Processing
+// ---------------------------------------------------------------------------
+
+func process(c *config) int {
+	// Build the scope regex
+	var re *regexp.Regexp
+	var err error
+	if c.literalString {
+		re, err = regexp.Compile(regexp.QuoteMeta(c.scope))
+	} else {
+		re, err = regexp.Compile(c.scope)
+	}
+	if err != nil {
+		// srgn error format
+		fmt.Fprintf(os.Stderr, "Error: Failed building regex\n")
+		fmt.Fprintln(os.Stderr)
+		fmt.Fprintf(os.Stderr, "Caused by:\n")
+		fmt.Fprintf(os.Stderr, "    %s\n", regexErrMsg(err))
+		return 1
+	}
+	if c.invert {
+		// invert: match the complement. We'll handle by inverting in the transform.
+	}
+
+	// Read all input from stdin
+	data, _ := readAll(os.Stdin)
+
+	// Determine mode
+	hasAction := len(c.actions) > 0 || c.delete || c.squeeze || c.hasReplace
+	// squeeze is applied, but does not count as a "real" action for the
+	// "No actions specified" diagnostic (matches reference behavior).
+	realAction := len(c.actions) > 0 || c.delete || c.hasReplace
+	if !hasAction && len(c.languageScopes) > 0 {
+		// Search mode: language scope given, no actions.
+		return runSearch(re, c, data)
+	}
+	// The "No actions specified" error is emitted when there is no real
+	// action (squeeze alone, or nothing at all) and we are not in search mode.
+	if !realAction && len(c.languageScopes) == 0 {
+		fmt.Fprintf(os.Stderr, "[%s ERROR srgn] No actions specified, and not in search mode. Will return input unchanged, if any.\n",
+			time.Now().UTC().Format("2006-01-02T15:04:05.000000Z"))
+	}
+	// Compute the output: apply actions, or write input unchanged if no action.
+	var out []byte
+	if !hasAction {
+		out = data
+	} else {
+		out = applyActions(re, c, data)
+	}
+
+	// A triggered fail condition suppresses stdout entirely (even with no
+	// action). The default global scope (".*") matches empty input, so
+	// --fail-any triggers even when there is no action and no input.
+	failAnyHit := c.failAny && anyInScope(re, data)
+	failNoneHit := c.failNone && !anyInScope(re, data)
+
+	if !failAnyHit && !failNoneHit {
+		os.Stdout.Write(out)
+	}
+
+	if failAnyHit {
+		fmt.Fprintf(os.Stderr, "Error: Error applying: Some input was in scope\n")
+		return 1
+	}
+	if failNoneHit {
+		fmt.Fprintf(os.Stderr, "Error: Error applying: No input was in scope\n")
+		return 1
+	}
+	return 0
+}
+
+func anyInScope(re *regexp.Regexp, data []byte) bool {
+	return len(re.FindAll(data, -1)) > 0
+}
+
+
+
+func regexErrMsg(err error) string {
+	msg := err.Error()
+	// Go's regexp error: "error parsing regexp: ..." try to map to srgn-like
+	return "Invalid regex: " + mapRegexpErr(msg)
+}
+
+func mapRegexpErr(msg string) string {
+	if strings.Contains(msg, "invalid character class") || strings.Contains(msg, "invalid character class") {
+		return "Invalid character class"
+	}
+	// pass through
+	return msg
+}
+
+// ---------------------------------------------------------------------------
+// Core transform
+// ---------------------------------------------------------------------------
+
+// applyActions applies the action sequence to the data.
+func applyActions(re *regexp.Regexp, c *config, data []byte) []byte {
+	// find all matches with submatches
+	matches := re.FindAllSubmatchIndex(data, -1)
+	if len(matches) == 0 {
+		// no matches; but squeeze/transform might still need the whole text?
+		// If no matches, nothing in scope -> return unchanged.
+		return data
+	}
+
+	// If a replacement is present -> replace mode (per-match).
+	if c.hasReplace || c.literalString {
+		return applyReplace(re, c, data, matches)
+	}
+
+
+	// Squeeze mode: collapse adjacent matches to the first match's original
+	// text, ignoring any other transform actions.
+	if c.squeeze {
+		return squeezeCollapse(c, data, matches)
+	}
+
+	// Transform mode (no replacement): merge adjacent matches, apply per region.
+	region := transformRegions(re, c, data, matches)
+	return region
+}
+
+// applyReplace: per-match replacement with backrefs, then other actions.
+func applyReplace(re *regexp.Regexp, c *config, data []byte, matches [][]int) []byte {
+	var out strings.Builder
+	last := 0
+	for _, m := range matches {
+		if len(m) < 2 || m[0] == -1 {
+			continue
+		}
+		start, end := m[0], m[1]
+		// emit gap
+		out.WriteString(string(data[last:start]))
+		// build captures: group 0 is the full match.
+		captures := make([]string, len(m)/2)
+		for i := 0; i < len(m); i += 2 {
+			s, e := m[i], m[i+1]
+			if s >= 0 {
+				captures[i/2] = string(data[s:e])
+			} else {
+				captures[i/2] = ""
+			}
+		}
+		// expand replacement
+		repl := expandRepl(c.replace, captures)
+		// apply subsequent actions to the replacement text
+		repl = applyInlineActions(repl, c)
+		out.WriteString(repl)
+		last = end
+	}
+	out.WriteString(string(data[last:]))
+	return []byte(out.String())
+}
+
+// applyInlineActions applies the composable actions (upper, etc.) to a string.
+func applyInlineActions(s string, c *config) string {
+	for _, a := range c.actions {
+		s = applyAction(s, a, c)
+	}
+	if c.delete {
+		s = ""
+	}
+	return s
+}
+
+// expandRepl expands backrefs $0,$1..,$name in the replacement string.
+func expandRepl(repl string, captures []string) string {
+	var b strings.Builder
+	r := []rune(repl)
+	i := 0
+	for i < len(r) {
+		ch := r[i]
+		if ch == '$' && i+1 < len(r) {
+			next := r[i+1]
+			if next == '$' {
+				b.WriteByte('$')
+				i += 2
+				continue
+			}
+			if next >= '0' && next <= '9' {
+				// could be multi-digit
+				j := i + 1
+				for j < len(r) && r[j] >= '0' && r[j] <= '9' {
+					j++
+				}
+				num, _ := strconv.Atoi(string(r[i+1 : j]))
+				if num < len(captures) {
+					b.WriteString(captures[num])
+				}
+				i = j
+				continue
+			}
+			// named group: letters
+			if (next >= 'a' && next <= 'z') || (next >= 'A' && next <= 'Z') || next == '_' {
+				j := i + 1
+				for j < len(r) && (r[j] == '_' || r[j] >= 'a' && r[j] <= 'z' || r[j] >= 'A' && r[j] <= 'Z' || r[j] >= '0' && r[j] <= '9') {
+					j++
+				}
+				// named group not supported in Go regexp reliably; skip name
+				b.WriteString("$")
+				i = j
+				continue
+			}
+			// lone $ -> literal
+			b.WriteByte('$')
+			i++
+			continue
+		}
+		b.WriteRune(ch)
+		i++
+	}
+	return b.String()
+}
+
+// squeezeCollapse collapses runs of adjacent matches to the first match's original
+// text, leaving gaps and non-adjacent matches unchanged. Other transform actions
+// are ignored when squeeze is set.
+func squeezeCollapse(c *config, data []byte, matches [][]int) []byte {
+	var out strings.Builder
+	last := 0
+	i := 0
+	for i < len(matches) {
+		m := matches[i]
+		if m[0] == -1 {
+			i++
+			continue
+		}
+		start, end := m[0], m[1]
+		// extend run while the next match is adjacent to the current run's end
+		runEnd := end
+		j := i + 1
+		for j < len(matches) {
+			m2 := matches[j]
+			if m2[0] == -1 {
+				j++
+				continue
+			}
+			if m2[0] == runEnd {
+			runEnd = m2[1]
+			j++
+			} else {
+				break
+			}
+		}
+		out.WriteString(string(data[last:start]))
+		out.WriteString(string(data[start:end]))
+		last = runEnd
+		i = j
+	}
+	out.WriteString(string(data[last:]))
+	return []byte(out.String())
+}
+
+// transformRegions: apply actions per-match (NO merging of adjacent matches).
+// This matches the reference: e.g. with scope ".", a single-char match is a
+// region, so multi-char symbols/german patterns do not match. With scope ".+"
+// the whole string is one match/region.
+func transformRegions(re *regexp.Regexp, c *config, data []byte, matches [][]int) []byte {
+	var out strings.Builder
+	last := 0
+	for _, m := range matches {
+		if m[0] == -1 {
+			continue
+		}
+		start, end := m[0], m[1]
+		out.WriteString(string(data[last:start]))
+		regionText := string(data[start:end])
+		regionText = applyRegionActions(regionText, c)
+		out.WriteString(regionText)
+		last = end
+	}
+	out.WriteString(string(data[last:]))
+	return []byte(out.String())
+}
+
+// applyRegionActions applies the composable + standalone actions to a region.
+func applyRegionActions(s string, c *config) string {
+	for _, a := range c.actions {
+		s = applyAction(s, a, c)
+	}
+	if c.delete {
+		s = ""
+	}
+	return s
+}
+
+// applyAction applies a single composable action to a string.
+func applyAction(s string, a action, c *config) string {
+	switch a.name {
+	case "upper":
+		return strings.ToUpper(s)
+	case "lower":
+		return strings.ToLower(s)
+	case "titlecase":
+		return titleCase(s)
+	case "normalize":
+		return normalizeText(s)
+	case "german":
+		return germanNaive(s)
+	case "symbols":
+		return symbolsText(s)
+	}
+	return s
+}
+
+func titleCase(s string) string {
+	var b strings.Builder
+	first := true
+	for _, r := range s {
+		if unicode.IsSpace(r) {
+			b.WriteRune(r)
+			first = true
+			continue
+		}
+		if first {
+			b.WriteRune(unicode.ToTitle(r))
+			first = false
+		} else if unicode.IsUpper(r) {
+			b.WriteRune(unicode.ToLower(r))
+		} else {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func squeezeRepeats(s string) string {
+	var b strings.Builder
+	prev := rune(0)
+	hasPrev := false
+	for _, r := range s {
+		if hasPrev && r == prev {
+			continue
+		}
+		b.WriteRune(r)
+		prev = r
+		hasPrev = true
+	}
+	return b.String()
+}
+
+// german: simple ae/oe/ue/ss -> umlauts mapping (case-sensitive, lowercase only)
+var germanRe = regexp.MustCompile(`(ae|oe|ue|ss)`)
+
+func germanNaive(s string) string {
+	return germanRe.ReplaceAllStringFunc(s, func(m string) string {
+		switch m {
+		case "ae":
+			return "ä"
+		case "oe":
+			return "ö"
+		case "ue":
+			return "ü"
+		case "ss":
+			return "ß"
+		}
+		return m
+	})
+}
+
+func titleCaseFirst(m, lower, upper string) string {
+	if len(m) == 0 {
+		return m
+	}
+	r0 := []rune(m)[0]
+	if unicode.IsUpper(r0) {
+		return upper
+	}
+	return lower
+}
+
+func readAll(r *os.File) ([]byte, error) {
+	var buf []byte
+	for {
+		p := make([]byte, 4096)
+		n, err := r.Read(p)
+		if n > 0 {
+			buf = append(buf, p[:n]...)
+		}
+		if err != nil {
+			break
+		}
+	}
+	return buf, nil
+}
+
+// normalizeText: strip diacritics (approximate NFD + combining mark removal)
+func normalizeText(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		base, ok := accentedMap[r]
+		if ok {
+			b.WriteRune(base)
+			continue
+		}
+		if r >= 0x300 && r <= 0x36F {
+			// combining diacritical mark, drop
+			continue
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// symbolsText: map common operator sequences to unicode symbols
+func symbolsText(s string) string {
+	// ordered longest-match table
+	type pair struct{ in, out string }
+	table := []pair{
+		{"=>", "\u21d2"},    // ⇒
+		{"->", "\u2192"},    // →
+		{"<=", "\u2264"},    // ≤
+		{">=", "\u2265"},    // ≥
+		{"!=", "\u2260"},    // ≠
+	}
+	// single-char passthrough operators stay unchanged
+	var b strings.Builder
+	i := 0
+	runes := []rune(s)
+	for i < len(runes) {
+		matched := false
+		for _, p := range table {
+			if len(runes[i:]) >= len(p.in) {
+				seg := string(runes[i : i+len(p.in)])
+				if seg == p.in {
+					b.WriteString(p.out)
+					i += len(p.in)
+					matched = true
+					break
+				}
+			}
+		}
+		if !matched {
+			b.WriteRune(runes[i])
+			i++
+		}
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Search mode
+// ---------------------------------------------------------------------------
+
+func runSearch(re *regexp.Regexp, c *config, data []byte) int {
+	text := string(data)
+	// Split into lines
+	lines := splitLines(text)
+	anyMatch := false
+	for li, line := range lines {
+		// Find all non-overlapping matches in the line.
+		indices := re.FindAllStringIndex(line, -1)
+		for _, idx := range indices {
+			anyMatch = true
+			matched := line[idx[0]:idx[1]]
+			fmt.Fprintf(os.Stdout, "(stdin):%d:%d-%d:%s\n", li+1, idx[0], idx[1], matched)
+		}
+	}
+	if c.failNone && !anyMatch {
+		fmt.Fprintf(os.Stderr, "Error: Error applying: No input was in scope\n")
+		return 1
+	}
+	if c.failAny && anyMatch {
+		fmt.Fprintf(os.Stderr, "Error: Error applying: Some input was in scope\n")
+		return 1
+	}
+	// Reference: in search mode, return rc=1 when the scope regex matches
+	// nothing (even without a --fail flag).
+	if !anyMatch {
+		return 1
+	}
+	return 0
+}
+
+func splitLines(text string) []string {
+	if text == "" {
+		return nil
+	}
+	var lines []string
+	for i := 0; i < len(text); {
+		j := strings.IndexByte(text[i:], '\n')
+		if j < 0 {
+			lines = append(lines, text[i:])
+			break
+		}
+		lines = append(lines, text[i:i+j])
+		i += j + 1
+	}
+	return lines
+}
+
+// ---------------------------------------------------------------------------
+// Data tables
+// ---------------------------------------------------------------------------
+
+var accentedMap = map[rune]rune{
+	'à': 'a', 'á': 'a', 'â': 'a', 'ã': 'a', 'ä': 'a', 'å': 'a', 'æ': 'a',
+	'è': 'e', 'é': 'e', 'ê': 'e', 'ë': 'e', 'ì': 'i', 'í': 'i', 'î': 'i', 'ï': 'i',
+	'ò': 'o', 'ó': 'o', 'ô': 'o', 'õ': 'o', 'ö': 'o', 'ø': 'o',
+	'ù': 'u', 'ú': 'u', 'û': 'u', 'ü': 'u', 'ý': 'y', 'ð': 'd', 'ç': 'c', 'ñ': 'n',
+	'¿': '?', '¡': '!',
+}
