++                    k = j
++                    while k < len(line) and line[k] != ')':
++                        k += 1
++                    if k < len(line):
++                        k += 1
++                    tokens.append(('variable_expansion', line[i:k]))
++                    i = k
++                    continue
++            elif j < len(line) and (line[j].isalnum() or line[j] == '_'):
++                # $var
++                k = j
++                while k < len(line) and (line[k].isalnum() or line[k] == '_'):
++                    k += 1
++                tokens.append(('variable', line[i:k]))
++                i = k
++                continue
++            else:
++                # $ (unquoted)
++                tokens.append(('variable', line[i]))
++                i += 1
++                continue
++        
++        # Backtick command substitution - quote
++        if line[i] == '`':
++            j = i + 1
++            while j < len(line) and line[j] != '`':
++                j += 1
++            if j < len(line):
++                j += 1
++            tokens.append(('command', line[i:j]))
++            i = j
++            continue
++        
++        # Double-quoted command substitution - quote
++        if line[i:i+2] == '$(':
++            j = i + 2
++            while j < len(line) and line[j] != ')':
++                j += 1
++            if j < len(line):
++                j += 1
++            tokens.append(('command', line[i:j]))
++            i = j
++            continue
++        
++        # Regular words - pass through
++        j = i
++        while j < len(line) and not line[j].isspace() and line[j] not in '"\\$`':
++            j += 1
++        if j > i:
++            tokens.append(('command', line[i:j]))
++            i = j
++            continue
++        
++        i += 1
++    
++    return tokens
++
