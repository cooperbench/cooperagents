++def highlight_tokens(tokens: List[Tuple[str, str]], mode: str = 'syntax') -> str:
++    """
++    Apply highlighting to tokens.
++    mode: 'syntax' - just syntax highlighting
++          'suggest' - highlight changes with background color
++    """
++    result = []
++    for token_type, text in tokens:
++        if mode == 'suggest':
++            if token_type in HIGHLIGHT_COLORS:
++                result.append(HIGHLIGHT_COLORS[token_type] + text + RESET)
++            else:
++                result.append(text)
++        else:
++            if token_type in COLORS:
++                result.append(COLORS[token_type] + text + RESET)
++            else:
++                result.append(text)
++    return ''.join(result)
