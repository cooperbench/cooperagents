++def tokenize_line(line: str) -> List[Tuple[str, str]]:
++    """
++    Tokenize a line into (token_type, token_text) pairs.
++    Token types: 'comment', 'keyword', 'string', 'string_single', 'variable',
++                 'variable_expansion', 'command', 'operator', 'special', 'whitespace'
