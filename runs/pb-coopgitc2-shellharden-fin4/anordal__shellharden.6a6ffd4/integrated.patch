++    tokens = []
++    i = 0
++    line = line.rstrip('\n\r')
++    
++    while i < len(line):
++        # Skip whitespace
++        if line[i].isspace():
++            j = i
++            while j < len(line) and line[j].isspace():
++                j += 1
++            if j > i:
++                tokens.append(('whitespace', line[i:j]))
++            i = j
++            continue
++        
++        # Comments
++        if line[i] == '#':
++            j = i
++            while j < len(line) and line[j] != '\n':
++                j += 1
++            tokens.append(('comment', line[i:j]))
++            i = j
++            continue
++        
++        # Shebang
++        if i == 0 and line.startswith('#!'):
++            j = i
++            while j < len(line) and line[j] != '\n':
++                j += 1
++            tokens.append(('special', line[i:j]))
++            i = j
++            continue
++        
++        # Strings (double-quoted)
++        if line[i] == '"':
++            j = i + 1
++            while j < len(line):
++                if line[j] == '\\' and j + 1 < len(line):
++                    j += 2
++                elif line[j] == '"':
++                    j += 1
++                    break
++                else:
++                    j += 1
++            tokens.append(('string', line[i:j]))
++            i = j
++            continue
++        
++        # Single-quoted strings
++        if line[i] == "'":
++            j = i + 1
++            while j < len(line) and line[j] != "'":
++                j += 1
++            if j < len(line):
++                j += 1
++            tokens.append(('string_single', line[i:j]))
++            i = j
++            continue
++        
++        # Variable expansions - quote them
++        if line[i] == '$':
++            j = i + 1
++            if j < len(line) and line[j] == '{':
++                # ${var}
++                k = j + 1
++                while k < len(line) and line[k] != '}':
++                    k += 1
++                if k < len(line):
++                    k += 1
++                tokens.append(('variable_expansion', line[i:k]))
++                i = k
++                continue
++            elif j < len(line) and line[j] == '(':
++                # $((expr)) or $(cmd)
++                k = j + 1
++                if k < len(line) and line[k] == '(':
++                    # $((expr))
++                    m = k + 1
++                    while m < len(line) and line[m] != ')':
++                        m += 1
++                    if m < len(line):
++                        m += 1
