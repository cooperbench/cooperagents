+    result = []
+    for token_type, text in tokens:
+        if mode == 'suggest':
+            if token_type in HIGHLIGHT_COLORS:
+                result.append(HIGHLIGHT_COLORS[token_type] + text + RESET)
+            else:
+                result.append(text)
+        else:
+            if token_type in COLORS:
+                result.append(COLORS[token_type] + text + RESET)
+            else:
+                result.append(text)
+    return ''.join(result)
+
+
+def transform_line(line: str) -> str:
+    """
+    Apply transformations to make the line more shell-safe.
+    Mainly adds quotes around variables.
+    """
+    result = []
+    i = 0
+    line = line.rstrip('\n\r')
+    
+    while i < len(line):
+        # Skip whitespace
+        if line[i].isspace():
+            result.append(line[i])
+            i += 1
+            continue
+        
+        # Comments - pass through
+        if line[i] == '#':
+            result.append(line[i:])
+            break
+        
+        # Shebang - pass through
+        if i == 0 and line.startswith('#!'):
+            result.append(line[i:])
+            break
+        
+        # Strings - pass through
+        if line[i] == '"':
+            j = i + 1
+            while j < len(line):
+                if line[j] == '\\' and j + 1 < len(line):
+                    result.append(line[j:j+2])
+                    j += 2
+                elif line[j] == '"':
+                    result.append(line[j])
+                    j += 1
+                    break
+                else:
+                    result.append(line[j])
+                    j += 1
+            i = j
+            continue
+        
+        # Single-quoted strings - pass through
+        if line[i] == "'":
+            j = i + 1
+            while j < len(line) and line[j] != "'":
+                result.append(line[j])
+                j += 1
+            if j < len(line):
+                result.append(line[j])
+                j += 1
+            i = j
+            continue
+        
+        # Variable expansions - quote them
+        if line[i] == '$':
+            j = i + 1
+            if j < len(line) and line[j] == '{':
+                # ${var}
+                k = j + 1
+                while k < len(line) and line[k] != '}':
+                    k += 1
+                if k < len(line):
+                    k += 1
+                result.append('"' + line[i:k] + '"')
+                i = k
+                continue
+            elif j < len(line) and line[j] == '(':
+                # $((expr)) or $(cmd)
+                k = j + 1
+                if k < len(line) and line[k] == '(':
+                    # $((expr))
+                    m = k + 1
+                    while m < len(line) and line[m] != ')':
+                        m += 1
+                    if m < len(line):
+                        m += 1
+                    result.append('"') + line[i:m] + '"'
+                    i = m
+                    continue
+                else:
+                    # $(cmd)
+                    k = j
+                    while k < len(line) and line[k] != ')':
+                        k += 1
+                    if k < len(line):
+                        k += 1
+                    result.append('"' + line[i:k] + '"')
+                    i = k
+                    continue
+            elif j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                # $var
+                k = j
+                while k < len(line) and (line[k].isalnum() or line[k] == '_'):
+                    k += 1
+                result.append('"' + line[i:k] + '"')
+                i = k
+                continue
+            else:
+                # $ (unquoted)
+                result.append('"') + line[i] + '"'
+                i += 1
+                continue
+        
+        # Backtick command substitution - quote
+        if line[i] == '`':
+            j = i + 1
+            while j < len(line) and line[j] != '`':
+                j += 1
+            if j < len(line):
+                j += 1
+            result.append('"' + line[i:j] + '"')
+            i = j
+            continue
+        
+        # Double-quoted command substitution - quote
+        if line[i:i+2] == '$(':
+            j = i + 2
+            while j < len(line) and line[j] != ')':
+                j += 1
+            if j < len(line):
+                j += 1
+            result.append('"' + line[i:j] + '"')
+            i = j
+            continue
+        
+        # Regular words - pass through
+        j = i
+        while j < len(line) and not line[j].isspace() and line[j] not in '"\\$`':
+            j += 1
+        result.append(line[i:j])
+        i = j
+        continue
+    
+    return ''.join(result)
+
+
+def process_file(filepath: str, mode: str, transform: bool = False) -> str:
+    """
+    Process a file and return the output.
+    """
+    with open(filepath, 'r') as f:
+        lines = f.readlines()
+    
+    if mode == 'transform':
+        return ''.join(transform_line(line) for line in lines)
+    else:
+        # Syntax highlighting
+        result = []
+        for line in lines:
+            tokens = tokenize_line(line)
+            highlighted = highlight_tokens(tokens, mode)
+            result.append(highlighted)
+        return ''.join(result)
+
+
+def process_stdin(mode: str, transform: bool = False) -> str:
+    """
+    Process stdin and return the output.
+    """
+    content = sys.stdin.read()
+    if not content:
+        return ''
+    
+    if mode == 'transform':
+        return transform_line(content)
+    else:
+        # Syntax highlighting
+        tokens = tokenize_line(content)
+        highlighted = highlight_tokens(tokens, mode)
+        return highlighted
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        prog='shellharden',
+        description='Shellharden: The corrective bash syntax highlighter.',
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog='''
+The changes suggested by Shellharden inhibits word splitting and indirect
+pathname expansion. This will make your script ShellCheck compliant in terms of
+quoting. Whether your script will work afterwards is a different question:
+If your script was using those features on purpose, it obviously won't anymore!
+
+Every script is possible to write without using word splitting or indirect
+pathname expansion, but it may involve doing things differently.
+See the accompanying file how_to_do_things_safely_in_bash.md or online:
+https://github.com/anordal/shellharden/blob/master/how_to_do_things_safely_in_bash.md
+'''
+    )
+    
+    parser.add_argument('--suggest', action='store_true',
+                        help='Output a colored diff suggesting changes.')
+    parser.add_argument('--syntax', action='store_true',
+                        help='Output syntax highlighting with ANSI colors.')
+    parser.add_argument('--syntax-suggest', action='store_true',
+                        help='Diff with syntax highlighting (default mode).')
+    parser.add_argument('--transform', action='store_true',
+                        help='Output suggested changes.')
+    parser.add_argument('--check', action='store_true',
+                        help='No output; exit with 2 if changes are suggested.')
+    parser.add_argument('--replace', action='store_true',
+                        help='Replace file contents with suggested changes.')
+    parser.add_argument('--version', action='store_true',
+                        help='Show version.')
+    parser.add_argument('files', nargs='*', metavar='FILES',
+                        help='Files to process.')
+    # -h is provided by argparse by default
+    
+    args = parser.parse_args()
+    
+    if args.version:
+        print(VERSION)
+        return 0
+    
+    # Determine mode
+    if args.suggest:
+        mode = 'suggest'
+    elif args.syntax:
+        mode = 'syntax'
+    elif args.syntax_suggest:
+        mode = 'syntax'
+    elif args.transform:
+        mode = 'transform'
+    elif args.check:
+        mode = 'check'
+    elif args.replace:
+        mode = 'transform'  # Replace uses transform mode
+    else:
+        mode = 'syntax'  # Default
+    
+    # If replace is used, we need to use transform mode for processing
+    use_transform = args.replace
+    
+    # Handle -- flag
+    files = args.files if args.files else []
+    
+    if not files:
+        # Read from stdin
+        if mode == 'transform':
+            output = process_stdin('transform', transform=True)
+        elif mode == 'check':
+            # Check mode: no output, exit with 2 if changes are suggested
+            content = sys.stdin.read()
+            if not content:
+                return 0
+            tokens = tokenize_line(content)
+            has_changes = any(tt in ('variable', 'variable_expansion') for tt, _ in tokens)
+            if has_changes:
+                return 2
+            return 0
+        else:
+            output = process_stdin(mode, transform=False)
+        print(output, end='')
+    
+    # Process files
+    for filepath in files:
+        if args.replace:
+            # Replace mode: transform and write back
+            with open(filepath, 'r') as f:
+                content = f.read()
+            new_content = transform_line(content)
+            with open(filepath, 'w') as f:
+                f.write(new_content)
+        elif mode == 'check':
+            # Check mode: no output, exit with 2 if changes are suggested
+            with open(filepath, 'r') as f:
+                content = f.read()
+            tokens = tokenize_line(content)
+            has_changes = any(tt in ('variable', 'variable_expansion') for tt, _ in tokens)
+            if has_changes:
+                return 2
+            return 0
+        else:
+            if mode == 'transform' or use_transform:
+                output = process_file(filepath, 'transform', transform=True)
+            else:
+                output = process_file(filepath, mode, transform=False)
+            print(output, end='')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
