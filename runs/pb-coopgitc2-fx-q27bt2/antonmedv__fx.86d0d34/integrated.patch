+// printComp prints the completion script for the given shell, or "unknown shell type".
+func printComp(shell string) {
+	switch shell {
+	case "bash":
+		os.Stdout.Write(compBash)
+	case "fish":
+		os.Stdout.Write(compFish)
+	case "zsh":
+		os.Stdout.Write(compZsh)
+	default:
+		fmt.Println("unknown shell type")
+	}
+}
+
+// dataProcessing tries to open /dev/tty for the interactive viewer; without a TTY
+// it panics exactly like the reference binary.
+func dataProcessing() {
+	openTTY()
+}
+
+// openTTY opens /dev/tty; on failure it prints the fixed reference panic and exits 2.
+func openTTY() {
+	_, err := os.OpenFile("/dev/tty", os.O_RDWR, 0)
+	if err != nil {
+		os.Stderr.Write(panicStderr)
+		os.Exit(2)
+	}
