++// refErr builds the reference "ReferenceError: <name> is not defined" block.
++func refErr(flag string) {
++	var b bytes.Buffer
++	b.WriteString("\n")
++	b.WriteString("  ")
++	b.WriteString(flag)
++	b.WriteString("\n  ")
++	for i := 0; i < len(flag); i++ {
++		b.WriteByte('^')
++	}
++	b.WriteString("\n\n")
++	name := strings.TrimPrefix(flag, "-")
++	b.WriteString("ReferenceError: ")
++	b.WriteString(name)
++	b.WriteString(" is not defined\n")
++	os.Stdout.Write(b.Bytes())
++	os.Exit(1)
++}
