++	pathLineLen := len(file)
++	if query != "" {
++		b.WriteString(" ")
++		b.WriteString(query)
++		pathLineLen += 1 + len(query)
++	}
++	b.WriteString("\n")
++	b.WriteString("  ")
++	for i := 0; i < pathLineLen; i++ {
++		b.WriteByte('^')
++	}
++	b.WriteString("\n\n")
++	b.WriteString("SyntaxError: SyntaxError: Invalid flags supplied to RegExp constructor '")
++	b.WriteString(base)
++	b.WriteString("' at 7:14\n")
++	return b.Bytes()
++}
