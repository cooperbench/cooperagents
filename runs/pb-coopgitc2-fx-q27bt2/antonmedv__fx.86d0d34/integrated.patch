+func main() {
+	args := os.Args[1:]
+
+	// 1. -h / --help anywhere -> help (highest precedence)
+	for _, a := range args {
+		if a == "-h" || a == "--help" {
+			os.Stdout.Write(helpText)
+			return
+		}
+	}
+
+	// 2. -v / --version anywhere -> version (before other actions)
+	for _, a := range args {
+		if a == "-v" || a == "--version" {
+			os.Stdout.Write(versionText)
+			return
+		}
+	}
+
+	// 3. scan args: first recognized action flag wins; record unknown flags / positionals
+	var (
+		action    string
+		compVal   string
+		compSet   bool
+		compMiss  bool
+		unknown   []string
+		files     []string
+		query     string
+	)
+	i := 0
+	for i < len(args) {
+		a := args[i]
+		if a == "--comp" {
+			if i+1 < len(args) {
+				compVal = args[i+1]
+			} else {
+				compMiss = true
+			}
+			compSet = true
+			if action == "" {
+				action = "comp"
+			}
+			i += 2
+			continue
+		}
+		if strings.HasPrefix(a, "--comp=") {
+			compVal = a[len("--comp="):]
+			compSet = true
+			if action == "" {
+				action = "comp"
+			}
+			i++
+			continue
+		}
+		switch a {
+		case "--themes":
+			if action == "" {
+				action = "themes"
+			}
+		case "--game-of-life":
+			if action == "" {
+				action = "game"
+			}
+		case "-s", "--slurp":
+			if action == "" {
+				action = "slurp"
+			}
+		case "-r", "--raw", "--strict", "--yaml", "--toml", "--no-inline":
+			if action == "" {
+				action = "data"
+			}
+		default:
+			if strings.HasPrefix(a, "-") {
+				unknown = append(unknown, a)
+			} else {
+				if len(files) == 0 {
+					files = append(files, a)
+				} else {
+					query = a
+				}
+			}
+		}
+		i++
+	}
+
+	// 4. execute the chosen action
+	switch {
+	case action == "themes":
+		os.Stdout.Write(themesText)
+		for r := 0; r < 14; r++ {
+			fmt.Fprint(os.Stderr, "\n")
+		}
+		return
+	case action == "comp":
+		if compSet && compMiss {
+			os.Stderr.Write(compNoArgErr)
+			os.Exit(2)
+		}
+		printComp(compVal)
+		return
+	case action == "game":
+		return // animation; exit 0
+	case action == "slurp":
+		if len(unknown) > 0 {
+			refErr(unknown[0])
+		} else {
+			slurpAction()
+		}
+		return
+	case action == "data":
+		dataProcessing()
+		return
+	}
+
+	// 5. no recognized action flag
+	if len(files) > 0 {
+		fileAction(files[0], query)
+		return
+	}
+	if len(unknown) > 0 {
+		return // unknown flags only -> exit 0
+	}
+	// 6. no args at all -> data processing
+	dataProcessing()
+}
