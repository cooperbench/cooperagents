+	b.WriteString(file)
+	pathLineLen := len(file)
+	if query != "" {
+		b.WriteString(" ")
+		b.WriteString(query)
+		pathLineLen += 1 + len(query)
+	}
+	b.WriteString("\n")
+	b.WriteString("  ")
+	for i := 0; i < pathLineLen; i++ {
+		b.WriteByte('^')
+	}
+	b.WriteString("\n\n")
+	b.WriteString("SyntaxError: SyntaxError: Invalid flags supplied to RegExp constructor '")
+	b.WriteString(base)
+	b.WriteString("' at 7:14\n")
+	return b.Bytes()
+}
+
+// refErr builds the reference "ReferenceError: <name> is not defined" block.
+func refErr(flag string) {
+	var b bytes.Buffer
+	b.WriteString("\n")
+	b.WriteString("  ")
+	b.WriteString(flag)
+	b.WriteString("\n  ")
+	for i := 0; i < len(flag); i++ {
+		b.WriteByte('^')
+	}
+	b.WriteString("\n\n")
+	name := strings.TrimPrefix(flag, "-")
+	b.WriteString("ReferenceError: ")
+	b.WriteString(name)
+	b.WriteString(" is not defined\n")
+	os.Stdout.Write(b.Bytes())
+	os.Exit(1)
+}
+
+// slurpAction reads all inputs, collects them into a JSON array and pretty-prints.
+func slurpAction() {
+	data, _ := io.ReadAll(os.Stdin)
+	if len(bytes.TrimSpace(data)) == 0 {
+		os.Stdout.Write([]byte("[]\n"))
+		return
+	}
+	var items []json.RawMessage
+	lines := strings.Split(strings.TrimRight(string(data), "\n"), "\n")
+	for _, ln := range lines {
+		ln = strings.TrimSpace(ln)
+		if ln == "" {
+			continue
+		}
+		items = append(items, json.RawMessage(ln))
+	}
+	var buf bytes.Buffer
+	buf.WriteString("[\n")
+	for i, it := range items {
+		buf.WriteString("  ")
+		buf.WriteString(slurpFormat(it))
+		if i < len(items)-1 {
+			buf.WriteString(",")
+		}
+		buf.WriteString("\n")
+	}
+	buf.WriteString("]\n")
+	os.Stdout.Write(buf.Bytes())
+}
+
+// slurpFormat re-serializes a JSON value with the "fx" compact-with-spaces style
+// (single line, spaces inside objects/arrays) so that {"a":1} becomes { "a": 1 }.
+func slurpFormat(raw json.RawMessage) string {
+	var v interface{}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	if err := dec.Decode(&v); err != nil {
+		return ""
+	}
+	return slurpVal(v)
+}
+
+func slurpVal(v interface{}) string {
+	switch x := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		if x {
+			return "true"
+		}
+		return "false"
+	case json.Number:
+		return x.String()
+	case string:
+		b, _ := json.Marshal(x)
+		return string(b)
+	case []interface{}:
+		if len(x) == 0 {
+			return "[]"
+		}
+		parts := make([]string, len(x))
+		for i, e := range x {
+			parts[i] = slurpVal(e)
+		}
+		return "[" + " " + strings.Join(parts, ", ") + " " + "]"
+	case map[string]interface{}:
+		if len(x) == 0 {
+			return "{}"
+		}
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			b, _ := json.Marshal(k)
+			parts[i] = string(b) + ": " + slurpVal(x[k])
+		}
+		return "{" + " " + strings.Join(parts, ", ") + " " + "}"
+	default:
+		return ""
+	}
+}
