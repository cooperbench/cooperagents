+"""
+Shellharden: The corrective bash syntax highlighter.
+Version 4.3.1
+"""
+
+import sys
+import re
+import argparse
+import os
+
+VERSION = "4.3.1"
+
+# ANSI color codes
+RESET = "\033[0m"
+BOLD = "\033[1m"
+KEYWORD_COLOR = "\033[0;38;2;192;0;128m"
+STRING_COLOR = "\033[0;38;2;255;0;0m"
+VARIABLE_COLOR = "\033[0;38;2;63;127;207m"
+NUMBER_COLOR = "\033[0;38;2;0;127;255m"
+COMMENT_COLOR = "\033[0;38;2;0;127;255m"
+SUGGEST_COLOR = "\033[0;42m"
+SUGGEST_RESET = "\033[0m"
+
+KEYWORDS = {"if", "then", "else", "fi", "for", "do", "done", "while", "esac",
+            "case", "in", "function", "return", "local", "export", "declare",
+            "readonly", "unset", "shift", "read", "echo", "printf", "test",
+            "[", "]", "true", "false", "exit", "break", "continue", "set",
+            "alias", "unalias", "type", "which", "where", "hash",
+            "command", "builtin", "enable", "disable", "trap", "exec", "cd",
+            "pwd", "pushd", "popd", "dirs", "eval", "source", ".",
+            "mapfile", "readarray", "getopts", "typeset", "nameref", "coproc",
+            "select", "times", "ulimit", "umask", "shopt", "opterr", "optreset",
+            "optplus", "optextglob", "optlocal", "optpipefail",
+            "optglobstar", "optnullglob", "optdotglob", "optfail", "optnocasematch",
+            "optglob", "optinherit", "optlastpipe", "optxpglob"}
+
+def parse_args():
+    parser = argparse.ArgumentParser(
+        prog="shellharden",
+        description="The corrective bash syntax highlighter.",
+        epilog="Version " + VERSION,
+        formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    parser.add_argument("file", nargs="?", help="Bash script file to analyze")
+    parser.add_argument("-v", "--version", action="version", version="shellharden " + VERSION)
+    parser.add_argument("-c", "--color", action="store_true", default=True,
+                        help="Enable color output (default)")
+    parser.add_argument("-n", "--no-color", action="store_true",
+                        help="Disable color output")
+    parser.add_argument("-q", "--quiet", action="store_true",
+                        help="Suppress all output except suggestions")
+    parser.add_argument("-s", "--suggest", action="store_true",
+                        help="Show suggestions for fixes")
+    parser.add_argument("-f", "--fix", action="store_true",
+                        help="Apply suggested fixes to the file")
+    parser.add_argument("-l", "--list", action="store_true",
+                        help="List all keywords")
+    return parser.parse_args()
+
+def highlight_line(line, suggest=False):
+    """Highlight a single line of bash code."""
+    result = []
+    pos = 0
+    line = line.rstrip()
+    
+    while pos < len(line):
+        # Check for comments
+        if line[pos] == "#":
+            result.append(COMMENT_COLOR + line[pos:])
+            break
+        # Check for strings
+        elif line[pos] in '"\'':
+            quote = line[pos]
+            end = line.find(quote, pos + 1)
+            if end == -1:
+                end = len(line)
+            result.append(STRING_COLOR + line[pos:end + 1])
+            pos = end + 1
+            continue
+        # Check for variables
+        elif line[pos] == "$":
+            end = pos + 1
+            while end < len(line) and (line[end].isalnum() or line[end] in "_{}[]"):
+                end += 1
+            result.append(VARIABLE_COLOR + line[pos:end])
+            pos = end
+            continue
+        # Check for numbers
+        elif line[pos].isdigit():
+            end = pos
+            while end < len(line) and line[end].isdigit():
+                end += 1
+            result.append(NUMBER_COLOR + line[pos:end])
+            pos = end
+            continue
+        # Check for keywords
+        elif line[pos:].lower().startswith("if"):
+            result.append(KEYWORD_COLOR + "if")
+            pos += 2
+            continue
+        elif line[pos:].lower().startswith("then"):
+            result.append(KEYWORD_COLOR + "then")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("else"):
+            result.append(KEYWORD_COLOR + "else")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("fi"):
+            result.append(KEYWORD_COLOR + "fi")
+            pos += 2
+            continue
+        elif line[pos:].lower().startswith("for"):
+            result.append(KEYWORD_COLOR + "for")
+            pos += 3
+            continue
+        elif line[pos:].lower().startswith("do"):
+            result.append(KEYWORD_COLOR + "do")
+            pos += 2
+            continue
+        elif line[pos:].lower().startswith("done"):
+            result.append(KEYWORD_COLOR + "done")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("while"):
+            result.append(KEYWORD_COLOR + "while")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("esac"):
+            result.append(KEYWORD_COLOR + "esac")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("case"):
+            result.append(KEYWORD_COLOR + "case")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("in"):
+            result.append(KEYWORD_COLOR + "in")
+            pos += 2
+            continue
+        elif line[pos:].lower().startswith("function"):
+            result.append(KEYWORD_COLOR + "function")
+            pos += 8
+            continue
+        elif line[pos:].lower().startswith("return"):
+            result.append(KEYWORD_COLOR + "return")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("local"):
+            result.append(KEYWORD_COLOR + "local")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("export"):
+            result.append(KEYWORD_COLOR + "export")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("declare"):
+            result.append(KEYWORD_COLOR + "declare")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("readonly"):
+            result.append(KEYWORD_COLOR + "readonly")
+            pos += 8
+            continue
+        elif line[pos:].lower().startswith("unset"):
+            result.append(KEYWORD_COLOR + "unset")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("shift"):
+            result.append(KEYWORD_COLOR + "shift")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("read"):
+            result.append(KEYWORD_COLOR + "read")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("printf"):
+            result.append(KEYWORD_COLOR + "printf")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("true"):
+            result.append(KEYWORD_COLOR + "true")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("false"):
+            result.append(KEYWORD_COLOR + "false")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("exit"):
+            result.append(KEYWORD_COLOR + "exit")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("break"):
+            result.append(KEYWORD_COLOR + "break")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("continue"):
+            result.append(KEYWORD_COLOR + "continue")
+            pos += 8
+            continue
+        elif line[pos:].lower().startswith("set"):
+            result.append(KEYWORD_COLOR + "set")
+            pos += 3
+            continue
+        elif line[pos:].lower().startswith("alias"):
+            result.append(KEYWORD_COLOR + "alias")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("unalias"):
+            result.append(KEYWORD_COLOR + "unalias")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("type"):
+            result.append(KEYWORD_COLOR + "type")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("which"):
+            result.append(KEYWORD_COLOR + "which")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("where"):
+            result.append(KEYWORD_COLOR + "where")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("hash"):
+            result.append(KEYWORD_COLOR + "hash")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("command"):
+            result.append(KEYWORD_COLOR + "command")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("builtin"):
+            result.append(KEYWORD_COLOR + "builtin")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("enable"):
+            result.append(KEYWORD_COLOR + "enable")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("disable"):
+            result.append(KEYWORD_COLOR + "disable")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("trap"):
+            result.append(KEYWORD_COLOR + "trap")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("exec"):
+            result.append(KEYWORD_COLOR + "exec")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("cd"):
+            result.append(KEYWORD_COLOR + "cd")
+            pos += 2
+            continue
+        elif line[pos:].lower().startswith("pwd"):
+            result.append(KEYWORD_COLOR + "pwd")
+            pos += 3
+            continue
+        elif line[pos:].lower().startswith("pushd"):
+            result.append(KEYWORD_COLOR + "pushd")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("popd"):
+            result.append(KEYWORD_COLOR + "popd")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("dirs"):
+            result.append(KEYWORD_COLOR + "dirs")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("eval"):
+            result.append(KEYWORD_COLOR + "eval")
+            pos += 4
+            continue
+        elif line[pos:].lower().startswith("source"):
+            result.append(KEYWORD_COLOR + "source")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("mapfile"):
+            result.append(KEYWORD_COLOR + "mapfile")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("readarray"):
+            result.append(KEYWORD_COLOR + "readarray")
+            pos += 9
+            continue
+        elif line[pos:].lower().startswith("getopts"):
+            result.append(KEYWORD_COLOR + "getopts")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("typeset"):
+            result.append(KEYWORD_COLOR + "typeset")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("nameref"):
+            result.append(KEYWORD_COLOR + "nameref")
+            pos += 7
+            continue
+        elif line[pos:].lower().startswith("coproc"):
+            result.append(KEYWORD_COLOR + "coproc")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("select"):
+            result.append(KEYWORD_COLOR + "select")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("times"):
+            result.append(KEYWORD_COLOR + "times")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("ulimit"):
+            result.append(KEYWORD_COLOR + "ulimit")
+            pos += 6
+            continue
+        elif line[pos:].lower().startswith("umask"):
+            result.append(KEYWORD_COLOR + "umask")
+            pos += 5
+            continue
+        elif line[pos:].lower().startswith("shopt"):
+            result.append(KEYWORD_COLOR + "shopt")
+            pos += 5
+            continue
+        else:
+            result.append(line[pos])
+            pos += 1
+    
+    return "".join(result)
+
+def analyze_file(filepath, suggest=False, fix=False):
+    """Analyze a bash script file and return issues."""
+    issues = []
+    try:
+        with open(filepath, "r") as f:
+            lines = f.readlines()
+    except FileNotFoundError:
+        print(f"Error: File not found: {filepath}", file=sys.stderr)
+        return 1
+    except IOError as e:
+        print(f"Error reading file: {e}", file=sys.stderr)
+        return 1
+    
+    for i, line in enumerate(lines, 1):
+        stripped = line.strip()
+        if stripped.startswith("#") or stripped == "":
+            continue
+        
+        # Check for common issues
+        if stripped.startswith("if") and not stripped.startswith("if ["):
+            if not stripped.endswith("then"):
+                issues.append((i, "Missing 'then' after 'if'"))
+        
+        if stripped.startswith("for") and not stripped.endswith("do"):
+            issues.append((i, "Missing 'do' after 'for'"))
+        
+        if stripped.startswith("while") and not stripped.endswith("do"):
+            issues.append((i, "Missing 'do' after 'while'"))
+        
+        if stripped.startswith("case") and not stripped.endswith("in"):
+            issues.append((i, "Missing 'in' after 'case'"))
+        
+        if stripped.startswith("function") and not stripped.endswith("("):
+            issues.append((i, "Missing '(' after 'function'"))
+        
+        if stripped.startswith("do") and not stripped.endswith("done"):
+            issues.append((i, "Missing 'done' after 'do'"))
+        
+        if stripped.startswith("then") and not stripped.endswith("fi"):
+            issues.append((i, "Missing 'fi' after 'then'"))
+        
+        if stripped.startswith("else") and not stripped.endswith("fi"):
+            issues.append((i, "Missing 'fi' after 'else'"))
+    
+    return issues
+
+def main():
+    args = parse_args()
+    
+    if args.list:
+        for kw in sorted(KEYWORDS):
+            print(kw)
+        return 0
+    
+    if args.file is None:
+        print("Usage: shellharden [OPTIONS] [FILE]", file=sys.stderr)
+        print("Analyze a bash script for syntax issues.", file=sys.stderr)
+        return 1
+    
+    filepath = args.file
+    issues = analyze_file(filepath, args.suggest, args.fix)
+    
+    if issues:
+        print(f"Found {len(issues)} issue(s) in {filepath}:")
+        for line_num, msg in issues:
+            print(f"  Line {line_num}: {msg}")
+        return 1
+    else:
+        print(f"No issues found in {filepath}")
+        return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
+PYEOF
+
+chmod +x executable
