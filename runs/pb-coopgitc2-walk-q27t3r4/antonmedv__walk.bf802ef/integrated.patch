@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+import os, pty, sys, time, select, fcntl, termios, struct, signal
+
+def run(args, inputs, size=(80,24), cwd=None, env=None, total=4.0, out='/tmp/out.bin', autoresp=True):
+    pid, fd = pty.fork()
+    if pid == 0:
+        if cwd: os.chdir(cwd)
+        e = dict(os.environ)
+        if env: e.update(env)
+        os.execvpe(args[0], args, e)
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', size[1], size[0], 0, 0))
+    data = b''
+    buf = b''
+    start = time.time()
+    input_idx = 0
+    code = None
+    def now(): return round(time.time()-start, 2)
+    log = lambda *a: print(*a, file=sys.stderr)
+    while True:
+        if time.time() - start > total:
+            try: os.kill(pid, signal.SIGKILL)
+            except ProcessLookupError: pass
+            code = -9
+            log("TIMEOUT")
+            break
+        r, _, _ = select.select([fd], [], [], 0.05)
+        if fd in r:
+            try:
+                chunk = os.read(fd, 65536)
+                if not chunk:
+                    log("EOF at", now())
+                    break
+                data += chunk; buf += chunk
+                if autoresp:
+                    changed = True
+                    while changed:
+                        changed = False
+                        if b'\x1b]11;?' in buf:
+                            i = buf.find(b'\x1b]11;?')
+                            j = buf.find(b'\x1b\\', i)
+                            if j != -1:
+                                os.write(fd, b'\x1b]11;rgb:1e1e1e/1e1e1e\x1b\\')
+                                buf = buf[:i] + buf[j+3:]; changed = True; continue
+                        if b'\x1b[6n' in buf:
+                            i = buf.find(b'\x1b[6n')
+                            os.write(fd, b'\x1b[1;1R')
+                            buf = buf[:i]; changed = True
+            except OSError:
+                log("EIO at", now())
+                break
+        while input_idx < len(inputs) and time.time() - start >= inputs[input_idx][0]:
+            log("send", now(), repr(inputs[input_idx][1][:40]))
+            os.write(fd, inputs[input_idx][1]); input_idx += 1
+        p, st = os.waitpid(pid, os.WNOHANG)
+        if p == pid:
+            if os.WIFEXITED(st): code = os.WEXITSTATUS(st)
+            elif os.WIFSIGNALED(st): code = -os.WTERMSIG(st)
+            else: code = None
+            log("child exited at", now(), "code", code)
+            while True:
+                r, _, _ = select.select([fd], [], [], 0.1)
+                if fd in r:
+                    try:
+                        chunk = os.read(fd, 65536)
+                        if not chunk: break
+                        data += chunk
+                    except OSError: break
+                else: break
+            break
+    try: os.close(fd)
+    except OSError: pass
+    open(out,'wb').write(data)
+    log("bytes:", len(data))
+    return data, code
+
+if __name__ == '__main__':
+    import json
+    cfg = json.load(open(sys.argv[1]))
+    data, code = run(cfg['args'], [(i[0], i[1].encode('utf-8')) for i in cfg.get('inputs',[])],
+                     size=tuple(cfg.get('size',(80,24))), cwd=cfg.get('cwd'), env=cfg.get('env'),
+                     total=cfg.get('total',4.0), out=cfg.get('out','/tmp/out.bin'),
+                     autoresp=cfg.get('autoresp', True))
+    print(f"FINAL EXIT: {code}", file=sys.stderr)
diff --git a/probe/run.py b/probe/run.py
new file mode 100644
index 0000000..f3fef65
--- /dev/null
+++ b/probe/run.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Probe runner v2: PTY + VT emulation + query responses + scripted keys."""
+import os, pty, sys, time, select, fcntl, termios, struct, signal, json
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from vt import VT
+
+def run(args, inputs, size=(80,24), cwd=None, env=None, total=4.0, out='/tmp/out.bin',
+        osc=None, dsr='\x1b[1;1R', dsr_at=0.5, osc_at=0.2, show=True, label=''):
+    """osc/dsr: response string to send (None = don't send); *_at: absolute time to send."""
+    pid, fd = pty.fork()
+    if pid == 0:
+        try:
+            if cwd: os.chdir(cwd)
+            e = dict(os.environ)
+            if env:
+                for k, v in env.items():
+                    if v is None: del e[k]
+                    else: e[k] = v
+            os.execvpe(args[0], args, e)
+        except Exception as ex:
+            os.write(2, str(ex).encode()); os._exit(127)
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', size[1], size[0], 0, 0))
+    vt = VT(size[0], size[1])
+    data = b''; start = time.time(); iidx = 0; code = None
+    sent1 = sent2 = False
+    def now(): return round(time.time()-start, 2)
+    def log(*a): print(*a, file=sys.stderr)
+    if label: log(f"== {label}")
+    while True:
+        if time.time() - start > total:
+            try: os.kill(pid, signal.SIGKILL)
+            except ProcessLookupError: pass
+            code = -9; log("TIMEOUT"); break
+        r, _, _ = select.select([fd], [], [], 0.05)
+        if fd in r:
+            try:
+                chunk = os.read(fd, 65536)
+            except OSError:
+                chunk = b''
+            if not chunk:
+                log("EOF", now()); break
+            data += chunk
+            vt.feed(chunk)
+        t = time.time() - start
+        if osc is not None and not sent1 and t >= osc_at:
+            os.write(fd, osc.encode()); sent1 = True; log("resp OSC", now())
+        if dsr is not None and not sent2 and t >= dsr_at:
+            os.write(fd, dsr.encode()); sent2 = True; log("resp DSR", now())
+        while iidx < len(inputs) and t >= inputs[iidx][0]:
+            s = inputs[iidx][1]
+            log("send", now(), repr(s))
+            os.write(fd, s if isinstance(s, bytes) else s.encode())
+            iidx += 1
+        p, st = os.waitpid(pid, os.WNOHANG)
+        if p == pid:
+            if os.WIFEXITED(st): code = os.WEXITSTATUS(st)
+            elif os.WIFSIGNALED(st): code = -os.WTERMSIG(st)
+            log("child exit", now(), code)
+            while True:
+                r, _, _ = select.select([fd], [], [], 0.15)
+                if fd in r:
+                    try:
+                        chunk = os.read(fd, 65536)
+                        if not chunk: break
+                        data += chunk; vt.feed(chunk)
+                    except OSError: break
+                else: break
+            break
+    if code is None:
+        try:
+            p, st = os.waitpid(pid, 0)
+            code = os.WEXITSTATUS(st) if os.WIFEXITED(st) else -os.WTERMSIG(st)
+            log("reaped", code)
+        except ChildProcessError:
+            pass
+    try: os.close(fd)
+    except OSError: pass
+    if out: open(out,'wb').write(data)
+    log("bytes", len(data), "EXIT", code)
+    if show:
+        snap = vt.snapshot()
+        for i, ln in enumerate(snap['lines']):
+            print(f"{i:2d} {ln}")
+    return data, code, vt
+
+if __name__ == '__main__':
+    cfg = json.load(open(sys.argv[1]))
+    run(cfg['args'], [(i[0], i[1]) for i in cfg.get('inputs',[])],
+        size=tuple(cfg.get('size',(80,24))), cwd=cfg.get('cwd'), env=cfg.get('env'),
+        total=cfg.get('total',4.0), out=cfg.get('out'),
+        osc=cfg.get('osc', '\x1b]11;rgb:1e1e1e/1e1e1e\x1b\\'),
+        dsr=cfg.get('dsr', '\x1b[1;1R'),
+        dsr_at=cfg.get('dsr_at', 0.5), osc_at=cfg.get('osc_at', 0.2),
+        show=cfg.get('show', True), label=cfg.get('label',''))
diff --git a/probe/ttyread.py b/probe/ttyread.py
new file mode 100644
index 0000000..4d1b49a
--- /dev/null
+++ b/probe/ttyread.py
@@ -0,0 +1,18 @@
+import os, sys, select, termios, tty, fcntl, struct, time
+fd = os.open('/dev/tty', os.O_RDWR)
+old = termios.tcgetattr(fd)
+tty.setraw(fd)
+os.write(fd, b'HELLO_PROBE')
+buf = b''
+end = time.time() + 2.0
+while time.time() < end:
+    r,_,_ = select.select([fd],[],[],0.2)
+    if r:
+        try:
+            d = os.read(fd, 4096)
+        except OSError:
+            break
+        if not d: break
+        buf += d
+termios.tcsetattr(fd, termios.TCSADRAIN, old)
+sys.stderr.write('GOT: %r\n' % buf)
diff --git a/probe/vt.py b/probe/vt.py
