index 0000000..ff150b9
--- /dev/null
+++ b/probe/vt.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Minimal VT emulator for capturing walk's frames."""
+import re, sys, json
+
+class VT:
+    def __init__(self, cols=80, rows=24):
+        self.cols, self.rows = cols, rows
+        self.grid = [[' ']*cols for _ in range(rows)]
+        self.styles = [[None]*cols for _ in range(rows)]
+        self.x = 0; self.y = 0
+        self.sgr = {}
+        self.events = []
+        self.hidden_cursor = False
+        self.mode = {}
+    def putc(self, ch):
+        if ch == '\r': self.x = 0; return
+        if ch == '\n':
+            self.y = min(self.y+1, self.rows-1)
+            return
+        if ch == '\b': self.x = max(0, self.x-1); return
+        if ch == '\t':
+            self.x = min(((self.x//8)+1)*8, self.cols-1); return
+        if ch == '\a': return
+        if self.x >= self.cols:
+            # autowrap
+            self.x = 0
+            self.y = min(self.y+1, self.rows-1)
+        self.grid[self.y][self.x] = ch
+        self.styles[self.y][self.x] = dict(self.sgr)
+        self.x += 1
+    def el(self, a):
+        if a == 0:
+            for i in range(self.x, self.cols):
+                self.grid[self.y][i]=' '; self.styles[self.y][i]=None
+        elif a == 1:
+            for i in range(0, self.x+1):
+                self.grid[self.y][i]=' '; self.styles[self.y][i]=None
+        elif a == 2:
+            for i in range(0, self.cols):
+                self.grid[self.y][i]=' '; self.styles[self.y][i]=None
+    def ed(self, a):
+        if a == 0:
+            for i in range(self.x, self.cols):
+                self.grid[self.y][i]=' '; self.styles[self.y][i]=None
+            for ry in range(self.y+1, self.rows):
+                for i in range(self.cols):
+                    self.grid[ry][i]=' '; self.styles[ry][i]=None
+        elif a == 1:
+            for ry in range(0, self.y):
+                for i in range(self.cols):
+                    self.grid[ry][i]=' '; self.styles[ry][i]=None
+            for i in range(0, self.x+1):
+                self.grid[self.y][i]=' '; self.styles[self.y][i]=None
+        elif a == 2:
+            for ry in range(self.rows):
+                for i in range(self.cols):
+                    self.grid[ry][i]=' '; self.styles[ry][i]=None
+    def feed(self, data):
+        i = 0; n = len(data)
+        while i < n:
+            b = data[i]
+            if b == 0x1b:
+                if i+1 < n and data[i+1:i+2] == b'[':
+                    m = re.match(rb'\[([;\?]*[\d;?]*)([@-~])', data[i+1:i+60])
+                    if m:
+                        params, fin = m.group(1).decode('ascii','replace'), m.group(2).decode('ascii')
+                        i += 1 + m.end()
+                        self.csi(params, fin)
+                        continue
+                elif i+1 < n and data[i+1:i+2] == b']':
+                    m = re.match(rb'\](.*?)(\x1b\\|\x07)', data[i+1:i+200], re.S)
+                    if m:
+                        self.events.append(('OSC', m.group(1).decode('utf-8','replace')))
+                        i += 1 + m.end()
+                        continue
+                    else:
+                        i = n; break
+                else:
+                    self.events.append(('ESC', data[i+1:i+2].decode('latin1')))
+                    i += 2
+                    continue
+            elif b == 0x07:
+                i += 1; continue
+            else:
+                ch = data[i:i+1].decode('utf-8', 'replace')
+                self.putc(ch)
+                i += 1
+    def csi(self, p, fin):
+        if fin == 'm':
+            ps = p.split(';') if p else ['0']
+            it = iter(range(len(ps)))
+            cur = 0
+            for k in ps:
+                v = int(k) if k else 0
+                if v == 0: self.sgr = {}
+                elif v == 1: self.sgr['bold'] = 1
+                elif v == 4: self.sgr['under'] = 1
+                elif v in (2,3,7,9): self.sgr[v] = 1
+                elif v in (22,24,27): self.sgr.pop({22:'bold',24:'under',27:'7'}[v], None)
+                elif 30 <= v <= 37: self.sgr['fg'] = v-30
+                elif 40 <= v <= 47: self.sgr['bg'] = v-40
+                elif v == 38 or v == 48:
+                    rest = ps[k+1:] if False else None
+                    # need context of ps; handle below
+                num = int(k) if k else 0
+                if num == 38:
+                    if ps.index(k)+2 < len(ps):
+                        m, a = int(ps[ps.index(k)+1]), int(ps[ps.index(k)+2])
+                        self.sgr['fg'] = f"255:{a}" if m==2 else f"256:{a}"
+                if num == 48:
+                    if ps.index(k)+2 < len(ps):
+                        m, a = int(ps[ps.index(k)+1]), int(ps[ps.index(k)+2])
+                        self.sgr['bg'] = f"255:{a}" if m==2 else f"256:{a}"
+        elif fin == 'H' or fin == 'f':
+            r, c = (p.split(';') + ['1','1'])[:2]
+            self.y = max(0, int(r)-1); self.x = max(0, int(c)-1)
+        elif fin == 'A': self.y = max(0, self.y - (int(p) if p else 1))
+        elif fin == 'B': self.y = min(self.rows-1, self.y + (int(p) if p else 1))
+        elif fin == 'C': self.x = min(self.cols-1, self.x + (int(p) if p else 1))
+        elif fin == 'D': self.x = max(0, self.x - (int(p) if p else 1))
+        elif fin == 'G': self.x = max(0, min(self.cols-1, int(p)-1 if p else 1))
+        elif fin == 'd': self.y = max(0, min(self.rows-1, int(p)-1 if p else 1))
+        elif fin == 'J': self.ed(int(p) if p else 0)
+        elif fin == 'K': self.el(int(p) if p else 0)
+        elif fin == 'h':
+            for q in (p[1:].split(';') if p.startswith('?') else p.split(';')):
+                if q: self.mode[(p.startswith('?'), int(q))] = 1
+            if (True, 25) in self.mode: self.hidden_cursor = True
+        elif fin == 'l':
+            for q in (p[1:].split(';') if p.startswith('?') else p.split(';')):
+                if q: self.mode[(p.startswith('?'), int(q))] = 0
+            if (True, 25) in self.mode and not self.mode[(True,25)]: self.hidden_cursor = False
+        elif fin == 'r': pass
+        else:
+            self.events.append(('CSI', p, fin))
+    def lines(self):
+        return [''.join(r).rstrip() for r in self.grid]
+    def snapshot(self):
+        out = []
+        for ry in range(self.rows):
+            line = ''.join(self.grid[ry])
+            out.append(line.rstrip())
+        return {'lines': out, 'cursor': (self.x, self.y), 'hidden': self.hidden_cursor,
+                'events': list(self.events)}
