+import os, pty, time, select, fcntl, termios, struct, signal, sys
+def run_variant(name, osc_delay, dsr_delay, term='xterm-256color', key=b'q', key_t=1.2):
+    pid, fd = pty.fork()
+    if pid == 0:
+        os.chdir('/tmp/t1')
+        if term: os.environ['TERM']=term
+        else: os.environ.pop('TERM', None)
+        os.execv('/workspace/executable', ['/workspace/executable', '/tmp/t1'])
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, 0, 0))
+    start = time.time(); data=b''; code=None
+    done1 = done2 = False; sent_key = False
+    while True:
+        t = time.time() - start
+        if t > 2.5:
+            try: os.kill(pid,9)
+            except: pass
+            code=-9; break
+        r,_,_ = select.select([fd], [], [], 0.05)
+        if fd in r:
+            try: chunk = os.read(fd, 65536)
+            except OSError: chunk=b''
+            if not chunk: break
+            data += chunk
+        if osc_delay is not None and not done1 and t >= osc_delay:
+            os.write(fd, b'\x1b]11;rgb:1e1e1e/1e1e1e\x1b\\'); done1=True
+        if dsr_delay is not None and not done2 and t >= dsr_delay:
+            os.write(fd, b'\x1b[1;1R'); done2=True
+        if not sent_key and t >= key_t:
+            os.write(fd, key); sent_key=True
+        p, st = os.waitpid(pid, os.WNOHANG)
+        if p == pid:
+            code = os.WEXITED and os.WEXITSTATUS(st) if os.WIFEXITED(st) else -os.WTERMSIG(st)
+            while True:
+                r,_,_ = select.select([fd], [], [], 0.15)
+                if fd in r:
+                    try:
+                        c2 = os.read(fd, 65536)
+                        if not c2: break
+                        data += c2
+                    except OSError: break
+                else: break
+            break
+    try: os.close(fd)
+    except: pass
+    print(f"{name}: bytes={len(data)} exit={code}")
+    return data
+
+run_variant("osc@0.2 dsr@0.5", 0.2, 0.5)
+run_variant("osc@0.5 dsr@0.2 (swapped)", 0.5, 0.2)
+run_variant("osc only", 0.2, None)
+run_variant("dsr only", None, 0.2)
+run_variant("none", None, None)
+run_variant("both@0.2", 0.2, 0.2)
