+    TokenType.LiteralStringUnicode: "LiteralStringUnicode",
+    TokenType.LiteralStringWhitespace: "LiteralStringWhitespace",
+    TokenType.Other: "Other",
+    TokenType.OtherBlock: "OtherBlock",
+    TokenType.OtherInline: "OtherInline",
