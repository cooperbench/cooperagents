+
+// Print a line of matrix text
+void print_matrix_line(const char *line, int color) {
+    if (line == NULL) return;
+    
+    // Set color
+    if (color == 1) {
+        printf("\033[1;31m");  // Red
+    } else if (color == 2) {
+        printf("\033[1;32m");  // Green
+    } else if (color == 3) {
+        printf("\033[1;34m");  // Blue
+    } else if (color == 4) {
+        printf("\033[1;37m");  // White
+    } else if (color == 5) {
+        printf("\033[1;33m");  // Yellow
+    } else if (color == 6) {
+        printf("\033[1;36m");  // Cyan
+    } else if (color == 7) {
+        printf("\033[1;35m");  // Magenta
+    } else if (color == 8) {
+        printf("\033[1;30m");  // Black
+    } else {
+        printf("\033[1;32m");  // Default green
+    }
+    
+    printf("%s", line);
+    
+    // Reset color
+    printf("\033[0m");
+}
+
+// Print the message in the center
+void print_message(const char *message) {
+    if (message == NULL) return;
+    
+    int width = get_terminal_width();
+    int height = get_terminal_height();
+    
+    // Clear screen
+    printf("\033[2J\033[H");
+    
+    // Center the message
+    int msg_len = strlen(message);
+    int padding = (width - msg_len) / 2;
+    
+    for (int i = 0; i < padding; i++) {
+        printf(" ");
+    }
+    printf("%s\n", message);
+    
+    // Clear screen again
+    printf("\033[2J\033[H");
+}
+
+// Stop screen rendering
+void screen_stop(void) {
+    restore_terminal();
+    
+    if (matrix_lines) {
+        for (int i = 0; i < num_lines; i++) {
+            free(matrix_lines[i]);
+        }
+        free(matrix_lines);
+        matrix_lines = NULL;
+    }
+}
+
+// Initialize matrix lines
+static void init_matrix_lines(void) {
+    if (matrix_lines != NULL) {
+        for (int i = 0; i < num_lines; i++) {
+            free(matrix_lines[i]);
+        }
+        free(matrix_lines);
+        matrix_lines = NULL;
+    }
+    
+    num_lines = 0;
+    max_lines = 0;
+    
+    // Allocate initial buffer
+    matrix_lines = malloc(sizeof(char *) * 100);
+    if (!matrix_lines) {
+        return;
+    }
+    
+    // Initialize with empty lines
+    for (int i = 0; i < 100; i++) {
+        matrix_lines[i] = malloc(sizeof(char) * (term_width + 1));
+        if (matrix_lines[i]) {
+            matrix_lines[i][0] = '\0';
+        }
+    }
+}
+
+// Update matrix lines
+static void update_matrix_lines(void) {
+    if (matrix_lines == NULL) {
+        init_matrix_lines();
+        return;
+    }
+    
+    // Shift lines up
+    for (int i = num_lines - 1; i > 0; i--) {
+        matrix_lines[i] = matrix_lines[i - 1];
+    }
+    
+    // Create new line at top
+    matrix_lines[0] = malloc(sizeof(char) * (term_width + 1));
+    if (!matrix_lines[0]) {
+        return;
+    }
+    
+    // Fill with random characters
+    for (int i = 0; i < term_width; i++) {
+        matrix_lines[0][i] = get_matrix_char();
+    }
+    matrix_lines[0][term_width] = '\0';
+    
+    // Expand buffer if needed
+    if (num_lines >= max_lines) {
+        max_lines = num_lines + 100;
+        char **new_lines = realloc(matrix_lines, sizeof(char *) * max_lines);
+        if (new_lines) {
+            matrix_lines = new_lines;
+            for (int i = num_lines; i < max_lines; i++) {
+                matrix_lines[i] = malloc(sizeof(char) * (term_width + 1));
+                if (matrix_lines[i]) {
+                    matrix_lines[i][0] = '\0';
+                }
+            }
+        }
+    }
+    
+    num_lines++;
+}
+
+// Render the matrix
+static void render_matrix(void) {
+    if (matrix_lines == NULL || num_lines == 0) {
+        init_matrix_lines();
+        update_matrix_lines();
+    }
+    
+    // Print all lines
+    for (int i = 0; i < num_lines; i++) {
+        print_matrix_line(matrix_lines[i], 2);  // Default green
+    }
+}
+
+// Main screen loop
+void screen_loop(void) {
+    long last_update = get_time_ms();
+    long update_interval = g_opts.update_delay * 100;  // Convert delay to ms
+    
+    while (1) {
+        long now = get_time_ms();
+        
+        // Check for keyboard input (screensaver mode)
+        if (g_opts.screensaver) {
+            fd_set readfds;
+            struct timeval timeout;
+            
+            FD_ZERO(&readfds);
+            FD_SET(STDIN_FILENO, &readfds);
+            timeout.tv_sec = 0;
+            timeout.tv_usec = 100000;  // 100ms timeout
+            
+            if (select(STDIN_FILENO + 1, &readfds, NULL, NULL, &timeout) > 0) {
+                char buf[1];
+                if (read(STDIN_FILENO, buf, 1) > 0) {
+                    exit(0);
+                }
+            }
+        }
+        
+        // Update and render
+        if (now - last_update >= update_interval) {
+            update_matrix_lines();
+            render_matrix();
+            last_update = now;
+        }
+        
+        // Sleep for a short time
+        usleep(10000);  // 10ms
+    }
+}
+
+// Initialize screen
+void screen_init(void) {
+    // Get terminal dimensions
+    struct winsize ws;
+    ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws);
+    term_width = ws.ws_col;
+    term_height = ws.ws_row;
+    // Initialize matrix lines
+    init_matrix_lines();
+    
+    // Set up signal handler
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+}
+
+// Main entry point for screen rendering
+void screen_start(void) {
+    screen_init();
+    screen_loop();
+}
