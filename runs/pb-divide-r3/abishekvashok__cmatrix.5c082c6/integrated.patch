+#!/bin/bash
+set -e
+
+cd "$(dirname "$0")"
+
+# Compile cmatrix
+gcc -o executable main.c options.c screen.c \
+    -lm \
+    -Wall -Wextra
+
+echo "Build successful: ./executable"
diff --git a/main.c b/main.c
new file mode 100644
index 0000000..716b845
--- /dev/null
+++ b/main.c
@@ -0,0 +1,245 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+#include <ctype.h>
+#include <math.h>
+#include "options.h"
+#include "screen.h"
+
+// Global options
+extern Options g_opts;
+
+// Signal handler for graceful shutdown
+static void signal_handler(int sig) {
+    (void)sig;
+    if (g_opts.screensaver) {
+        exit(0);
+    }
+    screen_stop();
+    exit(0);
+}
+
+// Print usage/help
+static void print_help(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+// Print version
+static void print_version(void) {
+    time_t now = time(NULL);
+    struct tm *tm_info = localtime(&now);
+    char time_str[20];
+    strftime(time_str, sizeof(time_str), "%H:%M:%S", tm_info);
+    
+    printf(" CMatrix version 2.0 (compiled %s, Jun 11 2026)\n", time_str);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+// Check for errors and print error message
+static int check_error(const char *msg) {
+    if (msg) {
+        printf(" %s\n", msg);
+    }
+    return 1;
+}
+
+// Parse command line arguments
+static int parse_options(int argc, char **argv) {
+    // Initialize options
+    options_init(&g_opts);
+    
+    // Check for --help or -h
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--help") == 0 || strcmp(argv[i], "-h") == 0) {
+            g_opts.help = 1;
+            break;
+        }
+    }
+    
+    // Check for --version or -V
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--version") == 0 || strcmp(argv[i], "-V") == 0) {
+            g_opts.version = 1;
+            break;
+        }
+    }
+    
+    // Parse other options
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-a") == 0) {
+            g_opts.async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            g_opts.bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            g_opts.all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            g_opts.shadows_only = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            g_opts.force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            g_opts.linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            g_opts.lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            g_opts.old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            g_opts.no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            g_opts.screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            g_opts.x_window = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            g_opts.rainbow_mode = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            g_opts.lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            g_opts.every_char_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                g_opts.update_delay = atoi(argv[i]);
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                g_opts.color = argv[i];
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                g_opts.message = argv[i];
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                i++;
+                g_opts.tty = argv[i];
+            }
+        }
+    }
+    
+    // Validate color if specified
+    if (g_opts.color) {
+        const char *valid_colors[] = {"green", "red", "blue", "white", "yellow", "cyan", "magenta", "black", NULL};
+        int found = 0;
+        for (int i = 0; valid_colors[i] != NULL; i++) {
+            if (strcmp(g_opts.color, valid_colors[i]) == 0) {
+                found = 1;
+                break;
+            }
+        }
+        if (!found) {
+            g_opts.error = 1;
+            printf(" Invalid color selection\n");
+            printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+        }
+    }
+    
+    // Validate update delay
+    if (g_opts.update_delay < 0 || g_opts.update_delay > 10) {
+        g_opts.error = 1;
+        printf(" Invalid update delay\n");
+    }
+    
+    return 0;
+}
+
+// Print message in center
+static void print_center_message(void) {
+    if (g_opts.message == NULL) return;
+    
+    int width = get_terminal_width();
+    int height = get_terminal_height();
+    
+    // Clear screen
+    printf("\033[2J\033[H");
+    
+    // Center the message
+    int msg_len = strlen(g_opts.message);
+    int padding = (width - msg_len) / 2;
+    
+    for (int i = 0; i < padding; i++) {
+        printf(" ");
+    }
+    printf("%s\n", g_opts.message);
+    
+    // Clear screen again
+    printf("\033[2J\033[H");
+}
+
+// Main function
+int main(int argc, char **argv) {
+    // Parse options
+    if (parse_options(argc, argv) != 0) {
+        return 0;
+    }
+    
+    // Handle help
+    if (g_opts.help) {
+        print_help();
+        return 0;
+    }
+    
+    // Handle version
+    if (g_opts.version) {
+        print_version();
+        return 0;
+    }
+    
+    // Handle error
+    if (g_opts.error) {
+        return 0;
+    }
+    
+    // Handle message
+    if (g_opts.message) {
+        print_center_message();
+    }
+    
+    // Handle lock mode
+    if (g_opts.lock_mode) {
+        printf("Lock mode enabled. Press Ctrl+C to exit.\n");
+    }
+    
+    // Initialize terminal
+    if (init_terminal() != 0) {
+        printf("Error opening terminal: unknown.\n");
+        return 1;
+    }
+    
+    // Set up signal handler
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+    
+    // Start screen
+    screen_start();
+    
+    return 0;
+}
