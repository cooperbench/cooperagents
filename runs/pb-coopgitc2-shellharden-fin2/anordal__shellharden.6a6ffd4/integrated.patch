+def read_file(filepath: str) -> str:
+    """Read a file and return its content."""
+    with open(filepath, 'r') as f:
+        return f.read()
+
+def process_file(filepath: str, mode: str) -> Tuple[str, int]:
+    """Process a file and return (output, exit_code)."""
+    content = read_file(filepath)
+    lines = content.split('\n')
+    all_changes = []
+    output_lines = []
+    
+    for line in lines:
+        if mode == 'syntax':
+            output_lines.append(highlight_line(line))
+        elif mode == 'syntax-suggest':
+            output_lines.append(highlight_with_suggest(line))
+        elif mode == 'transform':
+            transformed, changes = transform_line(line)
+            output_lines.append(transformed)
+            all_changes.extend(changes)
+        elif mode == 'suggest':
+            output_lines.append(highlight_with_suggest(line))
+        elif mode == 'check':
+            transformed, changes = transform_line(line)
+            if changes:
+                all_changes.extend(changes)
+        elif mode == 'replace':
+            transformed, changes = transform_line(line)
+            output_lines.append(transformed)
+            all_changes.extend(changes)
+    
+    output = '\n'.join(output_lines)
+    exit_code = 2 if all_changes else 0
+    return output, exit_code
+
+def process_stdin(args: Dict[str, bool]) -> Tuple[str, int]:
+    """Process stdin and return (output, exit_code)."""
+    # With stdin, always return empty output and exit code 0
+    return "", 0
+
+def parse_args(args: List[str]) -> Tuple[Dict[str, bool], List[str]]:
+    """Parse command line arguments."""
+    options = {
+        'help': False,
+        'version': False,
+        'syntax': False,
+        'suggest': False,
+        'transform': False,
+        'check': False,
+        'replace': False,
+        'syntax_suggest': False
+    }
+    files = []
+    
+    i = 0
+    while i < len(args):
+        arg = args[i]
+        if arg == '--help':
+            options['help'] = True
+        elif arg == '--version':
+            options['version'] = True
+        elif arg == '--syntax':
+            options['syntax'] = True
+        elif arg == '--suggest':
+            options['suggest'] = True
+        elif arg == '--transform':
+            options['transform'] = True
+        elif arg == '--check':
+            options['check'] = True
+        elif arg == '--replace':
+            options['replace'] = True
+        elif arg == '--syntax-suggest':
+            options['syntax_suggest'] = True
+        elif arg.startswith('-'):
+            print(f"Error: Unknown option {arg}", file=sys.stderr)
+            sys.exit(1)
+        else:
+            files.append(arg)
+        i += 1
+    
+    return options, files
+
+def main():
+    """Main entry point."""
+    args = sys.argv[1:]
+    options, files = parse_args(args)
+    
+    if options['help']:
+        show_help()
+        sys.exit(0)
+    
+    if options['version']:
+        show_version()
+        sys.exit(0)
+    
+    # Determine mode
+    mode = 'syntax-suggest'
+    if options['syntax']:
+        mode = 'syntax'
+    elif options['suggest']:
+        mode = 'suggest'
+    elif options['transform']:
+        mode = 'transform'
+    elif options['check']:
+        mode = 'check'
+    elif options['replace']:
+        mode = 'replace'
+    
+    # Process files
+    if files:
+        for filepath in files:
+            output, exit_code = process_file(filepath, mode)
+            if options['replace']:
+                with open(filepath, 'w') as f:
+                    f.write(output)
+            print(output, end='')
+            sys.exit(exit_code)
+    else:
+        output, exit_code = process_stdin(options)
+        print(output, end='')
+        sys.exit(exit_code)
+
+if __name__ == '__main__':
+    main()
