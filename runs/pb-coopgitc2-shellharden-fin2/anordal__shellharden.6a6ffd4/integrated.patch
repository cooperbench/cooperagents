+                in_heredoc = False
+                result.append((heredoc_marker, heredoc_marker))
+                i += 2
+                continue
+            else:
+                result.append((char, char))
+                i += 1
+                continue
+        
+        # Handle comments
+        if char == '#' and not in_string:
+            in_comment = True
+            result.append((char, char))
+            i += 1
+            continue
+        
+        if in_comment:
+            result.append((char, char))
+            i += 1
+            continue
+        
+        # Handle strings
+        if char in '"\'':
+            if not in_string:
+                in_string = True
+                string_char = char
+                result.append((char, char))
+            elif char == string_char:
+                in_string = False
+                string_char = None
+                result.append((char, char))
+            else:
+                result.append((char, char))
+            i += 1
+            continue
+        
+        if in_string:
+            result.append((char, char))
+            i += 1
+            continue
+        
+        # Handle operators and special tokens
+        if char in '[](){}|&<>':
+            result.append((char, char))
+            i += 1
+            continue
+        
+        # Handle variables - check if unquoted
+        if char == '$':
+            j = i + 1
+            if j < len(line) and (line[j].isalnum() or line[j] == '_' or line[j] == '{'):
+                if line[j] == '{':
+                    k = j + 1
+                    while k < len(line) and line[k] != '}':
+                        k += 1
+                    if k < len(line):
+                        var_name = line[i:k+1]
+                        if i > 0 and line[i-1] in '"\'':
+                            result.append((var_name, var_name))
+                        else:
+                            result.append((f'"{var_name}"', var_name))
+                            changes.append((i, var_name, f'"{var_name}"'))
+                        i = k + 1
+                        continue
+                else:
+                    while j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                        j += 1
+                    var_name = line[i:j]
+                    if i > 0 and line[i-1] in '"\'':
+                        result.append((var_name, var_name))
+                    else:
+                        result.append((f'"{var_name}"', var_name))
+                        changes.append((i, var_name, f'"{var_name}"'))
+                    i = j
+                    continue
+            else:
+                result.append((char, char))
+                i += 1
+                continue
+        
+        # Handle command substitution
+        if char == '$' and i + 1 < len(line) and line[i+1] == '(':
+            j = i + 2
+            while j < len(line) and line[j] != ')':
+                j += 1
+            if j < len(line):
+                cmd_sub = line[i:j+1]
+                if i > 0 and line[i-1] in '"\'':
+                    result.append((cmd_sub, cmd_sub))
+                else:
+                    result.append((f'"{cmd_sub}"', cmd_sub))
+                    changes.append((i, cmd_sub, f'"{cmd_sub}"'))
+                i = j + 1
+                continue
+            else:
+                result.append((char, char))
+                i += 1
+                continue
+        
+        # Handle word splitting - unquoted words
+        if char.isalpha() or char == '_':
+            j = i
+            while j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                j += 1
+            word = line[i:j]
+            
+            # Check if already quoted
+            if i > 0 and line[i-1] in '"\'':
+                result.append((word, word))
+            else:
+                # Only quote variables (not keywords)
+                result.append((word, word))
+            i = j
+            continue
+        
+        result.append((char, char))
+        i += 1
+    
+    transformed = ''.join(t[0] for t in result)
+    return transformed, changes
+
+def highlight_line(line: str) -> str:
+    """Apply syntax highlighting to a line."""
+    tokens = tokenize_line(line)
+    result = []
+    for token, original in tokens:
+        if token in ['[[', ']]', '<<', '>>', '<<-', '>>-', '||', '&&', '==', '!=', '<=', '>=', '+', '-', '*', '/', '%', '=', '<', '>', '!', '&', '|', '~', ':', ';', '(', ')', '{', '}', '[', ']', ',', ' ', '\t', '\n']:
+            result.append(original)
+        elif token in ['if', 'then', 'else', 'fi', 'for', 'do', 'done', 'while', 'until', 'case', 'esac', 'in', 'function', 'return', 'exit', 'break', 'continue', 'select', 'local', 'declare', 'export', 'readonly', 'unset', 'shift', 'trap', 'eval', 'exec', 'source', 'read', 'printf', 'echo', 'test', '[', 'true', 'false', 'set', 'ulimit', 'alias', 'unalias', 'type', 'command', 'hash', 'builtin', 'typeset', 'shopt', 'enable', 'dirs', 'pushd', 'popd', 'cd', 'pwd', 'mktemp', 'getopts', 'getcwd']:
+            result.append(f"{Colors.BOLD}{Colors.FG_GREEN}{token}{Colors.RESET}")
+        elif '$' in token:
+            result.append(f"{Colors.FG_RED}{token}{Colors.RESET}")
+        elif token in '"\'':
+            result.append(f"{Colors.BG_YELLOW}{token}{Colors.RESET}")
+        elif token.isalnum() or token == '_':
+            result.append(f"{Colors.FG_BLACK}{token}{Colors.RESET}")
+        else:
+            result.append(token)
+    return ''.join(result)
+
+def highlight_with_suggest(line: str) -> str:
+    """Apply syntax highlighting with suggestions."""
+    tokens = tokenize_line(line)
+    result = []
+    for token, original in tokens:
+        if token in ['[[', ']]', '<<', '>>', '<<-', '>>-', '||', '&&', '==', '!=', '<=', '>=', '+', '-', '*', '/', '%', '=', '<', '>', '!', '&', '|', '~', ':', ';', '(', ')', '{', '}', '[', ']', ',', ' ', '\t', '\n']:
+            result.append(original)
+        elif token in ['if', 'then', 'else', 'fi', 'for', 'do', 'done', 'while', 'until', 'case', 'esac', 'in', 'function', 'return', 'exit', 'break', 'continue', 'select', 'local', 'declare', 'export', 'readonly', 'unset', 'shift', 'trap', 'eval', 'exec', 'source', 'read', 'printf', 'echo', 'test', '[', 'true', 'false', 'set', 'ulimit', 'alias', 'unalias', 'type', 'command', 'hash', 'builtin', 'typeset', 'shopt', 'enable', 'dirs', 'pushd', 'popd', 'cd', 'pwd', 'mktemp', 'getopts', 'getcwd']:
+            result.append(f"{Colors.BOLD}{Colors.FG_GREEN}{token}{Colors.RESET}")
+        elif '$' in token:
+            result.append(f"{Colors.BG_CYAN}{token}{Colors.RESET}")
+        elif token in '"\'':
+            result.append(f"{Colors.BG_BLUE}{token}{Colors.RESET}")
+        elif token.isalnum() or token == '_':
+            result.append(f"{Colors.BG_MAGENTA}{token}{Colors.RESET}")
+        else:
+            result.append(token)
+    return ''.join(result)
+
+def highlight_suggest_only(line: str) -> str:
+    """Highlight only the suggested changes."""
+    tokens = tokenize_line(line)
+    result = []
+    for token, original in tokens:
+        if token in ['[[', ']]', '<<', '>>', '<<-', '>>-', '||', '&&', '==', '!=', '<=', '>=', '+', '-', '*', '/', '%', '=', '<', '>', '!', '&', '|', '~', ':', ';', '(', ')', '{', '}', '[', ']', ',', ' ', '\t', '\n']:
+            result.append(original)
+        elif token in ['if', 'then', 'else', 'fi', 'for', 'do', 'done', 'while', 'until', 'case', 'esac', 'in', 'function', 'return', 'exit', 'break', 'continue', 'select', 'local', 'declare', 'export', 'readonly', 'unset', 'shift', 'trap', 'eval', 'exec', 'source', 'read', 'printf', 'echo', 'test', '[', 'true', 'false', 'set', 'ulimit', 'alias', 'unalias', 'type', 'command', 'hash', 'builtin', 'typeset', 'shopt', 'enable', 'dirs', 'pushd', 'popd', 'cd', 'pwd', 'mktemp', 'getopts', 'getcwd']:
