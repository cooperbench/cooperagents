+#!/usr/bin/env python3
+"""Shellharden: The corrective bash syntax highlighter."""
+
+import sys
+import re
+import os
+from typing import List, Tuple, Optional, Dict, Any
+
+VERSION = "4.3.1"
+
+# ANSI color codes
+class Colors:
+    RESET = "\033[0m"
+    BOLD = "\033[1m"
+    FG_RED = "\033[0;38;2;192;0;128m"
+    FG_GREEN = "\033[0;38;2;63;127;207m"
+    BG_YELLOW = "\033[0;42m"
+    BG_CYAN = "\033[0;46m"
+    BG_BLUE = "\033[0;44m"
+    BG_MAGENTA = "\033[0;45m"
+    BG_WHITE = "\033[0;47m"
+    FG_WHITE = "\033[0;38;2;255;255;255m"
+    FG_BLACK = "\033[0;38;2;0;0;0m"
+
+def show_help():
+    """Display help message."""
+    print("""Usage: shellharden [OPTIONS] [FILE...]
+
+Shellharden: The corrective bash syntax highlighter.
+
+Options:
+  --help            Show this help message and exit
+  --version         Show version number and exit
+  --syntax          Apply syntax highlighting only
+  --suggest         Apply syntax highlighting with suggestions (default)
+  --transform       Transform line to suggest safe quoting changes
+  --check           Check for issues and return exit code
+  --replace         Replace file contents with transformed version
+  --syntax-suggest  Apply syntax highlighting with suggestions (alias for --suggest)
+
+Examples:
+  shellharden script.sh              # Highlight with suggestions
+  shellharden --transform script.sh  # Show suggested transformations
+  shellharden --check script.sh      # Check for issues
+  shellharden --replace script.sh    # Fix the file in place
+""")
+
+def show_version():
+    """Display version number."""
+    print(VERSION)
+
+def tokenize_line(line: str) -> List[Tuple[str, str]]:
+    """Tokenize a line into (token, original) pairs."""
+    tokens = []
+    i = 0
+    in_string = False
+    string_char = None
+    in_comment = False
+    in_heredoc = False
+    heredoc_marker = None
+    
+    while i < len(line):
+        char = line[i]
+        
+        # Handle heredocs
+        if not in_heredoc and char == '<' and i + 1 < len(line) and line[i+1] == '<':
+            if i + 2 < len(line) and line[i+2] == '-':
+                j = i + 3
+                while j < len(line) and line[j].isspace():
+                    j += 1
+                if j < len(line) and line[j].isalpha():
+                    heredoc_marker = line[j:j+1]
+                    in_heredoc = True
+                    tokens.append(('<<-', line[i:i+3]))
+                    i = j + 1
+                    continue
+            elif i + 2 < len(line):
+                j = i + 2
+                while j < len(line) and line[j].isspace():
+                    j += 1
+                if j < len(line) and line[j].isalpha():
+                    heredoc_marker = line[j:j+1]
+                    in_heredoc = True
+                    tokens.append(('<<', line[i:i+2]))
+                    i = j + 1
+                    continue
+        
+        if in_heredoc:
+            if char == heredoc_marker[0] and i + 1 < len(line) and line[i+1] == heredoc_marker[1]:
+                in_heredoc = False
+                tokens.append((heredoc_marker, heredoc_marker))
+                i += 2
+                continue
+            else:
+                tokens.append((char, char))
+                i += 1
+                continue
+        
+        # Handle comments
+        if char == '#' and not in_string:
+            in_comment = True
+            tokens.append((char, char))
+            i += 1
+            continue
+        
+        if in_comment:
+            tokens.append((char, char))
+            i += 1
+            continue
+        
+        # Handle strings
+        if char in '"\'':
+            if not in_string:
+                in_string = True
+                string_char = char
+                tokens.append((char, char))
+            elif char == string_char:
+                in_string = False
+                string_char = None
+                tokens.append((char, char))
+            else:
+                tokens.append((char, char))
+            i += 1
+            continue
+        
+        if in_string:
+            tokens.append((char, char))
+            i += 1
+            continue
+        
+        # Handle operators and special tokens
+        if char in '[](){}|&<>':
+            tokens.append((char, char))
+            i += 1
+            continue
+        
+        # Handle variables - check if unquoted
+        if char == '$':
+            j = i + 1
+            if j < len(line) and (line[j].isalnum() or line[j] == '_' or line[j] == '{'):
+                if line[j] == '{':
+                    k = j + 1
+                    while k < len(line) and line[k] != '}':
+                        k += 1
+                    if k < len(line):
+                        var_name = line[i:k+1]
+                        if i > 0 and line[i-1] in '"\'':
+                            tokens.append((var_name, var_name))
+                        else:
+                            tokens.append((f'"{var_name}"', var_name))
+                        i = k + 1
+                        continue
+                else:
+                    while j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                        j += 1
+                    var_name = line[i:j]
+                    if i > 0 and line[i-1] in '"\'':
+                        tokens.append((var_name, var_name))
+                    else:
+                        tokens.append((f'"{var_name}"', var_name))
+                    i = j
+                    continue
+            else:
+                tokens.append((char, char))
+                i += 1
+                continue
+        
+        # Handle command substitution
+        if char == '$' and i + 1 < len(line) and line[i+1] == '(':
+            j = i + 2
+            while j < len(line) and line[j] != ')':
+                j += 1
+            if j < len(line):
+                cmd_sub = line[i:j+1]
+                if i > 0 and line[i-1] in '"\'':
+                    tokens.append((cmd_sub, cmd_sub))
+                else:
+                    tokens.append((f'"{cmd_sub}"', cmd_sub))
+                i = j + 1
+                continue
+            else:
+                tokens.append((char, char))
+                i += 1
+                continue
+        
+        # Handle word splitting - unquoted words
+        if char.isalpha() or char == '_':
+            j = i
+            while j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                j += 1
+            word = line[i:j]
+            
+            # Check if already quoted
+            if i > 0 and line[i-1] in '"\'':
+                tokens.append((word, word))
+            else:
+                # Only quote variables (not keywords)
+                tokens.append((word, word))
+            i = j
+            continue
+        
+        tokens.append((char, char))
+        i += 1
+    
+    return tokens
+
+def transform_line(line: str) -> Tuple[str, List[Tuple[int, str, str]]]:
+    """
+    Transform a line to suggest safe quoting changes.
+    Returns (transformed_line, list of (position, original, suggested) tuples).
