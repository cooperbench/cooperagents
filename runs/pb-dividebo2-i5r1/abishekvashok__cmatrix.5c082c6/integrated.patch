+#ifndef SCREEN_H
+#define SCREEN_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+
+// Screen dimensions
+#define SCREEN_WIDTH 80
+#define SCREEN_HEIGHT 24
+
+// Colors
+#define COLOR_GREEN "\033[0;32m"
+#define COLOR_RED "\033[0;31m"
+#define COLOR_BLUE "\033[0;34m"
+#define COLOR_WHITE "\033[0;37m"
+#define COLOR_YELLOW "\033[0;33m"
+#define COLOR_CYAN "\033[0;36m"
+#define COLOR_MAGENTA "\033[0;35m"
+#define COLOR_BLACK "\033[0;30m"
+#define COLOR_RESET "\033[0m"
+#define COLOR_BOLD "\033[1m"
+
+// Screen modes
+#define MODE_SYNC 0
+#define MODE_ASYNC 1
+
+// Screen state
+typedef struct {
+    int mode;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int shadow_only;
+    int linux_mode;
+    int old_scroll;
+    int rainbow;
+    int lambda;
+    int char_change;
+    int tty_fd;
+    int update_delay;
+    int color_idx;
+    char message[256];
+    int async;
+    int locked;
+    int screensaver;
+    int x_mode;
+    int use_japanese;
+    int use_katakana;
+    int use_cjk;
+} screen_state_t;
+
+// Initialize screen state
+void screen_init(screen_state_t *state);
+
+// Get random character based on mode
+char screen_get_char(screen_state_t *state);
+
+// Draw screen
+void screen_draw(screen_state_t *state);
+
+// Handle keyboard input
+int screen_handle_input(screen_state_t *state, char *input);
+
+// Reset terminal settings
+void screen_reset_terminal(int tty_fd);
+
+// Set terminal settings
+int screen_set_terminal(int tty_fd);
+
+// Get random color
+int screen_get_random_color(void);
+
+// Get color index from character
+int screen_get_color_index(char c);
+
+#endif
