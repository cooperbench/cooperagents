+#ifndef OPTIONS_H
+#define OPTIONS_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+
+// Screen dimensions
+#define SCREEN_WIDTH 80
+#define SCREEN_HEIGHT 24
+
+// Colors
+#define COLOR_GREEN "\033[0;32m"
+#define COLOR_RED "\033[0;31m"
+#define COLOR_BLUE "\033[0;34m"
+#define COLOR_WHITE "\033[0;37m"
+#define COLOR_YELLOW "\033[0;33m"
+#define COLOR_CYAN "\033[0;36m"
+#define COLOR_MAGENTA "\033[0;35m"
+#define COLOR_BLACK "\033[0;30m"
+#define COLOR_RESET "\033[0m"
+#define COLOR_BOLD "\033[1m"
+
+// Screen modes
+#define MODE_SYNC 0
+#define MODE_ASYNC 1
+
+// Option structure
+typedef struct {
+    int async;
+    int bold;
+    int all_bold;
+    int no_bold;
+    int shadow_only;
+    int linux_mode;
+    int old_scroll;
+    int rainbow;
+    int lambda;
+    int char_change;
+    int tty_fd;
+    int update_delay;
+    int color_idx;
+    char message[256];
+    int screensaver;
+    int x_mode;
+    int use_japanese;
+    int use_katakana;
+    int use_cjk;
+    int locked;
+} options_t;
+
+// Parse command line options
+int options_parse(int argc, char **argv, options_t *opts);
+
+// Print usage
+void options_print_usage(void);
+
+// Print version
+void options_print_version(void);
+
+#endif
