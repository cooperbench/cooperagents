+// Initialize screen state
+void screen_init(screen_state_t *state) {
+    state->mode = MODE_SYNC;
+    state->bold = 0;
+    state->all_bold = 0;
+    state->no_bold = 0;
+    state->shadow_only = 0;
+    state->linux_mode = 0;
