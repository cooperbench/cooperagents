+    state->async = 0;
+    state->locked = 0;
+    state->screensaver = 0;
+    state->x_mode = 0;
+    state->use_japanese = 0;
+    state->use_katakana = 0;
+    state->use_cjk = 0;
+    state->message[0] = '\0';
+}
+
+// Get random character based on mode
+char screen_get_char(screen_state_t *state) {
+    if (state->use_japanese) {
+        if (state->use_katakana) {
+            return katakana_chars[rand() % strlen(katakana_chars)];
+        } else if (state->use_cjk) {
+            return cjk_chars[rand() % strlen(cjk_chars)];
+        }
+    }
+    return ascii_chars[rand() % strlen(ascii_chars)];
