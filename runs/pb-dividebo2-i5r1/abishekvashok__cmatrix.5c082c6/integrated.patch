+++ b/options.c
@@ -0,0 +1,158 @@
+#include "options.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+
+// Parse command line options
+int options_parse(int argc, char **argv, options_t *opts) {
+    int i;
+    int delay = 4;
+    int color = 0;
+    char *msg = NULL;
+    char *tty = NULL;
+    
+    // Initialize options
+    opts->async = 0;
+    opts->bold = 0;
+    opts->all_bold = 0;
+    opts->no_bold = 1;  // Default
+    opts->shadow_only = 0;
+    opts->linux_mode = 0;
+    opts->old_scroll = 0;
+    opts->rainbow = 0;
+    opts->lambda = 0;
+    opts->char_change = 0;
+    opts->tty_fd = 0;
+    opts->update_delay = 4;
+    opts->color_idx = 0;
+    opts->message[0] = '\0';
+    opts->screensaver = 0;
+    opts->x_mode = 0;
+    opts->use_japanese = 0;
+    opts->use_katakana = 0;
+    opts->use_cjk = 0;
+    opts->locked = 0;
+    
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            options_print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            options_print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            opts->async = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            opts->bold = 1;
+            opts->no_bold = 0;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            opts->all_bold = 1;
+            opts->no_bold = 0;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            opts->use_japanese = 1;
+            opts->use_katakana = 1;
+            opts->use_cjk = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            // Force linux TERM type
+        } else if (strcmp(argv[i], "-l") == 0) {
+            opts->linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            opts->locked = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            opts->old_scroll = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            opts->no_bold = 1;
+            opts->bold = 0;
+            opts->all_bold = 0;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            opts->screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            opts->x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            opts->rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            opts->lambda = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            opts->char_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                delay = atoi(argv[++i]);
+                if (delay < 0) delay = 0;
+                if (delay > 10) delay = 10;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = atoi(argv[++i]);
+                if (color < 0) color = 0;
+                if (color > 7) color = 7;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty = argv[++i];
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                msg = argv[++i];
+            }
+        } else {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            options_print_usage();
+            exit(1);
+        }
+    }
+    
+    // Apply defaults
+    opts->update_delay = delay;
+    opts->color_idx = color;
+    if (msg) {
+        strncpy(opts->message, msg, sizeof(opts->message) - 1);
+        opts->message[sizeof(opts->message) - 1] = '\0';
+    }
+    if (tty) {
+        opts->tty_fd = open(tty, O_RDWR);
+        if (opts->tty_fd < 0) {
+            fprintf(stderr, "Cannot open tty: %s\n", tty);
+            exit(1);
+        }
+    }
+    
+    return 0;
+}
+
+// Print usage
+void options_print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+// Print version
+void options_print_version(void) {
+    printf(" CMatrix version 2.0 (compiled 22:13:51, Jun 11 2026)\n");
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
