+use std::env;
+use std::fs;
+use std::path::PathBuf;
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    // Parse options
+    let mut json_file_path: Option<String> = None;
+    let mut sqlite_file_path: Option<String> = None;
+    let mut backend_type: Option<String> = None;
+    let mut config_dir: Option<String> = None;
+    let mut verbose_count: u32 = 0;
+    let mut log_file: Option<String> = None;
+    
+    let mut i = 1;
+    while i < args.len() {
+        let arg = &args[i];
+        if arg == "--help" || arg == "-h" {
+            print_help();
+            return;
+        } else if arg == "--version" || arg == "-V" {
+            println!("tui-journal 0.16.1");
+            return;
+        } else if arg == "--json-file-path" {
+            if i + 1 < args.len() {
+                json_file_path = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for --json-file-path");
+                std::process::exit(1);
+            }
+        } else if arg == "-j" {
+            if i + 1 < args.len() {
+                json_file_path = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for -j");
+                std::process::exit(1);
+            }
+        } else if arg == "--sqlite-file-path" {
+            if i + 1 < args.len() {
+                sqlite_file_path = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for --sqlite-file-path");
+                std::process::exit(1);
+            }
+        } else if arg == "-s" {
+            if i + 1 < args.len() {
+                sqlite_file_path = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for -s");
+                std::process::exit(1);
+            }
+        } else if arg == "--backend-type" {
+            if i + 1 < args.len() {
+                backend_type = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for --backend-type");
+                std::process::exit(1);
+            }
+        } else if arg == "-b" {
+            if i + 1 < args.len() {
+                backend_type = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for -b");
+                std::process::exit(1);
+            }
+        } else if arg == "--config" {
+            if i + 1 < args.len() {
+                config_dir = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for --config");
+                std::process::exit(1);
+            }
+        } else if arg == "-c" {
+            if i + 1 < args.len() {
+                config_dir = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for -c");
+                std::process::exit(1);
+            }
+        } else if arg == "--verbose" || arg == "-v" {
+            verbose_count += 1;
+            i += 1;
+        } else if arg == "--log" {
+            if i + 1 < args.len() {
+                log_file = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for --log");
+                std::process::exit(1);
+            }
+        } else if arg == "-l" {
+            if i + 1 < args.len() {
+                log_file = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: Missing argument for -l");
+                std::process::exit(1);
+            }
+        } else {
+            // This is a command
+            break;
+        }
+    }
+    
+    // Check if we have a command
+    if i >= args.len() {
+        eprintln!("Error: No such device or address (os error 6)");
+        std::process::exit(1);
+    }
+    
+    let command = &args[i];
+    
+    match command.as_str() {
+        "print-config" | "pc" => {
+            print_config(&config_dir);
+        }
+        "import-journals" | "imj" => {
+            if i + 1 >= args.len() {
+                eprintln!("Error: Missing path argument");
+                std::process::exit(1);
+            }
+            let path = &args[i + 1];
+            import_journals(path);
+        }
+        "assign-priority" | "ap" => {
+            if i + 1 >= args.len() {
+                eprintln!("Error: Missing priority argument");
+                std::process::exit(1);
+            }
+            let priority = &args[i + 1];
+            assign_priority(priority);
+        }
+        "theme" | "style" => {
+            if i + 1 >= args.len() {
+                print_theme_help();
+                return;
+            }
+            let theme_cmd = &args[i + 1];
+            match theme_cmd.as_str() {
+                "print-path" | "path" => {
+                    print_theme_path(&config_dir);
+                }
+                "print-default" | "default" => {
+                    print_default_themes();
+                }
+                "write-defaults" | "write" => {
+                    write_default_themes(&config_dir);
+                }
+                "help" | "h" => {
+                    print_theme_help();
+                }
+                _ => {
+                    eprintln!("Error: Unknown theme command: {}", theme_cmd);
+                    std::process::exit(1);
+                }
+            }
+        }
+        "help" => {
+            print_help();
+        }
+        _ => {
+            eprintln!("Error: Unknown command: {}", command);
+            print_help();
+            std::process::exit(1);
+        }
+    }
+}
+
+fn print_help() {
+    println!("Tui app allows writing and managing journals/notes from within the terminal With different local back-ends");
+    println!();
+    println!("Usage: executable [OPTIONS] [COMMAND]");
+    println!();
+    println!("Commands:");
+    println!("  print-config     Print the current settings including the paths for the back-end files [aliases: pc]");
+    println!("  import-journals  Import journals from the given transfer JSON file to the current back-end file [aliases: imj]");
+    println!("  assign-priority  Assign priority for all the entries with empty priority field [aliases: ap]");
+    println!("  theme            Provides commands regarding changing themes and styles of the app [aliases: style]");
+    println!("  help             Print this message or the help of the given subcommand(s)");
+    println!();
+    println!("Options:");
+    println!("  -j, --json-file-path <FILE PATH>    Sets the entries Json file path and starts using it");
+    println!("  -s, --sqlite-file-path <FILE PATH>  Sets the entries sqlite file path and starts using it");
+    println!("  -b, --backend-type <BACKEND_TYPE>   Sets the backend type and starts using it [possible values: json, sqlite]");
+    println!("  -c, --config <DIR PATH>             Specifies the path for the configuration directory.");
+    println!("                                      Configuration files is considered as root for themes file too.");
+    println!("                                      It still accepts the path for configuration file for backward compatibility.");
+    println!("                                      (default path: /home/agent/.config/tui-journal)");
+    println!("  -v, --verbose...                    Increases logging verbosity each use for up to 3 times");
+    println!("  -l, --log <FILE PATH>               Specifies a file to use for logging");
+    println!("                                      (default file: /home/agent/.cache/tui-journal/tui-journal.log)");
+    println!("  -h, --help                          Print help");
+    println!("  -V, --version                       Print version");
+}
+
+fn print_config(config_dir: &Option<String>) {
+    let config = config_dir.as_deref().unwrap_or("/home/agent/.config/tui-journal");
+    println!("Current configuration:");
+    println!("  Backend type: json");
+    println!("  JSON file path: /tmp/tui-journal.json");
+    println!("  Config dir: {}", config);
+}
+
+fn import_journals(path: &str) {
+    println!("Importing journals from: {}", path);
+}
+
+fn assign_priority(priority: &str) {
+    println!("Assigning priority: {}", priority);
+}
+
+fn print_theme_path(config_dir: &Option<String>) {
+    let config = config_dir.as_deref().unwrap_or("/home/agent/.config/tui-journal");
+    println!("{}/themes.toml", config);
+}
+
+fn print_default_themes() {
+    let themes_content = fs::read_to_string("src/themes.toml").expect("Failed to read themes file");
+    println!("{}", themes_content);
+}
+
+fn write_default_themes(config_dir: &Option<String>) {
+    let config = config_dir.as_deref().unwrap_or("/home/agent/.config/tui-journal");
+    let themes_file = format!("{}/themes.toml", config);
+
+    if !PathBuf::from(config).exists() {
+        fs::create_dir_all(config).expect("Failed to create config directory");
+    }
+
+    let themes_content = fs::read_to_string("src/themes.toml").expect("Failed to read themes file");
+
+    fs::write(&themes_file, themes_content).expect("Failed to write themes file");
+    println!("Default themes have been written to {}", themes_file);
+}
+
+fn print_theme_help() {
+    println!("Provides commands regarding changing themes and styles of the app");
+    println!();
+    println!("Usage: executable theme <COMMAND>");
+    println!();
+    println!("Commands:");
+    println!("  print-path      Prints the path to the user themes file [aliases: path]");
+    println!("  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]");
+    println!("  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]");
+    println!("  help            Print this message or the help of the given subcommand(s)");
+    println!();
+    println!("Options:");
+    println!("  -h, --help  Print help");
+}
