index 0000000..62b4213
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,516 @@
+/*
+ * CMatrix - A Matrix-like terminal effect
+ * Based on the original cmatrix screensaver
+ */
+
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <ctype.h>
+#include <time.h>
+#include <signal.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+
+#define VERSION "2.0"
+#define DEFAULT_DELAY 4
+#define MAX_DELAY 10
+#define MIN_DELAY 0
+
+/* Colors as strings */
+#define COLOR_GREEN "\033[0;32m"
+#define COLOR_RED "\033[0;31m"
+#define COLOR_BLUE "\033[0;34m"
+#define COLOR_WHITE "\033[0;37m"
+#define COLOR_YELLOW "\033[0;33m"
+#define COLOR_CYAN "\033[0;36m"
+#define COLOR_MAGENTA "\033[0;35m"
+#define COLOR_BLACK "\033[0;30m"
+#define COLOR_BOLD "\033[1m"
+#define COLOR_RESET "\033[0m"
+
+/* Character sets */
+static const char *ascii_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()_+-=[]{}|;:,.<>?";
+static const char *katakana_chars = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static const char *matrix_chars = "01";
+
+/* Global state */
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int old_style = 0;
+static int rainbow = 0;
+static int lambda_mode = 0;
+static int change_chars = 0;
+static int lock_mode = 0;
+static int screensaver_mode = 0;
+static int x_mode = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int use_katakana = 0;
+static int use_japanese = 0;
+
+static int delay = DEFAULT_DELAY;
+static char *color = NULL;
+static char *tty = NULL;
+static char *message = NULL;
+
+static int width = 80;
+static int height = 24;
+static char *current_color = NULL;
+
+static char **lines = NULL;
+static int num_lines = 0;
+
+static volatile int quit = 0;
+
+/* Signal handlers */
+static void sigwinch_handler(int sig) {
+    (void)sig;
+    width = 80;
+    height = 24;
+}
+
+static void sigint_handler(int sig) {
+    (void)sig;
+    quit = 1;
+}
+
+static void sigterm_handler(int sig) {
+    (void)sig;
+    quit = 1;
+}
+
+/* Parse color */
+static const char *parse_color(const char *str) {
+    if (strcmp(str, "green") == 0) return COLOR_GREEN;
+    if (strcmp(str, "red") == 0) return COLOR_RED;
+    if (strcmp(str, "blue") == 0) return COLOR_BLUE;
+    if (strcmp(str, "white") == 0) return COLOR_WHITE;
+    if (strcmp(str, "yellow") == 0) return COLOR_YELLOW;
+    if (strcmp(str, "cyan") == 0) return COLOR_CYAN;
+    if (strcmp(str, "magenta") == 0) return COLOR_MAGENTA;
+    if (strcmp(str, "black") == 0) return COLOR_BLACK;
+    return COLOR_GREEN;
+}
+
+/* Get character set based on mode */
+static const char *get_char_set(void) {
+    if (use_katakana) return katakana_chars;
+    if (use_japanese) return matrix_chars;
+    return ascii_chars;
+}
+
+/* Get random character */
+static char get_random_char(void) {
+    const char *charset = get_char_set();
+    int len = strlen(charset);
+    return charset[rand() % len];
+}
+
+/* Initialize terminal */
+static void init_terminal(void) {
+    struct termios oldt, newt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return;
+    }
+    
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) == -1) {
+        return;
+    }
+    
+    signal(SIGWINCH, sigwinch_handler);
+    signal(SIGINT, sigint_handler);
+    signal(SIGTERM, sigterm_handler);
+}
+
+/* Restore terminal */
+static void restore_terminal(void) {
+    struct termios oldt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return;
+    }
+    
+    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
+}
+
+/* Clear screen */
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+    fflush(stdout);
+}
+
+/* Print message in center */
+static void print_center_message(void) {
+    if (message) {
+        int msg_len = strlen(message);
+        int padding = (width - msg_len) / 2;
+        for (int i = 0; i < padding; i++) {
+            printf(" ");
+        }
+        printf("%s\n", message);
+        for (int i = 0; i < padding; i++) {
+            printf(" ");
+        }
+        printf("\n");
+    }
+}
+
+/* Draw a line */
+static void draw_line(int y, const char *line, const char *color, int bold) {
+    if (y < 0 || y >= height) return;
+    
+    printf("\033[%d;%dH", y + 1, 1);
+    if (bold) {
+        printf("%s", COLOR_BOLD);
+    }
+    printf("%s", color);
+    printf("%s", line);
+    printf("%s", COLOR_RESET);
+    fflush(stdout);
+}
+
+/* Draw the matrix */
+static void draw_matrix(void) {
+    for (int y = 0; y < height; y++) {
+        if (lines[y]) {
+            draw_line(y, lines[y], current_color, all_bold || (bold_chars && rand() % 100 < 30));
+        }
+    }
+}
+
+/* Update lines */
+static void update_lines(void) {
+    if (old_style) {
+        /* Old style: all lines move together */
+        for (int y = 0; y < num_lines; y++) {
+            if (lines[y]) {
+                free(lines[y]);
+                lines[y] = NULL;
+            }
+        }
+        
+        int new_y = (rand() % height) - (rand() % 5);
+        if (new_y < 0) new_y = 0;
+        if (new_y >= height) new_y = height - 1;
+        
+        for (int y = 0; y < num_lines; y++) {
+            if (lines[y]) {
+                char *new_line = malloc(width + 1);
+                if (new_line) {
+                    int start = rand() % (width - 10);
+                    for (int x = 0; x < width; x++) {
+                        if (start + x < (int)strlen(lines[y])) {
+                            new_line[x] = lines[y][start + x];
+                        } else {
+                            new_line[x] = get_random_char();
+                        }
+                    }
+                    new_line[width] = '\0';
+                    lines[y] = new_line;
+                }
+            }
+        }
+    } else {
+        /* Async style: each line moves independently */
+        for (int y = 0; y < num_lines; y++) {
+            if (lines[y]) {
+                char *new_line = malloc(width + 1);
+                if (new_line) {
+                    int start = rand() % (width - 10);
+                    for (int x = 0; x < width; x++) {
+                        if (start + x < (int)strlen(lines[y])) {
+                            new_line[x] = lines[y][start + x];
+                        } else {
+                            new_line[x] = get_random_char();
+                        }
+                    }
+                    new_line[width] = '\0';
+                    lines[y] = new_line;
+                }
+            }
+        }
+    }
+}
+
+/* Initialize lines */
+static void init_lines(void) {
+    num_lines = height;
+    lines = malloc(num_lines * sizeof(char *));
+    if (!lines) {
+        fprintf(stderr, "Memory allocation failed\n");
+        exit(1);
+    }
+    
+    for (int y = 0; y < num_lines; y++) {
+        lines[y] = malloc(width + 1);
+        if (!lines[y]) {
+            fprintf(stderr, "Memory allocation failed\n");
+            exit(1);
+        }
+        
+        for (int x = 0; x < width; x++) {
+            lines[y][x] = get_random_char();
+        }
+        lines[y][width] = '\0';
+    }
+}
+
+/* Free lines */
+static void free_lines(void) {
+    for (int y = 0; y < num_lines; y++) {
+        if (lines[y]) {
+            free(lines[y]);
+            lines[y] = NULL;
+        }
+    }
+    free(lines);
+    lines = NULL;
+}
+
+/* Print usage */
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+/* Print version */
+static void print_version(void) {
+    time_t now = time(NULL);
+    struct tm *tm_info = localtime(&now);
+    char time_str[20];
+    strftime(time_str, sizeof(time_str), "%H:%M:%S", tm_info);
+    
+    printf(" CMatrix version %s (compiled %s, %s)\n", VERSION, time_str, asctime(tm_info));
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+/* Parse command line arguments */
+static void parse_args(int argc, char *argv[]) {
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-?") == 0) {
+            print_usage();
+            exit(0);
+        } else if (strcmp(argv[i], "-V") == 0) {
+            print_version();
+            exit(0);
+        } else if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_katakana = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver_mode = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            change_chars = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                delay = atoi(argv[++i]);
+                if (delay < MIN_DELAY) delay = MIN_DELAY;
+                if (delay > MAX_DELAY) delay = MAX_DELAY;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                color = argv[++i];
+                current_color = (char *)parse_color(color);
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                message = argv[++i];
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty = argv[++i];
+            }
+        } else if (argv[i][0] == '-') {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            print_usage();
+            exit(1);
+        }
+    }
+}
+
+/* Handle keyboard input */
+static int handle_input(void) {
+    char buf[10];
+    ssize_t n = read(STDIN_FILENO, buf, sizeof(buf) - 1);
+    if (n > 0) {
+        buf[n] = '\0';
+        
+        for (int i = 0; buf[i] != '\0'; i++) {
+            char c = buf[i];
+            
+            if (c == 'q' || c == 'Q') {
+                quit = 1;
+                return 1;
+            } else if (c == 'a' || c == 'A') {
+                async_scroll = !async_scroll;
+            } else if (c == 'b' || c == 'B') {
+                bold_chars = !bold_chars;
+            } else if (c == 'n' || c == 'N') {
+                bold_chars = 0;
+                all_bold = 0;
+            } else if (c >= '0' && c <= '9') {
+                delay = c - '0';
+                if (delay < MIN_DELAY) delay = MIN_DELAY;
+                if (delay > MAX_DELAY) delay = MAX_DELAY;
+            } else if (c == '!') {
+                current_color = COLOR_RED;
+            } else if (c == '@') {
+                current_color = COLOR_GREEN;
+            } else if (c == '#') {
+                current_color = COLOR_YELLOW;
+            } else if (c == '$') {
+                current_color = COLOR_BLUE;
+            } else if (c == '%') {
+                current_color = COLOR_MAGENTA;
+            } else if (c == '^') {
+                current_color = COLOR_CYAN;
+            } else if (c == '&') {
+                current_color = COLOR_WHITE;
+            } else if (c == ')') {
+                current_color = COLOR_BLACK;
+            }
+        }
+    }
+    return 0;
+}
+
+/* Main loop */
+static void main_loop(void) {
+    struct timeval tv;
+    
+    init_terminal();
+    init_lines();
+    
+    clear_screen();
+    
+    if (lock_mode) {
+        printf("\033[?1049h");
+        printf("\033[2J\033[H");
+        if (message) {
+            print_center_message();
+        } else {
+            printf("CMatrix is running in lock mode.\n");
+            printf("Press Ctrl+C to quit.\n");
+        }
+        printf("\033[?1049l");
+        restore_terminal();
+        return;
+    }
+    
+    if (screensaver_mode) {
+        printf("\033[?1049h");
+        clear_screen();
+        printf("\033[?1049l");
+    }
+    
+    while (!quit) {
+        /* Update display */
+        if (change_chars) {
+            for (int y = 0; y < num_lines; y++) {
+                if (lines[y]) {
+                    for (int x = 0; x < width; x++) {
+                        lines[y][x] = get_random_char();
+                    }
+                }
+            }
+        }
+        
+        update_lines();
+        draw_matrix();
+        
+        if (message) {
+            print_center_message();
+        }
+        
+        /* Handle input */
+        if (!screensaver_mode) {
+            handle_input();
+        }
+        
+        /* Sleep for delay */
+        tv.tv_sec = 0;
+        tv.tv_usec = delay * 100000;
+        select(STDIN_FILENO, NULL, NULL, NULL, &tv);
+    }
+    
+    if (screensaver_mode) {
+        printf("\033[?1049h");
+        clear_screen();
+        printf("\033[?1049l");
+    }
+    
+    free_lines();
+    restore_terminal();
+}
+
+int main(int argc, char *argv[]) {
+    parse_args(argc, argv);
+    
+    if (x_mode) {
+        fprintf(stderr, "X window mode not supported in this implementation\n");
+        return 1;
+    }
+    
+    if (force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    main_loop();
+    
+    return 0;
+}
