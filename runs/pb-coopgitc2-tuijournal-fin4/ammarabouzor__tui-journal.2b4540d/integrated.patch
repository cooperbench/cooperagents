+use clap::{Parser, Subcommand};
+use std::fs;
+use std::path::Path;
+
+#[derive(Parser, Debug)]
+#[command(name = "tui-journal")]
+#[command(author = "Tui-Journal Team")]
+#[command(version = "0.16.1")]
+#[command(about = "Tui app allows writing and managing journals/notes from within the terminal With different local back-ends", long_about = None)]
+struct Cli {
+    /// Sets the entries Json file path and starts using it
+    #[arg(short = 'j', long = "json-file-path")]
+    json_file_path: Option<String>,
+
+    /// Sets the entries sqlite file path and starts using it
+    #[arg(short = 's', long = "sqlite-file-path")]
+    sqlite_file_path: Option<String>,
+
+    /// Sets the backend type and starts using it
+    #[arg(short = 'b', long = "backend-type", value_enum)]
+    backend_type: Option<BackendType>,
+
+    /// Specifies the path for the configuration directory.
+    /// Configuration files is considered as root for themes file too.
+    /// It still accepts the path for configuration file for backward compatibility.
+    /// (default path: /home/agent/.config/tui-journal)
+    #[arg(short = 'c', long = "config")]
+    config_dir: Option<String>,
+
+    /// Increases logging verbosity each use for up to 3 times
+    #[arg(short = 'v', long = "verbose", action = clap::ArgAction::Count)]
+    verbose: u8,
+
+    /// Specifies a file to use for logging
+    /// (default file: /home/agent/.cache/tui-journal/tui-journal.log)
+    #[arg(short = 'l', long = "log")]
+    log_file: Option<String>,
+
+    /// Print help
+    #[arg(short = 'h', long = "help")]
+    help: bool,
+
+    /// Print version
+    #[arg(short = 'V', long = "version")]
+    version: bool,
+
+    #[command(subcommand)]
+    command: Option<Commands>,
+}
+
+#[derive(Debug, Clone, clap::ValueEnum)]
+enum BackendType {
+    Json,
+    Sqlite,
+}
+
+#[derive(Subcommand, Debug)]
+enum Commands {
+    /// Print the current settings including the paths for the back-end files
+    #[command(name = "print-config", alias = "pc")]
+    PrintConfig,
+
+    /// Import journals from the given transfer JSON file to the current back-end file
+    #[command(name = "import-journals", alias = "imj")]
+    ImportJournals {
+        /// Path of the JSON file to import from
+        #[arg(short = 'p', long = "path")]
+        path: String,
+    },
+
+    /// Assign priority for all the entries with empty priority field
+    #[command(name = "assign-priority", alias = "ap")]
+    AssignPriority {
+        /// Priority value (Positive number)
+        priority: String,
+    },
+
+    /// Provides commands regarding changing themes and styles of the app
+    #[command(name = "theme", alias = "style")]
+    Theme(ThemeCommand),
+}
+
+#[derive(Subcommand, Debug)]
+enum ThemeCommand {
+    /// Prints the path to the user themes file
+    #[command(name = "print-path", alias = "path")]
+    PrintPath,
+
+    /// Dumps the styles with the default values to be used as a reference and base for user custom themes
+    #[command(name = "print-default", alias = "default")]
+    PrintDefault,
+
+    /// Creates user custom themes file if doesn't exist then writes the default styles to it
+    #[command(name = "write-defaults", alias = "write")]
+    WriteDefaults,
+
+    /// Print this message or the help of the given subcommand(s)
+    #[command(name = "help")]
+    Help,
+}
+
+fn main() {
+    let cli = Cli::parse();
+
+    if cli.version {
+        println!("tui-journal 0.16.1");
+        return;
+    }
+
+    if cli.help {
+        print_help();
+        return;
+    }
+
+    match cli.command {
+        Some(Commands::PrintConfig) => {
+            print_config();
+        }
+        Some(Commands::ImportJournals { path }) => {
+            import_journals(&path);
+        }
+        Some(Commands::AssignPriority { priority }) => {
+            assign_priority(&priority);
+        }
+        Some(Commands::Theme(theme_cmd)) => {
+            match theme_cmd {
+                ThemeCommand::PrintPath => {
+                    print_theme_path();
+                }
+                ThemeCommand::PrintDefault => {
+                    print_default_themes();
+                }
+                ThemeCommand::WriteDefaults => {
+                    write_default_themes();
+                }
+                ThemeCommand::Help => {
+                    print_theme_help();
+                }
+            }
+        }
+        None => {
+            print_help();
+        }
+    }
+}
+
+fn print_help() {
+    println!("Tui app allows writing and managing journals/notes from within the terminal With different local back-ends");
+    println!();
+    println!("Usage: executable [OPTIONS] [COMMAND]");
