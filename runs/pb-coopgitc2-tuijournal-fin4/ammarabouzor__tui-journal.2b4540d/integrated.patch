+    println!("  -b, --backend-type <BACKEND_TYPE>   Sets the backend type and starts using it [possible values: json, sqlite]");
+    println!("  -c, --config <DIR PATH>             Specifies the path for the configuration directory.");
+    println!("                                      Configuration files is considered as root for themes file too.");
