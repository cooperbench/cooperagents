+use std::collections::HashMap;
+use std::env;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+use std::process;
+
+#[derive(Debug, Clone)]
+struct Color {
+    r: u8,
+    g: u8,
+    b: u8,
+}
+
+impl Color {
+    fn from_hex(s: &str) -> Option<Self> {
+        let s = s.trim_start_matches('#');
+        if s.len() != 6 {
+            return None;
+        }
+        let r = u8::from_str_radix(&s[0..2], 16).ok()?;
+        let g = u8::from_str_radix(&s[2..4], 16).ok()?;
+        let b = u8::from_str_radix(&s[4..6], 16).ok()?;
+        Some(Color { r, g, b })
+    }
+
+    fn to_hex(&self) -> String {
+        format!("#{:02X}{:02X}{:02X}", self.r, self.g, self.b)
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Theme {
+    colors: HashMap<String, Color>,
+    window_colors: HashMap<String, WindowColors>,
+    bar_colors: HashMap<String, BarColors>,
+}
+
+#[derive(Debug, Clone)]
+struct WindowColors {
+    border: Color,
+    background: Color,
+    text: Color,
+    indicator: Color,
+}
+
+#[derive(Debug, Clone)]
+struct BarColors {
+    separator: Color,
+    background: Color,
+    statusline: Color,
+    focused_workspace: (Color, Color, Color),
+    active_workspace: (Color, Color, Color),
+    inactive_workspace: (Color, Color, Color),
+    urgent_workspace: (Color, Color, Color),
+}
+
+#[derive(Debug, Clone)]
+struct Config {
+    font: Option<String>,
+    bindsyms: Vec<BindSym>,
+    bar: Option<Bar>,
+    client_colors: Vec<ClientColor>,
+}
+
+#[derive(Debug, Clone)]
+struct BindSym {
+    key: String,
+    action: String,
+}
+
+#[derive(Debug, Clone)]
+struct Bar {
+    colors: Option<BarColors>,
+}
+
+#[derive(Debug, Clone)]
+struct ClientColor {
+    name: String,
+    colors: (Color, Color, Color, Color),
+}
+
+fn parse_color(s: &str) -> Option<Color> {
+    Color::from_hex(s)
+}
+
+fn parse_config(content: &str) -> Config {
+    let mut config = Config {
+        font: None,
+        bindsyms: Vec::new(),
+        bar: None,
+        client_colors: Vec::new(),
+    };
+
+    let mut in_bar = false;
+    let mut in_bar_colors = false;
+    let mut in_colors = false;
+    let mut current_workspace = String::new();
+    let mut current_color = String::new();
+    let mut current_action = String::new();
+    let mut current_key = String::new();
+    let mut current_name = String::new();
+    let mut current_colors: Vec<String> = Vec::new();
+    let mut in_client = false;
+    let mut in_client_colors = false;
+
+    for line in content.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+
+        if line.starts_with("font ") {
+            config.font = Some(line[5..].to_string());
+            continue;
+        }
+
+        if line.starts_with("bindsym ") {
+            let rest = line[8..].trim();
+            let parts: Vec<&str> = rest.split_whitespace().collect();
+            if parts.len() >= 2 {
+                config.bindsyms.push(BindSym {
+                    key: parts[0].to_string(),
+                    action: parts[1..].join(" "),
+                });
+            }
+            continue;
+        }
+
+        if line.starts_with("[bar]") {
+            in_bar = true;
+            in_bar_colors = false;
+            continue;
+        }
+
+        if in_bar && line.starts_with("colors") {
+            in_bar_colors = true;
+            continue;
+        }
+
+        if in_bar_colors {
+            if line.starts_with("separator") {
+                if let Some(color) = parse_color(&line[10..].trim()) {
+                    config.bar = Some(Bar {
+                        colors: Some(BarColors {
+                            separator: color,
+                            background: Color { r: 0, g: 0, b: 0 },
+                            statusline: Color { r: 0, g: 0, b: 0 },
+                            focused_workspace: (Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }),
+                            active_workspace: (Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }),
+                            inactive_workspace: (Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }),
+                            urgent_workspace: (Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }, Color { r: 0, g: 0, b: 0 }),
+                        },
+                    });
+                }
+                in_bar_colors = false;
+            } else if line.starts_with("background") {
+                if let Some(color) = parse_color(&line[11..].trim()) {
+                    if let Some(bar) = &mut config.bar {
+                        if let Some(ref mut colors) = bar.colors {
+                            colors.background = color;
+                        }
+                    }
+                }
+            } else if line.starts_with("statusline") {
+                if let Some(color) = parse_color(&line[10..].trim()) {
+                    if let Some(bar) = &mut config.bar {
+                        if let Some(ref mut colors) = bar.colors {
+                            colors.statusline = color;
+                        }
+                    }
+                }
+            } else if line.starts_with("focused_workspace") {
+                let rest = line[18..].trim();
+                let parts: Vec<&str> = rest.split_whitespace().collect();
+                if parts.len() >= 3 {
+                    if let Some(bar) = &mut config.bar {
+                        if let Some(ref mut colors) = bar.colors {
+                            colors.focused_workspace = (
+                                parse_color(parts[0]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[1]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[2]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                            );
+                        }
+                    }
+                }
+            } else if line.starts_with("active_workspace") {
+                let rest = line[17..].trim();
+                let parts: Vec<&str> = rest.split_whitespace().collect();
+                if parts.len() >= 3 {
+                    if let Some(bar) = &mut config.bar {
+                        if let Some(ref mut colors) = bar.colors {
+                            colors.active_workspace = (
+                                parse_color(parts[0]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[1]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[2]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                            );
+                        }
+                    }
+                }
+            } else if line.starts_with("inactive_workspace") {
+                let rest = line[19..].trim();
+                let parts: Vec<&str> = rest.split_whitespace().collect();
+                if parts.len() >= 3 {
+                    if let Some(bar) = &mut config.bar {
+                        if let Some(ref mut colors) = bar.colors {
+                            colors.inactive_workspace = (
+                                parse_color(parts[0]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[1]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[2]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                            );
+                        }
+                    }
+                }
+            } else if line.starts_with("urgent_workspace") {
+                let rest = line[17..].trim();
+                let parts: Vec<&str> = rest.split_whitespace().collect();
+                if parts.len() >= 3 {
+                    if let Some(bar) = &mut config.bar {
+                        if let Some(ref mut colors) = bar.colors {
+                            colors.urgent_workspace = (
+                                parse_color(parts[0]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[1]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                                parse_color(parts[2]).unwrap_or(Color { r: 0, g: 0, b: 0 }),
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    config
+}
+
+fn get_theme(name: &str) -> Option<Theme> {
+    match name {
+        "slate" => Some(Theme {
+            colors: HashMap::new(),
+            window_colors: HashMap::new(),
+            bar_colors: HashMap::new(),
+        }),
+        "default" => Some(Theme {
+            colors: HashMap::new(),
+            window_colors: HashMap::new(),
+            bar_colors: HashMap::new(),
+        }),
+        _ => None,
+    }
+}
+
+fn generate_theme(theme_name: &str) -> String {
+    let theme = get_theme(theme_name);
+    match theme {
+        Some(t) => {
+            let mut output = String::new();
+            output.push_str("# i3 config file\n");
+            output.push_str("# Generated by i3-style\n");
+            output.push_str("\n");
+            output.push_str("# Colors\n");
+            for (name, color) in &t.colors {
+                output.push_str(&format!("color {} {}\n", name, color.to_hex()));
+            }
+            output.push_str("\n");
+            output.push_str("# Window colors\n");
+            for (name, colors) in &t.window_colors {
+                output.push_str(&format!("[window {}]\n", name));
+                output.push_str(&format!("  border {}\n", colors.border.to_hex()));
+                output.push_str(&format!("  background {}\n", colors.background.to_hex()));
+                output.push_str(&format!("  text {}\n", colors.text.to_hex()));
+                output.push_str(&format!("  indicator {}\n", colors.indicator.to_hex()));
+                output.push_str("\n");
+            }
+            output.push_str("# Bar colors\n");
+            for (name, colors) in &t.bar_colors {
+                output.push_str(&format!("[bar {}]\n", name));
+                output.push_str(&format!("  colors\n"));
+                output.push_str(&format!("    separator {}\n", colors.separator.to_hex()));
+                output.push_str(&format!("    background {}\n", colors.background.to_hex()));
+                output.push_str(&format!("    statusline {}\n", colors.statusline.to_hex()));
+                output.push_str(&format!("    focused_workspace {}\n", colors.focused_workspace.0.to_hex()));
+                output.push_str(&format!("    focused_workspace {}\n", colors.focused_workspace.1.to_hex()));
+                output.push_str(&format!("    focused_workspace {}\n", colors.focused_workspace.2.to_hex()));
+                output.push_str(&format!("    active_workspace {}\n", colors.active_workspace.0.to_hex()));
+                output.push_str(&format!("    active_workspace {}\n", colors.active_workspace.1.to_hex()));
+                output.push_str(&format!("    active_workspace {}\n", colors.active_workspace.2.to_hex()));
+                output.push_str(&format!("    inactive_workspace {}\n", colors.inactive_workspace.0.to_hex()));
+                output.push_str(&format!("    inactive_workspace {}\n", colors.inactive_workspace.1.to_hex()));
+                output.push_str(&format!("    inactive_workspace {}\n", colors.inactive_workspace.2.to_hex()));
+                output.push_str(&format!("    urgent_workspace {}\n", colors.urgent_workspace.0.to_hex()));
+                output.push_str(&format!("    urgent_workspace {}\n", colors.urgent_workspace.1.to_hex()));
+                output.push_str(&format!("    urgent_workspace {}\n", colors.urgent_workspace.2.to_hex()));
+                output.push_str("\n");
+            }
+            output
+        }
+        None => String::new(),
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    let mut config_path: Option<String> = None;
+    let mut output_path: Option<String> = None;
+    let mut reload = false;
+    let mut save = false;
+    let mut theme_name: Option<String> = None;
+
+    let mut i = 1;
+    while i < args.len() {
+        let arg = &args[i];
+        if arg.starts_with('-') {
+            if arg == "--help" || arg == "-h" {
+                print_help();
+                process::exit(0);
+            } else if arg == "--version" || arg == "-V" {
+                println!("i3-style 1.0");
+                process::exit(0);
+            } else if arg == "--list-all" || arg == "-l" {
+                print_list_all();
+                process::exit(0);
+            } else if arg == "--reload" || arg == "-r" {
+                reload = true;
+            } else if arg == "--save" || arg == "-s" {
+                save = true;
+            } else if arg == "--config" || arg == "-c" {
+                if let Some(path) = arg.strip_prefix("--config=") {
+                    config_path = Some(path.to_string());
+                } else {
+                    let parts: Vec<&str> = arg.split('=').collect();
+                    if parts.len() == 2 {
+                        config_path = Some(parts[1].to_string());
+                    }
+                }
+            } else if arg == "--output" || arg == "-o" {
+                if let Some(path) = arg.strip_prefix("--output=") {
+                    output_path = Some(path.to_string());
+                } else {
+                    let parts: Vec<&str> = arg.split('=').collect();
+                    if parts.len() == 2 {
+                        output_path = Some(parts[1].to_string());
+                    }
+                }
+            } else if arg.starts_with("--theme=") {
+                theme_name = Some(arg[8..].to_string());
+            } else if arg.starts_with("-t") {
+                if arg.len() > 2 {
+                    theme_name = Some(arg[2..].to_string());
+                } else if i + 1 < args.len() {
+                    theme_name = Some(args[i + 1].clone());
+                    i += 1;
+                }
+            } else {
+                eprintln!("Unknown option: {}", arg);
+                process::exit(1);
+            }
+        } else {
+            if theme_name.is_none() {
+                theme_name = Some(arg.clone());
+            }
+        }
+        i += 1;
+    }
+
+    if let Some(ref name) = theme_name {
+        let theme = get_theme(name);
+        match theme {
+            Some(t) => {
+                let output = generate_theme(name);
+                if let Some(ref path) = output_path {
+                    let mut file = fs::File::create(path).expect("Failed to create output file");
+                    file.write_all(output.as_bytes()).expect("Failed to write to file");
+                } else {
+                    print!("{}", output);
+                }
+            }
+            None => {
+                eprintln!("Unknown theme: {}", name);
+                process::exit(1);
+            }
+        }
+    } else if reload {
+        eprintln!("Reload mode requires a config file");
+        process::exit(1);
+    } else if save {
+        eprintln!("Save mode requires a config file");
+        process::exit(1);
+    } else {
+        eprintln!("Usage: i3-style [OPTIONS] <theme>");
+        print_help();
+        process::exit(1);
+    }
+}
+
+fn print_help() {
+    println!("Usage: i3-style [OPTIONS] <theme>");
+    println!();
+    println!("OPTIONS:");
+    println!("    -h, --help          Prints this help message");
+    println!("    -V, --version       Prints version information");
+    println!("    -c, --config <file> The config file the theme should be applied to. Defaults to the default i3 location.");
+    println!("    -o, --output <file> Apply the theme, attempt to validate the result, and write it to <file>");
+    println!("    -t, --to-theme <file> Prints an i3-style theme based on the given config suitable for sharing with others");
+    println!("    -r, --reload        Reload the config file");
+    println!("    -s, --save          Save the config file");
+    println!();
+    println!("ARGS:");
+    println!("    <theme>    The theme to use");
+}
+
+fn print_list_all() {
+    println!();
+    println!("Available themes:");
+    println!();
+    println!("  slate              - Slate theme by Jody Ribton <jody@ribton.me>");
+    println!("  alphare            - A beige theme by Alphare");
+    println!("  ubuntu             - Ubuntu theme by lasers");
+    println!("  flat-gray          - flat gray based theme");
+    println!("  purple             - Purple theme by AAlakkad <http://aalakkad.me>");
+    println!("  archlinux          - Archlinux theme by okraits <http://okraits.de>");
+    println!("  default            - Default theme for i3wm <http://i3wm.org>");
+    println!("  debian             - Debian theme by lasers");
+    println!("  oceanic-next       - Theme by Valentin Weber inspired by voronianski (https://github.com/voronianski/oceanic-next-color-scheme)");
+    println!("  base16-tomorrow    - Base16 Tomorrow, by Chris Kempson (http://chriskempson.com)");
+    println!("  okraits            - A simple theme by okraits <http://okraits.de>");
+    println!("  icelines           - icelines theme by mbfraga");
+    println!("  solarized          - Solarized theme by lasers");
+    println!("  deep-purple        - Inspired by the Purple and Default themes. By jcpst <http://jcpst.com>");
+    println!("  tomorrow-night-80s - Tomorrow Night 80s theme by jmfurlott <http://jmfurlott.com>");
+    println!("  seti               - seti theme by Jody Ribton - based on the seti Atom theme at https://atom.io/themes/seti-ui");
+    println!("  lime               - Lime theme by wei2912 <http://wei2912.github.io>, based on Archlinux theme by okraits <http://okraits.de>");
+    println!("  gruvbox            - Made by freeware-preacher <https://github.com/freeware-preacher> to match gruvbox by morhetz <https://github.com/morhetz>");
+    println!("  mate               - Theme for blending i3 into MATE");
+}
