++pub fn render_init(shell: &str, cmd: &str, hook: Hook, nocmd: bool) -> String {
++    let out = get_cell(shell, hook, nocmd).to_string();
++    if cmd == "z" || cmd.is_empty() {
++        return out;
++    }
++    let mut result = out;
++    let subs: &[(&str, &str)] = match shell {
++        "bash" => CMD_SUBS_BASH,
++        "zsh" => CMD_SUBS_ZSH,
++        "fish" => CMD_SUBS_FISH,
++        "elvish" => CMD_SUBS_ELVISH,
++        "nushell" => CMD_SUBS_NUSHELL,
++        "posix" => CMD_SUBS_POSIX,
++        "powershell" => CMD_SUBS_POWERSHELL,
++        "tcsh" => CMD_SUBS_TCSH,
++        "xonsh" => CMD_SUBS_XONSH,
++        _ => &[],
++    };
++    for (base_line, foo_line) in subs {
++        if let Some(pos) = result.find(base_line) {
++            let tmpl = foo_line.replace("fooi", &format!("{}i", cmd)).replace("foo", cmd);
++            let end = pos + base_line.len();
++            result = format!("{}{}{}", &result[..pos], tmpl, &result[end..]);
++        }
++    }
++    result
++}
