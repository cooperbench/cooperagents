+use clap::{Arg, ArgAction, Command};
+use std::process::ExitCode;
+
+mod init;
+mod runtime;
+mod db;
+
+const VERSION: &str = "0.9.9";
+const AUTHOR: &str = "Ajeet D'Souza <98ajeet@gmail.com>";
+const TOP_ABOUT: &str = "A smarter cd command for your terminal";
+
+// Custom help template. The GitHub URL is inlined as literal text (it is the
+// same for every command) so it appears between the author and the one-line
+// about without polluting the parent's Commands list. The environment-variables
+// block is also inlined as literal text; using `{after-help}` would collapse
+// the 2-space indentation because clap word-wraps the after-help text.
+const HELP_TEMPLATE: &str =
+    "{name} {version}\n{author}\nhttps://github.com/ajeetdsouza/zoxide\n\n{about-with-newline}\nUsage:\n  {usage}\n\n{all-args}\n\nEnvironment variables:\n  _ZO_DATA_DIR          Path for zoxide data files\n  _ZO_ECHO              Print the matched directory before navigating to it when set to 1\n  _ZO_EXCLUDE_DIRS      List of directory globs to be excluded\n  _ZO_FZF_OPTS          Custom flags to pass to fzf\n  _ZO_MAXAGE            Maximum total age after which entries start getting deleted\n  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths";
+
+fn add() -> Command {
+    Command::new("add")
+        .about("Add a new directory or increment its rank")
+        .version(VERSION)
+        .author(AUTHOR)
+        .help_template(HELP_TEMPLATE)
+        .arg(
+            Arg::new("paths")
+                .required(true)
+                .num_args(1..)
+                .action(ArgAction::Append)
+                .value_name("PATHS")
+                .help(""),
+        )
+        .arg(
+            Arg::new("score")
+                .short('s')
+                .long("score")
+                .value_name("SCORE")
+                .num_args(1)
+                .help("The rank to increment the entry if it exists or initialize it with if it doesn't"),
+        )
+}
+
+fn edit() -> Command {
+    Command::new("edit")
+        .about("Edit the database")
+        .version(VERSION)
+        .author(AUTHOR)
+        .help_template(HELP_TEMPLATE)
+}
+
+fn import() -> Command {
+    Command::new("import")
+        .about("Import entries from another application")
+        .version(VERSION)
+        .author(AUTHOR)
+        .help_template(HELP_TEMPLATE)
+        .arg(
+            Arg::new("from")
+                .long("from")
+                .required(true)
+                .value_name("FROM")
+                .value_parser(["autojump", "z"])
+                .help("Application to import from"),
+        )
+        .arg(
+            Arg::new("merge")
+                .long("merge")
+                .action(ArgAction::SetTrue)
+                .help("Merge into existing database"),
+        )
+        .arg(
+            Arg::new("path")
+                .required(true)
+                .num_args(1)
+                .value_name("PATH")
+                .help(""),
+        )
+}
+
+fn init() -> Command {
+    Command::new("init")
+        .about("Generate shell configuration")
+        .version(VERSION)
+        .author(AUTHOR)
+        .help_template(HELP_TEMPLATE)
+        .arg(
+            Arg::new("shell")
+                .required(true)
+                .num_args(1)
+                .value_name("SHELL")
+                .value_parser(["bash", "elvish", "fish", "nushell", "posix", "powershell", "tcsh", "xonsh", "zsh"]),
+        )
+        .arg(
+            Arg::new("no_cmd")
+                .long("no-cmd")
+                .action(ArgAction::SetTrue)
+                .help("Prevents zoxide from defining the `z` and `zi` commands"),
+        )
+        .arg(
+            Arg::new("cmd")
+                .long("cmd")
+                .default_value("z")
+                .num_args(1)
+                .value_name("CMD")
+                .help("Changes the prefix of the `z` and `zi` commands"),
+        )
+        .arg(
+            Arg::new("hook")
+                .long("hook")
+                .default_value("pwd")
+                .value_parser(["none", "prompt", "pwd"])
+                .num_args(1)
+                .value_name("HOOK")
+                .help("Changes how often zoxide increments a directory's score"),
+        )
+}
+
+fn query() -> Command {
+    Command::new("query")
+        .about("Search for a directory in the database")
+        .version(VERSION)
+        .author(AUTHOR)
+        .help_template(HELP_TEMPLATE)
+        .arg(
+            Arg::new("keywords")
+                .num_args(0..)
+                .value_name("KEYWORDS")
+                .action(ArgAction::Append),
+        )
+        .arg(
+            Arg::new("all")
+                .short('a')
+                .long("all")
+                .action(ArgAction::SetTrue)
+                .help("Show unavailable directories"),
+        )
+        .arg(
+            Arg::new("interactive")
+                .short('i')
+                .long("interactive")
+                .action(ArgAction::SetTrue)
+                .help("Use interactive selection"),
+        )
+        .arg(
+            Arg::new("list")
+                .short('l')
+                .long("list")
+                .action(ArgAction::SetTrue)
+                .help("List all matching directories"),
+        )
+        .arg(
+            Arg::new("score")
+                .short('s')
+                .long("score")
+                .action(ArgAction::SetTrue)
+                .help("Print score with results"),
+        )
+        .arg(
+            Arg::new("exclude")
+                .long("exclude")
+                .num_args(1)
+                .value_name("path")
+                .help("Exclude the current directory"),
+        )
+        .arg(
+            Arg::new("base_dir")
+                .long("base-dir")
+                .num_args(1)
+                .value_name("path")
+                .help("Only search within this directory"),
+        )
+}
+
+fn remove() -> Command {
+    Command::new("remove")
+        .about("Remove a directory from the database")
+        .version(VERSION)
+        .author(AUTHOR)
+        .help_template(HELP_TEMPLATE)
+        .arg(
+            Arg::new("paths")
+                .num_args(0..)
+                .value_name("PATHS")
+                .action(ArgAction::Append),
+        )
+}
+
+fn build() -> Command {
+    let cmd = Command::new("zoxide")
+        .bin_name("executable")
+        .version(VERSION)
+        .author(AUTHOR)
+        .about(TOP_ABOUT)
+        .help_template(HELP_TEMPLATE)
+        .arg_required_else_help(true)
+        .subcommand_required(true)
+        .disable_help_subcommand(true)
+        .subcommand(add())
+        .subcommand(edit())
+        .subcommand(import())
+        .subcommand(init())
+        .subcommand(query())
+        .subcommand(remove());
+    cmd
+}
+
+fn run_init(matches: &clap::ArgMatches) -> ExitCode {
+    let shell = matches.get_one::<String>("shell").unwrap();
+    let cmd = matches.get_one::<String>("cmd").unwrap();
+    let no_cmd = matches.get_flag("no_cmd");
+    let hook = match matches.get_one::<String>("hook").unwrap().as_str() {
+        "none" => init::Hook::None,
+        "prompt" => init::Hook::Prompt,
+        _ => init::Hook::Pwd,
+    };
+    let out = init::render_init(shell, cmd, hook, no_cmd);
+    print!("{}", out);
+    ExitCode::SUCCESS
+}
+
+fn main() -> ExitCode {
+    let matches = build().get_matches();
+    let cmd = matches.subcommand().map(|(name, _)| name).unwrap();
+    match cmd {
+        "init" => run_init(&matches.subcommand_matches("init").unwrap()),
+        "add" => runtime::run_add(&matches.subcommand_matches("add").unwrap()),
+        "edit" => runtime::run_edit(),
+        "import" => runtime::run_import(&matches.subcommand_matches("import").unwrap()),
+        "query" => runtime::run_query(&matches.subcommand_matches("query").unwrap()),
+        "remove" => runtime::run_remove(&matches.subcommand_matches("remove").unwrap()),
+        _ => ExitCode::SUCCESS,
+    }
+}
