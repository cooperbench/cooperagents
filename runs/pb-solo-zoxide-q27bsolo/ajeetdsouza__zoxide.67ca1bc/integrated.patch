@@ -0,0 +1,212 @@
+use std::path::{Path, PathBuf};
+use std::io::Write;
+use std::process::ExitCode;
+
+use crate::db::{Database, Entry};
+
+fn env_data_dir() -> PathBuf {
+    if let Ok(dir) = std::env::var("_ZO_DATA_DIR") {
+        if !dir.is_empty() {
+            return PathBuf::from(dir);
+        }
+    }
+    if let Some(data) = dirs::data_dir() {
+        return data.join("zoxide");
+    }
+    let home = std::env::var("HOME").unwrap_or_default();
+    PathBuf::from(home).join(".local").join("share").join("zoxide")
+}
+
+fn db_path() -> PathBuf {
+    env_data_dir().join("db.zo")
+}
+
+pub fn run_add(matches: &clap::ArgMatches) -> ExitCode {
+    let paths: Vec<String> = matches
+        .get_many::<String>("paths")
+        .map(|s| s.map(|s| s.to_string()).collect())
+        .unwrap_or_default();
+    let score = match matches.get_one::<String>("score") {
+        Some(s) => s.parse::<f32>().ok(),
+        None => None,
+    };
+    let resolve = resolve_symlinks();
+    let mut db = Database::load(&db_path());
+    for p in &paths {
+        let norm = normalize(p, resolve);
+        if std::fs::metadata(&norm).map(|m| m.is_dir()).unwrap_or(false) {
+            db.add(&norm.to_string_lossy().to_string(), score);
+        }
+    }
+    db.save(&db_path());
+    ExitCode::SUCCESS
+}
+
+pub fn run_remove(matches: &clap::ArgMatches) -> ExitCode {
+    let paths: Vec<String> = matches
+        .get_many::<String>("paths")
+        .map(|s| s.map(|s| s.to_string()).collect())
+        .unwrap_or_default();
+    let mut db = Database::load(&db_path());
+    db.remove(&paths);
+    db.save(&db_path());
+    ExitCode::SUCCESS
+}
+
+pub fn run_import(matches: &clap::ArgMatches) -> ExitCode {
+    let from = matches.get_one::<String>("from").unwrap();
+    let merge = matches.get_flag("merge");
+    let path = matches.get_one::<String>("path").unwrap();
+    let mut db = if merge {
+        Database::load(&db_path())
+    } else {
+        Database::new()
+    };
+    match import_from(from, path) {
+        Ok(entries) => {
+            for e in entries {
+                db.add(&e.path, Some(e.score));
+            }
+            db.save(&db_path());
+        }
+        Err(_) => {}
+    }
+    ExitCode::SUCCESS
+}
+
+pub fn run_edit() -> ExitCode {
+    let db = Database::load(&db_path());
+    let out = std::io::stdout();
+    let mut f = out.lock();
+    let _ = write!(&mut f, "{}\n", db.entries.len());
+    for e in &db.entries {
+        let _ = write!(&mut f, "{}\t{}\n", e.path, e.score);
+    }
+    ExitCode::SUCCESS
+}
+
+pub fn run_query(matches: &clap::ArgMatches) -> ExitCode {
+    let keywords: Vec<String> = matches
+        .get_many::<String>("keywords")
+        .map(|s| s.map(|s| s.to_string()).collect())
+        .unwrap_or_default();
+    let all = matches.get_flag("all");
+    let list = matches.get_flag("list");
+    let show_score = matches.get_flag("score");
+    let base_dir = matches.get_one::<String>("base_dir").map(|s| s.to_string());
+    let _exclude = matches.get_one::<String>("exclude");
+
+    let db = Database::load(&db_path());
+    let mut matches_vec: Vec<&Entry> = db
+        .entries
+        .iter()
+        .filter(|e| !all && std::fs::metadata(Path::new(&e.path)).map(|m| m.is_dir()).unwrap_or(false))
+        .filter(|e| {
+            if let Some(base) = &base_dir {
+                e.path.starts_with(base.as_str())
+            } else {
+                true
+            }
+        })
+        .filter(|e| all_keywords_match(e.path.as_str(), &keywords))
+        .collect();
+
+    matches_vec.sort_by(|a, b| {
+        b.score
+            .partial_cmp(&a.score)
+            .unwrap_or(std::cmp::Ordering::Equal)
+            .then(a.path.cmp(&b.path))
+    });
+
+    let out = std::io::stdout();
+    let mut f = out.lock();
+
+    if list {
+        for e in &matches_vec {
+            if show_score {
+                let _ = write!(&mut f, "{}\t{}\n", e.path, e.score);
+            } else {
+                let _ = write!(&mut f, "{}\n", e.path);
+            }
+        }
+        return ExitCode::SUCCESS;
+    }
+
+    match matches_vec.first() {
+        Some(e) => {
+            if show_score {
+                let _ = write!(&mut f, "{}\t{}\n", e.path, e.score);
+            } else {
+                let _ = write!(&mut f, "{}\n", e.path);
+            }
+            ExitCode::SUCCESS
+        }
+        None => ExitCode::from(1),
+    }
+}
+
+fn resolve_symlinks() -> bool {
+    match std::env::var("_ZO_RESOLVE_SYMLINKS") {
+        Ok(v) => v == "1" || v.eq_ignore_ascii_case("true"),
+        Err(_) => false,
+    }
+}
+
+fn normalize(p: &str, resolve: bool) -> PathBuf {
+    let mut path = PathBuf::from(p);
+    if resolve {
+        if let Ok(canon) = std::fs::canonicalize(&path) {
+            path = canon;
+        }
+    }
+    path
+}
+
+fn import_from(from: &str, path: &str) -> Result<Vec<Entry>, ()> {
+    let data = std::fs::read_to_string(path).map_err(|_| ())?;
+    let mut entries = Vec::new();
+    for line in data.lines() {
+        let line = line.trim();
+        if line.is_empty() {
+            continue;
+        }
+        match from {
+            "z" => {
+                // tab separated: score<TAB>path
+                let parts: Vec<&str> = line.split('\t').collect();
+                if parts.len() >= 2 {
+                    let score = parts[0].parse::<f32>().unwrap_or(1.0);
+                    entries.push(Entry {
+                        path: parts[1].to_string(),
+                        score,
+                        last: 0,
+                    });
+                }
+            }
+            "autojump" => {
+                // autojump uses a simple format; one path per line
+                entries.push(Entry {
+                    path: line.to_string(),
+                    score: 1.0,
+                    last: 0,
+                });
+            }
+            _ => {}
+        }
+    }
+    Ok(entries)
+}
+
+fn all_keywords_match(path: &str, keywords: &[String]) -> bool {
+    if keywords.is_empty() {
+        return true;
+    }
+    let lower = path.to_lowercase();
+    for kw in keywords {
+        let kw = kw.to_lowercase();
+        if !lower.contains(&kw) {
+            return false;
+        }
+    }
+    true
+}
