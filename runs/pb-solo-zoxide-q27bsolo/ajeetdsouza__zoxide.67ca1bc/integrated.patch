      print(f\"zoxide: {exc}\", file=sys.stderr)\n            return 1\n\n    return wrapper\n\n\n# =============================================================================\n#\n# Hook configuration for zoxide.\n#\n\n# Initialize hook to add new entries to the database.\nif \"__zoxide_hook\" not in globals():\n\n    @builtins.events.on_post_prompt  # type: ignore  # pylint:disable=no-member\n    def __zoxide_hook(**_kwargs: typing.Any) -> None:\n        \"\"\"Hook to add new entries to the database.\"\"\"\n        pwd = __zoxide_pwd()\n        zoxide = __zoxide_bin()\n        subprocess.run(\n            [zoxide, \"add\", \"--\", pwd],\n            check=False,\n            env=__zoxide_env(),\n        )\n\n\n# =============================================================================\n#\n# When using zoxide with --no-cmd, alias these internal functions as desired.\n#\n\n\n@__zoxide_errhandler\ndef __zoxide_z(args: list[str]) -> None:\n    \"\"\"Jump to a directory using only keywords.\"\"\"\n    if args == []:\n        __zoxide_cd()\n    elif args == [\"-\"]:\n        __zoxide_cd(\"-\")\n    elif len(args) == 1 and os.path.isdir(args[0]):\n        __zoxide_cd(args[0])\n    else:\n        try:\n            zoxide = __zoxide_bin()\n            cmd = subprocess.run(\n                [zoxide, \"query\", \"--exclude\", __zoxide_pwd(), \"--\"] + args,\n                check=True,\n                env=__zoxide_env(),\n                stdout=subprocess.PIPE,\n            )\n        except subprocess.CalledProcessError as exc:\n            raise ZoxideSilentException() from exc\n\n        result = cmd.stdout[:-1]\n        __zoxide_cd(result)\n\n\n@__zoxide_errhandler\ndef __zoxide_zi(args: list[str]) -> None:\n    \"\"\"Jump to a directory using interactive search.\"\"\"\n    try:\n        zoxide = __zoxide_bin()\n        cmd = subprocess.run(\n            [zoxide, \"query\", \"-i\", \"--\"] + args,\n            check=True,\n            env=__zoxide_env(),\n            stdout=subprocess.PIPE,\n        )\n    except subprocess.CalledProcessError as exc:\n        raise ZoxideSilentException() from exc\n\n    result = cmd.stdout[:-1]\n    __zoxide_cd(result)\n\n\n# =============================================================================\n#\n# Commands for zoxide. Disable these using --no-cmd.\n#\n\n# -- not configured --\n\n# =============================================================================\n#\n# To initialize zoxide, add this to your configuration (usually ~/.xonshrc):\n#\n# execx($(zoxide init xonsh), 'exec', __xonsh__.ctx, filename='zoxide')\n";
+
+const CELL_XONSH_NOCMD_HN: &str = "# pylint: disable=missing-module-docstring\n\nimport builtins  # pylint: disable=unused-import\nimport os\nimport os.path\nimport subprocess\nimport sys\nimport typing\n\nimport xonsh.dirstack  # type: ignore # pylint: disable=import-error\nimport xonsh.environ  # type: ignore # pylint: disable=import-error\n\n# =============================================================================\n#\n# Utility functions for zoxide.\n#\n\n\ndef __zoxide_bin() -> str:\n    \"\"\"Finds and returns the location of the zoxide binary.\"\"\"\n    zoxide = typing.cast(str, xonsh.environ.locate_binary(\"zoxide\"))\n    if zoxide is None:\n        zoxide = \"zoxide\"\n    return zoxide\n\n\ndef __zoxide_env() -> dict[str, str]:\n    \"\"\"Returns the current environment.\"\"\"\n    return builtins.__xonsh__.env.detype()  # type: ignore  # pylint:disable=no-member\n\n\ndef __zoxide_pwd() -> str:\n    \"\"\"pwd based on the value of _ZO_RESOLVE_SYMLINKS.\"\"\"\n    pwd = __zoxide_env().get(\"PWD\")\n    if pwd is None:\n        raise RuntimeError(\"$PWD not found\")\n    return pwd\n\n\ndef __zoxide_cd(path: str | bytes | None = None) -> None:\n    \"\"\"cd + custom logic based on the value of _ZO_ECHO.\"\"\"\n    if path is None:\n        args = []\n    elif isinstance(path, bytes):\n        args = [path.decode(\"utf-8\")]\n    else:\n        args = [path]\n    _, exc, _ = xonsh.dirstack.cd(args)\n    if exc is not None:\n        raise RuntimeError(exc)\n\n\nclass ZoxideSilentException(Exception):\n    \"\"\"Exit without complaining.\"\"\"\n\n\ndef __zoxide_errhandler(\n    func: typing.Callable[[list[str]], None],\n) -> typing.Callable[[list[str]], int]:\n    \"\"\"Print exception and exit with error code 1.\"\"\"\n\n    def wrapper(args: list[str]) -> int:\n        try:\n            func(args)\n            return 0\n        except ZoxideSilentException:\n            return 1\n        except Exception as exc:  # pylint: disable=broad-except\n            print(f\"zoxide: {exc}\", file=sys.stderr)\n            return 1\n\n    return wrapper\n\n\n# =============================================================================\n#\n# Hook configuration for zoxide.\n#\n\n# -- not configured --\n\n# =============================================================================\n#\n# When using zoxide with --no-cmd, alias these internal functions as desired.\n#\n\n\n@__zoxide_errhandler\ndef __zoxide_z(args: list[str]) -> None:\n    \"\"\"Jump to a directory using only keywords.\"\"\"\n    if args == []:\n        __zoxide_cd()\n    elif args == [\"-\"]:\n        __zoxide_cd(\"-\")\n    elif len(args) == 1 and os.path.isdir(args[0]):\n        __zoxide_cd(args[0])\n    else:\n        try:\n            zoxide = __zoxide_bin()\n            cmd = subprocess.run(\n                [zoxide, \"query\", \"--exclude\", __zoxide_pwd(), \"--\"] + args,\n                check=True,\n                env=__zoxide_env(),\n                stdout=subprocess.PIPE,\n            )\n        except subprocess.CalledProcessError as exc:\n            raise ZoxideSilentException() from exc\n\n        result = cmd.stdout[:-1]\n        __zoxide_cd(result)\n\n\n@__zoxide_errhandler\ndef __zoxide_zi(args: list[str]) -> None:\n    \"\"\"Jump to a directory using interactive search.\"\"\"\n    try:\n        zoxide = __zoxide_bin()\n        cmd = subprocess.run(\n            [zoxide, \"query\", \"-i\", \"--\"] + args,\n            check=True,\n            env=__zoxide_env(),\n            stdout=subprocess.PIPE,\n        )\n    except subprocess.CalledProcessError as exc:\n        raise ZoxideSilentException() from exc\n\n    result = cmd.stdout[:-1]\n    __zoxide_cd(result)\n\n\n# =============================================================================\n#\n# Commands for zoxide. Disable these using --no-cmd.\n#\n\n# -- not configured --\n\n# =============================================================================\n#\n# To initialize zoxide, add this to your configuration (usually ~/.xonshrc):\n#\n# execx($(zoxide init xonsh), 'exec', __xonsh__.ctx, filename='zoxide')\n";
+
+
+pub enum Hook { Pwd, Prompt, None }
+
+fn get_cell(shell: &str, hook: Hook, nocmd: bool) -> &'static str {
+    match shell {
+        "bash" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_BASH_BASE,
+            (Hook::Prompt, false) => CELL_BASH_HOOKPROMPT,
+            (Hook::None, false) => CELL_BASH_HOOKNONE,
+            (Hook::Pwd, true) => CELL_BASH_NOCMD,
+            (Hook::Prompt, true) => CELL_BASH_NOCMD_HP,
+            (Hook::None, true) => CELL_BASH_NOCMD_HN,
+        },
+        "zsh" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_ZSH_BASE,
+            (Hook::Prompt, false) => CELL_ZSH_HOOKPROMPT,
+            (Hook::None, false) => CELL_ZSH_HOOKNONE,
+            (Hook::Pwd, true) => CELL_ZSH_NOCMD,
+            (Hook::Prompt, true) => CELL_ZSH_NOCMD_HP,
+            (Hook::None, true) => CELL_ZSH_NOCMD_HN,
+        },
+        "fish" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_FISH_BASE,
+            (Hook::Prompt, false) => CELL_FISH_HOOKPROMPT,
+            (Hook::None, false) => CELL_FISH_HOOKNONE,
+            (Hook::Pwd, true) => CELL_FISH_NOCMD,
+            (Hook::Prompt, true) => CELL_FISH_NOCMD_HP,
+            (Hook::None, true) => CELL_FISH_NOCMD_HN,
+        },
+        "elvish" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_ELVISH_BASE,
+            (Hook::Prompt, false) => CELL_ELVISH_HOOKPROMPT,
+            (Hook::None, false) => CELL_ELVISH_HOOKNONE,
+            (Hook::Pwd, true) => CELL_ELVISH_NOCMD,
+            (Hook::Prompt, true) => CELL_ELVISH_NOCMD_HP,
+            (Hook::None, true) => CELL_ELVISH_NOCMD_HN,
+        },
+        "nushell" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_NUSHELL_BASE,
+            (Hook::Prompt, false) => CELL_NUSHELL_HOOKPROMPT,
+            (Hook::None, false) => CELL_NUSHELL_HOOKNONE,
+            (Hook::Pwd, true) => CELL_NUSHELL_NOCMD,
+            (Hook::Prompt, true) => CELL_NUSHELL_NOCMD_HP,
+            (Hook::None, true) => CELL_NUSHELL_NOCMD_HN,
+        },
+        "posix" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_POSIX_BASE,
+            (Hook::Prompt, false) => CELL_POSIX_HOOKPROMPT,
+            (Hook::None, false) => CELL_POSIX_HOOKNONE,
+            (Hook::Pwd, true) => CELL_POSIX_NOCMD,
+            (Hook::Prompt, true) => CELL_POSIX_NOCMD_HP,
+            (Hook::None, true) => CELL_POSIX_NOCMD_HN,
+        },
+        "powershell" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_POWERSHELL_BASE,
+            (Hook::Prompt, false) => CELL_POWERSHELL_HOOKPROMPT,
+            (Hook::None, false) => CELL_POWERSHELL_HOOKNONE,
+            (Hook::Pwd, true) => CELL_POWERSHELL_NOCMD,
+            (Hook::Prompt, true) => CELL_POWERSHELL_NOCMD_HP,
+            (Hook::None, true) => CELL_POWERSHELL_NOCMD_HN,
+        },
+        "tcsh" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_TCSH_BASE,
+            (Hook::Prompt, false) => CELL_TCSH_HOOKPROMPT,
+            (Hook::None, false) => CELL_TCSH_HOOKNONE,
+            (Hook::Pwd, true) => CELL_TCSH_NOCMD,
+            (Hook::Prompt, true) => CELL_TCSH_NOCMD_HP,
+            (Hook::None, true) => CELL_TCSH_NOCMD_HN,
+        },
+        "xonsh" => match (hook, nocmd) {
+            (Hook::Pwd, false) => CELL_XONSH_BASE,
+            (Hook::Prompt, false) => CELL_XONSH_HOOKPROMPT,
+            (Hook::None, false) => CELL_XONSH_HOOKNONE,
+            (Hook::Pwd, true) => CELL_XONSH_NOCMD,
+            (Hook::Prompt, true) => CELL_XONSH_NOCMD_HP,
+            (Hook::None, true) => CELL_XONSH_NOCMD_HN,
+        },
+        _ => "",
+    }
+}
+
+pub fn render_init(shell: &str, cmd: &str, hook: Hook, nocmd: bool) -> String {
+    let out = get_cell(shell, hook, nocmd).to_string();
+    if cmd == "z" || cmd.is_empty() {
+        return out;
+    }
+    let mut result = out;
+    let subs: &[(&str, &str)] = match shell {
+        "bash" => CMD_SUBS_BASH,
+        "zsh" => CMD_SUBS_ZSH,
+        "fish" => CMD_SUBS_FISH,
+        "elvish" => CMD_SUBS_ELVISH,
+        "nushell" => CMD_SUBS_NUSHELL,
+        "posix" => CMD_SUBS_POSIX,
+        "powershell" => CMD_SUBS_POWERSHELL,
+        "tcsh" => CMD_SUBS_TCSH,
+        "xonsh" => CMD_SUBS_XONSH,
+        _ => &[],
+    };
+    for (base_line, foo_line) in subs {
+        if let Some(pos) = result.find(base_line) {
+            let tmpl = foo_line.replace("fooi", &format!("{}i", cmd)).replace("foo", cmd);
+            let end = pos + base_line.len();
+            result = format!("{}{}{}", &result[..pos], tmpl, &result[end..]);
+        }
+    }
+    result
+}
diff --git a/src/main.rs b/src/main.rs
new file mode 100644
