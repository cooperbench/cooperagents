+++ b/src/db.rs
@@ -0,0 +1,156 @@
+use std::path::Path;
+
+// Database entry: a stored directory with a score and last-access timestamp.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Entry {
+    pub path: String,
+    pub score: f32,
+    pub last: u64,
+}
+
+// The on-disk format observed for a single freshly-added entry is:
+//   u32 version, u32 count, u32 reserved
+//   per entry: u32 path_len, u32 reserved, path, u32 reserved, f32 score, u64 timestamp
+// The reserved fields read as 0 for a freshly added directory.
+pub struct Database {
+    pub version: u32,
+    pub entries: Vec<Entry>,
+}
+
+const DB_VERSION: u32 = 3;
+
+impl Database {
+    pub fn new() -> Self {
+        Database { version: DB_VERSION, entries: Vec::new() }
+    }
+
+    pub fn load(path: &Path) -> Database {
+        match std::fs::read(path) {
+            Ok(data) => Database::from_bytes(&data),
+            Err(_) => Database::new(),
+        }
+    }
+
+    pub fn from_bytes(data: &[u8]) -> Database {
+        let mut db = Database::new();
+        if data.len() < 12 {
+            return db;
+        }
+        let version = read_u32(data, 0);
+        db.version = version;
+        let count = read_u32(data, 4);
+        let mut pos = 12usize;
+        for _ in 0..count {
+            if pos + 4 > data.len() {
+                break;
+            }
+            let path_len = read_u32(data, pos) as usize;
+            pos += 4;
+            // reserved u32
+            pos += 4;
+            let start = pos;
+            if start + path_len > data.len() {
+                break;
+            }
+            let path = String::from_utf8_lossy(&data[start..start + path_len]).to_string();
+            pos += path_len;
+            // reserved u32
+            if pos + 4 > data.len() {
+                break;
+            }
+            pos += 4;
+            let score = read_f32(data, pos);
+            pos += 4;
+            if pos + 8 > data.len() {
+                break;
+            }
+            let last = read_u64(data, pos);
+            pos += 8;
+            if !path.is_empty() {
+                db.entries.push(Entry { path, score, last });
+            }
+        }
+        db
+    }
+
+    pub fn to_bytes(&self) -> Vec<u8> {
+        let mut out = Vec::new();
+        out.extend_from_slice(&self.version.to_le_bytes());
+        out.extend_from_slice(&(self.entries.len() as u32).to_le_bytes());
+        out.extend_from_slice(&0u32.to_le_bytes());
+        for e in &self.entries {
+            let bytes = e.path.as_bytes();
+            out.extend_from_slice(&(bytes.len() as u32).to_le_bytes());
+            out.extend_from_slice(&0u32.to_le_bytes());
+            out.extend_from_slice(bytes);
+            out.extend_from_slice(&0u32.to_le_bytes());
+            out.extend_from_slice(&e.score.to_le_bytes());
+            out.extend_from_slice(&e.last.to_le_bytes());
+        }
+        out
+    }
+
+    pub fn save(&self, path: &Path) {
+        if let Some(parent) = path.parent() {
+            let _ = std::fs::create_dir_all(parent);
+        }
+        let _ = std::fs::write(path, self.to_bytes());
+    }
+
+    pub fn add(&mut self, path: &str, score: Option<f32>) {
+        let now = now_secs();
+        if let Some(entry) = self.entries.iter_mut().find(|e| e.path == path) {
+            entry.last = now;
+            entry.score = match score {
+                Some(s) => s,
+                None => entry.score + 1.0,
+            };
+        } else {
+            let s = match score {
+                Some(s) => s,
+                None => 1.0,
+            };
+            self.entries.push(Entry { path: path.to_string(), score: s, last: now });
+        }
+    }
+
+    pub fn remove(&mut self, paths: &[String]) {
+        self.entries.retain(|e| !paths.iter().any(|p| *p == e.path));
+    }
+}
+
+fn now_secs() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+fn read_u32(data: &[u8], off: usize) -> u32 {
+    if off + 4 > data.len() {
+        return 0;
+    }
+    u32::from_le_bytes([data[off], data[off + 1], data[off + 2], data[off + 3]])
+}
+
+fn read_u64(data: &[u8], off: usize) -> u64 {
+    if off + 8 > data.len() {
+        return 0;
+    }
+    let mut b = [0u8; 8];
+    for i in 0..8 {
+        b[i] = data[off + i];
+    }
+    u64::from_le_bytes(b)
+}
+
+fn read_f32(data: &[u8], off: usize) -> f32 {
+    if off + 4 > data.len() {
+        return 0.0;
+    }
+    let mut b = [0u8; 4];
+    for i in 0..4 {
+        b[i] = data[off + i];
+    }
+    f32::from_le_bytes(b)
+}
