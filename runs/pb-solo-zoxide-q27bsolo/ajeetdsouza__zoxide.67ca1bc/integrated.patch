++    let cmd = matches.get_one::<String>("cmd").unwrap();
++    let no_cmd = matches.get_flag("no_cmd");
++    let hook = match matches.get_one::<String>("hook").unwrap().as_str() {
++        "none" => init::Hook::None,
++        "prompt" => init::Hook::Prompt,
++        _ => init::Hook::Pwd,
++    };
++    let out = init::render_init(shell, cmd, hook, no_cmd);
