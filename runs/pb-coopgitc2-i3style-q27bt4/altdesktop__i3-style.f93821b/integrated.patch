++fn list_all() -> String {
++    let mut s = String::from("\nAvailable themes:\n\n");
++    for t in themes() {
++        // 2 leading spaces + 18-char name field + " - " + desc
++        s.push_str(&format!("  {:<18} - {}\n", t.name, t.desc));
++    }
++    s
++}
