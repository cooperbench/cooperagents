++    env::args()
++        .next()
++        .map(|a| {
++            Path::new(&a)
++                .file_name()
++                .and_then(|n| n.to_str())
++                .map(|s| s.to_string())
++                .unwrap_or(NAME.to_string())
++        })
++        .unwrap_or_else(|| NAME.to_string())
++}
