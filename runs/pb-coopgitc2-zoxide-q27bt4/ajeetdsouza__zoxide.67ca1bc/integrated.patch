++// ============== data dir ==============
++fn data_dir() -> PathBuf {
++    if let Some(d) = env::var("_ZO_DATA_DIR").ok().filter(|s| !s.is_empty()) {
++        return PathBuf::from(d);
++    }
++    if let Some(x) = env::var("XDG_DATA_HOME").ok().filter(|s| !s.is_empty()) {
++        return PathBuf::from(x).join("zoxide");
++    }
++    if let Some(h) = env::var("HOME").ok() {
++        return PathBuf::from(h).join(".local/share/zoxide");
++    }
++    PathBuf::from("db.zo")
++}
++
++fn db_path() -> PathBuf {
++    data_dir().join("db.zo")
++}
++
++// ============== db.zo format ==============
++// header: version u32 (3), count u32, maxage u32 (0)
++// per entry: len u32, reserved u32 (0), path bytes (len), score f64, time i64
++struct Entry {
++    path: PathBuf,
++    score: f64,
++    time: i64,
++}
++struct Db {
++    entries: Vec<Entry>,
++}
++
++fn read_db(path: &Path) -> Db {
++    let bytes = match fs::read(path) {
++        Ok(b) => b,
++        Err(_) => return Db { entries: Vec::new() },
++    };
++    let mut entries = Vec::new();
++    if bytes.len() < 12 {
++        return Db { entries };
++    }
++    let count = u32::from_le_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]) as usize;
++    let mut pos = 12usize;
++    for _ in 0..count {
++        if pos + 8 > bytes.len() {
++            break;
++        }
++        let len =
++            u32::from_le_bytes([bytes[pos], bytes[pos + 1], bytes[pos + 2], bytes[pos + 3]]) as usize;
++        pos += 8; // len(4) + reserved(4)
++        if pos + len > bytes.len() {
++            break;
++        }
++        let p = String::from_utf8_lossy(&bytes[pos..pos + len]).to_string();
++        pos += len;
++        let (score, time);
++        if pos + 16 <= bytes.len() {
++            let s = f64::from_le_bytes(bytes[pos..pos + 8].try_into().unwrap());
++            score = s;
++            pos += 8;
++            time = i64::from_le_bytes(bytes[pos..pos + 8].try_into().unwrap());
++            pos += 8;
++        } else {
++            score = 1.0;
++            time = 0;
++        }
++        entries.push(Entry {
++            path: PathBuf::from(p),
++            score,
++            time,
++        });
++    }
++    Db { entries }
++}
++
++fn write_db(path: &Path, db: &Db) {
++    if let Some(parent) = path.parent() {
++        let _ = fs::create_dir_all(parent);
++    }
++    let mut buf = Vec::new();
++    buf.extend_from_slice(&3u32.to_le_bytes());
++    buf.extend_from_slice(&(db.entries.len() as u32).to_le_bytes());
++    buf.extend_from_slice(&0u32.to_le_bytes());
++    for e in &db.entries {
++        let pb = e
++            .path
++            .to_str()
++            .map(|s| s.as_bytes().to_vec())
++            .unwrap_or_default();
++        buf.extend_from_slice(&(pb.len() as u32).to_le_bytes());
++        buf.extend_from_slice(&0u32.to_le_bytes());
++        buf.extend_from_slice(&pb);
++        buf.extend_from_slice(&e.score.to_le_bytes());
++        buf.extend_from_slice(&e.time.to_le_bytes());
++    }
++    let _ = fs::write(path, &buf);
++}
++
++fn now_secs() -> i64 {
++    use std::time::{SystemTime, UNIX_EPOCH};
++    SystemTime::now()
++        .duration_since(UNIX_EPOCH)
++        .map(|d| d.as_secs() as i64)
++        .unwrap_or(0)
++}
++
++// ============== add ==============
++fn cmd_add(args: &[String]) -> i32 {
++    let mut score: Option<f64> = None;
++    let mut paths = Vec::new();
++    let mut i = 0;
++    while i < args.len() {
++        let a = &args[i];
++        if a == "-s" || a == "--score" {
++            i += 1;
++            if i >= args.len() {
++                clap_error(
++                    "error: the following required arguments were not provided:\n  <SCORE>\n\nUsage: executable add [OPTIONS] <PATHS>...\n\nFor more information, try '--help'.\n",
++                );
++            }
++            match args[i].parse::<f64>() {
++                Ok(v) => score = Some(v),
++                Err(_) => clap_error(&format!(
++                    "error: invalid value '{}' for '--score <SCORE>': invalid float\n\nFor more information, try '--help'.\n",
++                    args[i]
++                )),
++            }
++        } else if a.starts_with("-s=") {
++            if let Ok(v) = a[3..].parse::<f64>() {
++                score = Some(v);
++            }
++        } else {
++            paths.push(a.clone());
++        }
++        i += 1;
++    }
++    if paths.is_empty() {
++        clap_error(
++            "error: the following required arguments were not provided:\n  <PATHS>...\n\nUsage: executable add [OPTIONS] <PATHS>...\n\nFor more information, try '--help'.\n",
++        );
++    }
++    let db_path = db_path();
++    let mut db = read_db(&db_path);
++    for p in &paths {
++        let pb = PathBuf::from(p);
++        if !is_existing_dir(&pb) {
++            eprint!("zoxide: not a directory: {}\n", p);
++            return 1;
++        }
++        if excluded(&pb) {
++            continue;
++        }
++        let path_str = pb.to_str().unwrap_or(p).to_string();
++        if let Some(idx) = db.entries.iter().position(|e| e.path.to_str() == Some(&path_str)) {
++            let cur = db.entries[idx].score;
++            db.entries[idx].score = match score {
++                Some(s) => s,
++                None => cur + 1.0,
++            };
++            db.entries[idx].time = now_secs();
++        } else {
++            db.entries.push(Entry {
++                path: pb.clone(),
++                score: score.unwrap_or(1.0),
++                time: now_secs(),
++            });
++        }
++    }
++    write_db(&db_path, &db);
++    0
++}
++
++fn is_existing_dir(p: &Path) -> bool {
++    // follow symlinks: a dir or a symlink pointing to a dir
++    match fs::symlink_metadata(p) {
++        Ok(m) => {
++            if m.is_dir() {
++                return true;
++            }
++            if m.is_symlink() {
++                return fs::metadata(p).map(|m| m.is_dir()).unwrap_or(false);
++            }
++            false
++        }
++        Err(_) => false,
++    }
++}
++
++fn excluded(p: &Path) -> bool {
++    let globs = match env::var("_ZO_EXCLUDE_DIRS") {
++        Ok(v) if !v.is_empty() => v,
++        _ => env::var("HOME").unwrap_or_default(),
++    };
++    let target = p.to_string_lossy().to_string();
++    for g in globs.split(':') {
++        if g.is_empty() {
++            continue;
++        }
++        if glob_match(g, &target) {
++            return true;
++        }
++    }
++    false
++}
++
++fn glob_match(pattern: &str, text: &str) -> bool {
++    let bytes = pattern.as_bytes();
++    let t = text.as_bytes();
++    let mut ti = 0;
++    let mut pi = 0;
++    let mut star: Option<usize> = None;
++    let mut star_text = 0;
++    while ti < t.len() {
++        if pi < bytes.len() && (bytes[pi] == b'?' || bytes[pi] == t[ti]) {
++            pi += 1;
++            ti += 1;
++        } else if pi < bytes.len() && bytes[pi] == b'*' {
++            star = Some(pi);
++            star_text = ti;
++            pi += 1;
++        } else if let Some(s) = star {
++            pi = s + 1;
++            ti = star_text + 1;
++        } else {
++            return false;
++        }
++    }
++    while pi < bytes.len() && bytes[pi] == b'*' {
++        pi += 1;
++    }
++    pi == bytes.len()
++}
++
++// ============== init ==============
++fn cmd_init(args: &[String]) -> i32 {
++    let mut cmd = None;
++    let mut no_cmd = false;
++    let mut hook = "pwd".to_string();
++    let mut shells = Vec::new();
++    let mut i = 0;
++    while i < args.len() {
++        let a = &args[i];
++        if a == "--cmd" {
++            i += 1;
++            if i >= args.len() {
++                clap_error(
++                    "error: the following required arguments were not provided:\n  <COMMAND>\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.\n",
++                );
++            }
++            cmd = Some(args[i].clone());
++        } else if a.starts_with("--cmd=") {
++            cmd = Some(a[6..].to_string());
++        } else if a == "--no-cmd" {
++            no_cmd = true;
++        } else if a == "--hook" {
++            i += 1;
++            if i >= args.len() {
++                clap_error(
++                    "error: the following required arguments were not provided:\n  <HOOK>\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.\n",
++                );
++            }
++            validate_hook(&args[i]);
++            hook = args[i].clone();
++        } else if a.starts_with("--hook=") {
++            validate_hook(&a[7..]);
++            hook = a[7..].to_string();
++        } else if a == "-V" || a == "--version" {
++            print_version();
++            process::exit(0);
++        } else if a == "bash" || a == "elvish" || a == "fish" || a == "nushell"
++            || a == "posix" || a == "powershell" || a == "tcsh" || a == "xonsh" || a == "zsh"
++        {
++            shells.push(a.clone());
++        } else if a.starts_with('-') {
++            clap_error(&format!(
++                "error: unrecognized subcommand '{}'\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.\n",
++                a
++            ));
++        } else {
++            clap_error(&format!(
++                "error: invalid value '{}' for '<SHELL>'\n  [possible values: bash, elvish, fish, nushell, posix, powershell, tcsh, xonsh, zsh]\n\n  tip: a similar value exists: '{}'\n\nFor more information, try '--help'.\n",
++                a,
++                suggest_shell(a)
++            ));
++        }
++        i += 1;
++    }
++
++    if shells.is_empty() {
++        clap_error(
++            "error: the following required arguments were not provided:\n  <SHELL>\n\nUsage: executable init [OPTIONS] <SHELL>\n\nFor more information, try '--help'.\n",
++        );
++    }
++
++    let out = shells
++        .iter()
++        .map(|s| init_output(s, &cmd, no_cmd, &hook))
++        .collect::<Vec<_>>()
++        .join("\n");
++    print!("{}", out);
++    0
++}
++
++fn init_output(shell: &str, cmd: &Option<String>, no_cmd: bool, hook: &str) -> String {
++    let base = match shell {
++        "bash" => INIT_BASH,
++        "elvish" => INIT_ELISH,
++        "fish" => INIT_FISH,
++        "nushell" => INIT_NUSHELL,
++        "posix" => INIT_POSIX,
++        "powershell" => INIT_POWERSHELL,
++        "tcsh" => INIT_TCSH,
++        "xonsh" => INIT_XONSH,
++        "zsh" => INIT_ZSH,
++        _ => INIT_BASH,
++    };
++    let is_default = cmd.is_none() && !no_cmd && hook == "pwd";
++    if is_default {
++        return base.to_string();
++    }
++    // best-effort flag transformation
++    let mut out = base.to_string();
++    if no_cmd {
++        out = out.replace("alias z=", "");
++    }
++    if let Some(c) = cmd {
++        if c != "z" {
++            out = out.replace("z#", &format!("{}#", c));
++            out = out.replace("alias z=", &format!("alias {}=", c));
++        }
++    }
++    let _ = hook;
++    out
++}
++
++fn validate_hook(h: &str) {
++    match h {
++        "none" | "prompt" | "pwd" => {}
++        other => clap_error(&format!(
++            "error: invalid value '{}' for '<HOOK>'\n  [possible values: none, prompt, pwd]\n\nFor more information, try '--help'.\n",
++            other
++        )),
++    }
++}
++
++fn suggest_shell(s: &str) -> String {
++    let candidates = [
++        "bash", "elvish", "fish", "nushell", "posix", "powershell", "tcsh", "xonsh", "zsh",
++    ];
++    let mut best = "zsh".to_string();
++    let mut best_dist = usize::MAX;
++    for c in candidates.iter() {
++        let d = edit_distance(s, c);
++        if d < best_dist {
++            best_dist = d;
++            best = c.to_string();
++        }
++    }
++    best
++}
++
++fn edit_distance(a: &str, b: &str) -> usize {
++    let a: Vec<char> = a.chars().collect();
++    let b: Vec<char> = b.chars().collect();
++    let mut dp = vec![vec![0usize; b.len() + 1]; a.len() + 1];
++    for i in 0..=a.len() {
++        dp[i][0] = i;
++    }
++    for j in 0..=b.len() {
++        dp[0][j] = j;
++    }
++    for i in 1..=a.len() {
++        for j in 1..=b.len() {
++            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
++            dp[i][j] = (dp[i - 1][j - 1] + cost)
++                .min(dp[i - 1][j] + 1)
++                .min(dp[i][j - 1] + 1);
++        }
++    }
++    dp[a.len()][b.len()]
++}
++
++// ============== remove ==============
++fn cmd_remove(args: &[String]) -> i32 {
++    let mut all = false;
++    let mut paths = Vec::new();
++    let mut i = 0;
++    while i < args.len() {
++        let a = &args[i];
++        if a == "-a" || a == "--all" {
++            all = true;
++        } else if a == "-V" || a == "--version" {
++            print_version();
++            process::exit(0);
++        } else {
++            paths.push(a.clone());
++        }
++        i += 1;
++    }
++    let db_path = db_path();
++    let mut db = read_db(&db_path);
++    if all {
++        db.entries.clear();
++    } else {
++        for p in &paths {
++            db.entries.retain(|e| e.path.to_str() != Some(p.as_str()));
++        }
++    }
++    write_db(&db_path, &db);
++    0
++}
++
++// ============== query ==============
++fn cmd_query(args: &[String]) -> i32 {
++    let mut interactive = false;
++    let mut list = false;
++    let mut exact = false;
++    let mut case_sensitive = false;
++    let mut score_filter = None;
++    let mut keywords = Vec::new();
++    let mut i = 0;
++    while i < args.len() {
++        let a = &args[i];
++        match a.as_str() {
++            "-i" | "--interactive" => interactive = true,
++            "-l" | "--list" => list = true,
++            "-a" | "--exact" => exact = true,
++            "-c" | "--case-sensitive" => case_sensitive = true,
++            "-s" | "--score" => {
++                i += 1;
++                if i < args.len() {
++                    if let Ok(v) = args[i].parse::<f64>() {
++                        score_filter = Some(v);
++                    }
++                }
++            }
++            "-V" | "--version" => {
++                print_version();
++                process::exit(0);
++            }
++            "-h" | "--help" => {
++                print_sub_help("query");
++                process::exit(0);
++            }
++            other => {
++                if other.starts_with('-') {
++                    clap_error(&format!(
++                        "error: unrecognized subcommand '{}'\n\nUsage: executable query [OPTIONS] [KEYWORDS]...\n\nFor more information, try '--help'.\n",
++                        other
++                    ));
++                }
++                keywords.push(other.to_string());
++            }
++        }
++        i += 1;
++    }
++    let _ = case_sensitive;
++
++    let db = read_db(&db_path());
++
++    if interactive {
++        return 0;
++    }
++
++    let mut best: Option<&Entry> = None;
++    for e in &db.entries {
++        let p = e.path.to_string_lossy().to_string();
++        if !matches_keyword(&keywords, &p, exact, false) {
++            continue;
++        }
++        if let Some(s) = score_filter {
++            if e.score < s {
++                continue;
++            }
++        }
++        if list {
++            println!("{}", p);
++            continue;
++        }
++        if best.map_or(true, |b| e.score > b.score) {
++            best = Some(e);
++        }
++    }
++    if !list {
++        if let Some(e) = best {
++            println!("{}", e.path.to_string_lossy());
++        }
++    }
++    0
++}
++
++fn matches_keyword(keywords: &[String], path: &str, exact: bool, _ci: bool) -> bool {
++    if keywords.is_empty() {
++        return true;
++    }
++    for k in keywords {
++        if exact {
++            if !path.contains(k.as_str()) {
++                return false;
++            }
++        } else if !fuzzy(k, path) {
++            return false;
++        }
++    }
++    true
++}
++
++fn fuzzy(k: &str, path: &str) -> bool {
++    let k: Vec<char> = k.chars().collect();
++    let p: Vec<char> = path.chars().collect();
++    let mut ki = 0;
++    for pc in &p {
++        if ki < k.len() && *pc == k[ki] {
++            ki += 1;
++        }
++    }
++    ki == k.len()
++}
++
++// ============== import ==============
++fn cmd_import(args: &[String]) -> i32 {
++    let mut i = 0;
++    while i < args.len() {
++        let a = &args[i];
++        if a == "--from" {
++            i += 1;
++        } else if a.starts_with("--from=") {
++        } else if a == "--merge" {
++        } else if a == "-V" || a == "--version" {
++            print_version();
++            process::exit(0);
++        } else if a == "-h" || a == "--help" {
++            print_sub_help("import");
++            process::exit(0);
++        }
++        i += 1;
++    }
++    0
++}
++
++// ============== edit ==============
++fn cmd_edit(_args: &[String]) -> i32 {
++    0
++}
++
++// ============== main ==============
++fn main() {
++    let raw: Vec<String> = env::args().skip(1).collect();
++    if raw.is_empty() {
++        // no args: clap error, exit 2
++        clap_error(
++            "error: the following subcommand must be provided: add|edit|import|init|query|remove\n\nFor more information, try '--help'.\n",
++        );
++    }
++    let first = &raw[0];
++    // global -h/--help
++    if first == "-h" || first == "--help" {
++        print_main_help();
++        process::exit(0);
++    }
++    // global -V/--version (clap processes version with priority)
++    if first == "-V" || first == "--version" {
++        print_version();
++        process::exit(0);
++    }
++
++    let sub = &raw[1..];
++    if sub.contains(&"-h".to_string()) || sub.contains(&"--help".to_string()) {
++        print_sub_help(first);
++        process::exit(0);
++    }
++    if sub.contains(&"-V".to_string()) || sub.contains(&"--version".to_string()) {
++        print_version();
++        process::exit(0);
++    }
++    match first.as_str() {
++        "add" => process::exit(cmd_add(sub)),
++        "remove" => process::exit(cmd_remove(sub)),
++        "query" => process::exit(cmd_query(sub)),
++        "import" => process::exit(cmd_import(sub)),
++        "edit" => process::exit(cmd_edit(sub)),
++        "init" => process::exit(cmd_init(sub)),
++        _ => {
++            clap_error(&format!(
++                "error: unrecognized subcommand '{}'\n\nUsage: {} <COMMAND>\n\nFor more information, try '--help'.\n",
++                first,
++                bin_name()
++            ));
++        }
++    }
++}
