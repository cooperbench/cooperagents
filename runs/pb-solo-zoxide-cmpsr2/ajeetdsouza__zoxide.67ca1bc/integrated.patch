@@ -0,0 +1,17 @@
+use anyhow::Result;
+use std::path::PathBuf;
+
+pub fn import(from: &str, path: &PathBuf) -> Result<()> {
+    let content = std::fs::read_to_string(path)
+        .map_err(|e| anyhow::anyhow!("Could not read file: {}", e))?;
+    
+    let entries: Vec<db::Entry> = serde_json::from_str(&content)
+        .map_err(|e| anyhow::anyhow!("Could not parse file: {}", e))?;
+    
+    for entry in entries {
+        db::add_entry(&PathBuf::from(&entry.path), entry.score)?;
+    }
+    
+    println!("Imported {} entries from {:?}", entries.len(), path);
+    Ok(())
+}
