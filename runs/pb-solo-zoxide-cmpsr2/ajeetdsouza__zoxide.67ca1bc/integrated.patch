+use anyhow::Result;
+use std::path::PathBuf;
+
+pub fn add(score: Option<i64>, paths: &[PathBuf]) -> Result<()> {
+    let score = score.unwrap_or(1);
+    
+    for path in paths {
+        if !path.exists() {
+            eprintln!("Path does not exist: {:?}", path);
+            continue;
+        }
+        db::add_entry(path, score)?;
+        println!("Added: {:?}", path);
+    }
+    
+    Ok(())
+}
diff --git a/src/db.rs b/src/db.rs
