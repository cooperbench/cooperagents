--- /dev/null
+++ b/src/db.rs
@@ -0,0 +1,86 @@
+use anyhow::{Context, Result};
+use serde::{Deserialize, Serialize};
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+static DATA_DIR: OnceLock<PathBuf> = OnceLock::new();
+
+fn data_dir() -> &'static PathBuf {
+    DATA_DIR.get_or_init(|| {
+        dirs::data_local_dir()
+            .expect("Could not determine data directory")
+            .join("zoxide")
+    })
+}
+
+fn db_path() -> PathBuf {
+    data_dir().join("db.zoxide")
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+struct Entry {
+    path: String,
+    score: i64,
+}
+
+pub fn get_db() -> Result<Vec<Entry>> {
+    let path = db_path();
+    if !path.exists() {
+        return Ok(Vec::new());
+    }
+    let content = fs::read_to_string(&path)
+        .with_context(|| format!("Could not read database at {:?}", path))?;
+    let entries: Vec<Entry> = serde_json::from_str(&content)
+        .with_context(|| format!("Could not parse database at {:?}", path))?;
+    Ok(entries)
+}
+
+pub fn save_db(entries: &[Entry]) -> Result<()> {
+    let path = db_path();
+    let content = serde_json::to_string_pretty(entries)
+        .with_context(|| "Could not serialize database")?;
+    fs::write(&path, content)
+        .with_context(|| format!("Could not write database to {:?}", path))?;
+    Ok(())
+}
+
+pub fn add_entry(path: &Path, score: i64) -> Result<()> {
+    let mut entries = get_db()?;
+    let path_str = path.to_string_lossy().to_string();
+    
+    // Check if entry exists
+    let existing_idx = entries.iter().position(|e| e.path == path_str);
+    if let Some(idx) = existing_idx {
+        entries[idx].score += score;
+    } else {
+        entries.push(Entry {
+            path: path_str,
+            score,
+        });
+    }
+    
+    // Sort by score descending
+    entries.sort_by(|a, b| b.score.cmp(&a.score));
+    save_db(&entries)
+}
+
+pub fn remove_entry(path: &Path) -> Result<()> {
+    let mut entries = get_db()?;
+    let path_str = path.to_string_lossy().to_string();
+    entries.retain(|e| e.path != path_str);
+    save_db(&entries)
+}
+
+pub fn query_db(query: &str) -> Result<Vec<Entry>> {
+    let entries = get_db()?;
+    let query_lower = query.to_lowercase();
+    
+    let mut results: Vec<_> = entries
+        .into_iter()
+        .filter(|e| e.path.to_lowercase().contains(&query_lower))
+        .collect();
+    
+    results.sort_by(|a, b| b.score.cmp(&a.score));
+    Ok(results)
+}
