+use anyhow::Result;
+
+pub fn init(shell: &str) -> Result<()> {
+    let config = match shell.to_lowercase().as_str() {
+        "bash" => include_str!("init.bash"),
+        "zsh" => include_str!("init.zsh"),
+        "fish" => include_str!("init.fish"),
+        "powershell" => include_str!("init.powershell"),
+        "elvish" => include_str!("init.elvish"),
+        "nushell" => include_str!("init.nushell"),
+        "posix" => include_str!("init.posix"),
+        _ => {
+            eprintln!("Unknown shell: {}", shell);
+            return Err(anyhow::anyhow!("Unknown shell"));
+        }
+    };
+    
+    println!("{}", config);
+    Ok(())
+}
