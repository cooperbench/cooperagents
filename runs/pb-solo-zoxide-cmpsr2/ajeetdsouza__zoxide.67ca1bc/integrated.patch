+++ b/src/remove.rs
@@ -0,0 +1,15 @@
+use anyhow::Result;
+use std::path::PathBuf;
+
+pub fn remove(paths: &[PathBuf]) -> Result<()> {
+    for path in paths {
+        if !path.exists() {
+            eprintln!("Path does not exist: {:?}", path);
+            continue;
+        }
+        db::remove_entry(path)?;
+        println!("Removed: {:?}", path);
+    }
+    
+    Ok(())
+}
