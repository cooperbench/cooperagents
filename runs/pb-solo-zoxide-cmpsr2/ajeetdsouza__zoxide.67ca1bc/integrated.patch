+++ b/src/query.rs
@@ -0,0 +1,24 @@
+use anyhow::Result;
+use std::path::PathBuf;
+
+pub fn query(query: Option<String>) -> Result<()> {
+    let query = query.unwrap_or_else(|| String::from(""));
+    
+    if query.is_empty() {
+        println!("No query provided. Use 'z <query>' to search.");
+        return Ok(());
+    }
+    
+    let entries = db::query_db(&query)?;
+    
+    if entries.is_empty() {
+        println!("No matching directories found.");
+        return Ok(());
+    }
+    
+    for entry in entries {
+        println!("{} (score: {})", entry.path, entry.score);
+    }
+    
+    Ok(())
+}
