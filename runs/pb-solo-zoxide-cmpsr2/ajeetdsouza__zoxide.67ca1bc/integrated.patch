+++ b/src/main.rs
@@ -0,0 +1,71 @@
+mod db;
+mod query;
+mod add;
+mod remove;
+mod edit;
+mod import;
+mod init;
+
+use anyhow::{Context, Result};
+use clap::{Parser, Subcommand};
+use std::path::PathBuf;
+
+#[derive(Parser)]
+#[command(name = "zoxide")]
+#[command(author = "Ajeet D'Souza <98ajeet@gmail.com>")]
+#[command(version = "0.9.9")]
+#[command(about = "A smarter cd command for your terminal", long_about = None)]
+struct Cli {
+    #[command(subcommand)]
+    command: Commands,
+}
+
+#[derive(Subcommand)]
+enum Commands {
+    /// Add a new directory or increment its rank
+    Add {
+        /// The rank to increment the entry if it exists or initialize it with if it doesn't
+        #[arg(short, long)]
+        score: Option<i64>,
+        /// Paths to add
+        paths: Vec<PathBuf>,
+    },
+    /// Edit the database
+    Edit,
+    /// Import entries from another application
+    Import {
+        /// Source application
+        #[arg(short, long)]
+        from: String,
+        /// Path to the source database
+        path: PathBuf,
+    },
+    /// Generate shell configuration
+    Init {
+        /// Shell type
+        #[arg(short, long, default_value = "bash")]
+        shell: String,
+    },
+    /// Search for a directory in the database
+    Query {
+        /// Query string
+        query: Option<String>,
+    },
+    /// Remove a directory from the database
+    Remove {
+        /// Paths to remove
+        paths: Vec<PathBuf>,
+    },
+}
+
+fn main() -> Result<()> {
+    let cli = Cli::parse();
+    match cli.command {
+        Commands::Add { score, paths } => add::add(score, &paths),
+        Commands::Edit => edit::edit(),
+        Commands::Import { from, path } => import::import(&from, &path),
+        Commands::Init { shell } => init::init(&shell),
+        Commands::Query { query } => query::query(query),
+        Commands::Remove { paths } => remove::remove(&paths),
+    }
+}
diff --git a/src/query.rs b/src/query.rs
