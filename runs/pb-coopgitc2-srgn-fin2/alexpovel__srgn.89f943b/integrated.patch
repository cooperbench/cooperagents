+fn should_replace(text: &str, pattern: &str, replacement: &str, 
+                  upper: bool, lower: bool, delete: bool, squeeze: bool,
+                  symbols: bool, german: bool, invert: bool,
+                  python: bool, rust: bool, typescript: bool, javascript: bool,
+                  java: bool, c: bool, cpp: bool, go: bool, ruby: bool,
+                  php: bool, perl: bool, lua: bool, kotlin: bool, scala: bool,
+                  swift: bool, dart: bool, r: bool, sql: bool, html: bool,
+                  css: bool, json: bool, yaml: bool, xml: bool) -> String {
+    
+    if invert {
+        return text.to_string();
+    }
+    
+    if delete {
+        if let Some(pos) = text.find(pattern) {
+            if squeeze {
+                // Remove all consecutive matches
+                let mut result = String::new();
+                let mut chars: Vec<char> = text.chars().collect();
+                let mut i = 0;
+                let pattern_chars: Vec<char> = pattern.chars().collect();
+                while i < chars.len() {
+                    if i + pattern_chars.len() <= chars.len() && chars[i..i+pattern_chars.len()].iter().eq(pattern_chars.iter()) {
+                        // Found a match - skip it
+                        i += pattern_chars.len();
+                    } else {
+                        result.push(chars[i]);
+                        i += 1;
+                    }
+                }
+                return result;
+            } else {
+                return text.replace(pattern, "");
+            }
+        }
+        return text.to_string();
+    }
+    
+    if upper {
+        return text.to_uppercase();
+    }
+    
+    if lower {
+        return text.to_lowercase();
+    }
+    
+    if symbols {
+        let result = apply_symbols(text);
+        if let Some(pos) = result.find(pattern) {
+            return result.replace(&result[pos..pos+pattern.len()], replacement);
+        }
+        return result;
+    }
+    
+    if german {
+        let result = apply_german(text);
+        if let Some(pos) = result.find(pattern) {
+            return result.replace(&result[pos..pos+pattern.len()], replacement);
+        }
+        return result;
+    }
+    
+    if let Some(pos) = text.find(pattern) {
+        if squeeze {
+            // Squeeze: replace only the first consecutive match
+            let mut result = String::new();
+            let mut chars: Vec<char> = text.chars().collect();
+            let mut i = 0;
+            let pattern_chars: Vec<char> = pattern.chars().collect();
+            let mut first_match = true;
+            while i < chars.len() {
+                if i + pattern_chars.len() <= chars.len() && chars[i..i+pattern_chars.len()].iter().eq(pattern_chars.iter()) {
+                    // Found a match
+                    if first_match {
+                        // This is the first match, replace it
+                        result.push_str(replacement);
+                        first_match = false;
+                    } else {
+                        // This is a consecutive match, keep it
+                        for c in chars[i..i+pattern_chars.len()].iter() {
+                            result.push(*c);
+                        }
+                    }
+                    i += pattern_chars.len();
+                } else {
+                    result.push(chars[i]);
+                    i += 1;
+                }
+            }
+            return result;
+        } else {
+            return text.replace(pattern, replacement);
+        }
+    }
