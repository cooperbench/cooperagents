+    let mut pattern = args[1].clone();
+    let mut replacement: Option<String> = None;
+    let mut upper = false;
+    let mut lower = false;
+    let mut delete = false;
+    let mut squeeze = false;
+    let mut symbols = false;
+    let mut german = false;
+    let mut invert = false;
+    let mut dry_run = false;
+    let mut literal_string = false;
+    let mut search = false;
+    let mut glob = false;
+    
+    let mut lang = String::new();
+    let mut lang_set = false;
+    
+    let mut i = 2;
+    while i < args.len() {
+        let arg = &args[i];
+        if arg == "-h" || arg == "--help" {
+            print_help();
+            process::exit(0);
+        } else if arg == "-v" || arg == "--version" {
+            print_version();
+            process::exit(0);
+        } else if arg == "--upper" {
+            upper = true;
+        } else if arg == "--lower" {
+            lower = true;
+        } else if arg == "--delete" {
+            delete = true;
+        } else if arg == "--squeeze" {
+            squeeze = true;
+        } else if arg == "--symbols" {
+            symbols = true;
+        } else if arg == "--german" {
+            german = true;
+        } else if arg == "--invert" {
+            invert = true;
+        } else if arg == "--dry-run" {
+            dry_run = true;
+        } else if arg == "--literal-string" {
+            literal_string = true;
+        } else if arg == "--search" {
+            search = true;
+        } else if arg == "--glob" {
+            glob = true;
+        } else if arg.starts_with("--") && !arg.starts_with("--upper") && 
+                  !arg.starts_with("--lower") && !arg.starts_with("--delete") &&
+                  !arg.starts_with("--squeeze") && !arg.starts_with("--symbols") &&
+                  !arg.starts_with("--german") && !arg.starts_with("--invert") &&
+                  !arg.starts_with("--dry-run") && !arg.starts_with("--literal-string") &&
+                  !arg.starts_with("--search") && !arg.starts_with("--glob") {
+            lang = arg[2..].to_string();
+            lang_set = true;
