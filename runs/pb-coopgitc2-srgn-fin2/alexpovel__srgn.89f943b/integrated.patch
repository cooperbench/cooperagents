+        &input, &pattern, 
+        replacement.as_deref().unwrap_or(""),
+        upper, lower, delete, squeeze,
+        symbols, german, invert,
+        is_python_scope(&lang), is_rust_scope(&lang), is_typescript_scope(&lang),
+        is_javascript_scope(&lang), is_java_scope(&lang), is_c_scope(&lang),
+        is_cpp_scope(&lang), is_go_scope(&lang), is_ruby_scope(&lang),
+        is_php_scope(&lang), is_perl_scope(&lang), is_lua_scope(&lang),
+        is_kotlin_scope(&lang), is_scala_scope(&lang), is_swift_scope(&lang),
+        is_dart_scope(&lang), is_r_scope(&lang), is_sql_scope(&lang),
+        is_html_scope(&lang), is_css_scope(&lang), is_json_scope(&lang),
+        is_yaml_scope(&lang), is_xml_scope(&lang)
+    );
+    
+    if dry_run {
+        println!("Would change:");
+        println!("Input: {:?}", input);
+        println!("Output: {:?}", output);
+    } else {
+        print!("{}", output);
+    }
+}
