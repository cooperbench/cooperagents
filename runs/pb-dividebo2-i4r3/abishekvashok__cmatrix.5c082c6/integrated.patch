+    /* Print help or version if requested */
+    if (g_opts.help || g_opts.version) {
+        if (g_opts.help) {
+            options_print_usage(argv[0]);
+        } else if (g_opts.version) {
+            options_print_version();
+        }
+        return 0;
+    }
+    
+    /* Validate color if specified */
+    if (g_opts.color && !validate_color(g_opts.color)) {
+        error_exit("Invalid color selection", 1);
+    }
+    
+    /* Validate delay if specified */
+    if (g_opts.update_delay < 0 || g_opts.update_delay > 10) {
+        error_exit("Invalid update delay", 1);
+    }
+    
+    /* Initialize terminal */
+    if (init_terminal() == -1) {
+        error_exit("Error opening terminal: unknown.", 1);
+    }
+    
+    /* Set up signal handler */
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+    
+    /* Get terminal size */
+    get_term_size(&rows, &cols);
+    
+    /* Allocate output buffer */
+    output = malloc(rows * cols * sizeof(char));
+    if (!output) {
+        error_exit("Memory allocation failed", 1);
+    }
+    
+    /* Main loop */
+    while (running) {
+        /* Get matrix characters */
+        get_matrix_chars(output, rows * cols, &g_opts);
+        
+        /* Print matrix */
+        print_matrix(&g_opts);
+        
+        /* Handle keystrokes if not in screensaver mode */
+        if (!g_opts.screensaver) {
+            fd_set readfds;
+            struct timeval timeout;
+            int ret;
+            
+            FD_ZERO(&readfds);
+            FD_SET(STDIN_FILENO, &readfds);
+            
+            timeout.tv_sec = g_opts.update_delay;
+            timeout.tv_usec = 0;
+            
+            ret = select(STDIN_FILENO + 1, &readfds, NULL, NULL, &timeout);
+            if (ret > 0) {
+                if (read(STDIN_FILENO, &ch, 1) > 0) {
+                    handle_keystroke(ch, &g_opts);
+                }
+            }
+        }
+        
+        /* Sleep for update delay */
+        usleep(g_opts.update_delay * 100000);
+    }
+    
+    /* Restore terminal */
+    restore_terminal();
+    
+    /* Free memory */
+    free(output);
+    
+    return 0;
+}
diff --git a/src/matrix.c b/src/matrix.c
new file mode 100644
index 0000000..6a98652
--- /dev/null
+++ b/src/matrix.c
@@ -0,0 +1,178 @@
+#include "matrix.h"
+#include "error.h"
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <signal.h>
+#include <time.h>
+#include <stdlib.h>
+
+/* Initialize terminal settings */
+int init_terminal(void) {
+    struct termios oldt, newt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return -1;
+    }
+    
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) == -1) {
+        return -1;
+    }
+    
+    return 0;
+}
+
+/* Restore terminal settings */
+void restore_terminal(void) {
+    struct termios oldt;
+    
+    if (tcgetattr(STDIN_FILENO, &oldt) == -1) {
+        return;
+    }
+    
+    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
+}
+
+/* Get terminal dimensions */
+void get_term_size(int *rows, int *cols) {
+    struct winsize ws;
+    
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == -1) {
+        *rows = 24;
+        *cols = 80;
+    } else {
+        *rows = ws.ws_row;
+        *cols = ws.ws_col;
+    }
+}
+
+/* Get matrix characters based on mode */
+void get_matrix_chars(char *chars, int count, Options *opts) {
+    static const char *katakana = 
+        "アァカサタナハマヤャラワガザダバパイ"
+        "ィイウエオゥヴカシチニヒミヂビピ"
+        "ェェォフクスツヌフムユュルグズブヅプ"
+        "ョョヮヴクググヅヅヅ"
+        "トトトトトドド";
+    
+    static const char *latin = 
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+        "abcdefghijklmnopqrstuvwxyz"
+        "0123456789";
+    
+    static const char *lambda = 
+        "λλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλ";
+    
+    const char *charset;
+    int len;
+    
+    if (opts->lambda_mode) {
+        charset = lambda;
+        len = strlen(lambda);
+    } else if (opts->use_japanese) {
+        charset = katakana;
+        len = strlen(katakana);
+    } else {
+        charset = latin;
+        len = strlen(latin);
+    }
+    
+    for (int i = 0; i < count; i++) {
+        chars[i] = charset[rand() % len];
+    }
+}
+
+/* Print matrix with scrolling */
+void print_matrix(Options *opts) {
+    int rows, cols;
+    char *output;
+    int i, j;
+    
+    get_term_size(&rows, &cols);
+    
+    output = malloc(rows * cols * sizeof(char));
+    if (!output) {
+        error_exit("Memory allocation failed", 1);
+    }
+    
+    /* Get matrix characters */
+    get_matrix_chars(output, rows * cols, opts);
+    
+    /* Print matrix */
+    for (i = 0; i < rows; i++) {
+        for (j = 0; j < cols; j++) {
+            putchar(output[i * cols + j]);
+        }
+        putchar('\n');
+    }
+    
+    free(output);
+}
+
+/* Handle interactive keystrokes */
+void handle_keystroke(int ch, Options *opts) {
+    (void)opts;
+    
+    switch (ch) {
+        case 'a':
+            /* Toggle async scroll */
+            break;
+        case 'b':
+            /* Random bold characters */
+            break;
+        case 'B':
+            /* All bold characters */
+            break;
+        case 'n':
+            /* Turn off bold characters */
+            break;
+        case '0':
+        case '1':
+        case '2':
+        case '3':
+        case '4':
+        case '5':
+        case '6':
+        case '7':
+        case '8':
+        case '9':
+            /* Adjust update speed */
+            break;
+        case '!':
+            /* Change color to red */
+            break;
+        case '@':
+            /* Change color to green */
+            break;
+        case '#':
+            /* Change color to yellow */
+            break;
+        case '$':
+            /* Change color to blue */
+            break;
+        case '%':
+            /* Change color to magenta */
+            break;
+        case '^':
+            /* Change color to cyan */
+            break;
+        case '&':
+            /* Change color to white */
+            break;
+        case ')':
+            /* Change color to black */
+            break;
+        case 'q':
+            /* Quit the program */
+            exit(0);
+        default:
+            break;
+    }
+}
