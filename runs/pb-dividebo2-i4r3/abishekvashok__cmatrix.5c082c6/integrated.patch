diff --git a/src/options.c b/src/options.c
new file mode 100644
index 0000000..73784bc
--- /dev/null
+++ b/src/options.c
@@ -0,0 +1,179 @@
+#include "options.h"
+#include <ctype.h>
+
+const char *VERSION_STRING = "CMatrix version 2.0 (compiled 22:13:51, Jun 11 2026)";
+
+void options_init(Options *opts) {
+    opts->async_scroll = 0;
+    opts->bold_chars = 0;
+    opts->all_bold = 0;
+    opts->force_term = 0;
+    opts->linux_mode = 0;
+    opts->old_scroll = 0;
+    opts->shadows_only = 0;
+    opts->lock_mode = 0;
+    opts->rainbow_mode = 0;
+    opts->lambda_mode = 0;
+    opts->chars_change = 0;
+    opts->screensaver = 0;
+    opts->x_window = 0;
+    opts->no_bold = 0;
+    opts->help = 0;
+    opts->version = 0;
+    opts->use_japanese = 0;
+    opts->use_message = 0;
+    opts->use_tty = 0;
+    opts->update_delay = 4;
+    opts->color = NULL;
+    opts->message = NULL;
+    opts->tty = NULL;
+}
+
+void options_print_usage(const char *progname) {
+    (void)progname;
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+void options_print_version(void) {
+    printf(" %s\n", VERSION_STRING);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+void options_error(const char *msg, int exit_code) {
+    fprintf(stderr, "Error: %s\n", msg);
+    exit(exit_code);
+}
+
+int options_parse(int argc, char **argv, Options *opts) {
+    int opt;
+    int option_index = 0;
+    static struct option long_options[] = {
+        {"async", no_argument, 0, 'a'},
+        {"bold", no_argument, 0, 'b'},
+        {"all-bold", no_argument, 0, 'B'},
+        {"force", no_argument, 0, 'f'},
+        {"linux", no_argument, 0, 'l'},
+        {"lock", no_argument, 0, 'L'},
+        {"old", no_argument, 0, 'o'},
+        {"help", no_argument, 0, 'h'},
+        {"no-bold", no_argument, 0, 'n'},
+        {"screensaver", no_argument, 0, 's'},
+        {"x-window", no_argument, 0, 'x'},
+        {"version", no_argument, 0, 'V'},
+        {"message", required_argument, 0, 'M'},
+        {"update", required_argument, 0, 'u'},
+        {"color", required_argument, 0, 'C'},
+        {"rainbow", no_argument, 0, 'r'},
+        {"lambda", no_argument, 0, 'm'},
+        {"chars-change", no_argument, 0, 'k'},
+        {"tty", required_argument, 0, 't'},
+        {0, 0, 0, 0}
+    };
+
+    opts->help = 0;
+    opts->version = 0;
+
+    while ((opt = getopt_long(argc, argv, "abBcfhlsmVxknoC", long_options, &option_index)) != -1) {
+        switch (opt) {
+            case 'a':
+                opts->async_scroll = 1;
+                break;
+            case 'b':
+                opts->bold_chars = 1;
+                break;
+            case 'B':
+                opts->all_bold = 1;
+                break;
+            case 'c':
+                opts->use_japanese = 1;
+                break;
+            case 'f':
+                opts->force_term = 1;
+                break;
+            case 'l':
+                opts->linux_mode = 1;
+                break;
+            case 'L':
+                opts->lock_mode = 1;
+                break;
+            case 'o':
+                opts->old_scroll = 1;
+                break;
+            case 'h':
+                opts->help = 1;
+                break;
+            case 'n':
+                opts->no_bold = 1;
+                break;
+            case 's':
+                opts->screensaver = 1;
+                break;
+            case 'x':
+                opts->x_window = 1;
+                break;
+            case 'V':
+                opts->version = 1;
+                break;
+            case 'M':
+                opts->use_message = 1;
+                opts->message = optarg;
+                break;
+            case 'u':
+                opts->update_delay = atoi(optarg);
+                if (opts->update_delay < 0 || opts->update_delay > 10) {
+                    options_error("Update delay must be between 0 and 10", 1);
+                }
+                break;
+            case 'C':
+                opts->color = optarg;
+                break;
+            case 'r':
+                opts->rainbow_mode = 1;
+                break;
+            case 'm':
+                opts->lambda_mode = 1;
+                break;
+            case 'k':
+                opts->chars_change = 1;
+                break;
+            case 't':
+                opts->use_tty = 1;
+                opts->tty = optarg;
+                break;
+            case '?':
+                if (optopt == 'M' || optopt == 'u' || optopt == 'C' || optopt == 't') {
+                    fprintf(stderr, "Option -%c requires an argument.\n", optopt);
+                } else if (isprint(optopt)) {
+                    fprintf(stderr, "Unknown option `-%c'.\n", optopt);
+                } else {
+                    fprintf(stderr, "Unknown option character `\\x%x'.\n", optopt);
+                }
+                return 1;
+            default:
+                return 1;
+        }
+    }
+
+    return 0;
+}
diff --git a/src/options.h b/src/options.h
