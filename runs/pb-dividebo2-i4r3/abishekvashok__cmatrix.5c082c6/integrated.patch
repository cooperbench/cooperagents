+#ifndef OPTIONS_H
+#define OPTIONS_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <getopt.h>
+
+/* Version string */
+extern const char *VERSION_STRING;
+
+/* Option structures */
+typedef struct {
+    int async_scroll;
+    int bold_chars;
+    int all_bold;
+    int force_term;
+    int linux_mode;
+    int old_scroll;
+    int shadows_only;
+    int lock_mode;
+    int rainbow_mode;
+    int lambda_mode;
+    int chars_change;
+    int screensaver;
+    int x_window;
+    int no_bold;
+    int help;
+    int version;
+    int use_japanese;
+    int use_message;
+    int use_tty;
+    
+    int update_delay;
+    char *color;
+    char *message;
+    char *tty;
+} Options;
+
+/* Initialize options with defaults */
+void options_init(Options *opts);
+
+/* Parse command line options */
+int options_parse(int argc, char **argv, Options *opts);
+
+/* Print usage information */
+void options_print_usage(const char *progname);
+
+/* Print version information */
+void options_print_version(void);
+
+/* Print error message and exit */
+void options_error(const char *msg, int exit_code);
+
+#endif /* OPTIONS_H */
