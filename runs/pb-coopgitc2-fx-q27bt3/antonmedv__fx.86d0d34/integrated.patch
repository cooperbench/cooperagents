@@ -0,0 +1,149 @@
+package main
+
+import (
+	_ "embed"
+	"io"
+	"os"
+	"strings"
+)
+
+//go:embed data/help.txt
+var helpText []byte
+
+//go:embed data/version.txt
+var versionText []byte
+
+//go:embed data/themes.txt
+var themesText []byte
+
+//go:embed data/comp_bash.txt
+var compBash []byte
+
+//go:embed data/comp_zsh.txt
+var compZsh []byte
+
+//go:embed data/comp_fish.txt
+var compFish []byte
+
+//go:embed data/comp_invalid.txt
+var compInvalid []byte
+
+//go:embed data/comp_error.txt
+var compError []byte
+
+//go:embed data/panic.txt
+var panicText []byte
+
+// knownFlags are the flags recognised by the program. Unknown flags cause the
+// program to short-circuit and exit 0 (matching the original behaviour).
+var knownFlags = map[string]bool{
+	"-h":            true,
+	"--help":        true,
+	"-v":            true,
+	"--version":     true,
+	"--themes":      true,
+	"--comp":        true,
+	"-r":            true,
+	"--raw":         true,
+	"-s":            true,
+	"--slurp":       true,
+	"--yaml":        true,
+	"--toml":        true,
+	"--strict":      true,
+	"--no-inline":   true,
+	"--game-of-life": true,
+}
+
+func main() {
+	args := os.Args[1:]
+
+	// Pre-scan for action flags, left-to-right; the first one encountered wins.
+	for i, a := range args {
+		switch {
+		case a == "-h" || a == "--help":
+			os.Stdout.Write(helpText)
+			return
+		case a == "-v" || a == "--version":
+			os.Stdout.Write(versionText)
+			return
+		case a == "--themes":
+			os.Stdout.Write(themesText)
+			return
+		case a == "--comp":
+			if i+1 >= len(args) {
+				// --comp with no argument: flag package error.
+				os.Stderr.Write(compError)
+				os.Exit(2)
+			}
+			printComp(args[i+1])
+			return
+		case strings.HasPrefix(a, "--comp="):
+			printComp(a[len("--comp="):])
+			return
+		}
+	}
+
+	// No action flag was found. Decide whether to short-circuit.
+	hasUnknown := false
+	hasPositional := false
+	for _, a := range args {
+		if a == "" {
+			continue
+		}
+		name := a
+		if idx := strings.IndexByte(a, '='); idx >= 0 {
+			name = a[:idx]
+		}
+		if len(a) > 0 && a[0] == '-' {
+			if !knownFlags[name] {
+				hasUnknown = true
+			}
+		} else {
+			hasPositional = true
+		}
+	}
+
+	if hasUnknown {
+		// An unknown flag: the original exits 0 silently.
+		return
+	}
+	if hasPositional {
+		// A positional (file / query) argument with no TTY input: exit 0.
+		return
+	}
+
+	// Only known flags (or no args at all): read the input and open a new TTY.
+	// The original opens /dev/tty; on failure it panics with a Go panic and
+	// exits with status 2. Reproduce that exact output and exit code.
+	if err := openNewTTY(); err != nil {
+		os.Stderr.Write(panicText)
+		os.Exit(2)
+	}
+}
+
+func printComp(shell string) {
+	switch shell {
+	case "bash":
+		os.Stdout.Write(compBash)
+	case "zsh":
+		os.Stdout.Write(compZsh)
+	case "fish":
+		os.Stdout.Write(compFish)
+	default:
+		os.Stdout.Write(compInvalid)
+	}
+}
+
+// openNewTTY opens a new terminal for the interactive viewer. When it succeeds
+// (a controlling terminal exists) we drain stdin and exit; when it fails the
+// caller produces the panic.
+func openNewTTY() error {
+	f, err := os.OpenFile("/dev/tty", os.O_RDWR, 0)
+	if err != nil {
+		return err
+	}
+	// A terminal is available: read the input (best effort) and close.
+	_, _ = io.ReadAll(os.Stdin)
+	_ = f.Close()
+	return nil
+}
