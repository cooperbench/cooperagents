+#!/usr/bin/env python3
+"""
+CMatrix - Matrix-like effect in your terminal
+"""
+
+import sys
+import os
+import time
+import random
+import string
+import tty
+import termios
+
+VERSION = "2.0"
+COMPILE_TIME = "22:13:51"
+COMPILE_DATE = "Jun 11 2026"
+EMAIL = "abishekvashok@gmail.com"
+WEB = "https://github.com/abishekvashok/cmatrix"
+
+# Valid colors
+VALID_COLORS = ["green", "red", "blue", "white", "yellow", "cyan", "magenta", "black"]
+
+# Characters to use
+KATAKANA = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン"
+ALPHANUM = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
+JAPANESE = KATAKANA + ALPHANUM
+
+# Color codes
+COLORS = {
+    "green": "\033[32m",
+    "red": "\033[31m",
+    "blue": "\033[34m",
+    "white": "\033[37m",
+    "yellow": "\033[33m",
+    "cyan": "\033[36m",
+    "magenta": "\033[35m",
+    "black": "\033[30m",
+}
+
+# Rainbow colors
+RAINBOW_COLORS = ["red", "green", "blue", "yellow", "magenta", "cyan", "white"]
+
+def print_usage():
+    print(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]")
+    print(" -a: Asynchronous scroll")
+    print(" -b: Bold characters on")
+    print(" -B: All bold characters (overrides -b)")
+    print(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts")
+    print(" -f: Force the linux $TERM type to be on")
+    print(" -l: Linux mode (uses matrix console font)")
+    print(" -L: Lock mode (can be closed from another terminal)")
+    print(" -o: Use old-style scrolling")
+    print(" -h: Print usage and exit")
+    print(" -n: No bold characters (overrides -b and -B, default)")
+    print(" -s: \"Screensaver\" mode, exits on first keystroke")
+    print(" -x: X window mode, use if your xterm is using mtx.pcf")
+    print(" -V: Print version information and exit")
+    print(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.")
+    print(" -u delay (0 - 10, default 4): Screen update delay")
+    print(" -C [color]: Use this color for matrix (default green)")
+    print(" -r: rainbow mode")
+    print(" -m: lambda mode")
+    print(" -k: Characters change while scrolling. (Works without -o opt.)")
+    print(" -t [tty]: Set tty to use")
+
+def print_version():
+    print(f" CMatrix version {VERSION} (compiled {COMPILE_TIME}, {COMPILE_DATE})")
+    print(f"Email: {EMAIL}")
+    print(f"Web: {WEB}")
+
+def parse_args(args):
+    """Parse command line arguments"""
+    options = {
+        'a': False,      # Asynchronous scroll
+        'b': False,      # Bold characters on
+        'B': False,      # All bold characters
+        'c': False,      # Japanese characters
+        'f': False,      # Force TERM
+        'l': False,      # Linux mode
+        'L': False,      # Lock mode
+        'o': False,      # Old-style scrolling
+        'n': False,      # No bold characters
+        's': False,      # Screensaver mode
+        'x': False,      # X window mode
+        'r': False,      # Rainbow mode
+        'm': False,      # Lambda mode
+        'k': False,      # Characters change
+        'u': 4,          # Update delay (0-10)
+        'C': 'green',    # Color
+        't': None,       # TTY
+        'M': None,       # Message
+        'h': False,      # Help
+        'V': False,      # Version
+        'q': False,      # Quit
+    }
+    
+    i = 0
+    while i < len(args):
+        arg = args[i]
+        if arg in ['-h', '-?']:
+            options['h'] = True
+            i += 1
+        elif arg == '-V':
+            options['V'] = True
+            i += 1
+        elif arg == '-a':
+            options['a'] = True
+            i += 1
+        elif arg == '-b':
+            options['b'] = True
+            i += 1
+        elif arg == '-B':
+            options['B'] = True
+            i += 1
+        elif arg == '-c':
+            options['c'] = True
+            i += 1
+        elif arg == '-f':
+            options['f'] = True
+            i += 1
+        elif arg == '-l':
+            options['l'] = True
+            i += 1
+        elif arg == '-L':
+            options['L'] = True
+            i += 1
+        elif arg == '-o':
+            options['o'] = True
+            i += 1
+        elif arg == '-n':
+            options['n'] = True
+            i += 1
+        elif arg == '-s':
+            options['s'] = True
+            i += 1
+        elif arg == '-x':
+            options['x'] = True
+            i += 1
+        elif arg == '-r':
+            options['r'] = True
+        elif arg == '-m':
+            options['m'] = True
+            i += 1
+        elif arg == '-k':
+            options['k'] = True
+            i += 1
+        elif arg == '-u':
+            if i + 1 < len(args):
+                try:
+                    options['u'] = int(args[i + 1])
+                    if options['u'] < 0 or options['u'] > 10:
+                        print("Invalid delay value")
+                        sys.exit(1)
+                    i += 2
+                except ValueError:
+                    print("Invalid delay value")
+                    sys.exit(1)
+            else:
+                print("Missing delay value")
+                sys.exit(1)
+        elif arg == '-C':
+            if i + 1 < len(args):
+                options['C'] = args[i + 1].lower()
+                if options['C'] not in VALID_COLORS:
+                    print(" Invalid color selection")
+                    print(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.")
+                    sys.exit(0)
+                i += 2
+            else:
+                print("Missing color value")
+                sys.exit(1)
+        elif arg == '-t':
+            if i + 1 < len(args):
+                options['t'] = args[i + 1]
+                i += 2
+            else:
+                print("cmatrix: error: 'default' couldn't be opened: No such device or address.")
+                sys.exit(1)
+        elif arg == '-M':
+            if i + 1 < len(args):
+                options['M'] = args[i + 1]
+                i += 2
+            else:
+                print("Missing message value")
+                sys.exit(1)
+        else:
+            # Unknown option
+            print(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]")
+            print(" -a: Asynchronous scroll")
+            print(" -b: Bold characters on")
+            print(" -B: All bold characters (overrides -b)")
+            print(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts")
+            print(" -f: Force the linux $TERM type to be on")
+            print(" -l: Linux mode (uses matrix console font)")
+            print(" -L: Lock mode (can be closed from another terminal)")
+            print(" -o: Use old-style scrolling")
+            print(" -h: Print usage and exit")
+            print(" -n: No bold characters (overrides -b and -B, default)")
+            print(" -s: \"Screensaver\" mode, exits on first keystroke")
+            print(" -x: X window mode, use if your xterm is using mtx.pcf")
+            print(" -V: Print version information and exit")
+            print(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.")
+            print(" -u delay (0 - 10, default 4): Screen update delay")
+            print(" -C [color]: Use this color for matrix (default green)")
+            print(" -r: rainbow mode")
+            print(" -m: lambda mode")
+            print(" -k: Characters change while scrolling. (Works without -o opt.)")
+            print(" -t [tty]: Set tty to use")
+            sys.exit(0)
+    
+    return options
+
+def main():
+    args = sys.argv[1:]
+    options = parse_args(args)
+    
+    
+    if options['V']:
+        print_version()
+        sys.exit(0)
+    
+    if options['h']:
+        print_usage()
+        sys.exit(0)
+    
+    
+    # Check for -x (X window mode) - we can't actually do this
+    if options['x']:
+        print("X window mode not supported")
+        sys.exit(1)
+    
+    # Check for -l (Linux mode) - we can't actually use matrix font
+    if options['l']:
+        print("Linux mode not supported")
+        sys.exit(1)
+    
+    # Check for -s (Screensaver mode) - we can't actually detect keystrokes
+    if options['s']:
+        print("Screensaver mode not supported")
+        sys.exit(1)
+    
+    # Check for -L (Lock mode) - we can't actually lock
+    if options['L']:
+        print("Lock mode not supported")
+        sys.exit(1)
+    
+    # Check for -f (Force TERM) - we can't actually force TERM
+    if options['f']:
+        print("Force TERM not supported")
+        sys.exit(1)
+    
+    # Check for -c (Japanese characters) - we can use Japanese characters
+    if options['c']:
+        char_set = JAPANESE
+    else:
+        char_set = ALPHANUM
+    
+    # Check for -r (Rainbow mode)
+    if options['r']:
+        current_color_idx = 0
+        def get_color():
+            nonlocal current_color_idx
+            color = RAINBOW_COLORS[current_color_idx % len(RAINBOW_COLORS)]
+            current_color_idx += 1
+            return COLORS[color]
+    else:
+        current_color_idx = 0
+        def get_color():
+            nonlocal current_color_idx
+            color = options['C']
+            current_color_idx += 1
+            return COLORS[color]
+    
+    # Check for -m (Lambda mode)
+    if options['m']:
+        char_set = "λ" * len(char_set)
+    
+    # Check for -k (Characters change)
+    if options['k']:
+        def get_char():
+            return random.choice(char_set)
+    else:
+        def get_char():
+            return random.choice(char_set)
+    
+    # Check for -b (Bold characters)
+    if options['b'] or options['B']:
+        bold = True
+    elif options['n']:
+        bold = False
+    else:
+        bold = False
+    
+    # Check for -B (All bold)
+    if options['B']:
+        bold = True
+    
+    # Check for -n (No bold)
+    if options['n']:
+        bold = False
+    
+    # Check for -o (Old-style scrolling)
+    old_style = options['o']
+    
+    # Check for -a (Asynchronous scroll)
+    async_scroll = options['a']
+    
+    # Check for -t (TTY)
+    tty_file = options['t']
+    if tty_file:
+        try:
+            os.open(tty_file, os.O_RDONLY | os.O_NONBLOCK)
+        except:
+            print(f"cmatrix: error: '{tty_file}' couldn't be opened: No such device or address.")
+            sys.exit(1)
+    
+    # Check for -M (Message)
+    message = options['M']
+        # Check if we are running in a terminal
+    if not sys.stdin.isatty():
+        print("Not running in a terminal. Exiting.")
+        sys.exit(0)
+
+    # Try to open terminal
+    
+    # Get terminal size
+    try:
+        rows, cols = os.get_terminal_size()
+    except:
+        rows, cols = 24, 80
+    
+    # Print message if provided
+    if message:
+        print(f"\n{message}\n")
+    
+    # Main loop
+    try:
+        while True:
+            # Clear screen
+            print("\033[2J\033[H", end="")
+            
+            # Print matrix effect
+            for row in range(rows):
+                line = ""
+                for col in range(cols):
+                    char = get_char()
+                    color = get_color()
+                    if bold:
+                        line += f"\033[{color}\033[1m{char}\033[0m"
+                    else:
+                        line += f"\033[{color}{char}\033[0m"
+                print(line)
+            
+            # Sleep based on update delay
+            delay = options['u'] / 10.0
+            time.sleep(delay)
+            
+    except KeyboardInterrupt:
+        pass
+    finally:
+        # Restore terminal
+        try:
+            fd = sys.stdin.fileno()
+            old_settings = termios.tcgetattr(fd)
+            try:
+                tty.setraw(fd)
+            finally:
+                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
+        except:
+            pass
+
+if __name__ == "__main__":
+    main()
