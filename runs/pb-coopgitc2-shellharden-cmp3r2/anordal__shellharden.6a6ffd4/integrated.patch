+    RESET = '\033[0m'
+    BOLD = '\033[1m'
+    BLUE = '\033[0;38;2;192;0;128m'
+    CYAN = '\033[0;38;2;255;0;0m'
+    GREEN = '\033[0;38;2;63;127;207m'
+    YELLOW = '\033[0;38;2;255;140;0m'
+    MAGENTA = '\033[0;38;2;255;0;128m'
+    WHITE = '\033[0;38;2;0;127;255m'
