+            elif token_type == 'backtick':
+                result.append(Colors.BG_MAGENTA + text + Colors.RESET)
+            elif token_type == 'subshell':
+                result.append(Colors.BG_MAGENTA + text + Colors.RESET)
+            elif token_type == 'operator':
+                result.append(Colors.BG_YELLOW + text + Colors.RESET)
+            else:
+                result.append(text)
+    return ''.join(result)
+
+def transform_line(line):
+    result = []
+    i = 0
+    while i < len(line):
+        if line[i].isspace():
+            result.append(line[i])
+            i += 1
+        elif line[i] == '#':
