+                j += 1
+            var = line[i:j]
+            if var in '$?$$!#${#':
+                result.append(var)
+            else:
+                result.append('"' + var + '"')
+            i = j
+        elif line[i] == '`':
+            j = i + 1
+            while j < len(line) and line[j] != '`':
+                j += 1
+            if j < len(line):
+                j += 1
+            result.append('$(' + line[i+1:j-1] + ')')
+            i = j
+        elif line[i] == '(' and i + 1 < len(line) and line[i+1] == '$':
+            j = i + 2
+            depth = 1
+            while j < len(line) and depth > 0:
+                if line[j:j+2] == '$(':
+                    depth += 1
+                    j += 2
+                elif line[j:j+2] == ')':
+                    depth -= 1
+                    j += 2
+                else:
+                    j += 1
+            if depth == 0 and j < len(line):
+                j += 1
+            result.append(line[i:j])
+            i = j
+        elif line[i] in '=<>|&;':
+            j = i
+            while j < len(line) and line[j] in '=<>|&;':
+                j += 1
+            result.append(line[i:j])
+            i = j
+        elif line[i] in '[]{}':
+            result.append(line[i])
+            i += 1
+        elif line[i] in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_':
+            j = i
+            while j < len(line) and (line[j].isalnum() or line[j] in '_-'):
+                j += 1
+            result.append(line[i:j])
+            i = j
+        else:
+            result.append(line[i])
+            i += 1
+    return ''.join(result)
+
+def process_file(filename, mode='syntax'):
+    try:
+        with open(filename, 'r') as f:
+            lines = f.readlines()
+    except FileNotFoundError:
+        print(f'Error: File not found: {filename}', file=sys.stderr)
