+            i = end + 1
+        elif line[i] == '"' or line[i] == "'":
+            quote = line[i]
+            j = i + 1
+            while j < len(line) and line[j] != quote:
+                if line[j] == '\\' and j + 1 < len(line):
+                    j += 2
+                else:
+                    j += 1
+            if j < len(line):
+                j += 1
+            result.append(line[i:j])
+            i = j
+        elif line[i] == '$':
+            j = i + 1
