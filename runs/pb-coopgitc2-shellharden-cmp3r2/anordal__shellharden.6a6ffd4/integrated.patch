+    BG_YELLOW = '\033[0;48;2;255;140;0m'
+    BG_MAGENTA = '\033[0;48;2;255;0;128m'
+
+def tokenize(line):
+    tokens = []
+    i = 0
+    while i < len(line):
+        if line[i].isspace():
+            tokens.append(('whitespace', line[i]))
+            i += 1
+        elif line[i] == '#':
+            end = line.find('\n', i)
+            if end == -1:
+                end = len(line)
+            tokens.append(('comment', line[i:end]))
+            i = end + 1
+        elif line[i] == '"' or line[i] == "'":
+            quote = line[i]
+            j = i + 1
+            while j < len(line) and line[j] != quote:
+                if line[j] == '\\' and j + 1 < len(line):
+                    j += 2
+                else:
+                    j += 1
+            if j < len(line):
+                j += 1
+            tokens.append(('string', line[i:j]))
+            i = j
+        elif line[i] == '$':
+            j = i + 1
+            while j < len(line) and (line[j].isalnum() or line[j] in '[]{}*?_'):
+                j += 1
+            tokens.append(('variable', line[i:j]))
+            i = j
+        elif line[i] == '`':
+            j = i + 1
+            while j < len(line) and line[j] != '`':
+                j += 1
+            if j < len(line):
+                j += 1
+            tokens.append(('backtick', line[i:j]))
+            i = j
+        elif line[i] == '(' and i + 1 < len(line) and line[i+1] == '$':
+            j = i + 2
+            depth = 1
+            while j < len(line) and depth > 0:
+                if line[j:j+2] == '$(':
+                    depth += 1
+                    j += 2
+                elif line[j:j+2] == ')':
+                    depth -= 1
+                    j += 2
+                else:
+                    j += 1
+            if depth == 0 and j < len(line):
+                j += 1
+            tokens.append(('subshell', line[i:j]))
+            i = j
+        elif line[i] in '=<>|&;':
+            j = i
+            while j < len(line) and line[j] in '=<>|&;':
+                j += 1
+            tokens.append(('operator', line[i:j]))
+            i = j
+        elif line[i] in '[]{}':
+            tokens.append(('bracket', line[i]))
+            i += 1
+        elif line[i] in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_':
+            j = i
+            while j < len(line) and (line[j].isalnum() or line[j] in '_-'):
+                j += 1
+            tokens.append(('identifier', line[i:j]))
+            i = j
+        else:
+            tokens.append(('unknown', line[i]))
+            i += 1
+    return tokens
+
+def highlight_syntax(tokens, mode='syntax'):
+    result = []
+    for token_type, text in tokens:
+        if mode == 'syntax':
+            if token_type == 'whitespace':
+                result.append(text)
+            elif token_type == 'comment':
+                result.append(Colors.WHITE + text + Colors.RESET)
+            elif token_type == 'string':
+                result.append(Colors.CYAN + text + Colors.RESET)
+            elif token_type == 'variable':
+                result.append(Colors.GREEN + text + Colors.RESET)
+            elif token_type == 'backtick':
+                result.append(Colors.MAGENTA + text + Colors.RESET)
+            elif token_type == 'subshell':
+                result.append(Colors.MAGENTA + text + Colors.RESET)
+            elif token_type == 'operator':
+                result.append(Colors.YELLOW + text + Colors.RESET)
+            elif token_type == 'bracket':
+                result.append(Colors.WHITE + text + Colors.RESET)
+            elif token_type == 'identifier':
+                result.append(Colors.WHITE + text + Colors.RESET)
+            else:
+                result.append(text)
+        elif mode == 'transform':
+            result.append(text)
+        elif mode == 'suggest':
