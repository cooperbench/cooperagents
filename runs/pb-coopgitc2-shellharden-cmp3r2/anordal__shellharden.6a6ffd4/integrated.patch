+    
+    if mode == 'transform':
+        transformed_lines = [transform_line(line.rstrip('\n')) + '\n' for line in lines]
+        return ''.join(transformed_lines)
+    elif mode == 'check':
+        has_changes = False
+        for line in lines:
+            if transform_line(line.rstrip('\n')) != line.rstrip('\n'):
+                has_changes = True
+        return 2 if has_changes else 0
+    else:
+        result_lines = []
+        for line in lines:
+            if line.endswith('\n'):
+                line_content = line[:-1]
+            else:
+                line_content = line
+            tokens = tokenize(line_content)
+            highlighted = highlight_syntax(tokens, mode)
+            result_lines.append(highlighted + '\n')
+        return ''.join(result_lines)
+
