+fn main() {
+    let path = std::env::args().nth(1).unwrap();
+    let data = std::fs::read(&path).unwrap();
+    // find EOCD
+
+    // find CD start
+    // EOCD at end: 50 4b 05 06
+    let mut i = 0;
+    let n = data.len();
+    let eocd_off = loop {
+        if data[i..].starts_with(&[0x50,0x4b,0x05,0x06]) { break i; }
+        i += 1;
+        if i + 4 > n { break n; }
+    };
+    let cd_start = le_u32(&data, eocd_off + 16);
+    let cd_count = le_u16(&data, eocd_off + 10);
+    println!("EOCD at {}, CD start {}, CD count {}", eocd_off, cd_start, cd_count);
+    // parse central directory
+    let mut p = cd_start as usize;
+    while data[p..].starts_with(&[0x50,0x4b,0x01,0x02]) {
+        let ver_made = le_u16(&data, p+4);
+        let ver_need = le_u16(&data, p+6);
+        let flag = le_u16(&data, p+8);
+        let comp = le_u16(&data, p+10);
+        let crc = le_u32(&data, p+16);
+        let csize = le_u32(&data, p+20);
+        let usize_ = le_u32(&data, p+24);
+        let fnlen = le_u16(&data, p+28);
+        let exlen = le_u16(&data, p+30);
+        let cmlen = le_u16(&data, p+32);
+        let disk = le_u16(&data, p+34);
+        let iattr = le_u16(&data, p+36);
+        let eattr = le_u32(&data, p+38);
+        let lho = le_u32(&data, p+42);
+        let fnm = &data[p+46..p+46+fnlen as usize];
+        let ex = &data[p+46+fnlen as usize..p+46+fnlen as usize+exlen as usize];
+        println!("[CD] name={} flag={:#06x} comp={:#06x} crc={:#x} csize={} usize={} fnlen={} exlen={} cmlen={} lho={}", 
+            String::from_utf8_lossy(fnm), flag, comp, crc, csize, usize_, fnlen, exlen, cmlen, lho);
+        println!("   extra={:x?}", ex);
+        // parse local header
+        let lp = lho as usize;
+        let lflag = le_u16(&data, lp+6);
+        let lcomp = le_u16(&data, lp+8);
+        let lcsize = le_u32(&data, lp+18);
+        let lusize = le_u32(&data, lp+22);
+        let lfnlen = le_u16(&data, lp+26);
+        let lexlen = le_u16(&data, lp+28);
+        let data_off = lp + 30 + lfnlen as usize + lexlen as usize;
+        println!("   [LOCAL] flag={:#06x} comp={:#06x} csize={} usize={} fnlen={} exlen={} data_off={}",
+            lflag, lcomp, lcsize, lusize, lfnlen, lexlen, data_off);
+        let llex = &data[lp+30+lfnlen as usize..lp+30+lfnlen as usize+lexlen as usize];
+        println!("   local_extra={:x?}", llex);
+        let region = &data[data_off..data_off+lcsize as usize];
+        println!("   data({} bytes)={:x?}", region.len(), region);
+        p += 46 + fnlen as usize + exlen as usize + cmlen as usize;
+    }
+}
+fn le_u16(b: &[u8], o: usize) -> u16 { u16::from_le_bytes([b[o], b[o+1]]) }
+fn le_u32(b: &[u8], o: usize) -> u32 { u32::from_le_bytes([b[o],b[o+1],b[o+2],b[o+3]]) }
