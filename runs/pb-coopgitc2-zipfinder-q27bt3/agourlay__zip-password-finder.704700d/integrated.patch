+// Verify AES-128 (WinZip) and ZipCrypto against known test archives.
+// Usage: verify <file> <password>
+use std::fs;
+
+// ===== SHA-1 =====
+fn sha1(data: &[u8]) -> [u8; 20] {
+    let mut h = [0x67452301u32, 0xEFCDAB89u32, 0x98BADCFEu32, 0x10325476u32, 0x4E56C7A3u32];
+    let mut padded = Vec::with_capacity(data.len() + 72);
+    padded.extend_from_slice(data);
+    padded.push(0x80);
+    while padded.len() % 64 != 56 { padded.push(0); }
+    let bitlen = (data.len() as u64) * 8;
+    padded.extend_from_slice(&bitlen.to_be_bytes());
+    for chunk in padded.chunks(64) {
+        let mut w = [0u32; 64];
+        for i in 0..16 {
+            w[i] = u32::from_be_bytes([chunk[4*i], chunk[4*i+1], chunk[4*i+2], chunk[4*i+3]]);
+        }
+        for i in 16..64 {
+            w[i] = (w[i-3].wrapping_add(w[i-8]).wrapping_add(w[i-14]).wrapping_add(w[i-16])).rotate_left(1);
+        }
+        let (mut a, mut b, mut c, mut d, mut e) = (h[0], h[1], h[2], h[3], h[4]);
+        for i in 0..64 {
+            let (f, k) = if i < 20 { ((b & c) | ((b ^ 0xFFFFFFFF) & d), 0x5a827993u32) }
+                else if i < 40 { (b ^ c ^ d, 0x6ed9eba1u32) }
+                else if i < 60 { ((b & c) | (b & d) | (c & d), 0x7a39d29eu32) }
+                else { (b ^ c ^ d, 0xf429284cu32) };
+            let t = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[i]);
+            e = d; d = c; c = b; b = a; a = t;
+        }
+        h[0] = h[0].wrapping_add(a); h[1] = h[1].wrapping_add(b);
+        h[2] = h[2].wrapping_add(c); h[3] = h[3].wrapping_add(d); h[4] = h[4].wrapping_add(e);
+    }
+    let mut out = [0u8; 20];
+    for i in 0..5 { out[4*i..4*i+4].copy_from_slice(&h[i].to_be_bytes()); }
+    out
+}
+
+fn test_sha1() {
+    let h = sha1(b"abc");
+    let s = "a9993e364706816aba3e25717850c26c9cd0d89d";
+    let mut exp = [0u8; 20];
+    for i in 0..20 { exp[i] = u8::from_str_radix(&s[i*2..i*2+2], 16).unwrap(); }
+    println!("SHA-1(\"abc\") = {:02x?} match={}", h, h==exp);
+    let h2 = sha1(b"");
+    let s2 = "da39a3ee5e6b4b0d3255bfef95601890afd80709";
+    let mut exp2 = [0u8; 20];
+    for i in 0..20 { exp2[i] = u8::from_str_radix(&s2[i*2..i*2+2], 16).unwrap(); }
+    println!("SHA-1(\"\")   = {:02x?} match={}", h2, h2==exp2);
+}
+
+// ===== HMAC-SHA-1 =====
+fn hmac(key: &[u8], data: &[u8]) -> [u8; 20] {
+    let block: usize = 64;
+    let mut k = if key.len() > block {
+        let h = sha1(key);
+        let mut v = vec![0u8; block]; v[..20].copy_from_slice(&h); v
+    } else {
+        let mut v = vec![0u8; block]; v[..key.len()].copy_from_slice(key); v
+    };
+    for i in 0..block { k[i] ^= 0x36; }
+    let mut inner = Vec::with_capacity(block + data.len());
+    inner.extend_from_slice(&k); inner.extend_from_slice(data);
+    let ih = sha1(&inner);
+    for i in 0..block { k[i] ^= 0x36 ^ 0x5c; }
+    let mut outer = Vec::with_capacity(block + 20);
+    outer.extend_from_slice(&k); outer.extend_from_slice(&ih);
+    sha1(&outer)
+}
+
+// ===== PBKDF2-HMAC-SHA-1 =====
+fn pbkdf2(password: &[u8], salt: &[u8], iters: u32, keylen: usize) -> Vec<u8> {
+    let mut out = Vec::with_capacity(keylen);
+    let mut block = 1u32;
+    while out.len() < keylen {
+        let mut buf = Vec::with_capacity(salt.len() + 4);
+        buf.extend_from_slice(salt);
+        buf.extend_from_slice(&block.to_be_bytes());
+        let mut u = hmac(password, &buf);
+        let mut t = u;
+        for _ in 1..iters {
+            let u2 = hmac(password, &u);
+            for i in 0..20 { t[i] ^= u2[i]; }
+            u = t;
+        }
+        for i in 0..20 {
+            if out.len() < keylen { out.push(t[i]); } else { break; }
+        }
+        block += 1;
+    }
+    out
+}
