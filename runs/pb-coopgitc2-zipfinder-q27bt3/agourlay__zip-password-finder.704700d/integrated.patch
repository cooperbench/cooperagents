+fn xtime(a: u8) -> u8 {
+    if a & 0x80 != 0 { (a << 1) ^ 0x1b } else { a << 1 }
+}
+fn gmul(a: u8, b: u8) -> u8 {
+    let mut p = 0u8; let mut x = a; let mut y = b;
+    while y != 0 {
+        if y & 1 != 0 { p ^= x; }
+        y >>= 1;
+        if x & 0x80 != 0 { x = (x << 1) ^ 0x1b; } else { x <<= 1; }
+        x &= 0xff;
+    }
+    p
+}
+
+fn expand_key(key: &[u8; 16]) -> [[u8; 16]; 10] {
+    let mut rk = [[0u8; 16]; 10];
+    rk[0].copy_from_slice(key);
+    let mut rcon = 1u8;
+    for i in 1..10 {
+        let last = &rk[i-1][12..16];
+        let mut t = [last[1], last[2], last[3], last[0]];
+        let mut s = [0u8; 4];
+        for x in t.iter_mut() { *x = SB[*x as usize]; }
+        s[0] ^= rcon;
+        rcon = xtime(rcon);
+        for j in 0..4 {
+            let base = [
+                rk[i-1][j], rk[i-1][j+4], rk[i-1][j+8], rk[i-1][j+12],
+            ];
+            rk[i][j]     = base[0] ^ s[j];
+            rk[i][j+4]   = base[1] ^ s[j];
+            rk[i][j+8]   = base[2] ^ s[j];
+            rk[i][j+12]  = base[3] ^ s[j];
+        }
+    }
+    rk
+}
+
+fn aes_encrypt_block(rk: &[[u8; 16]; 10], in_block: &[u8; 16]) -> [u8; 16] {
+    let mut s = *in_block;
+    for i in 0..16 { s[i] ^= rk[0][i]; }
+    for round in 1..9 {
+        // SubBytes
+        for i in 0..16 { s[i] = SB[s[i] as usize]; }
+        // ShiftRows
+        let mut t = [0u8; 16];
+        for i in 0..4 {
+            t[i]    = s[i];
+            t[i+4]  = s[i+4];
+            t[i+8]  = s[i+8];
+            t[i+12] = s[i+12];
+        }
+        // ShiftRows: row r, position p -> s[r*4 + (p+r) mod 4]
+        let mut t2 = [0u8; 16];
+        for r in 0..4 {
+            for p in 0..4 {
+                t2[r*4 + p] = t[r*4 + ((p + r) % 4)];
+            }
+        }
+        s = t2;
+        // MixColumns
+        for i in 0..4 {
+            let b = [s[4*i], s[4*i+1], s[4*i+2], s[4*i+3]];
+            s[4*i]   = gmul(b[0],2) ^ gmul(b[1],3) ^ b[2] ^ b[3];
+            s[4*i+1] = b[0] ^ gmul(b[1],2) ^ gmul(b[2],3) ^ b[3];
+            s[4*i+2] = b[0] ^ b[1] ^ gmul(b[2],2) ^ gmul(b[3],3);
+            s[4*i+3] = gmul(b[0],3) ^ b[1] ^ b[2] ^ gmul(b[3],2);
+        }
+        // AddRoundKey
+        for i in 0..16 { s[i] ^= rk[round][i]; }
+    }
+    // Final round (no MixColumns)
+    for i in 0..16 { s[i] = SB[s[i] as usize]; }
+    let mut t2 = [0u8; 16];
+    for r in 0..4 {
+        for p in 0..4 {
+            t2[r*4 + p] = s[r*4 + ((p + r) % 4)];
+        }
+    }
+    s = t2;
+    for i in 0..16 { s[i] ^= rk[9][i]; }
+    s
+}
+
+fn aes_cbc_decrypt(key: &[u8; 16], ct: &[u8], iv: &[u8; 16]) -> Vec<u8> {
+    let rk = expand_key(key);
+    let mut out = Vec::with_capacity(ct.len());
+    let mut prev_iv = *iv;
+    for block in ct.chunks(16) {
+        let mut b = [0u8; 16];
+        b.copy_from_slice(block);
+        let dec = aes_encrypt_block(&rk, &b); // AES is symmetric for block
+        for i in 0..16 { out.push(dec[i] ^ prev_iv[i]); }
+        prev_iv = b;
+    }
+    out
+}
+
+// ===== WinZip AES test =====
+fn test_aes() {
+    // AES-128 FIPS-197 test vector: key=000102..0f, pt=00112233...
+    let key = [
+        0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0a,0x0b,0x0c,0x0d,0x0e,0x0f,
+    ];
+    let pt = [
+        0x00,0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0xaa,0xbb,0xcc,0xdd,0xee,0xff,
+    ];
+    let ct = aes_encrypt_block(&expand_key(&key), &pt);
+    let s = "69c4e0d86a7b0430d8cdb78070db1c96";
+    let mut exp = [0u8; 16];
+    for i in 0..16 { exp[i] = u8::from_str_radix(&s[i*2..i*2+2], 16).unwrap(); }
+    println!("AES-128 FIPS block = {:02x?} match={}", ct, ct==exp);
+}
+
+fn main() {
+    test_sha1();
+    test_aes();
+    // PBKDF2 known test vector:
+    // password="password", salt="salt", c=1, dkLen=20
+    // = 4c0c0222a9421d1613d217965c8135c9e0d1c3a5
+    let k = pbkdf2(b"password", b"salt", 1, 20);
+    let s = "4c0c0222a9421d1613d217965c8135c9e0d1c3a5";
+    let mut exp = [0u8; 20];
+    for i in 0..20 { exp[i] = u8::from_str_radix(&s[i*2..i*2+2], 16).unwrap(); }
+    let mut kb = [0u8; 20]; kb.copy_from_slice(&k);
+    println!("PBKDF2(c=1) = {:02x?} match={}", kb, kb==exp);
+    // c=2
+    let k2 = pbkdf2(b"password", b"salt", 2, 20);
+    let s2 = "0591c96157f81992f71a954d16d51f3c88159647";
+    let mut exp2 = [0u8; 20];
+    for i in 0..20 { exp2[i] = u8::from_str_radix(&s2[i*2..i*2+2], 16).unwrap(); }
+    let mut kb2 = [0u8; 20]; kb2.copy_from_slice(&k2);
+    println!("PBKDF2(c=2) = {:02x?} match={}", kb2, kb2==exp2);
+    // HMAC-SHA1 test: key="key", data="The quick brown fox jumps over the lazy dog"
+    // = 4b72d090091d38f7f8c1332d06b75513e5a0d8a6
+    let h = hmac(b"key", b"The quick brown fox jumps over the lazy dog");
+    let s3 = "4b72d090091d38f7f8c1332d06b75513e5a0d8a6";
+    let mut exp3 = [0u8; 20];
+    for i in 0..20 { exp3[i] = u8::from_str_radix(&s3[i*2..i*2+2], 16).unwrap(); }
+    println!("HMAC-SHA1   = {:02x?} match={}", h, h==exp3);
+}
