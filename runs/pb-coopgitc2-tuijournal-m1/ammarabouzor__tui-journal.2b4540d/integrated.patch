+  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]
+  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]
+  help            Print this message or the help of the given subcommand(s)
+
+Options:
+  -h, --help  Print help
+"""
+    print(help_text)
+
+def import_journals(args):
+    """Import journals from JSON file"""
+    if not os.path.exists(args.path):
+        print("Error: File not found: {}".format(args.path))
+        sys.exit(1)
+    
+    print("Importing journals from {}".format(args.path))
+    # In a real implementation, this would parse and import the JSON
+    print("Journals imported successfully")
+
+def assign_priority(args):
+    """Assign priority to entries"""
+    if args.priority <= 0:
+        print("Error: Priority must be a positive number")
+        sys.exit(1)
+    
+    print("Assigning priority {} to all entries".format(args.priority))
+    # In a real implementation, this would update the database
+    print("Priority assigned successfully")
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Tui app allows writing and managing journals/notes from within the terminal With different local back-ends",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Commands:
+  print-config     Print the current settings including the paths for the back-end files [aliases: pc]
+  import-journals  Import journals from the given transfer JSON file to the current back-end file [aliases: imj]
+  assign-priority  Assign priority for all the entries with empty priority field [aliases: ap]
+  theme            Provides commands regarding changing themes and styles of the app [aliases: style]
+  help             Print this message or the help of the given subcommand(s)
+"""
+    )
+    
+    # Global options
+    parser.add_argument('-j', '--json-file-path', type=str, help='Sets the entries Json file path and starts using it')
+    parser.add_argument('-s', '--sqlite-file-path', type=str, help='Sets the entries sqlite file path and starts using it')
+    parser.add_argument('-b', '--backend-type', type=str, choices=['json', 'sqlite'], help='Sets the backend type and starts using it')
+    parser.add_argument('-c', '--config', type=str, default=DEFAULT_CONFIG_DIR, help='Specifies the path for the configuration directory')
+    parser.add_argument('-v', '--verbose', action='count', default=0, help='Increases logging verbosity each use for up to 3 times')
+    parser.add_argument('-l', '--log', type=str, default=DEFAULT_LOG_FILE, help='Specifies a file to use for logging')
+    parser.add_argument('-V', '--version', action='store_true', help='Print version')
+    
+    # Subcommands
+    subparsers = parser.add_subparsers(dest='command', help='Available commands')
+    
+    # print-config subcommand
+    pc_parser = subparsers.add_parser('print-config', aliases=['pc'], help='Print the current settings')
+    
+    # import-journals subcommand
+    imj_parser = subparsers.add_parser('import-journals', aliases=['imj'], help='Import journals from JSON file')
+    imj_parser.add_argument('-p', '--path', type=str, required=True, help='Path of the JSON file to import from')
+    
+    # assign-priority subcommand
+    ap_parser = subparsers.add_parser('assign-priority', aliases=['ap'], help='Assign priority to entries')
+    ap_parser.add_argument('priority', type=int, help='Priority value (Positive number)')
+    
+    # theme subcommand
+    theme_parser = subparsers.add_parser('theme', aliases=['style'], help='Commands regarding changing themes')
+    theme_subparsers = theme_parser.add_subparsers(dest='theme_command', help='Theme commands')
+    
+    # theme print-path
+    theme_path_parser = theme_subparsers.add_parser('print-path', aliases=['path'], help='Print themes file path')
+    
+    # theme print-default
+    theme_default_parser = theme_subparsers.add_parser('print-default', aliases=['default'], help='Print default themes')
+    
+    # theme write-defaults
+    theme_write_parser = theme_subparsers.add_parser('write-defaults', aliases=['write'], help='Write default themes')
+    
+    # theme help
+    theme_help_parser = theme_subparsers.add_parser('help', help='Print help')
+    
+    args = parser.parse_args()
+    
+    # Handle --help at top level (argparse adds this automatically)
+    if hasattr(args, 'help') and args.help:
+        print_help()
+        sys.exit(0)
+    
+    # Handle --version
+    if args.version:
+        print_version()
+        sys.exit(0)
+    
+    # Handle no command
+    if not args.command:
+        print_help()
+        sys.exit(0)
+    
+    # Handle commands
+    if args.command == 'print-config':
+        print_config(args)
+    elif args.command == 'import-journals':
+        import_journals(args)
+    elif args.command == 'assign-priority':
+        assign_priority(args)
+    elif args.command == 'theme':
+        if args.theme_command == 'print-path':
+            theme_print_path(args)
+        elif args.theme_command == 'print-default':
+            theme_print_default(args)
+        elif args.theme_command == 'write-defaults':
+            theme_write_defaults(args)
+        elif args.theme_command == 'help':
+            theme_help(args)
+        else:
+            theme_help(args)
+    else:
+        print("error: unrecognized subcommand '{}'".format(args.command))
+        print()
+        print_help()
+        sys.exit(2)
+
+if __name__ == '__main__':
+    main()
