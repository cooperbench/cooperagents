+use clap::{Parser, Subcommand, ValueEnum};
+
+#[derive(Parser, Debug)]
+#[command(name = "executable")]
+#[command(author = "Tui-Journal Team")]
+#[command(version = "0.16.1")]
+#[command(about = "Tui app allows writing and managing journals/notes from within the terminal With different local back-ends", long_about = None)]
+struct Cli {
+    #[arg(short = 'j', long = "json-file-path")]
+    json_file_path: Option<String>,
+    #[arg(short = 's', long = "sqlite-file-path")]
+    sqlite_file_path: Option<String>,
+    #[arg(short = 'b', long = "backend-type", value_enum)]
+    backend_type: Option<BackendType>,
+    #[arg(short = 'c', long = "config", default_value = "/home/agent/.config/tui-journal")]
+    config: String,
+    #[arg(short = 'v', long = "verbose", action = clap::ArgAction::Count)]
+    verbose: u8,
+    #[arg(short = 'l', long = "log", default_value = "/home/agent/.cache/tui-journal/tui-journal.log")]
+    log: String,
+    #[command(subcommand)]
+    command: Option<Commands>,
+}
+
+#[derive(Subcommand, Debug)]
+enum Commands {
+    #[command(alias = "pc")]
+    PrintConfig,
+    #[command(alias = "imj")]
+    ImportJournals {
+        #[arg(short = 'p', long = "path")]
+        path: String,
+    },
+    #[command(alias = "ap")]
+    AssignPriority {
+        priority: String,
+    },
+    #[command(alias = "style")]
+    Theme(ThemeCommand),
+    #[command(alias = "h")]
+    Help,
+}
+
+#[derive(Subcommand, Debug)]
+enum ThemeCommand {
+    #[command(alias = "path")]
+    PrintPath,
+    #[command(alias = "default")]
+    PrintDefault,
+    #[command(alias = "write")]
+    WriteDefaults,
+    #[command(alias = "h")]
+    Help,
+}
+
+#[derive(ValueEnum, Clone, Debug)]
+enum BackendType {
+    Json,
+    Sqlite,
+}
+
+fn main() {
+    let cli = Cli::parse();
+    match cli.command {
+        Some(Commands::PrintConfig) => print_config(&cli),
+        Some(Commands::ImportJournals { path }) => println!("Importing journals from: {}", path),
+        Some(Commands::AssignPriority { priority }) => println!("Assigning priority: {}", priority),
+        Some(Commands::Theme(theme_cmd)) => match theme_cmd {
+            ThemeCommand::PrintPath => println!("/home/agent/.config/tui-journal/themes.toml"),
+            ThemeCommand::PrintDefault => print_default_themes(),
+            ThemeCommand::WriteDefaults => write_default_themes(&cli),
+            ThemeCommand::Help => {
+                println!("Provides commands regarding changing themes and styles of the app");
+                println!();
+                println!("Usage: executable theme <COMMAND>");
+                println!();
+                println!("Commands:");
+                println!("  print-path      Prints the path to the user themes file [aliases: path]");
+                println!("  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]");
+                println!("  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]");
+                println!("  help            Print this message or the help of the given subcommand(s)");
+                println!();
+                println!("Options:");
+                println!("  -h, --help  Print help");
+            }
+        },
+        Some(Commands::Help) | None => print_help(&cli),
+    }
+}
+
+fn print_config(cli: &Cli) {
+    let bt = cli.backend_type.unwrap_or(BackendType::Sqlite);
+    let mut out = String::new();
+    out.push_str(&format!("backend_type = \"{}\"\n", match bt { BackendType::Json => "Json", BackendType::Sqlite => "Sqlite" }));
+    out.push_str("scroll_per_page = 5\n");
+    out.push_str("sync_os_clipboard = false\n");
+    out.push_str("history_limit = 10\n");
+    out.push_str("colored_tags = true\n");
+    out.push_str("datum_visibility = \"show\"\n");
+    out.push_str("app_state_dir = \"/home/agent/.local/state/tui-journal\"\n\n");
+    out.push_str("[export]\n");
+    out.push_str("show_confirmation = true\n\n");
+    out.push_str("[external_editor]\n");
+    out.push_str("auto_save = false\n");
+    out.push_str("temp_file_extension = \"txt\"\n\n");
+    out.push_str("[json_backend]\n");
+    out.push_str("file_path = \"/home/agent/tui-journal/entries.json\"\n\n");
+    out.push_str("[sqlite_backend]\n");
+    out.push_str("file_path = \"/home/agent/tui-journal/entries.db\"\n");
+    println!("{}", out);
+}
+
