+
+def theme_print_default(args):
+    """Print default themes"""
+    print(DEFAULT_THEMES)
+
+def theme_write_defaults(args):
+    """Write default themes to file"""
+    config_dir = args.config
+    themes_file = os.path.join(config_dir, "themes.toml")
+    
