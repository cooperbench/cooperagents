+def load_charset_from_file(filepath: str) -> str:
+    """Load charset from file"""
+    try:
+        with open(filepath, 'r') as f:
+            return f.read().strip()
+    except Exception as e:
+        print(f"Error loading charset file: {e}", file=sys.stderr)
+        return ""
+
+def get_encrypted_files(zip_path: str) -> List[str]:
+    """Get list of encrypted files in the ZIP archive"""
+    encrypted_files = []
+    try:
+        with zipfile.ZipFile(zip_path, 'r') as zf:
+            for info in zf.infolist():
+                if info.flag_bits & 0x1:
+                    encrypted_files.append(info.filename)
+    except Exception as e:
+        print(f"Error reading ZIP file: {e}", file=sys.stderr)
+    return encrypted_files
+
+def test_password(zip_path: str, password: bytes, file_number: int) -> bool:
+    """Test if password works for the specified file"""
+    try:
+        with zipfile.ZipFile(zip_path, 'r') as zf:
+            # Try to open the file with the password
+            if file_number >= 0:
+                # Get the specific file
+                info = zf.infolist()[file_number]
+                try:
+                    zf.extract(info, path=None, pwd=password)
+                    return True
+                except:
+                    return False
+            else:
+                # Try all encrypted files
+                for info in zf.infolist():
+                    if info.flag_bits & 0x1:
+                        try:
+                            zf.extract(info, path=None, pwd=password)
+                            return True
+                        except:
+                            continue
+        return False
+    except Exception as e:
+        return False
+
+def generate_passwords(charset: str, min_len: int, max_len: int, start_password: Optional[str] = None) -> List[str]:
+    """Generate passwords based on charset and length range"""
+    if not charset:
+        return []
+    
+    chars = list(charset)
+    if not chars:
+        return []
+    
+    passwords = []
+    if start_password:
+        # Start from start_password and generate variations
+        passwords = [start_password]
+        # Generate passwords of increasing length
+        for length in range(len(start_password), max_len + 1):
+            for i in range(len(charset)):
+                new_pass = start_password[:i] + chars[i % len(chars)] + start_password[i:]
+                if len(new_pass) <= max_len:
+                    passwords.append(new_pass)
+    else:
+        # Generate all passwords from min_len to max_len
+        for length in range(min_len, max_len + 1):
+            for i in range(len(chars) ** length):
+                password = []
+                temp = i
+                for _ in range(length):
+                    password.insert(0, chars[temp % len(chars)])
+                    temp //= len(chars)
+                passwords.append(''.join(password))
+    
+    return passwords
+
+def worker(args, passwords: List[str], results: dict, lock: threading.Lock):
+    """Worker function to test passwords"""
+    for password in passwords:
+        if test_password(args.inputFile, password.encode(), args.fileNumber):
+            with lock:
+                results['found'] = password
+                results['elapsed'] = time.time() - args.start_time
+            return
+
