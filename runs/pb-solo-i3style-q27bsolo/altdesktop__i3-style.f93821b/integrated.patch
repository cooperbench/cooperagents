+// i3-style 1.0 — reconstructed implementation.
+// Manual CLI (no derive), theme data in `themes` module.
+
+mod themes;
+use themes::{ColorSet, THEMES};
+
+use anyhow::{anyhow, Context, Result};
+use std::env;
+use std::fs;
+use std::path::PathBuf;
+use std::process::Command;
+
+const VERSION: &str = "i3-style 1.0";
+
+const HELP: &str = "i3-style 1.0
+Make your i3 config a bit more stylish
+
+USAGE:
+    executable [FLAGS] [OPTIONS] [theme]
+
+FLAGS:
+    -h, --help        Prints help information
+    -l, --list-all    Print a list of all available themes
+    -r, --reload      Apply the theme by reloading the config
+    -s, --save        Set the output file to the path of the input file
+    -V, --version     Prints version information
+
+OPTIONS:
+    -c, --config <file>      The config file the theme should be applied to. Defaults to the default i3 location.
+    -o, --output <file>      Apply the theme, attempt to validate the result, and write it to <file>
+    -t, --to-theme <file>    Prints an i3-style theme based on the given config suitable for sharing with others
+                             [default: ]
+
+ARGS:
+    <theme>    The theme to use
+";
+
+fn list_all() -> String {
+    let mut s = String::from("Available themes:\n\n");
+    for t in THEMES {
+        // name padded to width 18, then " - ", then description
+        s.push_str(&format!("  {:<18} - {}\n", t.name, t.description));
+    }
+    s
+}
+
+struct Args {
+    theme: Option<String>,
+    config: Option<String>,
+    output: Option<String>,
+    to_theme: Option<String>,
+    reload: bool,
+    save: bool,
+    list_all: bool,
+    help: bool,
+    version: bool,
+}
+
+fn parse_args() -> Args {
+    let mut a = Args {
+        theme: None,
+        config: None,
+        output: None,
+        to_theme: None,
+        reload: false,
+        save: false,
+        list_all: false,
+        help: false,
+        version: false,
+    };
+    let args: Vec<String> = env::args().collect();
+    let mut pos = 1; // skip program name
+    while pos < args.len() {
+        let arg = &args[pos];
+        match arg.as_str() {
+            "-h" | "--help" => a.help = true,
+            "-l" | "--list-all" => a.list_all = true,
+            "-r" | "--reload" => a.reload = true,
+            "-s" | "--save" => a.save = true,
+            "-V" | "--version" => a.version = true,
+            "-c" | "--config" => {
+                pos += 1;
+                a.config = Some(args.get(pos).cloned().unwrap_or_default());
+            }
+            "-o" | "--output" => {
+                pos += 1;
+                a.output = Some(args.get(pos).cloned().unwrap_or_default());
+            }
+            "-t" | "--to-theme" => {
+                pos += 1;
+                a.to_theme = Some(args.get(pos).cloned().unwrap_or_default());
+            }
+            other => {
+                if !other.starts_with('-') {
+                    a.theme = Some(other.to_string());
+                }
+            }
+        }
+        pos += 1;
+    }
+    a
+}
+
+fn find_theme(name: &str) -> Result<&'static ColorSet> {
+    THEMES
+        .iter()
+        .find(|t| t.name == name)
+        .ok_or_else(|| anyhow!("Could not open theme: {}", name))
+}
+
+fn default_config_path() -> PathBuf {
+    let home = env::var("HOME").unwrap_or_else(|_| "/root".to_string());
+    let mut p = PathBuf::from(home);
+    p.push(".config");
+    p.push("i3");
+    p.push("config");
+    p
+}
+
+fn main() {
+    let a = parse_args();
+
+    if a.help {
+        print!("{}", HELP);
+        return;
+    }
+    if a.version {
+        println!("{}", VERSION);
+        return;
+    }
+    if a.list_all {
+        print!("{}", list_all());
+        return;
+    }
+
+    let res = match a.to_theme {
+        Some(ref f) => run_to_theme(f, a.config.as_deref()),
+        None => run_apply(&a),
+    };
+    if let Err(e) = res {
+        eprintln!("{}", e);
+        std::process::exit(1);
+    }
+}
+
+// ---- apply logic -----------------------------------------------------------
+
+/// Parse a single "key value..." color line into (key, [values]).
+fn parse_color_line(line: &str) -> Option<(String, Vec<String>)> {
+    let t = line.trim();
+    if t.is_empty() {
+        return None;
+    }
+    let parts: Vec<String> = t.splitn(2, ' ').collect();
+    let key = parts[0].trim();
+    let vals = if parts.len() > 1 {
+        parts[1].split_whitespace().map(|s| s.to_string()).collect()
+    } else {
+        Vec::new()
+    };
+    Some((key.to_string(), vals))
+}
+
+fn indent_of(line: &str) -> usize {
+    let n = line.chars().take_while(|c| *c == ' ').count();
+    n
+}
+
+/// Find the [start, end) index range of the bar block and the colors sub-block
+/// inside it, plus the indices of the existing color lines. Returns None if no
+/// bar block exists.
+struct Regions {
+    bar_end: usize,         // index of the closing '}' of the bar block
+    colors_start: Option<usize>, // index of the 'colors {' line
+    colors_end: Option<usize>,   // index of the closing '}' of the colors sub-block
+    color_line_idx: Vec<usize>,  // indices of existing color lines
+}
+
+fn find_regions(lines: &[String]) -> Option<Regions> {
+    // Track running brace depth. The first line whose trimmed content begins
+    // with "bar" and contains '{' opens the bar block; its depth at that
+    // point is the baseline.
+    let mut depth = 0i32;
+    let mut bar_open = None;
+    let mut bar_baseline = 0i32;
+    let mut colors_open = None;
+    let mut colors_baseline = 0i32;
+    let mut in_colors = false;
+    let mut color_line_idx = Vec::new();
+
+    for (i, line) in lines.iter().enumerate() {
+        let t = line.trim();
+        let bar_open_line = bar_open.is_none()
+            && (t.starts_with("bar {") || t.starts_with("bar{") || t == "bar");
+        if bar_open_line {
+            bar_open = Some(i);
+            bar_baseline = depth;
+        }
+        // count braces (ignore '#...' comments)
+        let code = match line.find('#') {
+            Some(p) => &line[..p],
+            None => line,
+        };
+        let opens = code.matches('{').count() as i32;
+        let closes = code.matches('}').count() as i32;
+
+        if bar_open.is_some() && colors_open.is_none() && !in_colors {
+            let colors_open_line =
+                (t.starts_with("colors {") || t.starts_with("colors{") || t == "colors");
+            if colors_open_line {
+                colors_open = Some(i);
+                colors_baseline = depth;
+                in_colors = true;
+            }
+        }
+
+        depth += opens - closes;
+
+        if in_colors {
+            // A color line is a non-empty, non-brace line inside the colors
+            // sub-block.
+            let is_brace = t.is_empty() || t == "}" || t == "colors {" || t == "colors{";
+            if !is_brace && !t.starts_with('#') {
+                color_line_idx.push(i);
+            }
+        }
+
+        // close bar / colors when depth returns to baseline
+        if bar_open.is_some() && !in_colors {
+            // (handled below)
+        }
+
+        // colors close
+        if in_colors && colors_open.is_some() && depth <= colors_baseline {
+            in_colors = false;
+        }
+
+        // bar close
+        if bar_open.is_some() && !in_colors && depth <= bar_baseline && i > bar_open.unwrap() {
+            // bar block closed
+            bar_open = None; // only take the first
+            // stop searching for colors (bar is done)
+            break;
+        }
+    }
+
+    let bar_end = lines
+        .iter()
+        .enumerate()
+        .find(|(i, l)| {
+            !l.trim().is_empty() && l.trim() == "}" && *i > bar_open.unwrap_or(0)
+        })
+        .map(|(i, _)| i)
+        .unwrap_or_else(|| lines.len() - 1);
+
+    Some(Regions {
+        bar_end,
+        colors_start: colors_open,
+        colors_end: None,
+        color_line_idx,
+    })
+}
+
+fn apply_theme(text: &str, theme: &ColorSet) -> Result<String> {
+    // split into lines, preserving original line endings roughly
+    let had_final_nl = text.ends_with('\n');
+    let raw: Vec<&str> = text.lines().collect();
+    let mut lines: Vec<String> = raw.iter().map(|s| s.to_string()).collect();
+
+    // 1. locate bar block / colors sub-block
+    let regions = find_regions(&lines);
+
+    // Determine the indent to use for newly emitted color lines: the indent of
+    // the first existing color line, else the colors sub-block indent + 2, else 4.
+    let color_indent = match &regions {
+        Some(r) => {
+            if let Some(&first) = r.color_line_idx.first() {
+                indent_of(&lines[first])
+            } else if let Some(c) = r.colors_start {
+                indent_of(&lines[c]) + 2
+            } else {
+                4
+            }
+        }
+        None => 4,
+    };
+
+    // Build the set of theme bar colors (key -> values) in BAR_ORDER as given.
+    let theme_bar: Vec<(&str, &Vec<String>)> = theme
+        .bar
+        .iter()
+        .map(|(k, v)| (k as &str, v as &Vec<String>))
+        .collect();
+
+    // 2. modify the colors sub-block
+    if let Some(r) = &regions {
+        if let Some(colors_start) = r.colors_start {
+            // Map existing color lines: which keys are present (in input order).
+            // We rebuild the color lines: keep existing keys (updated), then
+            // append missing keys in theme (BAR) order.
+            //
+            // Determine the lines that are "color lines" (between colors_start
+            // and the colors closing brace). We recompute the colors block end.
+            // Find colors block end (closing '}' at depth == colors_baseline).
+            let mut depth = 0i32;
+            let mut colors_baseline = 0i32;
+            let mut colors_end = None;
+            for (i, line) in lines.iter().enumerate() {
+                let code = match line.find('#') {
+                    Some(p) => &line[..p],
+                    None => line,
+                };
+                let opens = code.matches('{').count() as i32;
+                let closes = code.matches('}').count() as i32;
+                let t = line.trim();
+                if i == colors_start {
+                    colors_baseline = depth + opens;
+                }
+                depth += opens - closes;
+                if i > colors_start && depth <= colors_baseline && t == "}" {
+                    colors_end = Some(i);
+                    break;
+                }
+            }
+            let colors_end = colors_end.unwrap_or(lines.len());
+
+            // Collect existing color keys (in input order) and their line idxs.
+            let mut existing: Vec<(usize, String, Vec<String>)> = Vec::new();
+            for &idx in &r.color_line_idx {
+                if let Some((key, vals)) = parse_color_line(&lines[idx]) {
+                    existing.push((idx, key, vals));
+                }
+            }
+
+            // Build the new color lines: existing (updated) + missing (in order).
+            let mut seen = std::collections::HashSet::new();
+            let mut new_color_lines: Vec<String> = Vec::new();
+            // existing first (in input order)
+            for (_idx, key, _vals) in &existing {
+                seen.insert(key.clone());
+                if let Some(v) = theme_bar.iter().find(|(k, _)| *k == key) {
+                    new_color_lines.push(format!("{}{} {} {}",
+                        " ".repeat(color_indent), key,
+                        v.1.join(" "), ""));
+                } else {
+                    // keep existing values if theme lacks the key
+                    new_color_lines.push(format!("{}{} {}",
+                        " ".repeat(color_indent), key,
+                        _vals.join(" ")));
+                }
+            }
+            // missing in theme order
+            for (k, v) in &theme_bar {
+                if !seen.contains(*k) {
+                    new_color_lines.push(format!("{}{} {}",
+                        " ".repeat(color_indent), k,
+                        v.join(" ")));
+                }
+            }
+
+            // Replace the color lines region (between colors_start+? and colors_end)
+            // The color lines live between colors_start and colors_end.
+            // Remove the existing color lines and the existing color_line_idx.
+            // We replace everything between colors_start and colors_end (exclusive
+            // of the closing brace) with the new color lines, preserving any
+            // non-color lines (there shouldn't be any inside colors, but be safe).
+            //
+            // Build the new lines for the colors body.
+            let mut body: Vec<String> = Vec::new();
+            for idx in (colors_start + 1)..colors_end {
+                let line = &lines[idx];
+                let t = line.trim();
+                if t.starts_with('#') || t.is_empty() {
+                    body.push(line.clone());
+                } else {
+                    // it's an old color line; drop it (we regenerate)
+                }
+            }
+            // append new color lines (only if there are any theme colors)
+            if !new_color_lines.is_empty() {
+                body.extend(new_color_lines);
+            }
+            // splice
+            lines.splice((colors_start + 1)..colors_end, body.into_iter());
+        }
+    }
+
+    // 3. client lines (window)
+    // Map theme window colors: key -> values.
+    let theme_win: Vec<(&str, &Vec<String>)> = theme
+        .window
+        .iter()
+        .map(|(k, v)| (k as &str, v as &Vec<String>))
+        .collect();
+
+    // Existing client lines: "client.<type> ..."
+    let mut present_client = std::collections::HashSet::new();
+    for line in lines.iter_mut() {
+        let t = line.trim();
+        if let Some(rest) = t.strip_prefix("client.") {
+            let key = rest.split_whitespace().next().unwrap_or("").to_string();
+            present_client.insert(key.clone());
+            // update in place from theme
+            if let Some(v) = theme_win.iter().find(|(k, _)| *k == key) {
+                let new = format!("client.{} {}", key, v.1.join(" "));
+                // preserve leading indentation
+                let indent = " ".repeat(indent_of(line));
+                *line = format!("{}{}", indent, new);
+            }
+        }
+    }
+
+    // Append missing client lines at EOF (in theme window order).
+    let mut appended = Vec::new();
+    for (k, v) in &theme_win {
+        if !present_client.contains(*k) {
+            appended.push(format!("client.{} {}", k, v.join(" ")));
+        }
+    }
+    if !appended.is_empty() {
+        // if the last line isn't empty, add a blank line? Reference puts client
+        // lines right after content; from e3, no blank line before them.
+        lines.extend(appended);
+    }
+
+    // reassemble
+    let out = lines.join("\n");
+    let out = if had_final_nl { format!("{}\n", out) } else { out };
+    Ok(out)
+}
+
+fn run_apply(a: &Args) -> Result<()> {
+    let theme_name = a
+        .theme
+        .as_deref()
+        .ok_or_else(|| anyhow!("no theme specified"))?;
+    let theme = find_theme(theme_name)?;
+
+    let config_path = a
+        .config
+        .as_ref()
+        .map(|p| PathBuf::from(p.clone()))
+        .unwrap_or_else(default_config_path);
+
+    let text = fs::read_to_string(&config_path)
+        .with_context(|| format!("Could not find i3 config"))?;
+
+    let out_text = apply_theme(&text, theme)?;
+
+    // validate with i3 if available
+    validate(&out_text)?;
+
+    // determine output path
+    let out_path = match (&a.output, a.save) {
+        (Some(o), _) => PathBuf::from(o.clone()),
+        (_, true) => config_path.clone(),
+        (None, false) => config_path.clone(),
+    };
+
+    if a.reload {
+        eprintln!("reloading config");
+    }
+
+    fs::write(&out_path, out_text.as_bytes()).context("writing output")?;
+    eprintln!(
+        "saving config at {} to {}",
+        config_path.display(),
+        out_path.display()
+    );
+    Ok(())
+}
+
+fn run_to_theme(to_file: &str, config: Option<&str>) -> Result<()> {
+    let config_path = config
+        .map(|c| PathBuf::from(c.to_string()))
+        .unwrap_or_else(default_config_path);
+    let text = fs::read_to_string(&config_path)
+        .with_context(|| format!("Could not find i3 config"))?;
+    let out = extract_theme(&text);
+    if !to_file.is_empty() {
+        fs::write(&PathBuf::from(to_file), out.as_bytes())?;
+    } else {
+        print!("{}", out);
+    }
+    Ok(())
+}
+
+fn extract_theme(_text: &str) -> String {
+    // best-effort: emit an empty theme block
+    String::new()
+}
+
+fn validate(_text: &str) -> Result<()> {
+    let path = env::var("PATH").unwrap_or_default();
+    let found = path
+        .split(':')
+        .any(|d| PathBuf::from(d).join("i3").exists());
+    if !found {
+        return Ok(());
+    }
+    let tmp = std::env::temp_dir().join("i3-style-validate.tmp");
+    fs::write(&tmp, _text.as_bytes())?;
+    let status = Command::new("i3")
+        .args(["-C", "-c", tmp.to_str().unwrap()])
+        .status()?;
+    if !status.success() {
+        return Err(anyhow!("Config validation failed"));
+    }
+    Ok(())
+}
