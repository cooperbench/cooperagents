+[package]
+name = "i3-style"
+version = "1.0.0"
+edition = "2021"
+description = "Make your i3 config a bit more stylish"
+
+[[bin]]
+name = "executable"
+path = "src/main.rs"
+
+[dependencies]
+anyhow = "1.0.102"
