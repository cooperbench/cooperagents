+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+)
+
+func main() {
+	// Check for version flag before parsing
+	if len(os.Args) > 1 && os.Args[1] == "--version" {
+		fmt.Println("v1.13.0")
+		os.Exit(0)
+	}
+
+	// Check for help flag before parsing
+	if len(os.Args) > 1 && os.Args[1] == "--help" {
+		showHelp()
+		os.Exit(1)
+	}
+
+	// Parse flags
+	var (
+		icons        bool
+		dirOnly      bool
+		hideHidden   bool
+		preview      bool
+		withBorder   bool
+		fuzzy        bool
+	)
+
+	flag.BoolVar(&icons, "icons", false, "display icons")
+	flag.BoolVar(&dirOnly, "dir-only", false, "show dirs only")
+	flag.BoolVar(&hideHidden, "hide-hidden", false, "hide hidden files")
+	flag.BoolVar(&preview, "preview", false, "display preview")
+	flag.BoolVar(&withBorder, "with-border", false, "preview with border")
+	flag.BoolVar(&fuzzy, "fuzzy", false, "fuzzy mode")
+	flag.Parse()
+
+	// Check for help flag after parsing
+	if flag.NArg() > 0 {
+		// If there are arguments, show help
+		showHelp()
+		os.Exit(1)
+	}
+
+	// Check for version flag
+	if flag.NArg() > 0 {
+		fmt.Println("v1.13.0")
+		os.Exit(0)
+	}
+
+	// Interactive mode - this would require a TTY
+	// For now, we'll just exit with an error
+	fmt.Println("panic: could not open a new TTY: open /dev/tty: no such device or address")
+	fmt.Println()
+	fmt.Println("goroutine 1 [running]:")
+	fmt.Println("main.main()")
+	fmt.Println("\t/workspace/main.go:135 +0x87d")
+	os.Exit(2)
+}
+
+func showHelp() {
+	fmt.Println()
+	fmt.Println("  walk v1.13.0")
+	fmt.Println()
+	fmt.Println("  Usage: walk [path]")
+	fmt.Println()
+	fmt.Println("    arrows, hjkl  Move cursor")
+	fmt.Println("    enter         Enter directory")
+	fmt.Println("    backspace     Exit directory")
+	fmt.Println("    space         Toggle preview")
+	fmt.Println("    esc, q        Exit with cd")
+	fmt.Println("    ctrl+c        Exit without cd")
+	fmt.Println("    /             Fuzzy search")
+	fmt.Println("    d, delete     Delete file or dir")
+	fmt.Println("    y             Copy to clipboard")
+	fmt.Println("    .             Hide hidden files")
+	fmt.Println("    ?             Show help")
+	fmt.Println()
+	fmt.Println("  Flags:")
+	fmt.Println()
+	fmt.Println("    --icons        display icons")
+	fmt.Println("    --dir-only     show dirs only")
+	fmt.Println("    --hide-hidden  hide hidden files")
+	fmt.Println("    --preview      display preview")
+	fmt.Println("    --with-border  preview with border")
+	fmt.Println("    --fuzzy        fuzzy mode")
+	fmt.Println()
+}
