+package main
+
+import (
+	"embed"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// embeddedThemes ships the built-in themes inside the binary so the tool
+// keeps working even when the source tree is not next to the executable.
+//
+//go:embed themes/*.yaml
+var embeddedThemes embed.FS
+
+var hexColor = regexp.MustCompile(`^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$`)
+
+// Theme is a set of colors for the bar and the client windows.
+type Theme struct {
+	Bar     *BarTheme    `yaml:"bar,omitempty"`
+	Clients *ClientTheme `yaml:"clients,omitempty"`
+}
+
+// BarTheme holds the colors used inside a bar block's colors section.
+type BarTheme struct {
+	Separator         string   `yaml:"separator,omitempty"`
+	Background        string   `yaml:"background,omitempty"`
+	Statusline        string   `yaml:"statusline,omitempty"`
+	FocusedWorkspace  []string `yaml:"focused_workspace,omitempty"`
+	ActiveWorkspace   []string `yaml:"active_workspace,omitempty"`
+	InactiveWorkspace []string `yaml:"inactive_workspace,omitempty"`
+	UrgentWorkspace   []string `yaml:"urgent_workspace,omitempty"`
+	BindingMode       []string `yaml:"binding_mode,omitempty"`
+}
+
+// ClientTheme holds the client window border/background/text colors.
+type ClientTheme struct {
+	Focused         []string `yaml:"focused,omitempty"`
+	FocusedInactive []string `yaml:"focused_inactive,omitempty"`
+	Unfocused       []string `yaml:"unfocused,omitempty"`
+	Urgent          []string `yaml:"urgent,omitempty"`
+}
+
+// colorCount is the number of colors a directive takes.
+func colorCount(directive string) int {
+	switch directive {
+	case "separator", "background", "statusline":
+		return 1
+	case "binding_mode", "client.focused", "client.focused_inactive", "client.unfocused", "client.urgent":
+		return 4
+	default:
+		return 3 // the *_workspace directives
+	}
+}
+
+// colorsFor returns the theme colors that apply to the named directive, or
+// false when the theme does not define colors for it.
+func (t *Theme) colorsFor(directive string) ([]string, bool) {
+	switch directive {
+	case "separator":
+		if t.Bar == nil || t.Bar.Separator == "" {
+			return nil, false
+		}
+		return []string{t.Bar.Separator}, true
+	case "background":
+		if t.Bar == nil || t.Bar.Background == "" {
+			return nil, false
+		}
+		return []string{t.Bar.Background}, true
+	case "statusline":
+		if t.Bar == nil || t.Bar.Statusline == "" {
+			return nil, false
+		}
+		return []string{t.Bar.Statusline}, true
+	case "focused_workspace":
+		if t.Bar == nil {
+			return nil, false
+		}
+		return t.Bar.FocusedWorkspace, len(t.Bar.FocusedWorkspace) > 0
+	case "active_workspace":
+		if t.Bar == nil {
+			return nil, false
+		}
+		return t.Bar.ActiveWorkspace, len(t.Bar.ActiveWorkspace) > 0
+	case "inactive_workspace":
+		if t.Bar == nil {
+			return nil, false
+		}
+		return t.Bar.InactiveWorkspace, len(t.Bar.InactiveWorkspace) > 0
+	case "urgent_workspace":
+		if t.Bar == nil {
+			return nil, false
+		}
+		return t.Bar.UrgentWorkspace, len(t.Bar.UrgentWorkspace) > 0
+	case "binding_mode":
+		if t.Bar == nil {
+			return nil, false
+		}
+		return t.Bar.BindingMode, len(t.Bar.BindingMode) > 0
+	case "client.focused":
+		if t.Clients == nil {
+			return nil, false
+		}
+		return t.Clients.Focused, len(t.Clients.Focused) > 0
+	case "client.focused_inactive":
+		if t.Clients == nil {
+			return nil, false
+		}
+		return t.Clients.FocusedInactive, len(t.Clients.FocusedInactive) > 0
+	case "client.unfocused":
+		if t.Clients == nil {
+			return nil, false
+		}
+		return t.Clients.Unfocused, len(t.Clients.Unfocused) > 0
+	case "client.urgent":
+		if t.Clients == nil {
+			return nil, false
+		}
+		return t.Clients.Urgent, len(t.Clients.Urgent) > 0
+	}
+	return nil, false
+}
+
+// setColors stores the extracted colors for the named directive on t.
+func (t *Theme) setColors(directive string, colors []string) {
+	switch directive {
+	case "separator":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		if len(colors) > 0 {
+			t.Bar.Separator = colors[0]
+		}
+	case "background":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		if len(colors) > 0 {
+			t.Bar.Background = colors[0]
+		}
+	case "statusline":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		if len(colors) > 0 {
+			t.Bar.Statusline = colors[0]
+		}
+	case "focused_workspace":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		t.Bar.FocusedWorkspace = colors
+	case "active_workspace":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		t.Bar.ActiveWorkspace = colors
+	case "inactive_workspace":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		t.Bar.InactiveWorkspace = colors
+	case "urgent_workspace":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		t.Bar.UrgentWorkspace = colors
+	case "binding_mode":
+		if t.Bar == nil {
+			t.Bar = &BarTheme{}
+		}
+		t.Bar.BindingMode = colors
+	case "client.focused":
+		if t.Clients == nil {
+			t.Clients = &ClientTheme{}
+		}
+		t.Clients.Focused = colors
+	case "client.focused_inactive":
+		if t.Clients == nil {
+			t.Clients = &ClientTheme{}
+		}
+		t.Clients.FocusedInactive = colors
+	case "client.unfocused":
+		if t.Clients == nil {
+			t.Clients = &ClientTheme{}
+		}
+		t.Clients.Unfocused = colors
+	case "client.urgent":
+		if t.Clients == nil {
+			t.Clients = &ClientTheme{}
+		}
+		t.Clients.Urgent = colors
+	}
+}
+
+// validate checks that every color literal is a well-formed hex color.
+func (t *Theme) validate() error {
+	var problems []string
+	check := func(name, c string) {
+		if c != "" && !hexColor.MatchString(c) {
+			problems = append(problems, fmt.Sprintf("invalid color %q for %s", c, name))
+		}
+	}
+	if t.Bar != nil {
+		check("bar.separator", t.Bar.Separator)
+		check("bar.background", t.Bar.Background)
+		check("bar.statusline", t.Bar.Statusline)
+		for name, list := range map[string][]string{
+			"bar.focused_workspace":  t.Bar.FocusedWorkspace,
+			"bar.active_workspace":   t.Bar.ActiveWorkspace,
+			"bar.inactive_workspace": t.Bar.InactiveWorkspace,
+			"bar.urgent_workspace":   t.Bar.UrgentWorkspace,
+			"bar.binding_mode":       t.Bar.BindingMode,
+		} {
+			for _, c := range list {
+				check(name, c)
+			}
+		}
+	}
+	if t.Clients != nil {
+		for name, list := range map[string][]string{
+			"clients.focused":          t.Clients.Focused,
+			"clients.focused_inactive": t.Clients.FocusedInactive,
+			"clients.unfocused":        t.Clients.Unfocused,
+			"clients.urgent":           t.Clients.Urgent,
+		} {
+			for _, c := range list {
+				check(name, c)
+			}
+		}
+	}
+	if len(problems) > 0 {
+		return fmt.Errorf("%s", strings.Join(problems, "; "))
+	}
+	return nil
+}
+
+// themeSearchDirs are the directories, in order, that themes are looked up in.
+func themeSearchDirs() []string {
+	dirs := []string{"themes"}
+	if exe, err := os.Executable(); err == nil {
+		dirs = append(dirs, filepath.Join(filepath.Dir(exe), "themes"))
+	}
+	if d := os.Getenv("I3STYLE_THEMES"); d != "" {
+		dirs = append(dirs, d)
+	}
+	if home, err := os.UserHomeDir(); err == nil {
+		dirs = append(dirs, filepath.Join(home, ".config", "i3", "themes"))
+	}
+	return dirs
+}
+
+func fileExists(path string) bool {
+	st, err := os.Stat(path)
+	return err == nil && !st.IsDir()
+}
+
+// LoadTheme loads a theme by name or by path. Names are resolved against the
+// on-disk theme directories first and against the embedded themes second.
+func LoadTheme(nameOrPath string) (*Theme, error) {
+	var path string
+	if fileExists(nameOrPath) {
+		path = nameOrPath
+	} else {
+		for _, dir := range themeSearchDirs() {
+			for _, ext := range []string{".yaml", ".yml"} {
+				if p := filepath.Join(dir, nameOrPath+ext); fileExists(p) {
+					path = p
+					break
+				}
+			}
+			if path != "" {
+				break
+			}
+		}
+	}
+	var data []byte
+	var err error
+	switch {
+	case path != "":
+		data, err = os.ReadFile(path)
+	default:
+		for _, ext := range []string{".yaml", ".yml"} {
+			if data, err = embeddedThemes.ReadFile("themes/" + nameOrPath + ext); err == nil {
+				break
+			}
+		}
+	}
+	if err != nil {
+		return nil, fmt.Errorf("theme %q not found (looked in: %s)", nameOrPath, strings.Join(themeSearchDirs(), ", "))
+	}
+	var t Theme
+	if err := yaml.Unmarshal(data, &t); err != nil {
+		return nil, fmt.Errorf("parsing theme %q: %w", nameOrPath, err)
+	}
+	if err := t.validate(); err != nil {
+		return nil, fmt.Errorf("theme %q: %w", nameOrPath, err)
+	}
+	return &t, nil
+}
+
+// ListThemes returns the sorted names of all available themes.
+func ListThemes() ([]string, error) {
+	seen := make(map[string]bool)
+	var names []string
+	add := func(name string) {
+		if !seen[name] {
+			seen[name] = true
+			names = append(names, name)
+		}
+	}
+	for _, dir := range themeSearchDirs() {
+		entries, err := os.ReadDir(dir)
+		if err != nil {
+			continue
+		}
+		for _, e := range entries {
+			if e.IsDir() {
+				continue
+			}
+			ext := filepath.Ext(e.Name())
+			if ext == ".yaml" || ext == ".yml" {
+				add(strings.TrimSuffix(e.Name(), ext))
+			}
+		}
+	}
+	if entries, err := fs.ReadDir(embeddedThemes, "themes"); err == nil {
+		for _, e := range entries {
+			if e.IsDir() {
+				continue
+			}
+			ext := filepath.Ext(e.Name())
+			if ext == ".yaml" || ext == ".yml" {
+				add(strings.TrimSuffix(e.Name(), ext))
+			}
+		}
+	}
+	sort.Strings(names)
+	return names, nil
+}
+
+// ThemeFromConfig extracts the colors currently used in an i3 config so they
+// can be shared with others as a theme.
+func ThemeFromConfig(src string) *Theme {
+	var t Theme
+	forEachThemedLine(src, func(_ int, line string, directive string) {
+		colors := colorLiteralStrings(line)
+		if want := colorCount(directive); len(colors) > want {
+			colors = colors[:want]
+		}
+		t.setColors(directive, colors)
+	})
+	return &t
+}
+
+// ThemeYAML renders the theme as a YAML document suitable for sharing.
+func ThemeYAML(t *Theme) ([]byte, error) {
+	return yaml.Marshal(t)
+}
