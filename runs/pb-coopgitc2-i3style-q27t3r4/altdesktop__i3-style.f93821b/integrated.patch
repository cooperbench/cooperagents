++// ThemeFromConfig extracts the colors currently used in an i3 config so they
++// can be shared with others as a theme.
++func ThemeFromConfig(src string) *Theme {
++	var t Theme
++	forEachThemedLine(src, func(_ int, line string, directive string) {
++		colors := colorLiteralStrings(line)
++		if want := colorCount(directive); len(colors) > want {
++			colors = colors[:want]
++		}
++		t.setColors(directive, colors)
++	})
++	return &t
++}
