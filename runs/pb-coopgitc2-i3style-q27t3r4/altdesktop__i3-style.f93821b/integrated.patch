++package main
++
++import (
++	"fmt"
++	"regexp"
++	"strings"
++)
++
++// hexRun matches a '#' followed by a run of hex digits.
++var hexRun = regexp.MustCompile(`#[0-9a-fA-F]+`)
++
++// isColorLiteral reports whether lit is a 3- or 6-digit hex color literal.
++// Longer literals such as 8-digit ARGB values are intentionally left
++// untouched.
++func isColorLiteral(lit string) bool {
++	return len(lit) == 4 || len(lit) == 7 // '#' plus 3 or 6 digits
++}
++
++// colorLiterals returns the byte indices of every 3- or 6-digit hex color
++// literal in line.
++func colorLiterals(line string) [][]int {
++	var locs [][]int
++	for _, loc := range hexRun.FindAllStringIndex(line, -1) {
++		if isColorLiteral(line[loc[0]:loc[1]]) {
++			locs = append(locs, loc)
++		}
++	}
++	return locs
++}
++
++// colorLiteralStrings returns every 3- or 6-digit hex color literal in line.
++func colorLiteralStrings(line string) []string {
++	var out []string
++	for _, loc := range colorLiterals(line) {
++		out = append(out, line[loc[0]:loc[1]])
++	}
++	return out
++}
++
++// Block states used while walking an i3 config.
++const (
++	stOutside = iota
++	stBar
++	stBarColors
++)
++
++// firstToken returns the first whitespace-separated token of a config line.
++func firstToken(line string) string {
++	f := strings.Fields(line)
++	if len(f) == 0 {
++		return ""
++	}
++	return f[0]
++}
++
++// unquoted returns the line with the contents of double-quoted strings
++// removed so that braces inside string literals are not mistaken for block
++// delimiters.
++func unquoted(line string) string {
++	var b strings.Builder
++	inQuote := false
++	for _, r := range line {
++		switch {
++		case r == '"':
++			inQuote = !inQuote
++		case inQuote:
++		default:
++			b.WriteRune(r)
++		}
++	}
++	return b.String()
++}
++
++// replaceColors replaces the first len(colors) hex color tokens in line with
++// colors, leaving the rest of the line (whitespace, comments, extra values)
++// untouched. It reports an error when the line carries fewer colors than the
++// directive expects.
++func replaceColors(line string, colors []string) (string, error) {
++	locs := colorLiterals(line)
++	if len(locs) < len(colors) {
++		return line, fmt.Errorf("line %q contains %d color(s), need %d", strings.TrimSpace(line), len(locs), len(colors))
++	}
++	for i := len(colors) - 1; i >= 0; i-- {
++		loc := locs[i]
++		line = line[:loc[0]]+colors[i]+line[loc[1]:]
++	}
++	return line, nil
++}
++
++// barColorDirective reports whether key is a color directive that may appear
++// in a bar block's colors section.
++func barColorDirective(key string) (string, bool) {
++	switch key {
++	case "separator", "background", "statusline",
++		"focused_workspace", "active_workspace", "inactive_workspace",
++		"urgent_workspace", "binding_mode":
++		return key, true
++	}
++	return "", false
++}
++
++// clientDirective reports whether key is a top-level client color directive.
++func clientDirective(key string) (string, bool) {
++	switch key {
++	case "client.focused", "client.focused_inactive", "client.unfocused", "client.urgent":
++		return key, true
++	}
++	return "", false
++}
++
++// forEachThemedLine walks the i3 config line by line and invokes fn for every
++// line that carries themeable colors. fn receives the 0-based line index, the
++// line and the name of the directive whose colors it carries (e.g.
++// "separator" or "client.focused").
++func forEachThemedLine(src string, fn func(lineIdx int, line string, directive string)) {
++	state := stOutside
++	depth := 0
++	barDepth := 0
++	colorsDepth := 0
++	for i, line := range strings.Split(src, "\n") {
++		first := firstToken(line)
++		if state == stBarColors {
++			if directive, ok := barColorDirective(first); ok {
++				fn(i, line, directive)
++			}
++		} else if state == stOutside {
++			if directive, ok := clientDirective(first); ok {
++				fn(i, line, directive)
++			}
++		}
++		for _, r := range unquoted(line) {
++			switch r {
++			case '{':
++				depth++
++				if state == stOutside && first == "bar" && depth > barDepth {
++					state = stBar
++					barDepth = depth
++				} else if state == stBar && first == "colors" && depth == barDepth+1 {
++					state = stBarColors
++					colorsDepth = depth
++				}
++			case '}':
++				depth--
++				if depth < 0 {
++					depth = 0
++				}
++				if state == stBarColors && depth < colorsDepth {
++					state = stBar
++				}
++				if state == stBar && depth < barDepth {
++					state = stOutside
++				}
++			}
++		}
++	}
++}
++
++// ApplyTheme returns src with every themeable color replaced by the colors
++// from t. It validates the result: any themed line that does not contain
++// enough color tokens is an error. Lines or directives the theme does not
++// define are left untouched.
++func ApplyTheme(src string, t *Theme) (string, error) {
++	lines := strings.Split(src, "\n")
++	var firstErr error
++	forEachThemedLine(src, func(i int, line string, directive string) {
++		if firstErr != nil {
++			return
++		}
++		colors, ok := t.colorsFor(directive)
++		if !ok {
++			return
++		}
++		out, err := replaceColors(line, colors)
++		if err != nil {
++			firstErr = fmt.Errorf("line %d: %w", i+1, err)
++			return
++		}
++		lines[i] = out
++	})
++	if firstErr != nil {
++		return "", firstErr
++	}
++	return strings.Join(lines, "\n"), nil
++}
