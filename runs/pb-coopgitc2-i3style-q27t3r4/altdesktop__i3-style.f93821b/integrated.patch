++package main
++
++import (
++	"fmt"
++	"os"
++	"os/exec"
++	"path/filepath"
++	"strings"
++)
++
++const (
++	appName    = "i3-style"
++	appVersion = "1.0"
++	appDesc    = "Make your i3 config a bit more stylish"
++)
++
++type options struct {
++	help    bool
++	listAll bool
++	reload  bool
++	save    bool
++	version bool
++
++	config  string
++	output  string
++	toTheme string
++	theme   string
++}
++
++// parse parses command line arguments. Both "--flag value" and
++// "--flag=value" forms are accepted.
++func (o *options) parse(args []string) error {
++	var positional []string
++	for i := 0; i < len(args); i++ {
++		arg := args[i]
++		name, inline, hasInline := strings.Cut(arg, "=")
++		if hasInline && !strings.HasPrefix(name, "-") {
++			name, inline, hasInline = arg, "", false
++		}
++		switch name {
++		case "-h", "--help":
++			o.help = true
++		case "-l", "--list-all":
++			o.listAll = true
++		case "-r", "--reload":
++			o.reload = true
++		case "-s", "--save":
++			o.save = true
++		case "-V", "--version":
++			o.version = true
++		case "-c", "--config", "-o", "--output", "-t", "--to-theme":
++			var v string
++			if hasInline {
++				v = inline
++			} else if i+1 < len(args) {
++				i++
++				v = args[i]
++			} else {
++				return fmt.Errorf("flag %s requires a value", name)
++			}
++			switch name {
++			case "-c", "--config":
++				o.config = v
++			case "-o", "--output":
++				o.output = v
++			default:
++				o.toTheme = v
++			}
++		default:
++			if strings.HasPrefix(name, "-") && len(name) > 1 {
++				return fmt.Errorf("unknown flag: %s", name)
++			}
++			positional = append(positional, arg)
++		}
++	}
++	if len(positional) > 1 {
++		return fmt.Errorf("unexpected argument %q (see --help)", positional[1])
++	}
++	if len(positional) == 1 {
++		o.theme = positional[0]
++	}
++	return nil
++}
++
++func usageText(prog string) string {
++	return `i3-style 1.0
++` + appDesc + `
++
++USAGE:
++    ` + prog + ` [FLAGS] [OPTIONS] [theme]
++
++FLAGS:
++    -h, --help        Prints help information
++    -l, --list-all    Print a list of all available themes
++    -r, --reload      Apply the theme by reloading the config
++    -s, --save        Set the output file to the path of the input file
++    -V, --version     Prints version information
++
++OPTIONS:
++    -c, --config <file>      The config file the theme should be applied to. Defaults to the default i3 location.
++    -o, --output <file>      Apply the theme, attempt to validate the result, and write it to <file>
++    -t, --to-theme <file>    Prints an i3-style theme based on the given config suitable for sharing with others
++                             [default: ]
++
++ARGS:
++    <theme>    The theme to use
++`
++}
++
++func fail(format string, a ...interface{}) {
++	fmt.Fprintf(os.Stderr, appDesc+": "+format+"\n", a...)
++	os.Exit(1)
++}
++
++func main() {
++	opts := &options{}
++	if err := opts.parse(os.Args[1:]); err != nil {
++		fail("%v", err)
++	}
++	switch {
++	case opts.help:
++		fmt.Fprint(os.Stdout, usageText(filepath.Base(os.Args[0])))
++		return
++	case opts.version:
++		fmt.Printf("%s %s\n", appName, appVersion)
++		return
++	case opts.listAll:
++		names, err := ListThemes()
++		if err != nil {
++			fail("%v", err)
++		}
++		for _, n := range names {
++			fmt.Println(n)
++		}
++		return
++	case opts.toTheme != "":
++		data, err := os.ReadFile(opts.toTheme)
++		if err != nil {
++			fail("reading %s: %v", opts.toTheme, err)
++		}
++		out, err := ThemeYAML(ThemeFromConfig(string(data)))
++		if err != nil {
++			fail("rendering theme: %v", err)
++		}
++		if opts.output != "" {
++			if err := os.WriteFile(opts.output, out, 0o644); err != nil {
++				fail("writing %s: %v", opts.output, err)
++			}
++		} else {
++			os.Stdout.Write(out)
++		}
++		return
++	}
++	if opts.theme == "" {
++		fail("missing required argument <theme> (see --help)")
++	}
++	cfgPath := opts.config
++	if cfgPath == "" {
++		home, err := os.UserHomeDir()
++		if err != nil {
++			fail("resolving the default config location: %v", err)
++		}
++		cfgPath = filepath.Join(home, ".config", "i3", "config")
++	}
++	outPath := opts.output
++	if outPath == "" && opts.save {
++		outPath = cfgPath
++	}
++	if outPath == "" {
++		fail("no output path (use -o <file> or --save)")
++	}
++	theme, err := LoadTheme(opts.theme)
++	if err != nil {
++		fail("%v", err)
++	}
++	data, err := os.ReadFile(cfgPath)
++	if err != nil {
++		fail("reading %s: %v", cfgPath, err)
++	}
++	themed, err := ApplyTheme(string(data), theme)
++	if err != nil {
++		fail("applying theme: %v", err)
++	}
++	if err := os.WriteFile(outPath, []byte(themed), 0o644); err != nil {
++		fail("writing %s: %v", outPath, err)
++	}
++	if opts.reload {
++		if i3msg, err := exec.LookPath("i3-msg"); err == nil {
++			if err := exec.Command(i3msg, "reload").Run(); err != nil {
++				fmt.Fprintf(os.Stderr, "%s: warning: i3-msg reload failed: %v\n", appName, err)
++			}
++		} else {
++			fmt.Fprintf(os.Stderr, "%s: warning: i3-msg not found, skipping reload\n", appName)
++		}
++	}
++}
