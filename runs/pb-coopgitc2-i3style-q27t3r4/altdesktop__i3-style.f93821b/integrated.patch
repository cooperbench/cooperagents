++// ListThemes returns the sorted names of all available themes.
++func ListThemes() ([]string, error) {
++	seen := make(map[string]bool)
++	var names []string
++	add := func(name string) {
++		if !seen[name] {
++			seen[name] = true
++			names = append(names, name)
++		}
++	}
++	for _, dir := range themeSearchDirs() {
++		entries, err := os.ReadDir(dir)
++		if err != nil {
++			continue
++		}
++		for _, e := range entries {
++			if e.IsDir() {
++				continue
++			}
++			ext := filepath.Ext(e.Name())
++			if ext == ".yaml" || ext == ".yml" {
++				add(strings.TrimSuffix(e.Name(), ext))
++			}
++		}
++	}
++	if entries, err := fs.ReadDir(embeddedThemes, "themes"); err == nil {
++		for _, e := range entries {
++			if e.IsDir() {
++				continue
++			}
++			ext := filepath.Ext(e.Name())
++			if ext == ".yaml" || ext == ".yml" {
++				add(strings.TrimSuffix(e.Name(), ext))
++			}
++		}
++	}
++	sort.Strings(names)
++	return names, nil
++}
