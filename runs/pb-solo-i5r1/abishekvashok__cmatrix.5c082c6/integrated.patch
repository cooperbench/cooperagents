diff --git a/cmatrix.c b/cmatrix.c
new file mode 100644
index 0000000..4e002c1
--- /dev/null
+++ b/cmatrix.c
@@ -0,0 +1,351 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <curses.h>
+#include <locale.h>
+#include <signal.h>
+#include <time.h>
+
+#define VERSION "2.0"
+#define COMPILED_TIME "22:13:51, Jun 11 2026"
+#define EMAIL "abishekvashok@gmail.com"
+#define WEB "https://github.com/abishekvashok/cmatrix"
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int shadow_only = 0;
+static int lock_mode = 0;
+static int rainbow = 0;
+static int lambda_mode = 0;
+static int char_change = 0;
+static int x_mode = 0;
+static int screensaver = 0;
+static int use_japanese = 0;
+static int tty_set = 0;
+static int message_mode = 0;
+static int message[256];
+static int message_len = 0;
+static int update_delay = 4;
+static int color = 0;
+static int tty_fd = -1;
+
+static struct termios orig_termios;
+static volatile sig_atomic_t running = 1;
+
+static void sigint_handler(int sig) {
+    running = 0;
+}
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s)\n", VERSION, COMPILED_TIME);
+    printf("Email: %s\n", EMAIL);
+    printf("Web: %s\n", WEB);
+}
+
+static int parse_color(const char *str) {
+    if (strcmp(str, "green") == 0) return 0;
+    if (strcmp(str, "red") == 0) return 1;
+    if (strcmp(str, "blue") == 0) return 2;
+    if (strcmp(str, "white") == 0) return 3;
+    if (strcmp(str, "yellow") == 0) return 4;
+    if (strcmp(str, "cyan") == 0) return 5;
+    if (strcmp(str, "magenta") == 0) return 6;
+    if (strcmp(str, "black") == 0) return 7;
+    return -1;
+}
+
+static void setup_termios(void) {
+    tcgetattr(tty_fd, &orig_termios);
+    struct termios raw = orig_termios;
+    raw.c_lflag &= ~(ECHO | ICANON);
+    raw.c_cc[VMIN] = 0;
+    raw.c_cc[VTIME] = 0;
+    tcsetattr(tty_fd, TCSANOW, &raw);
+}
+
+static void restore_termios(void) {
+    tcsetattr(tty_fd, TCSANOW, &orig_termios);
+}
+
+static int get_char(void) {
+    char buf[1];
+    ssize_t n = read(tty_fd, buf, 1);
+    if (n > 0) {
+        return buf[0];
+    }
+    return -1;
+}
+
+static void draw_matrix(void) {
+    int rows, cols;
+    getmaxyx(stdscr, rows, cols);
+    
+    while (running) {
+        int delay = update_delay;
+        if (delay > 10) delay = 10;
+        if (delay < 0) delay = 0;
+        
+        int sleep_time = 100 - (delay * 10);
+        if (sleep_time < 0) sleep_time = 0;
+        if (sleep_time > 1000) sleep_time = 1000;
+        
+        int color_val = color;
+        if (rainbow) {
+            static int hue = 0;
+            hue = (hue + 1) % 16;
+            color_val = hue / 2;
+        }
+        
+        int bold_val = 0;
+        if (all_bold) bold_val = 1;
+        else if (bold_chars) {
+            if (rand() % 100 < 30) bold_val = 1;
+        }
+        if (no_bold) bold_val = 0;
+        
+        int shadow = shadow_only;
+        
+        int lambda = lambda_mode;
+        
+        int change = char_change;
+        
+        for (int i = 0; i < rows; i++) {
+            for (int j = 0; j < cols; j++) {
+                int ch;
+                if (use_japanese) {
+                    ch = 0x30A0 + (rand() % 96);
+                } else if (lambda) {
+                    ch = 0x03BB;
+                } else {
+                    ch = 0x534A + (rand() % 96);
+                }
+                
+                if (change) {
+                    ch = 0x534A + (rand() % 96);
+                }
+                
+                int attr = A_NORMAL;
+                if (bold_val) attr |= A_BOLD;
+                if (shadow) attr |= A_DIM;
+                
+                attr |= color_val;
+                
+                mvaddch(i, j, ch);
+                attr_off(A_NORMAL, A_NORMAL);
+                mvaddch(i, j, ' ');
+                attr_on(A_NORMAL, A_NORMAL);
+                mvaddch(i, j, ch);
+                attr_off(A_NORMAL, A_NORMAL);
+                mvaddch(i, j, ' ');
+                attr_on(A_NORMAL, A_NORMAL);
+                mvaddch(i, j, ch);
+            }
+        }
+        
+        if (message_len > 0) {
+            int msg_x = (cols - message_len) / 2;
+            int msg_y = rows / 2;
+            for (int i = 0; i < message_len; i++) {
+                mvaddch(msg_y, msg_x + i, message[i]);
+            }
+        }
+        
+        refresh();
+        napms(sleep_time);
+        
+        if (!screensaver) {
+            int ch = get_char();
+            if (ch == 'q' || ch == 'Q') {
+                running = 0;
+            } else if (ch == 'a') {
+                async_scroll = !async_scroll;
+            } else if (ch == 'b') {
+                bold_chars = !bold_chars;
+            } else if (ch == 'B') {
+                all_bold = !all_bold;
+            } else if (ch == 'n') {
+                no_bold = !no_bold;
+            } else if (ch >= '0' && ch <= '9') {
+                update_delay = ch - '0';
+            } else if (ch == '!') {
+                color = 1;
+            } else if (ch == '@') {
+                color = 0;
+            } else if (ch == '#') {
+                color = 4;
+            } else if (ch == '$') {
+                color = 2;
+            } else if (ch == '%') {
+                color = 6;
+            } else if (ch == '^') {
+                color = 5;
+            } else if (ch == '&') {
+                color = 3;
+            } else if (ch == ')') {
+                color = 7;
+            }
+        }
+    }
+}
+
+int main(int argc, char *argv[]) {
+    setlocale(LC_ALL, "");
+    
+    if (argc > 1 && (strcmp(argv[1], "-h") == 0 || strcmp(argv[1], "-?") == 0)) {
+        print_usage();
+        return 0;
+    }
+    
+    if (argc > 1 && strcmp(argv[1], "-V") == 0) {
+        print_version();
+        return 0;
+    }
+    
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-a") == 0) {
+            async_scroll = 1;
+        } else if (strcmp(argv[i], "-b") == 0) {
+            bold_chars = 1;
+        } else if (strcmp(argv[i], "-B") == 0) {
+            all_bold = 1;
+        } else if (strcmp(argv[i], "-c") == 0) {
+            use_japanese = 1;
+        } else if (strcmp(argv[i], "-f") == 0) {
+            force_term = 1;
+        } else if (strcmp(argv[i], "-l") == 0) {
+            linux_mode = 1;
+        } else if (strcmp(argv[i], "-L") == 0) {
+            lock_mode = 1;
+        } else if (strcmp(argv[i], "-o") == 0) {
+            old_style = 1;
+        } else if (strcmp(argv[i], "-n") == 0) {
+            no_bold = 1;
+        } else if (strcmp(argv[i], "-s") == 0) {
+            screensaver = 1;
+        } else if (strcmp(argv[i], "-x") == 0) {
+            x_mode = 1;
+        } else if (strcmp(argv[i], "-r") == 0) {
+            rainbow = 1;
+        } else if (strcmp(argv[i], "-m") == 0) {
+            lambda_mode = 1;
+        } else if (strcmp(argv[i], "-k") == 0) {
+            char_change = 1;
+        } else if (strcmp(argv[i], "-u") == 0) {
+            if (i + 1 < argc) {
+                update_delay = atoi(argv[++i]);
+                if (update_delay < 0) update_delay = 0;
+                if (update_delay > 10) update_delay = 10;
+            }
+        } else if (strcmp(argv[i], "-C") == 0) {
+            if (i + 1 < argc) {
+                int c = parse_color(argv[++i]);
+                if (c < 0) {
+                    printf(" Invalid color selection\n");
+                    printf(" Valid colors are green, red, blue, white, yellow, cyan, magenta and black.\n");
+                    return 0;
+                }
+                color = c;
+            }
+        } else if (strcmp(argv[i], "-M") == 0) {
+            if (i + 1 < argc) {
+                message_len = 0;
+                for (int j = 0; j < 255; j++) {
+                    message[j] = 0;
+                }
+                for (int j = 0; j < strlen(argv[++i]); j++) {
+                    if (j < 255) {
+                        message[message_len++] = argv[i][j];
+                    }
+                }
+                message[message_len] = 0;
+            }
+        } else if (strcmp(argv[i], "-t") == 0) {
+            if (i + 1 < argc) {
+                tty_set = 1;
+                tty_fd = open(argv[++i], O_RDWR);
+                if (tty_fd < 0) {
+                    fprintf(stderr, "Error opening terminal: %s\n", argv[i]);
+                    return 1;
+                }
+            }
+        }
+    }
+    
+    if (tty_fd < 0) {
+        tty_fd = open("/dev/tty", O_RDWR);
+        if (tty_fd < 0) {
+            fprintf(stderr, "Error opening terminal: unknown.\n");
+            return 1;
+        }
+    }
+    
+    signal(SIGINT, sigint_handler);
+    signal(SIGTERM, sigint_handler);
+    
+    setup_termios();
+    
+    if (linux_mode) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    if (force_term) {
+        setenv("TERM", "xterm", 1);
+    }
+    
+    if (initscr() == NULL) {
+        fprintf(stderr, "Error initializing terminal\n");
+        restore_termios();
+        return 1;
+    }
+    
+    cbreak();
+    noecho();
+    curs_set(0);
+    keypad(stdscr, TRUE);
+    
+    if (old_style) {
+        scrollok(stdscr, TRUE);
+    }
+    
+    draw_matrix();
+    
+    endwin();
+    restore_termios();
+    close(tty_fd);
+    
+    return 0;
+}
