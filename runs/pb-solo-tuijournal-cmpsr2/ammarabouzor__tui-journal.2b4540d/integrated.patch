+fn print_theme_help() {
+    println!("Provides commands regarding changing themes and styles of the app");
+    println!();
+    println!("Usage: executable theme <COMMAND>");
+    println!();
+    println!("Commands:");
+    println!("  print-path      Prints the path to the user themes file [aliases: path]");
+    println!("  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]");
+    println!("  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]");
+    println!("  help            Print this message or the help of the given subcommand(s)");
+    println!();
+    println!("Options:");
+    println!("  -h, --help  Print help");
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && (args[1] == "-V" || args[1] == "--version") {
+        println!("tui-journal 0.16.1");
+        return;
+    }
+    
+    if args.len() > 1 && (args[1] == "-h" || args[1] == "--help") {
+        print_help();
+        return;
+    }
+    
+    let mut command: Option<String> = None;
+    let mut json_file_path: Option<PathBuf> = None;
+    let mut sqlite_file_path: Option<PathBuf> = None;
+    let mut backend_type: Option<String> = None;
+    let mut config: Option<PathBuf> = None;
+    let mut verbose: u8 = 0;
+    let mut log: Option<PathBuf> = None;
+    
+    let mut i = 1;
+    while i < args.len() {
+        let arg = &args[i];
+        
+        if arg == "-j" || arg == "--json-file-path" {
+            if i + 1 < args.len() {
+                json_file_path = Some(PathBuf::from(&args[i + 1]));
+                i += 2;
+            } else {
+                eprintln!("Error: --json-file-path requires a value");
+                std::process::exit(1);
+            }
+        } else if arg == "-s" || arg == "--sqlite-file-path" {
+            if i + 1 < args.len() {
+                sqlite_file_path = Some(PathBuf::from(&args[i + 1]));
+                i += 2;
+            } else {
+                eprintln!("Error: --sqlite-file-path requires a value");
+                std::process::exit(1);
+            }
+        } else if arg == "-b" || arg == "--backend-type" {
+            if i + 1 < args.len() {
+                backend_type = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("Error: --backend-type requires a value");
+                std::process::exit(1);
+            }
+        } else if arg == "-c" || arg == "--config" {
+            if i + 1 < args.len() {
+                config = Some(PathBuf::from(&args[i + 1]));
+                i += 2;
+            } else {
+                eprintln!("Error: --config requires a value");
+                std::process::exit(1);
+            }
+        } else if arg == "-v" || arg == "--verbose" {
+            verbose += 1;
+            i += 1;
+        } else if arg == "-l" || arg == "--log" {
+            if i + 1 < args.len() {
+                log = Some(PathBuf::from(&args[i + 1]));
+                i += 2;
+            } else {
+                eprintln!("Error: --log requires a value");
+                std::process::exit(1);
+            }
+        } else if arg == "-h" || arg == "--help" {
+            print_help();
+            return;
+        } else if arg == "-V" || arg == "--version" {
+            println!("tui-journal 0.16.1");
+            return;
+        } else if arg == "print-config" || arg == "pc" {
+            command = Some("print-config".to_string());
+            break;
+        } else if arg == "import-journals" || arg == "imj" {
+            if i + 1 < args.len() {
+                command = Some("import-journals".to_string());
+                let path = PathBuf::from(&args[i + 1]);
+                import_journals(&path);
+            } else {
+                eprintln!("Error: import-journals requires a path argument");
+                std::process::exit(1);
+            }
+            break;
+        } else if arg == "assign-priority" || arg == "ap" {
+            if i + 1 < args.len() {
+                command = Some("assign-priority".to_string());
+                let priority = args[i + 1].clone();
+                assign_priority(&priority);
+            } else {
+                eprintln!("Error: assign-priority requires a priority argument");
+                std::process::exit(1);
+            }
+            break;
+        } else if arg == "theme" || arg == "style" {
+            command = Some("theme".to_string());
+            i += 1;
+            break;
+        } else if arg == "help" || arg == "h" {
+            print_help();
+            return;
+        } else {
+            // Unknown argument
+            eprintln!("Error: Unknown argument: {}", arg);
+            std::process::exit(1);
+        }
+    }
+    
+    if let Some(cmd) = command {
+        match cmd.as_str() {
+            "print-config" => {
+                print_config();
+            }
+            "import-journals" => {
+                // Already handled above
+            }
+            "assign-priority" => {
+                // Already handled above
+            }
+            "theme" => {
+                if i < args.len() {
+                    let subcmd = &args[i];
+                    if subcmd == "print-path" || subcmd == "path" {
+                        print_theme_path();
+                    } else if subcmd == "print-default" || subcmd == "default" {
+                        print_default_themes();
+                    } else if subcmd == "write-defaults" || subcmd == "write" {
+                        write_default_themes();
+                    } else if subcmd == "help" || subcmd == "h" {
+                        print_theme_help();
+                    } else {
+                        eprintln!("Error: Unknown theme subcommand: {}", subcmd);
+                        std::process::exit(1);
+                    }
+                } else {
+                    print_theme_help();
+                }
+            }
+            _ => {
+                eprintln!("Error: Unknown command: {}", cmd);
+                std::process::exit(1);
+            }
+        }
+    }
+}
