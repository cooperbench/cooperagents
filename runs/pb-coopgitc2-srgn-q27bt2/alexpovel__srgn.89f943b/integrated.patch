diff --git a/src/main.rs b/src/main.rs
new file mode 100644
index 0000000..3b326fc
--- /dev/null
+++ b/src/main.rs
@@ -0,0 +1,59 @@
+mod regex;
+mod cli;
+mod actions;
+mod files;
+
+use std::io::{self, Read, Write};
+use std::process::exit;
+
+fn prog_name() -> String {
+    // basename of argv[0]
+    let s = std::env::args().next().unwrap_or_else(|| "executable".to_string());
+    let s = s.replace("\\", "/");
+    s.rsplit('/').next().unwrap_or(&s).to_string()
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let rc = cli::run(&args);
+    exit(rc);
+}
+
+// helper for the warning timestamp, mimicking tracing/env_logger format
+pub fn warn_no_actions() {
+    use std::time::{SystemTime, UNIX_EPOCH};
+    let nanos = SystemTime::now().duration_since(UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u128)
+        .unwrap_or(0);
+    let secs = (nanos / 1_000_000_000) as u64;
+    let micros = ((nanos % 1_000_000_000) / 1000) as u64;
+    // civil time (UTC) from epoch seconds
+    let (y, mo, d, hh, mm, ss) = civil(secs);
+    let mut out = io::stderr();
+    let _ = writeln!(
+        out,
+        "[{}-{:02}-{:02}T{:02}:{:02}:{:02}.{:06}Z ERROR srgn] No actions specified, and not in search mode. Will return input unchanged, if any.",
+        y, mo, d, hh, mm, ss, micros
+    );
+    let _ = out.flush();
+}
+
+fn civil(epoch: u64) -> (u64, u64, u64, u64, u64, u64) {
+    // days since epoch
+    let days = epoch / 86400;
+    let secs = epoch % 86400;
+    let hh = secs / 3600;
+    let mm = (secs % 3600) / 60;
+    let ss = secs % 60;
+    // days to Y-M-D (Howard Hinnant's algorithm)
+    let z = days as i64 + 719468;
+    let era = if z >= 0 { z } else { z - 146096 } / 146097;
+    let doe = z - era * 146097; // [0, 146096]
+    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; // [0, 399]
+    let y = yoe as i64 + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100 + yoe / 400); // [0, 365]
+    let mp = (5 * doy + 2) / 155; // [0, 11]
+    let d = doy - (155 * mp - 2) / 5 + 1; // [1, 31]
+    let mo = mp + 1;
+    (y as u64, mo as u64, d as u64, hh, mm, ss)
+}
