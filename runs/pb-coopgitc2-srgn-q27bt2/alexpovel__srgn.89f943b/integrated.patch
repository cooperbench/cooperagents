+// Char-based regex engine (std only) with capture support.
+use std::collections::HashMap;
+
+#[derive(Clone)]
+enum Node {
+    Lit(char),
+    Any,
+    Class(Vec<(char, char)>, bool),
+    Digit,
+    NotDigit,
+    Word,
+    NotWord,
+    Space,
+    NotSpace,
+    Wb,
+    Nwb,
+    Start,
+    End,
+    Star(Box<Node>),
+    StarNg(Box<Node>),
+    Plus(Box<Node>),
+    PlusNg(Box<Node>),
+    Quest(Box<Node>),
+    QuestNg(Box<Node>),
+    Rep(usize, usize, Box<Node>),
+    RepNg(usize, usize, Box<Node>),
+    Group(usize, Vec<Node>),
+    NGroup(Vec<Node>),
+}
+
+struct Builder {
+    src: Vec<u8>,
+    i: usize,
+    err: Option<String>,
+    groups: usize,
+    names: HashMap<String, usize>,
+    }
+impl Builder {
+    fn new(src: &str) -> Builder {
+        Builder { src: src.bytes().collect(), i: 0, err: None, groups: 0, names: HashMap::new() }
+    }
+    fn peek(&self) -> Option<u8> { self.src.get(self.i).copied() }
+    fn q(&self) -> Option<u8> {
+        if self.i < self.src.len() { Some(self.src[self.i]) } else { None }
+    }
+    fn adv(&mut self) { if self.i < self.src.len() { self.i += 1; } }
+    fn fail(&mut self, m: &str) { if self.err.is_none() { self.err = Some(m.to_string()); } }
+
+    fn parse(&mut self) -> Result<Vec<Vec<Node>>, String> {
+        let mut alts: Vec<Vec<Node>> = Vec::new();
+        loop {
+            let seq = self.parse_seq();
+            alts.push(seq);
+            if self.peek() == Some(b'|') { self.adv(); continue; }
+            break;
+        }
+        if self.i < self.src.len() { self.fail(&format!("unexpected char {:?}", self.q().unwrap())); }
+        if let Some(e) = self.err.take() { return Err(e); }
+        if alts.is_empty() { return Err("empty pattern".to_string()); }
+        Ok(alts)
+    }
+
+    fn parse_seq(&mut self) -> Vec<Node> {
+        let mut items: Vec<Node> = Vec::new();
+        loop {
+            let b = self.peek();
+            if b == Some(b')') || b == Some(b'|') || b.is_none() { break; }
+            let start_i = self.i;
+            let n = self.parse_atom();
+            match n {
+                Some(x) => { items.push(x); }
+                None => break,
+            }
+            if self.i == start_i { break; }
+        }
+        items
+    }
+
+    fn parse_atom(&mut self) -> Option<Node> {
+        let b = self.peek()?;
+        let n: Node = match b {
+            b'.' => { self.adv(); Node::Any },
+            b'^' => { self.adv(); Node::Start },
+            b'$' => { self.adv(); Node::End },
+            b'\\' => { self.adv(); self.parse_escape() },
+            b'[' => self.parse_class(),
+            b'(' => self.parse_group(),
+            c => {
+                let c = c as char; self.adv();
+                Node::Lit(c)
+            }
+        };
+        Some(self.parse_quant(n))
+    }
+
+    fn parse_escape(&mut self) -> Node {
+        let b = match self.q() { Some(b) => b, None => { self.fail("unexpected eof"); return Node::Lit('\\'); } };
+        match b {
+            b'd' => { self.adv(); Node::Digit },
+            b'D' => { self.adv(); Node::NotDigit },
+            b'w' => { self.adv(); Node::Word },
+            b'W' => { self.adv(); Node::NotWord },
+            b's' => { self.adv(); Node::Space },
+            b'S' => { self.adv(); Node::NotSpace },
+            b'b' => { self.adv(); Node::Wb },
+            b'n' => { self.adv(); Node::Lit('\n') },
+            b't' => { self.adv(); Node::Lit('\t') },
+            b'\\' => { self.adv(); Node::Lit('\\') },
+            b'^' => { self.adv(); Node::Start },
+            b'$' => { self.adv(); Node::End },
+            b'.' => { self.adv(); Node::Lit('.') },
+            b'[' => { self.adv(); Node::Lit('[') },
+            b']' => { self.adv(); Node::Lit(']') },
+            b'/' => { self.adv(); Node::Lit('/') },
+            c => {
+                self.adv();
+                Node::Lit(c as char)
+            }
+        }
+    }
+
+    fn parse_quant(&mut self, mut base: Node) -> Node {
+        loop {
+            match self.peek() {
+                Some(b'*') => {
+                    self.adv();
+                    let ng = match self.peek() { Some(b'?') => { self.adv(); true } _ => false };
+                    base = if ng { Node::StarNg(Box::new(base)) } else { Node::Star(Box::new(base)) };
+                }
+                Some(b'+') => {
+                    self.adv();
+                    let ng = match self.peek() { Some(b'?') => { self.adv(); true } _ => false };
+                    base = if ng { Node::PlusNg(Box::new(base)) } else { Node::Plus(Box::new(base)) };
+                }
+                Some(b'?') => {
+                    self.adv();
+                    let ng = match self.peek() { Some(b'?') => { self.adv(); true } _ => false };
+                    base = if ng { Node::QuestNg(Box::new(base)) } else { Node::Quest(Box::new(base)) };
+                }
+                Some(b'{') => {
+                    self.adv();
+                    let mut a = 0usize;
+                    while self.peek().map(|b| b.is_ascii_digit()).unwrap_or(false) {
+                        a = a * 10 + (self.q().unwrap() - b'0') as usize;
+                        self.adv();
+                    }
+                    let comma = self.peek() == Some(b',');
+                    if comma { self.adv(); }
+                    let mut b = 0usize;
+                    let mut has_b = false;
+                    while self.peek().map(|x| x.is_ascii_digit()).unwrap_or(false) {
+                        b = b * 10 + (self.q().unwrap() - b'0') as usize;
+                        has_b = true;
+                        self.adv();
+                    }
+                    let ng = match self.peek() { Some(b'?') => { self.adv(); true } _ => false };
+                    self.expect(b'}');
+                    let (min, max) = if comma {
+                        (a, if has_b { b } else { usize::MAX })
+                    } else {
+                        (a, a)
+                    };
+                    base = if ng { Node::RepNg(min, max, Box::new(base)) } else { Node::Rep(min, max, Box::new(base)) };
+                }
+                _ => break,
+            }
+        }
+        base
+    }
+
+    fn parse_class(&mut self) -> Node {
+        self.adv();
+        let mut ranges: Vec<(char, char)> = Vec::new();
+        let mut neg = false;
+        if self.peek() == Some(b'^') { neg = true; self.adv(); }
+        let mut first: Option<char> = None;
+        loop {
+            let b = self.peek();
+            if b == Some(b']') { break; }
+            match b {
+                Some(b'\\') => {
+                    self.adv();
+                    match self.q() {
+                        Some(b'd') => { self.adv(); ranges.push(('0', '9')); }
+                        Some(b'D') => { self.adv(); ranges.push(('0', '9')); neg = !neg; }
+                        Some(b'w') => { self.adv(); ranges.push(('0', '9')); ranges.push(('a', 'z')); ranges.push(('A', 'Z')); ranges.push(('_', '_')); }
+                        Some(b'W') => { self.adv(); ranges.push(('0', '9')); ranges.push(('a', 'z')); ranges.push(('A', 'Z')); ranges.push(('_', '_')); neg = !neg; }
+                        Some(b's') => { self.adv(); ranges.push((' ', ' ')); ranges.push(('\n', '\n')); }
+                        Some(b'S') => { self.adv(); ranges.push((' ', ' ')); neg = !neg; }
+                        Some(b'\\') => { self.adv(); ranges.push(('\\', '\\')); }
+                        Some(b'^') => { self.adv(); ranges.push(('^', '^')); }
+                        Some(b'[') => { self.adv(); ranges.push(('[', '[')); }
+                        Some(b']') => { self.adv(); ranges.push((']', ']')); }
