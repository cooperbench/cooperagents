++// symbols: map some ASCII sequences/chars to unicode symbols
++pub fn apply_symbols(s: &str, invert: bool) -> String {
++    if !invert {
++        // forward: ASCII -> Unicode
++        let s = s.replace("->", "→").replace("=>", "⇒").replace("==", "≡")
++            .replace("!=", "≠").replace("<=", "≤").replace(">=", "≥")
++            .replace("--", "—").replace("---", "—")
++            .replace("+-", "±");
++        let mut out = String::new();
++        for c in s.chars() {
++            match c {
++                '<' => out.push('＜'),
++                '>' => out.push('＞'),
++                '+' => out.push('＋'),
++                _ => out.push(c),
++            }
++        }
++        out
++    } else {
++        // inverse: Unicode -> ASCII (only symbols are 1:1 reversible)
++        let s = s.replace("→", "->").replace("⇒", "=>").replace("≡", "==")
++            .replace("≠", "!=").replace("≤", "<=").replace("≥", ">=")
++            .replace("—", "--").replace("±", "+-");
++        let mut out = String::new();
++        for c in s.chars() {
++            match c {
++                '＜' => out.push('<'),
++                '＞' => out.push('>'),
++                '＋' => out.push('+'),
++                _ => out.push(c),
++            }
++        }
++        out
++    }
++}
