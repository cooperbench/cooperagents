++fn squeeze_matches(
++    matches: &[(usize, usize, regex::Captures)],
++    chars: &[char],
++    _actions: &Actions,
++    _replacement: Option<&String>,
++) -> Vec<(usize, usize, regex::Captures)> {
++    // keep only the first of consecutive identical matches
++    let mut out: Vec<(usize, usize, regex::Captures)> = vec![];
++    for m in matches {
++        let mstart: usize = m.0;
++        let mend: usize = m.1;
++        let matched: String = chars[mstart..mend].iter().collect();
++        if let Some(prev) = out.last() {
++            let pm: String = chars[prev.0..prev.1].iter().collect();
++            if pm == matched && prev.1 == mstart {
++                continue;
++            }
++        }
++        out.push(m.clone());
++    }
++    out
++}
