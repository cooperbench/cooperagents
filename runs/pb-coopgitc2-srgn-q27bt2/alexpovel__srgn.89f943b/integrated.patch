++    fn start_capturing(&mut self, name: String) -> Result<(), String> {
++        let id = self.next_id; self.next_id += 1;
++        self.names.push(Some(name));
++        Ok(())
++    }
++
++    fn parse_group_inner(&mut self) -> Result<Box<Node>, String> {
++        // we've consumed '('; parse until ')'
++        let node = self.parse_alt()?;
++        if self.peek() != Some(')') { return Err("expected )".into()); }
++        self.advance();
++        Ok(node)
++    }
++
++    fn read_name(&mut self) -> Result<String, String> {
++        let mut name = String::new();
++        while let Some(c) = self.peek() {
++            if c == '>' { self.advance(); break; }
++            if c.is_alphanumeric() || c == '_' { name.push(c); self.advance(); }
++            else { return Err("bad name".into()); }
++        }
++        if name.is_empty() { return Err("empty name".into()); }
++        Ok(name)
++    }
++
++    fn parse_class(&mut self) -> Result<Box<Node>, String> {
++        self.advance(); // consume '['
++        let mut neg = false;
++        if self.peek() == Some('^') { neg = true; self.advance(); }
++        let mut ranges: Vec<(char,char)> = vec![];
++        // first char can be ']' as literal
++        loop {
++            match self.peek() {
++                None => { return Err("unterminated class".into()); }
++                Some(']') => { self.advance(); break; }
++                Some(c) => {
++                    let lo = self.advance().unwrap();
++                    // range?
++                    if self.peek() == Some('-') && self.s.get(self.i+1) != Some(&']') {
++                        self.advance();
++                        let hi = self.advance().unwrap_or(']');
++                        ranges.push((lo, hi));
++                    } else {
++                        ranges.push((lo, lo));
++                    }
++                }
++            }
++        }
++        Ok(Box::new(Node::Class{ neg, set: ClassSet{ ranges, neg } }))
++    }
++
++    fn parse_escape(&mut self) -> Result<Box<Node>, String> {
++        // consumed '\'; read next char
++        let c = match self.advance() {
++            Some(c) => c,
++            None => return Err("trailing backslash".into()),
++        };
++        match c {
++            'd' => Ok(self.class_of(vec![('0','9')], false)),
++            'D' => Ok(self.class_of(vec![('0','9')], true)),
++            'w' => Ok(self.class_of(vec![('a','z'),('A','Z'),('0','9')], false)),
++            'W' => Ok(self.class_of(vec![('a','z'),('A','Z'),('0','9')], true)),
++            's' => Ok(self.class_of(vec![(' ',' '),('\t','\t'),('\n','\n'),('\r','\r'),('\x0c','\x0c'),('\x0b','\x0b')], false)),
++            'S' => Ok(self.class_of(vec![(' ',' '),('\t','\t'),('\n','\n'),('\r','\r'),('\x0c','\x0c'),('\x0b','\x0b')], true)),
++            'b' => { Ok(Box::new(Node::WordBoundary)) }
++            'B' => { Ok(Box::new(Node::NotWordBoundary)) }
++            'A' => { Ok(Box::new(Node::Start)) }
++            'z' => { Ok(Box::new(Node::End)) }
++            _ => {
++                // literal escaped char (., (, ), etc.) or \x \o \N
++                Ok(Box::new(Node::Char(c)))
++            }
++        }
++    }
++
++    fn class_of(&self, ranges: Vec<(char,char)>, neg: bool) -> Box<Node> {
++        Box::new(Node::Class{ neg, set: ClassSet{ ranges, neg } })
++    }
++}
++
++pub fn compile(pattern: &str) -> Result<Pattern, String> {
++    let mut p = Parser::new(pattern);
++    let root = p.parse()?;
++    // root is an Alt; wrap
++    let pat = Pattern {
++        root: Box::new(Node::Concat(vec![root])),
++        names: p.names,
++        case_insensitive: p.case_insensitive,
++    };
++    Ok(pat)
++}
++
++pub fn compile_lenient(pattern: &str) -> Result<Pattern, String> {
++    match compile(pattern) {
++        Ok(p) => Ok(p),
++        Err(_) => {
++            // fallback: treat as literal
++            let s: Vec<char> = pattern.chars().collect();
++            let items: Vec<Box<Node>> = s.iter().map(|&c| {
++                if c == '.' { Box::new(Node::Char('.')) } else { Box::new(Node::Char(c)) }
++            }).collect();
++            Ok(Pattern { root: Box::new(Node::Concat(items)), names: vec![None], case_insensitive: false })
++        }
++    }
++}
++
++// ---- Matching ----
++#[derive(Clone)]
++pub struct Captures {
++    pub starts: Vec<Option<usize>>, // char index start
++    pub ends: Vec<Option<usize>>,
++}
++impl Captures {
++    pub fn new(n: usize) -> Self {
++        Captures { starts: vec![None; n], ends: vec![None; n] }
++    }
++}
++
++fn is_word(c: Option<char>) -> bool {
++    match c {
++        Some(c) => c.is_alphanumeric() || c == '_',
++        None => false,
++    }
++}
++
++// Backtracking matcher: returns ALL (end, captures) a node can match starting at
++// `start`, ordered by preference (greedy => longer end first, lazy => shorter first).
++// Empty result means "no match". The caller (find_match) takes the first entry.
++fn match_node(pat: &Pattern, node: &Node, chars: &[char], start: usize, caps: &Captures)
++    -> Vec<(usize, Captures)> {
++    match node {
++        Node::Char(c) => {
++            if let Some(g) = chars.get(start) {
++                let g = *g;
++                let ok = if pat.case_insensitive {
++                    g.to_lowercase().eq(c.to_lowercase())
++                } else {
++                    g == *c
++                };
++                if ok { return vec![(start + 1, caps.clone())]; }
++            }
++            vec![]
++        }
++        Node::AnyChar => {
++            if let Some(g) = chars.get(start) {
++                if g != &'\n' { return vec![(start + 1, caps.clone())]; }
++            }
++            vec![]
++        }
++        Node::AnyCharIncl => {
++            if chars.get(start).is_some() { return vec![(start + 1, caps.clone())]; }
++            vec![]
++        }
++        Node::Class { set, neg: _ } => {
++            if let Some(g) = chars.get(start) {
++                if set.contains(*g) { return vec![(start + 1, caps.clone())]; }
++            }
++            vec![]
++        }
++        Node::Start => {
++            if start == 0 || (start > 0 && chars[start - 1] == '\n') {
++                return vec![(start, caps.clone())];
++            }
++            vec![]
++        }
++        Node::End => {
++            if start == chars.len() || (start < chars.len() && chars[start] == '\n') {
++                return vec![(start, caps.clone())];
++            }
++            vec![]
++        }
++        Node::WordBoundary => {
++            let before = if start > 0 { Some(chars[start - 1]) } else { None };
++            let after = chars.get(start).copied();
++            if is_word(before) != is_word(after) { return vec![(start, caps.clone())]; }
++            vec![]
++        }
++        Node::NotWordBoundary => {
++            let before = if start > 0 { Some(chars[start - 1]) } else { None };
++            let after = chars.get(start).copied();
++            if is_word(before) == is_word(after) { return vec![(start, caps.clone())]; }
++            vec![]
++        }
++        Node::Empty => vec![(start, caps.clone())],
++        Node::NonGroup(inner) => match_node(pat, inner, chars, start, caps),
++        Node::Group { id, node: inner } => {
++            let mut out = vec![];
++            for (end, mut c) in match_node(pat, inner, chars, start, caps) {
++                c.starts[*id] = Some(start);
++                c.ends[*id] = Some(end);
++                out.push((end, c));
++            }
++            out
++        }
++        Node::Concat(items) => {
++            let mut results: Vec<(usize, Captures)> = vec![(start, caps.clone())];
++            for it in items {
++                let mut next = vec![];
++                for (pos, c) in &results {
++                    for (end, c2) in match_node(pat, it, chars, *pos, c) {
++                        next.push((end, c2));
++                    }
++                }
++                results = next;
++            }
++            results
++        }
++        Node::Alt(brs) => {
++            let mut out = vec![];
++            for br in brs {
++                for (end, c) in match_node(pat, br, chars, start, caps) {
++                    out.push((end, c));
++                }
++            }
++            out
++        }
++        Node::Repeat { min, max, greedy, node: inner } => {
++            repeat_node(pat, inner, chars, start, caps, *min, *max, *greedy)
++        }
++    }
++}
++
++const RESULT_CAP: usize = 200_000;
++
++// Compute all (end, captures) for [min, max] repetitions of `inner`.
++fn repeat_node(pat: &Pattern, inner: &Box<Node>, chars: &[char], start: usize,
++              caps: &Captures, min: u32, max: u32, greedy: bool) -> Vec<(usize, Captures)> {
++    // by_count[k] = endpoints after exactly k repetitions (k=0 is the empty match)
++    let mut by_count: Vec<Vec<(usize, Captures)>> = vec![vec![(start, caps.clone())]];
++    // bound the number of repetitions we expand to avoid pathological blowups
++    let cap_max = max.min(2000);
++    for _ in 1..=cap_max {
++        let prev = by_count.last().unwrap();
++        let mut next = vec![];
++        for (pos, c) in prev {
++            for (end, c2) in match_node(pat, inner, chars, *pos, c) {
++                next.push((end, c2));
++            }
++        }
++        if next.is_empty() { break; }
++        if next.len() > RESULT_CAP { next.truncate(RESULT_CAP); }
++        by_count.push(next);
++    }
++    // assemble results for counts in [min, by_count.len()-1], ordered by preference
++    let mut result = vec![];
++    let lo = min as usize;
++    let hi = by_count.len() - 1;
++    if lo <= hi {
++        if greedy {
++            // higher count first (longer), then sort by end desc
++            for k in (lo..=hi).rev() {
++                let v = std::mem::take(&mut by_count[k]);
++                result.extend(v);
++            }
++        } else {
++            // lower count first (shorter), then sort by end asc
++            for k in lo..=hi {
++                let v = std::mem::take(&mut by_count[k]);
++                result.extend(v);
++            }
++        }
++    }
++    if greedy {
++        result.sort_by(|a, b| b.0.cmp(&a.0));
++    } else {
++        result.sort_by(|a, b| a.0.cmp(&b.0));
++    }
++    result
++}
++
++// Find the leftmost match at or after `start`, returning (start, end, captures).
++pub fn find_match(pat: &Pattern, chars: &[char], start: usize) -> Option<(usize, usize, Captures)> {
++    for pos in start..=chars.len() {
++        let initial = Captures::new(pat.names.len());
++        let results = match_node(pat, &pat.root, chars, pos, &initial);
++        if let Some((end, caps)) = results.into_iter().next() {
++            return Some((pos, end, caps));
++        }
++    }
++    None
++}
++
++
++// Global find: returns all non-overlapping matches [(start, end, captures), ...].
++pub fn find_all(pat: &Pattern, chars: &[char]) -> Vec<(usize, usize, Captures)> {
++    let mut result = vec![];
++    let mut pos = 0;
++    while pos <= chars.len() {
++        match find_match(pat, chars, pos) {
++            Some((mstart, end, caps)) => {
++                if end == mstart {
++                    // zero-length match; skip (advance by 1) like regex crate find_iter
++                    pos = mstart + 1;
++                } else {
++                    result.push((mstart, end, caps));
++                    pos = end;
++                }
++            }
++            None => break,
++        }
++    }
++    result
++}
