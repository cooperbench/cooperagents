++fn search_mode(input: &str, scope: &str) {
++    // approximate: for each line that matches scope, report (stdin):LINE:0-{len}:LINE
++    let mut out = io::stdout();
++    let pat = match regex::compile(scope) {
++        Ok(p) => p,
++        Err(e) => {
++            let mut e2 = io::stderr();
++            let _ = writeln!(e2, "Error: Failed building regex");
++            let _ = writeln!(e2, "");
++            let _ = writeln!(e2, "Caused by:");
++            let _ = writeln!(e2, "    {}", e);
++            let _ = e2.flush();
++            std::process::exit(1);
++        }
++    };
++    let mut any = false;
++    let mut line_no = 1usize;
++    for line in input.split_inclusive('\n') {
++        let trimmed = line.strip_suffix('\n').unwrap_or(line);
++        let chars: Vec<char> = trimmed.chars().collect();
++        if regex::find_all(&pat, &chars).iter().any(|m| m.1 > m.0) {
++            let end = trimmed.chars().count();
++            let _ = io::stdout();
++            let _ = writeln!(out, "(stdin):{}:{}-{}:{}", line_no, 0, end, line.trim_end_matches('\n'));
++            any = true;
++        }
++        line_no += 1;
++    }
++    let _ = out.flush();
++    let _ = any;
++    if !any {
++        std::process::exit(2);
++    }
++}
