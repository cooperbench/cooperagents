+++ b/src/cli.rs
@@ -0,0 +1,219 @@
+use std::io::{self, Write};
+use crate::regex;
+use crate::actions::Actions;
+
+const HELP: &str = include_str!("HELP.txt");
+const HHELP: &str = include_str!("H.txt");
+
+fn is_lang_scope(arg: &str) -> bool {
+    // language scope flags take a value; presence means search mode
+    matches!(arg, "--c" | "--python" | "--rust" | "--go" | "--cpp" | "--csharp" | "--java"
+        | "--javascript" | "--json" | "--ruby" | "--typescript" | "--yaml" | "--toml"
+        | "--markdown" | "--html" | "--lua" | "--php" | "--perl" | "--shell" | "--sql"
+        | "--bash" | "--powershell" | "--kotlin" | "--swift" | "--objc" | "--ocaml"
+        | "--r" | "--elixir" | "--erlang" | "--haskell" | "--dart" | "--scala"
+        | "--solidity" | "--vue" | "--xml" | "--ini" | "--css" | "--scss" | "--sass"
+        | "--diff" | "--gitignore" | "--dockerfile" | "--cmake" | "--make" | "--nasm"
+        | "--vim" | "--coffeescript" | "--elm" | "--fsharp" | "--gnuplot" | "--graphql"
+        | "--ini" | "--json5" | "--yaml" | "--zig" | "--c" )
+}
+
+// returns Some(usage) for a detected conflict
+fn detect_conflict(a: &Actions, has_replacement: bool) -> Option<String> {
+    if a.delete {
+        // --delete cannot be used with anything else
+                    if has_replacement || a.upper || a.lower || a.titlecase || a.german_naive || a.normalize
+            || a.german || a.german_naive || a.symbols || a.squeeze {
+            return Some(format!(
+"error: the argument '--delete' cannot be used with:
+  [REPLACEMENT]
+  --upper
+  --lower
+  --titlecase
+  --normalize
+  --german
+  --symbols
+
+Usage: executable --delete {}<SCOPE> {}[-- <REPLACEMENT>]
+
+For more information, try '--help'.",
+                if a.upper || a.lower || a.titlecase || a.normalize || a.german || a.symbols { "--upper " } else { "" },
+                if has_replacement { "-- " } else { "[-- <REPLACEMENT>]" },
+            ));
+        }
+    }
+    if a.squeeze && a.delete {
+        return Some(
+"error: the argument '--squeeze' cannot be used with '--delete'
+
+Usage: executable --squeeze <SCOPE> [-- <REPLACEMENT>]
+
+For more information, try '--help'.".to_string()
+        );
+    }
+    None
+}
+
+pub fn run(args: &[String]) -> i32 {
+    let mut i = 1;
+    let mut scope: Option<String> = None;
+    let mut replacement: Option<String> = None;
+    let mut after_dashdash = false;
+    let mut actions = Actions::default();
+    let mut literal = false;
+    let mut lang_scope = false;
+
+    let mut help_mode = None; // None=normal, Some(true)=full, Some(false)=short
+    loop {
+        if i >= args.len() { break; }
+        let arg = args[i].clone();
+        if after_dashdash {
+            // positional after -- is replacement
+            if replacement.is_none() {
+                replacement = Some(arg.clone());
+            }
+            i += 1;
+            continue;
+        }
+        if arg == "--" {
+            after_dashdash = true;
+            i += 1;
+            continue;
+        }
+        // help / version
+        if arg == "-h" || arg == "--help" {
+            let full = arg == "--help";
+            // print on first occurrence
+            if help_mode.is_none() { help_mode = Some(full); }
+            i += 1;
+            continue;
+        }
+        if arg == "-V" || arg == "--version" {
+            print!("srgn 0.14.1\n");
+            return 0;
+        }
+        // combined short flags, e.g. -Sgu -> -S -g -u
+        if arg.starts_with("-") && !arg.starts_with("--") && arg.len() > 2 {
+            let bytes = arg.as_bytes();
+            let mut j = 1usize;
+            let mut ok = true;
+            while j < bytes.len() {
+                let c = bytes[j] as char;
+                match c {
+                    'u' => { actions.upper = true; }
+                    'l' => { actions.lower = true; }
+                    't' => { actions.titlecase = true; }
+                    'n' => { actions.normalize = true; }
+                    'g' => { actions.german = true; }
+                    'S' => { actions.symbols = true; }
+                    'd' => { actions.delete = true; }
+                    's' => { actions.squeeze = true; }
+                    'i' => { actions.invert = true; }
+                    'L' => { literal = true; }
+                    'G' | 'j' | 'H' | 'v' | 'f' => { /* global, ignored */ }
+                    _ => { ok = false; break; }
+                }
+                j += 1;
+            }
+            if ok { i += 1; continue; }
+        }
+        // actions
+        if arg == "-u" || arg == "--upper" { actions.upper = true; i+=1; continue; }
+        if arg == "-l" || arg == "--lower" { actions.lower = true; i+=1; continue; }
+        if arg == "-t" || arg == "--titlecase" { actions.titlecase = true; i+=1; continue; }
+        if arg == "-n" || arg == "--normalize" { actions.normalize = true; i+=1; continue; }
+        if arg == "-g" || arg == "--german" { actions.german = true; i+=1; continue; }
+        if arg == "--german-naive" { actions.german_naive = true; i+=1; continue; }
+        if arg == "--german-prefer-original" { actions.german_prefer_original = true; i+=1; continue; }
+        if arg == "-S" || arg == "--symbols" { actions.symbols = true; i+=1; continue; }
+        if arg == "-d" || arg == "--delete" { actions.delete = true; i+=1; continue; }
+        if arg == "-s" || arg == "--squeeze" { actions.squeeze = true; i+=1; continue; }
+        // global flags (mostly ignored)
+        if arg == "-G" || arg == "--glob" { i+=1; continue; }
+        if arg == "--fail-no-files" { i+=1; continue; }
+        if arg == "--dry-run" { i+=1; continue; }
+        if arg == "-i" || arg == "--invert" { actions.invert = true; i+=1; continue; }
+        if arg == "-L" || arg == "--literal-string" { literal = true; i+=1; continue; }
+        if arg == "--fail-any" { actions.fail_any = true; i+=1; continue; }
+        if arg == "--fail-none" { actions.fail_none = true; i+=1; continue; }
+        if arg == "-j" || arg == "--join-language-scopes" { i+=1; continue; }
+        if arg == "-H" || arg == "--hidden" { i+=1; continue; }
+        if arg == "--gitignored" { i+=1; continue; }
+        if arg == "--sorted" { i+=1; continue; }
+        if arg == "--stdin-detection" { i+=1; continue; }
+        if arg == "--stdout-detection" { i+=1; continue; }
+        if arg == "-v" || arg == "--verbose" { i+=1; continue; }
+        // language scopes (take a value) -> search mode
+        if is_lang_scope(&arg) {
+            lang_scope = true;
+            i += 1; // the flag
+            // consume its value
+            if i < args.len() && !args[i].starts_with("--") { i += 1; }
+            continue;
+        }
+        // --threads takes a value
+        if arg == "--threads" {
+            i += 1;
+            if i < args.len() { i += 1; }
+            continue;
+        }
+        // any other -- option: if it's a known no-arg, skip; else treat unknown leniently
+        if arg.starts_with("--") {
+            i += 1;
+            continue;
+        }
+        // positional: SCOPE (first) then REPLACEMENT (if replacement given via --)
+        if scope.is_none() {
+            scope = Some(arg.clone());
+        } else {
+            // second positional = replacement
+            replacement = Some(arg.clone());
+        }
+        i += 1;
+    }
+
+    // help handling
+    if let Some(full) = help_mode {
+        let out = io::stdout();
+        let mut w = out.lock();
+        let _ = w.write_all(if full { HELP.as_bytes() } else { HHELP.as_bytes() });
+        let _ = w.flush();
+        return 0;
+    }
+
+    // conflict detection
+    if let Some(err) = detect_conflict(&actions, replacement.is_some()) {
+        let mut e = io::stderr();
+        let _ = e.write_all(err.as_bytes());
+        let _ = e.write_all(b"\n");
+        let _ = e.flush();
+        return 2;
+    }
+
+    let scope = scope.unwrap_or_else(|| ".*".to_string());
+    let has_replacement = replacement.is_some();
+    let has_actions = actions.upper || actions.lower || actions.titlecase || actions.normalize
+        || actions.german || actions.german_naive || actions.symbols || actions.delete || actions.squeeze || actions.fail_any || actions.fail_none
+        || has_replacement;
+
+    // compile scope
+    let scope_pattern = if literal {
+        None // literal handled in files
+    } else {
+        match regex::compile(&scope) {
+            Ok(p) => Some(p),
+            Err(e) => {
+                let mut e2 = io::stderr();
+                let _ = writeln!(e2, "Error: Failed building regex");
+                let _ = writeln!(e2, "");
+                let _ = writeln!(e2, "Caused by:");
+                let _ = writeln!(e2, "    {}", e);
+                let _ = e2.flush();
+                return 1;
+            }
+        }
+    };
+
+    crate::files::process(&scope, replacement.as_ref(), &actions, literal, lang_scope, scope_pattern, has_actions);
+    0
+}
