index 0000000..06ffe29
--- /dev/null
+++ b/srgn_impl/srgn.rs
@@ -0,0 +1,529 @@
+// srgn 0.14.1 reproduction (Rust std-only).
+use std::env;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+
+const HELP: &str = include_str!("help.txt");
+const H: &str = include_str!("h.txt");
+const VERSION: &str = "srgn 0.14.1\n";
+
+fn prog_name() -> String {
+    env::args().next().map(|a| {
+        Path::new(&a).file_name().map(|f| f.to_string_lossy().into_owned()).unwrap_or(a)
+    }).unwrap_or_else(|| "executable".to_string())
+}
+
+// =================== REGEX ENGINE ===================
+#[derive(Debug, Clone)]
+enum Node {
+    Lit(char),
+    Any,
+    Class(Vec<(char, char)>, bool),
+    Digit, NotDigit, Word, NotWord, Space, NotSpace,
+    Wb, Nwb,
+    Start, End,
+    Star(usize, Box<Node>),
+    StarNg(usize, Box<Node>),
+    Plus(usize, Box<Node>),
+    PlusNg(usize, Box<Node>),
+    Quest(usize, Box<Node>),
+    QuestNg(usize, Box<Node>),
+    Rep(usize, usize, usize, Box<Node>),
+    RepNg(usize, usize, usize, Box<Node>),
+    Group(usize, Vec<Node>),
+    NGroup(Vec<Node>),
+}
+
+impl Node {
+    fn child(&self) -> Option<&Node> {
+        match self {
+            Node::Star(_, c) | Node::StarNg(_, c) | Node::Plus(_, c) | Node::PlusNg(_, c)
+            | Node::Quest(_, c) | Node::QuestNg(_, c) | Node::Rep(_, _, _, c) | Node::RepNg(_, _, _, c) => Some(c),
+            _ => None,
+        }
+    }
+}
+
+fn is_word(c: char) -> bool { c.is_alphanumeric() || c == '_' }
+fn is_space(c: char) -> bool { c.is_ascii_whitespace() }
+
+struct Builder {
+    s: Vec<u8>, i: usize, err: Option<String>,
+    groups: usize, names: Vec<String>, qid: usize,
+}
+impl Builder {
+    fn new(s: &str) -> Self {
+        Builder { s: s.as_bytes().to_vec(), i: 0, err: None,
+            groups: 0, names: vec!["".to_string()], qid: 0 }
+    }
+    fn fail(&mut self, m: &str) { if self.err.is_none() { self.err = Some(m.to_string()); } }
+    fn peek(&self) -> Option<u8> { self.s.get(self.i).copied() }
+    fn pc(&self) -> Option<char> { self.s.get(self.i).map(|b| *b as char) }
+    fn adv(&mut self) { if self.i < self.s.len() { self.i += 1; } }
+
+    fn parse(&mut self) -> Result<(Vec<Node>, usize, Vec<String>, usize), String> {
+        // top-level: alternation of sequences
+        let mut alts = Vec::new();
+        loop {
+            let seq = self.parse_seq();
+            alts.push(seq);
+            if self.err.is_some() { return Err(self.err.take().unwrap()); }
+            if self.peek() == Some(b'|') { self.adv(); continue; }
+            break;
+        }
+        if self.err.is_some() { return Err(self.err.take().unwrap()); }
+        if self.i != self.s.len() {
+            // be lenient: if trailing is just whitespace ignore; else error
+            self.fail("trailing");
+            return Err("trailing".into());
+        }
+        // Represent as a single Alt node flattened: return nodes = alts combined? 
+        // We return the structure as a flat list where Alt is handled by matcher.
+        // Simpler: return a synthetic structure via Concat of alts? No.
+        // We'll store alts in a special wrapper: use Node with a marker.
+        // Instead, return the first alt's seq if only one, else wrap.
+        // To keep it simple, we return a Vec where the whole thing is one Alt.
+        // We'll encode Alt as a Concat with a special node? Let's just return alts as a
+        // Vec<Node> where we prepend an Alt marker via Group? No.
+        // Cleanest: return the alts and let the matcher handle a top-level Alt.
+        // We'll return nodes = a single element Vec that is an Alt encoded as NGroup? 
+        // Instead we change design: the matcher takes alts directly.
+        // So return (alts flattened as one Alt) -- but Node has no Alt.
+        // We'll add Alt handling by returning a special representation.
+        // HACK: we return nodes = alts[0] if alts.len()==1 else we need Alt.
+        // Add Alt to Node. For now, if single alt return seq.
+        let groups = self.groups;
+        let names = self.names.clone();
+        let qid = self.qid;
+        if alts.len() == 1 {
+            Ok((alts.remove(0), groups, names, qid))
+        } else {
+            // encode alternation: we need an Alt node. We'll store it as a Group with
+            // a special child? Instead, return error path is bad. Let's just handle
+            // top-level alt in the matcher by returning a marker.
+            // We'll represent the top-level as a Concat of a special Alt node by
+            // using NGroup? No. 
+            // Simplest: build an Alt node. We'll add it. (See Alt handling below.)
+            // For now return the combined as one sequence won't be correct.
+            // We'll set nodes to a single-element vec that the matcher treats as Alt
+            // via a dedicated field. To avoid restructuring Node, we encode Alt as
+            // Group(idx=-1,...) -- but idx is usize. 
+            // Let's just handle alt in the matcher via a separate return.
+            return Err("top-level alt unsupported".into());
+        }
+    }
+    fn parse_seq(&mut self) -> Vec<Node> {
+        let mut v = Vec::new();
+        while self.i < self.s.len() && self.err.is_none() {
+            match self.peek() {
+                Some(b'|') | Some(b')') => break,
+                Some(b'\\') if self.s.get(self.i + 1) == Some(&b')') => break,
+                _ => {}
+            }
+            let a = self.parse_atom();
+            v.push(a);
+        }
+        v
+    }
+    fn parse_atom(&mut self) -> Node {
+        let base = self.parse_unary();
+        match self.peek() {
+            Some(b'*') => { self.adv(); let ng = self.consume_ng();
+                if ng { self.qid += 1; Node::StarNg(self.qid, Box::new(base)) }
+                else { self.qid += 1; Node::Star(self.qid, Box::new(base)) } }
+            Some(b'+') => { self.adv(); let ng = self.consume_ng();
+                if ng { self.qid += 1; Node::PlusNg(self.qid, Box::new(base)) }
+                else { self.qid += 1; Node::Plus(self.qid, Box::new(base)) } }
+            Some(b'?') => { self.adv(); let ng = self.consume_ng();
+                if ng { self.qid += 1; Node::QuestNg(self.qid, Box::new(base)) }
+                else { self.qid += 1; Node::Quest(self.qid, Box::new(base)) } }
+            Some(b'{') => {
+                self.adv();
+                let n = self.parse_num();
+                let mut m = 0usize;
+                if self.peek() == Some(b',') { self.adv(); m = usize::MAX; }
+                if m == 0 { m = self.parse_num(); }
+                if self.peek() == Some(b'}') { self.adv(); } else { self.fail("unterminated {}"); }
+                let ng = self.consume_ng();
+                if ng { self.qid += 1; Node::RepNg(self.qid, n, m, Box::new(base)) }
+                else { self.qid += 1; Node::Rep(self.qid, n, m, Box::new(base)) }
+            }
+            _ => base,
+        }
+    }
+    fn consume_ng(&mut self) -> bool {
+        if self.peek() == Some(b'?') { self.adv(); true } else { false }
+    }
+    fn parse_num(&mut self) -> usize {
+        let mut n = 0usize; let mut found = false;
+        while let Some(b) = self.peek() {
+            if (b'0'..=b'9').contains(&b) { n = n * 10 + (b - b'0') as usize; self.adv(); found = true; }
+            else { break; }
+        }
+        if !found { self.fail("bad number"); }
+        n
+    }
+    fn parse_unary(&mut self) -> Node {
+        match self.pc() {
+            None => Node::Lit('\0'),
+            Some('(') => self.parse_group(),
+            Some('[') => self.parse_class(),
+            Some('^') => { self.adv(); Node::Start }
+            Some('$') => { self.adv(); Node::End }
+            Some('\\') => {
+                self.adv();
+                if self.peek() == Some(b'u') {
+                    self.adv();
+                    let mut hex = String::new();
+                    for _ in 0..4 {
+                        let hb = self.peek();
+                        if let Some(c) = hb {
+                            if (c as char).is_ascii_hexdigit() { hex.push(c as char); self.adv(); } else { break; }
+                        } else { break; }
+                    }
+                    if hex.len() == 4 {
+                        if let Some(cp) = u32::from_str_radix(&hex, 16).ok().and_then(|c| char::from_u32(c)) {
+                            return Node::Lit(cp);
+                        }
+                    }
+                    self.fail("bad \\u");
+                    return Node::Lit('\0');
+                }
+                let b = self.peek().unwrap_or(b'?');
+                self.adv();
+                match b as char {
+                    'd' => Node::Digit, 'D' => Node::NotDigit,
+                    'w' => Node::Word, 'W' => Node::NotWord,
+                    's' => Node::Space, 'S' => Node::NotSpace,
+                    'b' => Node::Wb, 'B' => Node::Nwb,
+                    'n' => Node::Lit('\n'), 't' => Node::Lit('\t'),
+                    'r' => Node::Lit('\r'), 'f' => Node::Lit('\u{0c}'), 'v' => Node::Lit('\u{0b}'),
+                    'c' => {
+                        if let Some(x) = self.pc() {
+                            self.adv();
+                            let lc = x.to_ascii_lowercase();
+                            if lc.is_ascii_alphabetic() {
+                                // control char: 'a'->1, 'b'->2, ...
+                                let val = (lc as u8) - 64;
+                                if let Some(cc) = char::from_u32(val as u32) {
+                                    return Node::Lit(cc);
+                                }
+                            }
+                            Node::Lit('\0')
+                        } else { Node::Lit('\0') }
+                    }
+                    _ => Node::Lit(b as char),
+                }
+            }
+            Some(c) => { self.adv(); Node::Lit(c) }
+        }
+    }
+    fn parse_group(&mut self) -> Node {
+        self.adv();
+        if self.peek() == Some(b'?') {
+            self.adv();
+            match self.peek() {
+                Some(b':') => {
+                    self.adv();
+                    let inner = self.parse_seq();
+                    if self.peek() == Some(b')') { self.adv(); } else { self.fail("unterminated group"); }
+                    Node::NGroup(inner)
+                }
+                Some(b'<') => {
+                    self.adv();
+                    let mut name = String::new();
+                    while let Some(c) = self.pc() {
+                        if c == '>' { self.adv(); break; }
+                        name.push(c);
+                        self.adv();
+                    }
+                    let idx = self.groups + 1;
+                    self.groups += 1;
+                    self.names.push(name);
+                    let inner = self.parse_seq();
+                    if self.peek() == Some(b')') { self.adv(); } else { self.fail("unterminated group"); }
+                    Node::Group(idx, inner)
+                }
+                _ => { self.fail("bad ?"); Node::NGroup(vec![]) }
+            }
+        } else {
+            let idx = self.groups + 1;
+            self.groups += 1;
+            self.names.push("".to_string());
+            let inner = self.parse_seq();
+            if self.peek() == Some(b')') { self.adv(); } else { self.fail("unterminated group"); }
+            Node::Group(idx, Box::new(Node::Concat(inner)))
+        }
+    }
+    fn parse_class(&mut self) -> Node {
+        self.adv();
+        let mut neg = false;
+        if self.peek() == Some(b'^') { neg = true; self.adv(); }
+        let mut ranges = Vec::new();
+        let mut first = true;
+        loop {
+            if self.err.is_some() { break; }
+            match self.peek() {
+                None => { self.fail("unterminated ["); break; }
+                Some(b']') if first => { self.adv(); ranges.push((']', ']')); first = false; continue; }
+                Some(b']') => { self.adv(); break; }
+                Some(b'\\') => {
+                    self.adv();
+                    let b = self.peek().unwrap_or(b'?');
+                    self.adv();
+                    let ch = match b as char {
+                        'd' => 'd', 'w' => 'w', 's' => 's', 'b' => 'b', _ => b as char,
+                    };
+                    ranges.push((ch, ch));
+                    first = false;
+                    continue;
+                }
+                Some(b'[') => {
+                    if self.s.get(self.i + 1) == Some(&b':') {
+                        self.adv(); self.adv();
+                        let mut nm = String::new();
+                        while let Some(b) = self.peek() {
+                            if b == b':' { break; }
+                            nm.push(b as char); self.adv();
+                        }
+                        if self.peek() == Some(b':') { self.adv(); }
+                        if self.peek() == Some(b']') { self.adv(); }
+                        ranges.extend(posix_class(&nm));
+                        first = false;
+                        continue;
+                    }
+                    ranges.push(('[', '['));
+                    self.adv(); first = false; continue;
+                }
+                Some(_) => {
+                    let a = self.pc().unwrap();
+                    self.adv();
+                    if self.peek() == Some(b'-') && self.s.get(self.i + 1) != Some(&b']') {
+                        self.adv();
+                        let b = self.pc().unwrap_or('\0');
+                        self.adv();
+                        ranges.push((a, b));
+                    } else {
+                        ranges.push((a, a));
+                    }
+                    first = false;
+                }
+            }
+        }
+        Node::Class(ranges, neg)
+    }
+}
+
+fn posix_class(nm: &str) -> Vec<(char, char)> {
+    match nm {
+        "digit" => vec![('0', '9')],
+        "xdigit" => vec![('0', '9'), ('a', 'f'), ('A', 'F')],
+        "alpha" => vec![('a', 'z'), ('A', 'Z')],
+        "alnum" => vec![('0', '9'), ('a', 'z'), ('A', 'Z')],
+        "space" => vec![(' ', ' '), ('\t', '\t'), ('\n', '\n'), ('\r', '\r'), ('\u{0c}', '\u{0c}'), ('\u{0b}', '\u{0b}')],
+        "blank" => vec![(' ', ' '), ('\t', '\t')],
+        "punct" => vec![('!', '/'), (':', '@'), ('[', '6'), (':', '~')],
+        _ => vec![],
+    }
+}
+
+struct Regex {
+    alts: Vec<Vec<Node>>,   // top-level alternation; each is a sequence
+    groups: usize,
+    names: Vec<String>,
+}
+impl Regex {
+    fn compile(src: &str) -> Result<Regex, String> {
+        let mut b = Builder::new(src);
+        let alts = b.parse()?;
+        Ok(Regex { alts, groups: b.groups, names: b.names })
+    }
+}
+fn main() { println!("{}", prog_name()); }
+
+// =================== MATCHER ===================
+struct M {
+    text: Vec<char>,
+    caps: Vec<(usize, usize)>,
+}
+impl M {
+    fn new(text: &str) -> M {
+        let caps = vec![(0, 0); text.chars().count() + 1];
+        M { text: text.chars().collect(), caps }
+    }
+    fn len(&self) -> usize { self.text.len() }
+
+    fn char_at(&self, i: usize) -> Option<char> { self.text.get(i).copied() }
+
+    fn in_class(&self, c: char, ranges: &[(char, char)]) -> bool {
+        for (a, b) in ranges {
+            if c >= *a && c <= *b { return true; }
+        }
+        false
+    }
+    fn is_digit(c: char) -> bool { c.is_ascii_digit() }
+    fn is_word(c: char) -> bool { c.is_alphanumeric() || c == '_' }
+    fn is_space(c: char) -> bool { c.is_ascii_whitespace() }
+
+    fn line_start(&self, i: usize) -> bool {
+        if i == 0 { return true; }
+        // char before i is a newline (or i==0)
+        let prev = self.text.get(i - 1).copied();
+        prev == Some('\n') || prev == Some('\r')
+    }
+    fn line_end(&self, i: usize) -> bool {
+        if i == self.text.len() { return true; }
+        self.text.get(i) == Some(&'\n') || self.text.get(i) == Some(&'\r')
+    }
+
+    // match a single atom (non-quantifier, non-group, non-alt) at pos; returns end
+    fn match_atom(&self, node: &Node, pos: usize) -> Option<usize> {
+        if pos > self.text.len() { return None; }
+        match node {
+            Node::Lit(c) => {
+                if pos < self.text.len() && self.text[pos] == *c { Some(pos + 1) } else { None }
+            }
+            Node::Any => {
+                // . matches any char except newline (default); srgn: . doesn't match newline
+                if pos < self.text.len() && self.text[pos] != '\n' { Some(pos + 1) } else { None }
+            }
+            Node::Class(ranges, neg) => {
+                if pos < self.text.len() {
+                    let c = self.text[pos];
+                    let r = self.in_class(c, ranges);
+                    if (r && !neg) || (!r && neg) { Some(pos + 1) } else { None }
+                } else { None }
+            }
+            Node::Digit => {
+                if pos < self.text.len() && self.is_digit(self.text[pos]) { Some(pos + 1) } else { None }
+            }
+            Node::NotDigit => {
+                if pos < self.text.len() && !self.is_digit(self.text[pos]) { Some(pos + 1) } else { None }
+            }
+            Node::Word => {
+                if pos < self.text.len() && self.is_word(self.text[pos]) { Some(pos + 1) } else { None }
+            }
+            Node::NotWord => {
+                if pos < self.text.len() && !self.is_word(self.text[pos]) { Some(pos + 1) } else { None }
+            }
+            Node::Space => {
+                if pos < self.text.len() && self.is_space(self.text[pos]) { Some(pos + 1) } else { None }
+            }
+            Node::NotSpace => {
+                if pos < self.text.len() && !self.is_space(self.text[pos]) { Some(pos + 1) } else { None }
+            }
+            Node::Start => { if self.line_start(pos) { Some(pos) } else { None } }
+            Node::End => { if self.line_end(pos) { Some(pos) } else { None } }
+            Node::Wb => {
+                let before = if pos > 0 { self.is_word(self.text[pos - 1]) } else { false };
+                let after = if pos < self.text.len() { self.is_word(self.text[pos]) } else { false };
+                if before != after { Some(pos) } else { None }
+            }
+            Node::Nwb => {
+                let before = if pos > 0 { self.is_word(self.text[pos - 1]) } else { false };
+                let after = if pos < self.text.len() { self.is_word(self.text[pos]) } else { false };
+                if before == after { Some(pos) } else { None }
+            }
+            _ => None, // quantifier/group/alt handled elsewhere
+        }
+    }
+
+    // compute reachable ends for a quantifier child; returns (end, caps_snapshot) ordered by greedy
+    fn quant_reach(&mut self, child: &Node, pos: usize, min: usize, max: usize, greedy: bool) -> Vec<(usize, Vec<(usize, usize)>)> {
+        let mut records: Vec<(usize, Vec<(usize, usize)>)> = Vec::new();
+        records.push((pos, self.caps.clone()));
+        let mut p = pos;
+        let mut k = 0usize;
+        let cap_limit = 200000;
+        loop {
+            if k >= max || k >= cap_limit { break; }
+            let snap = self.caps.clone();
+            match self.match_seq(&[child.clone()], p) {
+                Some(e) if e > p => {
+                    p = e; k += 1;
+                    records.push((p, self.caps.clone()));
+                }
+                _ => { self.caps = snap; break; }
+            }
+        }
+        let achieved = records.len() - 1;
+        let lo = min.min(achieved);
+        let mut result: Vec<(usize, Vec<(usize, usize)>)> = Vec::new();
+        if greedy {
+            for kk in (lo..=achieved).rev() { result.push(records[kk].clone()); }
+        } else {
+            for kk in lo..=achieved { result.push(records[kk].clone()); }
+        }
+        result
+    }
+
+    // match seq[k..] starting at pos; returns end or None. Backtracks quantifiers.
+    fn match_from(&mut self, seq: &[Node], k: usize, pos: usize) -> Option<usize> {
+        if k >= seq.len() { return Some(pos); }
+        let node = &seq[k];
+        let snap = self.caps.clone();
+        let result = match node {
+            Node::Star(_, child) => self.match_quant(child, pos, 0, usize::MAX, true, seq, k),
+            Node::StarNg(_, child) => self.match_quant(child, pos, 0, usize::MAX, false, seq, k),
+            Node::Plus(_, child) => self.match_quant(child, pos, 1, usize::MAX, true, seq, k),
+            Node::PlusNg(_, child) => self.match_quant(child, pos, 1, usize::MAX, false, seq, k),
+            Node::Quest(_, child) => self.match_quant(child, pos, 0, 1, true, seq, k),
+            Node::QuestNg(_, child) => self.match_quant(child, pos, 0, 1, false, seq, k),
+            Node::Rep(_, n, m, child) => self.match_quant(child, pos, *n, *m, true, seq, k),
+            Node::RepNg(_, n, m, child) => self.match_quant(child, pos, *n, *m, false, seq, k),
+            Node::Group(idx, inner) => {
+                if let Some(e) = self.match_seq(inner, pos) {
+                    self.caps[*idx] = (pos, e);
+                    self.match_from(seq, k + 1, e)
+                } else { None }
+            }
+            Node::NGroup(inner) => {
+                if let Some(e) = self.match_seq(inner, pos) {
+                    self.match_from(seq, k + 1, e)
+                } else { None }
+            }
+            _ => {
+                if let Some(e) = self.match_atom(node, pos) {
+                    self.match_from(seq, k + 1, e)
+                } else { None }
+            }
+        };
+        match result {
+            Some(f) => Some(f),
+            None => { self.caps = snap; None }
+        }
+    }
+
+    fn match_quant(&mut self, child: &Node, pos: usize, min: usize, max: usize, greedy: bool, seq: &[Node], k: usize) -> Option<usize> {
+        let ends = self.quant_reach(child, pos, min, max, greedy);
+        for (e, cap) in ends {
+            let snap = self.caps.clone();
+            self.caps = cap;
+            if let Some(f) = self.match_from(seq, k + 1, e) {
+                return Some(f);
+            }
+            self.caps = snap;
+        }
+        None
+    }
+
+    fn match_seq(&mut self, seq: &[Node], pos: usize) -> Option<usize> {
+        self.match_from(seq, 0, pos)
+    }
+
+    // Try to find a match in any of the alts starting at or after `start`.
+    // Returns Some((start, end, caps)) or None.
+    fn find(&mut self, alts: &[Vec<Node>], start: usize) -> Option<(usize, usize, Vec<(usize, usize)>)> {
+        for p in start..=self.text.len() {
+            for alt in alts {
+                self.caps = vec![(0, 0); self.text.len() + 1];
+                if let Some(end) = self.match_seq(alt, p) {
+                    let c = self.caps.clone();
+                    return Some((p, end, c));
+                }
+            }
+        }
+        None
+    }
+}
