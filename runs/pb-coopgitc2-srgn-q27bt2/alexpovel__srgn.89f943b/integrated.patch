++        search_mode(&input, scope);
++        return;
++    }
++
++    // no actions
++    if !has_actions {
++        crate::warn_no_actions();
++        let mut out = io::stdout();
++        let _ = out.write_all(input.as_bytes());
++        let _ = out.flush();
++        return;
++    }
++
++    // build transformed output (work in chars to handle Unicode safely)
++    let chars: Vec<char> = input.chars().collect();
++    let names: Vec<Option<String>> = scope_pattern.as_ref().map(|p| p.names.clone()).unwrap_or_default();
