diff --git a/src/files.rs b/src/files.rs
new file mode 100644
index 0000000..f5545aa
--- /dev/null
+++ b/src/files.rs
@@ -0,0 +1,177 @@
+use std::io::{self, Read, Write};
+use std::path::Path;
+use crate::regex;
+use crate::actions::Actions;
+
+pub fn process(
+    scope: &str,
+    replacement: Option<&String>,
+    actions: &Actions,
+    literal: bool,
+    lang_scope: bool,
+    scope_pattern: Option<regex::Pattern>,
+    has_actions: bool,
+) {
+    // read input from stdin
+    let mut input = String::new();
+    let mut buf = io::stdin();
+    let mut bytes = Vec::new();
+    let _ = buf.read_to_end(&mut bytes);
+    input = String::from_utf8_lossy(&bytes).to_string();
+
+    // search mode
+    if lang_scope {
+        search_mode(&input, scope);
+        return;
+    }
+
+    // no actions
+    if !has_actions {
+        crate::warn_no_actions();
+        let mut out = io::stdout();
+        let _ = out.write_all(input.as_bytes());
+        let _ = out.flush();
+        return;
+    }
+
+    // build transformed output (work in chars to handle Unicode safely)
+    let chars: Vec<char> = input.chars().collect();
+    let names: Vec<Option<String>> = scope_pattern.as_ref().map(|p| p.names.clone()).unwrap_or_default();
+
+    let matches = if literal {
+        literal_find_all(scope, &input)
+    } else {
+        match &scope_pattern {
+            Some(p) => regex::find_all(p, &chars),
+            None => vec![],
+        }
+    };
+    let found = !matches.is_empty();
+
+    let mut result: Vec<char> = Vec::with_capacity(chars.len());
+    let mut last = 0;
+    // for squeeze: track the text of the last OUTPUT match to collapse adjacent identical runs
+    let mut prev_squeezed: Option<String> = None;
+    for m in &matches {
+        let st = m.0;
+        let en = m.1;
+        let matched: String = chars[st..en].iter().collect();
+        // squeeze: if identical to and adjacent to the last OUTPUT match, collapse it (skip)
+        if actions.squeeze {
+            if let Some(ref pv) = prev_squeezed {
+                if pv == &matched && st == last {
+                    last = en;
+                    continue;
+                }
+            }
+        }
+        if st > last {
+            result.extend_from_slice(&chars[last..st]);
+        }
+        let t = actions.transform(&matched, replacement.map(|s| s.as_str()), &m.2, &names, st);
+        result.extend(t.chars());
+        last = en;
+        if actions.squeeze {
+            prev_squeezed = Some(matched);
+        }
+    }
+    if last < chars.len() {
+        result.extend_from_slice(&chars[last..]);
+    }
+
+    let result_str: String = result.iter().collect();
+    let mut out = io::stdout();
+    let _ = out.write_all(result_str.as_bytes());
+    let _ = out.flush();
+    if actions.fail_any && found { std::process::exit(1); }
+    if actions.fail_none && !found { std::process::exit(1); }
+}
+
+fn literal_find_all(scope: &str, input: &str) -> Vec<(usize, usize, regex::Captures)> {
+    if scope.is_empty() { return vec![]; }
+    let mut result = vec![];
+    let mut pos = 0;
+    let chars: Vec<char> = input.chars().collect();
+    let scope_chars: Vec<char> = scope.chars().collect();
+    while pos + scope_chars.len() <= chars.len() {
+        let rest = &chars[pos..];
+        let mut found_at = None;
+        for i in 0..rest.len() {
+            let mut ok = true;
+            for (k, sc) in scope_chars.iter().enumerate() {
+                if i + k >= rest.len() || rest[i + k] != *sc { ok = false; break; }
+            }
+            if ok { found_at = Some(i); break; }
+        }
+        if let Some(fa) = found_at {
+            let start = pos + fa;
+            let end = start + scope_chars.len();
+            let caps = regex::Captures::new(0);
+            result.push((start, end, caps));
+            pos = end;
+        } else {
+            break;
+        }
+    }
+    result
+}
+
+fn squeeze_matches(
+    matches: &[(usize, usize, regex::Captures)],
+    chars: &[char],
+    _actions: &Actions,
+    _replacement: Option<&String>,
+) -> Vec<(usize, usize, regex::Captures)> {
+    // keep only the first of consecutive identical matches
+    let mut out: Vec<(usize, usize, regex::Captures)> = vec![];
+    for m in matches {
+        let mstart: usize = m.0;
+        let mend: usize = m.1;
+        let matched: String = chars[mstart..mend].iter().collect();
+        if let Some(prev) = out.last() {
+            let pm: String = chars[prev.0..prev.1].iter().collect();
+            if pm == matched && prev.1 == mstart {
+                continue;
+            }
+        }
+        out.push(m.clone());
+    }
+    out
+}
+
+fn search_mode(input: &str, scope: &str) {
+    // approximate: for each line that matches scope, report (stdin):LINE:0-{len}:LINE
+    let mut out = io::stdout();
+    let pat = match regex::compile(scope) {
+        Ok(p) => p,
+        Err(e) => {
+            let mut e2 = io::stderr();
+            let _ = writeln!(e2, "Error: Failed building regex");
+            let _ = writeln!(e2, "");
+            let _ = writeln!(e2, "Caused by:");
+            let _ = writeln!(e2, "    {}", e);
+            let _ = e2.flush();
+            std::process::exit(1);
+        }
+    };
+    let mut any = false;
+    let mut line_no = 1usize;
+    for line in input.split_inclusive('\n') {
+        let trimmed = line.strip_suffix('\n').unwrap_or(line);
+        let chars: Vec<char> = trimmed.chars().collect();
+        if regex::find_all(&pat, &chars).iter().any(|m| m.1 > m.0) {
+            let end = trimmed.chars().count();
+            let _ = io::stdout();
+            let _ = writeln!(out, "(stdin):{}:{}-{}:{}", line_no, 0, end, line.trim_end_matches('\n'));
+            any = true;
+        }
+        line_no += 1;
+    }
+    let _ = out.flush();
+    let _ = any;
+    if !any {
+        std::process::exit(2);
+    }
+}
+
+pub fn _unused(p: &Path) {}
