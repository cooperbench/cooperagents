++    let scope_chars: Vec<char> = scope.chars().collect();
++    while pos + scope_chars.len() <= chars.len() {
++        let rest = &chars[pos..];
++        let mut found_at = None;
++        for i in 0..rest.len() {
++            let mut ok = true;
++            for (k, sc) in scope_chars.iter().enumerate() {
++                if i + k >= rest.len() || rest[i + k] != *sc { ok = false; break; }
++            }
++            if ok { found_at = Some(i); break; }
++        }
++        if let Some(fa) = found_at {
++            let start = pos + fa;
++            let end = start + scope_chars.len();
++            let caps = regex::Captures::new(0);
