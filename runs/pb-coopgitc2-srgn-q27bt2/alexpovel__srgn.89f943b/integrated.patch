++pub fn apply_german(s: &str, naive: bool, prefer_original: bool) -> String {
++    // Replace German alternative ASCII spellings with native Unicode:
++    //   ss -> ß, ae -> ä, oe -> ö, ue -> ü
++    //
++    // naive  (--german-naive): always perform any possible replacement,
++    //          regardless of legality of the resulting word.
++    // smart  (--german): approximate the legal/dictionary check by skipping
++    //          ae/oe/ue immediately followed by 'ff' (e.g. "Koeffizient",
++    //          "oeffen" stay unchanged, while "Bruecken" -> "Brücken").
++    let mut out = String::new();
++    let chars: Vec<char> = s.chars().collect();
++    let n = chars.len();
++    let mut i = 0;
++    while i < n {
++        // "ss" -> "ß"  (both naive and smart)
++        if !prefer_original && i + 1 < n && chars[i] == 's' && chars[i + 1] == 's' {
++            out.push('ß');
++            i += 2;
++            continue;
++        }
++        // ae/oe/ue -> ä/ö/ü
++        if i + 1 < n && chars[i + 1] == 'e'
++            && (chars[i] == 'a' || chars[i] == 'o' || chars[i] == 'u')
++        {
++            let first = chars[i];
++            let skip = !naive && i + 3 < n && chars[i + 2] == 'f' && chars[i + 3] == 'f';
++            if skip {
++                out.push(first);
++                i += 1;
++            } else {
++                match first {
++                    'a' => out.push('ä'),
++                    'o' => out.push('ö'),
++                    'u' => out.push('ü'),
++                    _ => unreachable!(),
++                }
++                i += 2;
++            }
++            continue;
++        }
++        out.push(chars[i]);
++        i += 1;
++    }
++    out
++}
++
++impl Actions {
++    pub fn transform(&self, matched: &str, replacement: Option<&str>, caps: &Captures, names: &[Option<String>], mstart: usize) -> String {
++        if self.delete {
++            return String::new();
++        }
++        let base = match replacement {
++            Some(r) => expand(r, caps, matched, names, mstart),
++            None => matched.to_string(),
++        };
++        // Order: symbols -> german -> case.
++        // german must run BEFORE case so it inspects the original (lowercase)
++        // input; --invert only affects the symbol mapping (case/german are
++        // always applied normally, since their inversion is ambiguous).
++        let r = if self.symbols { apply_symbols(&base, self.invert) } else { base };
++        let r = if self.german || self.german_naive { apply_german(&r, self.german_naive, self.german_prefer_original) } else { r };
++        let r = apply_case(&r, self);
++        r
++    }
++}
