new file mode 100644
index 0000000..367c7d6
--- /dev/null
+++ b/srgn_impl/main.rs
@@ -0,0 +1,470 @@
+use std::env;
+use std::io::{self, Read, Write};
+
+// ============================================================
+// Regex engine (byte-offset aware)
+// ============================================================
+#[derive(Debug, Clone)]
+enum Node {
+    Lit(char),
+    Any,
+    Class(Vec<(char, char)>, bool),
+    Digit, NotDigit, Word, NotWord, Space, NotSpace,
+    Wb, Nwb,
+    Start, End,
+    Star(Box<Node>),
+    StarNg(Box<Node>),
+    Plus(Box<Node>),
+    PlusNg(Box<Node>),
+    Quest(Box<Node>),
+    QuestNg(Box<Node>),
+    Rep(usize, usize, Box<Node>),
+    RepNg(usize, usize, Box<Node>),
+    Group(usize, Vec<Node>),
+    NGroup(Vec<Node>),
+}
+
+struct Builder {
+    s: Vec<u8>,
+    i: usize,
+    err: Option<String>,
+    groups: usize,
+    names: Vec<String>,
+    at_seq_start: bool,
+}
+impl Builder {
+    fn new(src: &str) -> Builder {
+        Builder { s: src.bytes().collect(), i: 0, err: None, groups: 0, names: vec![], at_seq_start: true }
+    }
+    fn peek(&self) -> Option<u8> { self.s.get(self.i).copied() }
+    fn adv(&mut self) { if self.i < self.s.len() { self.i += 1; } }
+    fn fail(&mut self, m: &str) { if self.err.is_none() { self.err = Some(m.to_string()); } }
+    fn q(&self) -> char { self.s.get(self.i).copied().unwrap_or(0) as char }
+
+    fn parse(&mut self) -> Result<Vec<Vec<Node>>, String> {
+        let mut alts = Vec::new();
+        loop {
+            let seq = self.parse_seq();
+            alts.push(seq);
+            if self.err.is_some() { return Err(self.err.take().unwrap()); }
+            if self.peek() == Some(b'|') { self.adv(); continue; }
+            break;
+        }
+        if self.err.is_some() { return Err(self.err.take().unwrap()); }
+        if self.i != self.s.len() {
+            self.fail("trailing");
+            return Err("trailing characters".into());
+        }
+        Ok(alts)
+    }
+
+    fn parse_seq(&mut self) -> Vec<Node> {
+        self.at_seq_start = true;
+        let mut v = Vec::new();
+        while self.i < self.s.len() && self.err.is_none() {
+            match self.peek() {
+                Some(b'|') | Some(b')') => break,
+                _ => {}
+            }
+            if self.at_seq_start {
+                if self.peek() == Some(b'^') { self.adv(); v.push(Node::Start); self.at_seq_start = false; continue; }
+                if self.peek() == Some(b'$') { self.adv(); v.push(Node::End); self.at_seq_start = false; continue; }
+            }
+            if self.peek() == Some(b'$') {
+                let nx = self.s.get(self.i + 1).copied();
+                match nx {
+                    Some(b'|') | Some(b')') | None => { self.adv(); v.push(Node::End); self.at_seq_start = false; continue; }
+                    _ => {}
+                }
+            }
+            let a = self.parse_atom();
+            self.at_seq_start = false;
+            v.push(a);
+        }
+        v
+    }
+    fn parse_atom(&mut self) -> Node {
+        let u = self.parse_unary();
+        match self.peek() {
+            Some(b'*') => { self.adv(); Node::Star(Box::new(u)) }
+            Some(b'+') => { self.adv(); Node::Plus(Box::new(u)) }
+            Some(b'?') => {
+                self.adv();
+                if self.peek() == Some(b'?') {
+                    self.adv(); Node::QuestNg(Box::new(u))
+                } else {
+                    Node::Quest(Box::new(u))
+                }
+            }
+            Some(b'{') => {
+                self.adv();
+                let mut n = 0;
+                while self.peek().map(|b| b.is_ascii_digit()).unwrap_or(false) { n = n*10 + (self.q() as u8 - b'0') as usize; self.adv(); }
+                let mut m: usize;
+                match self.peek() {
+                    Some(b',') => {
+                        self.adv();
+                        if self.peek().map(|b| b.is_ascii_digit()).unwrap_or(false) {
+                            m = 0;
+                            while self.peek().map(|b| b.is_ascii_digit()).unwrap_or(false) { m = m*10 + (self.q() as u8 - b'0') as usize; self.adv(); }
+                        } else { m = usize::MAX; }
+                        if self.peek() != Some(b'}') { self.fail("rep"); }
+                        self.adv();
+                    }
+                    _ => { m = n; if self.peek() != Some(b'}') { self.fail("rep"); } self.adv(); }
+                }
+                if self.peek() == Some(b'?') { self.adv(); Node::RepNg(n, m, Box::new(u)) } else { Node::Rep(n, m, Box::new(u)) }
+            }
+            _ => u,
+        }
+    }
+    fn parse_unary(&mut self) -> Node {
+        if let Some(b) = self.peek() {
+            match b {
+                b'.' => { self.adv(); return Node::Any; }
+                b'\\' => {
+                    self.adv();
+                    match self.peek() {
+                        Some(b'd') => { self.adv(); return Node::Digit; }
+                        Some(b'D') => { self.adv(); return Node::NotDigit; }
+                        Some(b'w') => { self.adv(); return Node::Word; }
+                        Some(b'W') => { self.adv(); return Node::NotWord; }
+                        Some(b's') => { self.adv(); return Node::Space; }
+                        Some(b'S') => { self.adv(); return Node::NotSpace; }
+                        Some(b'b') => { self.adv(); return Node::Wb; }
+                        Some(b'B') => { self.adv(); return Node::Nwb; }
+                        Some(b'^') => { self.adv(); return Node::Start; }
+                        Some(b'$') => { self.adv(); return Node::End; }
+                        _ => {}
+                    }
+                    match self.peek() {
+                        Some(b'n') => { self.adv(); return Node::Lit('\n'); }
+                        Some(b't') => { self.adv(); return Node::Lit('\t'); }
+                        Some(b'r') => { self.adv(); return Node::Lit('\r'); }
+                        Some(b'f') => { self.adv(); return Node::Lit('\u{0c}'); }
+                        Some(b'v') => { self.adv(); return Node::Lit('\u{0b}'); }
+                        Some(b'0') => { self.adv(); return Node::Lit('\0'); }
+                        Some(b'c') => {
+                            self.adv();
+                            if let Some(x) = self.peek() {
+                                self.adv();
+                                let lc = (x as char).to_ascii_lowercase();
+                                if lc.is_ascii_alphabetic() {
+                                    let val = (lc as u8) - 64;
+                                    if let Some(cc) = char::from_u32(val as u32) { return Node::Lit(cc); }
+                                }
+                            }
+                            return Node::Lit('\0');
+                        }
+                        Some(b) if b.is_ascii_digit() => {
+                            let mut d = (b - b'0') as usize;
+                            self.adv();
+                            while self.peek().map(|c| c.is_ascii_digit()).unwrap_or(false) {
+                                d = d * 10 + (self.q() as u8 - b'0') as usize; self.adv();
+                            }
+                            // octal up to 3 digits
+                            return Node::Lit(char::from_u32(d as u32).unwrap_or('\0'));
+                        }
+                        _ => {
+                            if let Some(x) = self.peek() {
+                                let x = x as char; self.adv();
+                                return Node::Lit(x);
+                            }
+                            return Node::Lit('\0');
+                        }
+                    }
+                }
+                b'[' => { return self.parse_class(); }
+                b'(' => { return self.parse_group(); }
+                b'!' => { self.adv(); return Node::NGroup(vec![]); } // (?:! ...) - rare, ignore content
+                _ => {
+                    let c = self.q() as char; self.adv();
+                    return Node::Lit(c);
+                }
+            }
+        }
+        // end of input
+        self.fail("unexpected end");
+        Node::Lit('\0')
+    }
+    fn parse_class(&mut self) -> Node {
+        // self at '['
+        self.adv();
+        let mut neg = false;
+        if self.peek() == Some(b'^') { self.adv(); neg = true; }
+        let mut ranges: Vec<(char, char)> = Vec::new();
+        let mut first: Option<char> = None;
+        loop {
+            if self.err.is_some() { break; }
+            match self.peek() {
+                Some(b']') if first.is_some() || ranges.len() > 0 || self.s.get(self.i+1).map(|b| *b==b']').unwrap_or(false) => {
+                    // closing
+                    self.adv(); break;
+                }
+                Some(b']') => {
+                    // ']' as literal at start
+                    self.adv();
+                    if let Some(f) = first { ranges.push((f, f)); }
+                    first = Some(']');
+                    continue;
+                }
+                Some(b'-') if first.is_some() && self.s.get(self.i+1).map(|b| *b != b']').unwrap_or(true) => {
+                    self.adv();
+                    let hi = self.q() as char; self.adv();
+                    if let Some(lo) = first { ranges.push((lo, hi)); }
+                    first = None;
+                    continue;
+                }
+                Some(b'-') => {
+                    // lone dash
+                    self.adv();
+                    if let Some(f) = first { ranges.push((f, f)); }
+                    first = Some('-');
+                    continue;
+                }
+                Some(b'\\') => {
+                    self.adv();
+                    // handle \d \w \s inside class
+                    match self.peek() {
+                        Some(b'd') => { self.adv(); ranges.push(('0', '9')); first = None; continue; }
+                        Some(b'D') => { self.adv(); first = None; /* not handled */ continue; }
+                        Some(b'w') => { self.adv(); ranges.push(('a','z')); ranges.push(('A','Z')); ranges.push(('0','9')); ranges.push(('_','_')); first = None; continue; }
+                        Some(b'W') => { self.adv(); first = None; continue; }
+                        Some(b's') => { self.adv(); ranges.push((' ',' ')); first = None; continue; }
+                        Some(b'S') => { self.adv(); first = None; continue; }
+                        _ => {}
+                    }
+                    if let Some(x) = self.peek() {
+                        let x = x as char; self.adv();
+                        if let Some(f) = first { ranges.push((f, f)); }
+                        first = Some(x);
+                    }
+                    continue;
+                }
+                Some(b) => {
+                    let c = b as char; self.adv();
+                    if let Some(f) = first { ranges.push((f, f)); }
+                    first = Some(c);
+                }
+                None => { self.fail("unterminated class"); break; }
+            }
+        }
+        Node::Class(ranges, neg)
+    }
+    fn parse_group(&mut self) -> Node {
+        // self at '('
+        self.adv();
+        let mut idx: Option<usize> = None;
+        // named group
+        if self.peek() == Some(b'?') {
+            self.adv();
+            match self.peek() {
+                Some(b':') => { self.adv(); let inner = self.parse_seq(); self.expect_close(); return Node::NGroup(inner); }
+                Some(b'P') => {
+                    self.adv();
+                    if self.peek() == Some(b'<') {
+                        self.adv();
+                        if self.peek() == Some(b'=') { self.adv(); let inner = self.parse_seq(); self.expect_close(); return Node::NGroup(inner); }
+                        if self.peek() == Some(b'!') { self.adv(); let inner = self.parse_seq(); self.expect_close(); return Node::NGroup(inner); }
+                        // named
+                        let mut name = String::new();
+                        while self.peek().map(|b| b != b')').unwrap_or(false) { name.push(self.q() as char); self.adv(); }
+                        self.groups += 1;
+                        self.names.push(name.clone());
+                        idx = Some(self.groups);
+                    }
+                }
+                _ => {}
+            }
+        }
+        self.groups += 1;
+        let gid = idx.unwrap_or(self.groups);
+        let inner = self.parse_seq();
+        self.expect_close();
+        Node::Group(gid, inner)
+    }
+    fn expect_close(&mut self) {
+        if self.peek() == Some(b')') { self.adv(); } else { self.fail("missing )"); }
+    }
+}
+
+struct Regex {
+    alts: Vec<Vec<Node>>,
+    groups: usize,
+    names: Vec<String>,
+}
+// ============================================================
+// Matcher (byte-offset aware, supports global search)
+// ============================================================
+struct M {
+    bytes: Vec<u8>,
+    text: Vec<char>,
+    char_b: Vec<usize>,
+    caps: Vec<(usize, usize)>,
+}
+impl M {
+    fn new(text: &str) -> M {
+        let mut t = text.chars().collect::<Vec<char>>();
+        let mut cb = Vec::with_capacity(t.len() + 1);
+        let mut off = 0usize;
+        for c in &t { cb.push(off); off += c.len_utf8(); }
+        cb.push(off);
+        let caps = vec![(0, 0); t.len() + 1];
+        M { bytes: text.as_bytes().to_vec(), text: t, char_b: cb, caps }
+    }
+    fn line_start_ok(&self, p: usize, start: usize) -> bool {
+        if p == start { return true; }
+        p == 0 || self.text[p - 1] == '\n'
+    }
+    fn line_end_ok(&self, p: usize) -> bool {
+        p == self.text.len() || self.text[p] == '\n'
+    }
+    fn class_match(&self, p: usize, ranges: &[(char, char)], neg: bool) -> bool {
+        if p >= self.text.len() { return false; }
+        let c = self.text[p];
+        let mut in_ = false;
+        for &(lo, hi) in ranges { if c >= lo && c <= hi { in_ = true; break; } }
+        if neg { !in_ } else { in_ }
+    }
+    fn match_atom(&self, n: &Node, p: usize) -> Option<usize> {
+        if p >= self.text.len() {
+            // zero-width atoms only
+            match n {
+                Node::Start => return if self.line_start_ok(p, 0) { Some(p) } else { None },
+                Node::End => return if self.line_end_ok(p) { Some(p) } else { None },
+                _ => return None,
+            }
+        }
+        let c = self.text[p];
+        match n {
+            Node::Lit(l) => { if *l == c { Some(p + 1) } else { None } }
+            Node::Any => { if c != '\n' { Some(p + 1) } else { None } }
+            Node::Class(r, neg) => { if self.class_match(p, r, *neg) { Some(p + 1) } else { None } }
+            Node::Digit => { if c.is_ascii_digit() { Some(p + 1) } else { None } }
+            Node::NotDigit => { if !c.is_ascii_digit() { Some(p + 1) } else { None } }
+            Node::Word => { if c.is_ascii_alphanumeric() || c == '_' { Some(p + 1) } else { None } }
+            Node::NotWord => { if !c.is_ascii_alphanumeric() && c != '_' { Some(p + 1) } else { None } }
+            Node::Space => { if c.is_whitespace() { Some(p + 1) } else { None } }
+            Node::NotSpace => { if !c.is_whitespace() { Some(p + 1) } else { None } }
+            Node::Start => { if self.line_start_ok(p, 0) { Some(p) } else { None } }
+            Node::End => { if self.line_end_ok(p) { Some(p) } else { None } }
+            Node::Wb => {
+                let a = if p == 0 { '\u{0000}' } else { self.text[p - 1] };
+                let b = if p >= self.text.len() { '\u{0000}' } else { self.text[p] };
+                let wa = a.is_ascii_alphanumeric() || a == '_';
+                let wb = b.is_ascii_alphanumeric() || b == '_';
+                if wa != wb { Some(p) } else { None }
+            }
+            Node::Nwb => {
+                let a = if p == 0 { '\u{0000}' } else { self.text[p - 1] };
+                let b = if p >= self.text.len() { '\u{0000}' } else { self.text[p] };
+                let wa = a.is_ascii_alphanumeric() || a == '_';
+                let wb = b.is_ascii_alphanumeric() || b == '_';
+                if wa == wb { Some(p) } else { None }
+            }
+            _ => None,
+        }
+    }
+    fn match_unit(&self, node: &Node, pos: usize) -> Option<usize> {
+        match node {
+            Node::Group(_, inner) => self.match_seq(inner, pos),
+            Node::NGroup(inner) => self.match_seq(inner, pos),
+            _ => self.match_atom(node, pos),
+        }
+    }
+    fn match_from(&self, seq: &[Node], k: usize, pos: usize) -> Option<usize> {
+        if k >= seq.len() { return Some(pos); }
+        let node = &seq[k];
+        match node {
+            Node::Star(c) => self.match_quant(c, pos, 0, usize::MAX, true, seq, k),
+            Node::StarNg(c) => self.match_quant(c, pos, 0, usize::MAX, false, seq, k),
+            Node::Plus(c) => self.match_quant(c, pos, 1, usize::MAX, true, seq, k),
+            Node::PlusNg(c) => self.match_quant(c, pos, 1, usize::MAX, false, seq, k),
+            Node::Quest(c) => self.match_quant(c, pos, 0, 1, true, seq, k),
+            Node::QuestNg(c) => self.match_quant(c, pos, 0, 1, false, seq, k),
+            Node::Rep(n, m, c) => self.match_quant(c, pos, *n, *m, true, seq, k),
+            Node::RepNg(n, m, c) => self.match_quant(c, pos, *n, *m, false, seq, k),
+            Node::Group(_, inner) => {
+                if let Some(e) = self.match_seq(inner, pos) { Some(e) } else { None }
+            }
+            Node::NGroup(inner) => {
+                if let Some(e) = self.match_seq(inner, pos) { Some(e) } else { None }
+            }
+            _ => {
+                if let Some(e) = self.match_atom(node, pos) {
+                    self.match_from(seq, k + 1, e)
+                } else { None }
+            }
+        }
+    }
+    fn match_quant(&self, child: &Node, pos: usize, min: usize, max: usize, greedy: bool, seq: &[Node], k: usize) -> Option<usize> {
+        let ends = self.quant_reach(child, pos, min, max, greedy);
+        for e in ends {
+            if let Some(f) = self.match_from(seq, k + 1, e) {
+                return Some(f);
+            }
+        }
+        None
+    }
+    fn quant_reach(&self, child: &Node, pos: usize, min: usize, max: usize, greedy: bool) -> Vec<usize> {
+        let mut positions = vec![pos];
+        let mut q = pos;
+        let mut count = 0usize;
+        let cap = 100000usize;
+        while count < max {
+            match self.match_unit(child, q) {
+                Some(e) => {
+                    q = e;
+                    positions.push(q);
+                    count += 1;
+                    if count >= cap { break; }
+                }
+                None => break,
+            }
+        }
+        let achieved = count;
+        if achieved < min { return vec![]; }
+        let lo = min;
+        let hi = achieved.min(max);
+        let mut res: Vec<usize> = Vec::new();
+        if greedy {
+            for i in (lo..=hi).rev() { res.push(positions[i]); }
+        } else {
+            for i in lo..=hi { res.push(positions[i]); }
+        }
+        res
+    }
+    fn match_seq(&self, seq: &[Node], pos: usize) -> Option<usize> {
+        self.match_from(seq, 0, pos)
+    }
+    fn try_at(&self, alts: &[Vec<Node>], p: usize) -> Option<usize> {
+        for alt in alts {
+            if let Some(e) = self.match_seq(alt, p) { return Some(e); }
+        }
+        None
+    }
+    fn find(&self, alts: &[Vec<Node>], start: usize) -> Option<(usize, usize)> {
+        for p in start..=self.text.len() {
+            if let Some(e) = self.try_at(alts, p) { return Some((p, e)); }
+        }
+        None
+    }
+    fn find_all(&self, alts: &[Vec<Node>]) -> Vec<(usize, usize)> {
+        let mut out = Vec::new();
+        let mut p = 0usize;
+        while p <= self.text.len() {
+            let (s, e) = match self.try_at(alts, p) {
+                Some(e) => (p, e),
+                None => break,
+            };
+            out.push((s, e));
+            if s == e { p += 1; } else { p = e; }
+        }
+        out
+    }
+}
+
+fn find_match(text: &str, alts: &[Vec<Node>], start: usize) -> Option<(usize, usize)> {
+    let m = M::new(text);
+    m.find(alts, start)
+}
