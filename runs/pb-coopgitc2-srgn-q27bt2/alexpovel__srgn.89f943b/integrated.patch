++// A backtracking regex engine, Unicode-aware, approximating Rust `regex` crate semantics.
++// Supports: literals, . (no newline), char classes [..][^..][a-z], \d\w\s\D\W\S, \., \( etc.
++// quantifiers * + ? {n} {n,} {n,m} with ? non-greedy, groups ( ) (?:), named (?P<name>|?<?name>),
++// anchors ^ $ \b \B, alternation |, escapes \x \u{} \o{} \N.
++
++pub struct Pattern {
++    pub root: Box<Node>,
++    pub names: Vec<Option<String>>, // index -> name (None for unnamed), 0 unused
++    pub case_insensitive: bool,
++}
++
++#[derive(Debug, Clone)]
++enum Node {
++    Char(char),
++    AnyChar,           // . (no newline)
++    AnyCharIncl,        // . with (?s)
++    Class { neg: bool, set: ClassSet },
++    Start, End,         // ^ $
++    WordBoundary, NotWordBoundary, // \b \B
++    Concat(Vec<Box<Node>>),
++    Alt(Vec<Box<Node>>),
++    Group { id: usize, node: Box<Node> },
++    NonGroup(Box<Node>),
++    Repeat { min: u32, max: u32, greedy: bool, node: Box<Node> },
++    Empty,
++}
++
++#[derive(Debug, Clone)]
++struct ClassSet {
++    ranges: Vec<(char, char)>,
++    neg: bool,
++}
++impl ClassSet {
++    fn contains(&self, c: char) -> bool {
++        let mut inside = false;
++        for (a, b) in &self.ranges {
++            if *a <= c && c <= *b { inside = true; break; }
++        }
++        if self.neg { !inside } else { inside }
++    }
++}
++
++pub struct Compiled {
++    pub pat: Pattern,
++}
++
++// ---- Parser ----
++struct Parser {
++    s: Vec<char>,
++    i: usize,
++    names: Vec<Option<String>>,
++    next_id: usize,
++    case_insensitive: bool,
++    dot_all: bool,
++    err: Option<String>,
