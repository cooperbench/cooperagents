+mod regex;
+use regex::*;
+fn tryc(p: &str) { match compile(p) { Ok(_) => println!("OK   {}", p), Err(e) => println!("FAIL {} : {}", p, e) } }
+fn main() {
+    for p in ["a.*?b", "a+?b", "a??", "a{2,3}?", ".*?", "(a)?", "a*?", "x+?"] {
+        tryc(p);
+    }
+}
diff --git a/src/tregex.rs b/src/tregex.rs
new file mode 100644
index 0000000..9c7c5ed
--- /dev/null
+++ b/src/tregex.rs
@@ -0,0 +1,46 @@
+mod regex;
+use regex::*;
+
+fn t(pat: &str, input: &str) {
+    let p = compile(pat).unwrap();
+    let chars: Vec<char> = input.chars().collect();
+    let all = find_all(&p, &chars);
+    let mut out = String::new();
+    for (s, e, _c) in &all {
+        let sub = &input[*s..*e];
+        out.push_str(&format!("{}-{}:{} ", *s + 1, *e + 1, sub));
+    }
+    println!("pat={:<12} input={:?} => {}", pat, input, if out.is_empty() { "(no match)".to_string() } else { out });
+}
+
+fn main() {
+    t(r"\d+", "a1b22c");
+    t(r"\w+", "ab12 cd");
+    t(r"[a-z]+", "abc123def");
+    t(r"a+b", "aaab");
+    t(r"a{2,3}b", "aaaaab");
+    t(r"a.*?b", "a1b2b");
+    t(r"a.*b", "a1b2b");
+    t(r"(a)(b)(c)", "abc");
+    t(r"(x+)(y+)", "xxxyyy");
+    t(r"^(abc)", "abcX");
+    t(r"abc$", "Xabc");
+    t(r"a|b", "axb");
+    t(r"a|bc", "abc");
+    t(r".", "abc\n");
+    t(r"\bword\b", "a word b");
+    t(r"\Bword\B", "xwordx");
+    t(r"a{2,}", "aaaa");
+    t(r"a{1,3}", "aaaa");
+    t(r"a+|x", "aaa");
+    t(r"a{3,5}", "aaaaa");
+    t(r"(ab){2}", "ababab");
+    t(r"(\d+)(\d+)", "12345");
+    t(r"[0-9][a-z]", "5a");
+    t(r"a.b", "a1b");
+    t(r"a{2,5}", "aa");
+    t(r"a{0,2}", "aaa");
+    t(r".{0,2}", "abc");
+    t(r"(?i)abc", "ABC");
+    t(r"a+?", "aa");
+}
