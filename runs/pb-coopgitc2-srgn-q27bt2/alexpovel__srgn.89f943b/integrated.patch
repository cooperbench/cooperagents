++pub fn apply_case(s: &str, a: &Actions) -> String {
++    let mut r = s.to_string();
++    if a.upper { r = r.to_uppercase(); }
++    if a.lower { r = r.to_lowercase(); }
++    if a.normalize { r = normalize(&r); }
++    if a.titlecase { r = titlecase(&r); }
