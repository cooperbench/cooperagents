+                            let cc = c as char; self.adv();
+                            if let Some(f) = first { ranges.push((f, f)); }
+                            first = Some(cc);
+                        }
+                        None => { self.fail("unterminated class"); break; }
+                    }
+                }
+                Some(b) => {
+                    let c = b as char; self.adv();
+                    if let Some(f) = first { ranges.push((f, f)); }
+                    first = Some(c);
+                }
+                None => { self.fail("unterminated class"); break; }
+            }
+        }
+        if self.peek() == Some(b']') { self.adv(); }
+        Node::Class(ranges, neg)
+    }
+
+    fn parse_group(&mut self) -> Node {
+        self.adv();
+        let mut idx: Option<usize> = None;
+        if self.peek() == Some(b'?') {
+            self.adv();
+            match self.peek() {
+                Some(b':') => { self.adv(); let inner = self.parse_seq(); self.expect_close(); return Node::NGroup(inner); }
