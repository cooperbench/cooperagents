+                    self.adv();
+                    if self.peek() == Some(b'<') {
+                        self.adv();
+                        if self.peek() == Some(b'=') { self.adv(); let inner = self.parse_seq(); self.expect_close(); return Node::NGroup(inner); }
+                        if self.peek() == Some(b'!') { self.adv(); let inner = self.parse_seq(); self.expect_close(); return Node::NGroup(inner); }
