+                        while self.peek().map(|b| b != b')').unwrap_or(false) { name.push(self.q().unwrap() as char); self.adv(); }
+                        self.groups += 1;
+                        let gid = self.groups;
+                        self.names.insert(name.clone(), gid);
+                        idx = Some(gid);
+                    }
+                }
+                _ => {}
+            }
+        }
+        self.groups += 1;
+        let gid = idx.unwrap_or(self.groups);
+        let inner = self.parse_seq();
+        self.expect_close();
+        Node::Group(gid, inner)
+    }
+
+    fn expect(&mut self, c: u8) {
+        if self.peek() == Some(c) { self.adv(); } else { self.fail("missing"); }
+    }
+    fn expect_close(&mut self) {
+        if self.peek() == Some(b')') { self.adv(); } else { self.fail("missing )"); }
+    }
+}
+
+#[derive(Clone)]
+pub struct Regex {
+    alts: Vec<Vec<Node>>,
+    groups: usize,
+    names: HashMap<String, usize>,
+}
+impl Regex {
+    pub fn compile(src: &str) -> Result<Regex, String> {
+        let mut b = Builder::new(src);
+        let alts = b.parse()?;
+        if alts.is_empty() { return Err("empty pattern".to_string()); }
+        Ok(Regex { alts, groups: b.groups, names: b.names })
+    }
+    pub fn group_count(&self) -> usize { self.groups }
+    pub fn names(&self) -> &HashMap<String, usize> { &self.names }
+    pub fn find_all(&self, text: &str) -> Vec<Match> {
+        let m = M { text: text.chars().collect() };
+        m.find_all(&self.alts, self.groups)
+    }
+}
+
+pub struct Match {
+    pub start: usize,
+    pub end: usize,
+    pub groups: Vec<Option<(usize, usize)>>,
+}
+
+struct M { text: Vec<char> }
+impl M {
+    fn atom_match(&self, node: &Node, pos: usize) -> Option<usize> {
+        match node {
+            Node::Lit(c) => {
+                if pos < self.text.len() && self.text[pos] == *c { Some(pos + 1) } else { None }
+            }
+            Node::Any => {
+                if pos < self.text.len() && self.text[pos] != '\n' { Some(pos + 1) } else { None }
+            }
+            Node::Start => if pos == 0 { Some(pos) } else { None },
+            Node::End => {
+                if pos == self.text.len() { Some(pos) }
+                else if self.text[pos] == '\n' { Some(pos + 1) }
+                else { None }
+            }
+            Node::Digit => {
+                if pos < self.text.len() && self.text[pos].is_ascii_digit() { Some(pos + 1) } else { None }
+            }
+            Node::NotDigit => {
+                if pos < self.text.len() && !self.text[pos].is_ascii_digit() { Some(pos + 1) } else { None }
+            }
+            Node::Word => {
+                if pos < self.text.len() && (self.text[pos].is_alphanumeric() || self.text[pos] == '_') { Some(pos + 1) } else { None }
+            }
+            Node::NotWord => {
+                if pos < self.text.len() && !(self.text[pos].is_alphanumeric() || self.text[pos] == '_') { Some(pos + 1) } else { None }
+            }
+            Node::Space => {
+                if pos < self.text.len() && self.text[pos].is_whitespace() { Some(pos + 1) } else { None }
+            }
+            Node::NotSpace => {
+                if pos < self.text.len() && !self.text[pos].is_whitespace() { Some(pos + 1) } else { None }
+            }
+            Node::Wb => {
+                let before = pos == 0 || (self.text[pos - 1].is_alphanumeric() || self.text[pos - 1] == '_');
+                let after = pos >= self.text.len() || (self.text[pos].is_alphanumeric() || self.text[pos] == '_');
+                if before != after { Some(pos) } else { None }
+            }
+            Node::Nwb => {
+                let before = pos == 0 || (self.text[pos - 1].is_alphanumeric() || self.text[pos - 1] == '_');
+                let after = pos >= self.text.len() || (self.text[pos].is_alphanumeric() || self.text[pos] == '_');
+                if before == after { Some(pos) } else { None }
+            }
+            Node::Class(ranges, neg) => {
+                if pos < self.text.len() {
+                    let c = self.text[pos];
+                    let mut in_class = false;
+                    for (lo, hi) in ranges {
+                        if c >= *lo && c <= *hi { in_class = true; break; }
+                    }
+                    if in_class != *neg { Some(pos + 1) } else { None }
+                } else { None }
+            }
+            _ => None,
+        }
+    }
+
+    fn match_unit(&self, node: &Node, pos: usize, pcaps: &mut Vec<Option<(usize, usize)>>) -> Option<usize> {
+        match node {
+            Node::Group(_, inner) => self.match_seq(inner, pos, pcaps),
+            Node::NGroup(inner) => self.match_seq(inner, pos, pcaps),
+            _ => self.atom_match(node, pos),
+        }
+    }
+
+    fn match_from(&self, seq: &[Node], k: usize, pos: usize, caps: &mut Vec<Option<(usize, usize)>>) -> Option<usize> {
+        if k >= seq.len() { return Some(pos); }
+        let snap = caps.clone();
+        let node = &seq[k];
+        let result = match node {
+            Node::Star(c) => self.match_quant(c, pos, 0, usize::MAX, true, seq, k, caps),
+            Node::StarNg(c) => self.match_quant(c, pos, 0, usize::MAX, false, seq, k, caps),
+            Node::Plus(c) => self.match_quant(c, pos, 1, usize::MAX, true, seq, k, caps),
+            Node::PlusNg(c) => self.match_quant(c, pos, 1, usize::MAX, false, seq, k, caps),
+            Node::Quest(c) => self.match_quant(c, pos, 0, 1, true, seq, k, caps),
+            Node::QuestNg(c) => self.match_quant(c, pos, 0, 1, false, seq, k, caps),
+            Node::Rep(n, m, c) => self.match_quant(c, pos, *n, *m, true, seq, k, caps),
+            Node::RepNg(n, m, c) => self.match_quant(c, pos, *n, *m, false, seq, k, caps),
+            Node::Group(g, inner) => {
+                let r = self.match_seq(inner, pos, caps);
+                if let Some(end) = r {
+                    caps[*g] = Some((pos, end));
+                    self.match_from(seq, k + 1, end, caps)
+                } else { None }
+            }
+            Node::NGroup(inner) => {
+                if let Some(end) = self.match_seq(inner, pos, caps) {
+                    self.match_from(seq, k + 1, end, caps)
+                } else { None }
+            }
+            _ => {
+                if let Some(e) = self.atom_match(node, pos) {
+                    self.match_from(seq, k + 1, e, caps)
+                } else { None }
+            }
+        };
+        match result {
+            Some(e) => Some(e),
+            None => { *caps = snap; None }
+        }
+    }
+
+    fn match_quant(&self, child: &Node, pos: usize, min: usize, max: usize, greedy: bool, seq: &[Node], k: usize, caps: &mut Vec<Option<(usize, usize)>>) -> Option<usize> {
+        let mut pcaps = vec![None; (caps.len()).max(1)];
+        let ends = self.quant_reach(child, pos, min, max, greedy, &mut pcaps);
+        let snap = caps.clone();
+        for e in ends {
+            let mut c = snap.clone();
+            if let Some(f) = self.match_from(seq, k + 1, e, &mut c) {
+                *caps = c;
+                return Some(f);
+            }
+        }
+        None
+    }
+
+    fn quant_reach(&self, child: &Node, pos: usize, min: usize, max: usize, greedy: bool, pcaps: &mut Vec<Option<(usize, usize)>>) -> Vec<usize> {
+        let mut positions = vec![pos];
+        let mut q = pos;
+        let mut count = 0usize;
+        let cap = 100000usize;
+        while count < max {
+            match self.match_unit(child, q, pcaps) {
+                Some(e) => {
+                    q = e;
+                    positions.push(q);
+                    count += 1;
+                    if count >= cap { break; }
+                }
+                None => break,
+            }
+        }
+        let achieved = count;
+        if achieved < min { return vec![]; }
+        let lo = min;
+        let hi = achieved.min(max);
+        let mut res: Vec<usize> = Vec::new();
+        if greedy {
+            for i in (lo..=hi).rev() { res.push(positions[i]); }
+        } else {
+            for i in lo..=hi { res.push(positions[i]); }
+        }
+        res
+    }
+
+    fn match_seq(&self, seq: &[Node], pos: usize, caps: &mut Vec<Option<(usize, usize)>>) -> Option<usize> {
+        self.match_from(seq, 0, pos, caps)
+    }
+
+    fn find_all(&self, alts: &[Vec<Node>], groups: usize) -> Vec<Match> {
+        let mut results = Vec::new();
+        let mut pos = 0;
+        while pos <= self.text.len() {
+            let mut best_end = 0usize;
+            let mut best_found = false;
+            let mut best_caps: Vec<Option<(usize, usize)>> = vec![None; groups + 1];
+            for alt in alts {
+                let mut caps = vec![None; groups + 1];
+                if let Some(end) = self.match_seq(alt, pos, &mut caps) {
+                    if end > pos || (end == pos && best_found) {
+                        if !best_found || end > best_end {
+                            best_end = end;
+                            best_found = true;
+                            best_caps = caps;
+                        }
+                    }
+                }
+            }
+            if best_found {
+                results.push(Match { start: pos, end: best_end, groups: best_caps });
+                if best_end > pos { pos = best_end; } else { pos += 1; }
+            } else {
+                pos += 1;
+            }
+        }
+        results
+    }
+}
+
+fn show(re: &Regex, txt: &str) {
+    for m in re.find_all(txt) {
+        let g: Vec<_> = m.groups.iter().enumerate().filter(|(_,v)| v.is_some()).map(|(i,v)| format!("{}={}", i, v.unwrap().1)).collect();
+        println!("  [{},{}]: groups {:?}", m.start, m.end, m.groups.iter().enumerate().filter(|(_,v)|v.is_some()).map(|(i,v)| (i, v.unwrap())).collect::<Vec<_>>());
+    }
+}
+fn main() {
+    for (pat, txt) in [("\\w+", "foo bar"), ("(a)(b)", "xaaxbb"), ("(a)(b)c", "xabc"), ("(a+)(b+)", "aaabb"), ("(\\w+)(\\w+)", "abc"), ("(a)(b)*", "aabb"), ("x|y", "xyz"), ("a{2,3}", "aaaa")] {
+        match Regex::compile(pat) {
+            Ok(r) => { println!("{} on {:?}:", pat, txt); show(&r, txt); }
+            Err(e) => println!("ERR {}: {}", pat, e),
+        }
+    }
+}
