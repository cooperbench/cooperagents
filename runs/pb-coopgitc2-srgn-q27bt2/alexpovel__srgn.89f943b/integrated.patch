+use crate::regex::Captures;
+
+#[derive(Clone, Default)]
+pub struct Actions {
+    pub upper: bool,
+    pub lower: bool,
+    pub titlecase: bool,
+    pub normalize: bool,
+    pub german: bool,
+    pub german_naive: bool,
+    pub german_prefer_original: bool,
+    pub symbols: bool,
+    pub delete: bool,
+    pub squeeze: bool,
+    pub invert: bool,
+    pub fail_any: bool,
+    pub fail_none: bool,
+}
+
+impl Actions {
+    pub fn none(&self) -> bool {
+        !self.upper && !self.lower && !self.titlecase && !self.normalize
+            && !self.german && !self.german_naive && !self.symbols && !self.delete && !self.squeeze
+    }
+}
+
+// expand a replacement string with capture groups: $1..$9, $name, $& (whole match)
+fn expand(replacement: &str, caps: &Captures, matched: &str, names: &[Option<String>], mstart: usize) -> String {
+    let mut out = String::new();
+    let chars: Vec<char> = replacement.chars().collect();
+    let mut k = 0;
+    while k < chars.len() {
+        match chars[k] {
+            '$' => {
+                if k + 1 >= chars.len() {
+                    out.push('$');
+                    k += 1;
+                    continue;
+                }
+                let next = chars[k + 1];
+                if next == '$' {
+                    out.push('$');
+                    k += 2;
+                } else if next.is_ascii_digit() {
+                    // read full number
+                    let mut num = 0usize;
+                    let mut m = k + 1;
+                    while m < chars.len() && chars[m].is_ascii_digit() {
+                        num = num * 10 + (chars[m] as u32 - '0' as u32) as usize;
+                        m += 1;
+                    }
+                    if let Some(s) = caps.starts.get(num).filter(|s| s.is_some()) {
+                        let st = s.unwrap() - mstart;
+                        let en = caps.ends.get(num).unwrap().unwrap() - mstart;
+                        out.push_str(&matched[st..en]);
+                    } else if num == 0 {
+                        out.push_str(matched);
+                    }
+                    k = m;
+                } else if next == '&' {
+                    out.push_str(matched);
+                    k += 2;
+                } else if next.is_alphabetic() || next == '_' {
+                    // named capture
+                    let mut name = String::new();
+                    let mut m = k + 1;
+                    while m < chars.len() && (chars[m].is_alphanumeric() || chars[m] == '_') {
+                        name.push(chars[m]);
+                        m += 1;
+                    }
+                    // find group with this name
+                    let mut found = false;
+                    for idx in 1..names.len() {
+                        if let Some(Some(nm)) = names.get(idx) {
+                            if nm == &name {
+                                if let Some(st) = caps.starts.get(idx).and_then(|s| *s) {
+                                    if let Some(en) = caps.ends.get(idx).and_then(|e| *e) {
+                                        out.push_str(&matched[st - mstart..en - mstart]);
+                                        found = true;
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    if !found {
+                        // literal name fallback
+                        for c in name.chars() { out.push(c); }
+                    }
+                    k = m;
+                } else if next == '\\' {
+                    // escaped: keep next char literal
+                    k += 1;
+                    if k < chars.len() { out.push(chars[k]); }
+                    k += 1;
+                } else {
+                    out.push('$');
+                    k += 1;
+                }
+            }
+            '\\' if k + 1 < chars.len() => {
+                match chars[k + 1] {
+                    'n' => { out.push('\n'); k += 2; }
+                    't' => { out.push('\t'); k += 2; }
+                    'r' => { out.push('\r'); k += 2; }
+                    '0' => { out.push('\0'); k += 2; }
+                    c => { out.push(c); k += 2; }
+                }
+            }
+            c => { out.push(c); k += 1; }
+        }
+    }
+    out
+}
+
+fn titlecase(s: &str) -> String {
+    let mut out = String::new();
+    let mut at_word_start = true;
+    for c in s.chars() {
+        if c.is_alphanumeric() {
+            if at_word_start {
+                for up in c.to_uppercase() { out.push(up); }
+                at_word_start = false;
+            } else {
+                for lo in c.to_lowercase() { out.push(lo); }
+            }
+        } else {
+            out.push(c);
+            at_word_start = true;
+        }
+    }
+    out
+}
+
+// strip common combining accents (NFD-ish for Latin)
+fn normalize(s: &str) -> String {
+    let mut out = String::new();
+    for c in s.chars() {
+        match c {
+            'à' => out.push('a'), 'á' => out.push('a'), 'â' => out.push('a'),
+            'ã' => out.push('a'), 'ä' => out.push('a'), 'å' => out.push('a'),
+            'À' => out.push('A'), 'Á' => out.push('A'), 'Â' => out.push('A'),
+            'Ã' => out.push('A'), 'Ä' => out.push('A'), 'Å' => out.push('A'),
+            'è' => out.push('e'), 'é' => out.push('e'), 'ê' => out.push('e'),
+            'ë' => out.push('e'), 'É' => out.push('E'), 'Ê' => out.push('E'),
+            'È' => out.push('E'), 'Ë' => out.push('E'),
+            'ì' => out.push('i'), 'í' => out.push('i'), 'î' => out.push('i'),
+            'ï' => out.push('i'), 'Í' => out.push('I'), 'Î' => out.push('I'),
+            'Ì' => out.push('I'), 'Ï' => out.push('I'),
+            'ò' => out.push('o'), 'ó' => out.push('o'), 'ô' => out.push('o'),
+            'õ' => out.push('o'), 'ö' => out.push('o'), 'ø' => out.push('o'),
+            'Ö' => out.push('O'), 'Ø' => out.push('O'), 'Ó' => out.push('O'),
+            'Ô' => out.push('O'), 'Ò' => out.push('O'),
+            'ù' => out.push('u'), 'ú' => out.push('u'), 'û' => out.push('u'),
+            'ü' => out.push('u'), 'Ú' => out.push('U'), 'Û' => out.push('U'),
+            'Ü' => out.push('U'), 'Ù' => out.push('U'),
+            'ý' => out.push('y'), 'ÿ' => out.push('y'), 'Ý' => out.push('Y'),
+            'ñ' => out.push('n'), 'Ñ' => out.push('N'),
+            'ç' => out.push('c'), 'Ç' => out.push('C'),
+            'ß' => { out.push('s'); out.push('s'); }
+            'ß' => { out.push('s'); out.push('s'); }
+            'ł' => out.push('l'), 'Ł' => out.push('L'),
+            'Ł' => out.push('l'), 'ł' => out.push('l'),
+            'ć' => out.push('c'), 'Ć' => out.push('C'),
+            'ż' => out.push('z'), 'Ż' => out.push('Z'),
+            'ź' => out.push('z'), 'Ź' => out.push('Z'),
+            'ŝ' => out.push('s'), 'Ŝ' => out.push('S'),
+            'ř' => out.push('r'), 'Ř' => out.push('R'),
+            'č' => out.push('c'), 'Č' => out.push('C'),
+            'š' => out.push('s'), 'Š' => out.push('S'),
+            _ => out.push(c),
+        }
+    }
+    out
+}
