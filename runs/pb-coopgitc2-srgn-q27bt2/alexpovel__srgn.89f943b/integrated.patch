++        if actions.squeeze {
++            if let Some(ref pv) = prev_squeezed {
++                if pv == &matched && st == last {
++                    last = en;
++                    continue;
++                }
++            }
++        }
++        if st > last {
++            result.extend_from_slice(&chars[last..st]);
++        }
++        let t = actions.transform(&matched, replacement.map(|s| s.as_str()), &m.2, &names, st);
