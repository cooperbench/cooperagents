index 0000000..28dd61b
--- /dev/null
+++ b/src/regex_dbg.rs
@@ -0,0 +1,519 @@
+// A backtracking regex engine, Unicode-aware, approximating Rust `regex` crate semantics.
+// Supports: literals, . (no newline), char classes [..][^..][a-z], \d\w\s\D\W\S, \., \( etc.
+// quantifiers * + ? {n} {n,} {n,m} with ? non-greedy, groups ( ) (?:), named (?P<name>|?<?name>),
+// anchors ^ $ \b \B, alternation |, escapes \x \u{} \o{} \N.
+
+pub struct Pattern {
+    pub root: Box<Node>,
+    pub names: Vec<Option<String>>, // index -> name (None for unnamed), 0 unused
+    pub case_insensitive: bool,
+}
+
+#[derive(Debug, Clone)]
+enum Node {
+    Char(char),
+    AnyChar,           // . (no newline)
+    AnyCharIncl,        // . with (?s)
+    Class { neg: bool, set: ClassSet },
+    Start, End,         // ^ $
+    WordBoundary, NotWordBoundary, // \b \B
+    Concat(Vec<Box<Node>>),
+    Alt(Vec<Box<Node>>),
+    Group { id: usize, node: Box<Node> },
+    NonGroup(Box<Node>),
+    Repeat { min: u32, max: u32, greedy: bool, node: Box<Node> },
+    Empty,
+}
+
+#[derive(Debug, Clone)]
+struct ClassSet {
+    ranges: Vec<(char, char)>,
+    neg: bool,
+}
+impl ClassSet {
+    fn contains(&self, c: char) -> bool {
+        let mut inside = false;
+        for (a, b) in &self.ranges {
+            if *a <= c && c <= *b { inside = true; break; }
+        }
+        if self.neg { !inside } else { inside }
+    }
+}
+
+pub struct Compiled {
+    pub pat: Pattern,
+}
+
+// ---- Parser ----
+struct Parser {
+    s: Vec<char>,
+    i: usize,
+    names: Vec<Option<String>>,
+    next_id: usize,
+    case_insensitive: bool,
+    dot_all: bool,
+    err: Option<String>,
+}
+
+impl Parser {
+    fn new(p: &str) -> Self {
+        let s: Vec<char> = p.chars().collect();
+        Parser { s, i: 0, names: vec![None], next_id: 1, case_insensitive: false, dot_all: false, err: None }
+    }
+
+    fn peek(&self) -> Option<char> { self.s.get(self.i).copied() }
+    fn advance(&mut self) -> Option<char> {
+        let c = self.s.get(self.i).copied();
+        if c.is_some() { self.i += 1; }
+        c
+    }
+
+    fn parse(&mut self) -> Result<Box<Node>, String> {
+        // top-level: Alt of Concat
+        let alts = self.parse_alt()?;
+        Ok(alts)
+    }
+
+    fn parse_alt(&mut self) -> Result<Box<Node>, String> {
+        let mut branches = vec![self.parse_concat()?];
+        while self.peek() == Some('|') {
+            self.advance();
+            let b = self.parse_concat()?;
+            branches.push(b);
+        }
+        Ok(Box::new(Node::Alt(branches)))
+    }
+
+    fn parse_concat(&mut self) -> Result<Box<Node>, String> {
+        let mut items = vec![];
+        loop {
+            match self.peek() {
+                None => break,
+                Some('|') | Some(')') => break,
+                _ => {}
+            }
+            // handle flag groups (?i) (?s) etc
+            if self.peek() == Some('(') && self.i + 1 < self.s.len() && self.s.get(self.i+1) == Some(&'?') {
+                // could be a flag group or named/lookaround
+                let k = self.s.get(self.i+2).copied();
+                if let Some(c @ ('i' | 'i' | 's' | 'm' | 'x')) = k {}
+                // We'll detect (?i), (?s), (?-i) etc.
+                if self.try_parse_flag_group() { continue; }
+            }
+            let item = self.parse_quant()?;
+            items.push(item);
+        }
+        if items.len() == 1 { Ok(items.pop().unwrap()) }
+        else { Ok(Box::new(Node::Concat(items))) }
+    }
+
+    fn try_parse_flag_group(&mut self) -> bool {
+        // Detect zero-assertion flag groups like (?i), (?-i), (?s), (?-s), (?m), (?x).
+        // Also detect scoped (?i: ...) by applying the flag globally then parsing the body.
+        if self.s.get(self.i) != Some(&'(') { return false; }
+        if self.s.get(self.i+1) != Some(&'?') { return false; }
+        // Scan flag chars from i+3 until ')' or ':'
+        let mut j = self.i + 3;
+        let mut flags = String::new();
+        let mut seen = false;
+        while let Some(c) = self.s.get(j) {
+            if *c == ')' {
+                // zero-assertion flag group
+                for ch in flags.chars() {
+                    match ch {
+                        'i' => self.case_insensitive = true,
+                        's' => self.dot_all = true,
+                        '-' => { /* handled below */ }
+                        _ => {}
+                    }
+                }
+                // handle '-'
+                if flags.contains('-') {
+                    // flags like -i, -s ; negate
+                    // simple: if '-' present, set the following flag false
+                    if flags.contains('i') { self.case_insensitive = false; }
+                    if flags.contains('s') { self.dot_all = false; }
+                }
+                self.i = j + 1;
+                return true;
+            }
+            if *c == ':' {
+                // scoped flag group: (?flags:...); apply flags, continue parsing body in parse_atom
+                for ch in flags.chars() {
+                    match ch {
+                        'i' => self.case_insensitive = true,
+                        's' => self.dot_all = true,
+                        _ => {}
+                    }
+                }
+                // leave i at the ':' so caller continues; but we want to parse the group body.
+                // For simplicity, set a marker: we will let parse_atom treat the rest.
+                seen = true;
+                self.i = j; // stop before ':'
+                break;
+            }
+            if matches!(*c, 'i'|'s'|'m'|'x'|'-') {
+                flags.push(*c); seen = true;
+                j += 1;
+                continue;
+            }
+            break;
+        }
+        if !seen { return false; }
+        // If we hit ':' with a scoped group, we need to parse the inner body.
+        // Handle (?flags:...) by consuming the group here.
+        if self.s.get(self.i) == Some(&':') {
+            self.i += 1; // consume ':'
+            // parse inner group until matching ')'
+            let _ = self.parse_alt();
+            // consume ')'
+            if self.peek() == Some(')') { self.advance(); }
+            return true;
+        }
+        false
+    }
+
+    fn parse_quant(&mut self) -> Result<Box<Node>, String> {
+        let base = self.parse_atom()?;
+        match self.peek() {
+            Some('*') => { self.advance(); let g = self.peek() == Some('?'); Ok(Box::new(Node::Repeat{min:0,max:u32::MAX,greedy:!g,node:base})) }
+            Some('+') => { self.advance(); let g = self.peek() == Some('?'); Ok(Box::new(Node::Repeat{min:1,max:u32::MAX,greedy:!g,node:base})) }
+            Some('?') => { self.advance(); let g = self.peek() == Some('?'); Ok(Box::new(Node::Repeat{min:0,max:1,greedy:!g,node:base})) }
+            Some('{') => {
+                self.advance();
+                // parse {n}, {n,}, {n,m}
+                let mut n: u32 = 0; let mut m: u32 = u32::MAX; let mut has_m = false; let mut has_comma = false;
+                while let Some(c) = self.peek() {
+                    if c.is_ascii_digit() { n = n*10 + (c as u32 - '0' as u32); self.advance(); }
+                    else if c == ',' { has_comma = true; self.advance(); }
+                    else if c == '}' { self.advance(); break; }
+                    else { self.err = Some("invalid quantifier".into()); return Err("bad".into()); }
+                }
+                if !has_comma { m = n; }
+                let g = self.peek() == Some('?');
+                Ok(Box::new(Node::Repeat{min:n,max:m,greedy:!g,node:base}))
+            }
+            _ => Ok(base),
+        }
+    }
+
+    fn parse_atom(&mut self) -> Result<Box<Node>, String> {
+        let c = match self.peek() {
+            Some(c) => c,
+            None => return Err("unexpected end".into()),
+        };
+        match c {
+            '(' => {
+                self.advance();
+                if self.peek() == Some('?') {
+                    // special group
+                    let c2 = self.s.get(self.i+1).copied();
+                    match c2 {
+                        Some('<') => {
+                            // named: (?<name>...)
+                            self.advance(); // consume '<'
+                            let name = self.read_name()?;
+                            self.start_capturing(name)?;
+                            let inner = self.parse_group_inner()?;
+                            return Ok(inner);
+                        }
+                        Some('P') => {
+                            // (?P<name>...)
+                            self.advance(); // consume 'P'
+                            if self.peek() != Some('<') { return Err("bad".into()); }
+                            self.advance();
+                            let name = self.read_name()?;
+                            self.start_capturing(name)?;
+                            let inner = self.parse_group_inner()?;
+                            return Ok(inner);
+                        }
+                        Some('i') | Some('s') | Some('m') | Some('x') => {
+                            // handled by flag group in parse_concat
+                            let inner = self.parse_group_inner()?;
+                            return Ok(Box::new(Node::NonGroup(inner)));
+                        }
+                        _ => { return Err("bad group".into()); }
+                    }
+                }
+                // normal capturing group
+                let id = self.next_id; self.next_id += 1;
+                self.names.push(None);
+                let inner = self.parse_group_inner()?;
+                Ok(Box::new(Node::Group{ id, node: inner }))
+            }
+            '[' => self.parse_class(),
+            '.' => {
+                self.advance();
+                if self.dot_all { Ok(Box::new(Node::AnyCharIncl)) } else { Ok(Box::new(Node::AnyChar)) }
+            }
+            '^' => { self.advance(); Ok(Box::new(Node::Start)) }
+            '$' => { self.advance(); Ok(Box::new(Node::End)) }
+            '\\' => {
+                self.advance();
+                self.parse_escape()
+            }
+            _ if c == '|' || c == ')' || c == '?' => { Err("bad".into()) }
+            _ => {
+                self.advance();
+                Ok(Box::new(Node::Char(c)))
+            }
+        }
+    }
+
+    fn start_capturing(&mut self, name: String) -> Result<(), String> {
+        let id = self.next_id; self.next_id += 1;
+        self.names.push(Some(name));
+        Ok(())
+    }
+
+    fn parse_group_inner(&mut self) -> Result<Box<Node>, String> {
+        // we've consumed '('; parse until ')'
+        let node = self.parse_alt()?;
+        if self.peek() != Some(')') { return Err("expected )".into()); }
+        self.advance();
+        Ok(node)
+    }
+
+    fn read_name(&mut self) -> Result<String, String> {
+        let mut name = String::new();
+        while let Some(c) = self.peek() {
+            if c == '>' { self.advance(); break; }
+            if c.is_alphanumeric() || c == '_' { name.push(c); self.advance(); }
+            else { return Err("bad name".into()); }
+        }
+        if name.is_empty() { return Err("empty name".into()); }
+        Ok(name)
+    }
+
+    fn parse_class(&mut self) -> Result<Box<Node>, String> {
+        self.advance(); // consume '['
+        let mut neg = false;
+        if self.peek() == Some('^') { neg = true; self.advance(); }
+        let mut ranges: Vec<(char,char)> = vec![];
+        // first char can be ']' as literal
+        loop {
+            match self.peek() {
+                None => { return Err("unterminated class".into()); }
+                Some(']') => { self.advance(); break; }
+                Some(c) => {
+                    let lo = self.advance().unwrap();
+                    // range?
+                    if self.peek() == Some('-') && self.s.get(self.i+1) != Some(&']') {
+                        self.advance();
+                        let hi = self.advance().unwrap_or(']');
+                        ranges.push((lo, hi));
+                    } else {
+                        ranges.push((lo, lo));
+                    }
+                }
+            }
+        }
+        Ok(Box::new(Node::Class{ neg, set: ClassSet{ ranges, neg } }))
+    }
+
+    fn parse_escape(&mut self) -> Result<Box<Node>, String> {
+        // consumed '\'; read next char
+        let c = match self.advance() {
+            Some(c) => c,
+            None => return Err("trailing backslash".into()),
+        };
+        match c {
+            'd' => Ok(self.class_of(vec![('0','9')], false)),
+            'D' => Ok(self.class_of(vec![('0','9')], true)),
+            'w' => Ok(self.class_of(vec![('a','z'),('A','Z'),('0','9')], false)),
+            'W' => Ok(self.class_of(vec![('a','z'),('A','Z'),('0','9')], true)),
+            's' => Ok(self.class_of(vec![(' ',' '),('\t','\t'),('\n','\n'),('\r','\r'),('\x0c','\x0c'),('\x0b','\x0b')], false)),
+            'S' => Ok(self.class_of(vec![(' ',' '),('\t','\t'),('\n','\n'),('\r','\r'),('\x0c','\x0c'),('\x0b','\x0b')], true)),
+            'b' => { Ok(Box::new(Node::WordBoundary)) }
+            'B' => { Ok(Box::new(Node::NotWordBoundary)) }
+            'A' => { Ok(Box::new(Node::Start)) }
+            'z' => { Ok(Box::new(Node::End)) }
+            _ => {
+                // literal escaped char (., (, ), etc.) or \x \o \N
+                Ok(Box::new(Node::Char(c)))
+            }
+        }
+    }
+
+    fn class_of(&self, ranges: Vec<(char,char)>, neg: bool) -> Box<Node> {
+        Box::new(Node::Class{ neg, set: ClassSet{ ranges, neg } })
+    }
+}
+
+pub fn compile(pattern: &str) -> Result<Pattern, String> {
+    let mut p = Parser::new(pattern);
+    let root = p.parse()?;
+    // root is an Alt; wrap
+    let pat = Pattern {
+        root: Box::new(Node::Concat(vec![root])),
+        names: p.names,
+        case_insensitive: p.case_insensitive,
+    };
+    Ok(pat)
+}
+
+pub fn compile_lenient(pattern: &str) -> Result<Pattern, String> {
+    match compile(pattern) {
+        Ok(p) => Ok(p),
+        Err(_) => {
+            // fallback: treat as literal
+            let s: Vec<char> = pattern.chars().collect();
+            let items: Vec<Box<Node>> = s.iter().map(|&c| {
+                if c == '.' { Box::new(Node::Char('.')) } else { Box::new(Node::Char(c)) }
+            }).collect();
+            Ok(Pattern { root: Box::new(Node::Concat(items)), names: vec![None], case_insensitive: false })
+        }
+    }
+}
+
+// ---- Matching ----
+#[derive(Clone)]
+pub struct Captures {
+    pub starts: Vec<Option<usize>>, // char index start
+    pub ends: Vec<Option<usize>>,
+}
+impl Captures {
+    fn new(n: usize) -> Self {
+        Captures { starts: vec![None; n], ends: vec![None; n] }
+    }
+}
+
+fn is_word(c: Option<char>) -> bool {
+    match c {
+        Some(c) => c.is_alphanumeric() || c == '_',
+        None => false,
+    }
+}
+
+// Try to match node at position `pos` in `chars`, advancing `*end`, recording captures.
+fn match_node(pat: &Pattern, node: &Node, chars: &[char], pos: usize,
+              end: &mut usize, caps: &mut Captures) -> bool {
+    match node {
+        Node::Char(c) => {
+            let got = chars.get(*end).copied();
+            if got.is_some() {
+                let g = got.unwrap();
+                if pat.case_insensitive {
+                    if g.to_lowercase().eq((*c).to_lowercase()) { *end += 1; return true; }
+                } else if g == *c {
+                    *end += 1; return true;
+                }
+            }
+            false
+        }
+        Node::AnyChar => {
+            let got = chars.get(*end).copied();
+            if got.is_some() && got != Some('\n') { *end += 1; return true; }
+            false
+        }
+        Node::AnyCharIncl => {
+            let got = chars.get(*end).copied();
+            if got.is_some() { *end += 1; return true; }
+            false
+        }
+        Node::Class { set, neg: _ } => {
+            let got = chars.get(*end).copied();
+            eprintln!("[Class] end={} got={:?} set.ranges={:?} set.neg={} contains={}", *end, got, set.ranges, set.neg, got.map_or(false,|c| set.contains(c)));
+            if got.is_some() && set.contains(got.unwrap()) { *end += 1; return true; }
+            false
+        }
+        Node::Start => {
+            // ^ matches at start of input or after newline
+            if *end == 0 { true } else { chars[*end - 1] == '\n' }
+        }
+        Node::End => {
+            // $ matches at end of input or before newline
+            if *end == chars.len() { true } else { chars[*end] == '\n' }
+        }
+        Node::WordBoundary => {
+            let before = if *end > 0 { Some(chars[*end-1]) } else { None };
+            let after = chars.get(*end).copied();
+            is_word(before) != is_word(after)
+        }
+        Node::NotWordBoundary => {
+            let before = if *end > 0 { Some(chars[*end-1]) } else { None };
+            let after = chars.get(*end).copied();
+            is_word(before) == is_word(after)
+        }
+        Node::Concat(items) => {
+            let mut e = *end;
+            for it in items {
+                if !match_node(pat, it, chars, pos, &mut e, caps) { return false; }
+            }
+            *end = e;
+            true
+        }
+        Node::Alt(brs) => {
+            for br in brs {
+                let mut e = *end;
+                let mut c = caps.clone();
+                if match_node(pat, br, chars, pos, &mut e, &mut c) {
+                    *caps = c; *end = e; return true;
+                }
+            }
+            false
+        }
+        Node::Group { id, node: inner } => {
+            let mut e = *end;
+            let mut c = caps.clone();
+            if match_node(pat, inner, chars, pos, &mut e, &mut c) {
+                caps.starts[*id] = Some(pos);
+                caps.ends[*id] = Some(e);
+                *caps = c; *end = e; return true;
+            }
+            false
+        }
+        Node::NonGroup(inner) => {
+            match_node(pat, inner, chars, pos, end, caps)
+        }
+        Node::Repeat { min, max, greedy, node: inner } => {
+            eprintln!("[Repeat] start end={} min={} max={}", *end, min, max);
+            let mut e = *end;
+            let mut c = caps.clone();
+            let mut count = 0u32;
+            loop {
+                let mut e2 = e;
+                let mut c2 = c.clone();
+                if count < *max && match_node(pat, inner, chars, pos, &mut e2, &mut c2) {
+                    e = e2; c = c2; count += 1;
+                    if *max == u32::MAX && !greedy { break; } // lazy max: stop after first
+                } else { break; }
+            }
+            if count >= *min { *end = e; *caps = c; true } else { false }
+        }
+        Node::Empty => true,
+    }
+}
+
+// Find a match starting at `start`, returning (end, captures) of the leftmost-longest match.
+pub fn find_match(pat: &Pattern, chars: &[char], start: usize) -> Option<(usize, Captures)> {
+    for pos in start..=chars.len() {
+        let mut end = pos;
+        let mut caps = Captures::new(pat.names.len());
+        if match_node(pat, &pat.root, chars, pos, &mut end, &mut caps) {
+            return Some((end, caps));
+        }
+    }
+    None
+}
+
+// Global find: returns all non-overlapping matches [(start, end, captures), ...].
+pub fn find_all(pat: &Pattern, chars: &[char]) -> Vec<(usize, usize, Captures)> {
+    let mut result = vec![];
+    let mut pos = 0;
+    while pos <= chars.len() {
+        match find_match(pat, chars, pos) {
+            Some((end, caps)) => {
+                result.push((pos, end, caps));
+                if end == pos {
+                    // zero-length match; advance by 1
+                    pos += 1;
+                } else {
+                    pos = end;
+                }
+            }
+            None => break,
+        }
+    }
+    result
+}
