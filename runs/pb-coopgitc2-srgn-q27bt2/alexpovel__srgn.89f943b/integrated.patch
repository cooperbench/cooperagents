++// expand a replacement string with capture groups: $1..$9, $name, $& (whole match)
++fn expand(replacement: &str, caps: &Captures, matched: &str, names: &[Option<String>], mstart: usize) -> String {
++    let mut out = String::new();
++    let chars: Vec<char> = replacement.chars().collect();
++    let mut k = 0;
++    while k < chars.len() {
++        match chars[k] {
++            '$' => {
++                if k + 1 >= chars.len() {
++                    out.push('$');
++                    k += 1;
++                    continue;
++                }
++                let next = chars[k + 1];
++                if next == '$' {
++                    out.push('$');
++                    k += 2;
++                } else if next.is_ascii_digit() {
++                    // read full number
++                    let mut num = 0usize;
++                    let mut m = k + 1;
++                    while m < chars.len() && chars[m].is_ascii_digit() {
++                        num = num * 10 + (chars[m] as u32 - '0' as u32) as usize;
++                        m += 1;
++                    }
++                    if let Some(s) = caps.starts.get(num).filter(|s| s.is_some()) {
++                        let st = s.unwrap() - mstart;
++                        let en = caps.ends.get(num).unwrap().unwrap() - mstart;
++                        out.push_str(&matched[st..en]);
++                    } else if num == 0 {
++                        out.push_str(matched);
++                    }
++                    k = m;
++                } else if next == '&' {
++                    out.push_str(matched);
++                    k += 2;
++                } else if next.is_alphabetic() || next == '_' {
++                    // named capture
++                    let mut name = String::new();
++                    let mut m = k + 1;
++                    while m < chars.len() && (chars[m].is_alphanumeric() || chars[m] == '_') {
++                        name.push(chars[m]);
++                        m += 1;
++                    }
++                    // find group with this name
++                    let mut found = false;
++                    for idx in 1..names.len() {
++                        if let Some(Some(nm)) = names.get(idx) {
++                            if nm == &name {
++                                if let Some(st) = caps.starts.get(idx).and_then(|s| *s) {
++                                    if let Some(en) = caps.ends.get(idx).and_then(|e| *e) {
++                                        out.push_str(&matched[st - mstart..en - mstart]);
++                                        found = true;
++                                    }
++                                }
++                            }
++                        }
++                    }
++                    if !found {
++                        // literal name fallback
++                        for c in name.chars() { out.push(c); }
++                    }
++                    k = m;
++                } else if next == '\\' {
++                    // escaped: keep next char literal
++                    k += 1;
++                    if k < chars.len() { out.push(chars[k]); }
++                    k += 1;
++                } else {
++                    out.push('$');
++                    k += 1;
++                }
++            }
++            '\\' if k + 1 < chars.len() => {
++                match chars[k + 1] {
++                    'n' => { out.push('\n'); k += 2; }
++                    't' => { out.push('\t'); k += 2; }
++                    'r' => { out.push('\r'); k += 2; }
++                    '0' => { out.push('\0'); k += 2; }
++                    c => { out.push(c); k += 2; }
++                }
++            }
++            c => { out.push(c); k += 1; }
++        }
++    }
++    out
++}
++
++fn titlecase(s: &str) -> String {
++    let mut out = String::new();
++    let mut at_word_start = true;
++    for c in s.chars() {
++        if c.is_alphanumeric() {
++            if at_word_start {
++                for up in c.to_uppercase() { out.push(up); }
++                at_word_start = false;
++            } else {
++                for lo in c.to_lowercase() { out.push(lo); }
++            }
++        } else {
++            out.push(c);
++            at_word_start = true;
++        }
++    }
++    out
++}
