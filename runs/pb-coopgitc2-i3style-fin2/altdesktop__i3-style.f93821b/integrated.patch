+fn load_theme_from_file(path: &str) -> Result<Theme, String> {
+    let content = fs::read_to_string(path)
+        .map_err(|e| format!("Could not open theme: {} - {}", path, e))?;
+    
+    let colors: HashMap<String, String> = HashMap::new();
+    let mut window_colors = WindowColors {
+        focused: Color { border: String::new(), background: String::new(), text: String::new(), indicator: String::new() },
+        focused_inactive: Color { border: String::new(), background: String::new(), text: String::new(), indicator: String::new() },
+        unfocused: Color { border: String::new(), background: String::new(), text: String::new(), indicator: String::new() },
+        urgent: Color { border: String::new(), background: String::new(), text: String::new(), indicator: String::new() },
+    };
+    let mut bar_colors = BarColors {
+        background: String::new(),
+        statusline: String::new(),
+        separator: String::new(),
+        focused_workspace: Color { border: String::new(), background: String::new(), text: String::new(), indicator: String::new() },
+        urgent_workspace: Color { border: String::new(), background: String::new(), text: String::new(), indicator: String::new() },
+    };
+    
+    let mut in_focused = false;
+    let mut in_focused_inactive = false;
+    let mut in_unfocused = false;
+    let mut in_urgent = false;
+    let mut in_bar_colors = false;
+    let mut in_focused_workspace = false;
+    let mut in_urgent_workspace = false;
+    
+    for line in content.lines() {
+        let line = line.trim();
+        
+        if line.starts_with("colors:") {
+            in_focused = false;
+            in_focused_inactive = false;
+            in_unfocused = false;
+            in_urgent = false;
+            continue;
+        }
+        
+        if line.starts_with("window_colors:") {
+            in_focused = false;
+            in_focused_inactive = false;
+            in_unfocused = false;
+            in_urgent = false;
+            continue;
+        }
+        
+        if line.starts_with("bar_colors:") {
+            in_bar_colors = true;
+            in_focused_workspace = false;
+            in_urgent_workspace = false;
+            continue;
+        }
+        
+        if line.starts_with("bar:") {
+            in_bar_colors = false;
+            continue;
+        }
+        
+        if in_focused {
+            if line.starts_with("    border:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused.border = val;
+            } else if line.starts_with("    background:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused.background = val;
+            } else if line.starts_with("    text:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused.text = val;
+            } else if line.starts_with("    indicator:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused.indicator = val;
+            }
+        } else if in_focused_inactive {
+            if line.starts_with("    border:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused_inactive.border = val;
+            } else if line.starts_with("    background:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused_inactive.background = val;
+            } else if line.starts_with("    text:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused_inactive.text = val;
+            } else if line.starts_with("    indicator:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.focused_inactive.indicator = val;
+            }
+        } else if in_unfocused {
+            if line.starts_with("    border:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.unfocused.border = val;
+            } else if line.starts_with("    background:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.unfocused.background = val;
+            } else if line.starts_with("    text:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.unfocused.text = val;
+            } else if line.starts_with("    indicator:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.unfocused.indicator = val;
+            }
+        } else if in_urgent {
+            if line.starts_with("    border:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.urgent.border = val;
+            } else if line.starts_with("    background:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.urgent.background = val;
+            } else if line.starts_with("    text:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.urgent.text = val;
+            } else if line.starts_with("    indicator:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                window_colors.urgent.indicator = val;
+            }
+        } else if in_bar_colors {
+            if line.starts_with("  background:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                bar_colors.background = val;
+            } else if line.starts_with("  statusline:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                bar_colors.statusline = val;
+            } else if line.starts_with("  separator:") {
+                let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                bar_colors.separator = val;
+            } else if line.starts_with("  focused_workspace:") {
+                in_focused_workspace = true;
+                in_urgent_workspace = false;
+                continue;
+            } else if line.starts_with("  urgent_workspace:") {
+                in_focused_workspace = false;
+                in_urgent_workspace = true;
+                continue;
+            }
+            
+            if in_focused_workspace {
+                if line.starts_with("    border:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.focused_workspace.border = val;
+                } else if line.starts_with("    background:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.focused_workspace.background = val;
+                } else if line.starts_with("    text:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.focused_workspace.text = val;
+                } else if line.starts_with("    indicator:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.focused_workspace.indicator = val;
+                }
+            } else if in_urgent_workspace {
+                if line.starts_with("    border:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.urgent_workspace.border = val;
+                } else if line.starts_with("    background:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.urgent_workspace.background = val;
+                } else if line.starts_with("    text:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.urgent_workspace.text = val;
+                } else if line.starts_with("    indicator:") {
+                    let val = line.split_whitespace().nth(1).unwrap_or("").trim().to_string();
+                    bar_colors.urgent_workspace.indicator = val;
+                }
+            }
+        }
+    }
+    
+    Ok(Theme { colors, window_colors, bar_colors })
+}
