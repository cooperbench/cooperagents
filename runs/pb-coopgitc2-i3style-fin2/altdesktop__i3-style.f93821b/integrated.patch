+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() < 2 {
+        print_help();
+        process::exit(1);
+    }
+    
+    let mut theme_arg = None;
+    let mut config_file = None;
+    let mut output_file = None;
+    let mut to_theme_file = None;
+    let mut reload = false;
+    let mut save = false;
+    let mut list_all = false;
+    
+    let mut i = 1;
+    while i < args.len() {
+        let arg = &args[i];
+        
+        if arg == "-h" || arg == "--help" {
+            print_help();
+            process::exit(0);
+        } else if arg == "-l" || arg == "--list-all" {
+            list_all = true;
+        } else if arg == "-r" || arg == "--reload" {
+            reload = true;
+        } else if arg == "-s" || arg == "--save" {
+            save = true;
+        } else if arg == "-V" || arg == "--version" {
+            print_version();
+            process::exit(0);
+        } else if arg == "-c" || arg == "--config" {
+            if i + 1 < args.len() {
+                config_file = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: -c requires a value");
+                process::exit(1);
+            }
+        } else if arg == "-o" || arg == "--output" {
+            if i + 1 < args.len() {
+                output_file = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: -o requires a value");
+                process::exit(1);
+            }
+        } else if arg == "-t" || arg == "--to-theme" {
+            if i + 1 < args.len() {
+                to_theme_file = Some(args[i + 1].clone());
+                i += 2;
+            } else {
+                eprintln!("error: -t requires a value");
+                process::exit(1);
+            }
+        } else {
+            theme_arg = Some(arg.clone());
+            i += 1;
+        }
+    }
+    
+    if list_all {
+        list_themes();
+        process::exit(0);
+    }
+    
+    let theme_name = theme_arg.as_deref().unwrap_or("default");
+    
+    let theme = match load_theme_from_file(&format!("themes/{}.theme", theme_name)) {
+        Ok(t) => t,
+        Err(e) => {
+            eprintln!("error: {}", e);
+            process::exit(1);
+        }
+    };
+    
+    let config_path = config_file.as_deref().unwrap_or(DEFAULT_CONFIG_PATH);
+    
+    let config = match fs::read_to_string(config_path) {
+        Ok(c) => c,
+        Err(e) => {
+            eprintln!("error: Could not open config: {} - {}", config_path, e);
+            process::exit(1);
+        }
+    };
+    
+    let result = apply_theme_to_config(&config, &theme);
+    
+    if let Some(ref output) = output_file {
+        if let Err(e) = fs::write(output, &result) {
+            eprintln!("error: Could not write to {}: {}", output, e);
+            process::exit(1);
+        }
+    } else if save {
+        if let Err(e) = fs::write(config_path, &result) {
+            eprintln!("error: Could not write to {}: {}", config_path, e);
+            process::exit(1);
+        }
+    } else if let Some(ref to_theme) = to_theme_file {
+        let theme_output = generate_theme_from_config();
+        if let Err(e) = fs::write(to_theme, &theme_output) {
+            eprintln!("error: Could not write to {}: {}", to_theme, e);
+            process::exit(1);
+        }
+    }
+    
+    if reload {
+        eprintln!("Reloading config...");
+    }
+}
+
+fn generate_theme_from_config() -> String {
+    let mut result = String::new();
+    result.push_str("colors:\n");
+    result.push_str("  focused:\n");
+    result.push_str("    border: \"#000000\"\n");
+    result.push_str("    background: \"#000000\"\n");
+    result.push_str("    text: \"#ffffff\"\n");
+    result.push_str("    indicator: \"#ffffff\"\n");
