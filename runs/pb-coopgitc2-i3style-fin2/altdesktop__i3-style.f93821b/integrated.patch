+    result.push_str("    background: \"#000000\"\n");
+    result.push_str("    text: \"#ffffff\"\n");
+    result.push_str("    indicator: \"#ffffff\"\n");
+    result.push_str("  urgent:\n");
+    result.push_str("    border: \"#000000\"\n");
+    result.push_str("    background: \"#000000\"\n");
+    result.push_str("    text: \"#ffffff\"\n");
+    result.push_str("    indicator: \"#ffffff\"\n");
+    result.push_str("bar_colors:\n");
+    result.push_str("  background: \"#000000\"\n");
+    result.push_str("  statusline: \"#000000\"\n");
+    result.push_str("  separator: \"#000000\"\n");
+    result.push_str("  focused_workspace:\n");
+    result.push_str("    border: \"#000000\"\n");
+    result.push_str("    background: \"#000000\"\n");
+    result.push_str("    text: \"#ffffff\"\n");
+    result.push_str("    indicator: \"#ffffff\"\n");
+    result.push_str("  urgent_workspace:\n");
+    result.push_str("    border: \"#000000\"\n");
+    result.push_str("    background: \"#000000\"\n");
+    result.push_str("    text: \"#ffffff\"\n");
+    result.push_str("    indicator: \"#ffffff\"\n");
+    result
+}
