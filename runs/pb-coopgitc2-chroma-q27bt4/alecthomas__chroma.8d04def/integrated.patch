+	return mkStyle("dracula", color{0x28, 0x2a, 0x36, 0xff}, color{0xff, 0xff, 0xff, 0xff}, e)
+}
+
+// default style lookup order; "swapoff" default doesn't exist as a file in chroma,
+// so default errors. We model that in run().
+func getStyle(name string) (*style, bool) {
+	m := buildStyles()
+	s, ok := m[name]
+	return s, ok
+}
+
+// lexAndFormat produces output for the given lexer + style + formatter.
+func (app *cliApp) lexAndFormat(src string, lexName, styleName, fmtName string) ([]byte, error) {
+	// tokenizer
+	var toks []token
+	switch lexName {
+	case "plaintext":
+		toks = plaintextLexer(src)
+	case "autodetect":
+		toks = autodetectLexer(src)
+	default:
+		toks = goLex(src)
+	}
+
+	switch fmtName {
+	case "terminal", "terminal16", "terminal16m", "terminal256", "terminal8":
+		return terminalFormat(app, toks, styleName, fmtName), nil
+	case "json", "jsonl":
+		return jsonFormat(toks, lexName, styleName), nil
+	case "tokens":
+		return tokensFormat(toks), nil
+	case "noop":
+		return []byte(src), nil
+	case "html":
+		return htmlFormat(app, toks, styleName), nil
+	case "svg":
+		return svgFormat(toks, styleName), nil
+	default:
+		return nil, fmt.Errorf("unknown formatter %q", fmtName)
+	}
+}
+
+// terminalFormat produces ANSI-colored output.
+func terminalFormat(app *cliApp, toks []token, styleName, fmtName string) []byte {
+	st := getStyleRaw(styleName)
+	var b strings.Builder
+	// write the raw text, wrapping styled runs.
+	for _, t := range toks {
+		if st == nil {
+			b.WriteString(t.Text)
+			continue
+		}
+		sgr := terminalSGR(st, t.Type, fmtName)
+		if sgr == "" {
+			b.WriteString(t.Text)
+			continue
+		}
+		text := t.Text
+		// chroma writes the colored text, then resets, then emits a
+		// trailing newline raw (unstyled).
+		if strings.HasSuffix(text, "\n") {
+			b.WriteString(sgr)
+			b.WriteString(text[:len(text)-1])
+			b.WriteString(resetSGR)
+			b.WriteString("\n")
+		} else {
+			b.WriteString(sgr)
+			b.WriteString(text)
+			b.WriteString(resetSGR)
+		}
+	}
+	return []byte(b.String())
+}
+
+// terminalSGR returns the SGR for a token type in a style.
+func terminalSGR(st *style, t tokenType, fmtName string) string {
+	e, ok := st.get(t)
+	if !ok {
+		// fall back to a few common mappings
+		e, ok = st.get(fallbackType(t))
+	}
+	if !ok || !e.Color.set() {
+		// try foreground
+		if st.foreground.set() {
+			e = styleEntry{Color: st.foreground}
+		} else {
+			return ""
+		}
+	}
+	return colorSGR(e.Color, e.Bold, e.Italic, fmtName)
+}
+
+// fallbackType maps a token type to a more general one.
+func fallbackType(t tokenType) tokenType {
+	switch t {
+	case NumberInteger, NumberFloat, NumberHex, NumberOct, NumberBin, NumberIntegerLong:
+		return Number
+	case StringInterpol, StringRegex, StringBacktick, StringEscape:
+		return String
+	case CommentHashbang, CommentMultiline, CommentSingle, CommentSpecial, CommentPreproc:
+		return Comment
+	case KeywordConstant, KeywordNamespace, KeywordPseudo, KeywordReserved, KeywordType:
+		return Keyword
+	case NameTag, NameAttribute, NameClass, NameConstant, NameDecorator, NameException, NameFunction, NameBuiltin, NameBuiltinPseudo, NameVariable:
+		return Name
+	default:
+		return t
+	}
+}
+
+// jsonFormat produces JSON output (approximation).
+func jsonFormat(toks []token, lexName, styleName string) []byte {
+	// Real chroma: json.NewEncoder(w).Encode(it) -> json.Marshal([]Token{...}) + newline.
+	// Tokens carry JSON keys "Type" and "Value"; output is compact (no indentation).
+	var b strings.Builder
+	b.WriteString("[")
+	for i, t := range toks {
+		if i > 0 {
+			b.WriteByte(',')
+		}
+		fmt.Fprintf(&b, "{\"Type\":%q,\"Value\":%q}", t.Type.name(), t.Text)
+	}
+	b.WriteString("]\n")
+	return []byte(b.String())
+}
+
+// tokensFormat produces &Token{...} output.
+func tokensFormat(toks []token) []byte {
+	var b strings.Builder
+	for _, t := range toks {
+		fmt.Fprintf(&b, "{Type: %q, Value: %q}\n", t.Type.name(), t.Text)
+	}
+	return []byte(b.String())
+}
+
+// htmlFormat produces HTML output.
+func htmlFormat(app *cliApp, toks []token, styleName string) []byte {
+	var b strings.Builder
+	b.WriteString(htmlHead(styleName))
+	for _, t := range toks {
+		cls := htmlClass(t.Type)
+		if cls != "" {
+			fmt.Fprintf(&b, "<span class=\"%s\">%s</span>", cls, htmlEscape(t.Text))
+		} else {
+			b.WriteString(htmlEscape(t.Text))
+		}
+	}
+	b.WriteString("</body>\n")
+	return []byte(b.String())
+}
+
+// htmlClass maps a token type to its CSS class (chroma convention: short codes).
+func htmlClass(t tokenType) string {
+	switch t {
+	case Keyword, KeywordPseudo, KeywordReserved:
+		return "k"
+	case KeywordNamespace, KeywordConstant, KeywordType:
+		return "kn"
+	case NameFunction:
+		return "nf"
+	case NameBuiltin, NameBuiltinPseudo:
+		return "nb"
+	case NameClass, NameNamespace, NameException, NameTag:
+		return "nc"
+	case NameOther, NameVariable:
+		return "nn"
+	case String, StringInterpol, StringRegex, StringBacktick, StringEscape:
+		return "s"
+	case Number, NumberInteger, NumberFloat, NumberHex, NumberOct, NumberBin, NumberIntegerLong:
+		return "m"
+	case Operator:
+		return "o"
+	case OperatorWord:
+		return "ow"
+	case Punctuation:
+		return "p"
+	case Comment, CommentSingle, CommentMultiline, CommentHashbang, CommentSpecial, CommentPreproc:
+		return "c"
+	case Text, Other:
+		return ""
+	default:
+		return ""
+	}
+}
+
+// htmlEscape escapes a string for HTML.
+func htmlEscape(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '&':
+			b.WriteString("&amp;")
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// htmlHead produces the HTML head + opening body with the style's CSS.
+func htmlHead(styleName string) string {
+	return "<!DOCTYPE html>\n<html>\n<head>\n<style>\n" + htmlCSS(styleName) + "</style>\n</head>\n<body>\n"
+}
+
+// svgFormat produces SVG output.
+func svgFormat(toks []token, styleName string) []byte {
+	st, ok := getStyle(styleName)
+	var b strings.Builder
+	b.WriteString("<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" style=\"font-family:monospace;font-size:12px;background:#000000\" viewBox=\"0 0 100 100\">\n")
+	var x float64 = 0
+	for _, t := range toks {
+		fill := "#000000"
+		if ok {
+			e, _ := st.get(t.Type)
+			if e.Color.set() {
+				fill = colorName(e.Color)
+			}
+		}
+		fmt.Fprintf(&b, "<text x=\"%.0f\" y=\"12\" fill=\"%s\">\n", x, fill)
+		fmt.Fprintf(&b, "%s</text>\n", htmlEscape(t.Text))
+		x += float64(len(t.Text)) * 7
+	}
+	b.WriteString("</svg>\n")
+	return []byte(b.String())
+}
+
+// getStyleRaw returns the style (nil if default swapoff).
+func getStyleRaw(name string) *style {
+	s, _ := getStyle(name)
+	return s
+}
+
+// run executes the highlighter.
+func (app *cliApp) run() error {
+	styleName := app.style
+	st, ok := getStyle(styleName)
+	if !ok {
+		return fmt.Errorf("open %s: no such file or directory", styleName)
+	}
+	_ = st
+
+	fmtr := app.formatter
+	if fmtr == "" {
+		fmtr = "terminal"
+	}
+	if app.json {
+		fmtr = "json"
+	}
+	if app.html {
+		fmtr = "html"
+	}
+	if app.svg {
+		fmtr = "svg"
+	}
+
+	// gather input
+	var src string
+	if len(app.files) > 0 {
+		for _, f := range app.files {
+			data, err := os.ReadFile(f)
+			if err != nil {
+				return err
+			}
+			src += string(data)
+		}
+	} else {
+		data, err := io.ReadAll(os.Stdin)
+		if err != nil {
+			return err
+		}
+		src = string(data)
+	}
+
+	lexName := app.lexer
+	if lexName == "" {
+		lexName = "autodetect"
+	}
+
+	out, err := app.lexAndFormat(src, lexName, styleName, fmtr)
+	if err != nil {
+		return err
+	}
+	fmt.Fprint(os.Stdout, string(out))
+	return nil
+}
+
+// atoiDefault parses s as an int, returning def if s is empty or invalid.
+func atoiDefault(s string, def int) int {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return def
+	}
+	n, err := strconv.Atoi(s)
+	if err != nil {
+		return def
+	}
+	return n
+}
+
+// autodetectLexer picks a lexer heuristically. For most inputs the go lexer is
+// a reasonable default; otherwise fall back to plaintext.
+func autodetectLexer(src string) []token {
+	// cheap heuristic: looks like Go?
+	if strings.Contains(src, "package ") || strings.Contains(src, "func ") || strings.Contains(src, "import ") || strings.Contains(src, "var ") {
+		return goLex(src)
+	}
+	return plaintextLexer(src)
+}
+
+// htmlCSS produces the CSS for a style (approximation of chroma's output).
+func htmlCSS(styleName string) string {
+	st, ok := getStyle(styleName)
+	if !ok {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString(".chroma {\n")
+	b.WriteString(fmt.Sprintf("  color: %s;\n", colorName(st.foreground)))
+	b.WriteString(fmt.Sprintf("  background-color: %s;\n", colorName(st.Background)))
+	b.WriteString("}\n")
+	for _, t := range []tokenType{
+		Keyword, KeywordConstant, KeywordNamespace, KeywordPseudo, KeywordType,
+		NameFunction, NameBuiltin, NameClass, NameNamespace, NameException,
+		NameOther, String, Number, Operator, OperatorWord, Comment, Text,
+	} {
+		e, ok := st.get(t)
+		if !ok {
+			e, ok = st.get(fallbackType(t))
+		}
+		if !ok || !e.Color.set() {
+			continue
+		}
+		fmt.Fprintf(&b, ".chroma.%s {\n", htmlClass(t))
+		fmt.Fprintf(&b, "  color: %s;\n", colorName(e.Color))
+		if e.Bold {
+			b.WriteString("  font-weight: bold;\n")
+		}
+		if e.Italic {
+			b.WriteString("  font-style: italic;\n")
+		}
+		b.WriteString("}\n")
+	}
+	return b.String()
+}
+
+// colorName formats a color as a CSS hex color (without alpha).
+func colorName(c color) string {
+	return fmt.Sprintf("#%02x%02x%02x", c.R, c.G, c.B)
+}
