+package main
+
+import (
+	"fmt"
+	"io"
+	"strings"
+)
+
+// htmlFormatter renders source in the chroma HTML format: an <html> document
+// containing a <style type="text/css"> block with the active style's CSS
+// followed by a <pre class="chroma"><code> block holding the highlighted code.
+type htmlFormatter struct{}
+
+// monokaiHTMLCSS is the verbatim CSS block that the original emits for the
+// monokai style (the default). It is emitted inside <style type="text/css">.
+const monokaiHTMLCSS = `/* Background */ .bg { color: #f8f8f2; background-color: #272822; }
+/* PreWrapper */ .chroma { color: #f8f8f2; background-color: #272822; -webkit-text-size-adjust: none; }
+/* Error */ .chroma .err { color: #960050; background-color: #1e0010 }
+/* LineLink */ .chroma .lnlinks { outline: none; text-decoration: none; color: inherit }
+/* LineTableTD */ .chroma .lntd { vertical-align: top; padding: 0; margin: 0; border: 0; }
+/* LineTable */ .chroma .lntable { border-spacing: 0; padding: 0; margin: 0; border: 0; }
+/* LineHighlight */ .chroma .hl { background-color: #3c3d38 }
+/* LineNumbersTable */ .chroma .lnt { white-space: pre; -webkit-user-select: none; user-select: none; margin-right: 0.4em; padding: 0 0.4em 0 0.4em;color: #7f7f7f }
+/* LineNumbers */ .chroma .ln { white-space: pre; -webkit-user-select: none; user-select: none; margin-right: 0.4em; padding: 0 0.4em 0 0.4em;color: #7f7f7f }
+/* Line */ .chroma .line { display: flex; }
+/* Keyword */ .chroma .k { color: #66d9ef }
+/* KeywordConstant */ .chroma .kc { color: #66d9ef }
+/* KeywordDeclaration */ .chroma .kd { color: #66d9ef }
+/* KeywordNamespace */ .chroma .kn { color: #f92672 }
+/* KeywordPseudo */ .chroma .kp { color: #66d9ef }
+/* KeywordReserved */ .chroma .kr { color: #66d9ef }
+/* KeywordType */ .chroma .kt { color: #66d9ef }
+/* NameAttribute */ .chroma .na { color: #a6e22e }
+/* NameClass */ .chroma .nc { color: #a6e22e }
+/* NameConstant */ .chroma .no { color: #66d9ef }
+/* NameDecorator */ .chroma .nd { color: #a6e22e }
+/* NameException */ .chroma .ne { color: #a6e22e }
+/* NameOther */ .chroma .nx { color: #a6e22e }
+/* NameTag */ .chroma .nt { color: #f92672 }
+/* NameFunction */ .chroma .nf { color: #a6e22e }
+/* NameFunctionMagic */ .chroma .fm { color: #a6e22e }
+/* Literal */ .chroma .l { color: #ae81ff }
+/* LiteralDate */ .chroma .ld { color: #e6db74 }
+/* LiteralString */ .chroma .s { color: #e6db74 }
+/* LiteralStringAffix */ .chroma .sa { color: #e6db74 }
+/* LiteralStringBacktick */ .chroma .sb { color: #e6db74 }
+/* LiteralStringChar */ .chroma .sc { color: #e6db74 }
+/* LiteralStringDelimiter */ .chroma .dl { color: #e6db74 }
+/* LiteralStringDoc */ .chroma .sd { color: #e6db74 }
+/* LiteralStringDouble */ .chroma .s2 { color: #e6db74 }
+/* LiteralStringEscape */ .chroma .se { color: #ae81ff }
+/* LiteralStringHeredoc */ .chroma .sh { color: #e6db74 }
+/* LiteralStringInterpol */ .chroma .si { color: #e6db74 }
+/* LiteralStringOther */ .chroma .sx { color: #e6db74 }
+/* LiteralStringRegex */ .chroma .sr { color: #e6db74 }
+/* LiteralStringSingle */ .chroma .s1 { color: #e6db74 }
+/* LiteralStringSymbol */ .chroma .ss { color: #e6db74 }
+/* LiteralNumber */ .chroma .m { color: #ae81ff }
+/* LiteralNumberBin */ .chroma .mb { color: #ae81ff }
+/* LiteralNumberFloat */ .chroma .mf { color: #ae81ff }
+/* LiteralNumberHex */ .chroma .mh { color: #ae81ff }
+/* LiteralNumberInteger */ .chroma .mi { color: #ae81ff }
+/* LiteralNumberIntegerLong */ .chroma .il { color: #ae81ff }
+/* LiteralNumberOct */ .chroma .mo { color: #ae81ff }
+/* Operator */ .chroma .o { color: #f92672 }
+/* OperatorWord */ .chroma .ow { color: #f92672 }
+/* OperatorReserved */ .chroma .or { color: #f92672 }
+/* Comment */ .chroma .c { color: #75715e }
+/* CommentHashbang */ .chroma .ch { color: #75715e }
+/* CommentMultiline */ .chroma .cm { color: #75715e }
+/* CommentSingle */ .chroma .c1 { color: #75715e }
+/* CommentSpecial */ .chroma .cs { color: #75715e }
+/* CommentPreproc */ .chroma .cp { color: #75715e }
+/* CommentPreprocFile */ .chroma .cpf { color: #75715e }
+/* GenericDeleted */ .chroma .gd { color: #f92672 }
+/* GenericEmph */ .chroma .ge { font-style: italic }
+/* GenericInserted */ .chroma .gi { color: #a6e22e }
+/* GenericStrong */ .chroma .gs { font-weight: bold }
+/* GenericSubheading */ .chroma .gu { color: #75715e }
+body { color:#f8f8f2;background-color:#272822;; }
+`
+
+// htmlClass maps a chroma token type string to its CSS class name (the chroma
+// HTML formatter convention). Types with no entry are emitted without a class.
+var htmlClass = map[string]string{
+	"Text": "",
+	"Comment": "c",
+	"Comment.Hashbang": "ch",
+	"Comment.Multiline": "cm",
+	"Comment.Preproc": "cp",
+	"Comment.PreprocFile": "cpf",
+	"Comment.Special": "cs",
+	"Comment.Single": "c1",
+	"Keyword": "k",
+	"Keyword.Constant": "kc",
+	"Keyword.Declaration": "kd",
+	"Keyword.Namespace": "kn",
+	"Keyword.Pseudo": "kp",
+	"Keyword.Reserved": "kr",
+	"Keyword.Type": "kt",
+	"Literal": "l",
+	"Literal.Date": "ld",
+	"Literal.String": "s",
+	"Literal.String.Affix": "sa",
+	"Literal.String.Backtick": "sb",
+	"Literal.String.Char": "sc",
+	"Literal.String.Delimiter": "dl",
+	"Literal.String.Doc": "sd",
+	"Literal.String.Double": "s2",
+	"Literal.String.Escape": "se",
+	"Literal.String.Heredoc": "sh",
+	"Literal.String.Interpol": "si",
+	"Literal.String.Other": "sx",
+	"Literal.String.Regex": "sr",
+	"Literal.String.Single": "s1",
+	"Literal.String.Symbol": "ss",
+	"Literal.Number": "m",
+	"Literal.Number.Bin": "mb",
+	"Literal.Number.Float": "mf",
+	"Literal.Number.Hex": "mh",
+	"Literal.Number.Integer": "mi",
+	"Literal.Number.IntegerLong": "il",
+	"Literal.Number.Oct": "mo",
+	"Name": "n",
+	"Name.Attribute": "na",
+	"Name.Builtin": "nb",
+	"Name.Builtin.Pseudo": "bp",
+	"Name.Class": "nc",
+	"Name.Constant": "no",
+	"Name.Decorator": "nd",
+	"Name.Exception": "ne",
+	"Name.Function": "nf",
+	"Name.Function.Magic": "fm",
+	"Name.Namespace": "nn",
+	"Name.Other": "nx",
+	"Name.Property": "py",
+	"Name.Tag": "nt",
+	"Name.Variable": "nv",
+	"Operator": "o",
+	"Operator.Word": "ow",
+	"Operator.Reserved": "or",
+	"Punctuation": "p",
+	"Generic.Deleted": "gd",
+	"Generic.Emph": "ge",
+	"Generic.Inserted": "gi",
+	"Generic.Strong": "gs",
+	"Generic.Subheading": "gu",
+}
+
+func (htmlFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
+	var b strings.Builder
+	b.WriteString("<html>\n")
+	b.WriteString("<style type=\"text/css\">\n")
+	b.WriteString(monokaiHTMLCSS)
+	b.WriteString("</style>")
+	b.WriteString("<body class=\"bg\">\n")
+	b.WriteString("<pre class=\"chroma\"><code>")
+	b.WriteString("<span class=\"line\"><span class=\"cl\">")
+
+	for _, tk := range toks {
+		cls, ok := htmlClass[tk.t]
+		if !ok {
+			cls = ""
+		}
+		segs := strings.Split(tk.v, "\n")
+		for i, seg := range segs {
+			if i > 0 {
+				// this segment follows a newline
+				b.WriteString("\n")
+				b.WriteString("</span></span>")
+				b.WriteString("<span class=\"line\"><span class=\"cl\">")
+			}
+			if seg == "" {
+				continue
+			}
+			if cls != "" {
+				b.WriteString("<span class=\"")
+				b.WriteString(cls)
+				b.WriteString("\">")
+				b.WriteString(htmlEscape(seg))
+				b.WriteString("</span>")
+			} else {
+				b.WriteString(htmlEscape(seg))
+			}
+		}
+	}
+
+	b.WriteString("</span></span>")
+	b.WriteString("</code></pre>\n")
+	b.WriteString("</body>\n")
+	b.WriteString("</html>\n")
+	_, err := io.WriteString(w, b.String())
+	return err
+}
+
+func htmlEscape(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+var _ = fmt.Sprint
diff --git a/chroma_src/formatters.go b/chroma_src/formatters.go
new file mode 100644
index 0000000..084174c
--- /dev/null
+++ b/chroma_src/formatters.go
@@ -0,0 +1,235 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"strings"
+)
+
+// formatter renders the lexed+styled tokens to a writer.
+type formatter interface {
+	format(w io.Writer, st *style, toks tokens, src string) error
+}
+
+// displayType maps the internal dotted token type (e.g. "Name.Class") to the
+// display name used by the json and tokens formatters (e.g. "NameClass").
+func displayType(t string) string {
+	return strings.ReplaceAll(t, ".", "")
+}
+
+// escapeSeq returns the ANSI escape that activates c's attributes for the base
+// "terminal"/"terminal8" formatters. For {fg:"37",bold:true} this is
+// "\x1b[1m\x1b[37m".
+func escapeSeq(c colorSpec) string {
+	var b strings.Builder
+	if c.bold {
+		b.WriteString("\x1b[1m")
+	}
+	if c.italic {
+		b.WriteString("\x1b[3m")
+	}
+	if c.uline {
+		b.WriteString("\x1b[4m")
+	}
+	if c.fg != "" {
+		b.WriteString("\x1b[" + c.fg + "m")
+	}
+	if c.bg != "" {
+		b.WriteString("\x1b[" + c.bg + "m")
+	}
+	return b.String()
+}
+
+// monokaiRGB maps a monokai (8-color fg, bold) pair to its 24-bit RGB and
+// 256-palette index, used by the terminal16m and terminal256 formatters. The
+// bold flag disambiguates the two yellow/white pairs.
+func monokaiRGB(c colorSpec) ([3]uint8, byte) {
+	switch {
+	case c.fg == "37" && c.bold:
+		return [3]uint8{248, 248, 242}, 231
+	case c.fg == "33" && c.bold:
+		return [3]uint8{166, 226, 46}, 148
+	case c.fg == "36" && c.bold:
+		return [3]uint8{102, 217, 239}, 81
+	case c.fg == "31" && c.bold:
+		return [3]uint8{249, 38, 114}, 197
+	case c.fg == "30" && c.bold:
+		return [3]uint8{117, 113, 94}, 242
+	case c.fg == "33" && !c.bold:
+		return [3]uint8{174, 129, 255}, 141
+	case c.fg == "37" && !c.bold:
+		return [3]uint8{230, 219, 116}, 186
+	default:
+		return [3]uint8{248, 248, 242}, 231
+	}
+}
+
+// variantEscape returns the escape sequence for color c in the given terminal
+// variant. The base "terminal"/"terminal8" use the bold+8-color model; the
+// "terminal16" variant uses bright colors for bold tokens; the "terminal16m"
+// and "terminal256" variants use 24-bit RGB and 256-palette codes (no bold).
+func variantEscape(c colorSpec, variant string) string {
+	switch variant {
+	case "terminal16":
+		if c.bold {
+			// bright: 30->90 .. 37->97
+			if len(c.fg) == 2 {
+				return "\x1b[9" + c.fg[1:] + "m"
+			}
+			return "\x1b[" + c.fg + "m"
+		}
+		if c.fg != "" {
+			return "\x1b[" + c.fg + "m"
+		}
+		return ""
+	case "terminal16m":
+		rgb, _ := monokaiRGB(c)
+		return fmt.Sprintf("\x1b[38;2;%d;%d;%dm", rgb[0], rgb[1], rgb[2])
+	case "terminal256":
+		_, c256 := monokaiRGB(c)
+		return fmt.Sprintf("\x1b[38;5;%dm", c256)
+	default:
+		return escapeSeq(c)
+	}
+}
+
+// terminalWriter is the ANSI "closed" model: a style span is opened with an
+// escape sequence and closed with "\x1b[0m"; newlines are written after the
+// span is closed.
+type terminalWriter struct {
+	w       io.Writer
+	esc     string
+	open    bool
+	variant string
+}
+
+func (tw *terminalWriter) openSpan() {
+	if !tw.open {
+		tw.w.Write([]byte(tw.esc))
+		tw.open = true
+	}
+}
+
+func (tw *terminalWriter) closeSpan() {
+	if tw.open {
+		tw.w.Write([]byte("\x1b[0m"))
+		tw.open = false
+	}
+}
+
+// writeToken writes a single token's value, opening/closing the style span
+// and handling embedded newlines so that each line's newline sits outside the
+// span. Bytes are emitted one at a time so a newline inside the value always
+// triggers a span close/reopen.
+func (tw *terminalWriter) writeToken(c colorSpec, v string) {
+	tw.esc = variantEscape(c, tw.variant)
+	tw.openSpan()
+	for i := 0; i < len(v); i++ {
+		ch := v[i]
+		if ch == '\n' {
+			tw.closeSpan()
+			tw.w.Write([]byte("\n"))
+			continue
+		}
+		tw.openSpan()
+		tw.w.Write([]byte{ch})
+	}
+	tw.closeSpan()
+}
+
+// terminalFormatter writes ANSI-colored output. The variant selects the color
+// encoding: base "terminal"/"terminal8" use bold+8-color, while
+// "terminal16"/"terminal16m"/"terminal256" use bright/RGB/256 codes.
+type terminalFormatter struct {
+	variant string
+}
+
+func (tf terminalFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
+	tw := &terminalWriter{w: w, variant: tf.variant}
+	for _, t := range toks {
+		c, _ := styleFor(st, t.t)
+		tw.writeToken(c, t.v)
+	}
+	return nil
+}
+
+// jsonFormatter writes a JSON array of {type, value} pairs (one per token).
+// The type is the undotted display name.
+type jsonFormatter struct{}
+
+func (jsonFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
+	w.Write([]byte("[\n"))
+	for i, t := range toks {
+		if i > 0 {
+			w.Write([]byte(",\n"))
+		}
+		fmt.Fprintf(w, `  {"type":"%s","value":%s}`, displayType(t.t), jsonQuote(t.v))
+	}
+	w.Write([]byte("\n]\n"))
+	return nil
+}
+
+func jsonQuote(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch r {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\t':
+			b.WriteString(`\t`)
+		case '\r':
+			b.WriteString(`\r`)
+		default:
+			if r < 0x20 {
+				fmt.Fprintf(&b, `\u%04x`, int(r))
+			} else {
+				b.WriteRune(r)
+			}
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// tokensFormatter writes each token as a Go-style "&Token{Type, \"value\"}"
+// line, using the undotted display name for the type.
+type tokensFormatter struct{}
+
+func (tokensFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
+	for _, t := range toks {
+		fmt.Fprintf(w, "&Token{%s, %q}\n", displayType(t.t), t.v)
+	}
+	return nil
+}
+
+// noopFormatter writes the source verbatim.
+type noopFormatter struct{}
+
+func (noopFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
+	_, err := w.Write([]byte(src))
+	return err
+}
+
+// makeFormatter selects the formatter by name.
+func makeFormatter(f *flags) formatter {
+	switch f.formatter {
+	case "json":
+		return jsonFormatter{}
+	case "tokens":
+		return tokensFormatter{}
+	case "noop":
+		return noopFormatter{}
+	case "terminal", "terminal8", "terminal16", "terminal16m", "terminal256":
+		return terminalFormatter{variant: f.formatter}
+	case "html":
+		return terminalFormatter{variant: "terminal"}
+	case "svg":
+		return terminalFormatter{variant: "terminal"}
+	}
+	return terminalFormatter{variant: "terminal"}
+}
