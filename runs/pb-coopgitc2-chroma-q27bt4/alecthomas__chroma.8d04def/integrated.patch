diff --git a/chroma/core.go b/chroma/core.go
new file mode 100644
index 0000000..9b61e98
--- /dev/null
+++ b/chroma/core.go
@@ -0,0 +1,64 @@
+package chroma
+
+import (
+	"io"
+)
+
+// TokenType is a category of lexical token.
+type TokenType string
+
+// Style is the styling of a token type (foreground colour etc).
+type Style struct {
+	Color  string
+	Style  string
+	IsSet  bool
+}
+
+// Token is a single lexed token.
+type Token struct {
+	Type  TokenType
+	Value string
+}
+
+// Lexer produces tokens from an input source.
+type Lexer interface {
+	// Name returns the name of the lexer.
+	Name() string
+	// Aliases returns the aliases for the lexer.
+	Aliases() []string
+	// Filenames returns the filenames for the lexer.
+	Filenames() []string
+	// Mimetypes returns the mimetypes for the lexer.
+	Mimetypes() []string
+	// Lex lexes the input and emits tokens to out.
+	Lex(r io.Reader, out chan Token)
+}
+
+// Formatter writes the tokens in a particular format.
+type Formatter interface {
+	// Format takes an iterator of tokens and writes them to w.
+	Format(w io.Writer, it Iterator) error
+	// Name returns the name of the formatter.
+	Name() string
+	// FormatterType returns the type of the formatter.
+	FormatterType() FormatterType
+}
+
+// FormatterType is the type of a formatter.
+type FormatterType int
+
+const (
+	// Terminal is a terminal formatter.
+	Terminal FormatterType = iota
+	// JSON is a JSON formatter.
+	JSON
+	// HTML is an HTML formatter.
+	HTML
+	// SVG is an SVG formatter.
+	SVG
+	// XML is an XML formatter.
+	XML
+)
+
+// StyleSet is the set of styles for a given style.
+type StyleSet map[TokenType]Style
