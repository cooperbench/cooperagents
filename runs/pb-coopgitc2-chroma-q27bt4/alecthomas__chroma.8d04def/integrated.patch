new file mode 100644
index 0000000..3669a23
--- /dev/null
+++ b/chroma_src/styles.go
@@ -0,0 +1,77 @@
+package main
+
+// colorSpec describes a single style entry.
+type colorSpec struct {
+	fg     string
+	bg     string
+	bold   bool
+	italic bool
+	uline  bool
+}
+
+// style is a map from token type -> colorSpec.
+type style map[string]colorSpec
+
+// monokai is the (only) built-in style with a fully populated color table.
+var monokaiStyle = &style{
+	"Text":                 colorSpec{fg: "37", bold: true},
+	"Name":               colorSpec{fg: "37", bold: true},
+	"Name.Function":      colorSpec{fg: "33", bold: true},
+	"Name.Class":         colorSpec{fg: "33", bold: true},
+	"Name.Namespace":     colorSpec{fg: "37", bold: true},
+	"Keyword":            colorSpec{fg: "36", bold: true},
+	"Keyword.Constant":   colorSpec{fg: "36", bold: true},
+	"Keyword.Namespace":  colorSpec{fg: "31", bold: true},
+	"Operator":           colorSpec{fg: "31", bold: true},
+	"Operator.Word":      colorSpec{fg: "31", bold: true},
+	"Punctuation":        colorSpec{fg: "37", bold: true},
+	"Literal":            colorSpec{fg: "37"},
+	"Literal.Number":     colorSpec{fg: "33"},
+	"Literal.Number.Integer": colorSpec{fg: "33"},
+	"Literal.Number.Float":   colorSpec{fg: "33"},
+	"Literal.Number.Hex":     colorSpec{fg: "33"},
+	"Literal.Number.Bin":     colorSpec{fg: "33"},
+	"Literal.String":     colorSpec{fg: "37"},
+	"Literal.String.Double": colorSpec{fg: "37"},
+	"Literal.String.Affix": colorSpec{fg: "37"},
+	"Literal.String.Single": colorSpec{fg: "37"},
+	"Comment":          colorSpec{fg: "30", bold: true},
+	"Comment.Single":   colorSpec{fg: "30", bold: true},
+}
+
+// styles maps a style name to its color table. "swapoff" is intentionally
+// absent (it is not loadable in the original binary).
+var styles = map[string]*style{
+	"monokai": monokaiStyle,
+}
+
+// styleFor returns the color spec for token type t, walking up parent types
+// (Literal.Number.Integer -> Literal.Number -> Literal) and finally falling
+// back to the default "Text" entry.
+func styleFor(st *style, t string) (colorSpec, bool) {
+	for {
+		if c, ok := (*st)[t]; ok {
+			return c, true
+		}
+		i := lastIndexByte(t, '.')
+		if i < 0 {
+			break
+		}
+		t = t[:i]
+	}
+	if c, ok := (*st)["Text"]; ok {
+		return c, true
+	}
+	return colorSpec{}, false
+}
+
+func lastIndexByte(s string, b byte) int {
+	for i := len(s) - 1; i >= 0; i-- {
+		if s[i] == b {
+			return i
+		}
+	}
+	return -1
+}
+
+var _ = colorSpec{}
