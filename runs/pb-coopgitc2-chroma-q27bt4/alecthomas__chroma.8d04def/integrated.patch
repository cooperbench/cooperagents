++package main
++
++import (
++	"bytes"
++	"io"
++	"os"
++)
++
++// token type
++const (
++	tText         = "Text"
++	tComment      = "Comment"
++	tKeyword      = "Keyword"
++	tOperator     = "Operator"
++	tNumber       = "Number"
++	tString       = "String"
++	tName         = "Name"
++	tNameFunction = "Name.Function"
++	tNameClass    = "Name.Class"
++	tLiteral      = "Literal"
++	tConstant     = "Literal.String"
++	tPunct        = "Punctuation"
++)
++
++type token struct {
++	t string
++	v string
++}
++
++type tokens []token
++
++type lexer struct {
++	name     string
++	tokenize func(s string) tokens
++}
++
++// fallbackLexer is used when -l is an unknown name.
++var fallbackLexer = &lexer{name: "plaintext", tokenize: func(s string) tokens { return tokens{{tText, s}} }}
++
++// --- registered style set (all --list styles EXCEPT swapoff, which fails) ---
++var registeredStyleSet = map[string]bool{
++	"abap": true, "algol": true, "algol_nu": true, "arduino": true, "ashen": true,
++	"aura-theme-dark": true, "aura-theme-dark-soft": true, "autumn": true, "average": true,
++	"base16-snazzy": true, "borland": true, "bw": true, "catppuccin-frappe": true,
++	"catppuccin-latte": true, "catppuccin-macchiato": true, "catppuccin-mocha": true,
++	"colorful": true, "darcula": true, "doom-one": true, "doom-one2": true, "dracula": true,
++	"emacs": true, "evergarden": true, "friendly": true, "fruity": true, "github": true,
++	"github-dark": true, "gruvbox": true, "gruvbox-light": true, "hr_high_contrast": true,
++	"hrdark": true, "igor": true, "kanagawa-dragon": true, "kanagawa-lotus": true,
++	"kanagawa-wave": true, "lovelace": true, "manni": true, "modus-operandi": true,
++	"modus-vivendi": true, "monokai": true, "monokailight": true, "murphy": true,
++	"native": true, "nord": true, "nordic": true, "onedark": true, "onesenterprise": true,
++	"paraiso-dark": true, "paraiso-light": true, "pastie": true, "perldoc": true,
++	"pygments": true, "rainbow_dash": true, "rose-pine": true, "rose-pine-dawn": true,
++	"rose-pine-moon": true, "rpgle": true, "rrt": true, "solarized-dark": true,
++	"solarized-dark256": true, "solarized-light": true, "tango": true, "tokyonight-day": true,
++	"tokyonight-moon": true, "tokyonight-night": true, "tokyonight-storm": true,
++	"trac": true, "vim": true, "vs": true, "vulcan": true, "witchhazel": true,
++	"xcode": true, "xcode-dark": true,
++}
++
++func registeredStyle(s string) bool { return registeredStyleSet[s] }
++
++var lexers = map[string]*lexer{}
++
++func findLexer(name string) *lexer {
++	if name == "autodetect" {
++		return nil // handle in runInput via content/filename
++	}
++	if l, ok := lexers[name]; ok {
++		return l
++	}
++	return nil
++}
++
++// runInput reads input and formats output.
++func runInput(f *flags, lex *lexer, form formatter) error {
++	// read all input
++	var src string
++	if len(f.files) == 0 || (len(f.files) == 1 && f.files[0] == "-") {
++		data, err := io.ReadAll(os.Stdin)
++		if err != nil {
++			return err
++		}
++		src = string(data)
++	} else {
++		for _, fn := range f.files {
++			data, err := os.ReadFile(fn)
++			if err != nil {
++				return err
++			}
++			src += string(data)
++		}
++	}
++	out := fmtHighlight(f, src, lex)
++	os.Stdout.Write(out)
++	return nil
++}
++
++// resolveStylePtr returns the *style for f.style. Only monokai is populated;
++// any other (registered-but-unpopulated, or a file path) falls back to it so
++// the formatter always has a non-nil style.
++func resolveStylePtr(f *flags) *style {
++	if st, ok := styles[f.style]; ok {
++		return st
++	}
++	return monokaiStyle
++}
++
++// fmtHighlight lexes src with lex and formats it with the formatter selected by
++// f, returning the rendered bytes.
++func fmtHighlight(f *flags, src string, lex *lexer) []byte {
++	toks := lex.tokenize(src)
++	st := resolveStylePtr(f)
++	var buf bytes.Buffer
++	form := makeFormatter(f)
++	form.format(&buf, st, toks, src)
++	return buf.Bytes()
++}
