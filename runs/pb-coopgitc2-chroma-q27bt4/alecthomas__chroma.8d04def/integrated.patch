++	"fmt"
++	"os"
++)
++
++func doHighlight(f *flags) error {
++	if err := resolveStyle(f); err != nil {
++		return err
++	}
++	lex := resolveLexer(f)
++	form, ferr := getFormatter(f)
++	if ferr != nil {
++		return ferr
++	}
++	return runInput(f, lex, form)
++}
++
++// resolveStyle loads the style named f.style. Unknown built-in styles and the
++// default "swapoff" are treated as file paths and fail with an open error.
++func resolveStyle(f *flags) error {
++	st := f.style
++	if registeredStyle(st) {
++		return nil
++	}
++	if _, err := os.Stat(st); err == nil {
++		return nil
++	}
++	return fmt.Errorf("open %s: no such file or directory", st)
++}
++
++func resolveLexer(f *flags) *lexer {
++	if l := findLexer(f.lexer); l != nil {
++		return l
++	}
++	return fallbackLexer
++}
++
++func getFormatter(f *flags) (formatter, error) {
++	switch f.formatter {
++	case "html", "json", "noop", "svg", "terminal", "terminal16", "terminal16m", "terminal256", "terminal8", "tokens":
++		return nil, nil
++	}
++	list := "\"html\",\"json\",\"noop\",\"svg\",\"terminal\",\"terminal16\",\"terminal16m\",\"terminal256\",\"terminal8\",\"tokens\""
++	return nil, fmt.Errorf("--formatter must be one of %s but got %q", list, f.formatter)
++}
