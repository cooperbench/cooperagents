index 0000000..65f06cb
--- /dev/null
+++ b/cmd/chroma/main.go
@@ -0,0 +1,119 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// programName is the basename of the executable, used in error messages.
+var programName = filepath.Base(os.Args[0])
+
+// cliApp holds the parsed command-line state.
+type cliApp struct {
+	// flags
+	help       bool
+	version    bool
+	list       bool
+	unbuffered bool
+	trace      bool
+	check      bool
+	filename   string
+	fail       bool
+	lexer      string
+	style      string
+	formatter  string
+	json       bool
+	html       bool
+	svg        bool
+
+	// html options
+	htmlPrefix         string
+	htmlStyles         bool
+	htmlAllStyles      bool
+	htmlOnly           bool
+	htmlInlineStyles   bool
+	htmlTabWidth       int
+	htmlLines          bool
+	htmlLinesTable     bool
+	htmlLinesStyle     string
+	htmlHighlight      string
+	htmlHighlightStyle string
+	htmlBaseLine       int
+	htmlNoSurround     bool
+	htmlLinkable       bool
+
+	files []string
+}
+
+// flagSpec describes a single flag for suggestion purposes.
+type flagSpec struct {
+	name  string // e.g. "-h", "--style"
+	value bool   // whether it takes a value
+}
+
+// flagSpecs is the full list of known flags in registration order.
+var flagSpecs = []flagSpec{
+	{"-h", false},
+	{"--help", false},
+	{"--version", false},
+	{"--list", false},
+	{"--unbuffered", false},
+	{"--trace", false},
+	{"--check", false},
+	{"--filename", true},
+	{"--fail", false},
+	{"-l", true},
+	{"--lexer", true},
+	{"-s", true},
+	{"--style", true},
+	{"-f", true},
+	{"--formatter", true},
+	{"--json", false},
+	{"--html", false},
+	{"--svg", false},
+	{"--html-prefix", true},
+	{"--html-styles", false},
+	{"--html-all-styles", false},
+	{"--html-only", false},
+	{"--html-inline-styles", false},
+	{"--html-tab-width", true},
+	{"--html-lines", false},
+	{"--html-lines-table", false},
+	{"--html-lines-style", true},
+	{"--html-highlight", true},
+	{"--html-highlight-style", true},
+	{"--html-base-line", true},
+	{"--html-prevent-surrounding-pre", false},
+	{"--html-linkable-lines", false},
+}
+
+func main() {
+	app := &cliApp{
+		lexer:     "autodetect",
+		style:     "swapoff",
+		formatter: "terminal",
+	}
+	if err := app.parse(os.Args[1:]); err != nil {
+		fmt.Fprintf(os.Stderr, "%s: error: %s\n", programName, err)
+		os.Exit(80)
+	}
+
+	if app.version {
+		fmt.Println("?-?-?")
+		return
+	}
+	if app.help {
+		fmt.Print(helpText)
+		return
+	}
+	if app.list {
+		fmt.Print(listText)
+		return
+	}
+
+	if err := app.run(); err != nil {
+		fmt.Fprintf(os.Stderr, "%s: error: %s\n", programName, err)
+		os.Exit(1)
+	}
+}
diff --git a/cmd/chroma/parse.go b/cmd/chroma/parse.go
new file mode 100644
index 0000000..025ff38
--- /dev/null
+++ b/cmd/chroma/parse.go
@@ -0,0 +1,271 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+)
+
+// parse consumes the command-line arguments. It validates files (returning a
+// parse error, exit code 80, on failure) and fills in the flag fields.
+func (app *cliApp) parse(args []string) error {
+	for {
+		if len(args) == 0 {
+			break
+		}
+		arg := args[0]
+		args = args[1:]
+
+		if arg == "--" {
+			app.files = append(app.files, args...)
+			break
+		}
+
+		if strings.HasPrefix(arg, "--") {
+			// long flag
+			name := arg[2:]
+			value := ""
+			hasValue := false
+			if idx := strings.Index(name, "="); idx >= 0 {
+				value = name[idx+1:]
+				name = name[:idx]
+				hasValue = true
+			}
+			spec, ok := app.lookupLong(name)
+			if !ok {
+				return fmt.Errorf("unknown flag %s%s%s", "--"+name, suggest(name), "")
+			}
+			if !hasValue && spec.value && len(args) > 0 {
+				// value-bearing flag with a separate value: consume the next arg
+				value = args[0]
+				args = args[1:]
+			}
+			app.setLong(name, value)
+			continue
+		}
+
+		if len(arg) > 1 && arg[0] == '-' && arg != "-" {
+			// short flag (possibly a value-bearing flag with attached value)
+			c := arg[1]
+			spec, ok := app.lookupShort(string(c))
+			if !ok {
+				return fmt.Errorf("unknown flag -%c, did you mean one of %s", c, allShort())
+			}
+			rest := arg[2:]
+			v := ""
+			if spec.value {
+				if rest != "" {
+					v = rest
+					if strings.HasPrefix(v, "=") {
+						v = v[1:]
+					}
+				} else if len(args) > 0 {
+					// value-bearing short flag with a separate value
+					v = args[0]
+					args = args[1:]
+				}
+			}
+			app.setShort(c, v)
+			continue
+		}
+
+		// a file
+		app.files = append(app.files, arg)
+	}
+
+	// validate that all files exist (parse-time check, exit code 80).
+	if len(app.files) > 0 {
+		for _, f := range app.files {
+			if _, err := os.Stat(f); err != nil {
+				return fmt.Errorf("[<files> ...]: %s", err.Error())
+			}
+		}
+	}
+
+	// validate the formatter (parse-time check, exit code 80).
+	if app.formatter != "" {
+		validFormatters := []string{"html", "json", "noop", "svg", "terminal", "terminal16", "terminal16m", "terminal256", "terminal8", "tokens"}
+		ok := false
+		for _, f := range validFormatters {
+			if f == app.formatter {
+				ok = true
+				break
+			}
+		}
+		if !ok {
+			quoted := make([]string, len(validFormatters))
+			for i, f := range validFormatters {
+				quoted[i] = fmt.Sprintf("%q", f)
+			}
+			return fmt.Errorf("--formatter must be one of %s but got %s", strings.Join(quoted, ","), fmt.Sprintf("%q", app.formatter))
+		}
+	}
+	return nil
+}
+
+// lookupLong returns the spec whose long name matches name.
+func (app *cliApp) lookupLong(name string) (flagSpec, bool) {
+	for _, s := range flagSpecs {
+		if strings.HasPrefix(s.name, "--") && s.name == "--"+name {
+			return s, true
+		}
+	}
+	return flagSpec{}, false
+}
+
+// lookupShort returns the spec whose short name matches c.
+func (app *cliApp) lookupShort(c string) (flagSpec, bool) {
+	for _, s := range flagSpecs {
+		if s.name == "-"+c {
+			return s, true
+		}
+	}
+	return flagSpec{}, false
+}
+
+// setLong sets a long-flag value.
+func (app *cliApp) setLong(name, value string) {
+	switch name {
+	case "help":
+		app.help = true
+	case "version":
+		app.version = true
+	case "list":
+		app.list = true
+	case "unbuffered":
+		app.unbuffered = true
+	case "trace":
+		app.trace = true
+	case "check":
+		app.check = true
+	case "fail":
+		app.fail = true
+	case "json":
+		app.json = true
+	case "html":
+		app.html = true
+	case "svg":
+		app.svg = true
+	case "html-styles":
+		app.htmlStyles = true
+	case "html-all-styles":
+		app.htmlAllStyles = true
+	case "html-only":
+		app.htmlOnly = true
+	case "html-inline-styles":
+		app.htmlInlineStyles = true
+	case "html-lines":
+		app.htmlLines = true
+	case "html-lines-table":
+		app.htmlLinesTable = true
+	case "html-prevent-surrounding-pre":
+		app.htmlNoSurround = true
+	case "html-linkable-lines":
+		app.htmlLinkable = true
+	case "filename":
+		app.filename = value
+	case "lexer":
+		app.lexer = value
+	case "style":
+		app.style = value
+	case "formatter":
+		app.formatter = value
+	case "html-prefix":
+		app.htmlPrefix = value
+	case "html-tab-width":
+		app.htmlTabWidth = atoiDefault(value, 8)
+	case "html-lines-style":
+		app.htmlLinesStyle = value
+	case "html-highlight":
+		app.htmlHighlight = value
+	case "html-highlight-style":
+		app.htmlHighlightStyle = value
+	case "html-base-line":
+		app.htmlBaseLine = atoiDefault(value, 1)
+	}
+}
+
+// setShort sets a short-flag value.
+func (app *cliApp) setShort(c byte, value string) {
+	switch c {
+	case 'h':
+		app.help = true
+	case 'l':
+		app.lexer = value
+	case 's':
+		app.style = value
+	case 'f':
+		app.formatter = value
+	}
+}
+
+// allShort returns the suggestion string for an unknown short flag.
+func allShort() string {
+	var names []string
+	for _, s := range flagSpecs {
+		if strings.HasPrefix(s.name, "-") && !strings.HasPrefix(s.name, "--") {
+			names = append(names, s.name)
+		}
+	}
+	return fmt.Sprintf("%q", strings.Join(names, ", "))
+}
+
+// suggest returns the ", did you mean one of <suggestions>?" suffix for an
+// unknown long flag, based on edit-distance to known flags.
+func suggest(name string) string {
+	var names []string
+	best := 99
+	for _, s := range flagSpecs {
+		if !strings.HasPrefix(s.name, "--") {
+			continue
+		}
+		d := levenshtein(name, s.name[2:])
+		if d <= 2 {
+			if d < best {
+				best = d
+			}
+			names = append(names, s.name)
+		}
+	}
+	if len(names) == 0 {
+		return ""
+	}
+	sort.SliceStable(names, func(i, j int) bool {
+		return levenshtein(name, names[i][2:]) < levenshtein(name, names[j][2:])
+	})
+	return ", did you mean one of " + fmt.Sprintf("%q", strings.Join(names, "\", \""))
+}
+
+// levenshtein returns the edit distance between a and b.
+func levenshtein(a, b string) int {
+	la, lb := len(a), len(b)
+	prev := make([]int, lb+1)
+	cur := make([]int, lb+1)
+	for j := 0; j <= lb; j++ {
+		prev[j] = j
+	}
+	for i := 1; i <= la; i++ {
+		cur[0] = i
+		for j := 1; j <= lb; j++ {
+			cost := 1
+			if a[i-1] == b[j-1] {
+				cost = 0
+			}
+			cur[j] = min3(prev[j]+1, cur[j-1]+1, prev[j-1]+cost)
+		}
+		prev, cur = cur, prev
+	}
+	return prev[lb]
+}
+
+func min3(a, b, c int) int {
+	m := a
+	if b < m {
+		m = b
+	}
+	if c < m {
+		m = c
+	}
+	return m
+}
