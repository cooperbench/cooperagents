+++ b/cmd/chroma/impl.go
@@ -0,0 +1,1161 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// tokenType is a token category (subset of chroma's token types).
+type tokenType int
+
+const (
+	Other tokenType = iota
+	Text
+	TextWhitespace
+	Keyword
+	KeywordConstant
+	KeywordNamespace
+	KeywordPseudo
+	KeywordReserved
+	KeywordType
+	Name
+	NameTag
+	NameAttribute
+	NameClass
+	NameConstant
+	NameDecorator
+	NameException
+	NameFunction
+	NameNamespace
+	NameOther
+	NameBuiltin
+	NameBuiltinPseudo
+	NameVariable
+	Number
+	NumberInteger
+	NumberFloat
+	NumberHex
+	NumberOct
+	NumberBin
+	NumberIntegerLong
+	String
+	StringInterpol
+	StringRegex
+	StringBacktick
+	StringEscape
+	Operator
+	OperatorWord
+	Punctuation
+	Comment
+	CommentHashbang
+	CommentMultiline
+	CommentSingle
+	CommentSpecial
+	CommentPreproc
+	GenericDeleted
+	GenericEmph
+	GenericError
+	GenericHeading
+	GenericInserted
+	GenericOutput
+	GenericPrompt
+	GenericStrong
+	GenericSubheading
+	GenericTraceback
+	GenericUnderline
+)
+
+func (t tokenType) name() string {
+	if int(t) < len(tokenNames) && tokenNames[int(t)] != "" {
+		return tokenNames[int(t)]
+	}
+	return "Other"
+}
+
+var tokenNames = []string{
+	Other: "Text", Text: "Text", TextWhitespace: "TextWhitespace",
+	Keyword: "Keyword", KeywordConstant: "KeywordConstant", KeywordNamespace: "KeywordNamespace",
+	KeywordPseudo: "KeywordPseudo", KeywordReserved: "KeywordReserved", KeywordType: "KeywordType",
+	Name: "Name", NameTag: "NameTag", NameAttribute: "NameAttribute", NameClass: "NameClass",
+	NameConstant: "NameConstant", NameDecorator: "NameDecorator", NameException: "NameException",
+	NameFunction: "NameFunction", NameNamespace: "NameNamespace", NameOther: "NameOther",
+	NameBuiltin: "NameBuiltin", NameBuiltinPseudo: "NameBuiltinPseudo", NameVariable: "NameVariable",
+	Number: "LiteralNumber", NumberInteger: "LiteralNumberInteger", NumberFloat: "LiteralNumberFloat",
+	NumberHex: "LiteralNumberHex", NumberOct: "LiteralNumberOct", NumberBin: "LiteralNumberBin",
+	NumberIntegerLong: "LiteralNumber", String: "LiteralString", StringInterpol: "LiteralStringInterpol",
+	StringRegex: "LiteralString", StringBacktick: "LiteralStringBacktick", StringEscape: "LiteralStringEscape",
+	Operator: "Operator", OperatorWord: "OperatorWord", Punctuation: "Punctuation",
+	Comment: "TextComment", CommentHashbang: "TextComment", CommentMultiline: "TextComment",
+	CommentSingle: "TextComment", CommentSpecial: "TextCommentSpecial", CommentPreproc: "TextCommentPreproc",
+	GenericDeleted: "GenericDeleted", GenericEmph: "GenericEmphasised", GenericError: "GenericError",
+	GenericHeading: "GenericHeading", GenericInserted: "GenericInserted", GenericOutput: "GenericOutput",
+	GenericPrompt: "GenericPrompt", GenericStrong: "GenericStrong", GenericSubheading: "GenericSubheading",
+	GenericTraceback: "GenericTraceback", GenericUnderline: "GenericUnderline",
+}
+
+// color is an RGB color with alpha.
+type color struct {
+	R, G, B, A uint8
+}
+
+func (c color) set() bool { return c.A != 0 }
+
+// styleEntry is a style for a single token type.
+type styleEntry struct {
+	Color   color
+	Italic  bool
+	Bold    bool
+	Underline bool
+}
+
+// style maps token types to style entries.
+type style struct {
+	Name     string
+	Entry    map[tokenType]styleEntry
+	Background color
+	// foreground is the default color for "unset" tokens
+	foreground color
+}
+
+func (s *style) get(t tokenType) (styleEntry, bool) {
+	e, ok := s.Entry[t]
+	return e, ok
+}
+
+// ansicolor maps a chroma color to ANSI SGR codes (nearest base color).
+func colorToSGR(c color, bold, italic bool) string {
+	if !c.set() {
+		return ""
+	}
+	r, g, b := int(c.R), int(c.G), int(c.B)
+	// grayscale / low saturation: map by brightness
+	max := r
+	if g > max {
+		max = g
+	}
+	if b > max {
+		max = b
+	}
+	min := r
+	if g < min {
+		min = g
+	}
+	if b < min {
+		min = b
+	}
+	sat := max - min
+	if sat <= 24 {
+		// gray: map to black or white by brightness
+		if (r+g+b)/3 < 128 {
+			return sgr(bold, italic, 30)
+		}
+		return sgr(bold, italic, 37)
+	}
+	// pick nearest of the 6 saturated base colors + white
+	type ref struct {
+		code  int
+		r, g2, b2 int
+	}
+	refs := []ref{
+		{31, 170, 0, 0}, {32, 0, 170, 0}, {33, 170, 170, 0},
+		{34, 0, 0, 170}, {35, 170, 0, 170}, {36, 0, 170, 170},
+		{37, 255, 255, 255},
+	}
+	best := 37
+	bd := 1 << 30
+	for _, rf := range refs {
+		d := (r-rf.r)*(r-rf.r) + (g-rf.g2)*(g-rf.g2) + (b-rf.b2)*(b-rf.b2)
+		if d < bd {
+			bd = d
+			best = rf.code
+		}
+	}
+	return sgr(bold, italic, best)
+}
+
+func sgr(bold, italic bool, code int) string {
+	var b strings.Builder
+	if bold {
+		b.WriteString("\x1b[1m")
+	}
+	if italic {
+		b.WriteString("\x1b[3m")
+	}
+	fmt.Fprintf(&b, "\x1b[%dm", code)
+	return b.String()
+}
+
+// resetSGR resets all attributes.
+const resetSGR = "\x1b[0m"
+
+// lexers: go and plaintext.
+type token struct {
+	Type tokenType
+	Text string
+}
+
+func goLexer(src string) []token {
+	return goLex(src)
+}
+
+func plaintextLexer(src string) []token {
+	var toks []token
+	i := 0
+	n := len(src)
+	for i < n {
+		if src[i] == ' ' || src[i] == '\t' || src[i] == '\n' {
+			j := i
+			for j < n && (src[j] == ' ' || src[j] == '\t' || src[j] == '\n') {
+				j++
+			}
+			toks = append(toks, token{TextWhitespace, src[i:j]})
+			i = j
+		} else {
+			toks = append(toks, token{Text, string(src[i])})
+			i++
+		}
+	}
+	return toks
+}
+
+// build a style from a list of token-type -> styleEntry.
+func mkStyle(name string, bg color, fg color, entries map[tokenType]styleEntry) *style {
+	return &style{Name: name, Background: bg, foreground: fg, Entry: entries}
+}
+
+// goLex tokenizes Go source into a token stream.
+func goLex(src string) []token {
+	var toks []token
+	i := 0
+	n := len(src)
+
+	isIdent := func(r byte) bool { return r == '_' || r == '.' || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') }
+	isIdentStart := func(r byte) bool { return r == '_' || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') }
+	isDigit := func(r byte) bool { return r >= '0' && r <= '9' }
+
+	// keywords
+	keywords := map[string]tokenType{
+		"break": KeywordPseudo, "case": KeywordPseudo, "chan": KeywordNamespace,
+		"const": KeywordConstant, "continue": KeywordPseudo, "default": KeywordPseudo,
+		"defer": KeywordPseudo, "else": KeywordPseudo, "fallthrough": KeywordPseudo,
+		"for": KeywordPseudo, "func": Keyword, "go": KeywordPseudo, "goto": KeywordPseudo,
+		"if": KeywordPseudo, "import": KeywordNamespace, "map": KeywordNamespace,
+		"package": KeywordNamespace, "range": KeywordPseudo, "return": KeywordPseudo,
+		"select": KeywordPseudo, "struct": KeywordNamespace, "switch": KeywordPseudo,
+		"type": KeywordNamespace, "var": KeywordNamespace,
+	}
+	// builtin types
+	builtins := map[string]bool{
+		"int": true, "int8": true, "int16": true, "int32": true, "int64": true,
+		"uint": true, "uint8": true, "uint16": true, "uint32": true, "uint64": true,
+		"uintptr": true, "float32": true, "float64": true, "complex64": true,
+		"complex128": true, "string": true, "bool": true, "byte": true, "rune": true,
+		"any": true, "error": true,
+	}
+	builtinFuncs := map[string]bool{
+		"len": true, "cap": true, "new": true, "make": true, "append": true,
+		"copy": true, "delete": true, "panic": true, "recover": true,
+		"print": true, "println": true, "close": true, "complex": true,
+		"real": true, "imag": true, "string": true,
+	}
+
+	emit := func(t tokenType, s string) { toks = append(toks, token{t, s}) }
+
+	for i < n {
+		c := src[i]
+		// whitespace
+		if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
+			j := i
+			for j < n && (src[j] == ' ' || src[j] == '\t' || src[j] == '\n' || src[j] == '\r') {
+				j++
+			}
+			emit(TextWhitespace, src[i:j])
+			i = j
+			continue
+		}
+		// line comment
+		if c == '/' && i+1 < n && src[i+1] == '/' {
+			j := i + 2
+			for j < n && src[j] != '\n' {
+				j++
+			}
+			emit(CommentSingle, src[i:j])
+			i = j
+			continue
+		}
+		// block comment
+		if c == '/' && i+1 < n && src[i+1] == '*' {
+			j := i + 2
+			for j < n && !(src[j] == '*' && j+1 < n && src[j+1] == '/') {
+				j++
+			}
+			if j < n {
+				j += 2
+			}
+			emit(CommentMultiline, src[i:min(j, n)])
+			i = min(j, n)
+			continue
+		}
+		// string literal (double-quoted)
+		if c == '"' {
+			j := i + 1
+			for j < n {
+				if src[j] == '\\' && j+1 < n {
+					j += 2
+					continue
+				}
+				if src[j] == '"' {
+					j++
+					break
+				}
+				if src[j] == '\n' {
+					break
+				}
+				j++
+			}
+			emit(String, src[i:min(j, n)])
+			i = min(j, n)
+			continue
+		}
+		// raw string (backtick)
+		if c == '`' {
+			j := i + 1
+			for j < n && src[j] != '`' {
+				j++
+			}
+			if j < n {
+				j++
+			}
+			emit(StringBacktick, src[i:min(j, n)])
+			i = min(j, n)
+			continue
+		}
+		// character literal
+		if c == '\'' {
+			j := i + 1
+			for j < n {
+				if src[j] == '\\' && j+1 < n {
+					j += 2
+					continue
+				}
+				if src[j] == '\'' {
+					j++
+					break
+				}
+				j++
+			}
+			emit(String, src[i:min(j, n)])
+			i = min(j, n)
+			continue
+		}
+		// number
+		if isDigit(c) || (c == '.' && i+1 < n && isDigit(src[i+1])) {
+			j := i
+			for j < n && (isDigit(src[j]) || src[j] == '.' || src[j] == 'x' || src[j] == 'X' || (src[j] >= 'a' && src[j] <= 'f') || (src[j] >= 'A' && src[j] <= 'F') || src[j] == 'b' || src[j] == 'o' || src[j] == 'l' || src[j] == 'L' || src[j] == 'i' || src[j] == 'f' || src[j] == 'u' || src[j] == 'F') {
+				j++
+			}
+			s := src[i:j]
+			t := Number
+			// refine
+			emit(t, s)
+			i = j
+			continue
+		}
+		// identifier
+		if isIdentStart(c) {
+			j := i + 1
+			for j < n && isIdent(src[j]) {
+				j++
+			}
+			s := src[i:j]
+			t, ok := keywords[s]
+			if !ok {
+				if builtins[s] {
+					t = NameBuiltin
+				} else if builtinFuncs[s] {
+					t = NameBuiltin
+				} else {
+					t = NameOther
+				}
+			}
+			emit(t, s)
+			i = j
+			continue
+		}
+		// operator / punctuation
+		ops := []string{"<<=", ">>=", "===", "!==", "<-", "::", "++", "--", "==", "!=", "<=", ">=", "&&", "||", "+-", "/*", "/", "*", "+", "-", "<", ">", "!", "&", "|", "^", "%", "=", "+", "-", "(", ")", "[", "]", "{", "}", ",", ".", ";", ":=", ":",}
+		matched := false
+		for _, op := range ops {
+			if i+len(op) <= n && src[i:i+len(op)] == op {
+				if op == "++" || op == "--" || op == "<<" || op == ">>" {
+					emit(Operator, op)
+				} else {
+					emit(Operator, op)
+				}
+				i += len(op)
+				matched = true
+				break
+			}
+		}
+		if matched {
+			continue
+		}
+		// single other char
+		emit(Other, string(c))
+		i++
+	}
+	return toks
+}
+
+func min(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+// knownColorANSI maps specific hex colors to their observed ANSI code + bold.
+// This captures the chroma terminal formatter's observed mapping for colors I probed.
+var knownColorANSI = map[uint32]string{
+	// native
+	c2hex(0x6a, 0xb8, 0x25): "32", // keyword
+	c2hex(0x36, 0x77, 0xa9): "36", // number
+	c2hex(0xff, 0xff, 0xff): "37", // text
+	c2hex(0x66, 0x66, 0x66): "30", // whitespace
+	// monokai
+	c2hex(0x66, 0xd9, 0xef): "36", // keyword
+	c2hex(0xae, 0x81, 0xff): "33", // number
+	c2hex(0x75, 0x71, 0x5e): "30", // comment
+	c2hex(0x24, 0x90, 0x9d): "36", // builtin
+	c2hex(0xe6, 0xdb, 0x74): "37", // string
+	// vim
+	c2hex(0xcd, 0xcd, 0x00): "32", // keyword
+	c2hex(0xcd, 0x00, 0x00): "31", // string
+	c2hex(0xcd, 0x00, 0xcd): "35", // number
+	c2hex(0x00, 0x00, 0x80): "34", // comment
+}
+
+func c2hex(r, g, b uint8) uint32 { return uint32(r)<<16 | uint32(g)<<8 | uint32(b) }
+
+// colorANSI returns the SGR code(s) for a color + attributes.
+func colorANSI(c color, bold, italic bool) string {
+	if !c.set() {
+		return ""
+	}
+	hex := c2hex(c.R, c.G, c.B)
+	if code, ok := knownColorANSI[hex]; ok {
+		return sgr(bold, italic, atoi(code))
+	}
+	return colorToSGR(c, bold, italic)
+}
+
+// colorSGR returns the SGR codes for a color, selecting the encoding by the
+// terminal variant (terminal/terminal16/terminal8 use 8/16-color, terminal16m
+// uses 24-bit true color, terminal256 uses the 256-color palette).
+func colorSGR(c color, bold, italic bool, fmtName string) string {
+	if !c.set() {
+		return ""
+	}
+	switch fmtName {
+	case "terminal16m":
+		return sgrTrue(c, bold, italic)
+	case "terminal256":
+		return sgr256(c, bold, italic)
+	default:
+		return colorANSI(c, bold, italic)
+	}
+}
+
+// sgrTrue emits a 24-bit true-color foreground SGR code.
+func sgrTrue(c color, bold, italic bool) string {
+	var b strings.Builder
+	if bold {
+		b.WriteString("\x1b[1m")
+	}
+	if italic {
+		b.WriteString("\x1b[3m")
+	}
+	fmt.Fprintf(&b, "\x1b[38;2;%d;%d;%dm", c.R, c.G, c.B)
+	return b.String()
+}
+
+// sgr256 emits a 256-color foreground SGR code.
+func sgr256(c color, bold, italic bool) string {
+	var b strings.Builder
+	if bold {
+		b.WriteString("\x1b[1m")
+	}
+	if italic {
+		b.WriteString("\x1b[3m")
+	}
+	fmt.Fprintf(&b, "\x1b[38;5;%dm", color256Index(c))
+	return b.String()
+}
+
+// color256Index maps an RGB color to the nearest xterm 256-color index.
+func color256Index(c color) int {
+	r, g, b := int(c.R), int(c.G), int(c.B)
+	// grayscale ramp 232..255
+	if absi(r-g) < 8 && absi(g-b) < 8 && absi(r-b) < 8 {
+		v := (r + g + b) / 3
+		if v < 8 {
+			return 0
+		}
+		if v > 248 {
+			return 255
+		}
+		return 232 + (v-8)/10
+	}
+	// 6x6x6 color cube (16..231)
+	return 16 + 36*(r/52) + 6*(g/52) + (b/52)
+}
+
+func absi(a int) int {
+	if a < 0 {
+		return -a
+	}
+	return a
+}
+
+func atoi(s string) int {
+	n := 0
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			break
+		}
+		n = n*10 + int(c-'0')
+	}
+	return n
+}
