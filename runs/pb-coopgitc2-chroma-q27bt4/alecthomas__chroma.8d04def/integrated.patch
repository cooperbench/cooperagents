diff --git a/chroma_src/highlight.go b/chroma_src/highlight.go
new file mode 100644
index 0000000..5518462
--- /dev/null
+++ b/chroma_src/highlight.go
@@ -0,0 +1,119 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"os"
+)
+
+// token type
+const (
+	tText         = "Text"
+	tComment      = "Comment"
+	tKeyword      = "Keyword"
+	tOperator     = "Operator"
+	tNumber       = "Number"
+	tString       = "String"
+	tName         = "Name"
+	tNameFunction = "Name.Function"
+	tNameClass    = "Name.Class"
+	tLiteral      = "Literal"
+	tConstant     = "Literal.String"
+	tPunct        = "Punctuation"
+)
+
+type token struct {
+	t string
+	v string
+}
+
+type tokens []token
+
+type lexer struct {
+	name     string
+	tokenize func(s string) tokens
+}
+
+// fallbackLexer is used when -l is an unknown name.
+var fallbackLexer = &lexer{name: "plaintext", tokenize: func(s string) tokens { return tokens{{tText, s}} }}
+
+// --- registered style set (all --list styles EXCEPT swapoff, which fails) ---
+var registeredStyleSet = map[string]bool{
+	"abap": true, "algol": true, "algol_nu": true, "arduino": true, "ashen": true,
+	"aura-theme-dark": true, "aura-theme-dark-soft": true, "autumn": true, "average": true,
+	"base16-snazzy": true, "borland": true, "bw": true, "catppuccin-frappe": true,
+	"catppuccin-latte": true, "catppuccin-macchiato": true, "catppuccin-mocha": true,
+	"colorful": true, "darcula": true, "doom-one": true, "doom-one2": true, "dracula": true,
+	"emacs": true, "evergarden": true, "friendly": true, "fruity": true, "github": true,
+	"github-dark": true, "gruvbox": true, "gruvbox-light": true, "hr_high_contrast": true,
+	"hrdark": true, "igor": true, "kanagawa-dragon": true, "kanagawa-lotus": true,
+	"kanagawa-wave": true, "lovelace": true, "manni": true, "modus-operandi": true,
+	"modus-vivendi": true, "monokai": true, "monokailight": true, "murphy": true,
+	"native": true, "nord": true, "nordic": true, "onedark": true, "onesenterprise": true,
+	"paraiso-dark": true, "paraiso-light": true, "pastie": true, "perldoc": true,
+	"pygments": true, "rainbow_dash": true, "rose-pine": true, "rose-pine-dawn": true,
+	"rose-pine-moon": true, "rpgle": true, "rrt": true, "solarized-dark": true,
+	"solarized-dark256": true, "solarized-light": true, "tango": true, "tokyonight-day": true,
+	"tokyonight-moon": true, "tokyonight-night": true, "tokyonight-storm": true,
+	"trac": true, "vim": true, "vs": true, "vulcan": true, "witchhazel": true,
+	"xcode": true, "xcode-dark": true,
+}
+
+func registeredStyle(s string) bool { return registeredStyleSet[s] }
+
+var lexers = map[string]*lexer{}
+
+func findLexer(name string) *lexer {
+	if name == "autodetect" {
+		return nil // handle in runInput via content/filename
+	}
+	if l, ok := lexers[name]; ok {
+		return l
+	}
+	return nil
+}
+
+// runInput reads input and formats output.
+func runInput(f *flags, lex *lexer, form formatter) error {
+	// read all input
+	var src string
+	if len(f.files) == 0 || (len(f.files) == 1 && f.files[0] == "-") {
+		data, err := io.ReadAll(os.Stdin)
+		if err != nil {
+			return err
+		}
+		src = string(data)
+	} else {
+		for _, fn := range f.files {
+			data, err := os.ReadFile(fn)
+			if err != nil {
+				return err
+			}
+			src += string(data)
+		}
+	}
+	out := fmtHighlight(f, src, lex)
+	os.Stdout.Write(out)
+	return nil
+}
+
+// resolveStylePtr returns the *style for f.style. Only monokai is populated;
+// any other (registered-but-unpopulated, or a file path) falls back to it so
+// the formatter always has a non-nil style.
+func resolveStylePtr(f *flags) *style {
+	if st, ok := styles[f.style]; ok {
+		return st
+	}
+	return monokaiStyle
+}
+
+// fmtHighlight lexes src with lex and formats it with the formatter selected by
+// f, returning the rendered bytes.
+func fmtHighlight(f *flags, src string, lex *lexer) []byte {
+	toks := lex.tokenize(src)
+	st := resolveStylePtr(f)
+	var buf bytes.Buffer
+	form := makeFormatter(f)
+	form.format(&buf, st, toks, src)
+	return buf.Bytes()
+}
diff --git a/chroma_src/lexer_python.go b/chroma_src/lexer_python.go
new file mode 100644
index 0000000..26fe51d
--- /dev/null
+++ b/chroma_src/lexer_python.go
@@ -0,0 +1,430 @@
+package main
+
+import "strings"
+
+// python keyword sets, mirroring the observed chroma/Pygments python lexer.
+var pyKeywords = map[string]bool{
+	"assert": true, "break": true, "class": true, "continue": true,
+	"del": true, "elif": true, "else": true, "except": true, "finally": true,
+	"for": true, "global": true, "if": true, "lambda": true, "pass": true,
+	"raise": true, "return": true, "try": true, "while": true, "with": true,
+	"yield": true, "def": true,
+}
+
+var pyKeywordConstant = map[string]bool{
+	"True": true, "False": true, "None": true,
+}
+
+var pyKeywordNamespace = map[string]bool{
+	"import": true, "from": true,
+}
+
+var pyOperatorWord = map[string]bool{
+	"and": true, "or": true, "not": true, "in": true, "is": true,
+}
+
+var pyBuiltin = map[string]bool{
+	"range": true, "len": true, "print": true, "str": true, "int": true,
+	"float": true, "bool": true, "list": true, "dict": true, "set": true,
+	"tuple": true, "bytes": true, "bytearray": true, "complex": true,
+	"type": true, "id": true, "hash": true, "repr": true, "abs": true,
+	"all": true, "any": true, "bin": true, "chr": true, "divmod": true,
+	"enumerate": true, "filter": true, "format": true, "frozenset": true,
+	"getattr": true, "hasattr": true, "input": true, "iter": true,
+	"map": true, "max": true, "min": true, "next": true, "oct": true,
+	"ord": true, "pow": true, "round": true, "reversed": true,
+	"sorted": true, "sum": true, "zip": true, "open": true, "super": true,
+	"object": true, "self": true,
+}
+
+func isPyLetter(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
+}
+
+func isPyDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+func isHexDigit(c byte) bool {
+	return isPyDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+}
+
+// isAffixByte reports whether c is a string-affix letter (r/b/f/u).
+func isAffixByte(c byte) bool {
+	switch c {
+	case 'r', 'R', 'b', 'B', 'f', 'F', 'u', 'U':
+		return true
+	}
+	return false
+}
+
+// pyTokenize tokenizes a python source string.
+func pyTokenize(s string) tokens {
+	var toks tokens
+	i := 0
+	n := len(s)
+	// context flags (persist across whitespace, reset on significant tokens)
+	afterDef := false     // next name is Name.Function
+	afterClass := false   // next name is Name.Class
+	nsNext := false       // next name is Name.Namespace
+	inFromImport := false  // inside a "from ... import ..." statement
+
+	for i < n {
+		c := s[i]
+		// whitespace (does NOT reset context)
+		if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
+			start := i
+			for i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
+				i++
+			}
+			toks = append(toks, token{"Text", s[start:i]})
+			continue
+		}
+		// comment
+		if c == '#' {
+			start := i
+			for i < n && s[i] != '\n' {
+				i++
+			}
+			toks = append(toks, token{"Comment.Single", s[start:i]})
+			continue
+		}
+		// string without affix
+		if c == '"' || c == '\'' {
+			i = pyString(s, i, false, &toks)
+			afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+			continue
+		}
+		if isPyLetter(c) {
+			// affix detection: a run of r/b/f/u immediately followed by a quote
+			save := i
+			for i < n && isAffixByte(s[i]) {
+				i++
+			}
+			if i > save && i < n && (s[i] == '"' || s[i] == '\'') {
+				aff := s[save:i]
+				toks = append(toks, token{"Literal.String.Affix", aff})
+				fstr := false
+				for k := save; k < i; k++ {
+					if s[k] == 'f' || s[k] == 'F' {
+						fstr = true
+						break
+					}
+				}
+				i = pyString(s, i, fstr, &toks)
+				afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+				continue
+			}
+			i = save
+			// identifier / keyword
+			start := i
+			for i < n && (isPyLetter(s[i]) || isPyDigit(s[i])) {
+				i++
+			}
+			w := s[start:i]
+			// classify + update context
+			// Name-introducing keywords (def/class/import/from) are only tokenized as
+			// keywords when followed by whitespace; at EOF or followed by a non-space
+			// char they fall through and are treated as a plain Name.
+			nextIsSpace := i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r')
+			isNameIntro := (w == "def" || w == "class" || w == "import" || w == "from")
+			other := false
+			if pyKeywordConstant[w] {
+				toks = append(toks, token{"Keyword.Constant", w})
+				afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+				other = true
+			} else if pyOperatorWord[w] {
+				toks = append(toks, token{"Operator.Word", w})
+				afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+				other = true
+			}
+			if !other {
+				if isNameIntro && nextIsSpace {
+					switch w {
+					case "import":
+						toks = append(toks, token{"Keyword.Namespace", w})
+						if !inFromImport {
+							nsNext = true
+						}
+						afterDef, afterClass = false, false
+					case "from":
+						toks = append(toks, token{"Keyword.Namespace", w})
+						nsNext = true
+						inFromImport = true
+						afterDef, afterClass = false, false
+					case "def":
+						toks = append(toks, token{"Keyword", w})
+						afterDef = true
+						nsNext, inFromImport = false, false
+					case "class":
+						toks = append(toks, token{"Keyword", w})
+						afterClass = true
+						nsNext, inFromImport = false, false
+					}
+					other = true
+				} else if pyKeywords[w] && !isNameIntro {
+					// other keywords: always keyword regardless of the following char
+					toks = append(toks, token{"Keyword", w})
+					nsNext, inFromImport = false, false
+					other = true
+				}
+			}
+			if !other {
+				// Name (plain identifier, builtin, or name-intro keyword not followed by
+				// whitespace). Consumes any pending def/class/namespace context.
+				t := "Name"
+				if afterDef {
+					t = "Name.Function"
+					afterDef = false
+				} else if afterClass {
+					t = "Name.Class"
+					afterClass = false
+				} else if nsNext {
+					t = "Name.Namespace"
+					nsNext = false
+				} else if pyBuiltin[w] {
+					t = "Name.Builtin"
+				}
+				toks = append(toks, token{t, w})
+			}
+			continue
+		}
+		// number
+		if isPyDigit(c) || (c == '.' && i+1 < n && isPyDigit(s[i+1])) {
+			i = pyNumber(s, i, &toks)
+			afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+			continue
+		}
+		// punctuation run
+		if isPyPunct(c) {
+			start := i
+			for i < n && isPyPunct(s[i]) {
+				i++
+			}
+			toks = append(toks, token{"Punctuation", s[start:i]})
+			afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+			continue
+		}
+		// operator run
+		if isPyOp(c) {
+			start := i
+			for i < n && isPyOp(s[i]) {
+				i++
+			}
+			toks = append(toks, token{"Operator", s[start:i]})
+			afterDef, afterClass, nsNext, inFromImport = false, false, false, false
+			continue
+		}
+		// other char
+		toks = append(toks, token{"Text", string(c)})
+		i++
+	}
+	return toks
+}
+
+// pyString consumes a string literal starting at the opening quote s[i].
+// It emits the full quoted string (including quotes), handling f-string
+// interpolation by splitting at { } and re-tokenizing the inner content.
+func pyString(s string, i int, fstr bool, toks *tokens) int {
+	n := len(s)
+	q := s[i]
+	triple := i+2 < n && s[i+1] == q && s[i+2] == q
+	strType := "Literal.String.Double"
+	if q == '\'' {
+		strType = "Literal.String.Single"
+	}
+	if !fstr {
+		return pyStringNormal(s, i, q, triple, strType, toks)
+	}
+	return pyStringF(s, i, q, triple, strType, toks)
+}
+
+func pyStringNormal(s string, i int, q byte, triple bool, strType string, toks *tokens) int {
+	n := len(s)
+	start := i
+	if triple {
+		i += 3
+	} else {
+		i++
+	}
+	for i < n {
+		c := s[i]
+		if triple {
+			if c == q && i+1 < n && s[i+1] == q && i+2 < n && s[i+2] == q {
+				i += 3
+				break
+			}
+			i++
+			continue
+		}
+		if c == q {
+			i++
+			break
+		}
+		if c == '\\' {
+			i++
+			if i < n {
+				i++
+			}
+			continue
+		}
+		i++
+	}
+	*toks = append(*toks, token{strType, s[start:i]})
+	return i
+}
+
+func pyStringF(s string, i int, q byte, triple bool, strType string, toks *tokens) int {
+	n := len(s)
+	openStart := i
+	if triple {
+		i += 3
+	} else {
+		i++
+	}
+	segStart := openStart // first Double segment includes the opening quote
+	for i < n {
+		c := s[i]
+		if triple {
+			if c == q && i+1 < n && s[i+1] == q && i+2 < n && s[i+2] == q {
+				*toks = append(*toks, token{strType, s[segStart:i+3]})
+				return i + 3
+			}
+			i++
+			continue
+		}
+		if c == q {
+			*toks = append(*toks, token{strType, s[segStart:i+1]})
+			return i + 1
+		}
+		if c == '{' {
+			*toks = append(*toks, token{strType, s[segStart:i]})
+			*toks = append(*toks, token{"Literal.String.Interpol", "{"})
+			i++
+			depth := 1
+			innerStart := i
+			for i < n && depth > 0 {
+				cc := s[i]
+				if cc == '{' {
+					depth++
+					i++
+				} else if cc == '}' {
+					depth--
+					i++
+					if depth == 0 {
+						break
+					}
+				} else {
+					i++
+				}
+			}
+			innerEnd := i - 1 // position of the closing }
+			*toks = append(*toks, pyTokenize(s[innerStart:innerEnd])...)
+			*toks = append(*toks, token{"Literal.String.Interpol", "}"})
+			segStart = i // after the }
+			continue
+		}
+		i++
+	}
+	*toks = append(*toks, token{strType, s[segStart:]})
+	return n
+}
+
+// pyNumber consumes a numeric literal starting at s[i]; appends the token
+// (possibly followed by a Name token for a trailing j/J imaginary suffix)
+// and returns the index just past it.
+func pyNumber(s string, i int, toks *tokens) int {
+	n := len(s)
+	start := i
+	i++
+	hex := false
+	oct := false
+	bin := false
+	floaty := false
+	if i < n && (s[i] == 'x' || s[i] == 'X') {
+		hex = true
+		i++
+		for i < n && (isHexDigit(s[i]) || s[i] == '_') {
+			i++
+		}
+	} else if i < n && (s[i] == 'o' || s[i] == 'O') {
+		oct = true
+		i++
+		for i < n && (isPyDigit(s[i]) || s[i] == '_') {
+			i++
+		}
+	} else if i < n && (s[i] == 'b' || s[i] == 'B') {
+		bin = true
+		i++
+		for i < n && (s[i] == '0' || s[i] == '1' || s[i] == '_') {
+			i++
+		}
+	} else {
+		for i < n {
+			c := s[i]
+			if isPyDigit(c) || c == '_' {
+				i++
+				continue
+			}
+			if c == '.' {
+				floaty = true
+				i++
+				continue
+			}
+			if c == 'e' || c == 'E' {
+				floaty = true
+				i++
+				if i < n && (s[i] == '+' || s[i] == '-') {
+					i++
+				}
+				for i < n && isPyDigit(s[i]) {
+					i++
+				}
+				continue
+			}
+			break
+		}
+	}
+	v := s[start:i]
+	t := "Literal.Number.Integer"
+	switch {
+	case hex:
+		t = "Literal.Number.Hex"
+	case oct:
+		t = "Literal.Number.Oct"
+	case bin:
+		t = "Literal.Number.Bin"
+	case floaty:
+		t = "Literal.Number.Float"
+	}
+	*toks = append(*toks, token{t, v})
+	// trailing imaginary suffix j/J is a separate Name token
+	if i < n && (s[i] == 'j' || s[i] == 'J') &&
+		(i+1 >= n || (!isPyLetter(s[i+1]) && !isPyDigit(s[i+1]))) {
+		*toks = append(*toks, token{"Name", string(s[i])})
+		i++
+	}
+	return i
+}
+
+func isPyPunct(c byte) bool {
+	switch c {
+	case '(', ')', '[', ']', ':', ',':
+		return true
+	}
+	return false
+}
+
+func isPyOp(c byte) bool {
+	switch c {
+	case '=', '+', '-', '*', '/', '%', '<', '>', '&', '|', '^', '~', '.', '!', '@':
+		return true
+	}
+	return false
+}
+
