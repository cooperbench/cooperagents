diff --git a/chroma_src/main.go b/chroma_src/main.go
new file mode 100644
index 0000000..174cae3
--- /dev/null
+++ b/chroma_src/main.go
@@ -0,0 +1,231 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func main() {
+	f, err := parse(os.Args[1:])
+	if err != nil {
+		prog := filepath.Base(os.Args[0])
+		fmt.Fprintf(os.Stderr, "%s: error: %s\n", prog, err)
+		os.Exit(80)
+	}
+	prog := filepath.Base(os.Args[0])
+	switch f.action {
+	case actHelp:
+		fmt.Print(helpText)
+		return
+	case actVersion:
+		fmt.Print("?-?-?\n")
+		return
+	case actList:
+		fmt.Print(listText)
+		return
+	}
+	if err := doHighlight(f); err != nil {
+		fmt.Fprintf(os.Stderr, "%s: error: %s\n", prog, err)
+		os.Exit(1)
+	}
+}
+
+const (
+	actNone act = iota
+	actHelp
+	actVersion
+	actList
+)
+
+type act int
+
+// valueFlags take an argument (either =val or a following token).
+var valueFlags = map[string]bool{
+	"-l": true, "--lexer": true,
+	"-s": true, "--style": true,
+	"-f": true, "--formatter": true,
+	"--filename":             true,
+	"--html-prefix":          true,
+	"--html-tab-width":       true,
+	"--html-lines-style":     true,
+	"--html-highlight":       true,
+	"--html-highlight-style": true,
+	"--html-base-line":       true,
+}
+
+// booleanFlags take no argument.
+var booleanFlags = map[string]bool{
+	"-h": true, "--help": true, "--version": true, "--list": true,
+	"--unbuffered": true, "--trace": true, "--check": true, "--fail": true,
+	"--json": true, "--html": true, "--svg": true,
+	"--html-styles": true, "--html-all-styles": true, "--html-only": true,
+	"--html-inline-styles": true, "--html-lines": true, "--html-lines-table": true,
+	"--html-prevent-surrounding-pre": true, "--html-linkable-lines": true,
+}
+
+func knownFlag(name string) bool {
+	return valueFlags[name] || booleanFlags[name]
+}
+
+type flags struct {
+	files  []string
+	action act
+
+	lexer     string
+	style     string
+	formatter string
+
+	unbuffered bool
+	trace      bool
+	check      bool
+	fail       bool
+	filename   string
+
+	json bool
+	html bool
+	svg  bool
+}
+
+func (f *flags) setAction(a act) {
+	if f.action == actNone {
+		f.action = a
+	}
+}
+
+func parse(args []string) (*flags, error) {
+	f := &flags{
+		lexer:     "autodetect",
+		style:     "swapoff",
+		formatter: "terminal",
+	}
+	i := 0
+	for i < len(args) {
+		a := args[i]
+		if a == "--" {
+			i++
+			for i < len(args) {
+				f.files = append(f.files, args[i])
+				i++
+			}
+			break
+		}
+		if a == "-" {
+			f.files = append(f.files, "-")
+			i++
+			continue
+		}
+		if strings.HasPrefix(a, "-") && a != "-" {
+			name, val, hasVal := splitFlag(a)
+			if name == "-h" || name == "--help" {
+				f.setAction(actHelp)
+				i++
+				continue
+			}
+			if name == "--version" {
+				f.setAction(actVersion)
+				i++
+				continue
+			}
+			if name == "--list" {
+				f.setAction(actList)
+				i++
+				continue
+			}
+			if !knownFlag(name) {
+				return nil, fmt.Errorf("unknown flag %s", name)
+			}
+			if hasVal {
+				assignFlag(f, name, val)
+				i++
+				continue
+			}
+			if valueFlags[name] {
+				if i+1 >= len(args) {
+					return nil, fmt.Errorf("flag %s requires a value", name)
+				}
+				assignFlag(f, name, args[i+1])
+				i += 2
+				continue
+			}
+			assignFlag(f, name, "")
+			i++
+			continue
+		}
+		f.files = append(f.files, a)
+		i++
+	}
+	applyConvenience(f)
+	// --help/--version bypass validation; other actions (incl. --list) do not.
+	if f.action != actHelp && f.action != actVersion {
+		if err := validateFormatter(f); err != nil {
+			return nil, err
+		}
+	}
+	return f, nil
+}
+
+func applyConvenience(f *flags) {
+	if f.json {
+		f.formatter = "json"
+	}
+	if f.html {
+		f.formatter = "html"
+	}
+	if f.svg {
+		f.formatter = "svg"
+	}
+}
+
+func validateFormatter(f *flags) error {
+	switch f.formatter {
+	case "html", "json", "noop", "svg", "terminal", "terminal16", "terminal16m", "terminal256", "terminal8", "tokens":
+		return nil
+	}
+	list := "\"html\",\"json\",\"noop\",\"svg\",\"terminal\",\"terminal16\",\"terminal16m\",\"terminal256\",\"terminal8\",\"tokens\""
+	return fmt.Errorf("--formatter must be one of %s but got %q", list, f.formatter)
+}
+
+func splitFlag(s string) (name, val string, hasVal bool) {
+	if strings.HasPrefix(s, "--") {
+		rest := s[2:]
+		if eq := strings.IndexByte(rest, '='); eq >= 0 {
+			return "--" + rest[:eq], rest[eq+1:], true
+		}
+		return s, "", false
+	}
+	// short flag: -l, -h, -lvalue or -l value
+	rest := s[1:]
+	if len(rest) > 1 {
+		return "-" + string(rest[0]), rest[1:], true
+	}
+	return s, "", false
+}
+
+func assignFlag(f *flags, name, val string) {
+	switch name {
+	case "-l", "--lexer":
+		f.lexer = val
+	case "-s", "--style":
+		f.style = val
+	case "-f", "--formatter":
+		f.formatter = val
+	case "--filename":
+		f.filename = val
+	case "--unbuffered":
+		f.unbuffered = true
+	case "--trace":
+		f.trace = true
+	case "--check":
+		f.check = true
+	case "--fail":
+		f.fail = true
+	case "--json":
+		f.json = true
+	case "--html":
+		f.html = true
+	case "--svg":
+		f.svg = true
+	}
+}
diff --git a/chroma_src/pipeline.go b/chroma_src/pipeline.go
new file mode 100644
index 0000000..696b037
--- /dev/null
+++ b/chroma_src/pipeline.go
@@ -0,0 +1,47 @@
+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+func doHighlight(f *flags) error {
+	if err := resolveStyle(f); err != nil {
+		return err
+	}
+	lex := resolveLexer(f)
+	form, ferr := getFormatter(f)
+	if ferr != nil {
+		return ferr
+	}
+	return runInput(f, lex, form)
+}
+
+// resolveStyle loads the style named f.style. Unknown built-in styles and the
+// default "swapoff" are treated as file paths and fail with an open error.
+func resolveStyle(f *flags) error {
+	st := f.style
+	if registeredStyle(st) {
+		return nil
+	}
+	if _, err := os.Stat(st); err == nil {
+		return nil
+	}
+	return fmt.Errorf("open %s: no such file or directory", st)
+}
+
+func resolveLexer(f *flags) *lexer {
+	if l := findLexer(f.lexer); l != nil {
+		return l
+	}
+	return fallbackLexer
+}
+
+func getFormatter(f *flags) (formatter, error) {
+	switch f.formatter {
+	case "html", "json", "noop", "svg", "terminal", "terminal16", "terminal16m", "terminal256", "terminal8", "tokens":
+		return nil, nil
+	}
+	list := "\"html\",\"json\",\"noop\",\"svg\",\"terminal\",\"terminal16\",\"terminal16m\",\"terminal256\",\"terminal8\",\"tokens\""
+	return nil, fmt.Errorf("--formatter must be one of %s but got %q", list, f.formatter)
+}
