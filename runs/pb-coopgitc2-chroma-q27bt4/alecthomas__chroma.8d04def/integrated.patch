++package main
++
++import (
++	"fmt"
++	"io"
++	"strings"
++)
++
++// formatter renders the lexed+styled tokens to a writer.
++type formatter interface {
++	format(w io.Writer, st *style, toks tokens, src string) error
++}
++
++// displayType maps the internal dotted token type (e.g. "Name.Class") to the
++// display name used by the json and tokens formatters (e.g. "NameClass").
++func displayType(t string) string {
++	return strings.ReplaceAll(t, ".", "")
++}
++
++// escapeSeq returns the ANSI escape that activates c's attributes for the base
++// "terminal"/"terminal8" formatters. For {fg:"37",bold:true} this is
++// "\x1b[1m\x1b[37m".
++func escapeSeq(c colorSpec) string {
++	var b strings.Builder
++	if c.bold {
++		b.WriteString("\x1b[1m")
++	}
++	if c.italic {
++		b.WriteString("\x1b[3m")
++	}
++	if c.uline {
++		b.WriteString("\x1b[4m")
++	}
++	if c.fg != "" {
++		b.WriteString("\x1b[" + c.fg + "m")
++	}
++	if c.bg != "" {
++		b.WriteString("\x1b[" + c.bg + "m")
++	}
++	return b.String()
++}
++
++// monokaiRGB maps a monokai (8-color fg, bold) pair to its 24-bit RGB and
++// 256-palette index, used by the terminal16m and terminal256 formatters. The
++// bold flag disambiguates the two yellow/white pairs.
++func monokaiRGB(c colorSpec) ([3]uint8, byte) {
++	switch {
++	case c.fg == "37" && c.bold:
++		return [3]uint8{248, 248, 242}, 231
++	case c.fg == "33" && c.bold:
++		return [3]uint8{166, 226, 46}, 148
++	case c.fg == "36" && c.bold:
++		return [3]uint8{102, 217, 239}, 81
++	case c.fg == "31" && c.bold:
++		return [3]uint8{249, 38, 114}, 197
++	case c.fg == "30" && c.bold:
++		return [3]uint8{117, 113, 94}, 242
++	case c.fg == "33" && !c.bold:
++		return [3]uint8{174, 129, 255}, 141
++	case c.fg == "37" && !c.bold:
++		return [3]uint8{230, 219, 116}, 186
++	default:
++		return [3]uint8{248, 248, 242}, 231
++	}
++}
++
++// variantEscape returns the escape sequence for color c in the given terminal
++// variant. The base "terminal"/"terminal8" use the bold+8-color model; the
++// "terminal16" variant uses bright colors for bold tokens; the "terminal16m"
++// and "terminal256" variants use 24-bit RGB and 256-palette codes (no bold).
++func variantEscape(c colorSpec, variant string) string {
++	switch variant {
++	case "terminal16":
++		if c.bold {
++			// bright: 30->90 .. 37->97
++			if len(c.fg) == 2 {
++				return "\x1b[9" + c.fg[1:] + "m"
++			}
++			return "\x1b[" + c.fg + "m"
++		}
++		if c.fg != "" {
++			return "\x1b[" + c.fg + "m"
++		}
++		return ""
++	case "terminal16m":
++		rgb, _ := monokaiRGB(c)
++		return fmt.Sprintf("\x1b[38;2;%d;%d;%dm", rgb[0], rgb[1], rgb[2])
++	case "terminal256":
++		_, c256 := monokaiRGB(c)
++		return fmt.Sprintf("\x1b[38;5;%dm", c256)
++	default:
++		return escapeSeq(c)
++	}
++}
++
++// terminalWriter is the ANSI "closed" model: a style span is opened with an
++// escape sequence and closed with "\x1b[0m"; newlines are written after the
++// span is closed.
++type terminalWriter struct {
++	w       io.Writer
++	esc     string
++	open    bool
++	variant string
++}
++
++func (tw *terminalWriter) openSpan() {
++	if !tw.open {
++		tw.w.Write([]byte(tw.esc))
++		tw.open = true
++	}
++}
++
++func (tw *terminalWriter) closeSpan() {
++	if tw.open {
++		tw.w.Write([]byte("\x1b[0m"))
++		tw.open = false
++	}
++}
++
++// writeToken writes a single token's value, opening/closing the style span
++// and handling embedded newlines so that each line's newline sits outside the
++// span. Bytes are emitted one at a time so a newline inside the value always
++// triggers a span close/reopen.
++func (tw *terminalWriter) writeToken(c colorSpec, v string) {
++	tw.esc = variantEscape(c, tw.variant)
++	tw.openSpan()
++	for i := 0; i < len(v); i++ {
++		ch := v[i]
++		if ch == '\n' {
++			tw.closeSpan()
++			tw.w.Write([]byte("\n"))
++			continue
++		}
++		tw.openSpan()
++		tw.w.Write([]byte{ch})
++	}
++	tw.closeSpan()
++}
++
++// terminalFormatter writes ANSI-colored output. The variant selects the color
++// encoding: base "terminal"/"terminal8" use bold+8-color, while
++// "terminal16"/"terminal16m"/"terminal256" use bright/RGB/256 codes.
++type terminalFormatter struct {
++	variant string
++}
++
++func (tf terminalFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
++	tw := &terminalWriter{w: w, variant: tf.variant}
++	for _, t := range toks {
++		c, _ := styleFor(st, t.t)
++		tw.writeToken(c, t.v)
++	}
++	return nil
++}
++
++// jsonFormatter writes a JSON array of {type, value} pairs (one per token).
++// The type is the undotted display name.
++type jsonFormatter struct{}
++
++func (jsonFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
++	w.Write([]byte("[\n"))
++	for i, t := range toks {
++		if i > 0 {
++			w.Write([]byte(",\n"))
++		}
++		fmt.Fprintf(w, `  {"type":"%s","value":%s}`, displayType(t.t), jsonQuote(t.v))
++	}
++	w.Write([]byte("\n]\n"))
++	return nil
++}
++
++func jsonQuote(s string) string {
++	var b strings.Builder
++	b.WriteByte('"')
++	for _, r := range s {
++		switch r {
++		case '"':
++			b.WriteString(`\"`)
++		case '\\':
++			b.WriteString(`\\`)
++		case '\n':
++			b.WriteString(`\n`)
++		case '\t':
++			b.WriteString(`\t`)
++		case '\r':
++			b.WriteString(`\r`)
++		default:
++			if r < 0x20 {
++				fmt.Fprintf(&b, `\u%04x`, int(r))
++			} else {
++				b.WriteRune(r)
++			}
++		}
++	}
++	b.WriteByte('"')
++	return b.String()
++}
++
++// tokensFormatter writes each token as a Go-style "&Token{Type, \"value\"}"
++// line, using the undotted display name for the type.
++type tokensFormatter struct{}
++
++func (tokensFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
++	for _, t := range toks {
++		fmt.Fprintf(w, "&Token{%s, %q}\n", displayType(t.t), t.v)
++	}
++	return nil
++}
++
++// noopFormatter writes the source verbatim.
++type noopFormatter struct{}
++
++func (noopFormatter) format(w io.Writer, st *style, toks tokens, src string) error {
++	_, err := w.Write([]byte(src))
++	return err
++}
++
++// makeFormatter selects the formatter by name.
++func makeFormatter(f *flags) formatter {
++	switch f.formatter {
++	case "json":
++		return jsonFormatter{}
++	case "tokens":
++		return tokensFormatter{}
++	case "noop":
++		return noopFormatter{}
++	case "terminal", "terminal8", "terminal16", "terminal16m", "terminal256":
++		return terminalFormatter{variant: f.formatter}
++	case "html":
++		return terminalFormatter{variant: "terminal"}
++	case "svg":
++		return terminalFormatter{variant: "terminal"}
++	}
++	return terminalFormatter{variant: "terminal"}
++}
