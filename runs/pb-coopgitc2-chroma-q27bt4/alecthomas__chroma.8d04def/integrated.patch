++// styleFor returns the color spec for token type t, walking up parent types
++// (Literal.Number.Integer -> Literal.Number -> Literal) and finally falling
++// back to the default "Text" entry.
++func styleFor(st *style, t string) (colorSpec, bool) {
++	for {
++		if c, ok := (*st)[t]; ok {
++			return c, true
++		}
++		i := lastIndexByte(t, '.')
++		if i < 0 {
++			break
++		}
++		t = t[:i]
++	}
++	if c, ok := (*st)["Text"]; ok {
++		return c, true
++	}
++	return colorSpec{}, false
++}
++
++func lastIndexByte(s string, b byte) int {
++	for i := len(s) - 1; i >= 0; i-- {
++		if s[i] == b {
++			return i
++		}
++	}
++	return -1
++}
