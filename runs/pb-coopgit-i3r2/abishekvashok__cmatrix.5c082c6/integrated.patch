+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <ctype.h>
+#include <math.h>
+#include <time.h>
+#include <errno.h>
+#include <limits.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/utsname.h>
+#include <ncurses.h>
+
+#define VERSION "2.0"
+#define COMPILE_TIME __DATE__ " " __TIME__
+#define DEFAULT_DELAY 4
+#define MAX_DELAY 10
+#define MIN_DELAY 0
+
+typedef struct {
+    int async;
+    int bold;
+    int all_bold;
+    int force_term;
+    int linux_mode;
+    int old_scroll;
+    int shadows;
+    int lock;
+    int rainbow;
+    int lambda;
+    int chars_change;
+    int screensaver;
+    int x_mode;
+    int tty_fd;
+    int delay;
+    int c;
+    int no_bold;
+    char *color;
+    char *message;
+    int has_message;
+} options_t;
+
+static const char *color_names[] = {
+    "green", "red", "yellow", "blue", "magenta", "cyan", "white", "black"
+};
+
+static const char *katakana = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+static const char *latin = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+static const char *katakana_full = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+
+static options_t opts;
+static int width, height;
+static int running = 1;
+static int current_color = 0;
+static char *message = NULL;
+static int message_set = 0;
+
+static int async_scroll = 0;
+static int bold_chars = 0;
+static int all_bold = 0;
+static int no_bold = 0;
+static int force_term = 0;
+static int linux_mode = 0;
+static int old_style = 0;
+static int only_shadows = 0;
+static int lock_mode = 0;
+static int rainbow_mode = 0;
+static int lambda_mode = 0;
+static int chars_change = 0;
+static int x_mode = 0;
+static int screensaver_mode = 0;
+static int tty_set = 0;
+static int update_delay = DEFAULT_DELAY;
+static char *color = "green";
+static char *tty = NULL;
+
+static const char *valid_colors[] = {
+    "green", "red", "blue", "white", "yellow", "cyan", "magenta", "black"
+};
+
+static void print_usage(void) {
+    printf(" Usage: cmatrix -[abBcfhlsmVxk] [-u delay] [-C color] [-t tty] [-M message]\n");
+    printf(" -a: Asynchronous scroll\n");
+    printf(" -b: Bold characters on\n");
+    printf(" -B: All bold characters (overrides -b)\n");
+    printf(" -c: Use Japanese characters as seen in the original matrix. Requires appropriate fonts\n");
+    printf(" -f: Force the linux $TERM type to be on\n");
+    printf(" -l: Linux mode (uses matrix console font)\n");
+    printf(" -L: Lock mode (can be closed from another terminal)\n");
+    printf(" -o: Use old-style scrolling\n");
+    printf(" -h: Print usage and exit\n");
+    printf(" -n: No bold characters (overrides -b and -B, default)\n");
+    printf(" -s: \"Screensaver\" mode, exits on first keystroke\n");
+    printf(" -x: X window mode, use if your xterm is using mtx.pcf\n");
+    printf(" -V: Print version information and exit\n");
+    printf(" -M [message]: Prints your message in the center of the screen. Overrides -L's default message.\n");
+    printf(" -u delay (0 - 10, default 4): Screen update delay\n");
+    printf(" -C [color]: Use this color for matrix (default green)\n");
+    printf(" -r: rainbow mode\n");
+    printf(" -m: lambda mode\n");
+    printf(" -k: Characters change while scrolling. (Works without -o opt.)\n");
+    printf(" -t [tty]: Set tty to use\n");
+}
+
+static void print_version(void) {
+    printf(" CMatrix version %s (compiled %s)\n", VERSION, COMPILE_TIME);
+    printf("Email: abishekvashok@gmail.com\n");
+    printf("Web: https://github.com/abishekvashok/cmatrix\n");
+}
+
+static int parse_color(const char *str) {
+    if (str == NULL) return 0;
+    for (int i = 0; i < 8; i++) {
+        if (strcasecmp(str, color_names[i]) == 0) return i;
+    }
+    return 0;
+}
+
+static int validate_color(const char *color) {
+    for (int i = 0; i < 8; i++) {
+        if (strcmp(color, valid_colors[i]) == 0) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void set_color(int color) {
+    current_color = color;
+}
+
+static void set_tty(int tty_fd) {
+    struct termios oldt, newt;
+    if (tcgetattr(tty_fd, &oldt) != 0) {
+        fprintf(stderr, "cmatrix: error: couldn't get terminal attributes\n");
+        exit(1);
+    }
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    if (tcsetattr(tty_fd, TCSANOW, &newt) != 0) {
+        fprintf(stderr, "cmatrix: error: couldn't set terminal attributes\n");
+        exit(1);
+    }
+    opts.tty_fd = tty_fd;
+}
+
+static void restore_tty(void) {
+    if (opts.tty_fd >= 0) {
+        struct termios oldt;
+        if (tcgetattr(opts.tty_fd, &oldt) == 0) {
+            tcsetattr(opts.tty_fd, TCSANOW, &oldt);
+        }
+    }
+}
+
+static void get_terminal_size(void) {
+    struct winsize ws;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
+        width = ws.ws_col;
+        height = ws.ws_row;
+    } else {
+        width = 80;
+        height = 24;
+    }
+}
+
+static char *get_char_for_col(int col) {
+    if (opts.c) {
+        return (char *)&katakana_full[col % strlen(katakana_full)];
+    }
+    return (char *)&latin[col % strlen(latin)];
+}
+
+static void clear_screen(void) {
+    printf("\033[2J\033[H");
+    fflush(stdout);
+}
+
+static void set_cursor_visible(void) {
+    printf("\033[?25h");
+    fflush(stdout);
+}
+
+static void set_cursor_hidden(void) {
+    printf("\033[?25l");
+    fflush(stdout);
+}
+
+static void set_color_code(int color) {
+    switch (color) {
+        case 0: printf("\033[32m"); break;  // green
+        case 1: printf("\033[31m"); break;  // red
+        case 2: printf("\033[33m"); break;  // yellow
+        case 3: printf("\033[34m"); break;  // blue
+        case 4: printf("\033[35m"); break;  // magenta
+        case 5: printf("\033[36m"); break;  // cyan
+        case 6: printf("\033[37m"); break;  // white
+        case 7: printf("\033[30m"); break;  // black
+    }
+}
+
+static void set_bold(int bold) {
+    if (bold) printf("\033[1m");
+    else printf("\033[22m");
+}
+
+static void draw_line(int y, int x, int col) {
+    char c = get_char_for_col(col)[0];
+    set_color_code(current_color);
+    if (opts.bold || opts.all_bold) {
+        set_bold(1);
+    } else {
+        set_bold(0);
+    }
+    printf("%c", c);
+    printf("\033[0m");
+}
+
+static void update_matrix(void) {
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            int col = (x + y * width + (rand() % 100)) % (width * height);
+            draw_line(y, x, col);
+        }
+    }
+}
+
+static void draw_message(void) {
+    if (message_set) {
+        printf("\033[%d;%dH", height / 2, width / 2);
+        printf("\033[1;37m%s\033[0m", message);
+    }
+}
+
+static void draw_lock_message(void) {
+    if (opts.lock && !message_set) {
+        printf("\033[%d;%dH", height / 2, width / 2);
+        printf("\033[1;37mPress any key to close\033[0m");
+    }
+}
+
+static int get_key(void) {
+    if (opts.tty_fd >= 0) {
+        char buf[10];
+        fd_set fds;
+        struct timeval tv;
+        int ret;
+        
+        FD_ZERO(&fds);
+        FD_SET(opts.tty_fd, &fds);
+        tv.tv_sec = 0;
+        tv.tv_usec = 100000;
+        
+        ret = select(opts.tty_fd + 1, &fds, NULL, NULL, &tv);
+        if (ret > 0 && FD_ISSET(opts.tty_fd, &fds)) {
+            ret = read(opts.tty_fd, buf, sizeof(buf) - 1);
+            if (ret > 0) {
+                buf[ret] = '\0';
+                return buf[0];
+            }
+        }
+    }
+    return -1;
+}
+
+static void handle_key(int key) {
+    if (opts.screensaver) return;
+    
+    switch (key) {
+        case 'a':
+            opts.async = !opts.async;
+            break;
+        case 'b':
+            opts.bold = 1;
+            opts.all_bold = 0;
+            opts.no_bold = 0;
+            break;
+        case 'B':
+            opts.all_bold = 1;
+            opts.bold = 0;
+            opts.no_bold = 0;
+            break;
+        case 'n':
+            opts.no_bold = 1;
+            opts.bold = 0;
+            opts.all_bold = 0;
+            break;
+        case '0':
+        case '1':
+        case '2':
+        case '3':
+        case '4':
+        case '5':
+        case '6':
+        case '7':
+        case '8':
+        case '9':
+            opts.delay = key - '0';
+            if (opts.delay < 0) opts.delay = 0;
+            if (opts.delay > MAX_DELAY) opts.delay = MAX_DELAY;
+            break;
+        case '!':
+            set_color(1);  // red
+            break;
+        case '@':
+            set_color(0);  // green
+            break;
+        case '#':
+            set_color(2);  // yellow
+            break;
+        case '$':
+            set_color(3);  // blue
+            break;
+        case '%':
+            set_color(4);  // magenta
+            break;
+        case '^':
+            set_color(5);  // cyan
+            break;
+        case '&':
+            set_color(6);  // white
+            break;
+        case ')':
+            set_color(7);  // black
+            break;
+        case 'q':
+            running = 0;
+            break;
+    }
+}
+
+static void run(void) {
+    set_cursor_hidden();
+    clear_screen();
+    
+    if (opts.linux_mode) {
+        printf("\033]1000;matrix.fnt\007");
+    }
+    
+    if (opts.force_term) {
+        setenv("TERM", "linux", 1);
+    }
+    
+    if (opts.tty_fd >= 0) {
+        set_tty(opts.tty_fd);
+    }
+    
+    srand(time(NULL));
+    
+    while (running) {
+        if (opts.rainbow) {
+            current_color = rand() % 8;
+        }
+        
+        if (opts.lambda) {
+            for (int y = 0; y < height; y++) {
+                for (int x = 0; x < width; x++) {
+                    printf("\033[%d;%dH", y + 1, x + 1);
+                    printf("\033[32m\033[1m\033[90m\033[37m\033[0m");
+                    printf("λ");
+                }
+            }
+        } else {
+            update_matrix();
+        }
+        
+        if (opts.chars_change && !opts.old_scroll) {
+            for (int y = 0; y < height; y++) {
+                for (int x = 0; x < width; x++) {
+                    int col = (x + y * width + (rand() % 100)) % (width * height);
+                    draw_line(y, x, col);
+                }
+            }
+        }
+        
+        if (opts.has_message) {
+            message_set = 1;
+            strncpy(message, opts.message, sizeof(message) - 1);
+            message[sizeof(message) - 1] = '\0';
+        }
+        
+        if (opts.lock) {
+            draw_lock_message();
+        }
+        
+        if (opts.has_message) {
+            draw_message();
+        }
+        
+        if (opts.screensaver) {
+            int key = get_key();
+            if (key >= 0) {
+                running = 0;
+            }
+        } else {
+            int key = get_key();
+            if (key >= 0) {
+                handle_key(key);
+            }
+        }
+        
+        usleep(opts.delay * 100000);
+    }
+    
+    set_cursor_visible();
+    restore_tty();
+}
+
+static int open_terminal(const char *tty_path) {
+    struct termios oldt, newt;
+    int fd;
+    
+    if (tty_path) {
+        fd = open(tty_path, O_RDWR);
+        if (fd < 0) {
+            printf("cmatrix: error: '%s' couldn't be opened: %s.\n", tty_path, strerror(errno));
+            return -1;
+        }
+    } else {
+        fd = STDIN_FILENO;
+    }
+    
+    if (tcgetattr(fd, &oldt) < 0) {
+        printf("Error opening terminal: unknown.\n");
+        return -1;
+    }
+    
+    newt = oldt;
+    newt.c_lflag &= ~(ECHO | ICANON);
+    newt.c_cc[VMIN] = 0;
+    newt.c_cc[VTIME] = 0;
+    
+    if (tcsetattr(fd, TCSANOW, &newt) < 0) {
+        printf("Error opening terminal: unknown.\n");
+        return -1;
+    }
+    
+    return fd;
+}
+
+static void close_terminal(int fd) {
+    struct termios oldt;
+    if (tcgetattr(fd, &oldt) >= 0) {
+        tcsetattr(fd, TCSANOW, &oldt);
+    }
+    if (tty) {
+        close(fd);
+    }
+}
+
+static void init_ncurses(void) {
+    initscr();
+    cbreak();
+    noecho();
+    keypad(stdscr, TRUE);
+    curs_set(0);
+    nodelay(stdscr, TRUE);
+    scrollok(stdscr, TRUE);
+}
+
+static void reset_ncurses(void) {
+    endwin();
+}
+
+static int get_random_char(void) {
+    static const char *katakana = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+    static const char *latin = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    static const char *katakana2 = "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789";
+    
+    int choice = rand() % 3;
+    if (choice == 0) {
+        return rand() % (strlen(katakana) + 1);
+    } else if (choice == 1) {
+        return rand() % (strlen(latin) + 1);
+    } else {
+        return rand() % (strlen(katakana2) + 1);
+    }
+}
+
+static int get_random_char_old(void) {
+    static const char *katakana = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
+    static const char *latin = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    static const char *katakana2 = "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789";
+    
+    int choice = rand() % 3;
+    if (choice == 0) {
+        return rand() % (strlen(katakana) + 1);
+    } else if (choice == 1) {
+        return rand() % (strlen(latin) + 1);
+    } else {
+        return rand() % (strlen(katakana2) + 1);
+    }
+}
+
+static void draw_matrix(int fd) {
+    int height, width;
+    int x, y;
+    int col, row;
+    int i, j;
+    int char_idx;
+    int color_idx;
+    int current_color = 0;
+    
+    getmaxyx(stdscr, height, width);
+    
+    for (y = 0; y < height; y++) {
+        for (x = 0; x < width; x++) {
+            if (y == height - 1) {
+                mvaddch(y, x, ' ');
+                continue;
+            }
+            
+            char_idx = get_random_char();
+            if (char_idx == 0) {
+                mvaddch(y, x, ' ');
+                continue;
+            }
+            
+            if (lambda_mode) {
+                mvaddch(y, x, 0x03BB);
+                continue;
+            }
+            
+            if (old_style) {
+                char_idx = get_random_char_old();
+            }
+            
+            if (char_idx == 0) {
+                mvaddch(y, x, ' ');
+                continue;
+            }
+            
+            if (rainbow_mode) {
+                color_idx = (current_color + x) % 8;
+                current_color = (current_color + 1) % 8;
+            } else {
+                color_idx = 0;
+            }
+            
+            if (only_shadows) {
+                attron(A_REVERSE);
+            } else {
+                attron(COLOR_PAIR(color_idx + 1));
+            }
+            
+            if (all_bold) {
+                attron(A_BOLD);
+            } else if (bold_chars) {
+                if (rand() % 100 < 50) {
+                    attron(A_BOLD);
+                }
+            }
+            
+            mvaddch(y, x, (char)char_idx);
+            attroff(A_BOLD);
+            attroff(COLOR_PAIR(color_idx + 1));
+            attroff(A_REVERSE);
+        }
+    }
+    
+    if (message && !message_set) {
+        int msg_height = 2;
+        int msg_width = strlen(message) + 2;
+        int msg_x = (width - msg_width) / 2;
+        int msg_y = (height - msg_height) / 2;
+        mvaddstr(msg_y, msg_x, message);
+        mvaddstr(msg_y + 1, msg_x, message);
+    }
+}
