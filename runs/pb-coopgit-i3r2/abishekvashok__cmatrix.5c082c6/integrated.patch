+    
+    if (old_style) {
+        draw_matrix_old(fd);
+    } else {
+        draw_matrix(fd);
+    }
+    
+    refresh();
+    
+    while (running) {
+        int ch = getch();
+        
+        if (ch == 'q' || ch == 'Q') {
+            running = 0;
+        } else if (ch == 'a' || ch == 'A') {
+            async_scroll = !async_scroll;
+        } else if (ch == 'b' || ch == 'B') {
+            bold_chars = !bold_chars;
+        } else if (ch == 'n' || ch == 'N') {
+            bold_chars = 0;
+            all_bold = 0;
+        } else if (ch >= '0' && ch <= '9') {
+            update_delay = ch - '0';
+        } else if (ch == '!') {
+            color = "red";
+        } else if (ch == '@') {
+            color = "green";
+        } else if (ch == '#') {
+            color = "yellow";
+        } else if (ch == '$') {
+            color = "blue";
+        } else if (ch == '%') {
+            color = "magenta";
+        } else if (ch == '^') {
+            color = "cyan";
+        } else if (ch == '&') {
+            color = "white";
+        } else if (ch == ')') {
+            color = "black";
+        }
+        
+        if (screensaver_mode) {
+            break;
+        }
+        
+        if (update_delay < MIN_DELAY || update_delay > MAX_DELAY) {
+            update_delay = DEFAULT_DELAY;
+        }
+        
+        delay_ms = 1000 - (update_delay * 100);
+        usleep(delay_ms * 1000);
+        
+        if (old_style) {
+            draw_matrix_old(fd);
+        } else {
+            draw_matrix(fd);
+        }
+        
+        refresh();
+    }
+    
+    reset_ncurses();
+    close_terminal(fd);
+    
+    return 0;
+}
