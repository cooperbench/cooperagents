+int main(int argc, char *argv[]) {
+    int fd = -1;
+    int running = 1;
+    int key;
+    int delay_ms;
+    
+    parse_args(argc, argv);
+    
+    if (update_delay < MIN_DELAY || update_delay > MAX_DELAY) {
+        printf("Error opening terminal: unknown.\n");
+        return 1;
+    }
+    
+    if (tty_set && tty) {
+        fd = open_terminal(tty);
+        if (fd < 0) {
+            return 1;
+        }
+    } else {
+        fd = open_terminal(NULL);
+        if (fd < 0) {
+            return 1;
