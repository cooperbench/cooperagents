index 0000000..d3aaffc
--- /dev/null
+++ b/compile.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -e
+cd "$(dirname "$0")"
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS=-mod=mod
+export GOTOOLCHAIN=local
+
+# Find a go toolchain that is >= 1.24 (tcell v2.13.10 requires go >= 1.24.0)
+find_go() {
+    local g
+    for g in "$(command -v go 2>/dev/null || true)" \
+             /usr/local/go/bin/go \
+             /usr/local/go/mod-cache/golang.org/toolchain@*/bin/go; do
+        [ -x "$g" ] || continue
+        local v
+        v=$("$g" version 2>/dev/null | grep -oE 'go1\.[0-9]+' | head -1 || true)
+        # accept any go1.24 or newer (major.minor >= 1.24)
+        case "$v" in
+            go1.2[4-9]|go1.[3-9][0-9]|go1.1[0-9][0-9]) echo "$g"; return 0;;
+        esac
+    done
+}
+GO=$(find_go)
+[ -n "$GO" ] || { echo "no suitable go toolchain found" >&2; exit 1; }
+echo "using go: $GO ($($GO version 2>&1))"
+"$GO" build -o executable .
