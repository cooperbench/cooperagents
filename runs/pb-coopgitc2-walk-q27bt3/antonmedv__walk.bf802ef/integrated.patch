++find_go() {
++    local g
++    for g in "$(command -v go 2>/dev/null || true)" \
++             /usr/local/go/bin/go \
++             /usr/local/go/mod-cache/golang.org/toolchain@*/bin/go; do
++        [ -x "$g" ] || continue
++        local v
++        v=$("$g" version 2>/dev/null | grep -oE 'go1\.[0-9]+' | head -1 || true)
++        # accept any go1.24 or newer (major.minor >= 1.24)
++        case "$v" in
++            go1.2[4-9]|go1.[3-9][0-9]|go1.1[0-9][0-9]) echo "$g"; return 0;;
++        esac
++    done
++}
