+    --dir-only     show dirs only
+    --hide-hidden  hide hidden files
+    --preview      display preview
+    --with-border  preview with border
+    --fuzzy        fuzzy mode
+
diff --git a/main.go b/main.go
new file mode 100644
index 0000000..13e4478
--- /dev/null
+++ b/main.go
@@ -0,0 +1,565 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/gdamore/tcell/v2"
+)
+
+const version = "v1.13.0"
+
+const helpText = `
+  walk v1.13.0
+
+  Usage: walk [path]
+
+    arrows, hjkl  Move cursor
+    enter         Enter directory
+    backspace     Exit directory
+    space         Toggle preview
+    esc, q        Exit with cd
+    ctrl+c        Exit without cd
+    /             Fuzzy search
+    d, delete     Delete file or dir
+    y             Copy to clipboard
+    .             Hide hidden files
+    ?             Show help
+
+  Flags:
+
+    --icons        display icons
+    --dir-only     show dirs only
+    --hide-hidden  hide hidden files
+    --preview      display preview
+    --with-border  preview with border
+    --fuzzy        fuzzy mode
+
+`
+
+func main() {
+	o := parseArgs(os.Args[1:])
+
+	if o.exitCode != 0 {
+		os.Exit(o.exitCode)
+	}
+	if o.versionSeen {
+		os.Exit(0)
+	}
+
+	fd, err := openTTY()
+	if err != nil {
+		panic("could not open a new TTY: " + err.Error())
+	}
+	runTUI(fd, o)
+}
+
+type opts struct {
+	exitCode    int
+	versionSeen bool
+	icons       bool
+	dirOnly     bool
+	hideHidden  bool
+	preview     bool
+	withBorder  bool
+	fuzzy       bool
+	path        string
+}
+
+func parseArgs(args []string) *opts {
+	o := &opts{}
+	o.path = "."
+
+loop:
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch a {
+		case "-v", "--version":
+			fmt.Println(version)
+			o.versionSeen = true
+			break loop
+		case "-h", "--help":
+			fmt.Fprint(os.Stderr, helpText)
+			o.exitCode = 1
+			break loop
+		case "--icons":
+			o.icons = true
+		case "--dir-only":
+			o.dirOnly = true
+		case "--hide-hidden":
+			o.hideHidden = true
+		case "--preview":
+			o.preview = true
+		case "--with-border":
+			o.withBorder = true
+		case "--fuzzy":
+			o.fuzzy = true
+		case "-":
+			o.path = "."
+		default:
+			if !startsWith(a, "-") {
+				if o.path == "." {
+					o.path = a
+				}
+			}
+			// ignore unknown flags (lenient)
+		}
+	}
+
+	return o
+}
+
+func startsWith(s, prefix string) bool {
+	return len(s) >= len(prefix) && s[:len(prefix)] == prefix
+}
+
+func openTTY() (int, error) {
+	f, err := os.OpenFile("/dev/tty", os.O_RDWR, 0)
+	if err != nil {
+		return 0, err
+	}
+	_ = f
+	return 0, nil
+}
+
+func runTUI(fd int, o *opts) {
+	screen, err := tcell.NewScreen()
+	if err != nil {
+		panic("could not create a new screen: " + err.Error())
+	}
+	if err = screen.Init(); err != nil {
+		panic("could not init the screen: " + err.Error())
+	}
+	defer screen.Fini()
+
+	a := &app{
+		screen:     screen,
+		opts:       o,
+		preview:    o.preview,
+		withBorder: o.withBorder,
+		fuzzy:      o.fuzzy,
+	}
+	a.mainColor = tcell.GetColor(strings.TrimSpace(os.Getenv("WALK_MAIN_COLOR")))
+	a.statusBar = os.Getenv("WALK_STATUS_BAR")
+	a.editor = pickEnv("WALK_EDITOR", "EDITOR")
+	a.openWith = os.Getenv("WALK_OPEN_WITH")
+	a.removeCmd = os.Getenv("WALK_REMOVE_CMD")
+
+	a.chdir(a.absPath(o.path))
+
+	for {
+		a.draw()
+		a.event()
+	}
+}
+
+type app struct {
+	screen     tcell.Screen
+	opts       *opts
+	dir        string
+	entries    []entry
+	cur        int
+	preview    bool
+	withBorder bool
+	fuzzy      bool
+	search     string
+	mainColor  tcell.Color
+	statusBar  string
+	editor     string
+	openWith   string
+	removeCmd  string
+}
+
+func (a *app) absPath(path string) string {
+	if path == "" {
+		path = "."
+	}
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = path
+	}
+	return abs
+}
+
+func (a *app) chdir(abs string) {
+	a.dir = abs
+	a.entries = loadEntries(abs, a.opts)
+	if a.cur >= len(a.entries) {
+		a.cur = 0
+	}
+}
+
+func (a *app) current() *entry {
+	if a.cur < 0 || a.cur >= len(a.entries) {
+		return nil
+	}
+	return &a.entries[a.cur]
+}
+
+func (a *app) mainStyle() tcell.Style {
+	fg := a.mainColor
+	if fg == 0 {
+		fg = tcell.ColorWhite
+	}
+	return tcell.StyleDefault.Background(fg).Foreground(tcell.ColorBlack)
+}
+
+func (a *app) draw() {
+	w, h := a.screen.Size()
+	a.screen.Clear()
+
+	// Status bar on row 0.
+	status := a.dir
+	if a.statusBar != "" {
+		status = a.statusBar
+	}
+	if w > 0 {
+		a.screen.PutStrStyled(0, 0, trunc(status, w), tcell.StyleDefault.Bold(true))
+	}
+
+	// File list starting at row 1.
+	listW := w
+	if a.preview {
+		listW = w / 2
+		if listW < 1 {
+			listW = 1
+		}
+	}
+	hl := a.mainStyle()
+	for i, e := range a.entries {
+		row := i + 1
+		if row >= h {
+			break
+		}
+		name := a.label(e)
+		if i == a.cur {
+			a.screen.PutStrStyled(0, row, trunc(name, listW), hl)
+		} else {
+			a.screen.PutStrStyled(0, row, trunc(name, listW), tcell.StyleDefault)
+		}
+	}
+
+	if a.preview {
+		a.drawPreview(w, h)
+	}
+
+	a.screen.ShowCursor(0, a.cur+1)
+	a.screen.Show()
+}
+
+func (a *app) label(e entry) string {
+	name := e.name
+	if e.isDir {
+		name = name + "/"
+	}
+	return name
+}
+
+func (a *app) drawPreview(w, h int) {
+	col := w / 2
+	if col < 1 {
+		col = 1
+	}
+	width := w - col
+	if width < 1 {
+		return
+	}
+	if a.withBorder {
+		for y := 0; y < h; y++ {
+			a.screen.PutStrStyled(col, y, "|", tcell.StyleDefault)
+		}
+	}
+	e := a.current()
+	if e == nil || e.isDir {
+		return
+	}
+	content, err := os.ReadFile(filepath.Join(a.dir, e.name))
+	if err != nil {
+		return
+	}
+	lines := strings.Split(string(content), "\n")
+	for i, ln := range lines {
+		y := i + 1
+		if y >= h {
+			break
+		}
+		a.screen.PutStrStyled(col, y, trunc(ln, width), tcell.StyleDefault)
+	}
+}
+
+func (a *app) event() {
+	ev := a.screen.PollEvent()
+	keyEv, ok := ev.(*tcell.EventKey)
+	if !ok {
+		return
+	}
+
+	switch keyEv.Key() {
+	case tcell.KeyCtrlC:
+		a.exit(false)
+		return
+	case tcell.KeyEscape:
+		a.exit(true)
+		return
+	}
+
+	shift := keyEv.Modifiers()&tcell.ModShift != 0
+	switch keyEv.Key() {
+	case tcell.KeyDown:
+		if shift {
+			a.jumpEnd()
+		} else {
+			a.moveDown()
+		}
+	case tcell.KeyUp:
+		if shift {
+			a.jumpStart()
+		} else {
+			a.moveUp()
+		}
+	case tcell.KeyLeft:
+		a.moveUp()
+	case tcell.KeyRight:
+		a.moveDown()
+	case tcell.KeyEnter:
+		a.enter()
+	case tcell.KeyBackspace, tcell.KeyBackspace2:
+		a.back()
+	case tcell.KeyDelete:
+		a.delete()
+	}
+
+	if !shift {
+		switch keyEv.Rune() {
+		case 'q':
+			a.exit(true)
+		case 'j':
+			a.moveDown()
+		case 'k':
+			a.moveUp()
+		case 'h':
+			a.moveUp()
+		case 'l':
+			a.moveDown()
+		case ' ':
+			a.preview = !a.preview
+		case '/':
+			a.fuzzy = !a.fuzzy
+			a.search = ""
+		case '.':
+			a.opts.hideHidden = !a.opts.hideHidden
+			a.chdir(a.dir)
+		case 'd':
+			a.delete()
+		case 'y':
+			a.yank()
+		case '?':
+			// show help
+		default:
+			if a.fuzzy {
+				a.search += string(keyEv.Rune())
+			}
+		}
+	}
+}
+
+func (a *app) moveDown() {
+	if a.cur < len(a.entries)-1 {
+		a.cur++
+	}
+}
+
+func (a *app) moveUp() {
+	if a.cur > 0 {
+		a.cur--
+	}
+}
+
+func (a *app) jumpEnd() {
+	if len(a.entries) > 0 {
+		a.cur = len(a.entries) - 1
+	}
+}
+
+func (a *app) jumpStart() {
+	a.cur = 0
+}
+
+func (a *app) enter() {
+	e := a.current()
+	if e == nil {
+		return
+	}
+	if e.isDir {
+		a.chdir(filepath.Join(a.dir, e.name))
+		return
+	}
+	a.openFile(e)
+}
+
+func (a *app) back() {
+	parent := filepath.Dir(a.dir)
+	if parent != a.dir {
+		a.chdir(parent)
+	}
+}
+
+func (a *app) delete() {
+	e := a.current()
+	if e == nil {
+		return
+	}
+	target := filepath.Join(a.dir, e.name)
+	cmd := a.removeCmd
+	if cmd == "" {
+		cmd = "rm"
+	}
+	args := strings.Fields(cmd)
+	args = append(args, target)
+	if len(args) > 0 {
+		c := exec.Command(args[0], args[1:]...)
+		c.Run()
+	}
+	a.chdir(a.dir)
+}
+
+func (a *app) yank() {
+	e := a.current()
+	if e == nil {
+		return
+	}
+	// Best-effort copy to clipboard; fall back to printing the path.
+	if p := clipboardTool(); p != "" {
+		args := strings.Fields(p)
+		if len(args) > 0 {
+			c := exec.Command(args[0], args[1:]...)
+			c.Stdin = strings.NewReader(filepath.Join(a.dir, e.name))
+			c.Run()
+			return
+		}
+	}
+	fmt.Fprint(os.Stdout, filepath.Join(a.dir, e.name))
+}
+
+func clipboardTool() string {
+	for _, name := range []string{"pbcopy", "wl-copy", "xclip", "xsel"} {
+		if path, err := exec.LookPath(name); err == nil {
+			return path
+		}
+	}
+	return ""
+}
+
+func (a *app) openFile(e *entry) {
+	// WALK_OPEN_WITH is "ext:cmd" pairs.
+	if a.openWith != "" {
+		ext := ext(e.name)
+		for _, pair := range strings.Split(a.openWith, " ") {
+			pair = strings.TrimSpace(pair)
+			if pair == "" {
+				continue
+			}
+			kv := strings.SplitN(pair, ":", 2)
+			if len(kv) == 2 && kv[0] == ext {
+				args := strings.Fields(kv[1])
+				if len(args) > 0 {
+					args = append(args, filepath.Join(a.dir, e.name))
+					c := exec.Command(args[0], args[1:]...)
+					c.Run()
+					return
+				}
+			}
+		}
+	}
+	editor := a.editor
+	if editor == "" {
+		editor = "vi"
+	}
+	args := strings.Fields(editor)
+	if len(args) > 0 {
+		args = append(args, filepath.Join(a.dir, e.name))
+		c := exec.Command(args[0], args[1:]...)
+		c.Run()
+	}
+}
+
+func (a *app) exit(withCd bool) {
+	a.screen.Fini()
+	if withCd {
+		fmt.Fprint(os.Stdout, "cd "+a.dir+"\n")
+	}
+}
+
+type entry struct {
+	name  string
+	isDir bool
+	size  int64
+}
+
+func loadEntries(abs string, o *opts) []entry {
+	infos, err := os.ReadDir(abs)
+	if err != nil {
+		return []entry{}
+	}
+	out := make([]entry, 0, len(infos))
+	for _, fi := range infos {
+		name := fi.Name()
+		if o.hideHidden && len(name) > 0 && name[0] == '.' {
+			continue
+		}
+		isDir := fi.IsDir()
+		if o.dirOnly && !isDir {
+			continue
+		}
+		size := int64(0)
+		if fi.Type().IsRegular() {
+			if info, err := fi.Info(); err == nil {
+				size = info.Size()
+			}
+		}
+		out = append(out, entry{name: name, isDir: isDir, size: size})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].isDir != out[j].isDir {
+			return out[i].isDir
+		}
+		return strings.ToLower(out[i].name) < strings.ToLower(out[j].name)
+	})
+	return out
+}
+
+func pickEnv(names ...string) string {
+	for _, n := range names {
+		if v := os.Getenv(n); v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func ext(name string) string {
+	idx := strings.LastIndex(name, ".")
+	if idx < 0 {
+		return ""
+	}
+	return strings.ToLower(name[idx+1:])
+}
+
+func trunc(s string, width int) string {
+	if width <= 0 {
+		return ""
+	}
+	r := []rune(s)
+	if len(r) <= width {
+		return s
+	}
+	if width <= 1 {
+		return string(r[:width])
+	}
+	return string(r[:width-1]) + "…"
+}
