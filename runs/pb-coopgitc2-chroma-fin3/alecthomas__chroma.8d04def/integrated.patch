+    tab_width = options.get('tab_width', 8)
+    include_lines = options.get('include_lines', False)
+    bg_color = options.get('bg_color', DEFAULT_BG)
+    fg_color = options.get('fg_color', DEFAULT_FG)
+    
+    css_parts = []
+    if has_styles or all_styles:
+        css_parts.append(f'/* {prefix} */ .{prefix} {{ color:{fg_color};background-color:{bg_color}; }}')
+        css_parts.append(f'/* NameBuiltin */ .{prefix} .nb {{ color: #66d9ef }}')
+        css_parts.append(f'/* NameClass */ .{prefix} .nc {{ color: #a6e22e }}')
+        css_parts.append(f'/* NameFunction */ .{prefix} .nf {{ color: #a6e22e }}')
+        css_parts.append(f'/* NameTag */ .{prefix} .nt {{ color: #f92672 }}')
+        css_parts.append(f'/* NameFunctionMagic */ .{prefix} .fm {{ color: #a6e22e }}')
+        css_parts.append(f'/* Literal */ .{prefix} .l {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralDate */ .{prefix} .ld {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralString */ .{prefix} .s {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringAffix */ .{prefix} .sa {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringBacktick */ .{prefix} .sb {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringChar */ .{prefix} .sc {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringDelimiter */ .{prefix} .dl {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringDoc */ .{prefix} .sd {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringDouble */ .{prefix} .s2 {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringEscape */ .{prefix} .se {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralStringHeredoc */ .{prefix} .sh {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringInterpol */ .{prefix} .si {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringOther */ .{prefix} .sx {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringRegex */ .{prefix} .sr {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringSingle */ .{prefix} .s1 {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralStringSymbol */ .{prefix} .ss {{ color: #e6db74 }}')
+        css_parts.append(f'/* LiteralNumber */ .{prefix} .m {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralNumberBin */ .{prefix} .mb {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralNumberFloat */ .{prefix} .mf {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralNumberHex */ .{prefix} .mh {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralNumberInteger */ .{prefix} .mi {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralNumberIntegerLong */ .{prefix} .il {{ color: #ae81ff }}')
+        css_parts.append(f'/* LiteralNumberOct */ .{prefix} .mo {{ color: #ae81ff }}')
+        css_parts.append(f'/* Operator */ .{prefix} .o {{ color: #f92672 }}')
+        css_parts.append(f'/* OperatorWord */ .{prefix} .ow {{ color: #f92672 }}')
+        css_parts.append(f'/* OperatorReserved */ .{prefix} .or {{ color: #f92672 }}')
+        css_parts.append(f'/* Comment */ .{prefix} .c {{ color: #75715e }}')
+        css_parts.append(f'/* CommentHashbang */ .{prefix} .ch {{ color: #75715e }}')
+        css_parts.append(f'/* CommentMultiline */ .{prefix} .cm {{ color: #75715e }}')
+        css_parts.append(f'/* CommentSingle */ .{prefix} .c1 {{ color: #75715e }}')
+        css_parts.append(f'/* CommentSpecial */ .{prefix} .cs {{ color: #75715e }}')
+        css_parts.append(f'/* CommentPreproc */ .{prefix} .cp {{ color: #75715e }}')
+        css_parts.append(f'/* CommentPreprocFile */ .{prefix} .cpf {{ color: #75715e }}')
+        css_parts.append(f'/* GenericDeleted */ .{prefix} .gd {{ color: #f92672 }}')
+        css_parts.append(f'/* GenericEmph */ .{prefix} .ge {{ font-style: italic }}')
+        css_parts.append(f'/* GenericInserted */ .{prefix} .gi {{ color: #a6e22e }}')
+        css_parts.append(f'/* GenericStrong */ .{prefix} .gs {{ font-weight: bold }}')
+        css_parts.append(f'/* GenericSubheading */ .{prefix} .gu {{ color: #75715e }}')
+        css_parts.append(f'body {{ color:{fg_color};background-color:{bg_color}; }}')
+    
+    html_parts = ['<html>']
+    if has_styles or all_styles:
+        html_parts.append(f'<style type="text/css">\n{"\n".join(css_parts)}\n</style>')
+    
+    if inline_styles:
+        for token_type, value in tokens:
+            style = get_style(style_name, token_type)
+            color = style.get('color', DEFAULT_FG)
+            if token_type == TokenType.Keyword or token_type == TokenType.NameBuiltin:
+                html_parts.append(f'<span style="font-weight:bold;color:{color}">{html.escape(value)}</span>')
+            else:
+                html_parts.append(f'<span style="color:{color}">{html.escape(value)}</span>')
+    else:
+        for token_type, value in tokens:
+            class_name = f'{prefix} {token_type.name}'
+            html_parts.append(f'<span class="{class_name}">{html.escape(value)}</span>')
+    
+    if include_lines:
+        for i, (token_type, value) in enumerate(tokens):
+            if token_type == TokenType.Whitespace and value == '\n':
+                html_parts.append(f'<span class="{prefix} .ln">{i+1}</span>')
+    
+    html_parts.append('</html>')
+    return '\n'.join(html_parts)
