+
+    println!("Default themes have been written to {}", themes_path.display());
+}
+
+fn print_theme_help() {
+    println!("Provides commands regarding changing themes and styles of the app");
+    println!();
+    println!("Usage: executable theme <COMMAND>");
+    println!();
+    println!("Commands:");
+    println!("  print-path      Prints the path to the user themes file [aliases: path]");
+    println!("  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]");
+    println!("  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]");
+    println!("  help            Print this message or the help of the given subcommand(s)");
+    println!();
+    println!("Options:");
+    println!("  -h, --help  Print help");
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    
+    if args.len() > 1 && args[1] == "-V" || args.len() > 1 && args[1] == "--version" {
+        println!("tui-journal 0.16.1");
+        return;
+    }
+
+    if args.len() > 1 && args[1] == "-h" || args.len() > 1 && args[1] == "--help" {
+        print_help();
+        return;
+    }
+
+    let command = if args.len() > 1 {
+        args[1].clone()
+    } else {
+        String::new()
+    };
+
+    let subcommand = if args.len() > 2 {
+        args[2].clone()
+    } else {
+        String::new()
+    };
+
+    match command.as_str() {
+        "print-config" | "pc" => {
+            print_config();
+        }
+        "import-journals" | "imj" => {
+            if args.len() < 4 {
+                println!("Import journals from the given transfer JSON file to the current back-end file");
+                println!();
+                println!("Usage: executable import-journals --path <FILE PATH>");
+                println!();
+                println!("Options:");
+                println!("  -p, --path <FILE PATH>  Path of the JSON file to import from");
+                println!("  -h, --help              Print help");
+                std::process::exit(1);
+            }
+            let path = &args[3];
+            import_journals(path);
+        }
+        "assign-priority" | "ap" => {
+            if args.len() < 4 {
+                println!("Assign priority for all the entries with empty priority field");
+                println!();
+                println!("Usage: executable assign-priority <PRIORITY>");
+                println!();
+                println!("Arguments:");
+                println!("  <PRIORITY>  Priority value (Positive number)");
+                println!();
+                println!("Options:");
+                println!("  -h, --help  Print help");
+                std::process::exit(1);
+            }
+            let priority = &args[3];
+            assign_priority(priority);
+        }
+        "theme" | "style" => {
+            match subcommand.as_str() {
+                "print-path" | "path" => {
+                    print_theme_path();
+                }
+                "print-default" | "default" => {
+                    print_default_themes();
+                }
+                "write-defaults" | "write" => {
+                    write_default_themes();
+                }
+                "help" => {
+                    print_theme_help();
+                }
+                _ => {
+                    println!("Provides commands regarding changing themes and styles of the app");
+                    println!();
+                    println!("Usage: executable theme <COMMAND>");
+                    println!();
+                    println!("Commands:");
+                    println!("  print-path      Prints the path to the user themes file [aliases: path]");
+                    println!("  print-default   Dumps the styles with the default values to be used as a reference and base for user custom themes [aliases: default]");
+                    println!("  write-defaults  Creates user custom themes file if doesn't exist then writes the default styles to it [aliases: write]");
+                    println!("  help            Print this message or the help of the given subcommand(s)");
+                    println!();
+                    println!("Options:");
+                    println!("  -h, --help  Print help");
+                    std::process::exit(2);
+                }
+            }
+        }
+        "help" => {
+            print_help();
+        }
+        _ => {
+            print_help();
+            std::process::exit(1);
+        }
+    }
+}
