+                add_help=False
+            )
+            theme_parser.add_argument('command', nargs='?', help='Subcommand')
+            theme_parser.add_argument('-h', '--help', action='store_true', help='Print help')
+            
+            theme_args, rest = theme_parser.parse_known_args()
+            
+            if theme_args.help:
+                theme_help()
