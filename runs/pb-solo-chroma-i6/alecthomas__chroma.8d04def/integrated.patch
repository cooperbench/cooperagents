+
+# HTML formatter
+def format_html(tokens: List[Tuple[str, str]], style: str = 'swapoff', **kwargs) -> str:
+    """Format tokens as HTML."""
+    css_lines = []
+    colors = DEFAULT_COLORS if style == 'swapoff' else TOKEN_TYPES
+    
+    # Generate CSS
+    for token_type, color in colors.items():
+        css_lines.append(f'.chroma .{token_type} {{ color: {color}; }}')
+    
+    html_lines = []
+    html_lines.append('<style type="text/css">\\n' + '\\n'.join(css_lines) + '\\n</style>')
+    html_lines.append('<div class="chroma">')
+    
+    for token_type, value in tokens:
+        html_lines.append(f'<span class="{token_type}">{html.escape(value)}</span>')
+    
+    html_lines.append('</div>')
+    return '\\n'.join(html_lines)
+
+# SVG formatter
+def format_svg(tokens: List[Tuple[str, str]], style: str = 'swapoff') -> str:
+    """Format tokens as SVG."""
+    colors = DEFAULT_COLORS if style == 'swapoff' else TOKEN_TYPES
+    
+    # Map colors to SVG hex
+    color_map = {
+        'BRIGHT_CYAN': '#00FFFF',
+        'WHITE': '#FFFFFF',
+        'BRIGHT_YELLOW': '#FFFF00',
+        'BRIGHT_BLUE': '#00BFFF',
+        'BRIGHT_GREEN': '#00FF00',
+        'DIM': '#808080',
+        'RED': '#FF0000',
+        'BLUE': '#0000FF',
+        'CYAN': '#00FFFF',
+    }
+    
+    svg_lines = []
+    svg_lines.append('<?xml version="1.0" encoding="UTF-8"?>')
+    svg_lines.append('<svg xmlns="http://www.w3.org/2000/svg" width="100" height="20">')
+    
+    for token_type, value in tokens:
+        color = color_map.get(colors.get(token_type, 'WHITE'), '#000000')
+        svg_lines.append(f'<text x="0" y="15" fill="{color}">{html.escape(value)}</text>')
+    
+    svg_lines.append('</svg>')
+    return '\\n'.join(svg_lines)
+
+# Main function
+def main():
+    parser = argparse.ArgumentParser(
+        description='Chroma is a general purpose syntax highlighting library and corresponding command, for Go.',
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    
+    parser.add_argument('files', nargs='*', help='Files to highlight.')
+    parser.add_argument('-h', '--help', action='store_true', help='Show context-sensitive help.')
+    parser.add_argument('--version', action='store_true', help='Show version.')
+    parser.add_argument('--list', action='store_true', help='List lexers, styles and formatters.')
+    parser.add_argument('--unbuffered', action='store_true', help='Do not buffer output.')
+    parser.add_argument('--trace', action='store_true', help='Trace lexer states as they are traversed.')
+    parser.add_argument('--check', action='store_true', help='Do not format, check for tokenisation errors instead.')
+    parser.add_argument('--filename', metavar='FILENAME', help='Filename to use for selecting a lexer when reading from stdin.')
+    parser.add_argument('--fail', action='store_true', help='Exit silently with status 1 if no specific lexer was found.')
+    parser.add_argument('-l', '--lexer', default='autodetect', help='Lexer to use when formatting or path to an XML file to load.')
+    parser.add_argument('-s', '--style', default='swapoff', help='Style to use for formatting or path to an XML file to load.')
+    parser.add_argument('-f', '--formatter', default='terminal', help='Formatter to use.')
+    parser.add_argument('--json', action='store_true', help='Convenience flag to use JSON formatter.')
+    parser.add_argument('--html', action='store_true', help='Convenience flag to use HTML formatter.')
+    parser.add_argument('--svg', action='store_true', help='Convenience flag to use SVG formatter.')
+    parser.add_argument('--html-prefix', metavar='PREFIX', help='HTML CSS class prefix.')
+    parser.add_argument('--html-styles', action='store_true', help='Output HTML CSS styles.')
+    parser.add_argument('--html-all-styles', action='store_true', help='Output all HTML CSS styles, including redundant ones.')
+    parser.add_argument('--html-only', action='store_true', help='Output HTML fragment.')
+    parser.add_argument('--html-inline-styles', action='store_true', help='Output HTML with inline styles (no classes).')
+    parser.add_argument('--html-tab-width', type=int, default=8, help='Set the HTML tab width.')
+    parser.add_argument('--html-lines', action='store_true', help='Include line numbers in output.')
+    parser.add_argument('--html-lines-table', action='store_true', help='Split line numbers and code in a HTML table')
+    parser.add_argument('--html-lines-style', metavar='STRING', help='Style for line numbers.')
+    parser.add_argument('--html-highlight', metavar='N[:M][,...]', help='Highlight these lines.')
+    parser.add_argument('--html-highlight-style', metavar='STRING', help='Style used for highlighting lines.')
+    parser.add_argument('--html-base-line', type=int, default=1, help='Base line number.')
+    parser.add_argument('--html-prevent-surrounding-pre', action='store_true', help='Prevent the surrounding pre tag.')
+    parser.add_argument('--html-linkable-lines', action='store_true', help='Make the line numbers linkable and be a link to themselves.')
+    
+    args = parser.parse_args()
+    
+    # Handle --help
+    if getattr(args, 'help', False):
+        print_help_text()
+        sys.exit(0)
+    
+    # Handle --version
+    if args.version:
+        print('?-?-?')
+        sys.exit(0)
+    
+    # Handle --list
+    if args.list:
+        print_lexers_styles_formatters()
+        sys.exit(0)
+    
+    # Process files
+    for filename in args.files:
+        try:
+            with open(filename, 'r') as f:
+                content = f.read()
+        except FileNotFoundError:
+            print(f"Error: File not found: {filename}", file=sys.stderr)
+            sys.exit(1)
+        
+        # Tokenize
+        tokens = tokenize_python(content)
+        
+        # Format
+        if args.json:
+            output = format_json(tokens)
+        elif args.html:
+            output = format_html(tokens, args.style)
+        elif args.svg:
+            output = format_svg(tokens, args.style)
+        else:
+            output = format_terminal(tokens, args.style)
+        
+        print(output)
+
