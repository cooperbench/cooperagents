+def format_terminal(tokens: List[Tuple[str, str]], style: Dict[str, str], colors: Dict[str, str]) -> str:
+    """Format tokens for terminal output."""
+    output = []
+    for token_type, value in tokens:
+        color = colors.get(token_type, colors.get('Text', 'WHITE'))
+        if color == 'ITALIC':
+            output.append(Colors.ITALIC + value + Colors.RESET)
+            output.append(Colors.BOLD + value + Colors.RESET)
+            output.append(Colors.UNDERLINE + value + Colors.RESET)
+        elif color == 'UNDERLINE':
+            output.append(f"{Colors.UNDERLINE}{value}{Colors.RESET}")
+        else:
+            output.append(Colors[color] + value + Colors.RESET)
+    return ''.join(output)
