+# Simple lexer for Python
+def tokenize_python(code: str) -> List[Tuple[str, str]]:
+    """Simple Python tokenizer."""
+    tokens = []
+    i = 0
+    lines = code.split('\n')
+    
+    while i < len(lines):
+        line = lines[i]
+        j = 0
+        while j < len(line):
+            # Skip whitespace
+            if line[j].isspace():
+                j += 1
+                continue
+            
+            # String literals
+            if line[j] in '"\'':
+                quote = line[j]
+                j += 1
+                start = j
+                while j < len(line) and line[j] != quote:
+                    if line[j] == '\\' and j + 1 < len(line):
+                        j += 2
+                    else:
+                        j += 1
+                value = line[start:j]
+                j += 1  # Skip closing quote
+                tokens.append(('LiteralString', value))
+                continue
+            
+            # Numbers
+            if line[j].isdigit() or (line[j] == '.' and j + 1 < len(line) and line[j + 1].isdigit()):
+                start = j
+                while j < len(line) and (line[j].isdigit() or line[j] in '.eE+-'):
+                    j += 1
+                value = line[start:j]
+                tokens.append(('LiteralNumber', value))
+                continue
+            
+            # Comments
+            if line[j] == '#':
+                start = j
+                while j < len(line) and line[j] != '\n':
+                    j += 1
+                value = line[start:j]
+                tokens.append(('Comment', value))
+                continue
+            
+            # Keywords and identifiers
+            if line[j].isalpha() or line[j] == '_':
+                start = j
+                while j < len(line) and (line[j].isalnum() or line[j] == '_'):
+                    j += 1
+                value = line[start:j]
+                if value in PYTHON_KEYWORDS:
+                    tokens.append(('Keyword', value))
+                elif value in PYTHON_BUILTINS:
+                    tokens.append(('NameBuiltin', value))
+                else:
+                    tokens.append(('Name', value))
+                continue
+            
+            # Operators and punctuation
+            if line[j] in '()[]{};:,':
+                tokens.append(('Punctuation', line[j]))
+                j += 1
+                continue
+            
+            if line[j] in '+-*/%=<>!&|^~':
+                # Multi-char operators
+                if j + 1 < len(line) and line[j + 1] in '+-*/':
+                    tokens.append(('OperatorWord', line[j:j+2]))
+                    j += 2
+                    continue
+                tokens.append(('OperatorWord', line[j]))
+                j += 1
+                continue
+            
+            j += 1
+        
+        i += 1
+    
+    return tokens
