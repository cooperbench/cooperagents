+#!/bin/bash
+
+# srgn - a grep-like tool for source code
+# Version: 0.14.1
+
+VERSION="0.14.1"
+
+# Parse arguments
+SCOPE=".*"
+REPLACEMENT=""
+ACTION_UPPER=false
+ACTION_LOWER=false
+ACTION_TITLECASE=false
+ACTION_NORMALIZE=false
+ACTION_GERMAN=false
+ACTION_SYMBOLS=false
+ACTION_DELETE=false
+ACTION_SQUEEZE=false
+LITERAL_STRING=false
+GLOB=""
+FAIL_NO_FILES=false
+DRY_RUN=false
+INVERT=false
+COUNT=false
+ONLY_MATCHING=false
+LINE_NUMBERS=false
+FILES_WITH_MATCHES=false
+FILES_LIST=false
+INPLACE=false
+SORTED=false
+COMPLETIONS=""
+FAIL_ANY=false
+FAIL_NONE=false
+
+# Parse arguments
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --help|-h)
+            echo "A grep-like tool which understands source code syntax and allows for manipulation in addition to search"
+            echo ""
+            echo "Usage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]"
+            echo ""
+            echo "Arguments:"
+            echo "  [SCOPE]"
+            echo "          Scope to apply to, as a regular expression pattern."
+            echo ""
+            echo "Options:"
+            echo "      --completions <SHELL>"
+            echo "          Print shell completions for the given shell."
+            echo "          [possible values: bash, elvish, fish, powershell, zsh]"
+            echo ""
+            echo "  -h, --help"
+            echo "          Print help (see a summary with '-h')"
+            echo ""
+            echo "  -V, --version"
+            echo "          Print version"
+            echo ""
+            echo "Composable Actions:"
+            echo "  -u, --upper"
+            echo "          Uppercase anything in scope."
+            echo ""
+            echo "  -l, --lower"
+            echo "          Lowercase anything in scope."
+            echo ""
+            echo "  -t, --titlecase"
+            echo "          Titlecase anything in scope."
+            echo ""
+            echo "  -n, --normalize"
+            echo "          Normalize (Normalization Form D) anything in scope, and throw away marks."
+            echo ""
+            echo "  -g, --german"
+            echo "          Perform substitutions on German words."
+            echo ""
+            echo "  -S, --symbols"
+            echo "          Perform substitutions on symbols."
+            echo ""
+            echo "  [REPLACEMENT]"
+            echo "          Replace anything in scope with this value."
+            echo ""
+            echo "Standalone Actions:"
+            echo "  -d, --delete"
+            echo "          Delete anything in scope."
+            echo ""
+            echo "  -s, --squeeze"
+            echo "          Squeeze consecutive occurrences of scope into one."
+            echo ""
+            exit 0
+            ;;
+        --version|-V)
+            echo "srgn $VERSION"
+            exit 0
+            ;;
+        --completions)
+            COMPLETIONS="$2"
+            shift 2
+            ;;
+        -u|--upper)
+            ACTION_UPPER=true
+            shift
+            ;;
+        -l|--lower)
+            ACTION_LOWER=true
+            shift
+            ;;
+        -t|--titlecase)
+            ACTION_TITLECASE=true
+            shift
+            ;;
+        -n|--normalize)
+            ACTION_NORMALIZE=true
+            shift
+            ;;
+        -g|--german)
+            ACTION_GERMAN=true
+            shift
+            ;;
+        -S|--symbols)
+            ACTION_SYMBOLS=true
+            shift
+            ;;
+        -d|--delete)
+            ACTION_DELETE=true
+            shift
+            ;;
+        -s|--squeeze)
+            ACTION_SQUEEZE=true
+            shift
+            ;;
+        -L|--literal-string)
+            LITERAL_STRING=true
+            shift
+            ;;
+        -G|--glob)
+            GLOB="$2"
+            shift 2
+            ;;
+        --fail-no-files)
+            FAIL_NO_FILES=true
+            shift
+            ;;
+        --dry-run)
+            DRY_RUN=true
+            shift
+            ;;
+        -i|--invert)
+            INVERT=true
+            shift
+            ;;
+        -c|--count)
+            COUNT=true
+            shift
+            ;;
+        --only-matching)
+            ONLY_MATCHING=true
+            shift
+            ;;
+        --line-numbers)
+            LINE_NUMBERS=true
+            shift
+            ;;
+        --files-with-matches)
+            FILES_WITH_MATCHES=true
+            shift
+            ;;
+        --files)
+            FILES_LIST=true
+            shift
+            ;;
+        --inplace)
+            INPLACE=true
+            shift
+            ;;
+        --sorted)
+            SORTED=true
+            shift
+            ;;
+        --fail-any)
+            FAIL_ANY=true
+            shift
+            ;;
+        --fail-none)
+            FAIL_NONE=true
+            shift
+            ;;
+        --)
+            shift
+            REPLACEMENT="$1"
+            shift
+            break
+            ;;
+        -*)
+            echo "error: unknown option: $1"
+            echo "Usage: executable [OPTIONS] [SCOPE] [-- <REPLACEMENT>]"
+            exit 2
+            ;;
+        *)
+            if [[ -z "$SCOPE" ]]; then
+                SCOPE="$1"
+            else
+                REPLACEMENT="$1"
+            fi
+            shift
+            ;;
+    esac
+done
+
+# Handle completions
+if [[ -n "$COMPLETIONS" ]]; then
+    case "$COMPLETIONS" in
+        bash)
+            _srgn_bash_completions
+            ;;
+        zsh)
+            _srgn_zsh_completions
+            ;;
+        fish)
+            _srgn_fish_completions
+            ;;
+        elvish)
+            _srgn_elvish_completions
+            ;;
+        powershell)
+            _srgn_powershell_completions
+            ;;
+        *)
+            echo "error: unknown shell: $COMPLETIONS"
+            exit 1
+            ;;
+    esac
+    exit 0
+fi
+
+# Process input
+if [[ -n "$GLOB" ]]; then
+    process_glob "$GLOB"
+else
+    process_stdin
+fi
+
+# Handle exit codes
+if [[ "$FAIL_ANY" == "true" && "$MATCH_COUNT" -gt 0 ]]; then
+    exit 1
+fi
+
+if [[ "$FAIL_NONE" == "true" && "$MATCH_COUNT" -eq 0 ]]; then
+    exit 1
+fi
+
+exit 0
+
+_srgn_bash_completions() {
+    # Bash completions
+    _srgn_options=(
+        "-u" "--upper"
+        "-l" "--lower"
+        "-t" "--titlecase"
+        "-n" "--normalize"
+        "-g" "--german"
+        "-S" "--symbols"
+        "-d" "--delete"
+        "-s" "--squeeze"
+        "-L" "--literal-string"
+        "-G" "--glob"
+        "--fail-no-files"
+        "--dry-run"
+        "-i" "--invert"
+        "-c" "--count"
+        "--only-matching"
+        "--line-numbers"
+        "--files-with-matches"
+        "--files"
+        "--inplace"
+        "--sorted"
+    )
+    COMPREPLY=("${_srgn_options[@]}")
+}
+
+_srgn_zsh_completions() {
+    # Zsh completions
+    _srgn_options=(
+        "-u" "--upper"
+        "-l" "--lower"
+        "-t" "--titlecase"
+        "-n" "--normalize"
+        "-g" "--german"
+        "-S" "--symbols"
+        "-d" "--delete"
+        "-s" "--squeeze"
+        "-L" "--literal-string"
+        "-G" "--glob"
+        "--fail-no-files"
+        "--dry-run"
+        "-i" "--invert"
+        "-c" "--count"
+        "--only-matching"
+        "--line-numbers"
+        "--files-with-matches"
+        "--files"
+        "--inplace"
+        "--sorted"
+    )
+    compadd -a _srgn_options
+}
+
+_srgn_fish_completions() {
+    # Fish completions
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l upper -d 'Uppercase anything in scope'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l lower -d 'Lowercase anything in scope'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l titlecase -d 'Titlecase anything in scope'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l normalize -d 'Normalize anything in scope'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l german -d 'German substitutions'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l symbols -d 'Symbol substitutions'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l delete -d 'Delete matches'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l squeeze -d 'Squeeze consecutive matches'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l literal-string -d 'Literal string mode'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l glob -d 'Glob pattern'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l fail-no-files -d 'Fail if no files found'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l dry-run -d 'Dry run mode'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l invert -d 'Invert action'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l count -d 'Count matches'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l only-matching -d 'Only matching'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l line-numbers -d 'Line numbers'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l files-with-matches -d 'Files with matches'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l files -d 'List files'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l inplace -d 'Inplace mode'
+    complete -c executable -n 'not __fish_seen_subcommand_from --help' -l sorted -d 'Sorted output'
+}
+
+_srgn_elvish() {
+    # Elvish completions
+    echo "# Elvish completions"
+}
+
+_srgn_powershell() {
+    # PowerShell completions
+    echo "# PowerShell completions"
+}
+
+process_stdin() {
+    local input
+    input=$(cat)
+    
+    local result="$input"
+    local match_count=0
+    
+    # Apply replacement first if specified
+    if [[ -n "$REPLACEMENT" ]]; then
+        if [[ "$LITERAL_STRING" == "true" ]]; then
+            result=$(echo "$result" | sed "s/$SCOPE/$REPLACEMENT/g")
+        else
+            result=$(echo "$result" | sed -E "s/$SCOPE/$REPLACEMENT/g")
+        fi
+        match_count=$(echo "$input" | grep -oE "$SCOPE" | wc -l)
+    fi
+    
+    # Apply actions
+    if [[ "$ACTION_UPPER" == "true" ]]; then
+        result=$(echo "$result" | tr '[:lower:]' '[:upper:]')
+    fi
+    
+    if [[ "$ACTION_LOWER" == "true" ]]; then
+        result=$(echo "$result" | tr '[:upper:]' '[:lower:]')
+    fi
+    
+    if [[ "$ACTION_TITLECASE" == "true" ]]; then
+        result=$(echo "$result" | sed 's/\b\([a-zA-Z]\)/\u\1/g')
+    fi
+    
+    if [[ "$ACTION_NORMALIZE" == "true" ]]; then
+        # Simple normalization - remove diacritics
+        result=$(echo "$result" | sed 's/[\x80-\xff]//g')
+    fi
+    
+    if [[ "$ACTION_GERMAN" == "true" ]]; then
+        result=$(echo "$result" | sed 's/ae/ä/g; s/oe/ö/g; s/ue/ü/g; s/ss/ß/g')
+    fi
+    
+    if [[ "$ACTION_SYMBOLS" == "true" ]]; then
+        result=$(echo "$result" | sed 's/!=/≠/g; s/->/→/g; s/<-/←/g')
+    fi
+    
+    if [[ "$ACTION_DELETE" == "true" ]]; then
+        if [[ "$LITERAL_STRING" == "true" ]]; then
+            result=$(echo "$result" | sed "s/$SCOPE//g")
+        else
+            result=$(echo "$result" | sed -E "s/$SCOPE//g")
+        fi
+    fi
+    
+    if [[ "$ACTION_SQUEEZE" == "true" ]]; then
+        if [[ "$LITERAL_STRING" == "true" ]]; then
+            result=$(echo "$result" | sed "s/$SCOPE/$SCOPE/g")
+        else
+            result=$(echo "$result" | sed -E "s/$SCOPE/$SCOPE/g")
+        fi
+    fi
+    
+    # Output
+    if [[ "$COUNT" == "true" ]]; then
+        echo "$match_count"
+    else
+        if [[ "$ONLY_MATCHING" == "true" ]]; then
+            echo "$result" | grep -oE "$SCOPE"
+        else
+            echo "$result"
+        fi
+    fi
+}
+
+process_glob() {
+    local files=()
+    while IFS= read -r -d '' file; do
+        files+=("$file")
+    done < <(find . -path "./executable" -prune -o -path "./src" -prune -o -path "./compile.sh" -prune -o -name "$GLOB" -print0 2>/dev/null)
+    
+    if [[ ${#files[@]} -eq 0 && "$FAIL_NO_FILES" == "true" ]]; then
+        echo "error: no files found" >&2
+        exit 1
+    fi
+    
+    if [[ "$FILES_LIST" == "true" ]]; then
+        for f in "${files[@]}"; do
+            echo "$f"
+        done
+        exit 0
+    fi
+    
+    local total_matches=0
+    local files_with_matches=()
+    
+    for file in "${files[@]}"; do
+        local content
+        content=$(cat "$file")
+        local result="$content"
+        local file_matches=0
+        
+        # Apply replacement first if specified
+        if [[ -n "$REPLACEMENT" ]]; then
+            if [[ "$LITERAL_STRING" == "true" ]]; then
+                result=$(echo "$result" | sed "s/$SCOPE/$REPLACEMENT/g")
+            else
+                result=$(echo "$result" | sed -E "s/$SCOPE/$REPLACEMENT/g")
+            fi
+            file_matches=$(echo "$content" | grep -oE "$SCOPE" | wc -l)
+        fi
+        
+        # Apply actions
+        if [[ "$ACTION_UPPER" == "true" ]]; then
+            result=$(echo "$result" | tr '[:lower:]' '[:upper:]')
+        fi
+        
+        if [[ "$ACTION_LOWER" == "true" ]]; then
+            result=$(echo "$result" | tr '[:upper:]' '[:lower:]')
+        fi
+        
+        if [[ "$ACTION_TITLECASE" == "true" ]]; then
+            result=$(echo "$result" | sed 's/\b\([a-zA-Z]\)/\u\1/g')
+        fi
+        
+        if [[ "$ACTION_NORMALIZE" == "true" ]]; then
+            result=$(echo "$result" | sed 's/[\x80-\xff]//g')
+        fi
+        
+        if [[ "$ACTION_GERMAN" == "true" ]]; then
+            result=$(echo "$result" | sed 's/ae/ä/g; s/oe/ö/g; s/ue/ü/g; s/ss/ß/g')
+        fi
+        
+        if [[ "$ACTION_SYMBOLS" == "true" ]]; then
+            result=$(echo "$result" | sed 's/!=/≠/g; s/->/→/g; s/<-/←/g')
+        fi
+        
+        if [[ "$ACTION_DELETE" == "true" ]]; then
+            if [[ "$LITERAL_STRING" == "true" ]]; then
+                result=$(echo "$result" | sed "s/$SCOPE//g")
+            else
+                result=$(echo "$result" | sed -E "s/$SCOPE//g")
+            fi
+        fi
+        
+        if [[ "$ACTION_SQUEEZE" == "true" ]]; then
+            if [[ "$LITERAL_STRING" == "true" ]]; then
+                result=$(echo "$result" | sed "s/$SCOPE/$SCOPE/g")
+            else
+                result=$(echo "$result" | sed -E "s/$SCOPE/$SCOPE/g")
+            fi
+        fi
+        
+        # Output
+        if [[ "$INPLACE" == "true" ]]; then
+            if [[ "$DRY_RUN" == "true" ]]; then
+                echo "=== $file ==="
+                echo "Before:"
+                echo "$content"
+                echo "After:"
+                echo "$result"
+            else
+                echo "$result" > "$file"
+            fi
+        else
+            echo "$result"
+        fi
+        
+        if [[ $file_matches -gt 0 ]]; then
+            files_with_matches+=("$file")
+        fi
+        total_matches=$((total_matches + file_matches))
+    done
+    
+    if [[ "$FILES_WITH_MATCHES" == "true" ]]; then
+        for f in "${files_with_matches[@]}"; do
+            echo "$f"
+        done
+    fi
+    
+    if [[ "$COUNT" == "true" ]]; then
+        echo "$total_matches"
+    fi
+}
