# Shared worker/coordinator profile. No secrets in this file.
# Export OPENAI_API_KEY separately, then set ENV_FILE to this path for bench_compare.py.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AZURE_OPENAI_DEPLOYMENT=qwen/qwen3.5-9b
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=

# FORCE overrides TeamSpec's default temperature=0.0 for workers.
COOPER_TEMPERATURE_FORCE=1.0
COOPER_TOP_P=0.95
COOPER_TOP_K=20
COOPER_MIN_P=0.0
COOPER_PRESENCE_PENALTY=1.5
COOPER_REPETITION_PENALTY=1.0
COOPER_REASONING_ENABLED=false
COOPER_REQUIRE_PARAMETERS=true

# Set COOPER_MAX_TOKENS explicitly when choosing the experiment budget.
# If set, both clients use it. Otherwise their existing output limits remain.
# bench_compare uses setdefault: unset stale shell overrides before loading.
# Provider compatibility and actual non-thinking behavior still need a live smoke.
