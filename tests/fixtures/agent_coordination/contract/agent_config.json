{
  "gate": {
    "api_key_env": "OPENROUTER_API_KEY",
    "base_url": "https://openrouter.ai/api/alpha",
    "heartbeat_steps": 15,
    "min_seconds_between_wakes": 30.0,
    "min_steps_between_wakes": 4,
    "model": "liquid/d1.2-ultra",
    "per_worker_wake_cap": 4,
    "policy": "model",
    "random_seed": 0,
    "random_step_horizon": null,
    "random_wakes": null,
    "timeout_s": 3.0,
    "wake_budget": 8,
    "wake_threshold": 0.5
  },
  "max_retries": 2,
  "opening": "draft",
  "opening_max_tool_calls": 16,
  "opening_reserve": 2,
  "opening_time_limit_s": 180.0,
  "prompts": null,
  "reasoning_effort": "medium",
  "retry_base_delay_s": 0.5,
  "signals": {
    "churn_min_steps": 3,
    "churn_window": 10,
    "cooldown_steps": 6,
    "history_steps": 24,
    "no_progress_min_failures": 3,
    "no_progress_window": 5,
    "probe_timeout_s": 10.0,
    "test_command_prefixes": [
      "pytest",
      "python -m pytest",
      "python3 -m pytest",
      "python -m unittest",
      "tox",
      "nox",
      "go test",
      "cargo test",
      "npm test",
      "npm run test",
      "yarn test",
      "pnpm test",
      "npx jest",
      "jest",
      "vitest",
      "mvn test",
      "gradle test",
      "./gradlew test",
      "make test",
      "ctest",
      "rspec",
      "bundle exec rspec",
      "phpunit",
      "dotnet test"
    ]
  },
  "spec_check": true,
  "spec_check_time_limit_s": 150.0,
  "spec_gate_max_rejections": 1,
  "tick_s": 1.0,
  "wake_max_tool_calls": 6,
  "wake_reserve": 2,
  "wake_time_limit_s": 90.0
}
